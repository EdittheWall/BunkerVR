BunkerVR patch 1
file config/base_english.lang
from 7114e42bd563b81888592c60dd1103408cd675c7230994857cb58f3d2cdc1ed6 57782
to 284d46dc9c4ddfb2c1b6f0ae5be43392902d7770fe916f7eaab305515aa3a36d 67363
=460
+	<Entry Name="Options_VR">VR</Entry>
+	<Entry Name="VRMenu">VR SETTINGS</Entry>
+	<Entry Name="VR_Player">PLAYER</Entry>
+	<Entry Name="VR_Player_Info">Play mode, height offset and world scale.</Entry>
+	<Entry Name="VR_Comfort">COMFORT</Entry>
+	<Entry Name="VR_Comfort_Info">Turning, head bob, and how knockdowns and cutscenes are shown.</Entry>
+	<Entry Name="VR_Movement">MOVEMENT</Entry>
+	<Entry Name="VR_Movement_Info">Movement direction and speed, and crouching.</Entry>
+	<Entry Name="VR_Access">ACCESSIBILITY</Entry>
+	<Entry Name="VR_Access_Info">Interaction hints, throw assist, grab reach, controller vibration and menu pointer smoothing.</Entry>
+	<Entry Name="VR_System">SYSTEM</Entry>
+	<Entry Name="VR_System_Info">Menu distance and size, the spectator view on your monitor, and keyboard and mouse input.</Entry>
+	<Entry Name="VR_MeasureAgain">RECALIBRATE</Entry>
+	<Entry Name="VR_MeasureAgain_Info">Run Player Setup again: play mode, floor, height, and the positions of the holster, ammo pouch and flashlight.</Entry>
+	<Entry Name="VR_On">On</Entry>
+	<Entry Name="VR_Off">Off</Entry>
+	<Entry Name="VR_Playing">Play Mode</Entry>
+	<Entry Name="VR_Playing_Info">Choose whether you play seated or standing. This sets your view height and moves the holster to suit.</Entry>
+	<Entry Name="VR_Seated">Seated</Entry>
+	<Entry Name="VR_Standing">Standing</Entry>
+	<Entry Name="VR_Height">Height Offset</Entry>
+	<Entry Name="VR_Height_Info">Raises or lowers your view height in the game.</Entry>
+	<Entry Name="VR_Height0">-20 cm</Entry>
+	<Entry Name="VR_Height1">-15 cm</Entry>
+	<Entry Name="VR_Height2">-10 cm</Entry>
+	<Entry Name="VR_Height3">-5 cm</Entry>
+	<Entry Name="VR_Height4">0 cm</Entry>
+	<Entry Name="VR_Height5">+5 cm</Entry>
+	<Entry Name="VR_Height6">+10 cm</Entry>
+	<Entry Name="VR_Height7">+15 cm</Entry>
+	<Entry Name="VR_Height8">+20 cm</Entry>
+	<Entry Name="VR_Size">World Scale</Entry>
+	<Entry Name="VR_Size_Info">Your size relative to the game world. Calibrating your height sets it (the middle choice); a higher percentage makes you larger, so the world appears smaller.</Entry>
+	<Entry Name="VR_PressArrow">Press Either Arrow</Entry>
+	<Entry Name="VR_Done">Done</Entry>
+	<Entry Name="VR_Turning">Turn Style</Entry>
+	<Entry Name="VR_Turning_Info">Smooth: turn continuously while the right thumbstick is held. Snap: turn in fixed steps, which many players find more comfortable.</Entry>
+	<Entry Name="VR_Smooth">Smooth</Entry>
+	<Entry Name="VR_Snap">Snap</Entry>
+	<Entry Name="VR_SnapAngle">Snap Turn Angle</Entry>
+	<Entry Name="VR_SnapAngle_Info">How far each snap turn rotates you, in degrees.</Entry>
+	<Entry Name="VR_Angle30">30</Entry>
+	<Entry Name="VR_Angle45">45</Entry>
+	<Entry Name="VR_Angle60">60</Entry>
+	<Entry Name="VR_Angle90">90</Entry>
+	<Entry Name="VR_TurnSpeed">Smooth Turn Speed</Entry>
+	<Entry Name="VR_TurnSpeed_Info">How fast smooth turning rotates you.</Entry>
+	<Entry Name="VR_Slow">Slow</Entry>
+	<Entry Name="VR_Normal">Normal</Entry>
+	<Entry Name="VR_Fast">Fast</Entry>
+	<Entry Name="VR_VeryFast">Very Fast</Entry>
+	<Entry Name="VR_MoveVignette">Movement Vignette</Entry>
+	<Entry Name="VR_MoveVignette_Info">Darkens the edges of your view while the thumbsticks move or turn you, which helps many players avoid motion sickness. Your own movement is never darkened. Off, Weak, Medium or Strong.</Entry>
+	<Entry Name="VR_HeadBob">Head Bob</Entry>
+	<Entry Name="VR_HeadBob_Info">Camera motion from walking and breathing. Default keeps a little of it, Off removes it.</Entry>
+	<Entry Name="VR_Default">Default</Entry>
+	<Entry Name="VR_Full">Full</Entry>
+	<Entry Name="VR_Knockdown">Knockdown View</Entry>
+	<Entry Name="VR_Knockdown_Info">How knockdowns, falls and the Beast's kills are shown. No Comfort: through your own eyes as the game moves you. Cutscene Screen: on a large screen. Vignette: through your own eyes, the edges of your view darkened while you are thrown about.</Entry>
+	<Entry Name="VR_NoComfort">No Comfort</Entry>
+	<Entry Name="VR_CutsceneScreen">Cutscene Screen</Entry>
+	<Entry Name="VR_Vignette">Vignette</Entry>
+	<Entry Name="VR_VignetteStrength">Knockdown Vignette</Entry>
+	<Entry Name="VR_VignetteStrength_Info">How far the vignette closes in from the edges of your view while you are thrown about, when Knockdown View is Vignette. None, Weak, Medium or Strong.</Entry>
+	<Entry Name="VR_VignetteNone">None</Entry>
+	<Entry Name="VR_VignetteWeak">Weak</Entry>
+	<Entry Name="VR_VignetteMedium">Medium</Entry>
+	<Entry Name="VR_VignetteStrong">Strong</Entry>
+	<Entry Name="VR_FullMotion">Full Motion</Entry>
+	<Entry Name="VR_CinemaScreen">Cinema Screen</Entry>
+	<Entry Name="VR_FadeToBlack">Fade to Black</Entry>
+	<Entry Name="VR_ReducedMotion">Reduced Motion</Entry>
+	<Entry Name="VR_Cutscenes">Cutscene View</Entry>
+	<Entry Name="VR_Cutscenes_Info">Cinema Screen: cutscenes play on a large screen in a dark room. Reduced Motion: watch through your own eyes with the camera motion smoothed.</Entry>
+	<Entry Name="VR_Blood">Screen Effects</Entry>
+	<Entry Name="VR_Blood_Info">Blood across your view when you are hurt, and the gas mask's view while you wear it. Turn off if they cause discomfort.</Entry>
+	<Entry Name="VR_WalkDir">Movement Direction</Entry>
+	<Entry Name="VR_WalkDir_Info">Head: pushing the left thumbstick forward moves you where you are looking. Left Controller: you move where your left controller points, so you can look around freely while moving.</Entry>
+	<Entry Name="VR_MyHead">Head</Entry>
+	<Entry Name="VR_LeftController">Left Controller</Entry>
+	<Entry Name="VR_WalkSpeed">Movement Speed</Entry>
+	<Entry Name="VR_WalkSpeed_Info">Analog: a small push of the thumbstick moves you slowly and a full push at full speed. Always Full: any push moves you at full speed.</Entry>
+	<Entry Name="VR_AlwaysFull">Always Full</Entry>
+	<Entry Name="VR_FollowsStick">Analog</Entry>
+	<Entry Name="VR_DuckCrouch">Physical Crouch</Entry>
+	<Entry Name="VR_DuckCrouch_Info">Crouch in the game by crouching in real life. Pulling the right thumbstick down always crouches as well, and pushing it up stands you back up.</Entry>
+	<Entry Name="VR_DuckDepth">Crouch Depth</Entry>
+	<Entry Name="VR_DuckDepth_Info">How far your head must lower before you crouch in the game. Choose Shallow if crouching is difficult for you.</Entry>
+	<Entry Name="VR_ALittle">Shallow</Entry>
+	<Entry Name="VR_ALot">Deep</Entry>
+	<Entry Name="VR_ThrowHelp">Throw Assist</Entry>
+	<Entry Name="VR_ThrowHelp_Info">Adds speed to thrown objects, so a gentle throw still travels far. Useful when seated or if a full swing is difficult.</Entry>
+	<Entry Name="VR_Light">Low</Entry>
+	<Entry Name="VR_Medium">Medium</Entry>
+	<Entry Name="VR_Strong">High</Entry>
+	<Entry Name="VR_Reach">Grab Reach</Entry>
+	<Entry Name="VR_Reach_Info">How far beyond your hand you can grab and use objects. Longer means less leaning and stretching.</Entry>
+	<Entry Name="VR_Short">Short</Entry>
+	<Entry Name="VR_Long">Long</Entry>
+	<Entry Name="VR_VeryLong">Very Long</Entry>
+	<Entry Name="VR_Vibration">Controller Vibration</Entry>
+	<Entry Name="VR_Vibration_Info">How strongly the controllers vibrate. Off disables all vibration.</Entry>
+	<Entry Name="VR_Pointer">Menu Pointer Smoothing</Entry>
+	<Entry Name="VR_Pointer_Info">Steadies the menu pointer against hand tremor. Higher is steadier, but follows your hand slightly later.</Entry>
+	<Entry Name="VR_Hints">Interaction Hints</Entry>
+	<Entry Name="VR_Hints_Info">Small labels at the things your hands reach show how to use them. Until Learned: each hint shows until you have used it three times. Always: hints always show. Off: no hints.</Entry>
+	<Entry Name="VR_UntilLearned">Until Learned</Entry>
+	<Entry Name="VR_Always">Always</Entry>
+	<Entry Name="VR_HintsReset">Show Learned Hints Again</Entry>
+	<Entry Name="VR_HintsReset_Info">Press either arrow on this row: every hint shows again until you have used it three times.</Entry>
+	<Entry Name="VR_MenuDistance">Menu Distance</Entry>
+	<Entry Name="VR_MenuDistance_Info">How far away the game's menus and messages appear.</Entry>
+	<Entry Name="VR_Near">Near</Entry>
+	<Entry Name="VR_Far">Far</Entry>
+	<Entry Name="VR_MenuSize">Menu Size</Entry>
+	<Entry Name="VR_MenuSize_Info">How large the game's menus and messages appear. Larger is easier to read.</Entry>
+	<Entry Name="VR_Small">Small</Entry>
+	<Entry Name="VR_Large">Large</Entry>
+	<Entry Name="VR_MonitorSteady">Spectator Smoothing</Entry>
+	<Entry Name="VR_MonitorSteady_Info">For viewers and recordings: the view on your monitor follows your head smoothly and keeps the horizon level. Higher is smoother but lags slightly behind. Off mirrors the headset view.</Entry>
+	<Entry Name="VR_MonitorWidth">Spectator Field of View</Entry>
+	<Entry Name="VR_MonitorWidth_Info">How much the spectator view shows. Narrow is closer in and Wide shows more. Not used when Spectator Smoothing is off.</Entry>
+	<Entry Name="VR_Narrow">Narrow</Entry>
+	<Entry Name="VR_Wide">Wide</Entry>
+	<Entry Name="VR_PcInput">Keyboard and Mouse</Entry>
+	<Entry Name="VR_PcInput_Info">Off: only the controllers work while you play in VR, so an accidental key press does nothing. On: the keyboard and mouse work as well. Press Ctrl+F12 to switch this at any time.</Entry>
+	<Entry Name="VR_DoorTurn">Door Handles Require Turning</Entry>
+	<Entry Name="VR_DoorTurn_Info">On: a closed door opens once you grab its handle and twist your wrist, like a real handle. Off: grabbing the handle is enough to open it.</Entry>
end
