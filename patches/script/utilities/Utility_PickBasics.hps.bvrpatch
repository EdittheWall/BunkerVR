+// BunkerVR: picking with a hand. The search starts this far back inside the
+// hand and reaches this far out from the controller's front (in meters).
+const float gfVRHandPickStartBack = 0.12f;
+const float gfVRHandReach = 0.30f;
+// How far the extra rays tilt away from straight ahead (1 = 45 degrees).
+const float gfVRHandPickSpread = 0.9f;
=19
-1
+	// BunkerVR: abVRTouch: with a hand, only what the hand touches (see
+	// VRHandTouchFind in Prop_PlayerBody.hps). Set by the ordinary state's
+	// pick (PlayerState_Normal.hps), where an empty hand takes hold of things
+	// and uses them; the other picks (an item used on something, and the
+	// like) keep the rays.
+	bool UpdatePickCheck(cCamera @apCam, bool abCheckInteractionSupport, float afCustomMaxInteractDist=-1, bool abForceSkipSpecialDist=false, bool abVRTouch=false)
