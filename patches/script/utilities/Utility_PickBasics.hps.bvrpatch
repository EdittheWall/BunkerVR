+			if(vVRStatus.x > 12344.0f && vVRStatus.x < 12346.0f && vVRStatus.y > 0.5f)
=1
-2
+				apCam.SetRoll(7003.0f);
+				cMatrixf mtxVRHand = apCam.GetMatrix();
+				cMatrixf mtxVRHandInv = cMath_MatrixInverse(mtxVRHand);
+				vRayPos = mtxVRHand.GetTranslation();
+				vRayDir = mtxVRHandInv.GetForward() * -1.0f;
+				vRayRight = mtxVRHandInv.GetRight();
+				vRayUp = mtxVRHandInv.GetUp();
+
+				// The hand that is seen may be held back from the real one (it
+				// stops at tables and walls, the real hand going a little into
+				// them: see VRHandBlock in Prop_PlayerBody.hps). The search goes
+				// from the hand that is seen, so a hand resting on a table still
+				// finds what lies on it; from the real hand, inside the table, it
+				// would find only the table.
+				int lVRHand = int(vVRStatus.z + 0.5f);
+				lVRPickHand = lVRHand;
+				cVector3f vVRBack = cScript_GetGlobalVarVector3f(lVRHand == 0 ? "BunkerVR_HandBack0" : "BunkerVR_HandBack1");
+				if(vVRBack.Length() < 0.6f) vRayPos = vRayPos + vVRBack;
+
+				// Things are taken hold of with the hand itself: only what the hand
+				// is at, or very nearly touching, counts. The search starts inside
+				// the hand and reaches a short way past the fingertips.
+				bVRHandPick = true;
+				vRayPos = vRayPos - vRayDir * gfVRHandPickStartBack;
+				
+				// The reach can be changed in the mod's menu (special roll value 7032, second number).
+				apCam.SetRoll(7032.0f);
+				float fVRReachSet = apCam.GetMatrix().GetTranslation().y;
+				if(fVRReachSet > 0.04f && fVRReachSet < 3.01f) fVRHandReach = fVRReachSet;
