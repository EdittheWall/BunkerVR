+
+		// Normally one ray is tried per update, a little to one side of the center
+		// (a different side each time nothing was found).
+		// BunkerVR: with a hand, a whole fan of rays is tried at once: straight out
+		// of the hand and tilted to every side of that, so that whatever the hand
+		// is at or over is found, not only what it points exactly at. The nearest
+		// thing found wins.
+		int lRayNum = bVRHandPick ? glPickOffsetNum : 1;
+
+		// BunkerVR: only what the hand touches (abVRTouch): what the arms' code
+		// reports that hand touches ("BunkerVR_TouchEntity0/1"...: see
+		// VRHandTouchFind in Prop_PlayerBody.hps), if reported just now; then
+		// no rays. If the report is old or missing, the arms are not being drawn
+		// and the rays are used as usual.
+		if(bVRHandPick && abVRTouch && lVRPickHand >= 0 && lVRPickHand <= 1)
+		{
+			tString sVRHand = lVRPickHand == 0 ? "0" : "1";
