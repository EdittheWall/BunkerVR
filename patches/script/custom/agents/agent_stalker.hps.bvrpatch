=2143
+	// BunkerVR: the Beast directed for filming (the VR mod's Trailer page, VRTrailer in PlayerBodyHandler.hps).
+	// Arg 0: kept calm, taking no notice of the player (not seen, not felt near, the player's own sounds not heard, no
+	// damage given). Arg 1: the speed it goes to a sound at (0 its own, 1 a walk, 2 a run).
+	[nosave] bool mbVRTrailerCalm = false;
+	[nosave] int mlVRTrailerSpeed = 0;
+	void _Global_VRTrailer()
+	{
+		mbVRTrailerCalm = cScript_GetGlobalArgBool(0);
+		mlVRTrailerSpeed = cScript_GetGlobalArgInt(1);
+		if (mbVRTrailerCalm == false) return;
+		mbVRTrailerHuntOut = false;
+
+		// Calmed while after the player: it lets them be and waits where it is.
+		int lState = mpStateMachine.GetCurrentState();
+		if (lState == eStalkerState_PlayerDetected || lState == eStalkerState_Alert || lState == eStalkerState_PreHunt ||
+			lState == eStalkerState_Hunt || lState == eStalkerState_PostHunt || lState == eStalkerState_AttackClose ||
+			lState == eStalkerState_Rage || lState == eStalkerState_Stalk || lState == eStalkerState_SearchArea ||
+			lState == eStalkerState_CheckLastKnownPosition)
+		{
+			mBaseObj.ResetPlayerDetectionState();
+			mpStateMachine.ChangeState(eStalkerState_Idle);
+		}
+	}
+
+	// BunkerVR: the Trailer page's "Spawn the Beast Where You Look": out of the walls (or from wherever it is) and put
+	// with its feet on a spot (arg 0), turned to a yaw (arg 1), waiting there (Idle: kept calm, it stays). It is put
+	// there as it comes into Idle, once the state it leaves has tidied up (leaving the walls hides its body). Not while
+	// it throws or kills the player. Returns whether it is to be put there.
+	[nosave] bool mbVRTrailerPlace = false;
+	[nosave] cVector3f mvVRTrailerPlacePos = cVector3f(0.0f);
+	[nosave] float mfVRTrailerPlaceYaw = 0.0f;
+	void _Global_VRTrailerPlace()
+	{
+		int lState = mpStateMachine.GetCurrentState();
+		if (lState == eStalkerState_ThrowPlayer || lState == eStalkerState_KillPlayer)
+		{
+			cScript_SetGlobalReturnBool(false);
+			return;
+		}
+		mvVRTrailerPlacePos = cScript_GetGlobalArgVector3f(0);
+		mfVRTrailerPlaceYaw = cScript_GetGlobalArgFloat(1);
+		mbVRTrailerPlace = true;
+		if (lState == eStalkerState_Idle) VRTrailerPlaceNow();
+		else mpStateMachine.ChangeState(eStalkerState_Idle);
+		cScript_SetGlobalReturnBool(true);
+	}
+
+	// Put there now, as it is put when it comes out of a hole (Emerge_PrepareEmerge).
+	void VRTrailerPlaceNow()
+	{
+		mbVRTrailerPlace = false;
+		iCharacterBody@ pCharBody = mBaseObj.GetCharBody();
+		if (pCharBody is null) return;
+		mpSoundListener.SetHearRadius(mfHearRadius);
+		mpSoundListener.SetSoundRadiusMul(mfHearingMul);
+		mpPathfinder.Stop();
+		mpMover.StopTurning();
+		SetHidden(false);
+		pCharBody.SetFeetPosition(mvVRTrailerPlacePos, false);
+		pCharBody.SetYaw(mfVRTrailerPlaceYaw);
+	}
+
+	// BunkerVR: for the Trailer page's holes (VRTrailerNearestHole): its hole network, registered now if it has not
+	// been yet (as its first update after being switched on does, OnUpdate: the page may have just switched it on).
+	void _Global_VRTrailerHoleNetwork()
+	{
+		if (mlGhoulHoleNetworkId == -1)
+			mlGhoulHoleNetworkId = Blackboard_RegisterGhoulHoleNetwork(mBaseObj.GetMap(), msHoleNetwork);
+		cScript_SetGlobalReturnInt(mlGhoulHoleNetworkId);
+	}
+
+	// BunkerVR: for the Trailer page's watch on it (VRUpdateTrailer): its state's name, and whether it is in the walls.
+	void _Global_VRTrailerState()
+	{
+		tString sState = StateToString(mpStateMachine.GetCurrentState());
+		cScript_SetGlobalReturnString((sState != "" ? sState : "between states") + (mbHidden ? ", in the walls" : ""));
+	}
+
+	// BunkerVR: the Trailer page's "Hunt Me": no longer calm, in active mode, told where the player is and at once alert
+	// to them, as when it sees them (Alert: it turns to them, then hunts them). In the walls it does so as it next comes
+	// out (Emerge_DecidePostEmergeBehaviour; the page brings it out of the hole nearest the player). Returns whether it
+	// is in the walls.
+	[nosave] bool mbVRTrailerHuntOut = false;
+	void _Global_VRTrailerHunt()
+	{
+		mbVRTrailerCalm = false;
+		mlVRTrailerSpeed = 0;
+		ChangeMode(eStalkerMode_Active, false);
+		cScript_SetGlobalReturnBool(mbHidden);
+		if (mbHidden) mbVRTrailerHuntOut = true;
+		else VRTrailerHuntNow();
+	}
+
+	void VRTrailerHuntNow()
+	{
+		mbVRTrailerHuntOut = false;
+		mBaseObj.RevealPlayerPos();
+		mpStateMachine.ChangeState(eStalkerState_Alert);
+	}
+	
+	//------------------------------------------------------------
+	
