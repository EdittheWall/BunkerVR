=125
+		// BunkerVR: the kick in both hands (Prop_PlayerBody.hps VRRevolverKicked): a full one for a
+		// shot, a small one for the hammer's snap on an empty chamber. The game's own kick is in the
+		// arm's animation, which the hands on the controllers leave out.
+		cScript_SetGlobalVarFloat("BunkerVR_RevolverKickAt", float(cEngine_GetGameTime()));
+		cScript_SetGlobalVarFloat("BunkerVR_RevolverKickSize", bCanFire ? 1.0f : 0.15f);
