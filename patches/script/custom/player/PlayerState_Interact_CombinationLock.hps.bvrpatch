+// BunkerVR: the rollers picked by a VR fingertip and turned by the trigger
+// (see VRSetupFingers). Distances in the lock's own size (as its model has
+// them).
+const float gfVRRollerIn = 0.015f;		// a fingertip on a roller: from this far inside its front...
+const float gfVRRollerOut = 0.045f;		// ...to this far out in front of it...
+const float gfVRRollerAbove = 0.012f;	// ...and this much above and below its front's height
+const float gfVRRollerKeep = 0.5f;		// the roller under the finger stays picked until another is nearer by this share of their spacing (so it changes three quarters of the way to the next)
+const float gfVRRollerSpacing = 0.0174f;	// the bunker's lock: its rollers' centers this far apart (its model's points; used if they cannot be read)
+const float gfVRLockAwayDistance = 0.25f;	// (meters, real) no fingertip this near the lock...
+const float gfVRLockAwayTime = 2.0f;		// ...for this long (seconds), once a fingertip has turned it: left
+const float gfVRLockHeadAway = 1.4f;		// left too with the head this far from it (meters, real: past any arm's reach, as the player walks away)...
+const float gfVRLockHeadAwayTime = 0.3f;	// ...for this long (seconds)
+
