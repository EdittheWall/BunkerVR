-2
+	void OnUse()
+	{
+		// BunkerVR: in the headset the lid must be off first (opened by the
+		// left hand: PlayerBodyHandler.hps VRUpdateLid). While it is closed,
+		// only a hint saying so is shown.
+		if(cVR_Active() && cScript_GetGlobalVarInt("BunkerVR_FuelOpen") != 1)
+		{
+			Hint_ShowHint("Hints", "HintVRFuelLid");
+			return;
+		}
+
=19
+
+		// BunkerVR: in the headset the fuel is splashed out by a flick of the
+		// open can (VRUpdateFuelSplash in PlayerBodyHandler.hps), as far and in
+		// the direction it is flicked, not by the game's throw ahead of the eyes
+		// (the rule for hands-on items: no button does what the hands do).
+		if (cVR_Active()) return;
end
