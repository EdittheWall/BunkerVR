+		// BunkerVR: while both hands hold the cutters' handles in the headset,
+		// the hands pose the cutters (their own "cutter_cut_air" held at the
+		// opening: VRUpdateCutters in PlayerBodyHandler.hps), so the game must
+		// not start its own animations on them meanwhile.
+		if (cVR_Active() && cScript_GetGlobalVarInt("BunkerVR_CuttersPosed") == 1) return;
+		
=28
+		// BunkerVR: in the headset the cutters are opened and squeezed shut
+		// with both hands, around what they cut (VRUpdateCutters in
+		// PlayerBodyHandler.hps): no scene, and the right squeeze does
+		// nothing else with them.
+		if (cVR_Active()) return;
+		
end
