=88
+	// BunkerVR: the VR mod's flashlight (a squeeze at the left of the chest,
+	// or the right stick clicked) while a gun is out: done as the game's own
+	// flashlight key does here (see eAction_Flashlight in OnAction below), so
+	// the left arm takes the lamp with the game's own animation and the gun is
+	// then held in one hand. If the mod turned the light on by itself, the
+	// left arm would stay in the two-handed grip and hold the lamp like the
+	// revolver's grip until the lamp was wound.
+	void _Global_VRToggleLantern()
+	{
+		if (mbAllowUsingLantern == false ||
+			mlAnimState == eUsingItemAnimState_Outro ||
+			mLanternEquipState != eGunLanternEquipState_None ||
+			ItemType_GetCountInInventory("DynamoLantern") == 0 ||
+			Player_GetCanUseLightSource() == false)
+		{
+			return;
+		}
+		
+		// (Its animations play three times as fast as the game's own: at their
+		// own speed the lamp comes out of the holster with a noticeable delay.)
+		int lHeldState = Item_GetHandHeldState(eItemHandlerHand_Left);
+		if (lHeldState == 3)
+		{
+			Player_ToggleLightSource();
+			mLanternEquipState = eGunLanternEquipState_Unequip;
+			mfVRLanternAnimSpeed = gfVRLanternAnimSpeed;
+		}
+		else if (lHeldState == 0)
+		{
+			mLanternEquipState = eGunLanternEquipState_Equip;
+			mfVRLanternAnimSpeed = gfVRLanternAnimSpeed;
+		}
+	}
+	
+	//------------------------------------------------------------
+	
=167
+			pAnimL.SetSpeed(mfVRLanternAnimSpeed); // BunkerVR (see _Global_VRToggleLantern)
=5
+			pAnimR.SetSpeed(mfVRLanternAnimSpeed); // BunkerVR (see _Global_VRToggleLantern)
=174
