-1
+			// BunkerVR: in the headset the shotgun's dry click comes from its own
+			// script, cut short before the pump rack this sound includes
+			// (Prop_Shotgun.hps VRDryClick).
+			if (cVR_Active() == false || msWeaponType != "Shotgun")
