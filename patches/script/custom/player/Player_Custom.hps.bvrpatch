+
+		////////////////////////////////////
+		// BunkerVR: walk by the thumbstick's exact push.
+		// The VR mod presses the walking keys, which only gives eight directions
+		// at full speed. While a walking key is down, the mod is asked how the
+		// stick is really pushed (special roll value 7018; it answers through
+		// the camera's matrix with 12345, sideways, forwards) and that is walked
+		// by instead: any direction, slower for a small push. Without the mod,
+		// or with the setting off, the answer does not match and the keys count.
+		if(alAnalogId == eAnalogType_Move)
+		{
+			cCamera@ pVRMoveCam = mBaseObj.GetCamera();
+			if(pVRMoveCam !is null)
+			{
+				float fVRMoveRoll = pVRMoveCam.GetRoll();
+				pVRMoveCam.SetRoll(7018.0f);
+				cVector3f vVRMove = pVRMoveCam.GetMatrix().GetTranslation();
+				pVRMoveCam.SetRoll(fVRMoveRoll);
+				if(vVRMove.x > 12344.0f && vVRMove.x < 12346.0f &&
+					cMath_Abs(vVRMove.y) <= 1.01f && cMath_Abs(vVRMove.z) <= 1.01f &&
+					(cMath_Abs(vVRMove.y) > 0.001f || cMath_Abs(vVRMove.z) > 0.001f))
+				{
+					cScrPlayer::OnAnalogInput(alAnalogId, cVector3f(vVRMove.y, vVRMove.z, 0.0f));
+					return;
+				}
+			}
+		}
+
=82
+		VRTimeMark(7078); // BunkerVR: timing (to the end of Update)
=2
+
+		////////////////////////////////////
+		// BunkerVR: no force field around the feet.
+		// While the player walks, the game pushes loose objects within about a
+		// meter of the feet aside (the "foot force field"). In VR objects are
+		// picked up from the floor by hand, and a can that rolls away at every
+		// step toward it can't be. With the VR mod running (known once it has
+		// answered, see mbVRFaceGlow) the field is off.
+		if(mbVRFaceGlow)
+		{
+			cForceField@ pVRFootField = cLux_ID_ForceField(mFootForceField);
+			if(pVRFootField !is null && pVRFootField.IsActive()) pVRFootField.SetActive(false);
+
+			// And the body walks into light objects much more gently. The game
+			// kicks anything up to 10 kg out of the way with a sharp shove
+			// (push impulse 100, force up to 300), and small objects then roll
+			// off before a hand can reach them. Even a tenth of that kicks away
+			// what a crouching player reaches for, since the body is right on
+			// top of it. So there is no shove at all and only a slight push:
+			// loose objects are nudged slowly, or get in the way, but are not
+			// sent off. The field's own force is zeroed too, as the game fades
+			// it back in when the player starts walking.
+			if(pVRFootField !is null) pVRFootField.SetForce(0.0f);
+			iCharacterBody@ pVRCharBody = mBaseObj.GetCharacterBody();
+			// (And only objects under 1 kg count as pushed at all. The game
+			// pushes anything up to 10 kg, and a pushed object does not stop
+			// the body; pushed this gently, a door (2 kg the metal one, 5 the
+			// wooden one) or a crate would hardly move and the body would walk
+			// right into it. This way they stop the body as walls do.)
+			if(pVRCharBody !is null && (pVRCharBody.GetPushImpulse() > 0.5f || pVRCharBody.GetMaxPushForce() > 4.0f || pVRCharBody.GetMaxPushMass() > 1.01f))
+			{
+				pVRCharBody.SetPushImpulse(0.0f);
+				pVRCharBody.SetMaxPushForce(3.0f);
+				pVRCharBody.SetMaxPushMass(1.0f);
+			}
+		}
=2
