=1658
+	
+	// BunkerVR: a timing mark for the VR mod's log (7070 + 2 x the piece of
+	// work's number at its start, 7071 + 2 x it at its end; the mod times the
+	// gap, see CameraLogScriptTimings). Does nothing without the mod. Sent
+	// over the direct line (cVR_TimeMark).
+	void VRTimeMark(int alCode)
+	{
+		cVR_TimeMark(alCode);
+	}
+
+	// BunkerVR: the flashlight has been wound by its cord (the VR mod's way).
+	// The hint about winding it is done with, as when the game's own way is
+	// used (PlayerState_UsingLantern adds it as given). Otherwise it is
+	// shown each time the lamp is taken out (ItemCallbacks.OnHeld) and
+	// never goes away.
+	void _Global_VRLanternWound()
+	{
+		tString sHint = Hint_GetCurrentEntry();
+		if (sHint == "HintDynamoLantern" || sHint == "HintDynamoLantern_Toggle")
+			Hint_StopHint();
+		Hint_AddAsGiven("Hints", "HintDynamoLantern");
+		Hint_AddAsGiven("Hints", "HintDynamoLantern_Toggle");
+	}
=196
+	// BunkerVR: the gas mask put on by hand in the headset (VRUpdateMask in
+	// PlayerBodyHandler.hps: the hand brought it to the face):
+	// on at once, as the game's own putting on ends (the level's callbacks,
+	// the mask's look and breathing, the muffled hearing), without its
+	// animation or its fades.
+	void _Global_VRPutOnGasMask()
+	{
+		if (mbGasMask_Equipped || mbGasMask_Equipping) return;
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		if (pMap is null) return;
+		
+		tString sCallback = "void OnGasMaskStartEquip()";
+		if (pMap.ScriptMethodExists(sCallback) && pMap.ScriptPrepare(sCallback))
+			pMap.ScriptExecute();
+		
+		cLux_IncHideModeEffectUserCount();
+		cLux_SetHideModeEffectsActive(true);
+		mbGasMask_Equipped = true;
+		SetGasmaskEffectActive(true);
+		
+		sCallback = "void OnGasMaskEquip()";
+		if (pMap.ScriptMethodExists(sCallback) && pMap.ScriptPrepare(sCallback))
+			pMap.ScriptExecute();
+	}
+	
+	//------------------------------------------------------------
+	
+	// BunkerVR: ...and taken off by hand (pulled off the face): off at once,
+	// as the game's own taking off ends.
+	void _Global_VRTakeOffGasMask()
+	{
+		if (mbGasMask_Equipped == false || mbGasMask_Equipping) return;
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		tString sCallback = "void OnGasMaskStartUnequip()";
+		if (pMap !is null && pMap.ScriptMethodExists(sCallback) && pMap.ScriptPrepare(sCallback))
+			pMap.ScriptExecute();
+		
+		mbGasMask_Equipped = false;
+		UnequipGasMask(false);
+	}
+	
+	//------------------------------------------------------------
+	
+	// BunkerVR: is the game's own putting on or taking off of the mask under
+	// way (its animation)?
+	void _Global_VRGasMaskEquipping()
+	{
+		cScript_SetGlobalReturnBool(mbGasMask_Equipping || mfGasMaskEquipStartDelay > 0.f || mfGasMaskUnequipStartDelay > 0.f);
+	}
+	
+	//------------------------------------------------------------
+	
end
