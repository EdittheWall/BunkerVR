=101
+	[nosave] bool mbVRFaceGlow = false; // BunkerVR: the VR mod is drawing the hurt and heal glows
=39
+		// BunkerVR: the hit is passed to the VR mod for its hit indicator (vr.cpp VrHurt): the view's edge reddened on
+		// the side it came from, an impact in the hands.
+		if (cVR_Active() && aType != eDamageType_Silent) VRTellHurt(afAmount, aType, a_idSource);
+		
=205
+	// BunkerVR: how hard the hit was and where it came from, for the VR mod's hit indicator: a fall from below; a hit
+	// with a source (the shotgunner, a trench German's shot, a rat) as a direction from the camera at this moment (x right,
+	// y up, z ahead), an agent's from its chest rather than its feet; anything else from all around.
+	void VRTellHurt(float afAmount, int aType, tID a_idSource)
+	{
+		if (aType == eDamageType_Fall || aType == eDamageType_FallBig)
+		{
+			cVR_Hurt(afAmount, 2, 0.0f, 0.0f, 0.0f);
+			return;
+		}
+		iLuxEntity@ pSource = cLux_ID_Entity(a_idSource);
+		cCamera@ pCam = mBaseObj.GetCamera();
+		if (pSource is null || pCam is null)
+		{
+			cVR_Hurt(afAmount, 0, 0.0f, 0.0f, 0.0f);
+			return;
+		}
+		cVector3f vFrom = pSource.GetPosition() + cVector3f(0.0f, cLux_ID_Agent(a_idSource) !is null ? 0.9f : 0.0f, 0.0f) - pCam.GetPosition();
+		cVR_Hurt(afAmount, 1, cMath_Vector3Dot(vFrom, pCam.GetRight()), cMath_Vector3Dot(vFrom, pCam.GetUp()), cMath_Vector3Dot(vFrom, pCam.GetForward()));
+	}
+	
=18
-1
+		// BunkerVR: not in the headset. There the shake is kept out of the view and felt only as an even buzz in both
+		// hands (VRShakeAsBuzz), which a frame later would override the hit's own impact, sent just before by
+		// OnDamageTaken (cVR_Hurt: harder in the hand on the hit's side, then a heartbeat after a hard one).
+		if (!cVR_Active()) Effect_Shake_Start(afShake, 0.25, 0.05, 0.1f);
=65
+		/////////////////
+		// BunkerVR: the red edges when hurt and the pale glow when healed are
+		// drawn here as part of the game's flat interface, so in the headset
+		// they would show on the panel floating in front of the player. With the VR mod
+		// running they are not drawn here: the mod is told how strong each is
+		// and draws them across both eyes. It answers through the camera:
+		// after setting a special roll value, reading the camera's matrix
+		// returns its data (12345 as its first number). The strengths travel
+		// in the camera's position, which is put straight back.
+		mbVRFaceGlow = false;
+		cCamera@ pVRGlowCam = mBaseObj.GetCamera();
+		if (pVRGlowCam !is null)
+		{
+			float fVRGlowRoll = pVRGlowCam.GetRoll();
+			pVRGlowCam.SetRoll(7006.0f);
+			cVector3f vVRGlowStatus = pVRGlowCam.GetMatrix().GetTranslation();
+			if (vVRGlowStatus.x > 12344.0f && vVRGlowStatus.x < 12346.0f && vVRGlowStatus.y > 0.5f)
+			{
+				mbVRFaceGlow = true;
+				float fVRHurt = fAlpha > 0.f ? gfxBrightVignette.mColor.a : 0.f;
+				float fVRHeal = mbHealingFxActive ? ImGui_GetStateFloat("HealingFxAlpha", 0.f) : 0.f;
+				cVector3f vVRGlowPos = pVRGlowCam.GetPosition();
+				pVRGlowCam.SetPosition(cVector3f(fVRHurt, fVRHeal, 0.f));
+				pVRGlowCam.SetRoll(7025.0f);
+				pVRGlowCam.GetMatrix();
+				pVRGlowCam.SetPosition(vVRGlowPos);
+			}
+			pVRGlowCam.SetRoll(fVRGlowRoll);
+		}
+		if (mbVRFaceGlow) return;
+		
=544
+		//////////////////////////////////////////
+		// BunkerVR: no crosshair while a hand does the pointing.
+		// The crosshair marks the middle of the view, but with the VR mod things
+		// are picked by pointing a hand, so it would only mislead. The VR mod
+		// answers through the camera: after setting a special roll value, reading
+		// the camera's matrix returns its answer instead. Without the mod (or with
+		// no hand tracked) the answer does not match and the crosshair is drawn.
+		cCamera@ pVRCam = mBaseObj.GetCamera();
+		if(pVRCam !is null)
+		{
+			float fVRRealRoll = pVRCam.GetRoll();
+			pVRCam.SetRoll(7004.0f);
+			cVector3f vVRStatus = pVRCam.GetMatrix().GetTranslation();
+			pVRCam.SetRoll(fVRRealRoll);
+			if(vVRStatus.x > 12344.0f && vVRStatus.x < 12346.0f && vVRStatus.y > 0.5f) return;
+		}
+		
