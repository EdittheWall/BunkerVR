+			///////////////////
+			// BunkerVR: while it burns in the player's hand (lit by its cord,
+			// PlayerState_UsingFlare.hps) it never counts as stopped, so it
+			// leaves no blocker for the creatures' paths until it is let go.
+			if (cScript_GetGlobalVarBool("BunkerVR_FlareInHand_" + mBaseObj.GetName()))
+			{
+				mvPrevPos = mBaseObj.GetPosition();
+				mfStoppedCount = 0;
+			}
+
end
