=39
+		// BunkerVR: thrown unlit by hand, the spill is left unlit, to be lit
+		// later (see VRThrownUnlit).
+		if (VRThrownUnlit()) return;
=2
+
+	// BunkerVR: was this molotov thrown by hand without its cloth set burning?
+	// The hand throw sets a flag under the name of the molotov that the thrown
+	// one breaks into (VRThrow in PlayerState_UsingThrowable.hps); a flag never
+	// set reads false.
+	bool VRThrownUnlit()
+	{
+		return cScript_GetGlobalVarBool("BunkerVR_UnlitMolotov_" + mBaseObj.GetName());
+	}
end
