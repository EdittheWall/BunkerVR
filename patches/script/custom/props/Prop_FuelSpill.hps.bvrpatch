+// BunkerVR: how many spills' fire preloads have been timed in the log (at most 20).
+int glVRSpillPreloadNotes = 0;
+
=42
+		uint lVRStart = cSystem_GetApplicationTime(); // BunkerVR: the preload is timed for the log
=4
