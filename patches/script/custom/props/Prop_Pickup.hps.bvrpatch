+		// BunkerVR: a gun picked up in the headset goes straight into the
+		// hand, held: the pick-up's own "make held" flag is set and the gun
+		// is not put away after.
+		bool bVRToHand = (msType == "Gun" || msType == "Shotgun") && cVR_Active();
+		if (bVRToHand) Log("BunkerVR: " + mBaseObj.GetName() + " (" + msType + ") picked up into the hand\n");
=1
-1
+		pHandler.PickUpEntity(mBaseObj.GetName(), bVRToHand, bVRToHand ? false : mbPutAwayAfter, mbDestroyEntityOnPickup);
=8
+	
+	// BunkerVR: picks the item up as it reaches the hand that pulled it in
+	// (see VRDoPull in PlayerBodyHandler.hps), as when the player interacts
+	// with it: same rules (inventory full, only one needed) and its sound.
+	// Returns (as the global return) whether it was picked up. Goes through
+	// the entity's own interaction, as the game's pick does
+	// (PlayerState_Normal.hps), so the map's own callback for it runs too.
+	// Calling this class's OnInteract directly would skip it: the map with
+	// the soldier's gun in the bunker waits in OnInteract_PickupGun.
+	void _Global_VRPickUp()
+	{
+		iLuxEntity@ pSelf = cLux_ID_Entity(mBaseObj.GetID());
+		if(pSelf is null)
+		{
+			cScript_SetGlobalReturnBool(OnInteract(0, null, mBaseObj.GetPosition(), ""));
+			return;
+		}
+		cScript_SetGlobalReturnBool(pSelf.OnInteract(0, pSelf.GetMainBody(), mBaseObj.GetPosition(), ""));
+	}
+	
+	//------------------------------------------------------------
end
