=922
+		// BunkerVR: in the headset the watch is wound by hand (VRUpdateWatch in
+		// PlayerBodyHandler.hps: its crown pinched and twisted, then pressed):
+		// it waits, stopped, until then.
+		if (cVR_Active())
+		{
+			PocketWatch_ForceWindUp();
+			return;
+		}
+
=91
+	// BunkerVR: in the headset its button is pressed by hand to start it
+	// (VRUpdateWatch in PlayerBodyHandler.hps).
+	if (cVR_Active())
+	{
+		cScript_SetGlobalVarInt("BunkerVR_WatchPress", 1);
+		return;
+	}
+	
end
