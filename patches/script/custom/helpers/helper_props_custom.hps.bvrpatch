BunkerVR patch 1
file script/custom/helpers/helper_props_custom.hps
from 84be37f32e9904180e5dde6019e1a4140f8798e924986897def7923f55440441 20292
to 77eeffa55614768ad1e5edd4b325cb21c0be9b46f3dddb25dc3f657baeddfca6 21571
=262
+	// BunkerVR: in VR the other hand's item (the lantern) comes back only once the hands are free (the normal state,
+	// and not the shotgun in hand, whose aim drops to it for a sprint while the left hand is on its pump), tried again
+	// until then: not into a hand gripping a door or the pump, and never lost when the item's state comes back first.
+	if (cVR_Running())
+	{
+		if (lState == ePlayerState_Normal && Item_GetHeldType(eItemHandlerHand_Right) != "Shotgun") Item_TakeOut(asTimer);
+		else
+		{
+			cLuxMap@ pMap = cLux_GetCurrentMap();
+			if (pMap !is null) pMap.AddTimer(asTimer, 0.5f, "$_UsingItem_OnTimer_EquipLastItem");
+		}
+		return;
+	}
=366
+	// BunkerVR: in the headset, a fuse screwed into the box by hand
+	// (VRUpdateFit in PlayerBodyHandler.hps; "BunkerVR_FitIn") plays no scene
+	// (the scene takes over the body and screws the fuse in on its own). A
+	// moment later, on a timer outside the game's use as the scene's own timer
+	// does it, the box's own fuse is put where the held one is and the held one
+	// goes. With the use button the scene plays as usual.
+	if (cVR_Active() && cScript_GetGlobalVarInt("BunkerVR_FitIn") == 1)
+	{
+		pMap.AddTimer(Item_GetHeld(eItemHandlerHand_Right), 0.05f, "$_Fuse_OnTimer_PlaceInFuseBox");
+		return;
+	}
+	
end
