+	// BunkerVR: tell the VR mod whether the game's loading screen is up. This
+	// script also runs during loading screens. A loading screen that waits for
+	// a button already has the new level drawn behind it, which the headset
+	// would show around the loading picture; the mod keeps the eyes black
+	// until this says the screen is gone. (News goes to the mod in the
+	// camera's position with the special roll value 7027; both are put
+	// straight back.)
+	void VRSendLoadingNews()
+	{
+		cLuxPlayer@ pNewsPlayer = cLux_GetPlayer();
+		cCamera@ pNewsCam = pNewsPlayer !is null ? pNewsPlayer.GetCamera() : null;
+		if (pNewsCam is null) return;
+		
+		float fRealRoll = pNewsCam.GetRoll();
+		cVector3f vRealPos = pNewsCam.GetPosition();
+		pNewsCam.SetPosition(cVector3f(cLux_IsLoadingScreenVisible() ? 1.0f : 0.0f, 0.0f, 0.0f));
+		pNewsCam.SetRoll(7027.0f);
+		pNewsCam.GetMatrix();
+		pNewsCam.SetRoll(fRealRoll);
+		pNewsCam.SetPosition(vRealPos);
+	}
+	
+	// BunkerVR: the main menu's room (vr.cpp UpdateMenuRoom): every frame
+	// while the main menu is up, how far the game's camera stands above that
+	// room's floor, for the mod to put the floor where the real one is. The
+	// floor is found once: rays down from the camera and four places around
+	// it, taking the median of those that hit (one may hit a pile of rubble,
+	// one fall through a gap).
+	void VRSendMenuRoom()
+	{
+		if(mbMenuActive == false || cVR_Active() == false) return;
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		if(pMap is null || pMap.GetName() != "main_menu") return;
+		if(mfVRMenuFloorBelow < 0.0f && mbVRMenuFloorLooked == false)
+		{
+			mbVRMenuFloorLooked = true;
+			iLuxEntity@ pNode = pMap.GetEntityByName("CameraAnimation_1", eLuxEntityType_Area);
+			if(pNode !is null)
+			{
+				array<float> vHits;
+				for(int i = 0; i < 5; ++i)
+				{
+					cVector3f vFrom = pNode.GetPosition() + cVector3f(i == 1 ? 0.4f : (i == 2 ? -0.4f : 0.0f), 0.0f, i == 3 ? 0.4f : (i == 4 ? -0.4f : 0.0f));
+					float fDistance = 0.0f;
+					cVector3f vNormal = cVector3f(0.0f);
+					if(cLux_GetClosestBody(vFrom, cVector3f_Down, 3.0f, fDistance, vNormal) !is null) vHits.push_back(fDistance);
+				}
+				vHits.sortAsc();
+				if(vHits.length() > 0) mfVRMenuFloorBelow = vHits[vHits.length() / 2];
+				Log("BunkerVR: the main menu's floor is " + mfVRMenuFloorBelow + " below its camera (" + vHits.length() + " of 5 rays hit)\n");
+			}
+		}
+		cVR_MenuRoom(mfVRMenuFloorBelow);
+
+		// The main menu fully in view: this level's fade from black over (5 s, main_menu.hps OnEnter),
+		// the title shown, the first page up. The mod's start-up page appears a moment after.
+		if(mbPremenuActive == false && mbWelcomeScreen == false && mCurrentGroup == eMainMenuGroup_Main &&
+		   Effect_Fade_IsFading() == false && Effect_Fade_GetAlpha() < 0.01f && mfBackgroundTitleAlpha > 0.99f)
+			cVR_MenuInView();
+	}
+
+	// BunkerVR: the room blurred behind the mod's start-up page (the mod also darkens it):
+	// the game's own depth of field, as for checking health, sharp only within 10 cm (the
+	// page is a layer of its own), faded in and out over half a second. Here because this
+	// module's OnGui runs in the main menu and in every level.
+	void VRUpdateStartupBlur()
+	{
+		bool bWanted = cVR_Active() && cVR_RoomBlurred();
+		if(bWanted == (mlVRStartupBlur > 0)) return;
+		if(bWanted)
+		{
+			mlVRStartupBlur = Effect_DoF_Start(0.0f, 0.1f, 1.0f, 0.5f);
+			Log("BunkerVR: the start-up page is up: the room blurred\n");
+		}
+		else
+		{
+			Effect_DoF_FadeOut(mlVRStartupBlur, 0.5f);
+			mlVRStartupBlur = 0;
+			Log("BunkerVR: the start-up page is put away: the room sharp again\n");
+		}
+	}
+
+	// BunkerVR: debug jumps ("Take me there" in the mod's debug menu; testlist.h in
+	// the mod): the level, the start spot in it, then the items the check needs at
+	// hand. Here because this module's OnGui runs in the main menu and in every
+	// level, the game paused or not. Done the way the game's own debug page changes
+	// the map (GuiOptionsDebug); the level scripts skip their openings while
+	// cVR_Jumping() says so; after a jump nothing is saved (SaveRoomHandler.hps)
+	// until a real game is started or loaded. The target is read from the mod each
+	// time, never kept here: a new game sets this module up afresh and loses what
+	// it held, so a jump from the main menu would never arrive and would block
+	// every jump after it.
+	[nosave] float mfVRJumpWaited = 0.0f;	// seconds since it began
+	[nosave] float mfVRJumpInMap = 0.0f;	// seconds in the level wanted
+	[nosave] bool mbVRJumpAgainSeen = false;	// the jump under way is the last one again, after a death, and its waits have restarted
+
+	void VRUpdateJump(float afTimeStep)
+	{
+		if(cVR_JumpWanted())
+		{
+			VRJumpStart();
+			return;
+		}
+		if(cVR_Jumping() == false)
+		{
+			mbVRJumpAgainSeen = false;
+			return;
+		}
+		// A jump made again after a death (GameOverHandler.hps VRJumpRestart starts the level
+		// afresh itself, nothing is wanted here): its waits restart when it is first seen, then
+		// it arrives as any jump does.
+		if(mbVRJumpAgainSeen == false && cVR_JumpText(2) == "again")
+		{
+			mbVRJumpAgainSeen = true;
+			mfVRJumpWaited = 0.0f;
+			mfVRJumpInMap = 0.0f;
+		}
+
+		tString sMap = cVR_JumpText(0);
+		mfVRJumpWaited += afTimeStep;
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		if(pMap !is null && (sMap == "" || pMap.GetName() + ".hpm" == sMap))
+			mfVRJumpInMap += cMath_Min(afTimeStep, 0.1f); // (the first step after a load can be long)
+		if(mfVRJumpInMap >= 1.0f)
+		{
+			VRJumpArrived();
+		}
+		else if(mfVRJumpWaited > 180.0f)
+		{
+			Log("BunkerVR: jump: " + sMap + " did not come in 3 minutes; given up\n");
+			cVR_JumpDone();
+		}
+	}
+
+	void VRJumpStart()
+	{
+		tString sMap = cVR_JumpText(0);
+		tString sStart = cVR_JumpText(1);
+		mfVRJumpWaited = 0.0f;
+		mfVRJumpInMap = 0.0f;
+		Log("BunkerVR: jump: to level \"" + sMap + "\", start spot \"" + sStart + "\"\n");
+
+		// (A scene the body is playing, a level's own, is ended first: left on, it goes with the player into the next
+		// level, the body frozen. PlayerBodyHandler.hps VREndSceneForJump.)
+		if(mbMainMenuActive == false && cLux_GetPlayer() !is null)
+		{
+			iScrPlayerBodyHandler_Interface@ pJumpBody = cast<iScrPlayerBodyHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_PlayerBodyHandler));
+			if(pJumpBody !is null) pJumpBody.VREndSceneForJump();
+		}
+
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		if(sMap == "" || (pMap !is null && pMap.GetName() + ".hpm" == sMap))
+		{
+			VRJumpToStartSpot(sStart); // already in this level: no load
+		}
+		else if(mbMainMenuActive)
+		{
+			VRJumpStartGameAt(sMap, sStart);
+		}
+		else
+		{
+			if(mbMenuActive) SetMenuActive(false);
+			mbGameOver = false;
+			Map_ChangeMap(sMap, sStart, "", "", true, true);
+			cLux_ClearPlayedVoiceLines();
+		}
+	}
+
+	// From the main menu: what StartNewGame does, leaving out the save slot it
+	// clears and chooses (nothing of the player's is touched: a jump saves
+	// nothing), and starting in the level wanted.
+	void VRJumpStartGameAt(const tString &in asMap, const tString &in asStart)
+	{
+		cVR_NewGame(); // BunkerVR: a new game at that level: the hints start again
+		GameStats_ResetAllEntries(false);
+		SetMenuActive(false);
+		cLux_LoadScreenSetOneShotSolidColorBackground();
+		mbGameOver = false;
+		mbWelcomeScreen = false;
+		msPreviousSaveLoaded = "";
+		MainMenu_SetPhase_Items(eMainMenuPhase_Items_None);
+		MainMenu_Sketchbook_SetSketch("loadscreen_1aa");
+		MainMenu_SetPhase_Ghoul(0);
+		Sketchbook_OnNewGame();
+		cLux_SetGameDifficulty(mlSelectedGameMode);
+		GameDifficulty_SwitchSettingsPresetTo(mlSelectedGameMode);
+		array<int> vDifficultySettingValueIDs = GameDifficulty_GetSettingsSelectedValueIDs();
+		cLux_StartNewGame(asMap, asStart);
+		GameDifficulty_SetSettingsSelectedValueIDs(vDifficultySettingValueIDs, true);
+		GameDifficulty_SetInitialPlaythroughConditions(true);
+		Item_OnNewGame();
+	}
+
+	void VRJumpToStartSpot(const tString &in asStart)
+	{
+		if(asStart == "") return;
+		array<tString> vStarts;
+		cLux_GetStartPositions(vStarts);
+		for(uint i = 0; i < vStarts.length(); ++i)
+		{
+			if(vStarts[i] != asStart) continue;
+			cLux_TeleportToStartPos(asStart);
+			return;
+		}
+		Log("BunkerVR: jump: this level has no start spot \"" + asStart + "\" (" + vStarts.length() + " listed)\n");
+	}
+
+	void VRJumpArrived()
+	{
+		// After a death: the level was started afresh at its own start; back to the spot jumped to.
+		bool bAgain = cVR_JumpText(2) == "again";
+		if(bAgain) VRJumpToStartSpot(cVR_JumpText(1));
+		mbVRJumpAgainSeen = false;
+		Sketchbook_SetCanOpen(true); // (the end of each level's opening does this, and a jump has skipped it)
+		if(cVR_JumpText(10) != "") Item_SetCurrentSlotsCount(Item_GetMaxSlotsCount());
+		for(int i = 0; i < 8; ++i)
+		{
+			tString sItem = cVR_JumpText(10 + i);
+			if(sItem == "") break;
+			if(ItemType_GetCountInInventory(sItem) == 0) Item_AddToInventory(sItem);
+		}
+		// A jump starts clean: the dream's smoke, left on by a jump out of a dream scene, would
+		// show in the levels after it, and a hurt player would be stopped by a hint card.
+		if(cVR_JumpSkipsOpening())
+		{
+			cScript_SetGlobalArgFloat(0, 0.f);
+			cScript_SetGlobalArgFloat(1, 0.f);
+			cScript_RunGlobalFunc("LuxPlayer", "", "_Global_FadeDreamLights");
+			if(cLux_GetPlayer() !is null) cLux_GetPlayer().SetHealth(1.f);
+		}
+		tString sMap = cVR_JumpText(0);
+		Log("BunkerVR: jump: arrived in \"" + sMap + "\" after " + mfVRJumpWaited + " s" + (bAgain ? " (again, after a death)" : "") + "\n");
+		cVR_JumpDone(); // (the mod then asks the body script for what is to be made and pressed)
+	}
+
+	// BunkerVR: at the first start in the headset, the game's own graphics settings set to the mod's
+	// recommended ones for VR, lighter than the game's defaults (each eye's world is drawn at the
+	// window's size, both every frame, at the headset's 72 to 120 frames a second): the heaviest
+	// effects off or lower, and film grain off (its noise differs between the eyes). As the game's
+	// options menu sets them, saved and applied, so the options menu shows them. Only lowered, never
+	// raised; and only this once (cVR_RecommendedGraphicsOnce: the mod's settings remember it), so
+	// whatever the player sets afterwards is kept for good. Only in the main menu, never while playing
+	// (a headset that starts following the head after a save is loaded waits for the main menu).
+	void VRRecommendedGraphics()
+	{
+		if(mbMenuActive == false || cVR_Active() == false) return;
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		if(pMap is null || pMap.GetName() != "main_menu") return;
+		cConfigFile@ pConfig = cLux_GetUserConfig();
+		if(pConfig is null || cVR_RecommendedGraphicsOnce() == false) return;
+		tString sChanged = "";
+		if(pConfig.GetBool("Graphics", "SSAOActive", true))
+		{
+			pConfig.SetBool("Graphics", "SSAOActive", false);
+			sChanged += " ambient occlusion off;";
+		}
+		if(pConfig.GetBool("Graphics", "WorldReflection", true))
+		{
+			pConfig.SetBool("Graphics", "WorldReflection", false);
+			sChanged += " world reflections off;";
+		}
+		if(pConfig.GetBool("Graphics", "Refraction", true))
+		{
+			pConfig.SetBool("Graphics", "Refraction", false);
+			sChanged += " refraction off;";
+		}
+		if(pConfig.GetInt("Graphics", "ShadowResolution", 2) > 1)
+		{
+			pConfig.SetInt("Graphics", "ShadowResolution", 1);
+			pConfig.SetBool("Graphics", "BodyShadows", false); // (as the options menu has it: the body's shadow only above medium)
+			sChanged += " shadow detail medium;";
+		}
+		if(pConfig.GetInt("Graphics", "DirLightSliceNum", 4) > 2)
+		{
+			pConfig.SetInt("Graphics", "DirLightSliceNum", 2);
+			sChanged += " the sun's shadows in 2 slices;";
+		}
+		if(pConfig.GetInt("Graphics", "TerrainTessellation", 0) > 0 || pConfig.GetInt("Graphics", "TerrainQuality", 0) > 0)
+		{
+			pConfig.SetInt("Graphics", "TerrainQuality", 0); // (the options menu's tessellation row sets both)
+			pConfig.SetInt("Graphics", "TerrainTessellation", 0);
+			sChanged += " ground tessellation off;";
+		}
+		if(pConfig.GetBool("Graphics", "FilmGrainActive", true))
+		{
+			pConfig.SetBool("Graphics", "FilmGrainActive", false);
+			sChanged += " film grain off;";
+		}
+		if(sChanged == "")
+		{
+			Log("BunkerVR: the recommended graphics for the headset, this once: all already as light (nothing changed)\n");
+			return;
+		}
+		if(cLux_GetSaveConfigAtExit()) pConfig.Save();
+		bool bRestart = cLux_ApplyUserConfig();
+		Log("BunkerVR: the game's graphics set to the recommended ones for the headset, this once:" + sChanged +
+			(bRestart ? " (the game applies some at its next start)" : "") + "\n");
+	}
+
+	// BunkerVR: the headset taken off, or its own menu opened (SteamVR's dashboard, the Meta menu):
+	// the game paused as its menu button pauses it, once each time the headset is away, wherever the
+	// game lets its menu open (not while loading, in the main menu, or where the game keeps it shut).
+	// An open inventory is shut first, as the menu button shuts it. Back in the headset, the player
+	// finds the game's menu and goes on from it.
+	[nosave] bool mbVRPausedWhileAway = false;
+	void VRPauseWhileAway()
+	{
+		if(cVR_HeadsetAway() == false)
+		{
+			mbVRPausedWhileAway = false;
+			return;
+		}
+		if(mbVRPausedWhileAway || mbMenuActive) return;
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		if(pMap is null || pMap.GetName() == "main_menu" || LoadScreen_IsVisible() || GameStats_GetGuiActive() || mbPauseMenuEnabled == false) return;
+		if(Sketchbook_IsOpen())
+		{
+			Sketchbook_Close();
+			return;
+		}
+		mbVRPausedWhileAway = true;
+		mbMainMenuActive = false;
+		mfTransitionAlpha = 1.f;
+		SetMenuActive(true);
+		mbPauseSoundDelay = true;
+		if (mlBlurID == -1) mlBlurID = Effect_Blur_Start(1,0);
+		Log("BunkerVR: the headset is away (taken off, or its own menu open): the game is paused\n");
+	}
+
+	// BunkerVR: the headset software's own Quit (or the software closing) closes the game, as its Exit
+	// button does: VR games close when the headset's menu quits them.
+	[nosave] bool mbVRQuitting = false;
+	void VRQuitWhenAsked()
+	{
+		if(mbVRQuitting || cVR_QuitAsked() == false) return;
+		mbVRQuitting = true;
+		Log("BunkerVR: the headset software asked the game to close: the game exits\n");
+		if(mbMenuActive) SetMenuActive(false);
+		cLux_Exit();
+	}
+
