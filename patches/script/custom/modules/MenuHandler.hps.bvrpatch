=477
+	// BunkerVR: the VR menu. It is opened by its own button on the first page
+	// of the main menu (and of the pause menu), not from Options. Its first
+	// page lists six pages of settings, named and grouped as native VR games
+	// do (the mod's own menu in the headset, Y, uses the same names): player,
+	// comfort, movement, hands, accessibility, system; and Recalibrate.
+	//
+	// The settings themselves are kept by the VR mod (BunkerVR_settings.txt).
+	// These pages ask the mod what each one is set to and tell it when one is
+	// changed. The mod answers through the camera: after setting a special
+	// roll value, reading the camera's matrix returns the mod's data instead
+	// (12345 as its first number, the choice as its second). Without the mod
+	// the answer does not match, and the pages show the first choice of each.
+	// Settings 0 to 9 have a roll value each (7040 + number to ask, 7050 +
+	// number to set). The rest share two: 7060 asks and 7061 sets, with the
+	// setting's number (and the choice) put in the camera's position first.
+	int VRGetOption(int alIndex)
+	{
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		cCamera@ pCam = pPlayer !is null ? pPlayer.GetCamera() : null;
+		if(pCam is null) return -1;
+
+		float fRealRoll = pCam.GetRoll();
+		cVector3f vAnswer = cVector3f(0.0f, 0.0f, 0.0f);
+		if(alIndex < 10)
+		{
+			pCam.SetRoll(7040.0f + float(alIndex));
+			vAnswer = pCam.GetMatrix().GetTranslation();
+		}
+		else
+		{
+			cVector3f vRealPos = pCam.GetPosition();
+			pCam.SetPosition(cVector3f(float(alIndex), 0.0f, 0.0f));
+			pCam.SetRoll(7060.0f);
+			vAnswer = pCam.GetMatrix().GetTranslation();
+			pCam.SetPosition(vRealPos);
+		}
+		pCam.SetRoll(fRealRoll);
+
+		if(vAnswer.x < 12344.0f || vAnswer.x > 12346.0f) return -1;
+		return int(vAnswer.y + 0.5f);
+	}
+
+	void VRSetOption(int alIndex, int alChoice)
+	{
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		cCamera@ pCam = pPlayer !is null ? pPlayer.GetCamera() : null;
+		if(pCam is null) return;
+
+		// The choice travels in the camera's position, which is put straight back.
+		cVector3f vRealPos = pCam.GetPosition();
+		float fRealRoll = pCam.GetRoll();
+		if(alIndex < 10)
+		{
+			pCam.SetPosition(cVector3f(float(alChoice), 0.0f, 0.0f));
+			pCam.SetRoll(7050.0f + float(alIndex));
+		}
+		else
+		{
+			pCam.SetPosition(cVector3f(float(alIndex), float(alChoice), 0.0f));
+			pCam.SetRoll(7061.0f);
+		}
+		pCam.GetMatrix();
+		pCam.SetRoll(fRealRoll);
+		pCam.SetPosition(vRealPos);
+	}
+
+	// The World Scale row's choices (the mod's option 14): the calibrated scale
+	// (option 44, in thousandths) with -10%, -5%, 0, +5% and +10% of it, each
+	// named by the scale it gives, in percent.
+	array<tString> VRSizeLabels()
+	{
+		int lCalibrated = VRGetOption(44);
+		if(lCalibrated <= 0) lCalibrated = 1000;
+		array<tString> vLabels;
+		for(int i = -2; i <= 2; i++)
+		{
+			int lPercent = int(float(lCalibrated) * (1.0f + 0.05f * float(i)) / 10.0f + 0.5f);
+			vLabels.push_back("" + lPercent + "%");
+		}
+		return vLabels;
+	}
+
+	// One row of a page: a setting with a list of choices (their names looked up
+	// in the language file's asCategory; "": shown as they are).
+	void VROptionRow(const array<tString> &in avMenuItems, int alOption, const array<tString> &in avChoices, cVector2f avRightAnchor, cVector3f avInfoBoxPos, const tString &in asCategory = "menu")
+	{
+		if (OptionMenu_CheckOutOfLimits(mlCurrentItemId) == false)
+		{
+			int lValue = VRGetOption(alOption);
+			bool bModHere = lValue >= 0;
+			if (lValue < 0 || lValue >= int(avChoices.length())) lValue = 0;
+
+			int lNewValue = OptionMenu_ButtonOptionsMultiSelect(avMenuItems[mlCurrentItemId-mlFirstItemId], kOptionsAccessibilityButtonPos, mlCurrentItemId, msSelectedVRButton, avChoices, lValue, false, mlActionHorizontal, asCategory, 0, avRightAnchor, avInfoBoxPos, mfTransitionAlpha, false, false, true, "", cString_To16Char(""), false, false);
+			if (lNewValue != lValue && bModHere)
+			{
+				VRSetOption(alOption, lNewValue);
+			}
+			msSelectedVRButton = OptionMenu_UpdateFocusCustom(avMenuItems, avMenuItems[mlCurrentItemId], msSelectedVRButton);
+		}
+		mlCurrentItemId++;
+	}
+
+	// One row of the VR menu's first page: a button that opens a page.
+	void VRHubItem(const array<tString> &in avMenuItems, eMainMenuGroup aGroup, const tString &in asFirstRow, cVector2f avRightAnchor, cVector3f avInfoBoxPos)
+	{
+		if (OptionMenu_CheckOutOfLimits(mlCurrentItemId) == false)
+		{
+			if(OptionMenu_ButtonOptions(avMenuItems[mlCurrentItemId-mlFirstItemId], kOptionsButtonPos, mlCurrentItemId, msSelectedVRHubButton, false, avRightAnchor, avInfoBoxPos, mfTransitionAlpha))
+			{
+				mlFirstItemId = 0;
+				mlLastInFocus = 0;
+				mTargetGroup = aGroup;
+				msSelectedVRButton = asFirstRow;
+				msTargetFocus = asFirstRow;
+			}
+			msSelectedVRHubButton = OptionMenu_UpdateFocusCustom(avMenuItems, avMenuItems[mlCurrentItemId], msSelectedVRHubButton);
+		}
+		mlCurrentItemId++;
+	}
+
+	// The VR menu's first page's last row, RECALIBRATE ("VR_MeasureAgain"): the mod's start-up
+	// page, Player Setup, from the beginning (the mod's setting 39), for when the measured height
+	// is wrong.
+	void VRHubMeasureAgain(const array<tString> &in avMenuItems, cVector2f avRightAnchor, cVector3f avInfoBoxPos)
+	{
+		if (OptionMenu_CheckOutOfLimits(mlCurrentItemId) == false)
+		{
+			if(OptionMenu_ButtonOptions(avMenuItems[mlCurrentItemId-mlFirstItemId], kOptionsButtonPos, mlCurrentItemId, msSelectedVRHubButton, false, avRightAnchor, avInfoBoxPos, mfTransitionAlpha))
+			{
+				VRSetOption(39, 1);
+				Log("BunkerVR: the start-up page asked for from the VR settings' Measure Again\n");
+			}
+			msSelectedVRHubButton = OptionMenu_UpdateFocusCustom(avMenuItems, avMenuItems[mlCurrentItemId], msSelectedVRHubButton);
+		}
+		mlCurrentItemId++;
+	}
+
+	// The VR menu's first page.
+	void GuiVRHub()
+	{
+		GuiPauseDarkOverlay();
+
+		array<tString> vMenuItems = {"VR_Player", "VR_Comfort", "VR_Movement", "VR_Access", "VR_System", "VR_MeasureAgain"};
+		if (cLux_GetInputHandler().GetGamepadWasLastDeviceUsed()==false)
+			vMenuItems.push_back("Back");
+
+		cVector2f vBgSize = kOptionsBgSize;
+		cVector2f vRightAnchor = cVector2f(kOptionsBgPos.x + vBgSize.x, 0);
+		cVector3f vInfoBoxPos = OptionMenu_GetTopLeftOffset(cVector2f(kOptionsBgPos.x+vBgSize.x-60,0),0);
+
+		DoBackground(vRightAnchor.x + 100);
+
+		////////////////
+		// Title
+		OptionMenu_SectionTitle("VRMenu", kOptionsBgPos + cVector2f(40,-40), 1.f, mfTransitionAlpha);
+
+		ImGui_SetTransCategory("Menu");
+
+		mlCurrentItemId = mlFirstItemId;
+		OptionMenu_SetOutOfLimit(vMenuItems.length());
+
+		VRHubItem(vMenuItems, eMainMenuGroup_VR_Player, "VR_Playing", vRightAnchor, vInfoBoxPos);
+		VRHubItem(vMenuItems, eMainMenuGroup_VR_Comfort, "VR_Turning", vRightAnchor, vInfoBoxPos);
+		VRHubItem(vMenuItems, eMainMenuGroup_VR_Movement, "VR_WalkDir", vRightAnchor, vInfoBoxPos);
+		VRHubItem(vMenuItems, eMainMenuGroup_VR_Access, "VR_Hints", vRightAnchor, vInfoBoxPos);
+		VRHubItem(vMenuItems, eMainMenuGroup_VR_System, "VR_MenuDistance", vRightAnchor, vInfoBoxPos);
+		VRHubMeasureAgain(vMenuItems, vRightAnchor, vInfoBoxPos);
+
+		if (cLux_GetInputHandler().GetGamepadWasLastDeviceUsed()==false)
+			mlCurrentItemId++;
+
+		/////////////////
+		// Back
+		{
+			bool bButton = MainMenu_DoBackButton(msSelectedVRHubButton, mfTransitionAlpha);
+			bool bGamepadBack = ImGui_ActionTriggered(eImGuiAction_Cancel, true);
+
+			if(bButton || bGamepadBack)
+			{
+				mlFirstItemId = 0;
+				mlLastInFocus = 0;
+
+				if (ImGui_TimerExists("TransitionOut") == false)
+					ImGui_AddTimer("TransitionOut", 10);
+
+				mTargetGroup = eMainMenuGroup_Main;
+				msTargetFocus = mbMainMenuActive ? msSelectedMainMenuButton : msSelectedPauseMenuButton;
+
+				if(bGamepadBack == false)
+				{
+					OptionMenu_ShowGamepadButtons(true);
+					return;
+				}
+			}
+
+			if(mlCurrentItemId >= vMenuItems.size())
+				mlCurrentItemId = vMenuItems.size() - 1;
+
+			tString sID = cLux_GetInputHandler().GetGamepadWasLastDeviceUsed() ? vMenuItems[mlCurrentItemId] : "Back";
+			msSelectedVRHubButton = OptionMenu_UpdateFocus(sID, msSelectedVRHubButton);
+		}
+
+		GuiHandleTransition(mTargetGroup, msTargetFocus);
+
+		///////////
+		// Show gamepad legacy
+		OptionMenu_ShowGamepadButtons(true);
+	}
+
