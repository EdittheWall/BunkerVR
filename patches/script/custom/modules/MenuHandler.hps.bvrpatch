+	// BunkerVR: when the running mod is one of the BunkerVR test maps (each its
+	// own stand-alone mod, such as "BunkerVR Grab Test", the title in its
+	// entry.hpc), the menu starts a new game at once, the first time it shows,
+	// as the New Game button does (the "NewGameTimer", then StartNewGame below),
+	// so the room comes up without the logos or the menu, for quick testing.
+	// Done once: the game itself and any other mod are left alone, and back in
+	// the menu later (from the pause menu) it stays.
+	void VRGrabTestAutoStart()
+	{
+		if(gbVRGrabTestStarted) return;
+		if(mbMainMenuActive == false) return;
+		if(ImGui_TimerExists("NewGameTimer")) return;
+		cLuxModHandler@ pMods = cLux_GetModHandler();
+		if(pMods is null || pMods.GetIsRunningMod() == false) return;
+		gbVRGrabTestStarted = true;
+		tString sTitle = pMods.GetMainModTitle();
+		Log("BunkerVR: the running mod is \"" + sTitle + "\"\n");
+		if(sTitle != "BunkerVR Grab Test" && sTitle != "BunkerVR Item Test" && sTitle != "BunkerVR Drawer Test" && sTitle != "BunkerVR Sight Test") return; // (the grab, item, drawer and sight test maps)
+		Log("BunkerVR: the test map \"" + sTitle + "\": its game is started at once\n");
+		ImGui_AddTimer("NewGameTimer", 0.3f);
+	}
+
+	//-------------------------------------------------------
+
+	// BunkerVR: started from a test map's desktop shortcut (the VR mod says so:
+	// VR option 90, see StartedForGrabTest in its vr.cpp), the game's own main
+	// menu opens that test map's mod at once, as its entry in the Mods page does
+	// (LaunchMod_New), as soon as the mod list has it (looked for for up to 15
+	// seconds). That mod's menu then starts its game (VRGrabTestAutoStart). Done
+	// once. Don't have the shortcut pass the mod to the game itself with "-mod":
+	// the game then quits straight after starting.
+	[nosave] int mlVRGrabTestLaunch = 0;			// 0: not asked yet; 1: looking for it in the mod list; 2: done, or not wanted
+	[nosave] float mfVRGrabTestLooking = 0.0f;	// seconds spent looking
+	[nosave] tString msVRTestMapTitle = "BunkerVR Grab Test";	// the test map's mod looked for (its title)
+	void VRGrabTestLaunch(float afTimeStep)
+	{
+		if(mlVRGrabTestLaunch == 2) return;
+		if(mbMainMenuActive == false) return;
+		cLuxModHandler@ pMods = cLux_GetModHandler();
+		if(pMods is null || pMods.GetIsRunningMod())
+		{
+			mlVRGrabTestLaunch = 2;
+			return;
+		}
+		if(mlVRGrabTestLaunch == 0)
+		{
+			// (1: the grab test map's shortcut; 2: the item test map's; 3: the
+			// drawer test map's; 4: the sight test map's.)
+			int lVRWhich = VRGetOption(90);
+			if(lVRWhich != 1 && lVRWhich != 2 && lVRWhich != 3 && lVRWhich != 4)
+			{
+				mlVRGrabTestLaunch = 2;
+				return;
+			}
+			msVRTestMapTitle = lVRWhich == 4 ? "BunkerVR Sight Test" : (lVRWhich == 3 ? "BunkerVR Drawer Test" : (lVRWhich == 2 ? "BunkerVR Item Test" : "BunkerVR Grab Test"));
+			Log("BunkerVR: started from a test map's shortcut: opening \"" + msVRTestMapTitle + "\"\n");
+			pMods.CleanUpListing();
+			pMods.PrepareListing();
+			mlVRGrabTestLaunch = 1;
+			mfVRGrabTestLooking = 0.0f;
+		}
+
+		// (The list's news are taken here as the Mods page takes them; that page
+		// asks for the list afresh whenever it is opened.)
+		while(pMods.HasNextListEvent())
+		{
+			eLuxModEntryListEventType eventType;
+			array<uint32> vEntryIDs;
+			pMods.NextListEvent(eventType, vEntryIDs);
+		}
+		array<uint32> vIDs;
+		array<tString> vNames;
+		array<tWString> vAuthors;
+		array<tString> vPics;
+		pMods.GetModEntriesByName(eLuxModContentType_StandAlone, vIDs, vNames, vAuthors, vPics);
+		for(uint i = 0; i < vIDs.length() && i < vNames.length(); ++i)
+		{
+			if(vNames[i] != msVRTestMapTitle) continue;
+			mlVRGrabTestLaunch = 2;
+			Log("BunkerVR: the test map's mod is in the list (" + vIDs[i] + "): opening it\n");
+			array<uint32> vAddOnIDs;
+			mbHasSaveFiles = false;
+			pMods.LaunchMod_New(vIDs[i], vAddOnIDs);
+			return;
+		}
+		mfVRGrabTestLooking += afTimeStep;
+		if(mfVRGrabTestLooking > 15.0f)
+		{
+			mlVRGrabTestLaunch = 2;
+			Log("BunkerVR: the test map's mod \"" + msVRTestMapTitle + "\" was not found in the mod list (" + vIDs.length() + " mods listed)\n");
+		}
+	}
+
