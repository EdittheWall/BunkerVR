+			VROptionRow(vMenuItems, 17, vOffOn, vRightAnchor, vInfoBoxPos);
+		}
+		else if(alPage == 1)
+		{
+			array<tString> vWalkDir = {"VR_MyHead", "VR_LeftController"};
+			array<tString> vWalkSpeed = {"VR_AlwaysFull", "VR_FollowsStick"};
+			array<tString> vDuckDepth = {"VR_ALittle", "VR_Normal", "VR_ALot"};
+
+			VROptionRow(vMenuItems, 10, vWalkDir, vRightAnchor, vInfoBoxPos);
+			VROptionRow(vMenuItems, 11, vWalkSpeed, vRightAnchor, vInfoBoxPos);
+			VROptionRow(vMenuItems, 12, vOffOn, vRightAnchor, vInfoBoxPos);
+			VROptionRow(vMenuItems, 13, vDuckDepth, vRightAnchor, vInfoBoxPos);
+		}
+		else if(alPage == 5)
+		{
+			array<tString> vMenuDistance = {"VR_Near", "VR_Normal", "VR_Far"};
+			array<tString> vMenuSize = {"VR_Small", "VR_Normal", "VR_Large"};
+			array<tString> vMonitorSteady = {"VR_Off", "VR_Light", "VR_Medium", "VR_Strong"};
+			array<tString> vMonitorWidth = {"VR_Narrow", "VR_Normal", "VR_Wide"};
+			
+			VROptionRow(vMenuItems, 15, vMenuDistance, vRightAnchor, vInfoBoxPos);
+			VROptionRow(vMenuItems, 16, vMenuSize, vRightAnchor, vInfoBoxPos);
+			VROptionRow(vMenuItems, 33, vMonitorSteady, vRightAnchor, vInfoBoxPos); // the monitor's steady view (for recording)
+			VROptionRow(vMenuItems, 34, vMonitorWidth, vRightAnchor, vInfoBoxPos);
+			VROptionRow(vMenuItems, 29, vOffOn, vRightAnchor, vInfoBoxPos);
+		}
+		else
+		{
+			array<tString> vThrow = {"VR_Off", "VR_Light", "VR_Medium", "VR_Strong"};
+			array<tString> vReach = {"VR_Short", "VR_Normal", "VR_Long", "VR_VeryLong"};
+			array<tString> vVibration = {"VR_Off", "VR_Light", "VR_Normal", "VR_Strong"};
+			array<tString> vPointer = {"VR_Off", "VR_Light", "VR_Medium", "VR_Strong"};
+			array<tString> vHints = {"VR_UntilLearned", "VR_Always", "VR_Off"};
+			array<tString> vHintsReset = {"VR_PressArrow", "VR_Done"};
+
+			VROptionRow(vMenuItems, 40, vHints, vRightAnchor, vInfoBoxPos); // (the hints on the objects)
+			VROptionRow(vMenuItems, 41, vHintsReset, vRightAnchor, vInfoBoxPos); // (the mod always answers "first choice"; picking the other one shows every hint again)
+			VROptionRow(vMenuItems, 22, vThrow, vRightAnchor, vInfoBoxPos);
+			VROptionRow(vMenuItems, 23, vReach, vRightAnchor, vInfoBoxPos);
+			VROptionRow(vMenuItems, 24, vVibration, vRightAnchor, vInfoBoxPos);
+			VROptionRow(vMenuItems, 18, vPointer, vRightAnchor, vInfoBoxPos);
+		}
+
+		/////////////////
+		// Back
+		{
+			bool bButton = MainMenu_DoBackButton(msSelectedVRButton, mfTransitionAlpha);
+			bool bGamepad = ImGui_ActionTriggered(eImGuiAction_Cancel, true);
+
+			if(bButton || bGamepad)
+			{
+				if (ImGui_TimerExists("TransitionOut") == false)
+					ImGui_AddTimer("TransitionOut", 10);
+
+				mlFirstItemId = 0;
+				mlLastInFocus = 0;
+				mTargetGroup = eMainMenuGroup_Options_VR;
+				msTargetFocus = msSelectedVRHubButton;
+
+				/////////
+				// Reset menu position
+				if(bGamepad == false)
+				{
+					OptionMenu_ShowGamepadButtons(true);
+					return;
+				}
+			}
+
+			tString sID = cLux_GetInputHandler().GetGamepadWasLastDeviceUsed() ? vMenuItems[mlCurrentItemId-1] : "Back";
+			msSelectedVRButton = OptionMenu_UpdateFocus(sID, msSelectedVRButton);
+		}
+
+		GuiHandleTransition(mTargetGroup, msTargetFocus);
+
+		///////////
+		// Show gamepad legacy
+		OptionMenu_ShowGamepadButtons(true);
+	}
+	
+	//------------------------------------------------------- 
+
=2246
+	bool mbVRPreMenuHeld = false; // BunkerVR: the game's own start waiting for the studio's card (its last state, for the log)
=71
+	[nosave] tString msSelectedVRButton; // BunkerVR
+	[nosave] tString msSelectedVRHubButton; // BunkerVR
=39
+	[nosave] bool mbVRMenuFadeStarted = false;	// BunkerVR: the room's fade started for the menu's last wait
+	[nosave] float mfVRMenuFloorBelow = -1.0f;	// BunkerVR: how far the main menu's floor is below its camera (VRSendMenuRoom)
+	[nosave] bool mbVRMenuFloorLooked = false;	// BunkerVR: ...looked for already
+	[nosave] int mlVRStartupBlur = 0;	// BunkerVR: the blur behind the start-up page, while it is up (its id; 0 none)
end
