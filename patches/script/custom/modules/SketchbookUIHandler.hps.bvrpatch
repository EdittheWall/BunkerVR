+	cVector3f mvVRBookGroupPos = cVector3f(0.0f);	// BunkerVR: the sketchbook's whole group as last drawn...
+	cVector2f mvVRBookGroupSize = cVector2f(0.0f);	// ...for VRTellPhotoFocus
+
+	// BunkerVR: tells the mod where an opened photo's center is in the interface's picture, as fractions of it across and
+	// down, every frame it is open. The mod puts that point in front of the player instead of the book's center, which is
+	// to its right; otherwise the photo appears about 40% of the panel's width off to the left (cVR_PanelFocus; vr.cpp
+	// kInventoryBookMiddle). Worked out from where it comes to rest (avPos and afScale, DoPhotosPage's
+	// vDesiredSelectedPhotoPos and fDesiredSelectedPhotoScale), not from its growing out of the grid, so the panel has one
+	// place to glide to: a square of afScale of the page's height,
+	// its top-left corner at avPos in the photos page, which starts at 0.26, 0.14 of the sketchbook's group and is as big
+	// (DoPhotosPage's ImGui_GroupBegin), all from the top left (ImGui_SetAlignment in OnGui). The sketchbook's group starts
+	// at the picture's top.
+	void VRTellPhotoFocus(const cVector3f &in avPos, float afScale)
+	{
+		cVector2f vScreen = ImGui_GetSize();
+		if (vScreen.x <= 0.0f || vScreen.y <= 0.0f || mvVRBookGroupSize.x <= 0.0f || mvVRBookGroupSize.y <= 0.0f) return;
+		float fSide = afScale * mvVRBookGroupSize.y;
+		float fAcross = mvVRBookGroupPos.x + (0.26f + avPos.x) * mvVRBookGroupSize.x + fSide * 0.5f;
+		float fDown = (0.14f + avPos.y) * mvVRBookGroupSize.y + fSide * 0.5f;
+		cVR_PanelFocus(fAcross / vScreen.x, fDown / vScreen.y);
+	}
