=131
+	// BunkerVR: is the VR mod running? The VR mod answers through the camera:
+	// after setting a special roll value (7006, as VRUsingItemModActive in
+	// PlayerState_UsingItem_Base.hps), reading the camera's matrix returns the
+	// mod's data (12345 as its first number) instead. Without the mod the
+	// answer does not match.
+	bool VRModActive()
+	{
+		cLuxPlayer@ pVRPlayer = cLux_GetPlayer();
+		if (pVRPlayer is null) return false;
+		cCamera@ pVRCam = pVRPlayer.GetCamera();
+		if (pVRCam is null) return false;
+		
+		float fVRRealRoll = pVRCam.GetRoll();
+		pVRCam.SetRoll(7006.0f);
+		cVector3f vVRStatus = pVRCam.GetMatrix().GetTranslation();
+		pVRCam.SetRoll(fVRRealRoll);
+		
+		return vVRStatus.x > 12344.0f && vVRStatus.x < 12346.0f;
+	}
+	
+	// BunkerVR: was the last press in a menu made with a controller's grip
+	// button (rather than its trigger)? Asked the same way, with the special
+	// roll value 7017; always false without the mod.
+	bool VRPressWasGrip()
+	{
+		cLuxPlayer@ pVRPlayer = cLux_GetPlayer();
+		cCamera@ pVRCam = pVRPlayer !is null ? pVRPlayer.GetCamera() : null;
+		if (pVRCam is null) return false;
+		
+		float fVRRealRoll = pVRCam.GetRoll();
+		pVRCam.SetRoll(7017.0f);
+		cVector3f vVRAnswer = pVRCam.GetMatrix().GetTranslation();
+		pVRCam.SetRoll(fVRRealRoll);
+		
+		return vVRAnswer.x > 12344.0f && vVRAnswer.x < 12346.0f && vVRAnswer.y > 0.5f;
+	}
+	
+	// BunkerVR: tells the VR mod, on every frame the inventory is drawn, that
+	// it is open (special roll value 7092, as the body script's news in
+	// PlayerBodyHandler.hps), so that X and A do the inventory's drop and
+	// combine. The body script's news stops once the inventory has paused the
+	// game, and the mod forgets news older than 0.4 s, so without this X would
+	// drop only in the moment after the inventory opened.
+	void VRSendInventoryNews()
+	{
+		cLuxPlayer@ pVRPlayer = cLux_GetPlayer();
+		cCamera@ pVRCam = pVRPlayer !is null ? pVRPlayer.GetCamera() : null;
+		if (pVRCam is null) return;
+		
+		cVector3f vVRRealPos = pVRCam.GetPosition();
+		float fVRRealRoll = pVRCam.GetRoll();
+		pVRCam.SetPosition(cVector3f(1.0f, 0.0f, 0.0f));
+		pVRCam.SetRoll(7092.0f);
+		pVRCam.GetMatrix();
+		pVRCam.SetRoll(fVRRealRoll);
+		pVRCam.SetPosition(vVRRealPos);
+	}
+	
+	// BunkerVR: the storage box's book stands at the box in the headset, above
+	// it rather than at the player's face. While the box's book is open, on
+	// every frame it is drawn (the game may be paused: see VRSendInventoryNews),
+	// the mod is told where it is to stand: gfVRStorageBookAbove above the
+	// center of the top of the box that was opened ("BunkerVR_StorageBox", set
+	// by Prop_AuxiliaryInventory.hps), from the real head (the mod's rolls 7006
+	// and 7005): how far around from the way the head faces (radians, plus to
+	// the left), how far off level and how high, in the world's own units
+	// (cVR_StorageBoxAt; the mod keeps it within reach and below the eyes).
+	void VRSendStorageBoxAt()
+	{
+		if (mbAuxiliaryBoxActive == false || cVR_Active() == false) return;
+		iLuxEntity@ pBox = cLux_ID_Entity(cScript_GetGlobalVarID("BunkerVR_StorageBox"));
+		cMeshEntity@ pMesh = pBox !is null ? pBox.GetMeshEntity() : null;
+		cBoundingVolume@ pBounds = pMesh !is null ? pMesh.GetBoundingVolume() : null;
+		cLuxPlayer@ pVRPlayer = cLux_GetPlayer();
+		cCamera@ pVRCam = pVRPlayer !is null ? pVRPlayer.GetCamera() : null;
+		if (pBounds is null || pVRCam is null) return;
+
+		float fVRRealRoll = pVRCam.GetRoll();
+		pVRCam.SetRoll(7006.0f);
+		cVector3f vVRStatus = pVRCam.GetMatrix().GetTranslation();
+		bool bVRHead = vVRStatus.x > 12344.0f && vVRStatus.x < 12346.0f && vVRStatus.y > 0.5f;
+		cMatrixf mtxVRHead = cMatrixf_Identity;
+		if (bVRHead)
+		{
+			pVRCam.SetRoll(7005.0f);
+			mtxVRHead = pVRCam.GetMatrix();
+		}
+		pVRCam.SetRoll(fVRRealRoll);
+		if (bVRHead == false) return;
+
+		cVector3f vBook = pBounds.GetWorldCenter();
+		vBook.y = pBounds.GetMax().y + gfVRStorageBookAbove;
+		cVector3f vToBook = vBook - mtxVRHead.GetTranslation();
+		cVector3f vFlat = cVector3f(vToBook.x, 0.0f, vToBook.z);
+		cVector3f vFacing = cMath_MatrixMul3x3(mtxVRHead, cVector3f(0.0f, 0.0f, -1.0f));
+		vFacing.y = 0.0f;
+		if (vFlat.Length() < 0.01f || vFacing.Length() < 0.01f) return;
+		cVector3f vFlatDir = cMath_Vector3Normalize(vFlat);
+		vFacing.Normalize();
+		float fAngle = cMath_ATan2(vFacing.z * vFlatDir.x - vFacing.x * vFlatDir.z, cMath_Vector3Dot(vFacing, vFlatDir));
+		cVR_StorageBoxAt(fAngle, vFlat.Length(), vToBook.y);
+	}
+
+	// BunkerVR: while the book (the inventory or the storage box's) is open in
+	// the headset, the room behind it is blurred and the player's body (with
+	// its hands) hidden; left visible, its arms would be blurred along with the
+	// room. Both are set at once, as the game may be paused then, which stops
+	// its own fading: the world's depth of field set straight on the world
+	// (sharp only within gfVRStorageSharp of the eyes; the book is a layer of
+	// its own, not blurred), and the body's coverage at none with what hangs
+	// on it, as the game's number lock hides them in the flat game. All put
+	// back as the book shuts. On every frame drawn.
+	void VRUpdateStorageView()
+	{
+		bool bWanted = mbOpen && cVR_Active();
+		if (bWanted == mbVRStorageView) return;
+		mbVRStorageView = bWanted;
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		cWorld@ pWorld = pMap !is null ? pMap.GetWorld() : null;
+		if (pWorld !is null)
+		{
+			if (bWanted)
+			{
+				pWorld.SetDepthOfFieldFocusStart(0.0f);
+				pWorld.SetDepthOfFieldFocusEnd(gfVRStorageSharp);
+				pWorld.SetDepthOfFieldFalloff(1.0f);
+			}
+			pWorld.SetDepthOfFieldActive(bWanted);
+		}
+		PlayerBody_SetCoverageAmount(bWanted ? 0.0f : 1.0f, false);
+		cScript_SetGlobalArgBool(0, bWanted == false);
+		cScript_RunGlobalFunc(PlayerBody_GetEntityName(), "cScrPropPlayerBody", "_Global_SetAttachmentPropsActive");
+		Log("BunkerVR: the book " + (bWanted ? "opens: the room blurred, the body hidden" : "shuts: the room and the body back") + "\n");
+	}
+
+	//------------------------------------------------------------
+	
