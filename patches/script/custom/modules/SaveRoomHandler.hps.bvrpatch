+		// BunkerVR: after one of the mod's debug jumps nothing is saved: the
+		// player is not where the game's own story has them, and Continue must
+		// still find their real game.
+		if(cVR_JumpedThisRun())
+		{
+			Log("BunkerVR: no save: this run has jumped\n");
+			return;
+		}
+		
end
