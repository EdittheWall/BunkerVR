+// BunkerVR: holding an object in the hand (see the hold in Update). A hand's
+// own hold uses the same values (both hands alike): they are in
+// helper_bunkervr.hps (gfBunkerVR_HoldFollow and the rest).
+const float gfVRHoldMaxDistance = gfBunkerVR_HoldReachLeast;	// the furthest from the hand a held object's center may sit (meters; more for a big object: BunkerVR_HoldReachLimit)
+const float gfVRMaxThrowSpeed = gfBunkerVR_ThrowMaxSpeed;		// the fastest an object may leave the hand when thrown (meters a second)
+const float gfVRHoldFollow = gfBunkerVR_HoldFollow;				// how much of the way to its place it is sent each update (1 = all of it)
+const float gfVRHoldFollowHeavy = gfBunkerVR_HoldFollowHeavy;	// the same for heavy objects
+const float gfVRHoldMaxSpeed = gfBunkerVR_HoldMaxSpeed;			// the fastest it is moved (meters a second)
+const float gfVRHoldMaxSpin = gfBunkerVR_HoldMaxSpin;			// and turned (radians a second)
+const float gfVRHoldSpinShare = gfBunkerVR_HoldSpinShare;		// how much of the turn still needed it is turned by the next update (times gfVRHoldFollow)
+const float gfVRHoldLetGoDistance = gfBunkerVR_HoldLetGoDistance;	// held back this far from its place in the hand...
+const float gfVRHoldStuckSpeed = gfBunkerVR_HoldStuckSpeed;		// ...while moving slower than this (meters a second)...
+const float gfVRHoldLetGoTime = gfBunkerVR_HoldLetGoTime;		// ...for this long (seconds): it is let go
+const float gfVRHoldTwoHeavySpeed = 3.0f;	// a heavy object lifted with both hands moves at most this fast (meters a second)... (half this falls far behind the hands)
+const float gfVRHoldTwoHeavySpin = 8.0f;	// ...and turns at most this fast (radians a second)
+
