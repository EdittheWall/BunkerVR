+	// BunkerVR: the real weight of the held body (apBody), from the weights
+	// saved in SetupGrab (the game lowers it while it grabs: a heavy object
+	// keeps the lower one); its current weight if not found.
+	float VRRealMass(iPhysicsBody@ apBody)
+	{
+		for(uint i = 0; i < mvBodyProperties.length(); ++i)
+		{
+			if(mvBodyProperties[i].mBodyID == mBodyID) return mvBodyProperties[i].mfMass;
+		}
+		return apBody !is null ? apBody.GetMass() : 0.0f;
+	}
+
+	// BunkerVR: an object held in a VR hand weighs what it really weighs.
+	// The game makes a held object lighter (most objects: a tenth, so it
+	// doesn't push a lot of objects around; see SetupGrab). Held in a VR hand
+	// it is moved by giving it a speed, and while it touches another object
+	// that moves it may only speed up so quickly (see BunkerVR_HoldLimitChange
+	// in helper_bunkervr.hps), so it pushes, and holds out, as hard as that
+	// takes for its weight. At a tenth, a 1 kg can weighs as little as a
+	// pencil, and a pencil dropped on it pushes it down as if it weighed a
+	// ton. So the weights saved in SetupGrab are put back (as when it is let
+	// go, in OnLeaveState). (The hand's own hold, in PlayerBodyHandler.hps,
+	// never makes objects lighter.)
+	void VRUseRealMass()
+	{
+		mfMassSum = 0;
+		for(uint i=0; i<mvBodyProperties.length(); ++i)
+		{
+			iPhysicsBody@ pBody = cLux_ID_Body(mvBodyProperties[i].mBodyID);
+			if(pBody is null) continue;
+			pBody.SetMass(mvBodyProperties[i].mfMass);
+			pBody.SetMassMulApplied(1.0f);
+			mfMassSum += pBody.GetMass();
+		}
+	}
+
+	//-----------------------------------------------------------------------
+
+	// BunkerVR: the object taken hold of was held by the other hand's own hold
+	// (PlayerBodyHandler.hps, which reports which object each hand holds, and
+	// whether it had its gravity, and collided with the player, before that
+	// hand took it: "BunkerVR_FreeBody0/1", "BunkerVR_FreeGravity0/1",
+	// "BunkerVR_FreeBump0/1"). That hand switched both off, and SetupGrab
+	// noted them that way: the notes get what the object had before, for when
+	// it is let go. Then this grab tells the other hand what the object had
+	// ("BunkerVR_GrabGravity", "BunkerVR_GrabBump"), for when that hand keeps it
+	// after this one lets go.
+	void VRTakeOriginalsFromHand()
+	{
+		for(int lHand = 0; lHand < 2; ++lHand)
+		{
+			if(cScript_GetGlobalVarID(lHand == 0 ? "BunkerVR_FreeBody0" : "BunkerVR_FreeBody1") != mBodyID) continue;
+			for(uint i = 0; i < mvBodyProperties.length(); ++i)
+			{
+				if(mvBodyProperties[i].mBodyID != mBodyID) continue;
+				mvBodyProperties[i].mbHasGravity = cScript_GetGlobalVarBool(lHand == 0 ? "BunkerVR_FreeGravity0" : "BunkerVR_FreeGravity1");
+				mvBodyProperties[i].mbCollideCharacter = cScript_GetGlobalVarBool(lHand == 0 ? "BunkerVR_FreeBump0" : "BunkerVR_FreeBump1");
+			}
+		}
+		for(uint i = 0; i < mvBodyProperties.length(); ++i)
+		{
+			if(mvBodyProperties[i].mBodyID != mBodyID) continue;
+			cScript_SetGlobalVarBool("BunkerVR_GrabGravity", mvBodyProperties[i].mbHasGravity);
+			cScript_SetGlobalVarBool("BunkerVR_GrabBump", mvBodyProperties[i].mbCollideCharacter);
+		}
+	}
+
