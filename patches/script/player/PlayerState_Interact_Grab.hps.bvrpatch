+		/////////////////////////////////////
+		// BunkerVR: ask the VR mod where the grabbing hand is.
+		// The mod answers through the camera: after setting a special roll value,
+		// reading the camera's matrix returns the hand's data instead. Without the
+		// mod installed the answer doesn't match, and the normal grab is used.
+		bool bVRHand = false;
+		int lVRGrabHand = 0; // which hand holds (0 left, 1 right)
+		cMatrixf mtxVRHand;
+		{
+			float fRealRoll = pCam.GetRoll();
+			pCam.SetRoll(7002.0f);
+			cVector3f vVRStatus = pCam.GetMatrix().GetTranslation();
+			if(vVRStatus.x > 12344.0f && vVRStatus.x < 12346.0f && vVRStatus.y > 0.5f)
+			{
+				pCam.SetRoll(7001.0f);
+				mtxVRHand = pCam.GetMatrix();
+				bVRHand = true;
+
+				// Held from the hand that is seen, which may be held back from
+				// the real one at a table or a wall (see VRHandBlock in
+				// Prop_PlayerBody.hps), so what it holds stays with it.
+				lVRGrabHand = int(vVRStatus.z + 0.5f);
+				cVector3f vVRBack = cScript_GetGlobalVarVector3f(lVRGrabHand == 0 ? "BunkerVR_HandBack0" : "BunkerVR_HandBack1");
+				if(vVRBack.Length() < 0.6f) mtxVRHand.SetTranslation(mtxVRHand.GetTranslation() + vVRBack);
+			}
+			pCam.SetRoll(fRealRoll);
+		}
+		// BunkerVR: the Feel page's current values (see BunkerVR_ReadFeel).
+		if(bVRHand) BunkerVR_ReadFeel(pCam);
+
