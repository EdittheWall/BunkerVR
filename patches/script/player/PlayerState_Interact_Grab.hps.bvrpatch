=24
+			///////////////////
+			// BunkerVR: hold the object from the hand instead of from the camera.
+			if(bVRHand)
+			{
+				mtxCamTransform = mtxVRHand;
+				
+				// The first time, note where the object is compared with the hand, so
+				// that it stays there as if stuck to the hand. If it is further off
+				// than a hand's length it is drawn in to that distance.
+				// (First it is drawn into the hand, from the spot the hand's ray
+				// found (mvFocusPos) to the center of its grip: see
+				// BunkerVR_HoldPull. Not heavy objects, which stay on the floor.)
+				if(mbVRHandRotationSet == false)
+				{
+					VRBuzzHand(lVRGrabHand, 0.03f, 0.4f); // (the hand feels it take hold, as of a door or a drawer)
+					// (And it gets its real weight back; see VRUseRealMass. Not
+					// heavy objects, which are dragged as the game drags them.)
+					if(mbLowerMass && mbIsHeavy == false) VRUseRealMass();
+					// (Its real weight, for the hand's strength; and is it too
+					// heavy for one hand to hold up? Then it is dragged, as a
+					// heavy object is. See gbBunkerVR_Weight.)
+					mfVRRealMass = VRRealMass(pBody);
+					mbVRTooHeavy = BunkerVR_TooHeavyForOneHand(mfVRRealMass);
+					// (If the other hand's own hold already has it, that hand
+					// switched off its gravity and its collisions with the player
+					// before SetupGrab noted them. What it had before that hand took
+					// it is put back in the notes, so that letting go gives it back
+					// its weight. That hand then helps; see VRUpdateFreeHand in
+					// PlayerBodyHandler.hps.)
+					VRTakeOriginalsFromHand();
+					// (And it glides in; see BunkerVR_HoldPullSpeed.)
+					mbVRPullingIn = mbIsHeavy == false;
+					mfVRPullSpeed = 0.0f;
+					mfVRPullTime = 0.0f;
+					cVector3f vVRBodyAt = pBody.GetLocalPosition();
+					cVector3f vVRGrip = cVector3f(0.0f);
+					if(mbIsHeavy == false && BunkerVR_GetGripPoint(pCam, lVRGrabHand, mtxVRHand.GetTranslation(), vVRGrip))
+						vVRBodyAt = BunkerVR_HoldPull(vVRBodyAt, mvFocusPos, vVRGrip);
+					mvVRHandOffset = cMath_MatrixMul(cMath_MatrixInverse(mtxVRHand), vVRBodyAt);
+					// (No further than its own size allows, at least
+					// gfVRHoldMaxDistance; see BunkerVR_HoldReachLimit. A big object
+					// is held where it was taken, not drawn in to its center.)
+					float fVROffsetLength = mvVRHandOffset.Length();
+					float fVROffsetLimit = BunkerVR_HoldReachLimit(pBody, gfVRHoldMaxDistance);
+					if(fVROffsetLength > fVROffsetLimit)
+						mvVRHandOffset = mvVRHandOffset * (fVROffsetLimit / fVROffsetLength);
+					// (A heavy object: where the hand holds it, in its own frame,
+					// for the hand to be drawn there; see gfBunkerVR_HeavySlip.)
+					mvVRHeavyGrip = cMath_MatrixMul(cMath_MatrixInverse(pBody.GetLocalMatrix()), mtxVRHand.GetTranslation());
+				}
+				
+				// The first time, keep the object turned the way it is now, relative to the hand.
+				if(mbVRHandRotationSet == false)
+				{
+					if(mbUseCustomOffset == false)
+					{
+						cMatrixf mtxInvHandRot = cMath_MatrixInverse(mtxVRHand.GetRotation());
+						m_mtxBodyRotation = cMath_MatrixMul(mtxInvHandRot, pBody.GetLocalMatrix().GetRotation());
+					}
+					mbVRHandRotationSet = true;
+				}
+				
+				// Throwing: remember where the hand was over the last few
+				// updates. When the object is let go, it leaves with the speed
+				// the hand had at its fastest moment; see DropBody.
+				for(int i = 0; i < 19; ++i) mvVRHandTrail[i] = mvVRHandTrail[i + 1];
+				mvVRHandTrail[19] = mtxVRHand.GetTranslation();
+				if(mlVRHandTrailCount < 20) mlVRHandTrailCount++;
+				if(afTimeStep > 0.0001f) mfVRHandTrailStep = afTimeStep;
+				mbVRThrowKnown = true;
+				
+				// How strong throws are is set in the mod's menu (special roll value 7032, third number).
+				{
+					float fThrowRealRoll = pCam.GetRoll();
+					pCam.SetRoll(7032.0f);
+					float fVRBoost = pCam.GetMatrix().GetTranslation().z;
+					pCam.SetRoll(fThrowRealRoll);
+					if(fVRBoost > 0.19f && fVRBoost < 5.01f) mfVRThrowBoost = fVRBoost;
+				}
+			}
