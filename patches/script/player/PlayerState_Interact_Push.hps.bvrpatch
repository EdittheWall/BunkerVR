=132
+	[nosave] float mfVRPushApart = 0.0f;		// BunkerVR: how long the hand has been pulled off the object (seconds)
+	[nosave] float mfVRPushScrapeWait = 0.0f;	// BunkerVR: seconds until the next tick as it scrapes along
+	[nosave] float mfVRPushLogWait = 0.0f;	// BunkerVR: seconds until the next line in the log
+	[nosave] cVector3f mvVRPushGiven = cVector3f(0.0f);	// BunkerVR: the speed it was given last update (VRPushGoing)
+	[nosave] float mfVRPushTurnGiven = 0.0f;	// BunkerVR: ...and the turn
+	[nosave] cVector3f mvVRPushUpTaken = cVector3f(0.0f, 1.0f, 0.0f);	// BunkerVR: which way its own up pointed when taken
+	[nosave] int mlVRPushHelp = -1;				// BunkerVR: the other hand on it too (0 left, 1 right; -1 none; VRUpdatePushHelp)
+	[nosave] bool mbVRPushHelpSqueezeWas = false;	// BunkerVR: was that hand squeezing last update?
+	[nosave] cVector3f mvVRPushHelpOnBody = cVector3f(0.0f);	// BunkerVR: its spot, in the body's own frame
+	[nosave] cVector3f mvVRPushHelpPalmOff = cVector3f(0.0f);	// BunkerVR: its palm's offset from its spot when it took hold
+	[nosave] float mfVRPushHelpApart = 0.0f;	// BunkerVR: how long it has been pulled off (seconds)
end
