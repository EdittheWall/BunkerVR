=26
+// BunkerVR: a crate or barrel dragged by a VR hand (see VRPushByHand):
+const float gfVRPushCatchUp = 0.3f;		// the share of the gap to the hand closed each update
+const float gfVRPushMaxSpeed = 2.0f;	// the fastest it would go with the hand, weighing nothing (meters a second): less by its weight, as the game's own push (VRPushTopSpeed)
+const float gfVRPushLeastSpeed = 0.4f;	// ...and however heavy, it goes this fast
+const float gfVRPushForce = 45.0f;		// how hard a hand pulls (newtons): by its weight, how quickly it gets going
+const float gfVRPushStopForce = 150.0f;	// how hard the floor stops it, once the hand asks for less
+const float gfVRPushStick = 0.05f;		// the hand this far ahead of it before it moves at all (meters): it takes a pull to start it
+const float gfVRPushTwoForce = 1.5f;	// with both hands: pulled this much harder...
+const float gfVRPushTwoSpeed = 1.35f;	// ...and this much faster
+const float gfVRPushTurnShare = 0.45f;	// the share it takes of the turn the hand's pull about its center asks for
+const float gfVRPushMaxTurn = 2.0f;		// and the fastest it would turn, weighing nothing (radians a second)
+const float gfVRPushLeastTurn = 0.4f;	// ...and however heavy, it can turn this fast
+const float gfVRPushTurnGets = 90.0f;	// how quickly its turn gets going: this over its weight (radians a second, each second)
+const float gfVRPushUprightKeep = 0.8f;	// the share of any tipping or rolling turn kept each update while a hand has it
+const float gfVRPushTiltLetGo = 0.82f;	// tipped this far from how it stood when taken (the cosine: about 35 degrees): it goes out of the hand
+const float gfVRPushLetGo = 0.5f;		// the hand this far from the spot it holds, in any direction...
+const float gfVRPushLetGoTime = 0.25f;	// ...for this long (seconds): it lets go
+const float gfVRPushWalk = 1.6f;		// the fastest the player walks while dragging (meters a second)
+const float gfVRPushWalkOverTop = 0.9f;	// ...and no faster than this share of the top speed its weight allows (the floor keeps it a little under its top speed, and a faster walk draws the hand off it)
+const float gfVRPushRubbedOff = 0.15f;	// it has this much less speed than it was given last update (meters a second), or more: something stops it, not the floor's rub (VRPushGoing)
+const float gfVRPushTurnRubbedOff = 0.3f;	// ...and this much less turn (radians a second)
+const float gfVRPushScrapeEvery = 0.09f;	// a tick in the hand this often while it moves (seconds)...
+const float gfVRPushScrapeFrom = 0.08f;	// ...once it moves this fast (meters a second)...
+const float gfVRPushScrapeFull = 1.5f;	// ...strongest at this speed
+const float gfVRPushRayBack = 0.12f;	// the hand onto its surface: looked for from this far behind the palm (meters)...
+const float gfVRPushPalmOff = 0.035f;	// ...stopping this far out of it, the palm's thickness...
+const float gfVRPushOntoMost = 0.3f;	// ...and moved no further than this
+
