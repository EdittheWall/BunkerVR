=123
+	// BunkerVR: a drawer's handle, for a VR hand's hold (PlayerState_Interact.hps
+	// VRHoldSpot), so the hand lands on the handle and not off it or inside
+	// the drawer. The handle is the part of the front standing furthest out
+	// (along the rail, towards the player: a filing cabinet drawer's bar, a
+	// desk drawer's knob), found by rays cast back at the front, if it stands
+	// out by gfVRHandleStandsOut or more. Returns the point on it
+	// (gfVRHandleIn behind its face, at its height) nearest avNear along the
+	// front; false for a drawer without one.
+	// Don't read the shapes the body is made of (GetSubShapeNum): the
+	// engine's base shape doesn't have them and the game crashes as the hand
+	// takes hold. Rays are cast instead, as the hands' pressing does.
+	// Rays: two columns up the front (at avNear's place along it and at its
+	// center), each gfVRHandleStep apart; then a row along the front at the
+	// handle's height to find how far it reaches.
+	bool VRHoldOnHandle(iPhysicsBody@ apBody, const cVector3f &in avNear, cVector3f &out avOnHandle) override
+	{
+		avOnHandle = avNear;
+		if(apBody is null || apBody.GetJointNum() == 0) return false;
+		iPhysicsJoint@ pJoint = apBody.GetJoint(0);
+		cBoundingVolume@ pBox = apBody.GetBoundingVolume();
+		if(pJoint is null || pBox is null) return false;
+		cVector3f vLow = pBox.GetMin();
+		cVector3f vHigh = pBox.GetMax();
+		cVector3f vMid = (vLow + vHigh) * 0.5f;
+		cVector3f vHalf = (vHigh - vLow) * 0.5f;
+		cVector3f vOut = cMath_Vector3Normalize(pJoint.GetPinDir());
+		if(cMath_Vector3Dot(vOut, cLux_GetPlayer().GetCamera().GetPosition() - vMid) < 0.0f) vOut = vOut * -1.0f;
+		cVector3f vAlong = cMath_Vector3Cross(cVector3f(0.0f, 1.0f, 0.0f), vOut);
+		if(vAlong.Length() < 0.5f) return false;
+		vAlong.Normalize();
+		cVector3f vUp = cMath_Vector3Cross(vOut, vAlong);
+
+		// The box's front (how far out from its center), and how far it
+		// reaches along the front and up it.
+		float fFront = VRHandleReach(vHalf, vOut);
+		float fHalfAlong = VRHandleReach(vHalf, vAlong);
+		float fHalfUp = VRHandleReach(vHalf, vUp);
+		cVector3f vFrontMid = vMid + vOut * (fFront + gfVRHandleRayStart);
+		float fNearAlong = cMath_Clamp(cMath_Vector3Dot(avNear - vMid, vAlong), -fHalfAlong, fHalfAlong);
+
+		// Up the two columns: the nearest face (the part standing out) and
+		// the farthest one (the drawer's front itself, the most distant hit).
+		float fBest = 1000.0f;
+		float fBestAlong = 0.0f;
+		float fBestUp = 0.0f;
+		float fFarthest = -1.0f;
+		int lRows = cMath_Min(int(fHalfUp * 2.0f / gfVRHandleStep) + 1, 60);
+		for(int lColumn = 0; lColumn < 2; ++lColumn)
+		{
+			float fAlongHere = lColumn == 0 ? fNearAlong : 0.0f;
+			for(int lRow = 0; lRow < lRows; ++lRow)
+			{
+				float fUpHere = -fHalfUp + gfVRHandleStep * float(lRow);
+				float fHit = VRHandleRay(apBody, vFrontMid + vAlong * fAlongHere + vUp * fUpHere, vOut * -1.0f);
+				if(fHit < 0.0f) continue;
+				if(fHit > fFarthest) fFarthest = fHit;
+				// (As near as the best, within 2 mm: the one nearer the hand.)
+				bool bNearer = fHit < fBest - 0.002f;
+				bool bAsNear = cMath_Abs(fHit - fBest) <= 0.002f &&
+							   (vAlong * fAlongHere + vUp * fUpHere - (avNear - vMid)).Length() < (vAlong * fBestAlong + vUp * fBestUp - (avNear - vMid)).Length();
+				if(bNearer == false && bAsNear == false) continue;
+				fBest = fHit;
+				fBestAlong = fAlongHere;
+				fBestUp = fUpHere;
+			}
+		}
+		if(fBest >= 1000.0f || fFarthest - fBest < gfVRHandleStandsOut) return false;
+
+		// Along the front at the handle's height: how far the handle reaches
+		// (rays that hit within 5 mm of its face).
+		float fFrom = fBestAlong;
+		float fTo = fBestAlong;
+		for(int lWay = -1; lWay <= 1; lWay += 2)
+		{
+			for(int lStep = 1; lStep <= 20; ++lStep)
+			{
+				float fAlongHere = fBestAlong + float(lWay * lStep) * gfVRHandleStep;
+				float fHit = VRHandleRay(apBody, vFrontMid + vAlong * fAlongHere + vUp * fBestUp, vOut * -1.0f);
+				if(fHit < 0.0f || fHit > fBest + 0.005f) break;
+				if(lWay < 0)	fFrom = fAlongHere;
+				else			fTo = fAlongHere;
+			}
+		}
+		float fAlong = cMath_Clamp(cMath_Vector3Dot(avNear - vMid, vAlong), fFrom, fTo);
+		avOnHandle = vFrontMid + vAlong * fAlong + vUp * fBestUp - vOut * (fBest + gfVRHandleIn);
+		return true;
+	}
+
+	// How far a box of half sizes avHalf (world axes) reaches along avDir.
+	float VRHandleReach(const cVector3f &in avHalf, const cVector3f &in avDir)
+	{
+		return cMath_Abs(avDir.x) * avHalf.x + cMath_Abs(avDir.y) * avHalf.y + cMath_Abs(avDir.z) * avHalf.z;
+	}
+
+	// A ray from avStart along avDir (gfVRHandleRayLength long): how far it
+	// goes before it meets apBody (-1 if it meets something else first, or
+	// nothing).
+	float VRHandleRay(iPhysicsBody@ apBody, const cVector3f &in avStart, const cVector3f &in avDir)
+	{
+		float fHit = 0.0f;
+		cVector3f vNormal = cVector3f(0.0f);
+		iPhysicsBody@ pHit = cLux_GetClosestBody(avStart, avDir, gfVRHandleRayLength, fHit, vNormal);
+		if(pHit is null || pHit.GetID() != apBody.GetID()) return -1.0f;
+		return fHit;
+	}
+
+	//------------------------------------------------------------
+
end
