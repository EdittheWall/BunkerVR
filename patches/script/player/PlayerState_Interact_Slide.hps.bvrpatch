+// BunkerVR: a drawer's handle, found by rays cast back at its front (meters;
+// see VRHoldOnHandle).
+const float gfVRHandleStep = 0.01f;			// the rays this far apart, up and along the front
+const float gfVRHandleRayStart = 0.02f;		// each from this far in front of the drawer's box...
+const float gfVRHandleRayLength = 0.15f;	// ...this far back
+const float gfVRHandleStandsOut = 0.008f;	// a handle stands out of the front by this much at least
+const float gfVRHandleIn = 0.01f;			// the hand closes around it this far behind its face
+
=242
+		// BunkerVR: is a VR hand holding it (see below)? Then the camera's
+		// distance doesn't end the hold (the camera is the head, and leaning
+		// back to pull a drawer can take it past the limit): the hand lets go
+		// when pulled off the spot it holds instead.
+		int lVRHand = 1;
+		cVector3f vVRPalm = cVector3f(0.0f);
+		bool bVRHand = VRGrabbingHand(lVRHand, vVRPalm);
