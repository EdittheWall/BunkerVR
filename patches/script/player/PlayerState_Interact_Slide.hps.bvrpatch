=6
+		//////////////////////////////
+		// BunkerVR: held by a VR hand (see VRHoldSpot in
+		// PlayerState_Interact.hps): the drawer moves so that the spot held
+		// follows the hand along its rail, a quarter of the gap each update,
+		// no faster than its own top speed. The game's own push below moves
+		// it (its force is limited, so a heavy or jammed drawer lags and
+		// resists). The mouse (the right stick's turning) is not used.
+		float fVRWanted = 0.0f;
+		if(bVRHand)
+		{
+			cVector3f vVRSpot = VRHoldSpot(pBody, lVRHand, vVRPalm, "the drawer");
+			if(VRHoldPulledOff(lVRHand, vVRPalm - mvVRHoldPalmOff, vVRSpot, afTimeStep))
+			{
+				cLux_GetPlayer().ChangeState(mlPreviousState);
+				return;
+			}
+			cVector3f vVRPin = cMath_Vector3Normalize(pCurrentJoint.GetPinDir());
+			// The hand holds the handle like a door's bar: the bar runs level
+			// along the drawer's front (square to its rail), with the hand
+			// facing into the front. A vertical rail has no such bar.
+			cVector3f vVRBar = cMath_Vector3Cross(cVector3f(0.0f, 1.0f, 0.0f), vVRPin);
+			if(vVRBar.Length() > 0.5f)
+			{
+				cVector3f vVROut = vVRPin;
+				if(cMath_Vector3Dot(vVROut, pCam.GetPosition() - vVRSpot) < 0.0f) vVROut = vVROut * -1.0f;
+				VRHoldSetBar(lVRHand, cMath_Vector3Normalize(vVRBar), vVROut);
+			}
+			float fVRGap = cMath_Vector3Dot(vVRPalm - mvVRHoldPalmOff - vVRSpot, vVRPin); // (from where the hand took hold)
+			fVRWanted = cMath_Clamp(fVRGap * (gfVRHoldCatchUp / cMath_Max(afTimeStep, 0.004f)), -mfSlideMaxSpeed, mfSlideMaxSpeed);
+			VRHoldFeelStop(lVRHand, mfVRHoldLastWanted, cMath_Vector3Dot(pBody.GetLinearVelocity(), vVRPin), cMath_Abs(fVRGap), afTimeStep);
+			mfVRHoldLastWanted = fVRWanted;
+		}
+
=18
+		if(bVRHand) mfSlideSpeed = fVRWanted; // BunkerVR (see above)
