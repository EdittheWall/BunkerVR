+#include "custom/helpers/helper_bunkervr.hps" // (BunkerVR: holding it in the hand)
=30
+// BunkerVR: a dogtag held in the VR hand that took it (see VRSetupHeld).
+const float gfVRReadPinchMost = 0.06f;	// up to this tall to its center (meters, its own size) it is pinched (a dogtag); taller (the code sign), held in the whole hand
+const float gfVRReadHeldIn = 0.016f;	// a pinched one goes this far into the pinch (meters): about a quarter of it, the way a coin is held; much less and it stands off the fingertips
+const float gfVRReadPinchStale = 1.0f;	// where the pinch is (Prop_PlayerBody.hps VRNoteTagPinch) is believed for this long (seconds)
+const float gfVRReadBackNear = 0.4f;	// its back is read only when the eyes see it from nearer than this (meters)...
+const float gfVRReadBackLook = 0.5f;	// ...for this long (seconds)
+const float gfVRReadGlideIn = 0.2f;		// seconds to come from where it lay into the hand
+const float gfVRReadLightOff = 0.12f;	// the game's reading light this far from it, towards the eyes (meters)
+const float gfVRReadLetGoCurl = 0.3f;	// let go of when that hand's fingers open past this (0 open, 1 a fist)
+
