=10
+#include "custom/helpers/helper_bunkervr.hps" // BunkerVR: the palms (the ladder climbed hand over hand)
+#include "custom/helpers/helper_bunkervr_hints.hps" // BunkerVR: the hint on the hand
=16
+// BunkerVR: the ladder climbed hand over hand, as VR games climb ladders (the
+// Half-Life 2 VR mod, Half-Life: Alyx): on the ladder, a grip squeezed with
+// the hand at the rungs takes hold there, and while it holds, the body moves
+// up or down as far as that hand is pulled the other way, so the hand stays
+// where it took hold. The last hand to take hold climbs. Letting go leaves
+// the player where they are (nothing moves by itself). Pulled up past the top
+// or down to the foot, the player gets off as the game's own climbing does.
+// (VRUpdateHandClimb.) The stick climbs only while the palms aren't tracked
+// (the arms switched off), and climbing on and off is a blink
+// (VRClimbOnByBlink).
+const float gfVRLadderGripPress = 0.6f;		// a grip this far in takes hold...
+const float gfVRLadderGripLetGo = 0.35f;	// ...and lets go this far out (as the items' grips: PlayerBodyHandler.hps gfVRFitGripPress)
+// A hand takes hold only at a rung, not in the air between them. The rungs as
+// the game's ladder is built (static_objects\bunker\ladder: a piece every
+// 0.5 m, gfLadderRungDistance, with one round bar 3 cm thick across its
+// center, 0.43 m either side; the pillbox ladder, the game's only one, from
+// 6.0 m, its area's foot at 6.215 m: bars at 6.25, 6.75 ... 13.75, in the
+// area's own plane): the first gfVRLadderRungFirst above the area's foot.
+const float gfVRLadderRungFirst = 0.035f;	// the lowest bar this far above the ladder area's foot (meters)
+const float gfVRLadderRungHalf = 0.43f;		// a bar reaches this far either side of the center
+const float gfVRLadderRungSide = 0.06f;		// a hand at a bar: within this of its ends...
+const float gfVRLadderRungUpDown = 0.10f;	// ...this far above or below it...
+const float gfVRLadderRungOut = 0.15f;		// ...and this far in front of it or behind
+const float gfVRLadderGripAcross = 0.38f;	// a hand holding a rung is drawn on it at most this far from its center
+// Climbing on by a squeeze: a hand squeezed as climbing on begins, within this of the rungs' plane (meters;
+// VRClimbOnHolds), and still squeezed once on, holds on (VRUpdateHandClimb). Climbing on moves the body and so the
+// real hand (some 30 cm up and 15 cm nearer at the foot; turned around from the top), often between the rungs and
+// into the wall behind them, where the arm would be drawn clipping through the wall, holding nothing. It holds the
+// rung nearest where the real hand is now, if that is within gfVRLadderClimbOnHold of it (beyond that, the arm would
+// be drawn stretched, so it holds nothing).
+const float gfVRLadderClimbOnReach = 0.3f;
+const float gfVRLadderClimbOnHold = 0.45f;
+// Stepping off at the foot: climbed on at the foot, the body is 2.5 cm above
+// it, so a hand drifting 5 cm would take the player off at once, and the same
+// squeeze would climb straight back on, in a loop. So the hand must push this
+// far past the foot, and not in the first gfVRLadderSettle after climbing on...
+const float gfVRLadderFootPush = 0.15f;
+const float gfVRLadderSettle = 0.6f;
+// ...and a ladder isn't climbed onto again until this long after getting
+// off one (Area_Ladder.hps OnInteract; seconds).
+const float gfVRLadderAgainWait = 1.0f;
+// Climbing on in VR, the body script is asked to put the view over the body
+// (the global "BunkerVR_LadderCentre", PlayerBodyHandler.hps VRFollowHead);
+// the hands take no hold until it has, or this long at most (seconds).
+const float gfVRLadderCentreWait = 0.25f;
+// (Putting the view over the body takes a few updates; the blink stays dark
+// until it is done, or this long at most, seconds.)
+const float gfVRLadderCentreWaitMost = 0.45f;
+const float gfVRLadderMaxSpeed = 1.5f;		// the body moves at most this fast, however fast the hand (m/s), so the player can't climb too quickly
+const float gfVRLadderMoving = 0.1f;		// the climbing animation plays while the hands move the body faster than this (m/s)...
+const float gfVRLadderMovingKeep = 0.25f;	// ...and this long after (seconds), so that a slow pull doesn't flicker it
+const float gfVRLadderExitPull = 0.05f;		// off at the top or the foot only once the hold has climbed this far that way, or the hand asks this far past the end (meters)
+const float gfVRLadderHintClimbed = 0.2f;	// a hold that climbed this far counts as its hint used (meters)
+// Climbing on and off in VR: a blink (VRClimbOnByBlink): the view
+// dark over gfVRLadderBlinkOut (seconds), the player placed when it is dark
+// (or gfVRLadderBlinkWait later at most), clear again over gfVRLadderBlinkIn.
+const float gfVRLadderBlinkOut = 0.1f;
+const float gfVRLadderBlinkWait = 0.1f;
+const float gfVRLadderBlinkIn = 0.15f;
+
=155
