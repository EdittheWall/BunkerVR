+		mvVRClimbSqueezed[0] = true;
+		mvVRClimbSqueezed[1] = true;
+		mvVRClimbOnKeep[0] = false;
+		mvVRClimbOnKeep[1] = false;
+		mlVRClimbHand = -1;
+		mfVRClimbMovingFor = 0;
