+
+	// BunkerVR: the ladder climbed hand over hand (VRUpdateHandClimb).
+	[nosave] array<bool> mvVRClimbHeld = {false, false};		// each hand's hold on the rungs (0 left, 1 right)
+	[nosave] array<bool> mvVRClimbSqueezed = {true, true};	// each grip squeezed at the last update
+	[nosave] int mlVRClimbHand = -1;						// the hand that climbs (the last to take hold), -1 none...
+	[nosave] float mfVRClimbGrabRel = 0;					// ...its height over the game's camera as it took hold...
+	[nosave] float mfVRClimbGrabBodyY = 0;					// ...and the body's height then
+	[nosave] float mfVRClimbHoldStartY = 0;					// the body's height as this hold began (the exits, the hint)
+	[nosave] float mfVRClimbMovingFor = 0;					// seconds the climbing animation still plays
+	[nosave] float mfVRClimbDir = 0;						// which way the hands last moved the body: 1 up, -1 down
+	[nosave] float mfVRClimbBeyond = 0;						// how far the climbing hand asks the body past the top (+) or the foot (-)
+	[nosave] bool mbVRClimbByHand = false;					// the hands climbed last, not the stick (the game's rung sounds left out)
+	[nosave] int mlVRClimbNotes = 0;						// "BunkerVR ladder:" lines this time on the ladder (VRClimbNote)
+	[nosave] bool mbVRPalmsFollowed = false;				// are the palms tracked (VR: the stick then doesn't climb)?
+	[nosave] bool mbVRBlinkDark = false;					// has a blink (climbing on or off) the view dark? (VRClimbOnByBlink)
+	[nosave] float mfVRBlinkFor = 0;						// seconds since climbing on's blink began
+	[nosave] float mfVRSinceOn = 0;							// seconds on the ladder (mlState 1) since climbing on
+	[nosave] bool mbVRPlaced = false;						// climbing on's blink: the player placed on the ladder yet?...
+	[nosave] float mfVRCentringFor = 0;						// ...seconds since, the view being put over the body...
+	[nosave] float mfVRFacedLeft = 0;						// ...and how far the head faced from the ladder then (degrees; -1 not tracked)
+	[nosave] array<cVector3f> mvVRClimbGrip = {cVector3f(0.0f), cVector3f(0.0f)};	// where on its rung each hand holds, in the world (VRShowHandsOnRungs)
+	[nosave] array<bool> mvVRClimbOnKeep = {false, false};	// each hand that climbs on by its squeeze holds on once on (VRClimbOnHolds)
+	[nosave] bool mbVRHandsOnRungs = false;					// are hands being drawn on rungs (the door grip's values set)?
+
end
