+		mbVRClimbByHand = false;
+		mlVRClimbNotes = 0;
+		mbVRPalmsFollowed = cVR_Active(); // (the stick left out until the palms are known not to be tracked)
+		mbVRBlinkDark = false;
+		mfVRBlinkFor = 0;
