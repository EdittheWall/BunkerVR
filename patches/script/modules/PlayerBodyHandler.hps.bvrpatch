+	// BunkerVR: a jump (MenuHandler.hps VRJumpStart, the Places page) ends a scene the body is playing as the scene's own
+	// end does (its animation stopped, the body's state back to Idle: the scene's OnLeave gives back the camera, the
+	// body's gravity and collision, and the player's state), before the player is moved. Otherwise the scene stays on
+	// in the level jumped to (for example the friend's water scene in No Man's Land, jumping to Hub): the body with no
+	// gravity or collision, the view on the scene's camera, and every later jump there moving nothing.
+	void VREndSceneForJump()
+	{
+		if(mCurrentAnimationState < 0 || int(mCurrentAnimationState) >= int(mvAnimationStates.length())) return;
+		bool bScene = mvAnimationStates[mCurrentAnimationState].IsCameraAnimation();
+		if(bScene == false && mbCameraAnimation_Active == false) return;
+		tString sState = mvAnimationStates[mCurrentAnimationState].GetName();
+		tString sName = msCameraAnimation_Name;
+		if(bScene)
+		{
+			StopAnimationInLayer(msCameraAnimation_Name, ePlayerBodyAnimationLayer_FullBody, 0.0f);
+			mAnimationState_Idle.mbSkipFadeIn = true;
+			ChangeAnimationState(ePlayerBodyAnimationState_Idle);
+		}
+		SetAnimationControlledCamera(false); // (nothing more if leaving the state did it)
+		Log("BunkerVR: jump: the body's scene (" + sState + ", " + sName + ") ended before the player is moved\n");
+	}
