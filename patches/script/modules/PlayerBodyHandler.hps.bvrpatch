+		VRFollowHead(afTimeStep);
+		VRUpdateStealthLow(afTimeStep); // how low the player really is, for the Beast's sight in the dark
+		VRTimeMark(7077);
+		cScript_SetGlobalVarInt("BunkerVR_LegsOk", mbVRLegsOk ? 1 : 0);
