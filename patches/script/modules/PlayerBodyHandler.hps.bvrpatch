+			pPlayer.GetCamera().SetPosition(VRCameraPlace(pAttachNode.GetWorldPosition() + vCamPosAdd - mvVRBodyShift + cVector3f(0.0f, mfVRDuckLift, 0.0f) + mvVRSteadyLast, vCamPosAdd));
