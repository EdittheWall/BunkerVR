+		// In VR the player is "world scale" times bigger than the character, so the
+		// character's hands and arms look too small next to the controllers. The
+		// whole body is drawn bigger by that amount, and it is turned to follow
+		// the head (see above). Both are done around the point the camera hangs
+		// on (the eyes), so the view stays exactly where it was and the shoulders
+		// stay the right distance below it; the extra length goes down into the floor.
+		cMeshEntity@ pVRMeshEnt = pEntity.GetMeshEntity();
+		cNode3D@ pVRCamSocket = pVRMeshEnt !is null ? pVRMeshEnt.GetSocket("CameraSocket") : null;
+		bool bVRResize = fVRBodyScale > 1.01f || fVRBodyScale < 0.99f;
+		bool bVRTurn = fVRBodyTurn > 0.001f || fVRBodyTurn < -0.001f;
+		if(pVRCamSocket !is null && (bVRResize || bVRTurn))
+		{
+			// Where the eyes are compared with the body's own origin, as it would
+			// be at the body's real size and without the extra turn. (Worked back
+			// from where they are now, with the size and turn used last time.)
+			cVector3f vVREyes = pVRCamSocket.GetWorldPosition() - pEntity.GetMatrix().GetTranslation();
+			vVREyes = cMath_MatrixMul3x3(cMath_MatrixRotateY(-mfVRBodyTurnApplied), vVREyes) * (1.0f / mfVRBodyScaleApplied);
+			
+			// Place the body so that, resized and turned, its eyes are where they were.
+			float fVRSize = bVRResize ? fVRBodyScale : 1.0f;
+			vPos = vPos + vVREyes - cMath_MatrixMul3x3(cMath_MatrixRotateY(fVRBodyTurn), vVREyes) * fVRSize;
+			if(bVRResize)
+				mtxBodyOrientation = cMath_MatrixMul(mtxBodyOrientation, cMath_MatrixScale(cVector3f(fVRSize, fVRSize, fVRSize)));
+			mfVRBodyScaleApplied = fVRSize;
+			mfVRBodyTurnApplied = fVRBodyTurn;
+		}
+		else
+		{
+			mfVRBodyScaleApplied = 1.0f;
+			mfVRBodyTurnApplied = 0.0f;
+		}
+		
