=273
+		// BunkerVR: in VR the drawn feet turn at once with every turn of the game's body (the
+		// stick, a snap turn, the turn while walking), as the view does. The game turns them
+		// after it, at its own pace, the upper body twisted towards the camera meanwhile: turned
+		// with the stick, the chest would swing round some 17 degrees behind the view and the
+		// hips 45, and both go on turning for a second after the stick is let go, like a puppet.
+		// The real head's own turn is followed as usual (mfVRBodyTurn, UpdateOrientation), and
+		// walking still turns the feet the way they walk. (A turn of more than 90 degrees in one
+		// update is a jump or a scene's end, which the game places itself: not followed.)
+		if(mbVRSeen && mbCameraAnimation_Active == false && mbAttached == false)
+		{
+			float fVRCharYaw = pCharBody.GetYaw();
+			if(mbVRFeetYawKnown)
+			{
+				float fVRTurned = cMath_GetAngleDistanceRad(mfVRFeetCharYaw, fVRCharYaw);
+				if(cMath_Abs(fVRTurned) < cMath_Pi * 0.5f)
+				{
+					mfYaw += fVRTurned;
+					mfTargetYaw += fVRTurned;
+					// (And all these turns added up, for the drawn feet planted on the floor
+					// to go round with them: UpdateVRLegs in Prop_PlayerBody.hps.)
+					mfVRGameTurnSum += fVRTurned;
+					if(mfVRGameTurnSum > cMath_Pi) mfVRGameTurnSum -= cMath_Pi * 2.0f;
+					if(mfVRGameTurnSum < -cMath_Pi) mfVRGameTurnSum += cMath_Pi * 2.0f;
+					cScript_SetGlobalVarFloat("BunkerVR_GameTurnSum", mfVRGameTurnSum);
+				}
+			}
+			mfVRFeetCharYaw = fVRCharYaw;
+			mbVRFeetYawKnown = true;
+		}
+		else mbVRFeetYawKnown = false;
