=144
+	// BunkerVR: lets a hand hold a loose object without the game's own grab.
+	// The game can only grab with one hand at a time (it has one interact
+	// button). When the other hand squeezes meanwhile, the VR mod reports it
+	// here (special roll value 7014), and this code finds a loose object at
+	// that hand and moves it along with the hand until the hand lets go.
+	void VRUpdateFreeHands(float afTimeStep)
+	{
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		cCamera@ pCam = pPlayer !is null ? pPlayer.GetCamera() : null;
+		if(pCam is null) return;
+		
+		int lMask = 0;
+		cMatrixf mtxLeft = cMatrixf_Identity;
+		cMatrixf mtxRight = cMatrixf_Identity;
+		
+		float fRealRoll = pCam.GetRoll();
+		pCam.SetRoll(7014.0f);
+		cVector3f vStatus = pCam.GetMatrix().GetTranslation();
+		if(vStatus.x > 12344.0f && vStatus.x < 12346.0f)
+		{
+			lMask = int(vStatus.y + 0.5f);
+			
+			// Throw strength, from the mod's menu.
+			pCam.SetRoll(7032.0f);
+			float fBoost = pCam.GetMatrix().GetTranslation().z;
+			if(fBoost > 0.19f && fBoost < 5.01f) mfVRThrowBoost = fBoost;
+			
+			// (Each from the hand that is seen, which may be held back from the
+			// real one at a table or a wall: see VRHandBlock in Prop_PlayerBody.hps.
+			// So a hand resting on a table finds what lies on it, and what it
+			// holds stays with it.)
+			if(lMask == 1 || lMask == 3)
+			{
+				pCam.SetRoll(7011.0f);
+				mtxLeft = pCam.GetMatrix();
+				cVector3f vBack = cScript_GetGlobalVarVector3f("BunkerVR_HandBack0");
+				if(vBack.Length() < 0.6f) mtxLeft.SetTranslation(mtxLeft.GetTranslation() + vBack);
+			}
+			if(lMask == 2 || lMask == 3)
+			{
+				pCam.SetRoll(7012.0f);
+				mtxRight = pCam.GetMatrix();
+				cVector3f vBack = cScript_GetGlobalVarVector3f("BunkerVR_HandBack1");
+				if(vBack.Length() < 0.6f) mtxRight.SetTranslation(mtxRight.GetTranslation() + vBack);
+			}
+		}
+		pCam.SetRoll(fRealRoll);
+		
+		VRUpdateFreeHand(0, @mVRHoldLeft, lMask == 1 || lMask == 3, mtxLeft, @mVRHoldRight, afTimeStep);
+		VRUpdateFreeHand(1, @mVRHoldRight, lMask == 2 || lMask == 3, mtxRight, @mVRHoldLeft, afTimeStep);
+
+		// Which hands really hold something by themselves (1 left + 2 right), for
+		// the arms' code (Prop_PlayerBody.hps): a hand squeezed on nothing is an
+		// empty fist, which bumps into things as an open hand does.
+		cScript_SetGlobalVarInt("BunkerVR_FreeHolding", (mVRHoldLeft.m_idBody != tID_Invalid ? 1 : 0) + (mVRHoldRight.m_idBody != tID_Invalid ? 2 : 0));
+
+		// For the game's grab: which hand helps it hold its thing
+		// (-1: none; the rest is told in VRUpdateFreeHand), and what each hand
+		// holds by itself, with whether that thing had its gravity and bumped
+		// into the player before the hand took it (for when the grab takes it
+		// over: see VRTakeOriginalsFromHand in PlayerState_Interact_Grab.hps).
+		cScript_SetGlobalVarInt("BunkerVR_HelperHand", mVRHoldLeft.mbHelping ? 0 : (mVRHoldRight.mbHelping ? 1 : -1));
+		if(mVRHoldLeft.mbHelping == false && mVRHoldRight.mbHelping == false) cScript_SetGlobalVarID("BunkerVR_HelperBody", tID_Invalid); // (nothing stale left to be read)
+		cScript_SetGlobalVarID("BunkerVR_FreeBody0", mVRHoldLeft.mbHelping ? tID_Invalid : mVRHoldLeft.m_idBody);
+		cScript_SetGlobalVarBool("BunkerVR_FreeGravity0", mVRHoldLeft.mbHadGravity);
+		cScript_SetGlobalVarBool("BunkerVR_FreeBump0", mVRHoldLeft.mbCollidedCharacter);
+		cScript_SetGlobalVarID("BunkerVR_FreeBody1", mVRHoldRight.mbHelping ? tID_Invalid : mVRHoldRight.m_idBody);
+		cScript_SetGlobalVarBool("BunkerVR_FreeGravity1", mVRHoldRight.mbHadGravity);
+		cScript_SetGlobalVarBool("BunkerVR_FreeBump1", mVRHoldRight.mbCollidedCharacter);
+	}
+	
+	//------------------------------------------------------------
+	
+	void VRUpdateFreeHand(int alHand, cVRFreeHold@ apHold, bool abSqueezing, const cMatrixf &in a_mtxHand, cVRFreeHold@ apOtherHold, float afTimeStep)
+	{
+		/////////////////////////////
+		// Let go
+		if(abSqueezing == false)
+		{
+			if(apHold.m_idBody != tID_Invalid) VRReleaseFreeHold(apHold);
+			apHold.mbWasSqueezing = false;
+			return;
+		}
+		
+		bool bJustSqueezed = apHold.mbWasSqueezing == false;
+		apHold.mbWasSqueezing = true;
+		apHold.mfSqueezedFor = bJustSqueezed ? 0.0f : apHold.mfSqueezedFor + afTimeStep;
+		
+		/////////////////////////////
+		// Take hold: as the hand closes, or what it touches within
+		// gfVRFreeHoldSqueezeWait of closing, the grip still squeezed, so a hand
+		// closed a moment before it reaches a thing doesn't have to open and
+		// close again. The hand-over from the game's grab below is only for
+		// the moment it closes.
+		if(apHold.m_idBody == tID_Invalid)
+		{
+			if(bJustSqueezed == false && apHold.mfSqueezedFor > gfVRFreeHoldSqueezeWait) return;
+			
+			// This same hand's squeeze was the game's grab until now, and the mod
+			// has just given the game's interact button to the other hand, which
+			// reached for something only the game can use (see UpdateGrabInput in
+			// vr.cpp). What the grab holds in this
+			// hand passes to this hand's own hold, as soon as the grab has let go
+			// of it (below: VRTakeOverFromGrab, as when the other hand of two lets
+			// go), held where the hand holds it now. The grab is told not to throw
+			// it ("BunkerVR_HandOverBody", see VRHandingOver there).
+			// (Or the grab has let go of it already, from this hand, a moment
+			// ago: "BunkerVR_GrabLeftBody"; then this hand keeps it at once.)
+			tID idGrabbed = VRGrabBodyNow();
+			bool bGrabLeft = false;
+			if(idGrabbed == tID_Invalid || cScript_GetGlobalVarInt("BunkerVR_GrabHand") != alHand)
+			{
+				idGrabbed = tID_Invalid;
+				float fLeftAge = float(cEngine_GetGameTime()) - cScript_GetGlobalVarFloat("BunkerVR_GrabLeftTime");
+				if(cScript_GetGlobalVarInt("BunkerVR_GrabLeftHand") == alHand && fLeftAge > -0.001f && fLeftAge < 0.2f)
+				{
+					idGrabbed = cScript_GetGlobalVarID("BunkerVR_GrabLeftBody");
+					bGrabLeft = true;
+				}
+			}
+			iPhysicsBody@ pGrabbed = (bJustSqueezed && idGrabbed != tID_Invalid) ? cLux_ID_Body(idGrabbed) : null; // (only as it closes)
+			if(pGrabbed !is null && pGrabbed.GetID() != apOtherHold.m_idBody)
+			{
+				apHold.m_idBody = idGrabbed;
+				apHold.mbTakingOver = true;
+				apHold.mfTakingOverTime = 0.0f;
+				apHold.mbHelping = false;
+				apHold.mvHelpGrip = cMath_MatrixMul(cMath_MatrixInverse(pGrabbed.GetLocalMatrix()), a_mtxHand.GetTranslation());
+				apHold.mlHandTrailCount = 0;
+				cScript_SetGlobalVarID("BunkerVR_HandOverBody", idGrabbed);
+				cScript_SetGlobalVarFloat("BunkerVR_HandOverTime", float(cEngine_GetGameTime()));
+				Log("BunkerVR: the other hand takes the game's interact button: this hand keeps what the game's grab held in it, by itself" +
+					(bGrabLeft ? " (the grab had let go already)" : "") + "\n");
+				if(bGrabLeft)
+				{
+					apHold.mbTakingOver = false;
+					VRTakeOverFromGrab(apHold, pGrabbed, a_mtxHand, false);
+				}
+				return;
+			}
+
+			cVector3f vForward = cMath_MatrixMul3x3(a_mtxHand, cVector3f(0.0f, 0.0f, -1.0f));
+			cVector3f vRight = cMath_MatrixMul3x3(a_mtxHand, cVector3f(1.0f, 0.0f, 0.0f));
+			cVector3f vUp = cMath_MatrixMul3x3(a_mtxHand, cVector3f(0.0f, 1.0f, 0.0f));
+			vForward.Normalize();
+			vRight.Normalize();
+			vUp.Normalize();
+			
+			// A fan of short rays from just behind the palm: straight out of
+			// the hand and tilted to every side. The nearest loose object wins.
+			// (Normally only what the hand touches, as the arms' code reports it
+			// ("BunkerVR_TouchEntity0/1"...; see VRHandTouchFind in
+			// Prop_PlayerBody.hps); the rays only when it hasn't reported just
+			// now, the arms not being drawn.)
+			cVector3f vStart = a_mtxHand.GetTranslation() - vForward * 0.05f;
+			float fBest = gfVRFreeHoldReach;
+			iPhysicsBody@ pBest = null;
+			cVector3f vBestSpot = cVector3f(0.0f);	// where the ray touched it
+			bool bBestHelps = false;				// is it what the other hand holds with the game's grab?
+			bool bBestHeavy = false;				// is it a heavy thing (the urn, the concrete block)?
+			tID idGrabBody = VRGrabBodyNow();
+			cLuxClosestEntityData hitData;
+			tString sTouchHand = alHand == 0 ? "0" : "1";
+			float fTouchAge = float(cEngine_GetGameTime()) - cScript_GetGlobalVarFloat("BunkerVR_TouchTime" + sTouchHand);
+			bool bByTouch = fTouchAge > -0.001f && fTouchAge < 0.25f;
+			if(bByTouch)
+			{
+				iPhysicsBody@ pTouched = cLux_ID_Body(cScript_GetGlobalVarID("BunkerVR_TouchBody" + sTouchHand));
+				iLuxEntity@ pTouchedEntity = cLux_ID_Entity(cScript_GetGlobalVarID("BunkerVR_TouchEntity" + sTouchHand));
+				if(pTouched !is null && pTouchedEntity !is null && pTouched.GetID() != apOtherHold.m_idBody)
+				{
+					// What the other hand holds with the game's grab: this hand
+					// helps to hold it. Anything else: only what one hand may
+					// carry by itself.
+					bool bHelps = idGrabBody != tID_Invalid && pTouched.GetID() == idGrabBody;
+					if(bHelps || VRCanFreeHold(pTouchedEntity, pTouched))
+					{
+						@pBest = pTouched;
+						vBestSpot = cScript_GetGlobalVarVector3f("BunkerVR_TouchSpot" + sTouchHand);
+						bBestHelps = bHelps;
+						bBestHeavy = pTouchedEntity.GetVarBool("BunkerVR_IsHeavy");
+					}
+				}
+			}
+			for(int x = -1; x <= 1 && bByTouch == false; ++x)
+			{
+				for(int y = -1; y <= 1; ++y)
+				{
+					cVector3f vDir = vForward + (vRight * float(x) + vUp * float(y)) * 0.9f;
+					vDir.Normalize();
+
+					if(cLux_GetClosestEntity(vStart, vDir, gfVRFreeHoldReach, 0, false, hitData) == false) continue;
+					if(hitData.mpEntity is null || hitData.mpBody is null) continue;
+					if(hitData.mfDistance >= fBest) continue;
+					if(hitData.mpBody.GetID() == apOtherHold.m_idBody) continue;
+					// What the other hand holds with the game's grab: this hand
+					// helps to hold it, if it is at it. Anything else:
+					// only what one hand may carry by itself.
+					bool bHelps = idGrabBody != tID_Invalid && hitData.mpBody.GetID() == idGrabBody;
+					if(bHelps)
+					{
+						if(hitData.mfDistance > gfBunkerVR_TwoHandReach) continue;
+					}
+					else if(VRCanFreeHold(hitData.mpEntity, hitData.mpBody) == false) continue;
+
+					fBest = hitData.mfDistance;
+					@pBest = hitData.mpBody;
+					vBestSpot = vStart + vDir * hitData.mfDistance;
+					bBestHelps = bHelps;
+					bBestHeavy = hitData.mpEntity.GetVarBool("BunkerVR_IsHeavy"); // (set by its grab script, Prop_Grab.hps or Prop_Tear.hps)
+				}
+			}
+			if(pBest is null) return;
+
+			// Helping: where this hand holds it, in its own terms; the grab moves
+			// it, its gravity and bumping stay as the grab has them. The hand
+			// holds it where the hand is (not at the spot its ray touched: the
+			// hand drawn there would jump, and the thing be turned to suit). Told
+			// to the grab at once (VRHelp): told only on the next update, the
+			// grab could meanwhile read what the last helping hand had reported,
+			// often about this same thing, and flip it round, the hands seeming
+			// to stretch apart.
+			if(bBestHelps)
+			{
+				VRStartHelping(apHold, pBest, a_mtxHand, a_mtxHand.GetTranslation());
+				VRHelp(alHand, apHold, pBest, a_mtxHand, afTimeStep);
+				return;
+			}
+			// (Weight: too heavy for one hand to hold up: dragged too, as the
+			// game's grab does; see BunkerVR_TooHeavyForOneHand.)
+			if(BunkerVR_TooHeavyForOneHand(pBest.GetMass())) bBestHeavy = true;
+
+			// Remember where it is and how it is turned, as the hand sees it,
+			// so it stays like that in the hand. If it is further off than a
+			// hand's length it is drawn in.
+			// (First it is drawn into the hand, the spot the ray touched to the
+			// center of the grip, which is where this hand's matrix is: see
+			// BunkerVR_HoldPull. Otherwise it would be held in the air.)
+			// A heavy thing (the game's "Grab_IsHeavy": the urn, the concrete
+			// block) is not drawn in nor lifted: it keeps its weight and is
+			// dragged along the floor, as the game's grab drags it, with the
+			// hand on the spot where it holds it (gfBunkerVR_HeavySlip). One
+			// hand can't lift it like a can.
+			cMatrixf mtxHandInv = cMath_MatrixInverse(a_mtxHand);
+			cVector3f vBodyAt = pBest.GetLocalPosition();
+			if(bBestHeavy == false) vBodyAt = BunkerVR_HoldPull(vBodyAt, vBestSpot, a_mtxHand.GetTranslation());
+			apHold.mvOffset = cMath_MatrixMul(mtxHandInv, vBodyAt);
+			// (No further than its own size allows, at least
+			// gfBunkerVR_HoldReachLeast, as in the game's grab; see
+			// BunkerVR_HoldReachLimit. A big thing is held where it was taken,
+			// not drawn in to its center.)
+			float fOffsetLength = apHold.mvOffset.Length();
+			float fOffsetLimit = BunkerVR_HoldReachLimit(pBest, gfBunkerVR_HoldReachLeast);
+			if(fOffsetLength > fOffsetLimit)
+				apHold.mvOffset = apHold.mvOffset * (fOffsetLimit / fOffsetLength);
+			
+			cMatrixf mtxInvHandRot = cMath_MatrixInverse(a_mtxHand.GetRotation());
+			apHold.m_mtxRotation = cMath_MatrixMul(mtxInvHandRot, pBest.GetLocalMatrix().GetRotation());
+			
+			apHold.mbHadGravity = pBest.GetGravity();
+			apHold.mbCollidedCharacter = pBest.GetCollideCharacter();
+			if(bBestHeavy == false) pBest.SetGravity(false); // (a heavy thing keeps its weight)
+			pBest.SetCollideCharacter(false);
+			pBest.Enable();
+			apHold.m_idBody = pBest.GetID();
+			apHold.mlHandTrailCount = 0;
+			apHold.mbSettling = false;
+			apHold.mbPullingIn = bBestHeavy == false; // (it glides in; see BunkerVR_HoldPullSpeed)
+			apHold.mfPullSpeed = 0.0f;
+			apHold.mfPullTime = 0.0f;
+			apHold.mbHelping = false;
+			apHold.mbHeavy = bBestHeavy;
+			apHold.mvHeavyGrip = cMath_MatrixMul(cMath_MatrixInverse(pBest.GetLocalMatrix()), a_mtxHand.GetTranslation());
+			apHold.mbFeedKnown = false;
+			apHold.mfBlockedTime = 0.0f;
+			apHold.mfCaughtFor = 0.0f;
+			apHold.mWeight.Reset(); // (it starts at the hand)
+			if(bBestHeavy) Log("BunkerVR: a hand takes hold of a heavy thing by itself: it drags it\n");
+		}
+
+		/////////////////////////////
+		// Keep it in the hand
+		iPhysicsBody@ pBody = cLux_ID_Body(apHold.m_idBody);
+		if(pBody is null)
+		{
+			apHold.m_idBody = tID_Invalid; // gone (map change, destroyed)
+			apHold.mbHelping = false;
+			apHold.mbHeavy = false;
+			return;
+		}
+		if(afTimeStep < 0.0001f) return;
+
+		// Taking over what the game's grab held in this hand (see above):
+		// nothing to do while the grab still has it (it is let go on the
+		// game's next update); then this hand keeps it. Given up after half a
+		// second (the grab never let go).
+		if(apHold.mbTakingOver)
+		{
+			if(VRGrabBodyNow() == apHold.m_idBody)
+			{
+				apHold.mfTakingOverTime += afTimeStep;
+				if(apHold.mfTakingOverTime > 0.5f)
+				{
+					Log("BunkerVR: the game's grab did not let go of what this hand was to keep: left to the grab\n");
+					apHold.mbTakingOver = false;
+					apHold.m_idBody = tID_Invalid;
+				}
+				return;
+			}
+			apHold.mbTakingOver = false;
+			VRTakeOverFromGrab(apHold, pBody, a_mtxHand, false);
+		}
+
+		// Both hands on one thing (see BunkerVR_TwoHandPlace in
+		// helper_bunkervr.hps).
+		tID idGrabBody = VRGrabBodyNow();
+		if(apHold.mbHelping)
+		{
+			if(idGrabBody == apHold.m_idBody)
+			{
+				// The hands too far apart, or too near together, for their places
+				// on it: this hand slips off (the grab says when; see
+				// gfBunkerVR_TwoHandStretch). The signal is used up.
+				float fSlipAge = float(cEngine_GetGameTime()) - cScript_GetGlobalVarFloat("BunkerVR_HelperLetGoTime");
+				if(cMath_Abs(fSlipAge) < 0.25f)
+				{
+					cScript_SetGlobalVarFloat("BunkerVR_HelperLetGoTime", -1000.0f);
+					VRReleaseFreeHold(apHold);
+					return;
+				}
+				VRHelp(alHand, apHold, pBody, a_mtxHand, afTimeStep);
+				return;
+			}
+			// Both hands lost it (it fell too far behind them, or was stuck):
+			// this one lets go too (see gfBunkerVR_TwoHandLetGo).
+			float fDropAge = float(cEngine_GetGameTime()) - cScript_GetGlobalVarFloat("BunkerVR_TwoHandDropTime");
+			if(cMath_Abs(fDropAge) < 0.25f)
+			{
+				VRReleaseFreeHold(apHold);
+				return;
+			}
+			// The other hand has let go of it: this one keeps it, as if it had
+			// taken hold of it alone (held on below, from this update).
+			VRTakeOverFromGrab(apHold, pBody, a_mtxHand, true);
+		}
+		else if(idGrabBody == apHold.m_idBody)
+		{
+			// The other hand has taken hold of what this one holds, with the
+			// game's grab, which moves it now: this one helps. (The grab took
+			// what the thing had before this hand took it: see
+			// VRTakeOriginalsFromHand in PlayerState_Interact_Grab.hps.) Where
+			// the hand is drawn on it now (fixed to it, turned with it, by this
+			// hold's weight; on a heavy thing's spot), not the real hand, which
+			// may be off it: otherwise the drawn hand jumps there as the other
+			// hand takes hold.
+			cMatrixf mtxDrawnNow = a_mtxHand;
+			if(apHold.mbHeavy) mtxDrawnNow.SetTranslation(cMath_MatrixMul(pBody.GetLocalMatrix(), apHold.mvHeavyGrip));
+			else if(gbBunkerVR_Weight && gbBunkerVR_HandOnThing)
+			{
+				cMatrixf mtxHandWantsNow = cMath_MatrixMul(a_mtxHand.GetRotation(), apHold.m_mtxRotation);
+				mtxHandWantsNow.SetTranslation(cMath_MatrixMul(a_mtxHand, apHold.mvOffset));
+				mtxDrawnNow = cMath_MatrixMul(pBody.GetLocalMatrix(), cMath_MatrixMul(cMath_MatrixInverse(mtxHandWantsNow), a_mtxHand));
+			}
+			VRStartHelping(apHold, pBody, mtxDrawnNow, mtxDrawnNow.GetTranslation());
+			VRHelp(alHand, apHold, pBody, a_mtxHand, afTimeStep);
+			return;
+		}
+
+		cVector3f vWantedPos = cMath_MatrixMul(a_mtxHand, apHold.mvOffset);
+		cMatrixf mtxWanted = cMath_MatrixMul(a_mtxHand.GetRotation(), apHold.m_mtxRotation);
+		mtxWanted.SetTranslation(vWantedPos);
+		// Weight (see gbBunkerVR_Weight): it is held at its carried place,
+		// which follows where the hand wants it as a weight would, as in the
+		// game's grab (not a heavy thing: dragged, it trails anyway).
+		// Where the hand wants it is kept, for where the hand is drawn.
+		cMatrixf mtxHandWants = mtxWanted;
+		bool bWeighted = gbBunkerVR_Weight && apHold.mbHeavy == false;
+		if(bWeighted)
+		{
+			cVector3f vSpot = cMath_MatrixMul(cMath_MatrixInverse(mtxWanted), a_mtxHand.GetTranslation()); // (held at the hand)
+			mtxWanted = apHold.mWeight.Update(cLux_GetPlayer().GetCamera(), pBody, mtxWanted, vSpot, pBody.GetMass(), 1, 0.0f, afTimeStep,
+											  apHold.mbPullingIn == false && apHold.mbSettling == false, apHold.mbPullingIn);
+			vWantedPos = mtxWanted.GetTranslation();
+		}
+		else apHold.mWeight.Reset();
+		// The feed (see BunkerVR_HoldFeed): the speed its place moves
+		// at, so that it is sent to where its place will be by the next update,
+		// and keeps up with the hand. Not for a heavy thing (dragged, it
+		// trails), nor while it glides into the hand (that has the hand's own
+		// speed in it).
+		cVector3f vFeed = cVector3f(0.0f);
+		if(apHold.mbHeavy == false && apHold.mbPullingIn == false) vFeed = BunkerVR_HoldFeed(apHold.mvFeedWas, vWantedPos, afTimeStep, apHold.mbFeedKnown);
+		bool bFeedKnown = apHold.mbFeedKnown; // (for the feed for turning, below)
+		// (With weight, the carried place's own speed and spin, as in the
+		// game's grab.)
+		bool bWeightFeed = bWeighted && apHold.mbFeedKnown && BunkerVR_ViewJumped(afTimeStep) == false;
+		if(bWeightFeed && apHold.mbPullingIn == false) vFeed = apHold.mWeight.mvFeed;
+		apHold.mvFeedWas = vWantedPos;
+		apHold.mbFeedKnown = true;
+		cMatrixf mtxAhead = mtxWanted;
+		mtxAhead.SetTranslation(vWantedPos + vFeed * afTimeStep);
+		// Where it can be put on its way there: not into a table or a wall (see
+		// BunkerVR_HoldPlace; pressed in, it shakes and bounces). How far that is
+		// from where the hand wants it goes to the arms' code, so that the hand
+		// is drawn with the thing (see VRHandBlock in Prop_PlayerBody.hps).
+		// (Kept out of something: no feed; it goes only as far as it can.)
+		cVector3f vPlace = BunkerVR_HoldPlace(pBody, mtxAhead);
+		if((vPlace - mtxAhead.GetTranslation()).Length() > 0.002f) vFeed = cVector3f(0.0f);
+		BunkerVR_HoldNearHeadNote(alHand, pBody, vPlace - mtxAhead.GetTranslation());
+		BunkerVR_HoldNoBodyBump(pBody); // (the game can switch it on by itself: see there)
+		// In another thing that moves? (This one is then sent more softly,
+		// and with only so much strength: see BunkerVR_HoldTouch. No feed: it
+		// presses no harder than it did.)
+		cMatrixf mtxPlace = mtxWanted;
+		mtxPlace.SetTranslation(vPlace);
+		bool bTouching = BunkerVR_HoldTouch(pBody, mtxPlace, afTimeStep);
+		if(bTouching) vFeed = cVector3f(0.0f);
+		cVector3f vPosError = vPlace - pBody.GetLocalPosition();
+		if(apHold.mbHeavy) vPosError.y = 0.0f; // (a heavy thing: dragged along the floor, not lifted)
+		// How far it is behind its place as it is now (the feed's step ahead
+		// left out): what the checks below go by.
+		cVector3f vBehind = vPosError - vFeed * afTimeStep;
+		// After touching, it settles back to its place smoothly (see
+		// BunkerVR_HoldSettleSpeed), until it is nearly there.
+		if(bTouching) apHold.mbSettling = true;
+		else if(vBehind.Length() < gfBunkerVR_SettledDistance) apHold.mbSettling = false;
+		// Just taken hold of: gliding into the hand until it is there.
+		if(apHold.mbPullingIn)
+		{
+			apHold.mfPullTime += afTimeStep;
+			if(bTouching || vBehind.Length() < gfBunkerVR_PullDone || apHold.mfPullTime > gfBunkerVR_PullMaxTime) apHold.mbPullingIn = false;
+		}
+		// How far the hand is drawn from the real one: as far as the thing is
+		// kept from its place (its place less the feed's step ahead).
+		cVector3f vHoldBack = BunkerVR_HoldBack(pBody, vPlace - vFeed * afTimeStep, vWantedPos, bTouching || apHold.mbSettling);
+		if(apHold.mbHeavy)
+		{
+			// A heavy thing: the hand is drawn on the spot where it holds it.
+			// The real hand risen too far above that spot (or the
+			// thing dropped away below it): it slips out of the hand, let go
+			// and not thrown (see gfBunkerVR_HeavySlip).
+			vHoldBack = cMath_MatrixMul(pBody.GetLocalMatrix(), apHold.mvHeavyGrip) - a_mtxHand.GetTranslation();
+			if(-vHoldBack.y > gfBunkerVR_HeavySlip)
+			{
+				Log("BunkerVR: a heavy thing in one hand (its own hold): the hand rose " + int(-vHoldBack.y * 100.0f + 0.5f) + " cm above where it holds it: it slips out of the hand\n");
+				VRReleaseFreeHold(apHold, false);
+				return;
+			}
+			if(vHoldBack.Length() > gfBunkerVR_HandOffMost) vHoldBack = cVector3f(0.0f);
+		}
+		bool bGlueWeighted = bWeighted && apHold.mbPullingIn == false;
+		if(bGlueWeighted)
+		{
+			// Weight: the hand is drawn where it holds the thing, as the thing
+			// really is (as the game's grab does): a thing that lags behind a
+			// quick move takes the hand with it. (And turned with it, fixed to
+			// it; see BunkerVR_HoldGlue below.)
+			vHoldBack = cMath_MatrixMul(pBody.GetLocalMatrix(), cMath_MatrixMul(cMath_MatrixInverse(mtxHandWants), a_mtxHand.GetTranslation())) - a_mtxHand.GetTranslation();
+			if(vHoldBack.Length() > gfBunkerVR_HandOffMost) vHoldBack = cVector3f(0.0f);
+		}
+		cScript_SetGlobalVarVector3f(alHand == 0 ? "BunkerVR_HoldBack0" : "BunkerVR_HoldBack1", vHoldBack);
+		// The drawn hand fixed to the thing, where the arms are posed (see
+		// BunkerVR_HoldGlue), as in the game's grab: with weight, the
+		// palm (this hand's own matrix) where the hand wants the thing has it,
+		// turned with it; a heavy thing, the palm where it is drawn now, moved
+		// with it. (Not while it glides in, nor with "Hand fixed to what it
+		// holds" off on the Feel page.)
+		if(gbBunkerVR_HandOnThing == false) BunkerVR_HoldGlue(alHand, null, cMatrixf_Identity, false);
+		else if(bGlueWeighted) BunkerVR_HoldGlue(alHand, pBody, cMath_MatrixMul(cMath_MatrixInverse(mtxHandWants), a_mtxHand), true);
+		else if(apHold.mbHeavy)
+		{
+			cMatrixf mtxDrawn = a_mtxHand;
+			mtxDrawn.SetTranslation(a_mtxHand.GetTranslation() + vHoldBack);
+			BunkerVR_HoldGlue(alHand, pBody, cMath_MatrixMul(cMath_MatrixInverse(pBody.GetLocalMatrix()), mtxDrawn), false);
+		}
+		else BunkerVR_HoldGlue(alHand, null, cMatrixf_Identity, false);
+		if(apHold.mbHeavy == false) BunkerVR_HoldRaiseSpinLimit(pBody); // (it may spin as fast as the hand turns it; put back in VRReleaseFreeHold)
+
+		// For throwing: remember where the hand was over the last few updates.
+		for(int i = 0; i < 19; ++i) apHold.mvHandTrail[i] = apHold.mvHandTrail[i + 1];
+		apHold.mvHandTrail[19] = a_mtxHand.GetTranslation();
+		if(apHold.mlHandTrailCount < 20) apHold.mlHandTrailCount++;
+		apHold.mfHandTrailStep = afTimeStep;
+		
+		// Caught on something and left far behind: drop it. (Not thrown: it
+		// would leave with the hand's speed, and a hand pushing it hard is
+		// moving fast.)
+		if(vBehind.Length() > 0.8f)
+		{
+			VRReleaseFreeHold(apHold, false);
+			return;
+		}
+		// Caught on something (see BunkerVR_HoldStretch and
+		// BunkerVR_HoldCaughtFor): let go, not thrown, with a light buzz, when
+		// the drawn hand, fixed to it, is 25 cm from the real hand for 0.3 s, or
+		// 40 cm at once, so the drawn arm doesn't stretch. The game's grab has
+		// the same rule. Not while it glides in, nor a heavy thing dragged (its
+		// own rule above).
+		if(apHold.mbPullingIn == false && apHold.mbHeavy == false)
+		{
+			float fOff = BunkerVR_HoldStretch(pBody, cMath_MatrixMul(cMath_MatrixInverse(mtxHandWants), a_mtxHand.GetTranslation()), a_mtxHand.GetTranslation());
+			apHold.mfCaughtFor = BunkerVR_HoldCaughtFor(fOff, apHold.mfCaughtFor, afTimeStep);
+			if(apHold.mfCaughtFor > gfBunkerVR_HoldCaughtTime)
+			{
+				apHold.mfCaughtFor = 0.0f;
+				VRBuzzHand(alHand, 0.04f, 0.4f);
+				Log("BunkerVR: held in one hand (its own hold), caught on something: the hand on it " + int(fOff * 100.0f + 0.5f) + " cm from the real hand: let go\n");
+				VRReleaseFreeHold(apHold, false);
+				return;
+			}
+		}
+		else apHold.mfCaughtFor = 0.0f;
+		// Held back while hardly moving, for a moment: let go, as the game's
+		// grab does (not thrown; both hands alike).
+		if(vBehind.Length() > gfBunkerVR_HoldLetGoDistance && pBody.GetLinearVelocity().Length() < gfBunkerVR_HoldStuckSpeed)
+			apHold.mfBlockedTime += afTimeStep;
+		else
+			apHold.mfBlockedTime = 0.0f;
+		if(apHold.mfBlockedTime > gfBunkerVR_HoldLetGoTime)
+		{
+			VRReleaseFreeHold(apHold, false);
+			return;
+		}
+		
+		// Move most of the way there each update. Setting the speed (instead
+		// of the position) keeps it solid: it still bumps into things, and it
+		// keeps its speed when let go, so it can be thrown. (As firmly as the
+		// game's grab: both hands alike.)
+		float fFollow = BunkerVR_HoldFollow(apHold.mbHeavy ? gfBunkerVR_HoldFollowHeavy : gfBunkerVR_HoldFollow, vPlace, mtxAhead.GetTranslation()); // (less firmly while kept out of a table or a wall; a heavy thing half as firmly, as the game's grab drags it)
+		float fGain = fFollow / afTimeStep;
+		float fTurnGain = fGain; // (turned as firmly while touching: see gfBunkerVR_TouchTwist)
+		if(bTouching) fGain *= gfBunkerVR_TouchFollow; // (and moved less firmly while in another thing that moves)
+		cVector3f vSpeed = vPosError * fGain + vFeed * (1.0f - fFollow); // (with the feed: the rest of the way is its place moving on)
+		float fSpeed = vSpeed.Length();
+		float fMaxSpeed = apHold.mbHeavy ? gfBunkerVR_HoldMaxSpeed * gfBunkerVR_HoldHeavyShare : gfBunkerVR_HoldMaxSpeed;
+		if(fSpeed > fMaxSpeed) vSpeed = vSpeed * (fMaxSpeed / fSpeed);
+		if(bTouching) vSpeed = cMath_Vector3MaxLength(vSpeed, gfBunkerVR_TouchMaxSpeed);
+		if(bTouching) vSpeed = BunkerVR_HoldLimitChange(pBody.GetLinearVelocity(), vSpeed, gfBunkerVR_TouchAccel * afTimeStep); // (only so much strength)
+		else if(apHold.mbSettling) vSpeed = vFeed + BunkerVR_HoldSettleSpeed(pBody.GetLinearVelocity() - vFeed, vSpeed - vFeed, vBehind.Length(), afTimeStep); // (settling as the moving hand sees it)
+		else if(apHold.mbPullingIn)
+		{
+			// The hand's own speed (from its last two places), and towards its
+			// place at the glide's speed.
+			cVector3f vHandSpeed = cVector3f(0.0f);
+			if(apHold.mlHandTrailCount >= 2) vHandSpeed = (apHold.mvHandTrail[19] - apHold.mvHandTrail[18]) / afTimeStep;
+			float fError = vPosError.Length();
+			apHold.mfPullSpeed = BunkerVR_HoldPullSpeed(apHold.mfPullSpeed, fError, afTimeStep);
+			vSpeed = vHandSpeed;
+			if(fError > 0.0001f) vSpeed = vSpeed + vPosError * (apHold.mfPullSpeed / fError);
+			vSpeed = cMath_Vector3MaxLength(vSpeed, gfBunkerVR_HoldMaxSpeed); // (the hand's last two places may be a jump of the view apart)
+		}
+		if(apHold.mbHeavy)
+		{
+			// A heavy thing: its gravity is on, so falling and resting are left
+			// to its weight, and it stands and turns as its weight has it (as
+			// the game's grab drags heavy things).
+			vSpeed.y = pBody.GetLinearVelocity().y;
+			pBody.SetLinearVelocity(vSpeed);
+			return;
+		}
+		pBody.SetLinearVelocity(vSpeed);
+		
+		// Turning: the turn still needed, most of the way by the next update,
+		// plus the speed its wanted turn changes at (the feed for turning, so
+		// that it turns as fast as the hand; not while it touches another
+		// thing or settles back). The turn is worked out exactly, for any
+		// angle (BunkerVR_TurnVector; summing the cross products of its three
+		// directions and where they should point gives too little for big
+		// turns, and none at half a turn).
+		cMatrixf mtxWantedRot = mtxWanted.GetRotation(); // (with weight, as the carried place is turned)
+		cVector3f vSpinFeed = BunkerVR_HoldSpinFeed(apHold.m_mtxFeedTurnWas, mtxWantedRot, afTimeStep, bFeedKnown);
+		if(bWeightFeed) vSpinFeed = apHold.mWeight.mvSpinFeed; // (its own spin now)
+		apHold.m_mtxFeedTurnWas = mtxWantedRot;
+		// (Part of the way, as in the game's grab: gfBunkerVR_HoldSpinShare;
+		// both hands alike.)
+		cVector3f vTurnBehind = BunkerVR_TurnVector(pBody.GetLocalMatrix(), mtxWantedRot, pBody.GetAngularVelocity());
+		cVector3f vTurnSpeed = vTurnBehind * (gfBunkerVR_HoldSpinShare * fTurnGain);
+		// (The feed, but not when it has already turned past where it is
+		// wanted; see BunkerVR_FeedOvershoots.)
+		if(bTouching == false && apHold.mbSettling == false && BunkerVR_FeedOvershoots(vSpinFeed, vTurnBehind, afTimeStep) == false) vTurnSpeed = vTurnSpeed + vSpinFeed;
+		float fTurnSpeed = vTurnSpeed.Length();
+		if(fTurnSpeed > gfBunkerVR_HoldMaxSpin) vTurnSpeed = vTurnSpeed * (gfBunkerVR_HoldMaxSpin / fTurnSpeed);
+		if(bTouching || apHold.mbSettling) vTurnSpeed = BunkerVR_HoldLimitChange(pBody.GetAngularVelocity(), vTurnSpeed, BunkerVR_HoldSpinChange(pBody, afTimeStep)); // (a hand's twist)
+		pBody.SetAngularVelocity(vTurnSpeed);
+	}
+	
+	//------------------------------------------------------------
+	
+	// BunkerVR: what a hand (alHand: 0 left, 1 right) touches, for the mod
+	// (roll 7083): 0 nothing (or nothing reported just now: a hand that
+	// holds something reports nothing); 1 something a
+	// hand's own hold can take (a loose thing one hand may carry, see
+	// VRCanFreeHold, or what the game's grab holds, to help hold it); 2
+	// something only the game's own interaction can use (a door, a lever, a
+	// wheel, a pick-up, a note, a crate or the urn: anything else the game
+	// lets the player use); 3 the door the other hand holds with the game's own
+	// interaction (the mod then leaves the game's button with that
+	// hand, and this hand takes hold of the door too; see VRUpdateHelpHand in
+	// PlayerState_Interact_SwingDoor.hps). From what the arms' code found the
+	// hand touching ("BunkerVR_TouchEntity0/1"...; see VRHandTouchFind in
+	// Prop_PlayerBody.hps).
+	int VRTouchKind(int alHand)
+	{
+		tString sHand = alHand == 0 ? "0" : "1";
+		float fAge = float(cEngine_GetGameTime()) - cScript_GetGlobalVarFloat("BunkerVR_TouchTime" + sHand);
+		if(fAge < -0.001f || fAge > 0.25f) return 0;
+		iPhysicsBody@ pBody = cLux_ID_Body(cScript_GetGlobalVarID("BunkerVR_TouchBody" + sHand));
+		iLuxEntity@ pEntity = cLux_ID_Entity(cScript_GetGlobalVarID("BunkerVR_TouchEntity" + sHand));
+		if(pBody is null || pEntity is null) return 0;
+		// (The held door reports which it is and which hand, on every update: 1
+		// left, 2 right. A report older than a quarter of a second is ignored.)
+		float fDoorAge = float(cEngine_GetGameTime()) - cScript_GetGlobalVarFloat("BunkerVR_DoorTime");
+		if(cScript_GetGlobalVarInt("BunkerVR_DoorHand") == 2 - alHand && fDoorAge > -0.001f && fDoorAge < 0.25f &&
+		   pBody.GetID() == cScript_GetGlobalVarID("BunkerVR_DoorBody")) return 3;
+		tID idGrabBody = VRGrabBodyNow();
+		if(idGrabBody != tID_Invalid && pBody.GetID() == idGrabBody) return 1;
+		if(VRCanFreeHold(pEntity, pBody)) return 1;
+		if(pEntity.GetInteractionDisabled() == false && pEntity.CanInteract(0, pBody)) return 2;
+		return 0;
+	}
+
+	//------------------------------------------------------------
+
+	// Can a hand hold this by itself? Only loose things the game would let the
+	// player carry in one hand, that nothing else is holding.
+	bool VRCanFreeHold(iLuxEntity@ apEntity, iPhysicsBody@ apBody)
+	{
+		if(apEntity.GetInteractionDisabled()) return false;
+		if(apEntity.CanInteract(0, apBody) == false) return false;
+		if(apEntity.GetInteractIconId(0, apBody) != eCrossHairState_CarryOneHanded) return false;
+		
+		float fMass = apBody.GetMass();
+		if(fMass <= 0.0f || fMass > gfVRFreeHoldMaxMass) return false;
+		
+		// The game's own grab (and this code) switch gravity off for what they
+		// hold, so a body without gravity is already in a hand.
+		if(apBody.GetGravity() == false) return false;
+		
+		return true;
+	}
+	
+	//------------------------------------------------------------
+	
+	// BunkerVR: what the game's grab holds now (the other hand), or nothing.
+	// The grab reports it on every update ("BunkerVR_GrabBody", and when:
+	// "BunkerVR_GrabTime"); a report older than a quarter of a second is
+	// ignored (after a reload of the scripts the same thing may have the same
+	// ID again, and a grab that was going on then never reported that it had
+	// stopped).
+	tID VRGrabBodyNow()
+	{
+		tID idBody = cScript_GetGlobalVarID("BunkerVR_GrabBody");
+		if(idBody == tID_Invalid) return tID_Invalid;
+		float fAge = float(cEngine_GetGameTime()) - cScript_GetGlobalVarFloat("BunkerVR_GrabTime");
+		if(cMath_Abs(fAge) > 0.25f) return tID_Invalid;
+		return idBody;
+	}
+
+	// BunkerVR: this hand starts to help the other hand's grab hold what it
+	// holds (see BunkerVR_TwoHandPlace in helper_bunkervr.hps): where it
+	// holds it (avGripAt, in the world) is noted in the thing's own terms,
+	// and how the hand (a_mtxHand) is drawn there, turned;
+	// the grab moves it, and its gravity and its bumping into the player stay
+	// as the grab has them.
+	void VRStartHelping(cVRFreeHold@ apHold, iPhysicsBody@ apBody, const cMatrixf &in a_mtxHand, const cVector3f &in avGripAt)
+	{
+		apHold.m_idBody = apBody.GetID();
+		apHold.mbHelping = true;
+		apHold.mbHeavy = false;
+		apHold.mvHelpGrip = cMath_MatrixMul(cMath_MatrixInverse(apBody.GetLocalMatrix()), avGripAt);
+		cMatrixf mtxAt = a_mtxHand;
+		mtxAt.SetTranslation(avGripAt);
+		apHold.m_mtxHelpPalm = cMath_MatrixMul(cMath_MatrixInverse(apBody.GetLocalMatrix()), mtxAt);
+		apHold.mlHandTrailCount = 0;
+		apHold.mbSettling = false;
+		apHold.mbPullingIn = false;
+		apHold.mbFeedKnown = false;
+		apHold.mWeight.Reset();
+		Log("BunkerVR: a hand helps to hold what the other hand holds\n");
+	}
+
+	// BunkerVR: helping (each update): tells the grab where on the thing this
+	// hand holds it and where the hand is, and draws the hand on that place on
+	// the thing. Notes where the hand has been, for a throw should this hand
+	// keep it and let go.
+	void VRHelp(int alHand, cVRFreeHold@ apHold, iPhysicsBody@ apBody, const cMatrixf &in a_mtxHand, float afTimeStep)
+	{
+		cScript_SetGlobalVarID("BunkerVR_HelperBody", apHold.m_idBody);
+		cScript_SetGlobalVarVector3f("BunkerVR_HelperGrip", apHold.mvHelpGrip);
+		cScript_SetGlobalVarVector3f("BunkerVR_HelperAt", a_mtxHand.GetTranslation());
+		cScript_SetGlobalVarMatrix("BunkerVR_HelperHandTurn", a_mtxHand.GetRotation()); // (the grab turns the thing with both hands' turns, half and half)
+		cScript_SetGlobalVarInt("BunkerVR_HelperHand", alHand); // (set again at the end of the update, VRUpdateFreeHands)
+		cScript_SetGlobalVarFloat("BunkerVR_HelperTime", float(cEngine_GetGameTime())); // (when: for the grab's log, which of the two runs first in an update)
+		cVector3f vBack = cMath_MatrixMul(apBody.GetLocalMatrix(), apHold.mvHelpGrip) - a_mtxHand.GetTranslation();
+		if(vBack.Length() >= gfBunkerVR_HandOffMost) vBack = cVector3f(0.0f);
+		cScript_SetGlobalVarVector3f(alHand == 0 ? "BunkerVR_HoldBack0" : "BunkerVR_HoldBack1", vBack);
+		// (Fixed to the thing where the arms are posed, see BunkerVR_HoldGlue:
+		// moved and turned with it, as the hand was drawn when it took hold, so
+		// twisting the wrist against the other hand doesn't turn the drawn
+		// hand off the thing.)
+		if(gbBunkerVR_HandOnThing) BunkerVR_HoldGlue(alHand, apBody, apHold.m_mtxHelpPalm, true);
+		else BunkerVR_HoldGlue(alHand, null, cMatrixf_Identity, false); // (the Feel page: not fixed)
+		for(int i = 0; i < 19; ++i) apHold.mvHandTrail[i] = apHold.mvHandTrail[i + 1];
+		apHold.mvHandTrail[19] = a_mtxHand.GetTranslation();
+		if(apHold.mlHandTrailCount < 20) apHold.mlHandTrailCount++;
+		apHold.mfHandTrailStep = afTimeStep;
+	}
+
+	// BunkerVR: the other hand has let go of what this one helped to hold:
+	// this hand keeps it, as if it had taken hold of it alone, as it is turned
+	// now, with this hand's place on it back in the hand (with the hands
+	// further apart than their places, it was between them: kept where it
+	// is, it would stay off the hand). It glides there, settling, and the
+	// hand with it. What the thing had before the grab took it (gravity,
+	// bumping into the player) comes from the grab ("BunkerVR_GrabGravity",
+	// "BunkerVR_GrabBump"), to be given back when this hand lets go. A heavy
+	// thing ("BunkerVR_GrabHeavy") keeps its gravity and is dragged along the
+	// floor, as the game's grab drags it. abWasHelping: this hand helped; it
+	// is then held as the hand is drawn on it (fixed to it, turned with it,
+	// since it took hold), not as the real hand is now: the drawn hand stays
+	// where it is on the thing, and the thing comes round to the real hand
+	// with it, instead of the drawn hand jumping to the real hand's turn.
+	void VRTakeOverFromGrab(cVRFreeHold@ apHold, iPhysicsBody@ apBody, const cMatrixf &in a_mtxHand, bool abWasHelping)
+	{
+		apHold.mbHelping = false;
+		apHold.mbHeavy = cScript_GetGlobalVarBool("BunkerVR_GrabHeavy");
+		cMatrixf mtxTurnNow = apBody.GetLocalMatrix().GetRotation();
+		cVector3f vAt = a_mtxHand.GetTranslation() - cMath_MatrixMul3x3(mtxTurnNow, apHold.mvHelpGrip);
+		if(apHold.mbHeavy) vAt = apBody.GetLocalPosition(); // (a heavy thing: dragged from where it is, its height left to its weight)
+		apHold.mvOffset = cMath_MatrixMul(cMath_MatrixInverse(a_mtxHand), vAt);
+		apHold.m_mtxRotation = cMath_MatrixMul(cMath_MatrixInverse(a_mtxHand.GetRotation()), mtxTurnNow);
+		if(abWasHelping && apHold.mbHeavy == false && gbBunkerVR_HandOnThing)
+		{
+			cMatrixf mtxFromHand = cMath_MatrixInverse(apHold.m_mtxHelpPalm);
+			apHold.mvOffset = mtxFromHand.GetTranslation();
+			apHold.m_mtxRotation = mtxFromHand.GetRotation();
+		}
+		apHold.mbHadGravity = cScript_GetGlobalVarBool("BunkerVR_GrabGravity");
+		apHold.mbCollidedCharacter = cScript_GetGlobalVarBool("BunkerVR_GrabBump");
+		apBody.SetGravity(apHold.mbHeavy);
+		apBody.SetCollideCharacter(false);
+		apBody.Enable();
+		apHold.mbSettling = apHold.mbHeavy == false; // (it glides to its place in the hand, and the hand with it; not a dragged heavy thing)
+		apHold.mbPullingIn = false;
+		apHold.mbFeedKnown = false;
+		apHold.mfBlockedTime = 0.0f;
+		apHold.mfCaughtFor = 0.0f;
+		apHold.mWeight.Reset(); // (it starts again at the hand)
+		apHold.mvHeavyGrip = apHold.mvHelpGrip; // (a heavy thing: the hand stays where it held it with both; see gfBunkerVR_HeavySlip)
+		Log(apHold.mbHeavy ? "BunkerVR: the other hand let go; this hand keeps it, dragging it (heavy)\n" : "BunkerVR: the other hand let go; this hand keeps it\n");
+	}
+
+	// abThrow: false when the hand did not let go itself (the thing was left
+	// far behind): it then keeps its own speed.
+	void VRReleaseFreeHold(cVRFreeHold@ apHold, bool abThrow = true)
+	{
+		// Still waiting to take over what the game's grab held in this hand:
+		// the grab has it, or has just let it go; nothing to give back here.
+		if(apHold.mbTakingOver)
+		{
+			apHold.mbTakingOver = false;
+			apHold.m_idBody = tID_Invalid;
+			return;
+		}
+		// Helping the other hand's grab: that grab holds it on; nothing to give
+		// back here.
+		if(apHold.mbHelping)
+		{
+			apHold.mbHelping = false;
+			apHold.m_idBody = tID_Invalid;
+			return;
+		}
+		bool bHeavy = apHold.mbHeavy;
+		apHold.mbHeavy = false;
+		iPhysicsBody@ pBody = cLux_ID_Body(apHold.m_idBody);
+		if(pBody !is null)
+		{
+			pBody.SetGravity(apHold.mbHadGravity);
+			pBody.SetCollideCharacter(apHold.mbCollidedCharacter);
+			pBody.Enable();
+			BunkerVR_HoldRestoreSpinLimit(pBody); // (its own spin limit back)
+			// (The hand stops being drawn fixed to it; see BunkerVR_HoldGlue.)
+			for(int lHand = 0; lHand < 2; ++lHand)
+				if(cScript_GetGlobalVarID("BunkerVR_HoldBody" + lHand) == apHold.m_idBody) BunkerVR_HoldGlue(lHand, null, cMatrixf_Identity, false);
+
+			// As the game's grab lets go (both hands alike): marked as thrown
+			// by the player (for the game's own reactions to thrown things),
+			// and the player's last throw time set to now.
+			pBody.SetThrownByPlayer(true);
+			cScript_RunGlobalFunc("LuxPlayer", "", "_Global_ResetTimeSinceThrow");
+
+			// It leaves with the speed the hand had at its fastest moment just
+			// now (people let go a little late, when the hand is already
+			// slowing and dropping), so it can be thrown.
+			if(abThrow && apHold.mlHandTrailCount > 3 && apHold.mfHandTrailStep > 0.0001f)
+			{
+				int lFirst = 20 - apHold.mlHandTrailCount;
+				cVector3f vBest = cVector3f(0);
+				float fBest = -1.0f;
+				for(int i = lFirst + 3; i < 20; ++i)
+				{
+					cVector3f vSpeed = (apHold.mvHandTrail[i] - apHold.mvHandTrail[i - 3]) / (apHold.mfHandTrailStep * 3.0f);
+					float fSpeed = vSpeed.Length();
+					if(fSpeed > fBest)
+					{
+						fBest = fSpeed;
+						vBest = vSpeed;
+					}
+				}
+				cVector3f vThrow = vBest * mfVRThrowBoost;
+				float fThrow = vThrow.Length();
+				float fThrowMax = bHeavy ? gfBunkerVR_ThrowMaxSpeed * 0.5f : gfBunkerVR_ThrowMaxSpeed; // (as the game's grab: a heavy thing half)
+				if(fThrow > fThrowMax) vThrow = vThrow * (fThrowMax / fThrow);
+				vThrow = BunkerVR_ThrowLimit(vThrow, pBody.GetMass()); // (only so much energy: heavy things leave slowly)
+				pBody.SetLinearVelocity(vThrow);
+				if(abThrow && vThrow.Length() > 2.0f) cVR_HintUsed("throw"); // (the hints: let go in a swing)
+				// (Logged for heavy things, such as the trenches' brick.)
+				if(pBody.GetMass() >= 8.0f) Log("BunkerVR: a " + BunkerVR_Fixed(pBody.GetMass(), 0) + " kg thing thrown at " + BunkerVR_Fixed(vThrow.Length(), 2) + " m/s (the hand at its fastest " + BunkerVR_Fixed(fBest, 2) + "; at most " + BunkerVR_Fixed(cMath_Sqrt(2.0f * BunkerVR_ThrowEnergyFor(pBody.GetMass()) / pBody.GetMass()), 2) + " for its weight)\n");
+			}
+			// Let go by the player (not dropped for being stuck): spinning no
+			// faster than the game's grab lets a thing leave (a heavy one 30%),
+			// and it may hit a character until it has stopped, as the game's
+			// grab has it.
+			if(abThrow)
+			{
+				cVector3f vSpin = pBody.GetAngularVelocity();
+				float fSpinMax = bHeavy ? gfBunkerVR_ThrowMaxSpin * 0.3f : gfBunkerVR_ThrowMaxSpin;
+				if(vSpin.Length() > fSpinMax) pBody.SetAngularVelocity(vSpin * (fSpinMax / vSpin.Length()));
+				iLuxEntity@ pEntity = cLux_GetBodyEntity(pBody);
+				cLuxProp@ pProp = pEntity !is null ? cLux_ID_Prop(pEntity.GetID()) : null;
+				if(pProp !is null) pProp.EnableCharCollisionUntilStopped();
+			}
+		}
+		apHold.m_idBody = tID_Invalid;
+	}
+	
+	//------------------------------------------------------------
+	
+	// BunkerVR: the gun. The VR mod asks for the gun to be drawn, put away or
+	// opened (special roll value 7016, second number: 1, 2 or 3), and it is
+	// done here at once, whatever the player is doing with it. Pressing the
+	// game's own gun key for the player instead only works in its normal
+	// state and after a wait, which makes the gun slow to respond.
+	// BunkerVR: a mark, for testing: the left stick held in and the right
+	// stick clicked, when something has just felt wrong. The mod notes it in
+	// its own log (BunkerVR.log, "MARK n", with its
+	// frame timings) and sends 1000 + n here. This writes into the game's log
+	// what was kept of the last gfBunkerVR_MarkSeconds: the Feel numbers in
+	// use, the turn update by update (VRDoSnapTurn), and each hold's numbers
+	// update by update (cBunkerVRWeight.DumpForMark: the hands' own holds here,
+	// the game's grab through its _Global_VRMark). One line each, starting
+	// "BunkerVR: MARK n", so they can be found.
+	void VRMark(int alMark)
+	{
+		float fNow = float(cEngine_GetGameTime());
+		Log("BunkerVR: MARK " + alMark + " (the left stick held in, the right stick clicked). The Feel numbers: " + BunkerVR_FeelText() + "\n");
+		int lFirst = -1;
+		for(int i = 0; i < mVRTurnRing.mlCount; ++i)
+		{
+			if(mVRTurnRing.mvData[mVRTurnRing.At(i)] >= fNow - gfBunkerVR_MarkSeconds)
+			{
+				lFirst = i;
+				break;
+			}
+		}
+		if(lFirst >= 0)
+		{
+			Log("BunkerVR: MARK " + alMark + ", the turn, each update: seconds before the mark | the update | the step handed over by the mod | the step turned | left queued (degrees)\n");
+			for(int i = lFirst; i < mVRTurnRing.mlCount; ++i)
+			{
+				int lAt = mVRTurnRing.At(i);
+				// (Updates with no turn at all are left out.)
+				if(cMath_Abs(mVRTurnRing.mvData[lAt + 2]) < 0.00001f && cMath_Abs(mVRTurnRing.mvData[lAt + 3]) < 0.00001f && cMath_Abs(mVRTurnRing.mvData[lAt + 4]) < 0.00001f) continue;
+				Log("BunkerVR: MARK " + alMark + " turn " + BunkerVR_Fixed(mVRTurnRing.mvData[lAt] - fNow, 3) + " s | " + BunkerVR_Fixed(mVRTurnRing.mvData[lAt + 1] * 1000.0f, 1) +
+					" ms | " + BunkerVR_Fixed(mVRTurnRing.mvData[lAt + 2] * 57.29578f, 2) + " | " + BunkerVR_Fixed(mVRTurnRing.mvData[lAt + 3] * 57.29578f, 2) +
+					" | " + BunkerVR_Fixed(mVRTurnRing.mvData[lAt + 4] * 57.29578f, 2) + "\n");
+			}
+		}
+		mVRHoldLeft.mWeight.DumpForMark(alMark, "the left hand's own hold", fNow);
+		mVRHoldRight.mWeight.DumpForMark(alMark, "the right hand's own hold", fNow);
+		cScript_SetGlobalArgInt(0, alMark);
+		cScript_RunGlobalFunc("State_Interact_Grab", "", "_Global_VRMark");
+		tString sTap = VRTapMarkNote(alMark);
+		if(sTap != "") Log(sTap + "\n");
+		Log("BunkerVR: MARK " + alMark + " ends\n");
+	}
+
+	// BunkerVR: at a mark (VRMark), with the fuel tap near: the left hand against its lever, in numbers, for tuning
+	// where the hand is drawn on it (gvVRTapHandAt): the real left palm, and the hand drawn holding it, each as where
+	// its palm's center is from the lever's hub and which way its own lines point, in the lever's own terms (along it
+	// towards the knob, up, across). Returns the log line ("" with no tap near).
+	tString VRTapMarkNote(int alMark)
+	{
+		cLuxProp@ pTap = cLux_ID_Prop(m_idVRTap);
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		if(pTap is null || pPlayer is null) return "";
+		cMatrixf mtxTap = pTap.GetMatrix();
+		cVector3f vHub = cMath_MatrixMul(mtxTap, gvVRTapHub);
+		if((pPlayer.GetCharacterBody().GetPosition() - vHub).Length() > gfVRTapNear) return "";
+		cVector3f vUp = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxTap, cVector3f(0.0f, 1.0f, 0.0f)));
+		cVector3f vShut = cMath_MatrixMul(mtxTap, gvVRTapHandleEnd) - vHub;
+		cVector3f vEnd = vHub + cMath_MatrixMul3x3(BunkerVR_TurnBy(vUp * (gfVRTapTurnSign * mfVRTapAngle)), vShut);
+		cVector3f vAlong = VRFinaleLevel(vEnd - vHub, vUp);
+		cVector3f vAcross = cMath_Vector3Cross(vAlong, vUp);
+		cMatrixf mtxPalm;
+		float fArmScale;
+		tString sReal = BunkerVR_ReadFollowedPalm(0, mtxPalm, fArmScale) ? VRTapInLever(mtxPalm, vHub, vAlong, vUp, vAcross) : "not followed";
+		return "BunkerVR: MARK " + alMark + ", the fuel tap's lever (open " + int(cMath_ToDeg(mfVRTapAngle) + 0.5f) + " degrees, held " + (mbVRTapHeld ? "yes" : "no") +
+			   ", its knob " + VRTapInLeverAt(vEnd, vHub, vAlong, vUp, vAcross) + "): the real left palm " + sReal +
+			   (mbVRTapHeld ? "; the left hand drawn on it " + VRTapInLever(m_mtxVRTapDrawn, vHub, vAlong, vUp, vAcross) : "");
+	}
+
+	// Which side of the fuel tap's lever the player stands (+1 the side its across points to, where gvVRTapHandAt and
+	// the rest were taken, the hand drawn as they give it; -1 the other, the hand mirrored).
+	float VRTapSide(const cVector3f &in avHub, const cVector3f &in avAcross)
+	{
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		return pPlayer !is null && cMath_Vector3Dot(pPlayer.GetCharacterBody().GetPosition() - avHub, avAcross) < 0.0f ? -1.0f : 1.0f;
+	}
+
+	// A way (or a place from its hub) given in the fuel tap's lever's terms (along, up, across), in the world.
+	cVector3f VRTapLeverWay(const cVector3f &in avInLever, const cVector3f &in avAlong, const cVector3f &in avUp, const cVector3f &in avAcross)
+	{
+		return avAlong * avInLever.x + avUp * avInLever.y + avAcross * avInLever.z;
+	}
+
+	// A place in the fuel tap's lever's terms (VRTapMarkNote): cm along it, up, across, from its hub.
+	tString VRTapInLeverAt(const cVector3f &in avAt, const cVector3f &in avHub, const cVector3f &in avAlong, const cVector3f &in avUp, const cVector3f &in avAcross)
+	{
+		cVector3f vFrom = avAt - avHub;
+		return BunkerVR_Fixed(cMath_Vector3Dot(vFrom, avAlong) * 100.0f, 1) + " cm along, " + BunkerVR_Fixed(cMath_Vector3Dot(vFrom, avUp) * 100.0f, 1) + " up, " +
+			   BunkerVR_Fixed(cMath_Vector3Dot(vFrom, avAcross) * 100.0f, 1) + " across";
+	}
+
+	// A palm in the fuel tap's lever's terms: its center's place, and its own lines (out of the palm, towards the first
+	// finger, towards the wrist) as along, up, across.
+	tString VRTapInLever(const cMatrixf &in a_mtxPalm, const cVector3f &in avHub, const cVector3f &in avAlong, const cVector3f &in avUp, const cVector3f &in avAcross)
+	{
+		tString sLines = "";
+		array<tString> vNames = { "out of the palm", "towards the first finger", "towards the wrist" };
+		for(int a = 0; a < 3; ++a)
+		{
+			cVector3f vLine = cMath_MatrixMul3x3(a_mtxPalm, cVector3f(a == 0 ? 1.0f : 0.0f, a == 1 ? 1.0f : 0.0f, a == 2 ? 1.0f : 0.0f));
+			vLine.Normalize();
+			sLines += ", " + vNames[a] + " " + BunkerVR_Fixed(cMath_Vector3Dot(vLine, avAlong), 2) + " " + BunkerVR_Fixed(cMath_Vector3Dot(vLine, avUp), 2) + " " +
+					  BunkerVR_Fixed(cMath_Vector3Dot(vLine, avAcross), 2);
+		}
+		return VRTapInLeverAt(a_mtxPalm.GetTranslation(), avHub, avAlong, avUp, avAcross) + sLines;
+	}
+
+	// BunkerVR: the shotgun behind the right shoulder (the mod sends command
+	// 75 for the right hand squeezed there): out, it is put away (as the gun's
+	// own put-away, aiming or not); not out and carried, it is taken out, what
+	// the right hand held before put away by the game (the revolver's aim is
+	// left first; an item in use keeps the shotgun where it is). Logged as
+	// "BunkerVR shoulder:" (the first 30).
+	// (abWaited: as the hip's, see VRHipRevolver and VRDoBodySlotWait.)
+	void VRShoulderShotgun(cLuxPlayer@ apPlayer, bool abWaited = false)
+	{
+		tString sHeld = Item_GetHeldType(eItemHandlerHand_Right);
+		int lState = apPlayer.GetCurrentStateId();
+		if(sHeld == "Shotgun")
+		{
+			if(lState == ePlayerState_Custom_UsingShotgun_Aim || lState == ePlayerState_Custom_UsingShotgun_Reload) apPlayer.ChangeState(ePlayerState_Normal);
+			if(apPlayer.GetCurrentStateId() != ePlayerState_Normal)
+			{
+				VRShoulderNote("the shotgun not put away: the player is busy (state " + apPlayer.GetCurrentStateId() + ")");
+				return;
+			}
+			Item_PutAway(eItemHandlerHand_Right);
+			VRShoulderNote("the shotgun put away behind the shoulder");
+			return;
+		}
+		if(ItemType_GetFirstInInventory("Shotgun") == "")
+		{
+			VRShoulderNote("a reach behind the shoulder: no shotgun carried");
+			return;
+		}
+		// (Only the revolver's aim or loading is left for it: an item in use, the
+		// wrench on a bolt say, keeps its state, and nothing is taken out.)
+		bool bAiming = lState == ePlayerState_Custom_UsingGun_Aim || lState == ePlayerState_Custom_UsingGun_Reload;
+		if(bAiming) apPlayer.ChangeState(ePlayerState_Normal);
+		if(apPlayer.GetCurrentStateId() != ePlayerState_Normal)
+		{
+			// (An item kept ready is waited for, as at the hip: see VRHipRevolver.)
+			if(abWaited == false && sHeld != "" && apPlayer.GetCurrentStateId() == Item_GetUsingState(sHeld))
+			{
+				mfVRShoulderWait = gfVRBodySlotWait;
+				return;
+			}
+			VRShoulderNote("the shotgun not taken out: the player is busy (state " + apPlayer.GetCurrentStateId() + ")");
+			return;
+		}
+		Item_SetLastWeaponUsed("Shotgun");
+		Item_ToggleHeldItem("Shotgun");
+		VRShoulderNote("the shotgun taken out from behind the shoulder" + (sHeld != "" ? " (" + sHeld + " put away)" : ""));
+	}
+	
+	// BunkerVR: the right chest's item slot, the VR form of the flat game's hotkey 1. The slot's
+	// item is the game's own hotkey 1 (ItemHandler.hps
+	// AssignToHotkey, TriggerHotkey), so the game's inventory marks it and a saved game keeps it.
+	// The mod sends command 79 for an empty right hand squeezed there: the slot's item taken out
+	// the game's way, as its key 1 does (Item_TriggerHotkey); and 80 for an item in the right hand
+	// squeezed there, or a thing held to throw let go of there: that item made the hotkey and put
+	// away as X puts it away (VRDoPutAwayWait). Logged as "BunkerVR chest slot:" (the first 40).
+	void VRChestSlotTake(cLuxPlayer@ apPlayer)
+	{
+		mfVRHintCarriedAt = -100.0f; // (what is carried, for the mod, looked at again at once: VRUpdateHints)
+		tString sType = Item_GetAssignedToHotkey(1);
+		if(sType == "")
+		{
+			VRChestSlotNote("a reach to the chest slot: nothing is stored in it");
+			return;
+		}
+		tString sHeld = Item_GetHeldType(eItemHandlerHand_Right);
+		if(sHeld != "")
+		{
+			VRChestSlotNote("the " + sType + " not taken out: the right hand holds the " + sHeld);
+			return;
+		}
+		if(ItemType_GetFirstInInventory(sType) == "")
+		{
+			VRChestSlotNote("the chest slot's " + sType + " is no longer carried");
+			return;
+		}
+		if(apPlayer.GetCurrentStateId() != ePlayerState_Normal)
+		{
+			VRChestSlotNote("the " + sType + " not taken out: the player is busy (state " + apPlayer.GetCurrentStateId() + ")");
+			return;
+		}
+		Item_TriggerHotkey(1);
+		VRChestSlotNote("the " + sType + " taken out of the chest slot (the game's hotkey 1)");
+	}
+
+	void VRChestSlotPut()
+	{
+		mfVRHintCarriedAt = -100.0f;
+		tString sID = Item_GetHeld(eItemHandlerHand_Right);
+		tString sType = Item_GetHeldType(eItemHandlerHand_Right);
+		if(sID == "")
+		{
+			VRChestSlotNote("nothing in the right hand to store in the chest slot");
+			return;
+		}
+		if(VRChestSlotTakes(sID) == false)
+		{
+			VRChestSlotNote("the " + sType + " cannot go in the chest slot (the game's hotkeys take only items used on things or on yourself)");
+			return;
+		}
+		// (AssignToHotkey takes the item off the slot if it is the slot's already: only when it is not.)
+		tString sWas = Item_GetAssignedToHotkey(1);
+		if(sWas != sType) Item_AssignToHotkey(1, sID);
+		if(Item_GetAssignedToHotkey(1) != sType)
+		{
+			VRChestSlotNote("the game did not take the " + sType + " as its hotkey 1: it stays in the hand");
+			return;
+		}
+		if(Item_GetHeld(eItemHandlerHand_Right) != "") mfVRPutAwayWait = 2.0f; // (put away the game's way once out of its own state, as X does)
+		tString sBefore = "";
+		if(sWas != "" && sWas != sType) sBefore = " (it held the " + sWas + " before, still in the inventory)";
+		VRChestSlotNote("the " + sType + " stored in the chest slot" + sBefore);
+	}
+
+	// BunkerVR: may this item (by its ID) go into the chest's item slot? As the game's hotkeys take
+	// items (ItemHandler.hps AssignToHotkey: used on things or on the player, not the flashlight),
+	// and not the guns, which have the hip and the shoulder.
+	bool VRChestSlotTakes(const tString &in asItemID)
+	{
+		if(asItemID == "") return false;
+		iScrItemHandler_Interface@ pHandler = cast<iScrItemHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_Custom_ItemHandler));
+		if(pHandler is null) return false;
+		iScrItem@ pItem = pHandler.GetItemByID(asItemID);
+		if(pItem is null) return false;
+		tString sType = pItem.GetTypeID();
+		if(sType == "" || sType == "DynamoLantern" || sType == "Gun" || sType == "Shotgun") return false;
+		return pItem.GetType().CanUseOnWorld() || pItem.GetType().CanUseOnSelf();
+	}
+
+	// BunkerVR: a "BunkerVR chest slot:" line in hpl.log (the first 40).
+	void VRChestSlotNote(const tString &in asText)
+	{
+		if(mlVRSlotNotes >= 40) return;
+		mlVRSlotNotes++;
+		Log("BunkerVR chest slot: " + asText + "\n");
+	}
+
+	// BunkerVR: a "BunkerVR shoulder:" line in hpl.log (the first 30).
+	void VRShoulderNote(const tString &in asText)
+	{
+		if(mlVRShoulderNotes >= 30) return;
+		mlVRShoulderNotes++;
+		Log("BunkerVR shoulder: " + asText + "\n");
+	}
+
+	// BunkerVR: the revolver at the right hip. The mod sends command 78 for the hip with no gun
+	// out, or with the shotgun out: the revolver is taken out, if carried, what the right hand
+	// held put away by the game (the shotgun's aim or loading left first; an item in use keeps
+	// the revolver where it is). Not the gun button's tap: that draws the gun used last, which
+	// is the shotgun once it has been taken from behind the shoulder (VRShoulderShotgun). The
+	// revolver itself out, the hip still puts it away (command 2). Logged as "BunkerVR hip:"
+	// (the first 30). (abWaited: called again by VRDoBodySlotWait once the player is back in the
+	// normal state.)
+	void VRHipRevolver(cLuxPlayer@ apPlayer, bool abWaited = false)
+	{
+		tString sHeld = Item_GetHeldType(eItemHandlerHand_Right);
+		if(sHeld == "Gun")
+		{
+			VRHipNote("the revolver is out already (the hip puts it away: command 2)");
+			return;
+		}
+		if(ItemType_GetFirstInInventory("Gun") == "")
+		{
+			VRHipNote("a squeeze at the hip: no revolver carried");
+			return;
+		}
+		int lState = apPlayer.GetCurrentStateId();
+		if(lState == ePlayerState_Custom_UsingShotgun_Aim || lState == ePlayerState_Custom_UsingShotgun_Reload) apPlayer.ChangeState(ePlayerState_Normal);
+		if(apPlayer.GetCurrentStateId() != ePlayerState_Normal)
+		{
+			// (An item the mod keeps ready in the right hand, a bottle or the fuel can, has the player in that
+			// item's own state (a bottle: state 71); the mod lets go of its ready button with the squeeze, and the
+			// game is back in its normal state a moment later. So the revolver waits for that, up to a second:
+			// VRDoBodySlotWait.)
+			if(abWaited == false && sHeld != "" && apPlayer.GetCurrentStateId() == Item_GetUsingState(sHeld))
+			{
+				mfVRHipWait = gfVRBodySlotWait;
+				return;
+			}
+			VRHipNote("the revolver not taken out: the player is busy (state " + apPlayer.GetCurrentStateId() + ")");
+			return;
+		}
+		Item_SetLastWeaponUsed("Gun");
+		Item_ToggleHeldItem("Gun");
+		VRHipNote("the revolver taken out at the hip" + (sHeld != "" ? " (" + sHeld + " put away)" : ""));
+	}
+
+	// BunkerVR: a "BunkerVR hip:" line in hpl.log (the first 30).
+	void VRHipNote(const tString &in asText)
+	{
+		if(mlVRHipNotes >= 30) return;
+		mlVRHipNotes++;
+		Log("BunkerVR hip: " + asText + "\n");
+	}
+	
+	void VRDoGunCommands()
+	{
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		cCamera@ pCam = pPlayer !is null ? pPlayer.GetCamera() : null;
+		if(pCam is null) return;
+		
+		if(mlVRTraceLeft > 0) VRStandInTrace(pCam);
+		if(mlVRSurveyNext >= 0) VRStandInSurvey();
+		float fRealRoll = pCam.GetRoll();
+		pCam.SetRoll(7016.0f);
+		cVector3f vAnswer = pCam.GetMatrix().GetTranslation();
+		pCam.SetRoll(fRealRoll);
+		
+		if(vAnswer.x < 12344.0f || vAnswer.x > 12346.0f) return;
+		int lCommand = int(vAnswer.y + 0.5f);
+		if(lCommand >= 1000)
+		{
+			VRMark(lCommand - 1000); // (a mark: see there)
+			return;
+		}
+		if(lCommand == 61)
+		{
+			VRJumpMakeThings(); // (a jump from the mod's test list has arrived)
+			return;
+		}
+		if(lCommand == 62)
+		{
+			VRStandInReport(); // (testing with a stand-in headset)
+			return;
+		}
+		if(lCommand == 77)
+		{
+			// Testing with a stand-in headset: the held fuel can's lid off, as if the left hand had taken it
+			// (VRUpdateLid), to try the throw of fuel. (Don't reuse command 75 for this: it is the shotgun
+			// behind the shoulder's.)
+			mbVRLidOff = true;
+			Log("BunkerVR: TEST: the fuel can's lid is off (script 77)\n");
+			return;
+		}
+		if(lCommand == 76)
+		{
+			// Testing with a stand-in headset: the held flare lit, as if its cord had been pulled (VRUpdateFlare).
+			cScript_RunGlobalFunc("State_UsingFlare", "", "_Global_VRIgnite");
+			Log("BunkerVR: TEST: the flare is lit (script 76)\n");
+			return;
+		}
+		if(lCommand == 74)
+		{
+			// The player's height seems to have changed: the mod has seen the eyes stay well above or below the
+			// saved height (UpdateHeightWatch in vr.cpp; once a run). Not marked as given, so it can come again.
+			Hint_ShowHint("Hints", "HintVRHeightChanged", false, 1.5f, false);
+			return;
+		}
+		if(lCommand == 73)
+		{
+			VRStandInThingThere(); // (testing with a stand-in headset)
+			return;
+		}
+		if(lCommand == 72)
+		{
+			cLux_SetGodModeActivated(true); // (testing with a stand-in headset. Written to the settings as the game closes: the test run must put them back)
+			cVR_Say("god mode on");
+			return;
+		}
+		if(lCommand == 71)
+		{
+			VRStandInThings(); // (testing with a stand-in headset)
+			return;
+		}
+		if(lCommand == 70)
+		{
+			VRStandInTouch(); // (testing with a stand-in headset)
+			return;
+		}
+		if(lCommand == 68)
+		{
+			VRStandInUseItem(); // (testing with a stand-in headset)
+			return;
+		}
+		if(lCommand == 69)
+		{
+			VRStandInMapFunction(); // (the same)
+			return;
+		}
+		if(lCommand == 66 || lCommand == 67)
+		{
+			cScript_RunGlobalFunc("LuxPlayer", "", lCommand == 66 ? "_Global_EquipGasMask" : "_Global_UnequipGasMask"); // (testing with a stand-in headset)
+			return;
+		}
+		if(lCommand == 65)
+		{
+			VRStandInMoveTo(); // (testing with a stand-in headset)
+			return;
+		}
+		if(lCommand == 64)
+		{
+			mlVRSurveyNext = 0; // (testing: how high things stand, VRStandInSurvey)
+			return;
+		}
+		if(lCommand == 63)
+		{
+			mlVRTraceLeft = 1500; // (testing: a trace line each frame, some 17 seconds, VRStandInTrace)
+			return;
+		}
+		if((lCommand >= 4 && lCommand <= 19) || lCommand == 60)
+		{
+			VRDoItemCommand(lCommand);
+			return;
+		}
+		if(lCommand >= 20 && lCommand <= 59)
+		{
+			VRDoTestCommand(lCommand);
+			return;
+		}
+		if(lCommand == 75)
+		{
+			VRShoulderShotgun(pPlayer); // (the shotgun behind the right shoulder)
+			return;
+		}
+		if(lCommand == 78)
+		{
+			VRHipRevolver(pPlayer); // (the revolver at the right hip)
+			return;
+		}
+		if(lCommand == 79)
+		{
+			VRChestSlotTake(pPlayer); // (the right chest's item slot)
+			return;
+		}
+		if(lCommand == 80)
+		{
+			VRChestSlotPut(); // (the same)
+			return;
+		}
+		if(lCommand == 81)
+		{
+			// Testing with a stand-in headset: a line in hpl.log naming the replay starting now (run\survey.txt's
+			// first line), so that its own lines there can be told apart.
+			tString sReplay = cVR_SurveyName(0);
+			Log("BunkerVR: REPLAY: " + sReplay + "\n");
+			cVR_Say("replay: " + sReplay);
+			return;
+		}
+		if(lCommand == 82)
+		{
+			VRSightTest(); // (testing with a stand-in headset: the replay "sight")
+			return;
+		}
+		if(lCommand >= 83 && lCommand <= 88)
+		{
+			// The sight test map (mods\BunkerVR_SightTest; testing with a stand-in headset): 83 puts the player at its
+			// start, 84 to 87 behind its walls (0.9, 1.2, 1.5, 1.8 m), 88 asks it to report what the Beast sees now.
+			// (Its script takes them at its next look.)
+			if(lCommand == 88)	cScript_SetGlobalVarInt("BunkerVR_SightTestAsk", 1);
+			else				cScript_SetGlobalVarInt("BunkerVR_SightTestPlace", lCommand - 82);
+			return;
+		}
+		if(lCommand == 89)
+		{
+			VRStandInTap(); // (testing with a stand-in headset: the fuel tap's state)
+			return;
+		}
+		if(lCommand == 90)
+		{
+			VRStandInFinale(); // (testing with a stand-in headset: the exit's state)
+			return;
+		}
+		if(lCommand == 91)
+		{
+			VRStandInHeldFit(); // (testing with a stand-in headset: how the item in the right hand sits in it)
+			return;
+		}
+		if(lCommand == 93)
+		{
+			cVR_Say(VRTapMarkNote(0)); // (testing with a stand-in headset: the fuel tap's line of a mark, without a mark)
+			return;
+		}
+		if(lCommand == 92)
+		{
+			VRStandInTapPins(); // (testing with a stand-in headset: pins at the fuel tap's points for a picture)
+			return;
+		}
+		if(lCommand < 1 || lCommand > 3) return;
+		
+		tString sHeld = Item_GetHeldType(eItemHandlerHand_Right);
+		bool bGunHeld = sHeld == "Gun" || sHeld == "Shotgun";
+		int lState = pPlayer.GetCurrentStateId();
+		bool bAiming = lState == ePlayerState_Custom_UsingGun_Aim || lState == ePlayerState_Custom_UsingShotgun_Aim;
+		bool bReloading = lState == ePlayerState_Custom_UsingGun_Reload || lState == ePlayerState_Custom_UsingShotgun_Reload;
+		
+		/////////////////////////////
+		// Draw: the gun used last, or the first one carried (as the game's own key does)
+		if(lCommand == 1)
+		{
+			if(bGunHeld || lState != ePlayerState_Normal) return;
+			
+			tString sWeapon = Item_GetLastWeaponUsed();
+			if(sWeapon == "")
+			{
+				if(ItemType_GetFirstInInventory("Gun") != "")			sWeapon = "Gun";
+				else if(ItemType_GetFirstInInventory("Shotgun") != "")	sWeapon = "Shotgun";
+				if(sWeapon == "") return;
+				Item_SetLastWeaponUsed(sWeapon);
+			}
+			Item_ToggleHeldItem(sWeapon);
+		}
+		/////////////////////////////
+		// Put away
+		else if(lCommand == 2)
+		{
+			if(bGunHeld == false) return;
+			if(bAiming || bReloading) pPlayer.ChangeState(ePlayerState_Normal);
+			if(pPlayer.GetCurrentStateId() != ePlayerState_Normal) return;
+			Item_PutAway(eItemHandlerHand_Right);
+		}
+		/////////////////////////////
+		// Open (the game's "check ammo" state, in which bullets are loaded)
+		else
+		{
+			if(bGunHeld == false || Item_GetHeldState(eItemHandlerHand_Right) != 3) return;
+			if(bReloading) return;
+			if(bAiming == false && lState != ePlayerState_Normal) return;
+			pPlayer.ChangeState(sHeld == "Gun" ? ePlayerState_Custom_UsingGun_Reload : ePlayerState_Custom_UsingShotgun_Reload);
+		}
+	}
+	
+	//------------------------------------------------------------
+	
+	// BunkerVR: crouching by ducking. The VR mod watches how far the player's
+	// real head has come down from where it was when the view was centered, and
+	// reports here whether that counts as ducked (special roll value 7019; the
+	// answer is 12345, then 0 = switched off, 1 = head up, 2 = ducked, then the
+	// most the view may be raised again, see VRUpdateDuckLift). Going down crouches,
+	// coming back up stands, as long as the crouch was started this way: a
+	// crouch started with the stick is left alone. If there is no room to
+	// stand, standing is tried again on every update until there is.
+	// Playing standing (the mod's limit for raising the view is then 99, "no
+	// limit") the crouch is the player's own: the game counts the player as
+	// crouched (slower, quieter, its body smaller, so it fits under things),
+	// but the body is not put into the game's crouch and the view is not
+	// lowered, as the real head already is (mbVRRealCrouch, see SetCrouch).
+	void VRDoDuck()
+	{
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		cCamera@ pCam = pPlayer !is null ? pPlayer.GetCamera() : null;
+		if(pCam is null) return;
+
+		// (With the question the mod is told, in the camera's position, whether
+		// the game has the player crouched: it stands the player up on "stick up"
+		// then.)
+		float fRealRoll = pCam.GetRoll();
+		cVector3f vRealPos = pCam.GetPosition();
+		pCam.SetPosition(cVector3f(Player_GetCrouching() ? 1.0f : 0.0f, 0.0f, 0.0f));
+		pCam.SetRoll(7019.0f);
+		cVector3f vAnswer = pCam.GetMatrix().GetTranslation();
+		pCam.SetRoll(fRealRoll);
+		pCam.SetPosition(vRealPos);
+
+		// The answer: 12345, then 0 / 1 / 2 as above, then the most to raise the view.
+		bool bKnown = vAnswer.x > 12344.0f && vAnswer.x < 12346.0f && vAnswer.y > 0.5f && vAnswer.y < 2.5f &&
+					  vAnswer.z >= 0.0f && vAnswer.z < 100.0f;
+		bool bDucked = bKnown && vAnswer.y > 1.5f;
+		bool bCrouching = Player_GetCrouching();
+
+		// Only while walking about normally: not on ladders, and not during
+		// cutscenes and the like, when the game poses the body itself.
+		int lState = pPlayer.GetCurrentStateId();
+		// (The ladder is checked by name: its state keeps the normal move state, so a
+		// head lowered on a ladder, looking down it or reaching low, would crouch the
+		// climber, the body squashed on the rungs.)
+		bool bFree = mbCameraAnimation_Active == false && mbAttached == false &&
+					 pPlayer.GetCurrentMoveStateId() == eMoveState_Normal &&
+					 lState != ePlayerState_CutsceneAnimation && lState != ePlayerState_InteractiveCutsceneAnimation &&
+					 lState != ePlayerState_Dead && lState != ePlayerState_Ladder;
+
+		if(bKnown && bFree)
+		{
+			mfVRDuckMaxLift = cMath_Min(vAnswer.z, gvBodySize.y - gvBodyCrouchSize.y);
+
+			// Head went down: crouch (unless already crouching by the stick).
+			if(bDucked && mbVRDuckWas == false && bCrouching == false)
+			{
+				mbVRRealCrouch = vAnswer.z > 50.0f; // playing standing: the player's own crouch
+				Player_SetCrouching(true);
+				bCrouching = Player_GetCrouching();
+				mbVRDuckCrouched = bCrouching;
+			}
+			// Head is up again: stand, once there is room.
+			else if(bDucked == false && mbVRDuckCrouched && bCrouching && Player_GetCrawling() == false)
+			{
+				Player_SetCrouching(false);
+				bCrouching = Player_GetCrouching();
+			}
+		}
+
+		if(bCrouching == false)
+		{
+			mbVRDuckCrouched = false;
+			mbVRRealCrouch = false;
+		}
+		mbVRDuckWas = bDucked;
+	}
+
+	//------------------------------------------------------------
+
+	// BunkerVR: the view during a crouch that was started by ducking.
+	// The game lowers the view for a crouch by itself, and the player's real
+	// head has come down as well, so the view would drop twice. While such a
+	// crouch lasts, the view is raised again by as much as the game has lowered
+	// it, up to the limit the mod gave: playing seated that is only the depth
+	// of the duck, so the game's crouch still lowers the view; playing standing
+	// it is the whole of the game's crouch, so the view is at the real height.
+	// It follows the crouch's own movement, so nothing jumps. Returns how far
+	// to raise the view (game meters). afEyeHeight: the eyes above the feet now.
+	float VRUpdateDuckLift(float afEyeHeight, float afTimeStep)
+	{
+		iCharacterBody@ pCharBody = cLux_GetPlayer().GetCharacterBody();
+		bool bCrouching = Player_GetCrouching();
+
+		// Learn the standing eye height while plainly standing.
+		if(mbVRDuckLifting == false && bCrouching == false && Player_GetCrawling() == false &&
+			GetCrouchTransitionActive() == false && mbCameraAnimation_Active == false && mbAttached == false &&
+			pCharBody !is null && pCharBody.IsOnGround() && afEyeHeight > 1.0f && afEyeHeight < 2.5f)
+		{
+			if(mfVRStandEye < 0.0f)	mfVRStandEye = afEyeHeight;
+			else					mfVRStandEye += (afEyeHeight - mfVRStandEye) * cMath_Min(1.0f, afTimeStep * 3.0f);
+		}
+
+		if(mbVRDuckCrouched && mbVRRealCrouch == false && mfVRStandEye > 0.0f)
+		{
+			mbVRDuckLifting = true;
+			mfVRDuckIdle = 0.0f;
+		}
+
+		if(mbVRDuckLifting)
+		{
+			// How far the game has the eyes below standing height right now.
+			float fLowered = cMath_Max(0.0f, mfVRStandEye - afEyeHeight);
+			mfVRDuckLift = cMath_Min(fLowered, mfVRDuckMaxLift);
+
+			// Over once the body is back up (or, to be safe, after a while).
+			if(mbVRDuckCrouched == false)
+			{
+				mfVRDuckIdle += afTimeStep;
+				if(fLowered < 0.02f || mfVRDuckIdle > 2.0f) mbVRDuckLifting = false;
+			}
+			if(mbCameraAnimation_Active || mbAttached) mbVRDuckLifting = false;
+		}
+		else
+		{
+			mfVRDuckLift = cMath_IncreaseTo(mfVRDuckLift, afTimeStep * 0.6f, 0.0f);
+		}
+
+		return mfVRDuckLift;
+	}
+
+	//------------------------------------------------------------
+
+	// BunkerVR: where the game's camera goes, from where it hangs on the drawn head (avOnHead:
+	// its CameraSocket, with the game's own additions and the mod's: see where it is called).
+	// In VR its height is the head's, as animated (a crouch, a step's bob, as steadied), but
+	// across the floor it is where the game's body stands, as the room has it (the moves of the
+	// game's body after the real neck taken off: mvVRFollow, VRFollowHead), plus the game's own
+	// additions (avCamPosAdd). The point on the head is 15 cm in front of the spine and swings
+	// round as the upper body turns: following it, a turn with the stick would carry the eyes
+	// round in a circle up to half a meter across, and the view would go on moving for seconds
+	// after the stick was let go, as the feet caught up and the steadying followed, like a
+	// weight shift. Where the game's body is attached to something, the socket is used as is.
+	// What it leaves out across the floor is kept (mvVRCamLeftOut): the drawn body is still placed
+	// under the real head from where the camera would have been (UpdateOrientation), so that its
+	// head is where the real head is. (Placed from the camera as returned here, the body would be
+	// 15 cm too far forwards: the real eyes 26 cm behind its head in a knockdown.)
+	cVector3f VRCameraPlace(const cVector3f &in avOnHead, const cVector3f &in avCamPosAdd)
+	{
+		mvVRCamLeftOut = cVector3f(0.0f);
+		if(mbVRSeen == false || mbAttached) return avOnHead;
+		cVector3f vPlace = cVector3f(mvPrevSmoothPos.x - mvVRFollow.x + avCamPosAdd.x, avOnHead.y, mvPrevSmoothPos.z - mvVRFollow.z + avCamPosAdd.z);
+		mvVRCamLeftOut = cVector3f(avOnHead.x - vPlace.x, 0.0f, avOnHead.z - vPlace.z);
+		return vPlace;
+	}
+
+	//------------------------------------------------------------
+
+	// BunkerVR: the drawn body's own sway taken out of the view. The view
+	// hangs on the body's eyes (its CameraSocket), and the body's walking and
+	// standing animations move them: a bob at each step, a slow sway when
+	// standing. In VR the real head moves the view already, so that would be
+	// the world swaying. Where the animation holds the eyes is taken in the body's
+	// own space (moving, turning or resizing the body, as the mod does, is in
+	// the body's matrix, not there), followed slowly there, and the view moved
+	// by the difference: standing, over 3 s (the standing sway all but gone);
+	// walking, over 0.3 s for "Reduced" (the steps' bob, about two a second,
+	// cut to about a quarter) or 1.5 s for "None". The further the eyes are
+	// from where they are followed, the faster (twice 5 cm off, five times
+	// 10 cm off), so a new pose (stopping, turning the upper body) is taken up
+	// smoothly. A crouch is followed at once. Menu: "Body sway in the view"
+	// (VR option 37: 0 reduced, 1 none, 2 as the game: nothing done). Returns
+	// the move to add to the view (world meters; also kept in mvVRSteadyLast
+	// for the inventory's view, OnDraw).
+	// (Walking is the stick's own move speed, eased in over 0.2 s and out over
+	// 0.8 s, and the follow has no hard edge. Don't take "walking" from the
+	// body having moved at the last update: the mod's own small steps of the
+	// body under the real head do that too, and the follow would flicker
+	// between walking and standing after a stop, jittering the view.)
+	cVector3f VRSteadyEyes(iLuxEntity@ apBody, cNode3D@ apEyes, iCharacterBody@ apCharBody, float afTimeStep)
+	{
+		// The menu's choice, asked once a second.
+		mfVRSwayAsk -= afTimeStep;
+		if(mfVRSwayAsk <= 0.0f)
+		{
+			mfVRSwayAsk = 1.0f;
+			int lChoice = VRModOption(37);
+			mlVRSway = (lChoice >= 0 && lChoice <= 2) ? lChoice : 0;
+		}
+
+		cMatrixf mtxBody = apBody.GetMatrix();
+		cVector3f vEyesWorld = apEyes.GetWorldPosition();
+		cVector3f vEyes = cMath_MatrixMul(cMath_MatrixInverse(mtxBody), vEyesWorld);
+		cVector3f vSteadyWas = mvVRSteadyLast;
+		if(mlVRSway == 2 || mbVRSwayKnown == false)
+		{
+			mvVRSwayEyes = vEyes;
+			mbVRSwayKnown = true;
+			mfVRSwayWalk = 0.0f;
+			mfVRSwayCrouch = 0.0f;
+		}
+		else if(afTimeStep > 0.0f)
+		{
+			// Walking: the stick's own move speed (not the mod's steps of the
+			// body under the head), eased.
+			float fMove = cMath_Abs(apCharBody.GetMoveSpeed(eCharDir_Forward)) + cMath_Abs(apCharBody.GetMoveSpeed(eCharDir_Right));
+			float fWalkGoal = fMove > 0.2f ? 1.0f : 0.0f;
+			mfVRSwayWalk = cMath_IncreaseTo(mfVRSwayWalk, afTimeStep * (fWalkGoal > mfVRSwayWalk ? 5.0f : 1.25f), fWalkGoal);
+			float fCrouchGoal = GetCrouchTransitionActive() ? 1.0f : 0.0f;
+			mfVRSwayCrouch = cMath_IncreaseTo(mfVRSwayCrouch, afTimeStep * 10.0f, fCrouchGoal);
+
+			// How fast the eyes are followed (per second): standing a third,
+			// walking as the menu says, eased between; faster the further off,
+			// smoothly; a crouch at once.
+			float fRate = 1.0f / 3.0f + ((mlVRSway == 1 ? 1.0f / 1.5f : 1.0f / 0.3f) - 1.0f / 3.0f) * mfVRSwayWalk;
+			cVector3f vOff = vEyes - mvVRSwayEyes;
+			float fOff = vOff.Length() / 0.05f;
+			fRate *= 1.0f + fOff * fOff;
+			fRate += (20.0f - fRate) * mfVRSwayCrouch;
+			mvVRSwayEyes += vOff * cMath_Min(1.0f, afTimeStep * fRate);
+			VRSwayNote(vEyes, mfVRSwayWalk > 0.5f, afTimeStep);
+
+			// For the log: the first three stops (1 s of walking or more, then
+			// the stick let go), each frame for 0.8 s.
+			if(fWalkGoal > 0.5f) mfVRSwayWalkedFor += afTimeStep;
+			else
+			{
+				if(mfVRSwayWalkedFor >= 1.0f && mlVRSwayStops < 3)
+				{
+					mlVRSwayStops++;
+					mfVRSwayStopLog = 0.8f;
+				}
+				mfVRSwayWalkedFor = 0.0f;
+			}
+		}
+		mvVRSteadyLast = cMath_MatrixMul3x3(mtxBody, mvVRSwayEyes - vEyes);
+
+		if(mfVRSwayStopLog > 0.0f && afTimeStep > 0.0f)
+		{
+			mfVRSwayStopLog -= afTimeStep;
+			cVector3f vEyesMove = (vEyesWorld - mvVRSwayEyesWorldWas) * 1000.0f;
+			cVector3f vSteadyMove = (mvVRSteadyLast - vSteadyWas) * 1000.0f;
+			cVector3f vViewMove = vEyesMove + vSteadyMove;
+			Log("BunkerVR: sway at stop " + mlVRSwayStops + ": " + int(afTimeStep * 1000.0f + 0.5f) + " ms, walking " + int(mfVRSwayWalk * 100.0f + 0.5f) +
+				"%, eyes " + int((vEyes - mvVRSwayEyes).Length() * 1000.0f + 0.5f) + " mm off; the view moved " + int(vViewMove.x) + " " + int(vViewMove.y) + " " + int(vViewMove.z) +
+				" mm (the body's eyes " + int(vEyesMove.x) + " " + int(vEyesMove.y) + " " + int(vEyesMove.z) + ", the steadying " + int(vSteadyMove.x) + " " + int(vSteadyMove.y) + " " + int(vSteadyMove.z) + ")\n");
+		}
+		mvVRSwayEyesWorldWas = vEyesWorld;
+		return mvVRSteadyLast;
+	}
+
+	// BunkerVR: for hpl.log (VRSteadyEyes): every 10 s, how far the body's
+	// animation moved its eyes and how far the view let them move
+	// (millimeters at the body's own size, in its own directions: across,
+	// up and down, back and forth), and how much of the time was walking. At
+	// most 30 lines.
+	void VRSwayNote(const cVector3f &in avEyes, bool abWalking, float afTimeStep)
+	{
+		if(mlVRSwayLogs >= 30) return;
+		if(mfVRSwayLogTime <= 0.0f)
+		{
+			mvVRSwayRawLow = avEyes;
+			mvVRSwayRawHigh = avEyes;
+			mvVRSwayViewLow = mvVRSwayEyes;
+			mvVRSwayViewHigh = mvVRSwayEyes;
+			mfVRSwayWalkTime = 0.0f;
+		}
+		mvVRSwayRawLow = cVector3f(cMath_Min(mvVRSwayRawLow.x, avEyes.x), cMath_Min(mvVRSwayRawLow.y, avEyes.y), cMath_Min(mvVRSwayRawLow.z, avEyes.z));
+		mvVRSwayRawHigh = cVector3f(cMath_Max(mvVRSwayRawHigh.x, avEyes.x), cMath_Max(mvVRSwayRawHigh.y, avEyes.y), cMath_Max(mvVRSwayRawHigh.z, avEyes.z));
+		mvVRSwayViewLow = cVector3f(cMath_Min(mvVRSwayViewLow.x, mvVRSwayEyes.x), cMath_Min(mvVRSwayViewLow.y, mvVRSwayEyes.y), cMath_Min(mvVRSwayViewLow.z, mvVRSwayEyes.z));
+		mvVRSwayViewHigh = cVector3f(cMath_Max(mvVRSwayViewHigh.x, mvVRSwayEyes.x), cMath_Max(mvVRSwayViewHigh.y, mvVRSwayEyes.y), cMath_Max(mvVRSwayViewHigh.z, mvVRSwayEyes.z));
+		mfVRSwayLogTime += afTimeStep;
+		if(abWalking) mfVRSwayWalkTime += afTimeStep;
+		if(mfVRSwayLogTime < 10.0f) return;
+
+		cVector3f vRaw = (mvVRSwayRawHigh - mvVRSwayRawLow) * 1000.0f;
+		cVector3f vView = (mvVRSwayViewHigh - mvVRSwayViewLow) * 1000.0f;
+		Log("BunkerVR: body sway, the last 10 s (walking " + int(100.0f * mfVRSwayWalkTime / mfVRSwayLogTime + 0.5f) + "% of it; menu choice " + mlVRSway +
+			"): the animation moved the eyes " + int(vRaw.x + 0.5f) + " mm across, " + int(vRaw.y + 0.5f) + " up and down, " + int(vRaw.z + 0.5f) +
+			" back and forth; the view let them move " + int(vView.x + 0.5f) + ", " + int(vView.y + 0.5f) + ", " + int(vView.z + 0.5f) + " mm\n");
+		mlVRSwayLogs++;
+		mfVRSwayLogTime = 0.0f;
+	}
+
+	//------------------------------------------------------------
+
+	// BunkerVR: snap turning. When the right stick is flicked with snap turning
+	// chosen in the mod's menu, the mod hands over the angle here (special roll
+	// value 7015, second number; radians, positive = to the left) and the
+	// character is turned by it in one go.
+	// (While a hand holds something with the game's grab, a smooth turn with
+	// the stick also comes here, in small steps. The mod adds them up on its
+	// own clock, about 180 times a second, and they are taken here once an
+	// update, so an update's step varies: 0.02 to 0.08 rad (see below). A
+	// held thing is moved by the speed set at the last update, which goes
+	// round with the player at the last step's pace, so turned as they come
+	// it is off by the difference, up to 2-3 cm for a thing held out, and
+	// the hand on it jitters with it. So small steps are queued and turned
+	// evenly, at their speed smoothed over a few updates, keeping about two
+	// updates' turn in hand (11 ms behind), which leaves a quarter of that
+	// error; a snap turn's step is turned at once, with whatever is queued.
+	// See gfVRTurnSmoothShare.)
+	void VRDoSnapTurn(float afTimeStep)
+	{
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		cCamera@ pCam = pPlayer !is null ? pPlayer.GetCamera() : null;
+		if(pCam is null) return;
+		
+		float fRealRoll = pCam.GetRoll();
+		pCam.SetRoll(7015.0f);
+		cVector3f vAnswer = pCam.GetMatrix().GetTranslation();
+		pCam.SetRoll(fRealRoll);
+		
+		float fAngle = 0.0f;
+		if(vAnswer.x > 12344.0f && vAnswer.x < 12346.0f && cMath_Abs(vAnswer.y) >= 0.001f && cMath_Abs(vAnswer.y) <= 3.2f) fAngle = vAnswer.y;
+		// (A snap turn's step is marked by the mod, in its third number. Don't tell one by its size
+		// alone: a smooth turn's step can pass a fixed limit whenever a frame comes late, and the
+		// whole queue would then be turned at once. Still a jump: a step no smooth turn makes,
+		// gfVRSmoothTurnMost.)
+		// (Nothing is turned while a knockdown, a kill or a death plays: with a hand squeezed, a stick
+		// turn comes here, and it would turn the character, and the kill's animation with it, away from
+		// the Beast. The mod sends none meanwhile either: cVR_NoTurning, VRSendGunNews.)
+		if(mlVRRoughKind != 0)
+		{
+			fAngle = 0.0f;
+			mfVRTurnQueue = 0.0f;
+			mfVRTurnSpeed = 0.0f;
+		}
+		bool bVRJump = cMath_Abs(fAngle) > 0.0001f && ((vAnswer.z > 0.5f && vAnswer.z < 1.5f) || cMath_Abs(fAngle) > gfVRSmoothTurnMost);
+		
+		float fIncoming = fAngle;
+		if(bVRJump)
+		{
+			// A snap turn: at once, with what is queued.
+			fAngle += mfVRTurnQueue;
+			mfVRTurnQueue = 0.0f;
+			mfVRTurnSpeed = 0.0f;
+		}
+		else if(gbBunkerVR_EvenTurn == false)
+		{
+			// ("Smooth turn evened when holding" off on the Feel page: each
+			// step as it comes.)
+			fAngle += mfVRTurnQueue;
+			mfVRTurnQueue = 0.0f;
+			mfVRTurnSpeed = 0.0f;
+		}
+		else
+		{
+			// A smooth turn's small step (or none): queued, and turned evenly.
+			mfVRTurnQueue += fAngle;
+			if(afTimeStep > 0.0001f) mfVRTurnSpeed += (fAngle / afTimeStep - mfVRTurnSpeed) * gfVRTurnSmoothShare;
+			fAngle = mfVRTurnSpeed * afTimeStep + (mfVRTurnQueue - mfVRTurnSpeed * afTimeStep * 2.0f) * 0.15f;
+			if(mfVRTurnQueue * fAngle <= 0.0f) fAngle = 0.0f; // (never the other way)
+			if(cMath_Abs(fAngle) > cMath_Abs(mfVRTurnQueue) || cMath_Abs(mfVRTurnQueue) < 0.0005f) fAngle = mfVRTurnQueue;
+			mfVRTurnQueue -= fAngle;
+		}
+		// Kept for a mark (see VRMark): the game's time, the update,
+		// the step handed over, the step turned, what is left queued.
+		int lAt = mVRTurnRing.Add(5);
+		mVRTurnRing.mvData[lAt] = float(cEngine_GetGameTime());
+		mVRTurnRing.mvData[lAt + 1] = afTimeStep;
+		mVRTurnRing.mvData[lAt + 2] = fIncoming;
+		mVRTurnRing.mvData[lAt + 3] = fAngle;
+		mVRTurnRing.mvData[lAt + 4] = mfVRTurnQueue;
+		if(cMath_Abs(fAngle) < 0.00001f) return;
+		
+		iCharacterBody@ pCharBody = pPlayer.GetCharacterBody();
+		if(pCharBody is null) return;
+		
+		// The turn is given as cMath_MatrixRotateY turns (positive: to the
+		// left), and the game's own count of its turn is known against that
+		// (mfVRYawSense, checked at each step of the walking turn).
+		// (Don't check the turn with GetForward right after SetYaw: the engine's
+		// SetYaw only stores the yaw, and GetForward gives the forward worked
+		// out at the body's last update.)
+		
+		// Turn.
+		// (When, for the hands' holds: the hands jump round with the view, and
+		// a held thing is not to be given that jump as a speed; see
+		// BunkerVR_HoldFeed. Only a snap turn's step (bVRJump): while a hand
+		// holds something, a smooth turn with the stick is made here too,
+		// in small steps on every update, about 0.02 to 0.08 radians each, and
+		// a held thing is to go round with the hand then, as it does when
+		// walking. Taken for jumps, those steps would stop the feed while
+		// turning, leaving the thing an update's turn off the hand.)
+		if(bVRJump) cScript_SetGlobalVarFloat("BunkerVR_ViewJumpTime", float(cEngine_GetGameTime()));
+		pCharBody.SetYaw(pCharBody.GetYaw() + fAngle * mfVRYawSense);
+	}
+	
+	//------------------------------------------------------------
+	
+	// BunkerVR: the character turns with the player while walking. The game's
+	// character turns only with the right stick, while the walking stick goes
+	// the way the head faces (the mod turns its push by the head's turn), so a
+	// player who has turned for real would walk, to the game, sideways:
+	// sideways legs, the slower sideways run, and a path bent towards its
+	// forwards. While the stick walks, the character, and the game's camera
+	// with it, is turned towards the way the head faces, at most
+	// gfVRWalkTurnSpeed, and the drawn body's own turn after the head
+	// (mfVRBodyTurn) goes back to nothing as fast, so that the hips face the
+	// way walked. The mod is told each step just before the camera turns
+	// (special roll value 7095) and turns its "straight ahead" with it
+	// (VrAbsorbTurn in vr.cpp): the view, the hands and what they hold stay as
+	// they are. Standing still, nothing turns.
+	// (The way to turn is worked out from the turn's own count (mfVRYawSense:
+	// +1 as the game's own code counts it, -cMath_ATan2(x, -z) above and the
+	// body drawn turned by cMath_Pi+mfYaw), and each step is checked against
+	// the game's camera as built afresh (special roll value 7007): gone the
+	// wrong way, it is taken back and the count turned round. Don't read the
+	// character's own facing back instead: it doesn't follow a turn just
+	// made, so the character would step one way and back, update after
+	// update. The character follows smoothly, a share of the way each update.
+	// Which way the head faces comes from VRHeadFacing, which also works when
+	// looking almost straight down.)
+	void VRDoWalkTurn(float afTimeStep)
+	{
+		if(afTimeStep < 0.0001f) return;
+		if(mbAttached || mbCameraAnimation_Active) return;
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		cCamera@ pCam = pPlayer !is null ? pPlayer.GetCamera() : null;
+		iCharacterBody@ pCharBody = pPlayer !is null ? pPlayer.GetCharacterBody() : null;
+		if(pCam is null || pCharBody is null) return;
+		if(VRFollowStateOk(pPlayer.GetCurrentStateId()) == false) return;
+		
+		// Walking with the stick? (7094: 12345, 1 walking or 0.) And the
+		// head, as the camera with the head in it (7005), and the game's own
+		// camera, level (7007).
+		float fRealRoll = pCam.GetRoll();
+		pCam.SetRoll(7094.0f);
+		cVector3f vWalking = pCam.GetMatrix().GetTranslation();
+		pCam.SetRoll(7005.0f);
+		cMatrixf mtxHead = pCam.GetMatrix();
+		pCam.SetRoll(7007.0f);
+		cMatrixf mtxGameCam = pCam.GetMatrix();
+		pCam.SetRoll(fRealRoll);
+		if(vWalking.x < 12344.0f || vWalking.x > 12346.0f || vWalking.y < 0.5f) return;
+		
+		// The drawn body's own turn after the head goes back to nothing (it
+		// turns about the eyes: see UpdateBones).
+		float fStraighten = gfVRWalkTurnSpeed * afTimeStep;
+		if(mfVRBodyTurn > fStraighten)			mfVRBodyTurn -= fStraighten;
+		else if(mfVRBodyTurn < -fStraighten)	mfVRBodyTurn += fStraighten;
+		else									mfVRBodyTurn = 0.0f;
+		
+		// How far the camera (and the character, which it faces as) faces
+		// from the head: the turn about the up axis that takes the one onto
+		// the other.
+		cVector3f vHead = VRHeadFacing(mtxHead);
+		cVector3f vCam = VRLevelForward(mtxGameCam);
+		if(vHead.Length() < 0.5f || vCam.Length() < 0.5f) return;
+		float fOff = VRTurnBetween(vCam, vHead);
+		
+		// A share of it each update (smoothly, never past it), at most
+		// gfVRWalkTurnSpeed; not a step too small to matter.
+		float fStep = fOff * cMath_Min(1.0f, afTimeStep * gfVRWalkTurnFollow);
+		float fMost = gfVRWalkTurnSpeed * afTimeStep;
+		if(fStep > fMost) fStep = fMost;
+		if(fStep < -fMost) fStep = -fMost;
+		if(cMath_Abs(fStep) < 0.0005f) return;
+		float fYawStep = fStep * mfVRYawSense;
+		VRWalkTurnBy(pCam, pCharBody, fYawStep, fRealRoll);
+		
+		// Did it go the way it should? The game's camera as built afresh
+		// (7007) against how it faced before. If not, taken back, and the
+		// game's turn counted the other way round from now on.
+		if(cMath_Abs(fStep) < 0.002f) return;
+		pCam.SetRoll(7007.0f);
+		cVector3f vCamNow = VRLevelForward(pCam.GetMatrix());
+		pCam.SetRoll(fRealRoll);
+		if(vCamNow.Length() < 0.5f) return;
+		if(VRTurnBetween(vCam, vCamNow) * fStep < 0.0f)
+		{
+			VRWalkTurnBy(pCam, pCharBody, -fYawStep, fRealRoll);
+			mfVRYawSense = -mfVRYawSense;
+			Log("BunkerVR: the character's turn while walking went the wrong way round: taken back; the game's turn is counted the other way from now on\n");
+		}
+	}
+	
+	// BunkerVR: the character, and the game's camera with it, turned by
+	// afYaw (radians, as the game counts its turn), the mod told first
+	// (special roll value 7095: it keeps the view as it is, see VrAbsorbTurn
+	// in vr.cpp). Nothing that rebuilds the view may come in between the
+	// telling and the camera's turn.
+	void VRWalkTurnBy(cCamera@ apCam, iCharacterBody@ apCharBody, float afYaw, float afRealRoll)
+	{
+		apCharBody.SetYaw(apCharBody.GetYaw() + afYaw);
+		cVector3f vRealPos = apCam.GetPosition();
+		apCam.SetPosition(cVector3f(afYaw, 0.0f, 0.0f));
+		apCam.SetRoll(7095.0f);
+		apCam.GetMatrix();
+		apCam.SetRoll(afRealRoll);
+		apCam.SetPosition(vRealPos);
+		apCam.SetYaw(apCam.GetYaw() + afYaw);
+	}
+	
+	// BunkerVR: which way the head faces, level: its forwards laid flat, with
+	// its top's share added as far as it is tipped (looking down, the top of
+	// the head points the way the face is turned; looking up, the other way),
+	// so that it is known however far the head is tipped, and a head tilted
+	// to one side while looking level counts not at all. Zero if not known.
+	// (The forwards alone, laid flat, is too short to tell when looking far
+	// down.) The mod turns the walking stick's push by the same
+	// (UpdateMoveInput in vr.cpp).
+	cVector3f VRHeadFacing(const cMatrixf &in a_mtxHead)
+	{
+		cVector3f vFwd = cMath_MatrixMul3x3(a_mtxHead, cVector3f(0.0f, 0.0f, -1.0f));
+		cVector3f vUp = cMath_MatrixMul3x3(a_mtxHead, cVector3f(0.0f, 1.0f, 0.0f));
+		cVector3f vFacing = cVector3f(vFwd.x - vFwd.y * vUp.x, 0.0f, vFwd.z - vFwd.y * vUp.z);
+		if(vFacing.Length() < 0.3f) return cVector3f(0.0f);
+		vFacing.Normalize();
+		return vFacing;
+	}
+	
+	// BunkerVR: a matrix's forwards (-z), laid flat and made a unit long, or
+	// zero.
+	cVector3f VRLevelForward(const cMatrixf &in a_mtx)
+	{
+		cVector3f vFwd = cMath_MatrixMul3x3(a_mtx, cVector3f(0.0f, 0.0f, -1.0f));
+		vFwd.y = 0.0f;
+		if(vFwd.Length() < 0.01f) return cVector3f(0.0f);
+		vFwd.Normalize();
+		return vFwd;
+	}
+	
+	// BunkerVR: the turn about the up axis, as cMath_MatrixRotateY turns,
+	// that takes one level direction onto another (as the body's turn after
+	// the head is worked out in UpdateBones: both ways round are tried, as
+	// math libraries differ in which way a positive angle turns).
+	float VRTurnBetween(const cVector3f &in avFrom, const cVector3f &in avTo)
+	{
+		cVector3f vCross = cMath_Vector3Cross(avFrom, avTo);
+		float fTurn = cMath_ATan2(vCross.y, cMath_Vector3Dot(avFrom, avTo));
+		float fOneWay = cMath_Vector3Dot(cMath_MatrixMul3x3(cMath_MatrixRotateY(fTurn), avFrom), avTo);
+		float fOtherWay = cMath_Vector3Dot(cMath_MatrixMul3x3(cMath_MatrixRotateY(-fTurn), avFrom), avTo);
+		if(fOtherWay > fOneWay) fTurn = -fTurn;
+		return fTurn;
+	}
+	
+	//------------------------------------------------------------
+	
+	// BunkerVR: pulling things to the hand, mainly for playing seated, when
+	// items are out of reach: point the hand at an item, hold the grip, flick
+	// the wrist back, and it flies into the hand, as in Half-Life: Alyx (the
+	// mod's menu, "Pull things to the hand": Off / Seated only / Always).
+	// An empty hand pointing at an item (a pickup) out of its reach
+	// and in sight finds it (VRFindPullTarget), and it glows
+	// (VRGlowPullTargets). The mod is told which hands have one (special roll
+	// value 7096) and reports how each hand stands (7097; UpdatePull in vr.cpp):
+	// aimed (the grip pressed on it: that item is kept, wherever the hand
+	// points meanwhile) and pulled (the flick). Pulled, the item flies to the
+	// hand, steered onto it as it moves (VRUpdatePullFlight), and is picked up
+	// the game's way as it comes (its OnInteract: the same rules, its sound).
+	// Things that are not items (a loose bottle on a table) are not pulled.
+	void VRDoPull(float afTimeStep)
+	{
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		cCamera@ pCam = pPlayer !is null ? pPlayer.GetCamera() : null;
+		if(pCam is null) return;
+		
+		// How each hand stands (7097: 12345, left, right), and the palms (7011, 7012).
+		float fRealRoll = pCam.GetRoll();
+		pCam.SetRoll(7097.0f);
+		cVector3f vStates = pCam.GetMatrix().GetTranslation();
+		pCam.SetRoll(7011.0f);
+		cMatrixf mtxLeft = pCam.GetMatrix();
+		pCam.SetRoll(7012.0f);
+		cMatrixf mtxRight = pCam.GetMatrix();
+		pCam.SetRoll(fRealRoll);
+		int lLeft = -1, lRight = -1;
+		if(vStates.x > 12344.0f && vStates.x < 12346.0f)
+		{
+			lLeft = VRRoundToInt(vStates.y);
+			lRight = VRRoundToInt(vStates.z);
+		}
+		if(mbAttached || mbCameraAnimation_Active)
+		{
+			lLeft = -1;
+			lRight = -1;
+		}
+		
+		VRUpdatePullHand(0, mVRPullLeft, lLeft, mtxLeft, afTimeStep);
+		VRUpdatePullHand(1, mVRPullRight, lRight, mtxRight, afTimeStep);
+		
+		// Which hands have a thing to pull, for the mod (7096).
+		cVector3f vRealPos = pCam.GetPosition();
+		pCam.SetPosition(cVector3f(mVRPullLeft.m_idTarget != tID_Invalid ? 1.0f : 0.0f, mVRPullRight.m_idTarget != tID_Invalid ? 1.0f : 0.0f, 0.0f));
+		pCam.SetRoll(7096.0f);
+		pCam.GetMatrix();
+		pCam.SetRoll(fRealRoll);
+		pCam.SetPosition(vRealPos);
+	}
+	
+	// BunkerVR: a number the mod sent, to the nearest whole one (int() alone
+	// takes -0.9 to 0).
+	int VRRoundToInt(float afX)
+	{
+		return afX < 0.0f ? -int(-afX + 0.5f) : int(afX + 0.5f);
+	}
+	
+	// BunkerVR: one hand's pulling (see VRDoPull). alState: how the hand
+	// stands, as the mod reports it (VrPullState in vr.h: below 0 off
+	// or not known, 0 nothing, 1 aimed, 2 pulled).
+	void VRUpdatePullHand(int alHand, cVRPull@ apPull, int alState, const cMatrixf &in a_mtxPalm, float afTimeStep)
+	{
+		// A thing on its way to this hand.
+		if(apPull.m_idFlying != tID_Invalid) VRUpdatePullFlight(alHand, apPull, alState > -2, a_mtxPalm, afTimeStep);
+		
+		if(alState < 0 || VRHandEmptyForPull(alHand) == false)
+		{
+			apPull.m_idTarget = tID_Invalid;
+			apPull.mlLastState = alState;
+			return;
+		}
+		if(alState == 2)
+		{
+			// Pulled (the moment it is first told; not a thing already on its
+			// way to the other hand).
+			bool bFlyingAlready = apPull.m_idTarget == mVRPullLeft.m_idFlying || apPull.m_idTarget == mVRPullRight.m_idFlying;
+			if(apPull.mlLastState != 2 && apPull.m_idTarget != tID_Invalid && apPull.m_idFlying == tID_Invalid && bFlyingAlready == false)
+				VRLaunchPull(alHand, apPull, a_mtxPalm);
+			apPull.m_idTarget = tID_Invalid;
+		}
+		else if(alState == 1)
+		{
+			// Aimed: the same thing kept, while it is there.
+			if(apPull.m_idTarget != tID_Invalid && cLux_ID_Entity(apPull.m_idTarget) is null) apPull.m_idTarget = tID_Invalid;
+		}
+		else
+		{
+			// Looked for ten times a second.
+			apPull.mfLookWait -= afTimeStep;
+			if(apPull.mfLookWait <= 0.0f)
+			{
+				apPull.mfLookWait = 0.1f;
+				VRTimeMark(7158); // (timing by part: pulls, looking for a thing, to 7159)
+				apPull.m_idTarget = VRFindPullTarget(a_mtxPalm, apPull.m_idTarget);
+				VRTimeMark(7159);
+			}
+		}
+		apPull.mlLastState = alState;
+	}
+	
+	// BunkerVR: is this hand empty, to pull something to it? No
+	// item in it, nothing held by its own hold, not the game's grab's hand.
+	bool VRHandEmptyForPull(int alHand)
+	{
+		if(Item_GetHeld(alHand == 0 ? eItemHandlerHand_Left : eItemHandlerHand_Right) != "") return false;
+		if((alHand == 0 ? mVRHoldLeft.m_idBody : mVRHoldRight.m_idBody) != tID_Invalid) return false;
+		if(VRGrabBodyNow() != tID_Invalid && cScript_GetGlobalVarInt("BunkerVR_GrabHand") == alHand) return false;
+		return true;
+	}
+	
+	// BunkerVR: the center of what is drawn of a thing.
+	cVector3f VRPullCentre(iLuxEntity@ apItem)
+	{
+		cMeshEntity@ pMesh = apItem.GetMeshEntity();
+		cBoundingVolume@ pBounds = pMesh !is null ? pMesh.GetBoundingVolume() : null;
+		return pBounds !is null ? pBounds.GetWorldCenter() : apItem.GetPosition();
+	}
+	
+	// BunkerVR: the item the palm points at and may pull: a pickup within
+	// gfVRPullCone of the palm's direction, between gfVRPullNearest and the
+	// menu's reach (gfVRPullFarthest if the mod doesn't answer), that can be
+	// picked up now and fits in the inventory. Of those, the one nearest the
+	// line with nothing in the way; tID_Invalid if none. The nearest few are
+	// tested in turn, so one behind a wall doesn't hide a visible one beside
+	// it. a_idNow, the one glowing now, is kept while it is nearly as near, so
+	// the glow doesn't hop between two things side by side.
+	tID VRFindPullTarget(const cMatrixf &in a_mtxPalm, tID a_idNow)
+	{
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		if(pMap is null) return tID_Invalid;
+		cVector3f vFrom = a_mtxPalm.GetTranslation();
+		cVector3f vDir = cMath_MatrixMul3x3(a_mtxPalm, cVector3f(0.0f, 0.0f, -1.0f));
+		if(vDir.Length() < 0.5f) return tID_Invalid;
+		vDir.Normalize();
+		
+		// The reach: the menu's "Pull reach" (VR option 36, in centimeters,
+		// 1.5 m by default), or gfVRPullFarthest if the mod doesn't answer.
+		int lReach = VRModOption(36);
+		float fFarthest = lReach >= 50 ? float(lReach) * 0.01f : gfVRPullFarthest;
+		
+		// The map's pickups are listed once a second, as VRNearPickupByLook in Prop_PlayerBody.hps does, not on
+		// every search: this runs ten times a second for each hand, and each listing walks the whole map. The
+		// list is rebuilt after a map change (OnMapEnter); an item dropped since is found within the second.
+		float fNow = float(cEngine_GetGameTime());
+		if(fNow - mfVRPullListTime > 1.0f || fNow < mfVRPullListTime)
+		{
+			mfVRPullListTime = fNow;
+			mvVRPullList.resize(0);
+			pMap.GetEntityArrayID("*", eLuxEntityType_Prop, "cScrPropPickup", mvVRPullList);
+		}
+		array<iLuxEntity@> vFound;
+		array<float> vAngle;
+		for(uint i = 0; i < mvVRPullList.length(); ++i)
+		{
+			iLuxEntity@ pItem = cLux_ID_Entity(mvVRPullList[i]);
+			if(pItem is null || pItem.IsActive() == false) continue;
+			if(pItem.GetInteractionDisabled()) continue; // (not one the game doesn't let the player take yet, such as the soldier's gun before he holds it out)
+			cVector3f vTo = VRPullCentre(pItem) - vFrom;
+			float fDist = vTo.Length();
+			if(fDist < gfVRPullNearest || fDist > fFarthest) continue;
+			float fCos = cMath_Vector3Dot(vTo, vDir) / fDist;
+			if(fCos <= gfVRPullCone) continue;
+			// (It answers in its first argument.)
+			cScript_SetGlobalArgBool(0, false);
+			cScript_RunGlobalFunc(pItem.GetName(), "cScrPropPickup", "_Global_GetCanBePickedUp");
+			if(cScript_GetGlobalArgBool(0) == false) continue;
+			tString sType = Item_GetEntityItemType(pItem.GetName());
+			if(sType == "" || ItemType_WillFit(sType, true) == false) continue;
+			float fAngle = cMath_ACos(cMath_Min(fCos, 1.0f));
+			if(pItem.GetID() == a_idNow) fAngle = cMath_Max(fAngle - gfVRPullKeep, 0.0f);
+			vFound.push_back(pItem);
+			vAngle.push_back(fAngle);
+		}
+		// Nearest to the aim first, each tested for line of sight.
+		for(int lTry = 0; lTry < glVRPullSightChecks; ++lTry)
+		{
+			int lBest = -1;
+			for(uint i = 0; i < vFound.length(); ++i)
+			{
+				if(vFound[i] is null) continue;
+				if(lBest < 0 || vAngle[i] < vAngle[lBest]) lBest = int(i);
+			}
+			if(lBest < 0) break;
+			iLuxEntity@ pItem = vFound[lBest];
+			if(cLux_CheckLineOfSight(vFrom + vDir * 0.05f, VRPullCentre(pItem), false, false, pItem)) return pItem.GetID();
+			@vFound[lBest] = null;
+		}
+		return tID_Invalid;
+	}
+	
+	// BunkerVR: sends the pulled item flying to the hand.
+	void VRLaunchPull(int alHand, cVRPull@ apPull, const cMatrixf &in a_mtxPalm)
+	{
+		cLuxProp@ pItem = cLux_ID_Prop(apPull.m_idTarget);
+		if(pItem is null) return;
+		float fDist = (a_mtxPalm.GetTranslation() - VRPullCentre(pItem)).Length();
+		apPull.mfFlightTime = cMath_Clamp(fDist / gfVRPullSpeed, gfVRPullFlightLeast, gfVRPullFlightMost);
+		apPull.mfFlying = 0.0f;
+		apPull.m_idFlying = pItem.GetID();
+		// Free to move, awake, and not bumping into the player's body on its way.
+		pItem.SetStaticPhysics(false);
+		pItem.WakeUp();
+		for(int i = 0; i < pItem.GetBodyNum(); ++i)
+		{
+			iPhysicsBody@ pBody = pItem.GetBody(i);
+			if(pBody is null) continue;
+			pBody.Enable();
+			pBody.SetCollideCharacter(false);
+		}
+		VRSteerPull(apPull, pItem, a_mtxPalm.GetTranslation());
+		Log("BunkerVR: the " + (alHand == 0 ? "left" : "right") + " hand pulls " + pItem.GetName() + " from " + fDist + " m away\n");
+	}
+	
+	// BunkerVR: gives the pulled item the velocity that brings it to the hand
+	// by the end of its flight, falling as it goes (an arc), at most 15 m/s.
+	// Recomputed every update, so it follows the hand as it moves.
+	void VRSteerPull(cVRPull@ apPull, cLuxProp@ apItem, const cVector3f &in avHand)
+	{
+		float fLeft = cMath_Max(apPull.mfFlightTime - apPull.mfFlying, 0.12f);
+		cVector3f vSpeed = (avHand - VRPullCentre(apItem)) / fLeft + cVector3f(0.0f, 0.5f * 9.81f * fLeft, 0.0f);
+		float fSpeed = vSpeed.Length();
+		if(fSpeed > 15.0f) vSpeed = vSpeed * (15.0f / fSpeed);
+		for(int i = 0; i < apItem.GetBodyNum(); ++i)
+		{
+			iPhysicsBody@ pBody = apItem.GetBody(i);
+			if(pBody !is null) pBody.SetLinearVelocity(vSpeed);
+		}
+	}
+	
+	// BunkerVR: the pulled item in flight: picked up once it is near the palm;
+	// given up (it falls where it is) after gfVRPullGiveUp seconds, or when the
+	// hand's position isn't known.
+	void VRUpdatePullFlight(int alHand, cVRPull@ apPull, bool abPalmKnown, const cMatrixf &in a_mtxPalm, float afTimeStep)
+	{
+		cLuxProp@ pItem = cLux_ID_Prop(apPull.m_idFlying);
+		if(pItem is null || pItem.IsActive() == false)
+		{
+			apPull.m_idFlying = tID_Invalid; // (gone already: picked up some other way)
+			return;
+		}
+		apPull.mfFlying += afTimeStep;
+		tString sName = pItem.GetName();
+		tString sHand = alHand == 0 ? "left" : "right";
+		bool bNear = abPalmKnown && (a_mtxPalm.GetTranslation() - VRPullCentre(pItem)).Length() < gfVRPullCatch;
+		if(bNear || abPalmKnown == false || apPull.mfFlying > gfVRPullGiveUp)
+		{
+			for(int i = 0; i < pItem.GetBodyNum(); ++i)
+			{
+				iPhysicsBody@ pBody = pItem.GetBody(i);
+				if(pBody !is null) pBody.SetCollideCharacter(true);
+			}
+			apPull.m_idFlying = tID_Invalid;
+			if(bNear == false)
+			{
+				Log("BunkerVR: " + sName + " did not reach the " + sHand + " hand: left where it is\n");
+				return;
+			}
+			cScript_SetGlobalReturnBool(false);
+			cScript_RunGlobalFunc(sName, "cScrPropPickup", "_Global_VRPickUp");
+			Log("BunkerVR: " + sName + " came into the " + sHand + " hand: " + (cScript_GetGlobalReturnBool() ? "picked up" : "not picked up (as the game would not, interacted with)") + "\n");
+			return;
+		}
+		VRSteerPull(apPull, pItem, a_mtxPalm.GetTranslation());
+	}
+	
+	// BunkerVR: the things the hands may pull glow, with a band sweeping over
+	// them as over the game's own pickups, but faster and bluish.
+	void VRGlowPullTargets(float afTimeStep)
+	{
+		if(mVRPullLeft.m_idTarget == tID_Invalid && mVRPullRight.m_idTarget == tID_Invalid) return;
+		mfVRPullGlow += afTimeStep * 1.5f;
+		if(mfVRPullGlow > 1.0f) mfVRPullGlow -= 1.0f;
+		cColor glowColor = cColor(0.45f, 0.75f, 1.2f, 1.0f);
+		cLuxEffectHandler@ pEffects = cLux_GetEffectHandler();
+		for(int i = 0; i < 2; ++i)
+		{
+			tID idTarget = i == 0 ? mVRPullLeft.m_idTarget : mVRPullRight.m_idTarget;
+			if(idTarget == tID_Invalid) continue;
+			iLuxEntity@ pItem = cLux_ID_Entity(idTarget);
+			if(pItem is null) continue;
+			pEffects.AddGlowObject(pItem, glowColor, mfVRPullGlow);
+		}
+	}
+	
+	//------------------------------------------------------------
+	
+	// BunkerVR: the gun pushes loose things it touches. The game keeps a held
+	// gun from bumping into anything, so this looks along the barrel each
+	// update, and whatever lies within the gun's length is shoved along with
+	// the speed that part of the gun is moving at (and out of the gun's way).
+	void VRPushWithGun(float afTimeStep)
+	{
+		tString sHeld = Item_GetHeldType(eItemHandlerHand_Right);
+		bool bGun = (sHeld == "Gun" || sHeld == "Shotgun") && Item_GetHeldState(eItemHandlerHand_Right) == 3;
+		if(bGun == false || afTimeStep < 0.0001f)
+		{
+			mbVRGunPushKnown = false;
+			return;
+		}
+		
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		if(pMap is null) return;
+		
+		iLuxEntity@ pGun = pMap.GetEntityByName(Item_GetHeldEntity(eItemHandlerHand_Right));
+		iPhysicsBody@ pMuzzle = pGun !is null ? pGun.GetBodyFromName("Body_BulletStart") : null;
+		if(pMuzzle is null)
+		{
+			mbVRGunPushKnown = false;
+			return;
+		}
+		
+		// The barrel: the game fires from this body, along its Z direction.
+		cMatrixf mtxMuzzle = pMuzzle.GetWorldMatrix();
+		cVector3f vDir = cMath_MatrixMul3x3(mtxMuzzle, cVector3f(0.0f, 0.0f, 1.0f));
+		if(vDir.Length() < 0.000001f) return;
+		vDir.Normalize();
+		cVector3f vBack = mtxMuzzle.GetTranslation() - vDir * gfVRGunLength;
+		
+		if(mbVRGunPushKnown)
+		{
+			float fDistance = 0.0f;
+			cVector3f vNormal = cVector3f(0);
+			iPhysicsBody@ pHit = cLux_GetClosestBody(vBack, vDir, gfVRGunLength + 0.02f, fDistance, vNormal);
+			if(pHit !is null && pHit.GetMass() > 0.0f && pHit.GetCollide() && pHit.IsCharacter() == false &&
+				pHit.GetJointNum() == 0) // not doors, hatches, drawers or anything else on a hinge or rail
+			{
+				// How fast the touching part of the gun is moving.
+				cVector3f vPointNow = vBack + vDir * fDistance;
+				cVector3f vPointWas = mvVRGunBackWas + mvVRGunDirWas * fDistance;
+				cVector3f vPush = (vPointNow - vPointWas) / afTimeStep;
+				
+				// Only the gun's own movement pushes: a gun held still against
+				// something, or merely pointed at it, does nothing.
+				float fPush = vPush.Length();
+				if(fPush > gfVRGunMaxPushSpeed)
+				{
+					vPush = vPush * (gfVRGunMaxPushSpeed / fPush);
+					fPush = gfVRGunMaxPushSpeed;
+				}
+				if(fPush > 0.4f)
+				{
+					// Only ever speed the thing up along the push, never hold it back.
+					cVector3f vPushDir = vPush / fPush;
+					float fAlready = cMath_Vector3Dot(pHit.GetVelocityAtPosition(vPointNow), vPushDir);
+					if(fAlready < fPush)
+					{
+						float fMass = pHit.GetMass();
+						if(fMass > gfVRGunPushMass) fMass = gfVRGunPushMass;
+						pHit.Enable();
+						pHit.AddImpulseAtPosition(vPushDir * ((fPush - fAlready) * fMass * 0.25f), vPointNow);
+					}
+				}
+			}
+		}
+		
+		mvVRGunBackWas = vBack;
+		mvVRGunDirWas = vDir;
+		mbVRGunPushKnown = true;
+	}
+	
+	//------------------------------------------------------------
+	
+	// BunkerVR: tells the VR mod whether a gun is held ready in the right hand,
+	// and whether the player is in the game's normal state. The mod changes what
+	// the controller buttons do while a gun is out. The news travels in the
+	// camera's position while its roll holds a special value; both are put
+	// straight back.
+	void VRSendGunNews()
+	{
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		cCamera@ pCam = pPlayer !is null ? pPlayer.GetCamera() : null;
+		if(pCam is null) return;
+		
+		// With "both eyes in step" the game draws a second picture while
+		// its clock stands still. It only draws without moving its world on
+		// when this engine setting is off.
+		// It is only switched off while that option is on (the mod says so
+		// when asked with the special roll value 7034).
+		{
+			float fStepRoll = pCam.GetRoll();
+			pCam.SetRoll(7034.0f);
+			cVector3f vStep = pCam.GetMatrix().GetTranslation();
+			pCam.SetRoll(fStepRoll);
+			bool bInStep = vStep.x > 12344.0f && vStep.x < 12346.0f && vStep.y > 0.5f;
+			if(cEngine_GetLimitFPS() == bInStep) cEngine_SetLimitFPS(bInStep == false);
+		}
+		
+		tString sHeld = Item_GetHeldType(eItemHandlerHand_Right);
+		bool bGun = (sHeld == "Gun" || sHeld == "Shotgun") && Item_GetHeldState(eItemHandlerHand_Right) == 3;
+		bool bNormal = pPlayer.GetCurrentStateId() == ePlayerState_Normal;
+		
+		// The third number: is a cutscene playing? (The mod can show those on a screen.)
+		int lNewsState = pPlayer.GetCurrentStateId();
+		bool bCutscene = lNewsState == ePlayerState_CutsceneAnimation || lNewsState == ePlayerState_InteractiveCutsceneAnimation;
+		// When the game holds the player still (its "Null" state) straight
+		// after a cutscene, between two scenes, the cutscene screen stays (if
+		// that scene was on it) until play or the next scene, for at most
+		// gfVRCutsceneBridge seconds. Example: in the trenches the gas mask goes
+		// on between the cough and the walk after Lambert, in the Null state;
+		// without this the screen would switch to play for about 2 s between.
+		// Scenes seen through the eyes are left alone: each takes its own facing.
+		bool bVRHeldAfterScene = false;
+		{
+			float fNow = float(cEngine_GetGameTime());
+			bool bRawCutscene = bCutscene;
+			if(lNewsState == ePlayerState_Null)
+			{
+				if(mbVRCutsceneStateWas)
+				{
+					mbVRCutsceneBridging = true;
+					mfVRCutsceneBridgeStart = fNow;
+					Log("BunkerVR: the player is held still straight after a cutscene" + (mbVRScreenWas ? ": the cutscene screen stays (until play or the next scene, at most " + int(gfVRCutsceneBridge) + " s)" : "") + "\n");
+				}
+				if(mbVRCutsceneBridging && fNow - mfVRCutsceneBridgeStart < gfVRCutsceneBridge) bVRHeldAfterScene = true;
+				else if(mbVRCutsceneBridging)
+				{
+					mbVRCutsceneBridging = false;
+					Log("BunkerVR: still held still after " + int(gfVRCutsceneBridge) + " s: the cutscene screen is let go\n");
+				}
+			}
+			else if(mbVRCutsceneBridging)
+			{
+				mbVRCutsceneBridging = false;
+				Log("BunkerVR: the hold after the cutscene is over after " + int((fNow - mfVRCutsceneBridgeStart) * 10.0f + 0.5f) + " tenths of a second: " + (bRawCutscene ? "the next scene" : "play") + "\n");
+			}
+			mbVRCutsceneStateWas = bRawCutscene;
+		}
+		// A knockdown, a kill or a death is on the cutscene screen only when
+		// the menu puts them there (VRUpdateRoughMove), including those the
+		// game plays as cutscene animations (VRRoughMoveKind).
+		// One that began since the last update is reported as one here already: VRUpdateRoughMove only notes it
+		// later in the update, so one that began before this report (the big fall's, as the player lands) would
+		// go out as a cutscene for that update, flashing the screen for 20 ms and re-centering the view.
+		int lVRRoughKind = mlVRRoughKind;
+		int lVRRoughView = mlVRRoughView;
+		if(lVRRoughKind == 0)
+		{
+			lVRRoughKind = VRRoughMoveKind();
+			if(lVRRoughKind != 0) lVRRoughView = VRModOption(35) == 1 ? 1 : 0; // (as VRUpdateRoughMove will take it)
+		}
+		if(lVRRoughKind != 0) bCutscene = lVRRoughView == 1;
+		// The game's own cutscenes, noted as they begin and end (VRNoteCutscene).
+		VRNoteCutscene(bCutscene && lVRRoughKind == 0);
+		if(bVRHeldAfterScene && mbVRScreenWas) bCutscene = true; // (the hold after a cutscene, above)
+		mbVRScreenWas = bCutscene;
+		// Whether the player is in play (active: not held still by a scene,
+		// as for the trenches' opening words), for the interface in pieces
+		// during play: the subtitles below the eyes, the hint card above them.
+		// The mod keeps the big panel for menus, the inventory, the map and
+		// the cutscene screen.
+		cVR_InterfaceInPieces(pPlayer.IsActive());
+		cVR_NoTurning(mlVRRoughKind != 0); // (no stick turns during a knockdown, a kill or a death: see VRDoSnapTurn)
+		// The room the interface pieces have, so they are never placed beyond a wall (VRSendInterfaceRoom).
+		// Worked out every glVRRoomEvery updates, and at once on the first update in play: up to 5 directions
+		// of up to 4 rays each, 0.04 to 0.06 ms each time. The mod only glides the pieces towards it (most of
+		// the way in a fifth of a second, kPiecesFollowRate in vr.cpp) and treats it as stale after a quarter
+		// of a second, so an answer one or two updates old makes no visible difference.
+		if(pPlayer.IsActive() == false) mlVRRoomWait = 0;
+		else
+		{
+			mlVRRoomWait--;
+			if(mlVRRoomWait <= 0)
+			{
+				mlVRRoomWait = glVRRoomEvery;
+				VRTimeMark(7156); // (timing by part: the interface's room, to 7157)
+				VRSendInterfaceRoom(pCam);
+				VRTimeMark(7157);
+			}
+		}
+		
+		// (The first number is 2 for the shotgun: its pump and shells are worked by hand.)
+		cVector3f vNews(bGun ? (sHeld == "Shotgun" ? 2.0f : 1.0f) : 0.0f, bNormal ? 1.0f : 0.0f, bCutscene ? 1.0f : 0.0f);
+		cVector3f vRealPos = pCam.GetPosition();
+		float fRealRoll = pCam.GetRoll();
+		pCam.SetPosition(vNews);
+		pCam.SetRoll(7020.0f);
+		pCam.GetMatrix();
+		
+		// More news (special roll value 7026): what the hands hold, as far as
+		// the mod's hand moves are concerned (right: 2 = bandage or medkit,
+		// 3 = grenade, 4 = lighter, 5 = an empty or full bottle, 6 = torch;
+		// left: 1 = flashlight), and how far the game has faded its picture
+		// to black. The game draws a fade as part of its flat interface, so
+		// the mod has to darken the eyes' pictures itself.
+		tString sHeldLow = cString_ToLowerCase(sHeld);
+		float fRightKind = 0.0f;
+		if(sHeld == "Bandage" || sHeld == "Medkit")						fRightKind = 2.0f;
+		else if(cString_GetFirstStringPos(sHeldLow, "grenade") >= 0)	fRightKind = 3.0f;
+		else if(sHeld == "Lighter")										fRightKind = 4.0f;
+		else if(sHeld == "EmptyBottle" || sHeld == "FuelBottle")		fRightKind = 5.0f;
+		else if(sHeld == "Torch")										fRightKind = 6.0f;	// (brandished by holding it out, not held "ready")
+		else if(sHeld != "")											fRightKind = 9.0f;	// anything else: the mod leaves that hand's fingers as animated
+		tString sHeldLeft = Item_GetHeldType(eItemHandlerHand_Left);
+		float fLeftKind = sHeldLeft == "DynamoLantern" ? 1.0f : (sHeldLeft != "" ? 9.0f : 0.0f);
+		// (The game's own lighter, which it puts in the left hand while a
+		// molotov is held ready (its only "temporary" item: EquipLighterInLeftHand
+		// in PlayerState_UsingItem_Base.hps, and the torch's first lighting): 4,
+		// as the lighter in the right hand, so that the left trigger works it.)
+		if(Item_GetTempRTUItemEntity() != "") fLeftKind = 4.0f;
+		// (The hand's path is kept for a throw: a grenade, or anything whose
+		// profile has the throw move: the bottles, the molotovs, the meat and
+		// the rabbit doll.)
+		int lRightMoves = BunkerVR_ItemMoves(sHeld);
+		if(sHeld == "Flare" && mbVRFlareLitNow == false) lRightMoves = 0; // (the flare is thrown only once its cord is pulled: VRUpdateFlare)
+		mbVRThrowableHeld = (fRightKind > 2.5f && fRightKind < 3.5f) || (lRightMoves & glBunkerVR_Move_Throw) != 0;
+		
+		// (The darkening also takes in a head in a wall (VRFollowHead), a
+		// knockdown, a kill or a death faded to black, the blink of the gentle
+		// ones (VRGentleView), and a Beast kill's blink and end (VRUpdateKillView).)
+		pCam.SetPosition(cVector3f(fRightKind, fLeftKind, cMath_Max(cMath_Max(cMath_Max(cMath_Max(cLux_GetEffectHandler().GetFadeAlpha(), mfVRHeadFade), mfVRRoughFade), mfVRGentleDark), mfVRKillDark)));
+		pCam.SetRoll(7026.0f);
+		pCam.GetMatrix();
+		
+		// And (special roll value 7092) whether the inventory is open (1) or
+		// not (0). It pauses the game only with the difficulty's "game paused
+		// in inventory", so the pause alone can't tell the mod when X and A
+		// should do their inventory jobs (drop, combine).
+		pCam.SetPosition(cVector3f(Sketchbook_IsOpen() ? 1.0f : 0.0f, 0.0f, 0.0f));
+		pCam.SetRoll(7092.0f);
+		pCam.GetMatrix();
+		
+		// And (special roll value 7083) what each hand touches: 0
+		// nothing, 1 something a hand's own hold can take, 2 something only the
+		// game's interact button can use (see VRTouchKind). With that the mod
+		// gives the game's button to a hand reaching for a door while the
+		// other hand carries something (UpdateGrabInput in vr.cpp).
+		pCam.SetPosition(cVector3f(float(VRTouchKind(0)), float(VRTouchKind(1)), 0.0f));
+		pCam.SetRoll(7083.0f);
+		pCam.GetMatrix();
+
+		// And (special roll value 7084) which item each
+		// hand holds, as its place in the game's item list (see
+		// VRHeldItemIndex): the mod may have a grip for it, saying how it sits
+		// in the hand (see VRReadGrips in Prop_PlayerBody.hps). Also told to the
+		// arms' code, with the held thing's own name, so that only that thing
+		// is placed by its grip.
+		int lHeldLeft = VRHeldItemIndex(sHeldLeft);
+		int lHeldRight = VRHeldItemIndex(sHeld);
+		cScript_SetGlobalVarInt("BunkerVR_HeldItem0", lHeldLeft);
+		cScript_SetGlobalVarInt("BunkerVR_HeldItem1", lHeldRight);
+		cScript_SetGlobalVarString("BunkerVR_HeldEntity0", lHeldLeft >= 0 ? Item_GetHeldEntity(eItemHandlerHand_Left) : "");
+		cScript_SetGlobalVarString("BunkerVR_HeldEntity1", lHeldRight >= 0 ? Item_GetHeldEntity(eItemHandlerHand_Right) : "");
+		pCam.SetPosition(cVector3f(float(lHeldLeft), float(lHeldRight), 0.0f));
+		pCam.SetRoll(7084.0f);
+		pCam.GetMatrix();
+
+		// And (special roll value 7093, the hands-on items' shared moves)
+		// which moves the item in the right hand takes part in, from
+		// its profile (BunkerVR_ItemMoves in helper_bunkervr_items.hps), and
+		// its place in the item list (for the mod's notes). The mod watches
+		// the right hand for those moves and sends what it saw (commands 7
+		// and 15, see VRDoItemCommand).
+		pCam.SetPosition(cVector3f(float(lRightMoves), float(lHeldRight), 0.0f));
+		pCam.SetRoll(7093.0f);
+		pCam.GetMatrix();
+
+		pCam.SetRoll(fRealRoll);
+		pCam.SetPosition(vRealPos);
+	}
+
+	// BunkerVR: an item type's place in the game's item list (the order of
+	// config\Inventory.cfg; the mod has the same list, kItemNames in its
+	// grips.cpp, and checks it against that file as it starts), or -1: for
+	// nothing, and for the gun and the shotgun (they have their own angles, on
+	// the mod's Hands page, and their barrel is lined up with the controller).
+	int VRHeldItemIndex(const tString &in asType)
+	{
+		if(asType == "" || asType == "Gun" || asType == "Shotgun") return -1;
+		// (gvVRItemTypes is built once, not on every call: this runs twice an update.)
+		for(uint i = 0; i < gvVRItemTypes.length(); ++i)
+			if(gvVRItemTypes[i] == asType) return int(i);
+		return -1;
+	}
+	
+	//------------------------------------------------------------
+	
+	// BunkerVR: while a grenade (or anything else thrown by hand) is in the
+	// right hand, remember where the hand was over the last 20 updates, so
+	// that a throw leaves with the hand's speed.
+	void VRTrackThrowHand(float afTimeStep)
+	{
+		if(mbVRThrowableHeld == false)
+		{
+			mVRThrowHand.mlHandTrailCount = 0;
+			return;
+		}
+		if(afTimeStep < 0.0001f) return;
+		
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		cCamera@ pCam = pPlayer !is null ? pPlayer.GetCamera() : null;
+		if(pCam is null) return;
+		
+		float fRealRoll = pCam.GetRoll();
+		pCam.SetRoll(7014.0f);
+		cVector3f vStatus = pCam.GetMatrix().GetTranslation();
+		if(vStatus.x < 12344.0f || vStatus.x > 12346.0f)
+		{
+			pCam.SetRoll(fRealRoll);
+			return;
+		}
+		pCam.SetRoll(7012.0f); // where the right palm is
+		cVector3f vHand = pCam.GetMatrix().GetTranslation();
+		pCam.SetRoll(fRealRoll);
+		
+		for(int i = 0; i < 19; ++i) mVRThrowHand.mvHandTrail[i] = mVRThrowHand.mvHandTrail[i + 1];
+		mVRThrowHand.mvHandTrail[19] = vHand;
+		if(mVRThrowHand.mlHandTrailCount < 20) mVRThrowHand.mlHandTrailCount++;
+		mVRThrowHand.mfHandTrailStep = afTimeStep;
+	}
+	
+	//------------------------------------------------------------
+	
+	// BunkerVR: the revolver at the hip or the shotgun behind the shoulder, asked for while an item
+	// is held ready in the right hand (see VRHipRevolver): taken out as soon as the player is back
+	// in the normal state, or given up after gfVRBodySlotWait and reported as busy.
+	void VRDoBodySlotWait(float afTimeStep)
+	{
+		if(mfVRHipWait <= 0.0f && mfVRShoulderWait <= 0.0f) return;
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		if(pPlayer is null)
+		{
+			mfVRHipWait = 0.0f;
+			mfVRShoulderWait = 0.0f;
+			return;
+		}
+		bool bNormal = pPlayer.GetCurrentStateId() == ePlayerState_Normal;
+		if(mfVRHipWait > 0.0f)
+		{
+			mfVRHipWait -= afTimeStep;
+			if(bNormal || mfVRHipWait <= 0.0f)
+			{
+				mfVRHipWait = 0.0f;
+				VRHipRevolver(pPlayer, true);
+			}
+		}
+		if(mfVRShoulderWait > 0.0f)
+		{
+			mfVRShoulderWait -= afTimeStep;
+			if(bNormal || mfVRShoulderWait <= 0.0f)
+			{
+				mfVRShoulderWait = 0.0f;
+				VRShoulderShotgun(pPlayer, true);
+			}
+		}
+	}
+
+	// BunkerVR: a put-away asked for with X (command 12) is done once the game
+	// has left the right-hand item's own state. While it holds the item ready,
+	// or lifts it to look at (one press of X is the game's "use" button), the
+	// mod lets go of that button, the game lowers the item and leaves the
+	// state, and then the item is put away. Don't put it away at once: with
+	// the item gone before its state ends, the state can never end (with the
+	// bandage, the arms' outro restarts over and over, with its sound). Given
+	// up after 2 seconds (the item stays).
+	void VRDoPutAwayWait(float afTimeStep)
+	{
+		if(mfVRPutAwayWait <= 0.0f) return;
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		if(pPlayer is null || Item_GetHeld(eItemHandlerHand_Right) == "")
+		{
+			mfVRPutAwayWait = 0.0f;
+			return;
+		}
+		tString sType = Item_GetHeldType(eItemHandlerHand_Right);
+		if(pPlayer.GetCurrentStateId() != Item_GetUsingState(sType))
+		{
+			mfVRPutAwayWait = 0.0f;
+			Item_PutAway(eItemHandlerHand_Right);
+			return;
+		}
+		mfVRPutAwayWait -= afTimeStep;
+		if(mfVRPutAwayWait <= 0.0f) Log("BunkerVR: X pressed twice: the game did not leave the " + sType + "'s own state within 2 seconds, so it was not put away\n");
+	}
+	
+	// BunkerVR: flames and things that burn, one check for all of them, ten
+	// times a second:
+	// - The flames: the lighter in the right hand lit by its trigger (command
+	//   13), and the game's own lighter in the left hand, which it puts there
+	//   while a molotov is held ready, lit by the left trigger (command 16).
+	// - Spilled fuel catches at once when a flame is over it, from a little
+	//   outside its edge to 35 cm above it. (The game lights it by pointing at
+	//   it with the lighter held "ready" and pressing; in VR the lighter is
+	//   never held ready.)
+	// - The cloth of the molotov in the right hand catches when a flame has
+	//   been within gfVRFireReach of it for gfVRFireHold. Lit as the game lights
+	//   it in its throw (its Light_Fire brought up to 3; the cloth's fire is
+	//   tied to that light, PS_Fire's ConnectLight), with the torch's start
+	//   sound and a buzz. Kept in the hand it burns out after gfVRMolotovBurn
+	//   (about 10 s); thrown lit it bursts into fire as the game's does, thrown
+	//   unlit it only breaks into spilled fuel (the throw, command 7, and
+	//   VRThrow in PlayerState_UsingThrowable.hps).
+	// Each lighting is logged ("BunkerVR: FIRE: ...").
+	void VRUpdateFlames(float afTimeStep)
+	{
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		if(pMap is null) return;
+
+		// A molotov lit in the hand burns out, or is no longer the one held.
+		cLuxProp@ pMolotov = VRHeldMolotov();
+		if(m_idVRMolotovLit != tID_Invalid)
+		{
+			if(pMolotov is null || pMolotov.GetID() != m_idVRMolotovLit)
+			{
+				m_idVRMolotovLit = tID_Invalid;
+			}
+			else
+			{
+				mfVRMolotovBurn += afTimeStep;
+				if(mfVRMolotovBurn >= gfVRMolotovBurn)
+				{
+					VRSetMolotovFire(pMolotov, false);
+					m_idVRMolotovLit = tID_Invalid;
+					Log("BunkerVR: FIRE: the molotov's cloth burnt out in the hand after " + int(gfVRMolotovBurn) + " s\n");
+				}
+			}
+		}
+
+		// The flames. (The torch in the right hand: burning, its head is a
+		// flame; out unlit, waiting to be lit by hand, its head is a thing that
+		// burns.)
+		if(mbVRLighterLit && Item_GetHeldType(eItemHandlerHand_Right) != "Lighter") mbVRLighterLit = false;
+		if(mbVRLeftLighterLit && Item_GetTempRTUItemEntity() == "") mbVRLeftLighterLit = false;
+		cLuxProp@ pTorch = VRHeldTorch();
+		bool bTorchUnlit = pTorch !is null && VRTorchWaitingForFlame(pTorch);
+		bool bTorchBurning = pTorch !is null && bTorchUnlit == false && pTorch.GetEffectsActive();
+		VRUpdateBrandish(bTorchBurning); // (the torch held out is brandished only while it burns)
+		if(mbVRLighterLit == false && mbVRLeftLighterLit == false && bTorchBurning == false)
+		{
+			mfVRClothFlameTime = 0.0f;
+			mfVRTorchFlameTime = 0.0f;
+			return;
+		}
+		mfVRLighterLookWait -= afTimeStep;
+		if(mfVRLighterLookWait > 0.0f) return;
+		mfVRLighterLookWait = 0.1f;
+		array<cVector3f> vFlames;
+		array<tString> vFlameNames;
+		if(mbVRLighterLit)
+			VRAddLighterFlame(cLux_ToProp(pMap.GetEntityByName(Item_GetHeldEntity(eItemHandlerHand_Right))), "the lighter's flame", vFlames, vFlameNames);
+		if(mbVRLeftLighterLit)
+			VRAddLighterFlame(cLux_ToProp(pMap.GetEntityByName(Item_GetTempRTUItemEntity())), "the left hand's lighter's flame", vFlames, vFlameNames);
+		if(bTorchBurning)
+		{
+			vFlames.push_back(cMath_MatrixMul(pTorch.GetMatrix(), gvVRTorchFlame));
+			vFlameNames.push_back("the torch's flame");
+		}
+		if(vFlames.length() == 0) return;
+
+		// Spilled fuel.
+		array<iLuxEntity@> vSpills;
+		pMap.GetEntityArray("*", eLuxEntityType_Prop, "cScrPropFuelSpill", vSpills);
+		for(uint i = 0; i < vSpills.length(); ++i)
+		{
+			iLuxEntity@ pSpill = vSpills[i];
+			if(pSpill is null) continue;
+			cMeshEntity@ pMesh = pSpill.GetMeshEntity();
+			if(pMesh is null) continue;
+			cBoundingVolume@ pBounds = pMesh.GetBoundingVolume();
+			if(pBounds is null) continue;
+			cVector3f vMin = pBounds.GetMin();
+			cVector3f vMax = pBounds.GetMax();
+			for(uint f = 0; f < vFlames.length(); ++f)
+			{
+				cVector3f vFlame = vFlames[f];
+				if(vFlame.x < vMin.x - 0.05f || vFlame.x > vMax.x + 0.05f) continue;
+				if(vFlame.z < vMin.z - 0.05f || vFlame.z > vMax.z + 0.05f) continue;
+				if(vFlame.y < vMin.y - 0.1f || vFlame.y > vMax.y + 0.35f) continue;
+				cScript_RunGlobalFunc(pSpill.GetName(), "cScrPropFuelSpill", "_Global_GetCanIgnite");
+				if(cScript_GetGlobalReturnBool() == false) break;
+				cScript_SetGlobalArgBool(0, true);
+				cScript_RunGlobalFunc(pSpill.GetName(), "cScrPropFuelSpill", "_Global_Ignite");
+				Log("BunkerVR: FIRE: " + vFlameNames[f] + " lit the spilt fuel " + pSpill.GetName() + "\n");
+				break;
+			}
+		}
+
+		// The cloth of the molotov in the right hand, not lit yet.
+		cVector3f vClothLow, vClothHigh;
+		if(pMolotov is null || m_idVRMolotovLit != tID_Invalid || VRMolotovCloth(pMolotov, vClothLow, vClothHigh) == false)
+		{
+			mfVRClothFlameTime = 0.0f;
+		}
+		else
+		{
+			int lNear = VRNearestFlame(vFlames, vClothLow, vClothHigh, gfVRFireReach);
+			mfVRClothFlameTime = lNear >= 0 ? mfVRClothFlameTime + 0.1f : 0.0f;
+			if(lNear >= 0 && mfVRClothFlameTime >= gfVRFireHold - 0.01f)
+			{
+				VRSetMolotovFire(pMolotov, true);
+				m_idVRMolotovLit = pMolotov.GetID();
+				mfVRMolotovBurn = 0.0f;
+				mfVRClothFlameTime = 0.0f;
+				VRBuzzHand(1, 0.15f, 0.6f);
+				cVR_HintUsed("light_it");
+				Log("BunkerVR: FIRE: " + vFlameNames[lNear] + " lit the molotov's cloth (it burns out in the hand after " + int(gfVRMolotovBurn) + " s)\n");
+			}
+		}
+
+		// The head of the torch in the right hand, out unlit: its rag, from
+		// gvVRTorchHeadLow to gvVRTorchHeadHigh up the stick.
+		if(bTorchUnlit == false)
+		{
+			mfVRTorchFlameTime = 0.0f;
+		}
+		else
+		{
+			cMatrixf mtxTorch = pTorch.GetMatrix();
+			int lNear = VRNearestFlame(vFlames, cMath_MatrixMul(mtxTorch, gvVRTorchHeadLow), cMath_MatrixMul(mtxTorch, gvVRTorchHeadHigh), gfVRTorchHeadReach);
+			mfVRTorchFlameTime = lNear >= 0 ? mfVRTorchFlameTime + 0.1f : 0.0f;
+			if(lNear >= 0 && mfVRTorchFlameTime >= gfVRFireHold - 0.01f)
+			{
+				mfVRTorchFlameTime = 0.0f;
+				cScript_RunGlobalFunc(pTorch.GetName(), "cScrPropTorch", "_Global_VRLightByHand");
+				VRBuzzHand(1, 0.15f, 0.6f);
+				cVR_HintUsed("light_it");
+				Log("BunkerVR: FIRE: " + vFlameNames[lNear] + " lit the torch " + pTorch.GetName() + "\n");
+			}
+		}
+	}
+
+	// BunkerVR: the torch is brandished while the torch in the right hand is
+	// held out (commands 18, 19) and burns, as the game's "ready" state does it
+	// (PlayerState_UsingTorch: the torch's brighter, wider light and brandish
+	// sounds, rats threatened; the torch burns faster while brandished). Not
+	// while it is out unlit, waiting to be lit by hand (the brandish brings up
+	// its burning sounds); lit while held out, it is brandished at once. Ends
+	// when either stops or the torch leaves the hand.
+	void VRUpdateBrandish(bool abTorchBurning)
+	{
+		bool bBrandish = mbVRTorchHeldOut && abTorchBurning;
+		if(bBrandish == mbVRBrandishing) return;
+		mbVRBrandishing = bBrandish;
+		if(bBrandish) cVR_HintUsed("torch_out");
+		RatHandler_SetPlayerThreatensRats(bBrandish);
+		if(Item_GetHeldType(eItemHandlerHand_Right) == "Torch")
+		{
+			cScript_SetGlobalArgBool(0, bBrandish);
+			cScript_RunGlobalFunc(Item_GetHeldEntity(eItemHandlerHand_Right), "cScrPropTorch", "_Global_SetTorchAimAttributes");
+		}
+		Log("BunkerVR: FIRE: the torch " + (bBrandish ? "is brandished (held out, burning)" : "is no longer brandished") + "\n");
+	}
+
+	// BunkerVR: blood on the hands, so a look at them tells how hurt the
+	// player is. The game shows blood on the body (its "liquid amount") only
+	// while the health is checked (1 - health; PlayerState_CheckHealth.hps) or
+	// when a scene asks (the gas in the trenches); in VR it always shows at
+	// least 1 - health. What the scripts ask for is kept (SetLiquidAmount,
+	// FadeLiquidAmountTo) and the larger of the two is shown: the blood comes
+	// in within half a second and fades over a few seconds as the player heals.
+	void VRUpdateHandBlood(float afTimeStep)
+	{
+		if(mfVRScriptLiquidSpeed > 0.0f)
+			mfVRScriptLiquid = cMath_IncreaseTo(mfVRScriptLiquid, mfVRScriptLiquidSpeed * afTimeStep, mfVRScriptLiquidGoal);
+		else
+			mfVRScriptLiquid = mfVRScriptLiquidGoal;
+		float fHurt = cMath_Clamp(1.0f - Player_GetHealth(), 0.0f, 1.0f);
+		float fWant = cMath_Max(mfVRScriptLiquid, fHurt);
+		float fWas = mfVRHandBlood;
+		mfVRHandBlood = cMath_IncreaseTo(mfVRHandBlood, afTimeStep * (fWant > mfVRHandBlood ? 2.0f : 0.2f), fWant);
+		VRSayHealth();
+		cLuxProp@ pProp = cLux_ID_Prop(m_idBody);
+		if(pProp is null) return;
+		// (Set again when it changes, or the body is a new one: a map's own.)
+		if(cMath_Abs(mfVRHandBloodSet - mfVRHandBlood) > 0.002f || m_idVRHandBloodBody != m_idBody)
+		{
+			pProp.SetLiquidAmount(mfVRHandBlood);
+			mfVRHandBloodSet = mfVRHandBlood;
+			m_idVRHandBloodBody = m_idBody;
+		}
+		if(mlVRHandBloodNotes < 20 && int(fWas * 10.0f) != int(mfVRHandBlood * 10.0f))
+		{
+			mlVRHandBloodNotes++;
+			Log("BunkerVR: the blood on the hands: " + BunkerVR_Fixed(mfVRHandBlood, 2) + " (health " + BunkerVR_Fixed(Player_GetHealth(), 2) + ", the scripts ask " + BunkerVR_Fixed(mfVRScriptLiquid, 2) + ")\n");
+		}
+	}
+
+	// BunkerVR: each change of the player's health by 0.05 or more goes in the mod's own log, which has
+	// timestamps (the game's log has none), so the moment the player got hurt can be found by the clock.
+	// At most 400 lines a run.
+	void VRSayHealth()
+	{
+		float fHealth = Player_GetHealth();
+		if(mlVRHealthNotes >= 400 || cMath_Abs(fHealth - mfVRHealthSaid) < 0.05f) return;
+		mlVRHealthNotes++;
+		cVR_Say("health " + BunkerVR_Fixed(fHealth, 2) + (mfVRHealthSaid < 0.0f ? "" : " (was " + BunkerVR_Fixed(mfVRHealthSaid, 2) + ")"));
+		mfVRHealthSaid = fHealth;
+	}
+
+	// BunkerVR: the game's camera shake (Effect_Shake: shells, explosions)
+	// this frame, which the camera code takes out of the VR view (the view
+	// should never move by itself), and a buzz of both controllers instead, as
+	// strong as the shake.
+	// With the body shown, as it always is in VR, the game gives its shake to the body's spine
+	// (mvShakeAmount) instead of the camera; VR leaves that out too (UpdateBones), so the buzz
+	// covers it as well.
+	cVector3f VRShakeAsBuzz(float afTimeStep)
+	{
+		cVector3f vShake = cLux_GetPlayer().GetCameraPosAdd(eCameraAddType_Shake);
+		float fSize = cMath_Max(vShake.Length(), mvShakeAmount.Length());
+		mfVRShakeBuzzWait -= afTimeStep;
+		if(fSize > 0.002f && mfVRShakeBuzzWait <= 0.0f)
+		{
+			float fStrength = cMath_Clamp(fSize / 0.05f, 0.15f, 1.0f);
+			VRBuzzHand(0, 0.1f, fStrength);
+			VRBuzzHand(1, 0.1f, fStrength);
+			mfVRShakeBuzzWait = 0.1f;
+			if(mlVRShakeNotes < 10)
+			{
+				mlVRShakeNotes++;
+				Log("BunkerVR: a shake of " + BunkerVR_Fixed(fSize * 100.0f, 1) + " cm left out of the view and the body, a buzz of " + BunkerVR_Fixed(fStrength, 2) + " instead\n");
+			}
+		}
+		return vShake;
+	}
+
+	// BunkerVR: the lighter a trigger works: alHand 0, the game's
+	// own lighter in the left hand (a molotov held ready, the torch's first
+	// lighting); 1, the lighter in the right hand. Null when there is none.
+	cLuxProp@ VRTriggerLighter(int alHand)
+	{
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		if(pMap is null) return null;
+		tString sName = "";
+		if(alHand == 0) sName = Item_GetTempRTUItemEntity();
+		else if(Item_GetHeldType(eItemHandlerHand_Right) == "Lighter") sName = Item_GetHeldEntity(eItemHandlerHand_Right);
+		if(sName == "") return null;
+		return cLux_ToProp(pMap.GetEntityByName(sName));
+	}
+
+	// BunkerVR: a lighter's trigger held (abHeld) or let go. Held: its lid
+	// flicks open (the lighter's own flick, gsVRLighterOpenAnim, from
+	// gfVRLighterOpenFrom, just before its lid moves); it lights
+	// gfVRLighterLightAt later, as the lid is up, and settles into its lit idle
+	// (VRUpdateLighters). Let go: shut at once, with the lighter's click.
+	void VRLighterTrigger(int alHand, bool abHeld)
+	{
+		if(alHand == 0) mbVRLeftLighterLit = false;
+		else mbVRLighterLit = false;
+		mvVRLighterOpening[alHand] = -1.0f;
+		cLuxProp@ pLighter = VRTriggerLighter(alHand);
+		if(pLighter is null) return;
+		if(abHeld)
+		{
+			pLighter.PlayAnimation(gsVRLighterOpenAnim, 0.05f, false);
+			cAnimationState@ pOpen = pLighter.GetMeshEntity().GetAnimationStateFromName(gsVRLighterOpenAnim);
+			if(pOpen !is null) pOpen.SetTimePosition(gfVRLighterOpenFrom);
+			mvVRLighterOpening[alHand] = 0.0f;
+			if(mlVRLighterNotes < 20)
+			{
+				mlVRLighterNotes++;
+				Log("BunkerVR: FIRE: the " + (alHand == 0 ? "left hand's" : "right hand's") + " lighter opens (" + gsVRLighterOpenAnim + (pOpen !is null ? " from " + BunkerVR_Fixed(gfVRLighterOpenFrom, 2) + " s" : ", NOT found") + ")\n");
+			}
+		}
+		else
+		{
+			cScript_RunGlobalFunc(pLighter.GetName(), "cScrPropLighter", "_Global_Close");
+			pLighter.PlayAnimation("lighter_idle_closed", 0.1f, true);
+			for(int i = 0; i < pLighter.GetBillboardNum(); ++i)
+				pLighter.GetBillboard(i).SetVisible(false);
+		}
+	}
+
+	// BunkerVR: the lighters between their trigger's presses (see
+	// VRLighterTrigger), every update. An opening lighter lights
+	// gfVRLighterLightAt after the press (the lighter's own script: the click,
+	// the flame, its light) and goes into its lit idle at gfVRLighterSettleAt.
+	// The game's lighter in the left hand also keeps the lid the trigger gives
+	// it: the game plays its own molotov animations on it with the lid open,
+	// lit or not, which would show an open lid with no flame. A new lighter in
+	// a hand starts shut.
+	void VRUpdateLighters(float afTimeStep)
+	{
+		for(int lHand = 0; lHand < 2; ++lHand)
+		{
+			cLuxProp@ pLighter = VRTriggerLighter(lHand);
+			tID idLighter = pLighter !is null ? pLighter.GetID() : tID_Invalid;
+			if(idLighter != mvVRLighterID[lHand])
+			{
+				mvVRLighterID[lHand] = idLighter;
+				mvVRLighterOpening[lHand] = -1.0f;
+				if(lHand == 0) mbVRLeftLighterLit = false;
+				else mbVRLighterLit = false;
+			}
+			if(pLighter is null) continue;
+
+			if(mvVRLighterOpening[lHand] >= 0.0f)
+			{
+				float fWas = mvVRLighterOpening[lHand];
+				float fNow = fWas + afTimeStep;
+				mvVRLighterOpening[lHand] = fNow;
+				if(fWas < gfVRLighterLightAt && fNow >= gfVRLighterLightAt)
+				{
+					cScript_RunGlobalFunc(pLighter.GetName(), "cScrPropLighter", "_Global_IgniteInstantly");
+					if(lHand == 0) mbVRLeftLighterLit = true;
+					else mbVRLighterLit = true;
+					mfVRLighterLookWait = 0.0f;
+				}
+				if(fNow >= gfVRLighterSettleAt)
+				{
+					pLighter.PlayAnimation("lighter_idle_lit", 0.3f, true);
+					mvVRLighterOpening[lHand] = -1.0f;
+				}
+				continue;
+			}
+
+			if(lHand == 0)
+			{
+				bool bLit = mbVRLeftLighterLit;
+				tString sAnim = bLit ? "lighter_idle_lit" : "lighter_idle_closed";
+				cAnimationState@ pState = pLighter.GetMeshEntity().GetAnimationStateFromName(sAnim);
+				if(pState !is null && pState.IsActive() == false)
+				{
+					pLighter.PlayAnimation(sAnim, 0.15f, true);
+					if(mlVRLighterNotes < 20)
+					{
+						mlVRLighterNotes++;
+						Log("BunkerVR: FIRE: the left hand's lighter kept " + (bLit ? "open (lit)" : "shut") + " over the game's own animation\n");
+					}
+				}
+			}
+		}
+		VRUpdateLeftLighterPose();
+	}
+
+	// BunkerVR: while the game's lighter is in the left hand for the torch's
+	// first lighting, the left hand holds it as the game's molotov has it
+	// (gsVRLeftLighterPose, its fingers around the lighter: a hand that holds
+	// one of the game's things keeps the game's fingers, VrGetFingers). The
+	// game's own torch sequence plays its left arm's lighting animation; the
+	// mod skips that sequence, so without this the lighter would sit in a hand
+	// posed as an empty one. Released when the lighter goes.
+	void VRUpdateLeftLighterPose()
+	{
+		cLuxProp@ pTorch = VRHeldTorch();
+		bool bWant = pTorch !is null && Item_GetTempRTUItemEntity() != "" && VRTorchWaitingForFlame(pTorch);
+		bool bPlaying = mvAnimationLayers[ePlayerBodyAnimationLayer_LeftArm].mvCurrentAnimations.find(gsVRLeftLighterPose) >= 0;
+		if(bWant && bPlaying == false)
+		{
+			PlayAnimationInLayer(gsVRLeftLighterPose, ePlayerBodyAnimationLayer_LeftArm, true, false, false, 0.3f, 1.0f, 0.0f);
+			if(mbVRLeftLighterPose == false && mlVRLighterNotes < 20)
+			{
+				mlVRLighterNotes++;
+				Log("BunkerVR: FIRE: the left hand holds the game's lighter as for a molotov (" + gsVRLeftLighterPose + ")\n");
+			}
+			mbVRLeftLighterPose = true;
+		}
+		else if(bWant == false && mbVRLeftLighterPose)
+		{
+			StopAnimationInLayer(gsVRLeftLighterPose, ePlayerBodyAnimationLayer_LeftArm, 0.3f);
+			mbVRLeftLighterPose = false;
+			if(mlVRLighterNotes < 20)
+			{
+				mlVRLighterNotes++;
+				Log("BunkerVR: FIRE: the left hand lets go of the lighter's hold\n");
+			}
+		}
+	}
+
+	// BunkerVR: which of the flames is within afReach of the stretch from avLow
+	// to avHigh (the last of them that is), or -1.
+	int VRNearestFlame(const array<cVector3f> &in avFlames, const cVector3f &in avLow, const cVector3f &in avHigh, float afReach)
+	{
+		int lNear = -1;
+		for(uint f = 0; f < avFlames.length(); ++f)
+			if(BunkerVR_DistanceToSegment(avFlames[f], avLow, avHigh) < afReach) lNear = int(f);
+		return lNear;
+	}
+
+	// BunkerVR: the torch in the right hand, or null.
+	cLuxProp@ VRHeldTorch()
+	{
+		if(Item_GetHeldType(eItemHandlerHand_Right) != "Torch") return null;
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		return pMap !is null ? cLux_ToProp(pMap.GetEntityByName(Item_GetHeldEntity(eItemHandlerHand_Right))) : null;
+	}
+
+	// BunkerVR: is that torch out unlit, waiting to be lit by hand (its own
+	// script says, _Global_VRGetWaitingForFlame in Prop_Torch.hps)?
+	bool VRTorchWaitingForFlame(cLuxProp@ apTorch)
+	{
+		if(apTorch is null) return false;
+		cScript_SetGlobalReturnBool(false);
+		if(cScript_RunGlobalFunc(apTorch.GetName(), "cScrPropTorch", "_Global_VRGetWaitingForFlame") == false) return false;
+		return cScript_GetGlobalReturnBool();
+	}
+
+	// BunkerVR: the flame of a lighter: where its
+	// flame is drawn (its billboard; the game shows it as the lid opens), or the
+	// lighter itself if it has none. Added to the lists, if apLighter is there.
+	void VRAddLighterFlame(cLuxProp@ apLighter, const tString &in asName, array<cVector3f> &inout avFlames, array<tString> &inout avNames)
+	{
+		if(apLighter is null) return;
+		cVector3f vFlame = apLighter.GetMatrix().GetTranslation();
+		if(apLighter.GetBillboardNum() > 0) vFlame = apLighter.GetBillboard(0).GetWorldMatrix().GetTranslation();
+		avFlames.push_back(vFlame);
+		avNames.push_back(asName);
+	}
+
+	// BunkerVR: fuel poured by hand. The fuel can (or a full bottle) held in
+	// the right hand is tipped until its opening is below its middle, over the
+	// generator's fuel hatch (the area "Trigger_FuelHatch") or a save lamp's
+	// fuel opening (the area "SaveLamp_SavingCostsFuel_Aux", which the game
+	// lets be used only with "saving costs fuel"). It pours only once its lid
+	// or cork is off (VRUpdateLid). Fuel runs from the opening as a thin stream
+	// of the mod's own (gsVRPourStream; the game's fuel effect is its throwing
+	// splash, droplets thrown up) with a light buzz, and once it has run for
+	// gfVRPourCommit the can is used on it as the game's use button does there
+	// (Item_UseHeldOnWorld, after the game's own "can it be used": the map's
+	// refueling, which in VR plays no animation, officer_hub.hps OnUse_Fuel;
+	// one fuel, the can then used up). The game's checks stand: a full
+	// generator says so, and nothing is used. A pour stopped sooner uses
+	// nothing. After a use it must be tipped up again before it pours again.
+	// The use button works too.
+	void VRUpdatePour(float afTimeStep)
+	{
+		tString sType = Item_GetHeldType(eItemHandlerHand_Right);
+		bool bCan = sType == "Fuel";
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		cLuxProp@ pVessel = (bCan || sType == "FuelBottle") && pMap !is null ? cLux_ToProp(pMap.GetEntityByName(Item_GetHeldEntity(eItemHandlerHand_Right))) : null;
+		if(pVessel is null)
+		{
+			m_idVRPourVessel = tID_Invalid;
+			mfVRPourTime = 0.0f;
+			cScript_SetGlobalVarInt("BunkerVR_FuelOpen", 0);
+			return;
+		}
+		if(pVessel.GetID() != m_idVRPourVessel)
+		{
+			m_idVRPourVessel = pVessel.GetID();
+			// A new can pours once its lid is off, however it is held: if it waited to be tipped up first, one held
+			// tipped from the start would show its stream over the hatch and put nothing in. The closed lid it comes
+			// with keeps it from pouring by itself. After a pour it must still be tipped up again before another.
+			mbVRPourReady = true;
+			mfVRPourTime = 0.0f;
+			mfVRPourStreamWait = 0.0f;
+			mbVRLidOff = false;			// (it comes closed)
+			mbVRLidSqueezeWas = true;	// (a squeeze already on when it came does not open it)
+			mbVRLidHinted = false;
+		}
+
+		// Its opening and its middle, as held; open (VRUpdateLid)? tipped?
+		cMatrixf mtxVessel = pVessel.GetMatrix();
+		iPhysicsBody@ pOpeningBody = bCan ? pVessel.GetBodyFromName("Opening") : null;
+		cVector3f vOpening = pOpeningBody !is null ? pOpeningBody.GetWorldMatrix().GetTranslation() : cMath_MatrixMul(mtxVessel, gvVRBottleOpening);
+		mvVRHintOpening = vOpening; // (for the hints: VRUpdateHints)
+		cVector3f vMiddle = cMath_MatrixMul(mtxVessel, bCan ? gvVRCanMiddle : gvVRBottleMiddle);
+		VRUpdateLid(pVessel, bCan, vOpening);
+		cScript_SetGlobalVarInt("BunkerVR_FuelOpen", mbVRLidOff ? 1 : 0);
+		bool bTipped = VRPourTipped(vOpening, vMiddle, cMath_MatrixMul(mtxVessel, gvVRCanTop), bCan);
+		if(mbVRLidOff == false)
+		{
+			// Closed: nothing pours; tipped, the hint says how to open it (once).
+			mfVRPourTime = 0.0f;
+			if(bTipped && mbVRLidHinted == false)
+			{
+				mbVRLidHinted = true;
+				Hint_ShowHint("Hints", "HintVRFuelLid");
+			}
+			return;
+		}
+		if(bTipped == false)
+		{
+			mbVRPourReady = true;
+			mfVRPourTime = 0.0f;
+			return;
+		}
+
+		// Over what it can be used on? (The names the maps' own "can use"
+		// checks know: the generator's hatch, a trigger area in officer_hub,
+		// and the save lamps' openings; looked up again once a second. The
+		// game's own "can use" decides.)
+		float fNow = float(cEngine_GetGameTime());
+		if(fNow - mfVRPourListTime > 1.0f || fNow < mfVRPourListTime)
+		{
+			mfVRPourListTime = fNow;
+			mvVRPourTargets.resize(0);
+			iLuxEntity@ pHatch = pMap.GetEntityByName("Trigger_FuelHatch");
+			if(pHatch !is null) mvVRPourTargets.push_back(pHatch.GetID());
+			iLuxEntity@ pLampOpening = pMap.GetEntityByName("SaveLamp_SavingCostsFuel_Aux");
+			if(pLampOpening !is null) mvVRPourTargets.push_back(pLampOpening.GetID());
+		}
+		tString sTarget = "";
+		for(uint i = 0; i < mvVRPourTargets.length() && sTarget == ""; ++i)
+		{
+			iLuxEntity@ pArea = cLux_ID_Entity(mvVRPourTargets[i]);
+			if(pArea is null || pArea.IsActive() == false || pArea.GetBodyNum() == 0) continue;
+			iPhysicsBody@ pAreaBody = pArea.GetBody(0);
+			cBoundingVolume@ pBox = pAreaBody !is null ? pAreaBody.GetBoundingVolume() : null;
+			if(pBox is null) continue;
+			cVector3f vLow = pBox.GetMin() - cVector3f(gfVRPourOver, gfVRPourOver, gfVRPourOver);
+			cVector3f vHigh = pBox.GetMax() + cVector3f(gfVRPourOver, gfVRPourAbove, gfVRPourOver);
+			if(vOpening.x < vLow.x || vOpening.y < vLow.y || vOpening.z < vLow.z || vOpening.x > vHigh.x || vOpening.y > vHigh.y || vOpening.z > vHigh.z) continue;
+			if(Item_GetCanUseOnWorld(eItemHandlerHand_Right, pArea.GetName())) sTarget = pArea.GetName();
+		}
+		if(sTarget == "")
+		{
+			mfVRPourTime = 0.0f;
+			return;
+		}
+
+		// Pouring: the fuel runs from the opening (a thin falling stream, a new
+		// one every gfVRPourStreamGap, a quarter of a second), with a light buzz.
+		mfVRPourStreamWait -= afTimeStep;
+		if(mfVRPourStreamWait <= 0.0f)
+		{
+			mfVRPourStreamWait = gfVRPourStreamGap;
+			mlVRPourStreams++;
+			cParticleSystem@ pStream = pVessel.CreateParticleSystem("VRPour_" + mlVRPourStreams, gsVRPourStream, true, false);
+			if(pStream !is null)
+			{
+				cMatrixf mtxStream = cMatrixf_Identity; // (upright: it falls straight down)
+				mtxStream.SetTranslation(vOpening);
+				pStream.SetWorldMatrix(mtxStream);
+			}
+			VRBuzzHand(1, 0.03f, 0.25f);
+		}
+		if(mbVRPourReady == false) return;
+		mfVRPourTime += afTimeStep;
+		if(mfVRPourTime < gfVRPourCommit) return;
+
+		// Poured long enough: used on it, as the game's use button there.
+		mbVRPourReady = false;
+		mfVRPourTime = 0.0f;
+		Log("BunkerVR: the " + (bCan ? "fuel can" : "fuel bottle") + " is poured into " + sTarget + ": used on it (the game's own use)\n");
+		cVR_HintUsed("pour");
+		Item_UseHeldOnWorld(eItemHandlerHand_Right, sTarget);
+	}
+
+	// BunkerVR: the fuel tap turned by hand. The tap is maintenance's (FuelTap) or the item test map's
+	// ("BunkerVR_TestFuelTap"). The left hand takes its lever with a squeeze at the handle and turns it about the
+	// lever's upright, as the game's own refill scene turns it (43 degrees open), with a click in the hand every 10
+	// degrees and a firmer one fully open. The hand is drawn holding the handle, turning it against the tap's weight
+	// (see below). Let go, the lever springs shut and is seated again, so the fuel can't run forever. From 26 degrees
+	// open the fuel runs from the spout (the pour's thin stream). An empty bottle or empty molotov held upright in the
+	// right hand, its neck under the spout, fills in 1.6 s of it (the game's filling sound, a buzz in that hand
+	// growing), and is then used on the tap as the game's use button would ("Trigger_FuelBottleFiller": the maps'
+	// CanUse_EmptyBottle and OnUse_EmptyBottle, which in VR play no scene and put the full one in the hand). The game's
+	// own way (the trigger, with the bottle aimed at the tap) still works.
+	void VRUpdateFuelTap(float afTimeStep)
+	{
+		mbVRTapNearNow = false;
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		if(pMap is null) return;
+
+		// The tap: looked for again once a second.
+		float fNow = float(cEngine_GetGameTime());
+		if(fNow - mfVRTapListTime > 1.0f || fNow < mfVRTapListTime)
+		{
+			mfVRTapListTime = fNow;
+			iLuxEntity@ pFound = pMap.GetEntityByName("FuelTap");
+			tString sTest = cScript_GetGlobalVarString("BunkerVR_TestFuelTap");
+			if(pFound is null && sTest != "") @pFound = pMap.GetEntityByName(sTest);
+			tID idFound = pFound !is null ? pFound.GetID() : tID_Invalid;
+			if(idFound != m_idVRTap)
+			{
+				m_idVRTap = idFound;
+				mbVRTapHeld = false;
+				mfVRTapAngle = 0.0f;
+				mfVRTapAngleSet = -1.0f;
+				mbVRTapFreed = false;
+				mfVRTapTickAt = 0.0f;
+				mbVRTapRunning = false;
+				mfVRTapFill = 0.0f;
+				msVRTapBottle = "";
+			}
+		}
+		cLuxProp@ pTap = cLux_ID_Prop(m_idVRTap);
+		if(pTap is null) return;
+		cMatrixf mtxTap = pTap.GetMatrix();
+		cVector3f vHub = cMath_MatrixMul(mtxTap, gvVRTapHub);
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		bool bNear = pPlayer !is null && (pPlayer.GetCharacterBody().GetPosition() - vHub).Length() <= gfVRTapNear;
+		if(bNear == false && mbVRTapHeld == false && mfVRTapAngle <= 0.0f) return;
+		// The tap's own still pose is kept playing under the lever's turn: with no animation playing, the engine leaves
+		// the tap's bones as they are and the lever's pose doesn't show. Its model plays its refill on its own unless
+		// stopped (maintenance stops it as the level starts).
+		cMeshEntity@ pTapMesh = pTap.GetMeshEntity();
+		cAnimationState@ pIdle = pTapMesh !is null ? pTapMesh.GetAnimationStateFromName(gsVRTapIdleAnim) : null;
+		if(pIdle !is null && pIdle.IsActive() == false)
+		{
+			pTap.PlayAnimation(gsVRTapIdleAnim, 0.0f, true);
+			mfVRTapAngleSet = -1.0f;
+		}
+
+		// The lever's upright, the way its handle points shut (level), and the handle's end as it stands now.
+		cVector3f vUp = cMath_MatrixMul3x3(mtxTap, cVector3f(0.0f, 1.0f, 0.0f));
+		vUp.Normalize();
+		cVector3f vShut = cMath_MatrixMul(mtxTap, gvVRTapHandleEnd) - vHub;
+
+		cVector3f vEnd = vHub + cMath_MatrixMul3x3(BunkerVR_TurnBy(vUp * (gfVRTapTurnSign * mfVRTapAngle)), vShut);
+		mbVRTapNearNow = bNear;
+		mvVRTapHintAt = vEnd;
+
+		// The left hand: a fresh squeeze at the handle takes it (the left hand holding nothing of the game's); let go,
+		// or pulled away from the tap, it lets go.
+		float fCurl = BunkerVR_HandCurl(0);
+		bool bSqueeze = fCurl > (mbVRTapSqueezeWas ? gfVRLidLetGo : gfVRLidSqueeze);
+		bool bFresh = bSqueeze && mbVRTapSqueezeWas == false;
+		mbVRTapSqueezeWas = bSqueeze;
+		cMatrixf mtxPalm;
+		float fArmScale;
+		bool bPalm = BunkerVR_ReadFollowedPalm(0, mtxPalm, fArmScale);
+		cVector3f vPalm = mtxPalm.GetTranslation();
+		if(mbVRTapHeld == false && bFresh && bPalm && bNear && Item_GetHeldType(eItemHandlerHand_Left) == "")
+		{
+			float fNear = BunkerVR_DistanceToSegment(vPalm, vHub, vEnd);
+			if(cMath_Abs(fNow - cScript_GetGlobalVarFloat("BunkerVR_IndexTipTime0")) < 0.25f)
+				fNear = cMath_Min(fNear, BunkerVR_DistanceToSegment(cScript_GetGlobalVarVector3f("BunkerVR_IndexTip0"), vHub, vEnd));
+			if(fNear <= gfVRTapReach)
+			{
+				mbVRTapHeld = true;
+				m_vVRTapPalmWas = vPalm;
+				mfVRTapHand = mfVRTapAngle;
+				// (The way a pull goes from here: back towards where the player stands, level, and down, 2 to 1.)
+				cVector3f vBack = pPlayer.GetCharacterBody().GetPosition() - vPalm;
+				vBack = vBack - vUp * cMath_Vector3Dot(vBack, vUp);
+				m_vVRTapPullWay = cMath_Vector3Normalize(cMath_Vector3Normalize(vBack) - vUp * 0.5f);
+
+				VRBuzzHand(0, 0.03f, 0.5f);
+				VRTapNote("the left hand takes the lever (" + int(fNear * 100.0f + 0.5f) + " cm from its handle; open " + int(mfVRTapAngle * 57.3f + 0.5f) + " degrees)");
+			}
+		}
+		else if(mbVRTapHeld && (bSqueeze == false || bPalm == false || (vPalm - m_mtxVRTapDrawn.GetTranslation()).Length() > gfVRTapSlip))
+		{
+			mbVRTapHeld = false;
+			VRTapNote("the left hand lets go of the lever (" + (bSqueeze ? "pulled away" : "let go") + ", open " + int(mfVRTapAngle * 57.3f + 0.5f) + " degrees): it springs shut");
+		}
+
+		// Turned by the hand's pull: opened by how far the hand has moved back towards the player and down since it took
+		// the lever (m_vVRTapPullWay), gfVRTapPullPerTurn per radian; pushed back, closed. A natural pull goes mostly
+		// along the lever towards the player and down (say 20 cm along and 11 cm down, with only 3 cm the way the knob
+		// swings), so the knob's swing alone would hardly turn it. Don't use the hand's angle about the hub either: the
+		// grip lies 7.7 cm from the hub, so that angle swings wildly as the hand passes it. Standing in front of the tap,
+		// the pull towards the player is the knob's own swing.
+		// Between shut and fully open the tap has weight: tight at first, then loose, then tight again as it closes.
+		// Shut, it gives only once the hand is gfVRTapBreak past it, then frees and catches the hand up; freed, it
+		// follows the hand gfVRTapFree behind (its friction); over its last gfVRTapSeat of closing it tightens, until at
+		// shut the hand is gfVRTapBreak past it, and it seats. The hand's turn is kept as where it would have the lever
+		// (mfVRTapHand), never further from where the lever goes than its tightness there.
+		if(mbVRTapHeld)
+		{
+			mfVRTapHand += cMath_Vector3Dot(vPalm - m_vVRTapPalmWas, m_vVRTapPullWay) / gfVRTapPullPerTurn;
+			m_vVRTapPalmWas = vPalm;
+			// Where the lever goes: freed by the hand far enough past it shut; seated again at shut.
+			if(mbVRTapFreed == false && mfVRTapHand > mfVRTapAngle + gfVRTapBreak)
+			{
+				mbVRTapFreed = true;
+				VRBuzzHand(0, 0.06f, 0.75f);
+				VRTapNote("the lever gives: freed");
+			}
+			float fWant = mfVRTapAngle;
+			float fOpenLag = mbVRTapFreed ? gfVRTapFree : gfVRTapBreak;
+			if(mfVRTapHand > mfVRTapAngle + fOpenLag) fWant = mfVRTapHand - fOpenLag;
+			else if(mfVRTapHand < mfVRTapAngle - VRTapCloseLag(mfVRTapAngle)) fWant = VRTapClosedTo(mfVRTapHand);
+			fWant = cMath_Clamp(fWant, 0.0f, gfVRTapOpen);
+			float fStep = gfVRTapFollow * afTimeStep;
+			mfVRTapAngle = cMath_Clamp(mfVRTapAngle + cMath_Clamp(fWant - mfVRTapAngle, -fStep, fStep), 0.0f, gfVRTapOpen);
+			if(mbVRTapFreed && fWant <= 0.0f && mfVRTapAngle <= 0.0f)
+			{
+				mbVRTapFreed = false;
+				VRBuzzHand(0, 0.06f, 0.6f);
+				VRTapNote("the lever is shut tight: seated");
+			}
+			mfVRTapHand = cMath_Clamp(mfVRTapHand, fWant - VRTapCloseLag(fWant), fWant + (mbVRTapFreed ? gfVRTapFree : gfVRTapBreak));
+			// The strain felt against its tightness (shut, or seating), growing with how far the hand is past it.
+			float fPast = cMath_Max(mfVRTapHand - mfVRTapAngle, mfVRTapAngle - mfVRTapHand) - gfVRTapFree;
+			float fStrain = cMath_Clamp(fPast / (gfVRTapBreak - gfVRTapFree), 0.0f, 1.0f);
+			mfVRTapStrainWait -= afTimeStep;
+			if(fStrain > 0.1f && mfVRTapStrainWait <= 0.0f)
+			{
+				mfVRTapStrainWait = 0.12f;
+				VRBuzzHand(0, 0.04f, 0.12f + 0.4f * fStrain);
+			}
+
+			// Drawn holding its handle as a closed fist, pulling it around rather than twisting it with the wrist, at
+			// gvVRTapHandAt (a place taken from a real hand posed on the handle). From the lever's other side, mirrored:
+			// its place moves to the lever's other side, and it is turned about the upright so that the wrist still comes
+			// from the player's side.
+			cVector3f vEndNow = vHub + cMath_MatrixMul3x3(BunkerVR_TurnBy(vUp * (gfVRTapTurnSign * mfVRTapAngle)), vShut);
+			cVector3f vAlongLever = VRFinaleLevel(vEndNow - vHub, vUp);
+			cVector3f vAcross = cMath_Vector3Cross(vAlongLever, vUp);
+			cVector3f vOut = cMath_Vector3Normalize(VRTapLeverWay(gvVRTapHandOut, vAlongLever, vUp, vAcross));
+			cVector3f vFinger = VRTapLeverWay(gvVRTapHandFinger, vAlongLever, vUp, vAcross);
+			vFinger = cMath_Vector3Normalize(vFinger - vOut * cMath_Vector3Dot(vFinger, vOut));
+			cVector3f vWrist = cMath_Vector3Cross(vOut, vFinger);
+			cVector3f vHandAt = gvVRTapHandAt;
+			if(VRTapSide(vHub, vAcross) < 0.0f)
+			{
+				vHandAt.z = -vHandAt.z;
+				cVector3f vWristFlat = VRFinaleLevel(vWrist, vUp);
+				cVector3f vMirror = vWristFlat - vAcross * (2.0f * cMath_Vector3Dot(vWristFlat, vAcross));
+				cMatrixf mtxSide = BunkerVR_TurnBy(vUp * BunkerVR_AngleAbout(vUp, vWristFlat, vMirror));
+				vOut = cMath_MatrixMul3x3(mtxSide, vOut);
+				vFinger = cMath_MatrixMul3x3(mtxSide, vFinger);
+				vWrist = cMath_MatrixMul3x3(mtxSide, vWrist);
+			}
+			// (The left palm's x out of its palm, y towards the first finger, z towards the wrist: set as rows, then turned
+			// over, as a matrix's SetRight, SetUp and SetForward set its rows.)
+			cMatrixf mtxRows = cMatrixf_Identity;
+			mtxRows.SetRight(vOut);
+			mtxRows.SetUp(vFinger);
+			mtxRows.SetForward(vWrist);
+			cMatrixf mtxHand = cMath_MatrixInverse(mtxRows);
+			mtxHand.SetTranslation(vHub + VRTapLeverWay(vHandAt, vAlongLever, vUp, vAcross));
+			VRLeftFitPublish(mtxHand);
+			VRHandFingers(0, gvVRFistFingers);
+			m_mtxVRTapDrawn = mtxHand;
+		}
+		// Let go, it springs shut, and is seated there again (tight to open again).
+		else if(mfVRTapAngle > 0.0f)
+		{
+			mfVRTapAngle = cMath_Max(0.0f, mfVRTapAngle - afTimeStep * gfVRTapOpen / gfVRTapCloseTime);
+			if(mfVRTapAngle <= 0.0f) mbVRTapFreed = false;
+		}
+		else mbVRTapFreed = false;
+
+		// A click in the hand every 10 degrees, a firmer one fully open.
+		if(mbVRTapHeld && cMath_Abs(mfVRTapAngle - mfVRTapTickAt) >= gfVRTapTick)
+		{
+			mfVRTapTickAt = mfVRTapAngle;
+			VRBuzzHand(0, 0.02f, 0.35f);
+		}
+		// (Once at the stop, until it has come back 3 degrees: otherwise the hand's own tremble at the stop would click
+		// every frame.)
+		if(mbVRTapFullyOpen == false && mfVRTapAngle >= gfVRTapOpen)
+		{
+			mbVRTapFullyOpen = true;
+			mfVRTapTickAt = mfVRTapAngle;
+			VRBuzzHand(0, 0.05f, 0.6f);
+			VRTapNote("the lever is fully open");
+		}
+		else if(mbVRTapFullyOpen && mfVRTapAngle < gfVRTapOpen - 0.05f) mbVRTapFullyOpen = false;
+		if(mfVRTapAngle <= 0.0f) mfVRTapTickAt = 0.0f;
+
+		// The lever posed as it stands (its bone turned about its own upright).
+		if(cMath_Abs(mfVRTapAngle - mfVRTapAngleSet) > 0.002f)
+		{
+			mfVRTapAngleSet = mfVRTapAngle;
+			cBoneState@ pLever = pTapMesh !is null ? pTapMesh.GetBoneStateFromName("j_lever") : null;
+			if(pLever !is null)
+			{
+				pLever.SetUsePreTransform(true);
+				pLever.SetPreTransform(VRTapLeverTurn(gfVRTapTurnSign * mfVRTapAngle));
+			}
+		}
+
+		// The fuel runs from far enough open.
+		bool bRuns = mfVRTapAngle >= gfVRTapRuns;
+		if(bRuns != mbVRTapRunning)
+		{
+			mbVRTapRunning = bRuns;
+			mfVRTapStreamWait = 0.0f;
+			VRTapNote(bRuns ? "the fuel runs from the spout" : "the fuel stops");
+		}
+
+		// An empty bottle (or empty molotov) in the right hand, upright, its neck under the spout?
+		cVector3f vSpout = cMath_MatrixMul(mtxTap, gvVRTapSpout);
+		tString sHeld = Item_GetHeldType(eItemHandlerHand_Right);
+		tString sBottle = (sHeld == "EmptyBottle" || sHeld == "EmptyMolotovCocktail") ? Item_GetHeldEntity(eItemHandlerHand_Right) : "";
+		// (One used full is not filled again in the moment before the map swaps it for a full one.)
+		if(sBottle != msVRTapUsed) msVRTapUsed = "";
+		else sBottle = "";
+		cLuxProp@ pBottle = sBottle != "" ? cLux_ToProp(pMap.GetEntityByName(sBottle)) : null;
+		bool bUnder = false;
+		if(pBottle !is null)
+		{
+			cMatrixf mtxBottle = pBottle.GetMatrix();
+			cVector3f vNeck = cMath_MatrixMul(mtxBottle, gvVRBottleOpening);
+			cVector3f vBottleUp = cMath_MatrixMul3x3(mtxBottle, cVector3f(0.0f, 1.0f, 0.0f));
+			vBottleUp.Normalize();
+			cVector3f vDrop = vSpout - vNeck;
+			float fAcross = cMath_Sqrt(vDrop.x * vDrop.x + vDrop.z * vDrop.z);
+			bUnder = vBottleUp.y >= gfVRTapUpright && vDrop.y >= -0.02f && vDrop.y <= gfVRTapBelow && fAcross <= gfVRTapUnder;
+		}
+		if(sBottle != msVRTapBottle)
+		{
+			msVRTapBottle = sBottle;
+			mfVRTapFill = 0.0f;
+		}
+		if(bRuns == false) return;
+
+		// Running: the stream from the spout, a quarter of a second of it at a time (as the pour's).
+		mfVRTapStreamWait -= afTimeStep;
+		bool bStream = mfVRTapStreamWait <= 0.0f;
+		if(bStream)
+		{
+			mfVRTapStreamWait = gfVRPourStreamGap;
+			mlVRPourStreams++;
+			cParticleSystem@ pStream = pTap.CreateParticleSystem("VRTap_" + mlVRPourStreams, gsVRPourStream, true, false);
+			if(pStream !is null)
+			{
+				cMatrixf mtxStream = cMatrixf_Identity; // (upright: it falls straight down)
+				mtxStream.SetTranslation(vSpout);
+				pStream.SetWorldMatrix(mtxStream);
+			}
+		}
+		if(bUnder == false) return;
+
+		// Into the bottle: full after gfVRTapFill of it, then used on the tap as the game's use button would.
+		if(mfVRTapFill <= 0.0f)
+		{
+			Sound_CreateAtEntity("VRTapFill", gsVRTapFillSound, sBottle);
+			VRTapNote("the fuel runs into the " + sHeld + " under the spout");
+		}
+		mfVRTapFill += afTimeStep;
+		if(bStream) VRBuzzHand(1, 0.03f, 0.15f + 0.35f * cMath_Min(1.0f, mfVRTapFill / gfVRTapFill));
+		if(mfVRTapFill < gfVRTapFill) return;
+		mfVRTapFill = 0.0f;
+		msVRTapBottle = "";
+		if(Item_GetCanUseOnWorld(eItemHandlerHand_Right, "Trigger_FuelBottleFiller") == false)
+		{
+			VRTapNote("the " + sHeld + " is full, but this map cannot use it on the tap (no CanUse_EmptyBottle for it)");
+			return;
+		}
+		VRBuzzHand(1, 0.06f, 0.7f);
+		VRTapNote("the " + sHeld + " is full: used on the tap (the game's own use)");
+		cVR_HintUsed("tap_turn");
+		msVRTapUsed = sBottle;
+		Item_UseHeldOnWorld(eItemHandlerHand_Right, "Trigger_FuelBottleFiller");
+	}
+
+
+	// How far behind the hand the fuel tap's lever goes closing, where it stands (afAngle, radians open): its friction,
+	// and over its last gfVRTapSeat tighter and tighter, to gfVRTapBreak at shut.
+	float VRTapCloseLag(float afAngle)
+	{
+		return gfVRTapFree + (gfVRTapBreak - gfVRTapFree) * cMath_Clamp(1.0f - afAngle / gfVRTapSeat, 0.0f, 1.0f);
+	}
+
+	// Where the lever goes closing with the hand at afHand (where it would have it): afHand + VRTapCloseLag of where it
+	// goes, worked out (over its last gfVRTapSeat the lag grows as it closes).
+	float VRTapClosedTo(float afHand)
+	{
+		float fFree = afHand + gfVRTapFree;
+		if(fFree >= gfVRTapSeat) return fFree;
+		return (afHand + gfVRTapBreak) / (1.0f + (gfVRTapBreak - gfVRTapFree) / gfVRTapSeat);
+	}
+
+	// The lever's turn about its own upright as the engine poses it (afAngle right-handed, as BunkerVR_TurnBy's): the
+	// engine's cMath_MatrixRotateY counts the other way around if its turn of x by a radian is not BunkerVR_TurnBy's.
+	cMatrixf VRTapLeverTurn(float afAngle)
+	{
+		cVector3f vEngine = cMath_MatrixMul3x3(cMath_MatrixRotateY(1.0f), cVector3f(1.0f, 0.0f, 0.0f));
+		cVector3f vRight = cMath_MatrixMul3x3(BunkerVR_TurnBy(cVector3f(0.0f, 1.0f, 0.0f)), cVector3f(1.0f, 0.0f, 0.0f));
+		return cMath_MatrixRotateY(cMath_Vector3Dot(vEngine, vRight) > 0.9f ? afAngle : -afAngle);
+	}
+
+	// BunkerVR, for testing (script 89): the fuel tap's state as the hands work it, in the mod's own log
+	// (readable while the game runs): its lever's angle and hold, the fuel, the places of its hub, spout and handle's
+	// end, its lever bone's own x as posed (to check the pose turns the way the handle is reckoned), and the right
+	// hand's item, its neck and the right palm.
+	void VRStandInTap()
+	{
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		tString sHeld = Item_GetHeldType(eItemHandlerHand_Right);
+		cLuxProp@ pBottle = pMap !is null ? cLux_ToProp(pMap.GetEntityByName(Item_GetHeldEntity(eItemHandlerHand_Right))) : null;
+		cVector3f vNeck = pBottle !is null ? cMath_MatrixMul(pBottle.GetMatrix(), gvVRBottleOpening) : cVector3f(0.0f);
+		cMatrixf mtxPalm;
+		float fArmScale;
+		cVector3f vPalm = BunkerVR_ReadFollowedPalm(1, mtxPalm, fArmScale) ? mtxPalm.GetTranslation() : cVector3f(0.0f);
+		cLuxProp@ pTap = cLux_ID_Prop(m_idVRTap);
+		if(pTap is null)
+		{
+			cVR_Say("tap: none near; the right hand holds '" + sHeld + "'");
+			return;
+		}
+		cMatrixf mtxTap = pTap.GetMatrix();
+		cVector3f vUp = cMath_MatrixMul3x3(mtxTap, cVector3f(0.0f, 1.0f, 0.0f));
+		vUp.Normalize();
+		cVector3f vHub = cMath_MatrixMul(mtxTap, gvVRTapHub);
+		cVector3f vShut = cMath_MatrixMul(mtxTap, gvVRTapHandleEnd) - vHub;
+		cVector3f vEnd = vHub + cMath_MatrixMul3x3(BunkerVR_TurnBy(vUp * (gfVRTapTurnSign * mfVRTapAngle)), vShut);
+		cMeshEntity@ pMesh = pTap.GetMeshEntity();
+		cBoneState@ pLever = pMesh !is null ? pMesh.GetBoneStateFromName("j_lever") : null;
+		cVector3f vLeverX = pLever !is null ? cMath_MatrixMul3x3(pLever.GetWorldMatrix(), cVector3f(1.0f, 0.0f, 0.0f)) : cVector3f(0.0f);
+
+		cLuxProp@ pBody = cLux_ID_Prop(m_idBody);
+		cMeshEntity@ pBodyMesh = pBody !is null ? pBody.GetMeshEntity() : null;
+		cBoneState@ pSocket = pBodyMesh !is null ? pBodyMesh.GetBoneStateFromName("j_L_HandSocket") : null;
+		float fDrawnOff = mbVRTapHeld && pSocket !is null ? (pSocket.GetWorldPosition() - m_mtxVRTapDrawn.GetTranslation()).Length() : -1.0f;
+		float fFromRod = mbVRTapHeld ? BunkerVR_DistanceToSegment(m_mtxVRTapDrawn.GetTranslation(), vHub, vEnd) : -1.0f;
+		cVR_Say("tap: " + pTap.GetName() + " open " + int(mfVRTapAngle * 57.3f + 0.5f) + " degrees, the hand at " + int(mfVRTapHand * 57.3f + (mfVRTapHand < 0.0f ? -0.5f : 0.5f)) +
+			", freed " + (mbVRTapFreed ? "yes" : "no") + ", the left hand drawn " + BunkerVR_Fixed(fDrawnOff * 100.0f, 1) + " cm from its place on the handle, its palm " +
+			BunkerVR_Fixed(fFromRod * 100.0f, 1) + " cm from the rod, held " + (mbVRTapHeld ? "yes" : "no") +
+			", runs " + (mbVRTapRunning ? "yes" : "no") + ", fill " + BunkerVR_Fixed(mfVRTapFill, 2) + "; hub " + VRTapText(vHub) +
+			"; spout " + VRTapText(cMath_MatrixMul(mtxTap, gvVRTapSpout)) + "; handle end " + VRTapText(vEnd) + "; lever bone x " + VRTapText(vLeverX) +
+			"; the right hand holds '" + sHeld + "', its neck " + VRTapText(vNeck) + ", the right palm " + VRTapText(vPalm));
+	}
+
+	// BunkerVR, for testing (script 92): thin upright pins (the test map's plain blocks) standing on the fuel tap's
+	// points as reckoned, its lever's hub (tall) and its handle's knob as it turns (short), to compare in a picture
+	// with the tap as drawn (a mismatch shows the reckoned handle ahead of or behind the drawn lever).
+	void VRStandInTapPins()
+	{
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		cLuxProp@ pTap = cLux_ID_Prop(m_idVRTap);
+		if(pMap is null || pTap is null)
+		{
+			cVR_Say("tap pins: no tap near");
+			return;
+		}
+		cMatrixf mtxTap = pTap.GetMatrix();
+		cVector3f vHub = cMath_MatrixMul(mtxTap, gvVRTapHub);
+		cVector3f vUp = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxTap, cVector3f(0.0f, 1.0f, 0.0f)));
+		cVector3f vEnd = vHub + cMath_MatrixMul3x3(BunkerVR_TurnBy(vUp * (gfVRTapTurnSign * mfVRTapAngle)), cMath_MatrixMul(mtxTap, gvVRTapHandleEnd) - vHub);
+		if(pMap.GetEntityByName("VRTapPin_Hub") is null) pMap.CreateEntity("VRTapPin_Hub", "blockout_box_blank.ent", cMath_MatrixTranslate(vHub), cVector3f(0.008f, 0.30f, 0.008f));
+		if(pMap.GetEntityByName("VRTapPin_Knob") is null) pMap.CreateEntity("VRTapPin_Knob", "blockout_box_blank.ent", cMath_MatrixTranslate(vEnd), cVector3f(0.008f, 0.15f, 0.008f));
+		cVR_Say("tap pins: the hub " + VRTapText(vHub) + ", the handle's knob " + VRTapText(vEnd));
+
+	}
+
+	tString VRTapText(const cVector3f &in avAt)
+	{
+		return BunkerVR_Fixed(avAt.x, 3) + " " + BunkerVR_Fixed(avAt.y, 3) + " " + BunkerVR_Fixed(avAt.z, 3);
+	}
+
+	void VRTapNote(const tString &in asWhat)
+	{
+		if(mlVRTapNotes >= 60) return;
+		mlVRTapNotes++;
+		Log("BunkerVR fuel tap: " + asWhat + "\n");
+	}
+
+	// BunkerVR: the finale by hand: the player sets up the dynamite and the detonator with their own hands instead of
+	// watching cutscenes. The levels' side is helper_bunkervr_finale.hps. At the exit (officer_hub's, or the item test
+	// map's, laid out alike and found by the detonator's name), each update:
+	// - the detonator handle in the right hand, brought within 12 cm of where its T-bar stands, goes in (the game's own
+	//   use of it on Detonator_Proxy; the level then shows the T-bar up on its rod);
+	// - its two wing nuts are each pinched by a free hand (the trigger, or the grip) and turned right (clockwise from
+	//   above) a full turn with the wrist, the hand drawn pinching it, the nut turning with it, a click every 30 degrees
+	//   and a firmer one when it is tight; both tight, the level is told (BunkerVR_FinaleTight);
+	// - the dynamite bundle in the right hand, brought within 15 cm of its place, is set down there (its use on
+	//   Trigger_DynamiteBundleSlot);
+	// - then the cord: the game's short cable by the bundle is swapped for a rope of the engine's own (its physics: it
+	//   lies, sags and swings, 2.1 m long from where the cable leaves the floor), whose free end a free hand pinches and
+	//   carries; it can't be drawn further from where it starts than its length, so it never stretches (beyond that it
+	//   slips from the fingers); brought within 5 cm of the bundle's terminal, it clicks on there (BunkerVR_FinaleCabled)
+	//   and stays;
+	// - with the nuts tight, the T-bar is taken in both fists, one at each end, drawn closed around it; it gives only to
+	//   both hands pressing at least 2 cm past it, and follows them as a heavy plunger does (the further they press, the
+	//   faster, up to 3 m/s; the push's own animation held at its depth, a straining buzz); at the bottom the level is
+	//   told whether it came through the last 6 cm at 0.8 m/s or more (BunkerVR_FinalePushed): with all done, that fires
+	//   it; too slowly, or not all done, a clunk (sparks with no dynamite on the cable). Pulled up again, a new push counts.
+	// A hand at work there is drawn on what it holds (VRFinaleDrawHand, the fingers asked for: VRHandFingers), moved by
+	// where the real hand is (the drawn one is held back off solid things, the detonator's box among them). Where each is
+	// to be done, its hint (VRUpdateHints). Every step logged ("BunkerVR finale:" in hpl.log, the first 80).
+	void VRUpdateFinale(float afTimeStep)
+	{
+		mvVRFinaleHintKey[0] = "";
+		mvVRFinaleHintKey[1] = "";
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		if(pMap is null || pPlayer is null) return;
+
+		// The exit: its detonator looked for again once a second.
+		float fNow = float(cEngine_GetGameTime());
+		if(fNow - mfVRFinaleListTime > 1.0f || fNow < mfVRFinaleListTime)
+		{
+			mfVRFinaleListTime = fNow;
+			iLuxEntity@ pFound = pMap.GetEntityByName("Detonator_Animated");
+			tID idFound = pFound !is null ? pFound.GetID() : tID_Invalid;
+			if(idFound != m_idVRFinaleDet)
+			{
+				m_idVRFinaleDet = idFound;
+				VRFinaleLetGo();
+				mvVRFinaleNutTurn[0] = 0.0f;
+				mvVRFinaleNutTurn[1] = 0.0f;
+				mfVRFinaleDrop = 0.0f;
+				mbVRFinaleBarUp = true;
+				mlVRFinaleStateWas = -1;
+				msVRFinaleCord = ""; // (a level's own rope goes with the level)
+			}
+		}
+		cLuxProp@ pDet = cLux_ID_Prop(m_idVRFinaleDet);
+		if(pDet is null) return;
+		int lState = cScript_GetGlobalVarInt("BunkerVR_Finale");
+		if(lState != mlVRFinaleStateWas)
+		{
+			// (The level has just shown a new state, or the exit was set up again: what the hands held of the old let go.)
+			if(mlVRFinaleStateWas >= 0 && (lState & glBunkerVR_FinaleHandle) == 0)
+			{
+				mvVRFinaleNutTurn[0] = 0.0f;
+				mvVRFinaleNutTurn[1] = 0.0f;
+				mfVRFinaleDrop = 0.0f;
+				mbVRFinaleBarUp = true;
+			}
+			// (The rope only while the cord is to be laid or lies on: gone with the blast, or the bundle gone again.)
+			if((lState & glBunkerVR_FinaleFired) != 0 || (lState & glBunkerVR_FinaleBundle) == 0) VRFinaleCordGone((lState & glBunkerVR_FinaleFired) == 0);
+			// (Shown again as the hands have them: the level's showing of its state holds its own first frames.)
+			mfVRFinaleDropShown = -1.0f;
+			mvVRFinaleNutShown[0] = -1.0f;
+			mvVRFinaleNutShown[1] = -1.0f;
+			mlVRFinaleStateWas = lState;
+			VRFinaleLetGo();
+		}
+		if((lState & glBunkerVR_FinaleFired) != 0) return;
+		iLuxEntity@ pCable = pMap.GetEntityByName("DynamiteFuse");
+		iLuxEntity@ pPlace = pMap.GetEntityByName("Detonator_DynamiteBundle");
+		cMatrixf mtxDet = pDet.GetMatrix();
+		cVector3f vUp = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxDet, cVector3f(0.0f, 1.0f, 0.0f)));
+		cVector3f vBody = pPlayer.GetCharacterBody().GetPosition();
+		bool bNearDet = (vBody - mtxDet.GetTranslation()).Length() <= gfVRFinaleNear;
+		bool bNearSlot = pCable !is null && (vBody - pCable.GetPosition()).Length() <= gfVRFinaleNear;
+		// (Not near either, and nothing held there: nothing to do. The hub is the game's central level and its detonator is
+		// always there, so this keeps the hands from being read every update all over it. A rope there is the engine's to
+		// move.)
+		if(bNearDet == false && bNearSlot == false && mlVRFinaleNutHand < 0 && mlVRFinaleCordHand < 0 && mlVRFinaleBarHands == 0 &&
+		   (msVRFinaleCord == "" || mlVRFinaleCordStill >= glVRFinaleCordRest))
+			return;
+
+		// The hands: palms (where they really are), squeezes and triggers (a fresh one takes hold), free of the game's items.
+		for(int h = 0; h < 2; ++h)
+		{
+			float fArmScale;
+			mvVRFinalePalmKnown[h] = BunkerVR_ReadFollowedPalm(h, m_mtxVRFinalePalm[h], fArmScale);
+			// (Where the hand really is: the drawn one is held back off solid things, the detonator's box among them, and the
+			// T-bar is pushed down into it. A hand holding something here is drawn on it instead: VRFinaleDrawHand.)
+			cVector3f vBack = cScript_GetGlobalVarVector3f(h == 0 ? "BunkerVR_HandBack0" : "BunkerVR_HandBack1");
+			if(mvVRFinalePalmKnown[h] && vBack.Length() < 0.6f) m_mtxVRFinalePalm[h].SetTranslation(m_mtxVRFinalePalm[h].GetTranslation() - vBack);
+			bool bSqueeze = BunkerVR_HandCurl(h) > (mvVRFinaleSqueezeWas[h] ? gfVRLidLetGo : gfVRLidSqueeze);
+			mvVRFinaleFresh[h] = bSqueeze && mvVRFinaleSqueezeWas[h] == false;
+			mvVRFinaleSqueezeWas[h] = bSqueeze;
+			// (A pinch: the trigger, the first finger's; or the grip.)
+			bool bTrigger = cVR_HandTrigger(h) > (mvVRFinaleTriggerWas[h] ? gfVRFinaleTriggerLetGo : gfVRFinaleTriggerPress);
+			mvVRFinalePinchFresh[h] = (bTrigger && mvVRFinaleTriggerWas[h] == false) || mvVRFinaleFresh[h];
+			mvVRFinaleTriggerWas[h] = bTrigger;
+			mvVRFinalePinching[h] = bTrigger || bSqueeze;
+			mvVRFinaleFree[h] = Item_GetHeldType(h == 0 ? eItemHandlerHand_Left : eItemHandlerHand_Right) == "";
+			if(mvVRFinalePalmKnown[h]) VRFinaleReadPinch(h);
+		}
+
+		// 1. The handle into the detonator.
+		cVector3f vBarUp = cMath_MatrixMul(mtxDet, gvVRFinaleRod);
+		if((lState & glBunkerVR_FinaleHandle) == 0)
+		{
+			if(bNearDet && Item_GetHeldType(eItemHandlerHand_Right) == "DetonatorHandle")
+			{
+				mvVRFinaleHintKey[1] = "det_fit";
+				mvVRFinaleHintAt[1] = vBarUp;
+				iLuxEntity@ pHandle = pMap.GetEntityByName(Item_GetHeldEntity(eItemHandlerHand_Right));
+				float fOff = pHandle !is null ? (pHandle.GetPosition() - vBarUp).Length() : 100.0f;
+				if(fOff <= gfVRFinaleFitReach && VRFinaleCanUse("handle", "Detonator_Proxy", fNow))
+				{
+					mfVRFinaleUsedAt = fNow;
+					VRBuzzHand(1, 0.06f, 0.7f);
+					cVR_HintUsed("det_fit");
+					VRFinaleNote("the handle is brought to the detonator (" + int(fOff * 100.0f + 0.5f) + " cm from where it stands fitted): it goes in (the game's own use)");
+					Item_UseHeldOnWorld(eItemHandlerHand_Right, "Detonator_Proxy");
+				}
+			}
+		}
+		// 2. Its wing nuts done up.
+		else if((lState & glBunkerVR_FinaleTight) == 0)
+			VRFinaleNuts(mtxDet, vUp, bNearDet, fNow);
+
+		// 3. The bundle set down at its place.
+		if((lState & glBunkerVR_FinaleBundle) == 0)
+		{
+			if(bNearSlot && pPlace !is null && Item_GetHeldType(eItemHandlerHand_Right) == "DynamiteBundle")
+			{
+				cVector3f vPlace = pPlace.GetPosition();
+				mvVRFinaleHintKey[1] = "dyn_place";
+				mvVRFinaleHintAt[1] = vPlace;
+				iLuxEntity@ pHeld = pMap.GetEntityByName(Item_GetHeldEntity(eItemHandlerHand_Right));
+				float fOff = pHeld !is null ? (pHeld.GetPosition() - vPlace).Length() : 100.0f;
+				if(fOff <= gfVRFinalePlaceReach && VRFinaleCanUse("bundle", "Trigger_DynamiteBundleSlot", fNow))
+				{
+					mfVRFinaleUsedAt = fNow;
+					VRBuzzHand(1, 0.08f, 0.6f);
+					cVR_HintUsed("dyn_place");
+					VRFinaleNote("the bundle is brought to its place (" + int(fOff * 100.0f + 0.5f) + " cm from it): set down (the game's own use)");
+					Item_UseHeldOnWorld(eItemHandlerHand_Right, "Trigger_DynamiteBundleSlot");
+				}
+			}
+		}
+		// 4. The cord laid on it (and the rope kept while it lies on, until the blast).
+		else if(pCable !is null)
+			VRFinaleCord(pCable, bNearSlot, (lState & glBunkerVR_FinaleCable) != 0, afTimeStep);
+
+		// 5. The push.
+		if((lState & glBunkerVR_FinaleTight) != 0)
+			VRFinalePush(pDet, mtxDet, vUp, bNearDet, lState, vBody, fNow, afTimeStep);
+	}
+
+	// The wing nuts: pinched, turned right a full turn each about their upright with the wrist, posed on their bones as
+	// they turn (the same way as the wrist).
+	void VRFinaleNuts(const cMatrixf &in a_mtxDet, const cVector3f &in avUp, bool abNear, float afNow)
+	{
+		cLuxProp@ pDet = cLux_ID_Prop(m_idVRFinaleDet);
+		cMeshEntity@ pMesh = pDet !is null ? pDet.GetMeshEntity() : null;
+		array<cVector3f> vNut = { cMath_MatrixMul(a_mtxDet, gvVRFinaleNut0), cMath_MatrixMul(a_mtxDet, gvVRFinaleNut1) };
+		if(mlVRFinaleNutHand < 0)
+		{
+			// A free hand's fresh pinch with its pinch (thumb and first finger) at a loose nut takes it.
+			for(int h = 0; h < 2 && mlVRFinaleNutHand < 0; ++h)
+			{
+				if(mvVRFinalePinchFresh[h] == false || mvVRFinaleFree[h] == false || mvVRFinalePalmKnown[h] == false || abNear == false) continue;
+				for(int n = 0; n < 2; ++n)
+				{
+					if(mvVRFinaleNutTurn[n] >= gfVRFinaleNutTurn) continue;
+					float fNear = (VRFinalePinchAt(h) - vNut[n]).Length();
+					if(fNear > gfVRFinaleNutReach) continue;
+					mlVRFinaleNutHand = h;
+					mlVRFinaleNut = n;
+					m_mtxVRFinaleNutPalmWas = m_mtxVRFinalePalm[h];
+					mfVRFinaleNutTickAt = mvVRFinaleNutTurn[n];
+					VRBuzzHand(h, 0.03f, 0.45f);
+					VRFinaleNote("the " + (h == 0 ? "left" : "right") + " hand pinches wing nut " + (n + 1) + " (" + int(fNear * 100.0f + 0.5f) + " cm from it; done up " +
+								 int(cMath_ToDeg(mvVRFinaleNutTurn[n]) + 0.5f) + " degrees)");
+					break;
+				}
+			}
+		}
+		else
+		{
+			int h = mlVRFinaleNutHand;
+			int n = mlVRFinaleNut;
+			// (A frame with the hand not tracked keeps hold, as a lost hand stays where it was.)
+			if(mvVRFinalePinching[h] == false || (mvVRFinalePalmKnown[h] && (VRFinalePinchAt(h) - vNut[n]).Length() > gfVRFinaleSlip))
+			{
+				VRFinaleNote("the " + (h == 0 ? "left" : "right") + " hand lets go of wing nut " + (n + 1) + " (done up " + int(cMath_ToDeg(mvVRFinaleNutTurn[n]) + 0.5f) + " degrees)");
+				mlVRFinaleNutHand = -1;
+			}
+			else
+			{
+				// The wrist's turn about the nut's upright since the last update, right (clockwise from above) doing it up;
+				// the other way undoes it, no further than loose.
+				if(mvVRFinalePalmKnown[h])
+				{
+					mvVRFinaleNutTurn[n] = cMath_Clamp(mvVRFinaleNutTurn[n] - VRFinaleWristTurn(m_mtxVRFinaleNutPalmWas, m_mtxVRFinalePalm[h], avUp), 0.0f, gfVRFinaleNutTurn);
+					m_mtxVRFinaleNutPalmWas = m_mtxVRFinalePalm[h];
+				}
+				if(cMath_Abs(mvVRFinaleNutTurn[n] - mfVRFinaleNutTickAt) >= gfVRFinaleNutTick)
+				{
+					mfVRFinaleNutTickAt = mvVRFinaleNutTurn[n];
+					VRBuzzHand(h, 0.02f, 0.3f);
+				}
+				if(mvVRFinaleNutTurn[n] >= gfVRFinaleNutTurn)
+				{
+					VRBuzzHand(h, 0.06f, 0.75f);
+					VRFinaleNote("wing nut " + (n + 1) + " is tight");
+					mlVRFinaleNutHand = -1;
+					if(mvVRFinaleNutTurn[1 - n] >= gfVRFinaleNutTurn)
+					{
+						cVR_HintUsed("det_nut");
+						VRFinaleNote("both wing nuts are tight: the handle is fixed in (the level told)");
+						VRFinaleTell("BunkerVR_FinaleTight", -1);
+					}
+				}
+				// Drawn pinching it: its pinch on the nut, turned as the real hand is.
+				if(mlVRFinaleNutHand >= 0)
+				{
+					VRFinaleDrawHand(h, VRFinalePinchHand(h, vNut[n]));
+					VRHandFingers(h, gvVRFinalePinchFingers);
+				}
+			}
+		}
+		// Each nut posed as far as it is done up, turning the way the wrist turns it (clockwise from above). A full turn is
+		// its own pose again: the game's, tight.
+		for(int n = 0; n < 2; ++n)
+		{
+			if(cMath_Abs(mvVRFinaleNutTurn[n] - mvVRFinaleNutShown[n]) < 0.002f) continue;
+			mvVRFinaleNutShown[n] = mvVRFinaleNutTurn[n];
+			cBoneState@ pBone = pMesh !is null ? pMesh.GetBoneStateFromName(n == 0 ? "j_wing_screw_01" : "j_wing_screw_02") : null;
+			if(pBone is null) continue;
+			pBone.SetUsePreTransform(true);
+			pBone.SetPreTransform(VRTapLeverTurn(gfVRFinaleNutSense * (gfVRFinaleNutTurn - mvVRFinaleNutTurn[n])));
+		}
+		// The hint: at the nearer loose nut, for a free hand near the detonator.
+		for(int h = 0; h < 2; ++h)
+		{
+			if(abNear == false || mvVRFinaleFree[h] == false || mvVRFinalePalmKnown[h] == false || mlVRFinaleNutHand >= 0) continue;
+			int lBest = -1;
+			float fBest = 100.0f;
+			for(int n = 0; n < 2; ++n)
+			{
+				if(mvVRFinaleNutTurn[n] >= gfVRFinaleNutTurn) continue;
+				float fNear = (VRFinalePinchAt(h) - vNut[n]).Length();
+				if(fNear < fBest)
+				{
+					fBest = fNear;
+					lBest = n;
+				}
+			}
+			if(lBest < 0 || mvVRFinaleHintKey[h] != "") continue;
+			mvVRFinaleHintKey[h] = "det_nut";
+			mvVRFinaleHintAt[h] = vNut[lBest];
+		}
+	}
+
+	// How far a hand has turned about an upright from one placing of it to the next (radians, + anticlockwise from
+	// above), for the wing nuts: on whichever of its own three lines lies most level in both, the same line then and now
+	// (a hand over a nut, palm down, has its x upright; no line is swapped for another part way through, which would
+	// jump). (Its true axes, where the matrix takes them: a matrix's GetRight and GetForward are its rows, which on a
+	// turned hand turn the other way round, so using them would do the nuts up with a left twist.)
+	float VRFinaleWristTurn(const cMatrixf &in a_mtxWas, const cMatrixf &in a_mtxNow, const cVector3f &in avUp)
+	{
+		float fLevelBest = 0.3f; // (a line nearer upright than this in either says nothing)
+		float fTurn = 0.0f;
+		for(int a = 0; a < 3; ++a)
+		{
+			cVector3f vAxis = cVector3f(a == 0 ? 1.0f : 0.0f, a == 1 ? 1.0f : 0.0f, a == 2 ? 1.0f : 0.0f);
+			cVector3f vWas = cMath_MatrixMul3x3(a_mtxWas, vAxis);
+			cVector3f vNow = cMath_MatrixMul3x3(a_mtxNow, vAxis);
+			vWas = vWas - avUp * cMath_Vector3Dot(vWas, avUp);
+			vNow = vNow - avUp * cMath_Vector3Dot(vNow, avUp);
+			float fLevel = cMath_Min(vWas.Length(), vNow.Length());
+			if(fLevel <= fLevelBest) continue;
+			fLevelBest = fLevel;
+			fTurn = BunkerVR_AngleAbout(avUp, vWas, vNow);
+		}
+		return fTurn;
+	}
+
+	// A direction made level (square to an upright), of length 1.
+	cVector3f VRFinaleLevel(const cVector3f &in avDir, const cVector3f &in avUp)
+	{
+		return cMath_Vector3Normalize(avDir - avUp * cMath_Vector3Dot(avDir, avUp));
+	}
+
+	// Where a hand's pinch is (between the thumb's pad and the first finger's tip), in the palm's own terms, read from the
+	// drawn hand's bones as they are (the drawn palm is where this script last put it while holding, or the real one);
+	// kept between reads (the bones are posed only while drawn).
+	void VRFinaleReadPinch(int alHand)
+	{
+		cLuxProp@ pBody = cLux_ID_Prop(m_idBody);
+		cMeshEntity@ pMesh = pBody !is null ? pBody.GetMeshEntity() : null;
+		if(pMesh is null) return;
+		tString sSide = alHand == 0 ? "L" : "R";
+		cBoneState@ pIndexA = pMesh.GetBoneStateFromName("j_" + sSide + "_Index_3");
+		cBoneState@ pIndexB = pMesh.GetBoneStateFromName("j_" + sSide + "_Index_4");
+		cBoneState@ pThumb = pMesh.GetBoneStateFromName("j_" + sSide + "_Thumb_3");
+		if(pIndexA is null || pIndexB is null || pThumb is null) return;
+		cVector3f vIndexPad = pIndexA.GetWorldPosition() + (pIndexB.GetWorldPosition() - pIndexA.GetWorldPosition()) * 0.6f;
+		cVector3f vPinch = (vIndexPad + pThumb.GetWorldPosition()) * 0.5f;
+		// (Only from a hand drawn holding something here in each of the last updates, still: the bones are posed where it
+		// was drawn the update before, and a hand just taken hold, or moving, is somewhere else in them. Eased in.)
+		bool bSteady = mvVRFinaleDrawnFresh[alHand] && mvVRFinaleDrawnRuns[alHand] >= 3 &&
+					   (m_mtxVRFinaleDrawn[alHand].GetTranslation() - m_mtxVRFinaleDrawnWas[alHand].GetTranslation()).Length() < 0.004f;
+		if(bSteady)
+		{
+			cVector3f vOff = cMath_MatrixMul(cMath_MatrixInverse(m_mtxVRFinaleDrawnWas[alHand]), vPinch);
+			if(vOff.Length() < 0.15f) mvVRFinalePinchOff[alHand] = mvVRFinalePinchOff[alHand] + (vOff - mvVRFinalePinchOff[alHand]) * 0.3f;
+		}
+		if(mvVRFinaleDrawnFresh[alHand] == false) mvVRFinaleDrawnRuns[alHand] = 0;
+		mvVRFinaleDrawnFresh[alHand] = false;
+	}
+
+	// Where a hand's pinch is now, as the real hand is placed.
+	cVector3f VRFinalePinchAt(int alHand)
+	{
+		return cMath_MatrixMul(m_mtxVRFinalePalm[alHand], mvVRFinalePinchOff[alHand]);
+	}
+
+	// The hand drawn turned as the real one is, placed so that its pinch is at a point.
+	cMatrixf VRFinalePinchHand(int alHand, const cVector3f &in avAt)
+	{
+		cMatrixf mtxHand = m_mtxVRFinalePalm[alHand];
+		mtxHand.SetTranslation(avAt - cMath_MatrixMul3x3(mtxHand, mvVRFinalePinchOff[alHand]));
+		return mtxHand;
+	}
+
+	// A hand at work at the exit drawn as it holds what it holds (the fitted hand of the keys and the cutters,
+	// VRFittedHand and VRFittedLeftHand in Prop_PlayerBody.hps; not drawn so after 3 updates without this): not stopped
+	// by the detonator's box, moving with what it holds.
+	void VRFinaleDrawHand(int alHand, const cMatrixf &in a_mtxHand)
+	{
+		if(alHand == 1)
+		{
+			VRFitPublish(a_mtxHand, a_mtxHand);
+			cVR_RightFitted(); // (the right squeeze is the hold's, not the game's use button: as the fit's)
+		}
+		else VRLeftFitPublish(a_mtxHand);
+		m_mtxVRFinaleDrawnWas[alHand] = m_mtxVRFinaleDrawn[alHand];
+		m_mtxVRFinaleDrawn[alHand] = a_mtxHand;
+		mvVRFinaleDrawnFresh[alHand] = true;
+		mvVRFinaleDrawnRuns[alHand]++;
+	}
+
+	// A hand's fingers asked of the body (thumb, first finger, the rest: 0 open to 1 closed) while it is drawn holding
+	// something (the finale's nuts, cord and T-bar; the fuel tap's lever): read in Prop_PlayerBody.hps,
+	// "BunkerVR_HandFingers0/1", for as long as they keep being asked.
+	void VRHandFingers(int alHand, const cVector3f &in avFingers)
+	{
+		cScript_SetGlobalVarVector3f(alHand == 0 ? "BunkerVR_HandFingers0" : "BunkerVR_HandFingers1", avFingers);
+		cScript_SetGlobalVarFloat(alHand == 0 ? "BunkerVR_HandFingersAt0" : "BunkerVR_HandFingersAt1", float(cEngine_GetGameTime()));
+	}
+
+	// The cord: the game's short cable by the bundle is swapped for a cord this script moves itself, a point every 7 cm
+	// (VRFinaleCordStep), drawn by the engine's rope with its points weightless (the engine moves none of them: left to
+	// the engine's physics, the rope jitters, bends strangely and kinks in steps on the floor). It runs from where the
+	// cable leaves the floor; its end is pinched and carried, never further from its start than its length, and clicked
+	// onto the bundle's terminal. abOn: it is on already (kept there until the blast).
+	void VRFinaleCord(iLuxEntity@ apCable, bool abNear, bool abOn, float afTimeStep)
+	{
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		iPhysicsWorld@ pWorld = pMap !is null ? pMap.GetPhysicsWorld() : null;
+		if(pWorld is null) return;
+		cMatrixf mtxCable = apCable.GetMatrix();
+		cVector3f vStart = cMath_MatrixMul(mtxCable, gvVRFinaleCordStart);
+		cVector3f vOn = cMath_MatrixMul(mtxCable, gvVRFinaleCordOn);
+		iPhysicsRope@ pRope = msVRFinaleCord != "" ? pWorld.GetRope(msVRFinaleCord) : null;
+		if(pRope is null)
+		{
+			// Made: the game's cable hidden, the cord laid from its start to where the cable's end lies (on, after a load:
+			// to the terminal).
+			cVector3f vEnd = abOn ? vOn : cMath_MatrixMul(mtxCable, gvVRFinaleCordRest);
+			mlVRFinaleCords++;
+			msVRFinaleCord = "BunkerVR_FinaleCord" + mlVRFinaleCords;
+			@pRope = pWorld.CreateRope(msVRFinaleCord, vStart, vEnd);
+			if(pRope is null)
+			{
+				VRFinaleNote("the cord's rope could NOT be made: the game's cable stays");
+				msVRFinaleCord = "";
+				return;
+			}
+			pRope.SetSegmentLength(gfVRFinaleCordSegment);
+			pRope.SetTotalLength(gfVRFinaleCordLength);
+			pRope.SetMinTotalLength(gfVRFinaleCordLength);
+			pRope.SetMaxTotalLength(gfVRFinaleCordLength);
+			pRope.SetParticleRadius(gfVRFinaleCordRadius * 2.0f);
+			pRope.SetCollide(false);
+			pRope.SetActive(true);
+			pRope.SetPhysicsActive(true);
+			VRFinaleCordLay(pRope, vStart, vEnd);
+			apCable.SetActive(false);
+			mbVRFinaleCordDrawn = false;
+			mlVRFinaleCordHand = -1;
+			VRFinaleNote("the cord: " + BunkerVR_Fixed(gfVRFinaleCordLength, 2) + " m in " + pRope.GetParticleNum() + " points made in place of the game's cable" + (abOn ? " (on the bundle)" : ""));
+			return; // (drawn from the next update: the engine's rope helpers wait a moment too)
+		}
+		if(mbVRFinaleCordDrawn == false)
+		{
+			mbVRFinaleCordDrawn = true;
+			iRopeEntity@ pGfx = pMap.GetWorld().CreateRopeEntity(msVRFinaleCord + "Gfx", eRopeType_3D, pRope, 48, 6);
+			if(pGfx !is null)
+			{
+				pGfx.SetMaterial(cResources_CreateMaterial(gsVRFinaleCordMaterial));
+				pGfx.SetRadius(gfVRFinaleCordRadius);
+				pGfx.SetActive(true);
+				pGfx.SetVisible(true);
+				pGfx.SetScriptableIsSaved(false);
+				pGfx.SetRenderFlagBit(eRenderableFlag_ShadowCaster, true);
+			}
+			else VRFinaleNote("the cord's rope could not be drawn");
+		}
+		int lLast = int(mvVRFinaleCordAt.length()) - 1;
+		if(lLast < 2 || pRope.GetParticleNum() != lLast + 1) return;
+		cVector3f vEnd = mvVRFinaleCordAt[lLast];
+		// Its end: held on the terminal, in the fingers, or free.
+		bool bEndHeld = abOn;
+		cVector3f vEndAt = vOn;
+		if(abOn == false && mlVRFinaleCordHand < 0)
+		{
+			// A free hand's fresh pinch at its end takes it.
+			for(int h = 0; h < 2; ++h)
+			{
+				if(mvVRFinalePinchFresh[h] == false || mvVRFinaleFree[h] == false || mvVRFinalePalmKnown[h] == false || abNear == false) continue;
+				float fNear = (VRFinalePinchAt(h) - vEnd).Length();
+				if(fNear > gfVRFinaleCordReach) continue;
+				mlVRFinaleCordHand = h;
+				VRBuzzHand(h, 0.03f, 0.45f);
+				cVR_HintUsed("cable_take");
+				VRFinaleNote("the " + (h == 0 ? "left" : "right") + " hand pinches the cord's end (" + int(fNear * 100.0f + 0.5f) + " cm from it)");
+				break;
+			}
+		}
+		if(abOn == false && mlVRFinaleCordHand >= 0)
+		{
+			int h = mlVRFinaleCordHand;
+			if(mvVRFinalePinching[h] == false)
+			{
+				mlVRFinaleCordHand = -1;
+				VRFinaleNote("the " + (h == 0 ? "left" : "right") + " hand lets go of the cord's end: it falls");
+			}
+			else if(mvVRFinalePalmKnown[h] == false)
+			{
+				// (A frame with the hand not tracked: held where it is, as a lost hand stays where it was.)
+				bEndHeld = true;
+				vEndAt = vEnd;
+			}
+			else
+			{
+				// Where the pinch is, but never further from the cord's start than it reaches (a little short of its length,
+				// so that it hangs): pulled on past that, it slips from the fingers.
+				cVector3f vWant = VRFinalePinchAt(h);
+				cVector3f vFromStart = vWant - vStart;
+				float fReach = gfVRFinaleCordLength * gfVRFinaleCordReachMost;
+				if(vFromStart.Length() > fReach + gfVRFinaleCordPullOff)
+				{
+					mlVRFinaleCordHand = -1;
+					VRBuzzHand(h, 0.08f, 0.6f);
+					VRFinaleNote("the cord is pulled taut past its length: it slips from the " + (h == 0 ? "left" : "right") + " hand's fingers");
+				}
+				else
+				{
+					if(vFromStart.Length() > fReach) vWant = vStart + cMath_Vector3Normalize(vFromStart) * fReach;
+					// (Not into the floor or anything solid: the real hand reaching down for it goes below the floor, and an
+					// end held there would pull the cord in after it, to fall on inside. Moved there as its other points move,
+					// stopping at what is solid; the hand is drawn on it there. Whether it goes on is decided by where the hand
+					// brings it: the bundle's own shape may stop it short of its terminal.)
+					cVector3f vBrought = vWant;
+					bool bStopped;
+					vWant = VRFinaleCordStop(vEnd, vWant, bStopped);
+					bEndHeld = true;
+					vEndAt = vWant;
+					if((vBrought - vOn).Length() <= gfVRFinaleCableOn)
+					{
+						mlVRFinaleCordHand = -1;
+						vEndAt = vOn;
+						VRBuzzHand(h, 0.06f, 0.7f);
+						cVR_HintUsed("cable_on");
+						Sound_CreateAtEntity("BunkerVR_CableOn", "level_entity_shared/doors/button_lock/unlock", "Detonator_DynamiteBundle", 0.0f, false);
+						VRFinaleNote("the cord's end is on the bundle (the level told)");
+						VRFinaleTell("BunkerVR_FinaleCabled", -1);
+					}
+					else
+					{
+						VRFinaleDrawHand(h, VRFinalePinchHand(h, vWant));
+						VRHandFingers(h, gvVRFinalePinchFingers);
+					}
+				}
+			}
+		}
+		VRFinaleCordStep(pRope, vStart, bEndHeld, vEndAt, afTimeStep);
+		if(abOn) return;
+		// Its hints: where to take it, then where it goes.
+		for(int h = 0; h < 2; ++h)
+		{
+			if(abNear == false || mvVRFinaleFree[h] == false || mvVRFinaleHintKey[h] != "") continue;
+			if(mlVRFinaleCordHand < 0)
+			{
+				mvVRFinaleHintKey[h] = "cable_take";
+				mvVRFinaleHintAt[h] = vEnd;
+			}
+			else if(mlVRFinaleCordHand == h)
+			{
+				mvVRFinaleHintKey[h] = "cable_on";
+				mvVRFinaleHintAt[h] = vOn;
+			}
+		}
+	}
+
+	// The cord laid from its start to a point as a cord lies on a floor: an even curve using all its length, bowed to the
+	// side with nothing solid in the way (a level line asked of the world on each side), weightless points for the
+	// engine's rope to draw.
+	void VRFinaleCordLay(iPhysicsRope@ apRope, const cVector3f &in avStart, const cVector3f &in avEnd)
+	{
+		int lNum = apRope.GetParticleNum();
+		mvVRFinaleCordAt.resize(lNum);
+		mvVRFinaleCordWas.resize(lNum);
+		mvVRFinaleCordLying.resize(lNum);
+		cVector3f vChord = avEnd - avStart;
+		cVector3f vFlat = cVector3f(vChord.x, 0.0f, vChord.z);
+		float fChord = vFlat.Length();
+		cVector3f vAlong = fChord > 0.001f ? vFlat / fChord : cVector3f(1.0f, 0.0f, 0.0f);
+		cVector3f vSide = cVector3f(-vAlong.z, 0.0f, vAlong.x);
+		// (The half-angle of an arc of the cord's length over that chord: sin(a) / a = chord / length.)
+		float fRatio = cMath_Min(fChord / gfVRFinaleCordLength, 0.999f);
+		float fLow = 0.0001f;
+		float fHigh = 3.1415f;
+		for(int k = 0; k < 40; ++k)
+		{
+			float fMid = (fLow + fHigh) * 0.5f;
+			if(cMath_Sin(fMid) / fMid > fRatio) fLow = fMid;
+			else fHigh = fMid;
+		}
+		float fHalf = (fLow + fHigh) * 0.5f;
+		float fRadius = gfVRFinaleCordLength / (2.0f * fHalf);
+		float fBow = fRadius * (1.0f - cMath_Cos(fHalf));
+		// (Bowed away from what is solid: a wall, the crate.)
+		cVector3f vMiddle = (avStart + avEnd) * 0.5f + cVector3f(0.0f, 0.05f, 0.0f);
+		float fFreeThis = fBow + 0.1f;
+		float fFreeThat = fBow + 0.1f;
+		float fHitAt;
+		cVector3f vNormal;
+		if(cLux_GetClosestBody(vMiddle, vSide, fBow + 0.1f, fHitAt, vNormal) !is null) fFreeThis = fHitAt;
+		if(cLux_GetClosestBody(vMiddle, vSide * -1.0f, fBow + 0.1f, fHitAt, vNormal) !is null) fFreeThat = fHitAt;
+		if(fFreeThat > fFreeThis) vSide = vSide * -1.0f;
+		cVector3f vCentre = (avStart + avEnd) * 0.5f - vSide * (fRadius * cMath_Cos(fHalf));
+		for(int i = 0; i < lNum; ++i)
+		{
+			float fT = float(i) / float(lNum - 1);
+			float fAngle = -fHalf + 2.0f * fHalf * fT;
+			cVector3f vAt = vCentre + (vSide * cMath_Cos(fAngle) + vAlong * cMath_Sin(fAngle)) * fRadius;
+			vAt.y = avStart.y + (avEnd.y - avStart.y) * fT;
+			mvVRFinaleCordAt[i] = vAt;
+			mvVRFinaleCordWas[i] = vAt;
+			mvVRFinaleCordLying[i] = false;
+			cVerletParticle@ pPoint = apRope.GetParticle(i);
+			pPoint.SetInvMass(0.0f);
+			pPoint.SetPosition(vAt, true);
+		}
+		mlVRFinaleCordStill = 0;
+		mfVRFinaleCordTimeLeft = 0.0f;
+	}
+
+	// The cord moved on, a 60th of a second at a time (the time left over kept): its start held where it leaves the
+	// floor, its end where it is held (abEndHeld, at avEndAt) or free; each point carried on by its own swing and its
+	// weight, sliding little on what it lies on; its lengths kept (it cannot be stretched), and no bend at a point
+	// sharper than gfVRFinaleCordBendMost (no kinks); kept out of the floor and anything solid (the engine's own test of
+	// a rope's point along its move, VRFinaleCordStep asking it); at rest left be until something moves it again.
+	void VRFinaleCordStep(iPhysicsRope@ apRope, const cVector3f &in avStart, bool abEndHeld, const cVector3f &in avEndAt, float afTimeStep)
+	{
+		int lNum = int(mvVRFinaleCordAt.length());
+		int lLast = lNum - 1;
+		// (At rest while nothing moves it: a held end that moves, or one taken or let go, wakes it.)
+		if(abEndHeld != mbVRFinaleCordEndHeld || (abEndHeld && (mvVRFinaleCordAt[lLast] - avEndAt).Length() > 0.0005f)) mlVRFinaleCordStill = 0;
+		mbVRFinaleCordEndHeld = abEndHeld;
+		if(mlVRFinaleCordStill >= glVRFinaleCordRest)
+		{
+			mfVRFinaleCordTimeLeft = 0.0f;
+			return;
+		}
+		mfVRFinaleCordTimeLeft = cMath_Min(mfVRFinaleCordTimeLeft + afTimeStep, gfVRFinaleCordStep * 2.0f);
+		float fSegment = gfVRFinaleCordLength / float(lLast);
+		float fBendNearest = 2.0f * fSegment * cMath_Cos(gfVRFinaleCordBendMost * 0.5f);
+		cVector3f vFall = cVector3f(0.0f, -9.8f * gfVRFinaleCordStep * gfVRFinaleCordStep, 0.0f);
+		while(mfVRFinaleCordTimeLeft >= gfVRFinaleCordStep)
+		{
+			mfVRFinaleCordTimeLeft -= gfVRFinaleCordStep;
+			// Carried on by its swing and its weight.
+			for(int i = 1; i < lNum; ++i)
+			{
+				cVector3f vSwing = (mvVRFinaleCordAt[i] - mvVRFinaleCordWas[i]) * gfVRFinaleCordAir;
+				if(mvVRFinaleCordLying[i])
+				{
+					vSwing.x *= gfVRFinaleCordFriction;
+					vSwing.z *= gfVRFinaleCordFriction;
+				}
+				mvVRFinaleCordWas[i] = mvVRFinaleCordAt[i];
+				mvVRFinaleCordAt[i] = mvVRFinaleCordAt[i] + vSwing + vFall;
+			}
+			mvVRFinaleCordWas[0] = mvVRFinaleCordAt[0];
+			mvVRFinaleCordAt[0] = avStart;
+			if(abEndHeld) mvVRFinaleCordAt[lLast] = avEndAt;
+			// Its lengths, and its bends.
+			for(int k = 0; k < glVRFinaleCordPasses; ++k)
+			{
+				for(int i = 0; i < lLast; ++i) VRFinaleCordKeep(i, i + 1, fSegment, fSegment, abEndHeld);
+				for(int i = 0; i < lLast - 1; ++i) VRFinaleCordKeep(i, i + 2, fBendNearest, 2.0f * fSegment, abEndHeld);
+			}
+			// Kept out of what is solid; how far it moved.
+			float fMoved = 0.0f;
+			for(int i = 1; i < lNum; ++i)
+			{
+				if(i == lLast && abEndHeld) mvVRFinaleCordLying[i] = false;
+				else
+				{
+					bool bLying;
+					mvVRFinaleCordAt[i] = VRFinaleCordStop(mvVRFinaleCordWas[i], mvVRFinaleCordAt[i], bLying);
+					mvVRFinaleCordLying[i] = bLying;
+				}
+				fMoved = cMath_Max(fMoved, (mvVRFinaleCordAt[i] - mvVRFinaleCordWas[i]).Length());
+			}
+			mlVRFinaleCordStill = fMoved < 0.0002f ? mlVRFinaleCordStill + 1 : 0;
+		}
+		// Drawn where its points are.
+		for(int i = 0; i < lNum; ++i) apRope.GetParticle(i).SetPosition(mvVRFinaleCordAt[i], true);
+	}
+
+	// A point of the cord moved from avFrom towards avTo, stopped a little more than its thickness off anything solid it
+	// would go into, the rest of the move slid along that (abHit: it met something). A level line asked of the world from
+	// where the point was, which is outside: the engine's own test of a rope's point (UpdateParticleCollisionConstraint)
+	// starts a point's thickness behind it, inside what it rests on, and would put a point lifted off the floor under it.
+	// A character's body, and anything met from inside, is passed through (the player stands on the cord).
+	cVector3f VRFinaleCordStop(const cVector3f &in avFrom, const cVector3f &in avTo, bool &out abHit)
+	{
+		abHit = false;
+		cVector3f vMove = avTo - avFrom;
+		float fMove = vMove.Length();
+		if(fMove < 0.00001f) return avTo;
+		cVector3f vDir = vMove / fMove;
+		float fOff = gfVRFinaleCordRadius * 1.5f;
+		float fFrom = 0.0f; // (how far along the move the line starts)
+		for(int k = 0; k < 3; ++k)
+		{
+			float fHitAt;
+			cVector3f vNormal;
+			iPhysicsBody@ pHit = cLux_GetClosestBody(avFrom + vDir * fFrom, vDir, fMove + fOff - fFrom, fHitAt, vNormal);
+			if(pHit is null) return avTo;
+			float fFacing = -cMath_Vector3Dot(vNormal, vDir);
+			if(pHit.IsCharacter() || pHit.GetCollide() == false || fFacing <= 0.0f)
+			{
+				fFrom += fHitAt + 0.005f;
+				if(fFrom >= fMove + fOff) return avTo;
+				continue;
+			}
+			// Stopped where it is its thickness off the surface, square to it; the rest of the move along it, as far as nothing
+			// else solid is in the way (into a corner, the slide would take it inside the other surface, and from inside the
+			// next moves pass through it: an end let go there would sink into the floor).
+			float fStop = cMath_Clamp(fFrom + fHitAt - fOff / cMath_Max(fFacing, 0.2f), 0.0f, fMove);
+			cVector3f vAt = avFrom + vDir * fStop;
+			cVector3f vRest = avTo - vAt;
+			abHit = true;
+			cVector3f vSlide = vRest - vNormal * cMath_Vector3Dot(vRest, vNormal);
+			float fSlide = vSlide.Length();
+			if(fSlide < 0.00001f) return vAt;
+			cVector3f vSlideDir = vSlide / fSlide;
+			float fSlideHit;
+			cVector3f vSlideNormal;
+			iPhysicsBody@ pSlideHit = cLux_GetClosestBody(vAt, vSlideDir, fSlide + fOff, fSlideHit, vSlideNormal);
+			float fSlideFacing = -cMath_Vector3Dot(vSlideNormal, vSlideDir);
+			if(pSlideHit !is null && pSlideHit.IsCharacter() == false && pSlideHit.GetCollide() && fSlideFacing > 0.0f)
+				fSlide = cMath_Clamp(fSlideHit - fOff / cMath_Max(fSlideFacing, 0.2f), 0.0f, fSlide);
+			return vAt + vSlideDir * fSlide;
+		}
+		return avTo;
+	}
+
+	// Two of the cord's points kept between two distances of each other (its start, and its end while held, unmoved).
+	void VRFinaleCordKeep(int alA, int alB, float afShortest, float afLongest, bool abEndHeld)
+	{
+		int lLast = int(mvVRFinaleCordAt.length()) - 1;
+		float fA = (alA == 0 || (alA == lLast && abEndHeld)) ? 0.0f : 1.0f;
+		float fB = (alB == 0 || (alB == lLast && abEndHeld)) ? 0.0f : 1.0f;
+		if(fA + fB <= 0.0f) return;
+		cVector3f vApart = mvVRFinaleCordAt[alB] - mvVRFinaleCordAt[alA];
+		float fApart = vApart.Length();
+		if(fApart < 0.000001f) return;
+		float fWant = cMath_Clamp(fApart, afShortest, afLongest);
+		if(fWant == fApart) return;
+		cVector3f vMove = vApart * ((fApart - fWant) / (fApart * (fA + fB)));
+		mvVRFinaleCordAt[alA] = mvVRFinaleCordAt[alA] + vMove * fA;
+		mvVRFinaleCordAt[alB] = mvVRFinaleCordAt[alB] - vMove * fB;
+	}
+
+	// The cord's rope gone (the blast, the bundle gone again, the exit set up again): abShowCable, the game's cable shown
+	// again.
+	void VRFinaleCordGone(bool abShowCable)
+	{
+		mlVRFinaleCordHand = -1;
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		if(msVRFinaleCord == "" || pMap is null) return;
+		iRopeEntity@ pGfx = pMap.GetWorld().GetRopeEntity(msVRFinaleCord + "Gfx");
+		if(pGfx !is null) pMap.GetWorld().DestroyRopeEntity(pGfx);
+		iPhysicsRope@ pRope = pMap.GetPhysicsWorld().GetRope(msVRFinaleCord);
+		if(pRope !is null) pMap.GetPhysicsWorld().DestroyRope(pRope);
+		msVRFinaleCord = "";
+		iLuxEntity@ pCable = pMap.GetEntityByName("DynamiteFuse");
+		if(abShowCable && pCable !is null) pCable.SetActive(true);
+		VRFinaleNote("the cord's rope is gone" + (abShowCable ? ": the game's cable shown again" : ""));
+	}
+
+	// The T-bar: one fist at each end; given to both hands pressing past it and following them as a heavy plunger does,
+	// the push's animation held at its depth; at the bottom the level told how fast it came.
+	void VRFinalePush(cLuxProp@ apDet, const cMatrixf &in a_mtxDet, const cVector3f &in avUp, bool abNear, int alState, const cVector3f &in avBody,
+					  float afNow, float afTimeStep)
+	{
+		cVector3f vMiddle = cMath_MatrixMul(a_mtxDet, gvVRFinaleBar) - avUp * mfVRFinaleDrop;
+		cVector3f vAlong = cMath_Vector3Normalize(cMath_MatrixMul3x3(a_mtxDet, cVector3f(1.0f, 0.0f, 0.0f)));
+		// A free hand's fresh squeeze at an end takes it (the end nearer its palm, or the other if that one is taken).
+		for(int h = 0; h < 2; ++h)
+		{
+			bool bHeld = (mlVRFinaleBarHands & (1 << h)) != 0;
+			if(bHeld == false)
+			{
+				if(mvVRFinaleFresh[h] == false || mvVRFinaleFree[h] == false || mvVRFinalePalmKnown[h] == false || abNear == false) continue;
+				cVector3f vPalm = m_mtxVRFinalePalm[h].GetTranslation();
+				float fSide = cMath_Vector3Dot(vPalm - vMiddle, vAlong) >= 0.0f ? 1.0f : -1.0f;
+				int lOther = 1 - h;
+				if((mlVRFinaleBarHands & (1 << lOther)) != 0 && mvVRFinaleBarSide[lOther] == fSide) fSide = -fSide;
+				cVector3f vEnd = vMiddle + vAlong * (fSide * gfVRFinaleBarHalf);
+				float fNear = (vPalm - vEnd).Length();
+				if(fNear > gfVRFinaleBarReach) continue;
+				mlVRFinaleBarHands |= 1 << h;
+				mvVRFinaleBarSide[h] = fSide;
+				mvVRFinaleBarTop[h] = cMath_Vector3Dot(vPalm, avUp) + mfVRFinaleDrop;
+				VRBuzzHand(h, 0.03f, 0.5f);
+				VRFinaleNote("the " + (h == 0 ? "left" : "right") + " hand takes the T-bar's " + (fSide > 0.0f ? "+" : "-") + " end (" + int(fNear * 100.0f + 0.5f) + " cm from it; " +
+							 int(mfVRFinaleDrop * 100.0f + 0.5f) + " cm down)");
+			}
+			else if(mvVRFinaleSqueezeWas[h] == false)
+			{
+				mlVRFinaleBarHands &= ~(1 << h);
+				VRFinaleNote("the " + (h == 0 ? "left" : "right") + " hand lets go of the T-bar (" + int(mfVRFinaleDrop * 100.0f + 0.5f) + " cm down)");
+			}
+		}
+		// Both hands on it: it gives to them pressing past it by more than its stiffness, and follows the further they
+		// press the faster (a heavy plunger); pulled up, it comes up with them. One hand alone does not move it.
+		float fWas = mfVRFinaleDrop;
+		bool bBoth = mlVRFinaleBarHands == 3;
+		if(bBoth)
+		{
+			float fDepth = 100.0f;
+			for(int h = 0; h < 2; ++h)
+			{
+				float fHand = mvVRFinalePalmKnown[h] ? mvVRFinaleBarTop[h] - cMath_Vector3Dot(m_mtxVRFinalePalm[h].GetTranslation(), avUp) : mfVRFinaleDrop;
+				fDepth = cMath_Min(fDepth, fHand); // (the hand pressing less holds it back)
+			}
+			float fLead = fDepth - mfVRFinaleDrop;
+			float fSpeed = 0.0f;
+			if(fLead > gfVRFinaleBreak) fSpeed = cMath_Min((fLead - gfVRFinaleBreak) * gfVRFinaleGive, gfVRFinaleBarFastest);
+			else if(fLead < 0.0f) fSpeed = cMath_Max(fLead * gfVRFinaleRise, -gfVRFinaleBarFastest);
+			mfVRFinaleDrop = cMath_Clamp(mfVRFinaleDrop + fSpeed * afTimeStep, 0.0f, gfVRFinaleTravel);
+			mfVRFinaleLead = fLead;
+			// The strain in both hands as they press on it.
+			if(fLead > 0.005f)
+			{
+				mfVRFinaleStrainWait -= afTimeStep;
+				if(mfVRFinaleStrainWait <= 0.0f)
+				{
+					mfVRFinaleStrainWait = 0.04f;
+					float fStrain = cMath_Clamp(0.15f + fLead * 5.0f, 0.15f, 0.75f);
+					VRBuzzHand(0, 0.04f, fStrain);
+					VRBuzzHand(1, 0.04f, fStrain);
+				}
+			}
+		}
+		else if(mlVRFinaleBarHands != 0 && mbVRFinaleOneHandSaid == false)
+		{
+			mbVRFinaleOneHandSaid = true;
+			VRFinaleNote("one hand on the T-bar: it does not give to one hand (both are needed)");
+		}
+		vMiddle = cMath_MatrixMul(a_mtxDet, gvVRFinaleBar) - avUp * mfVRFinaleDrop;
+		// A hand gone far from its end (pulled away) lets go.
+		for(int h = 0; h < 2; ++h)
+		{
+			if((mlVRFinaleBarHands & (1 << h)) == 0 || mvVRFinalePalmKnown[h] == false) continue;
+			cVector3f vEnd = vMiddle + vAlong * (mvVRFinaleBarSide[h] * gfVRFinaleBarHalf);
+			if((m_mtxVRFinalePalm[h].GetTranslation() - vEnd).Length() <= gfVRFinaleSlip) continue;
+			mlVRFinaleBarHands &= ~(1 << h);
+			VRFinaleNote("the " + (h == 0 ? "left" : "right") + " hand is pulled away from the T-bar: it lets go (" + int(mfVRFinaleDrop * 100.0f + 0.5f) + " cm down)");
+		}
+		// The time it passed into its last 6 cm going down.
+		float fBarSpeed = afTimeStep > 0.0f ? (mfVRFinaleDrop - fWas) / afTimeStep : 0.0f;
+		float fMark = gfVRFinaleTravel - gfVRFinaleFastOver;
+		if(fWas < fMark && mfVRFinaleDrop >= fMark) mfVRFinaleFastFrom = afNow - (fBarSpeed > 0.0f ? (mfVRFinaleDrop - fMark) / fBarSpeed : 0.0f);
+		// At the bottom, after being up: the level told whether it came hard enough.
+		if(mbVRFinaleBarUp && mfVRFinaleDrop >= gfVRFinaleTravel - 0.002f)
+		{
+			mbVRFinaleBarUp = false;
+			float fTook = mfVRFinaleFastFrom >= 0.0f ? afNow - mfVRFinaleFastFrom : 100.0f;
+			float fCame = fTook > 0.0001f ? gfVRFinaleFastOver / fTook : 100.0f;
+			bool bFast = mfVRFinaleFastFrom >= 0.0f && fCame >= gfVRFinaleFast;
+			VRFinaleNote("the T-bar is at the bottom, its last " + int(gfVRFinaleFastOver * 100.0f + 0.5f) + " cm at " + BunkerVR_Fixed(cMath_Min(fCame, 9.99f), 2) + " m/s: " +
+						 (bFast ? "hard enough" : "too slowly") + (BunkerVR_FinaleArmed(alState) ? "" : " (not all done)") + " (the level told)");
+			VRFinaleTell("BunkerVR_FinalePushed", bFast ? 1 : 0);
+			if((cScript_GetGlobalVarInt("BunkerVR_Finale") & glBunkerVR_FinaleFired) != 0)
+			{
+				cVR_HintUsed("det_push");
+				VRBuzzHand(0, 0.35f, 1.0f);
+				VRBuzzHand(1, 0.35f, 1.0f);
+				mlVRFinaleBarHands = 0;
+				return;
+			}
+			Sound_CreateAtEntity("BunkerVR_PlungerDown", "level_entity_shared/levers/thatre_lever/lever_stop", apDet.GetName(), 0.0f, false);
+			for(int h = 0; h < 2; ++h)
+				if((mlVRFinaleBarHands & (1 << h)) != 0) VRBuzzHand(h, 0.08f, 0.7f);
+		}
+		// Up again: a new push may fire.
+		if(mbVRFinaleBarUp == false && mfVRFinaleDrop <= gfVRFinaleUpAgain)
+		{
+			mbVRFinaleBarUp = true;
+			mfVRFinaleFastFrom = -1.0f;
+			Sound_CreateAtEntity("BunkerVR_PlungerUp", "level_entity_shared/levers/water_pump/lever_stop", apDet.GetName(), 0.0f, false);
+			VRFinaleNote("the T-bar is pulled up again");
+		}
+		if(mfVRFinaleDrop < fMark) mfVRFinaleFastFrom = -1.0f;
+		// Posed: the push's animation held at its depth.
+		if(cMath_Abs(mfVRFinaleDrop - mfVRFinaleDropShown) > 0.0005f)
+		{
+			mfVRFinaleDropShown = mfVRFinaleDrop;
+			BunkerVR_FinaleHold(apDet.GetName(), "detonator_ignite", VRFinalePushTime(mfVRFinaleDrop));
+		}
+		// The fists drawn on its ends: the bar through the fist along the knuckles, the first finger towards the middle,
+		// the back of the hand up, the wrist towards the player.
+		cVector3f vBack = VRFinaleLevel(avBody - vMiddle, avUp);
+		vBack = cMath_Vector3Normalize(vBack - vAlong * cMath_Vector3Dot(vBack, vAlong));
+		for(int h = 0; h < 2; ++h)
+		{
+			if((mlVRFinaleBarHands & (1 << h)) == 0) continue;
+			cVector3f vEnd = vMiddle + vAlong * (mvVRFinaleBarSide[h] * gfVRFinaleBarHalf);
+			cVector3f vY = vAlong * (-mvVRFinaleBarSide[h]);
+			cVector3f vX = cMath_Vector3Cross(vY, vBack);
+			// (Its axes x, y and z as given: the rows set, then turned over, as a matrix's SetRight, SetUp and SetForward set
+			// its rows, not where it takes x, y and z.)
+			cMatrixf mtxRows = cMatrixf_Identity;
+			mtxRows.SetRight(vX);
+			mtxRows.SetUp(vY);
+			mtxRows.SetForward(vBack);
+			cMatrixf mtxHand = cMath_MatrixInverse(mtxRows);
+			mtxHand.SetTranslation(vEnd + avUp * gfVRFinaleFistAbove + vBack * gfVRFinaleFistBack);
+			VRFinaleDrawHand(h, mtxHand);
+			VRHandFingers(h, gvVRFistFingers);
+		}
+		// The hint, for a free hand near it, at the end it would take, while not both hold it.
+		for(int h = 0; h < 2; ++h)
+		{
+			if(abNear == false || mvVRFinaleFree[h] == false || (mlVRFinaleBarHands & (1 << h)) != 0 || mvVRFinaleHintKey[h] != "" || mvVRFinalePalmKnown[h] == false) continue;
+			float fSide = cMath_Vector3Dot(m_mtxVRFinalePalm[h].GetTranslation() - vMiddle, vAlong) >= 0.0f ? 1.0f : -1.0f;
+			if((mlVRFinaleBarHands & (1 << (1 - h))) != 0 && mvVRFinaleBarSide[1 - h] == fSide) fSide = -fSide;
+			mvVRFinaleHintKey[h] = "det_push";
+			mvVRFinaleHintAt[h] = vMiddle + vAlong * (fSide * gfVRFinaleBarHalf);
+		}
+	}
+
+	// The push's time (detonator_ignite) at a depth of the T-bar, from the animation's own descent (mvVRFinalePushDepth,
+	// mvVRFinalePushTime).
+	float VRFinalePushTime(float afDrop)
+	{
+		int lLast = int(mvVRFinalePushDepth.length()) - 1;
+		for(int i = 0; i < lLast; ++i)
+		{
+			if(afDrop > mvVRFinalePushDepth[i + 1] && i < lLast - 1) continue;
+			float fSpan = mvVRFinalePushDepth[i + 1] - mvVRFinalePushDepth[i];
+			float fT = fSpan > 0.0001f ? cMath_Clamp((afDrop - mvVRFinalePushDepth[i]) / fSpan, 0.0f, 1.0f) : 0.0f;
+			return mvVRFinalePushTime[i] + (mvVRFinalePushTime[i + 1] - mvVRFinalePushTime[i]) * fT;
+		}
+		return gfBunkerVR_FinalePushFrom;
+	}
+
+	// The item in the right hand brought to where it goes: may the game's own use of it be made there now (not again within
+	// 0.5 s, while the level takes it from the hand)? If the game says not, that is logged once.
+	bool VRFinaleCanUse(const tString &in asWhat, const tString &in asTarget, float afNow)
+	{
+		if(afNow - mfVRFinaleUsedAt <= 0.5f && afNow >= mfVRFinaleUsedAt) return false;
+		if(Item_GetCanUseOnWorld(eItemHandlerHand_Right, asTarget)) return true;
+		if(mbVRFinaleRefusedSaid == false)
+		{
+			mbVRFinaleRefusedSaid = true;
+			VRFinaleNote("the " + asWhat + " is where it goes, but the game says it cannot be used on " + asTarget + " now");
+		}
+		return false;
+	}
+
+	// What the hands held at the exit let go of (a cord's end held falls).
+	void VRFinaleLetGo()
+	{
+		mlVRFinaleNutHand = -1;
+		mlVRFinaleBarHands = 0;
+		mlVRFinaleCordHand = -1;
+	}
+
+	// The level told (its function asFunc, with alArg if not -1).
+	void VRFinaleTell(const tString &in asFunc, int alArg)
+	{
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		tString sDecl = "void " + asFunc + (alArg < 0 ? "()" : "(int)");
+		if(pMap is null || pMap.ScriptMethodExists(sDecl) == false || pMap.ScriptPrepare(sDecl) == false)
+		{
+			VRFinaleNote("the level has no " + sDecl);
+			return;
+		}
+		if(alArg >= 0) pMap.SetArgInt(0, alArg);
+		pMap.ScriptExecute();
+	}
+
+	// BunkerVR, for testing (script 90): the exit's state as the hands work it, in the mod's own log.
+	void VRStandInFinale()
+	{
+		cLuxProp@ pDet = cLux_ID_Prop(m_idVRFinaleDet);
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		if(pDet is null || pMap is null)
+		{
+			cVR_Say("finale: no exit here");
+			return;
+		}
+		cMatrixf mtxDet = pDet.GetMatrix();
+		cVector3f vUp = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxDet, cVector3f(0.0f, 1.0f, 0.0f)));
+		cVector3f vAlong = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxDet, cVector3f(1.0f, 0.0f, 0.0f)));
+		cVector3f vMiddle = cMath_MatrixMul(mtxDet, gvVRFinaleBar) - vUp * mfVRFinaleDrop;
+		iLuxEntity@ pCable = pMap.GetEntityByName("DynamiteFuse");
+		iLuxEntity@ pPlace = pMap.GetEntityByName("Detonator_DynamiteBundle");
+		iPhysicsRope@ pRope = msVRFinaleCord != "" ? pMap.GetPhysicsWorld().GetRope(msVRFinaleCord) : null;
+		cVector3f vStart = pCable !is null ? cMath_MatrixMul(pCable.GetMatrix(), gvVRFinaleCordStart) : cVector3f(0.0f);
+		cVector3f vEnd = pRope !is null ? pRope.GetEndParticle().GetPosition() : (pCable !is null ? cMath_MatrixMul(pCable.GetMatrix(), gvVRFinaleCordRest) : cVector3f(0.0f));
+		cVector3f vOn = pCable !is null ? cMath_MatrixMul(pCable.GetMatrix(), gvVRFinaleCordOn) : cVector3f(0.0f);
+		cMeshEntity@ pMesh = pDet.GetMeshEntity();
+		cBoneState@ pNut = pMesh !is null ? pMesh.GetBoneStateFromName("j_wing_screw_01") : null;
+		cVector3f vNutX = pNut !is null ? cMath_Vector3Normalize(cMath_MatrixMul3x3(pNut.GetWorldMatrix(), cVector3f(1.0f, 0.0f, 0.0f))) : cVector3f(0.0f);
+		iLuxEntity@ pHeld = pMap.GetEntityByName(Item_GetHeldEntity(eItemHandlerHand_Right));
+		cVR_Say("finale: state " + cScript_GetGlobalVarInt("BunkerVR_Finale") + ", nuts " + int(cMath_ToDeg(mvVRFinaleNutTurn[0]) + 0.5f) + " " +
+			int(cMath_ToDeg(mvVRFinaleNutTurn[1]) + 0.5f) + " degrees (hand " + mlVRFinaleNutHand + "), cord " + (pRope !is null ? "a rope" : "the game's") +
+			" (hand " + mlVRFinaleCordHand + "), T-bar " + BunkerVR_Fixed(mfVRFinaleDrop * 100.0f, 1) + " cm down (hands " + mlVRFinaleBarHands + ", up " + (mbVRFinaleBarUp ? "yes" : "no") +
+			", lead " + BunkerVR_Fixed(mfVRFinaleLead * 100.0f, 1) + " cm); T-bar " + VRTapText(vMiddle) + ", its ends " + VRTapText(vMiddle - vAlong * gfVRFinaleBarHalf) + " / " +
+			VRTapText(vMiddle + vAlong * gfVRFinaleBarHalf) + "; nuts " + VRTapText(cMath_MatrixMul(mtxDet, gvVRFinaleNut0)) + " / " + VRTapText(cMath_MatrixMul(mtxDet, gvVRFinaleNut1)) +
+			", nut 1's bone x " + VRTapText(vNutX) + "; cord start " + VRTapText(vStart) + ", end " + VRTapText(vEnd) + ", on at " + VRTapText(vOn) +
+			"; the bundle's place " + (pPlace !is null ? VRTapText(pPlace.GetPosition()) : "none") +
+			"; the right hand holds '" + Item_GetHeldType(eItemHandlerHand_Right) + "' at " + VRTapText(pHeld !is null ? pHeld.GetPosition() : cVector3f(0.0f)) +
+			"; pinches at " + VRTapText(VRFinalePinchAt(0)) + " / " + VRTapText(VRFinalePinchAt(1)) + " (the right's in its palm's terms " + VRTapText(mvVRFinalePinchOff[1]) + ")" +
+			"; the right palm's x " + VRTapText(cMath_MatrixMul3x3(m_mtxVRFinalePalm[1], cVector3f(1.0f, 0.0f, 0.0f))) + ", z " + VRTapText(cMath_MatrixMul3x3(m_mtxVRFinalePalm[1], cVector3f(0.0f, 0.0f, 1.0f))) + "; the body " +
+			BunkerVR_Fixed((cLux_GetPlayer().GetCharacterBody().GetPosition() - mtxDet.GetTranslation()).Length(), 2) + " m from the detonator, the game's use there " +
+			(Item_GetCanUseOnWorld(eItemHandlerHand_Right, "Detonator_Proxy") ? "allowed" : "refused"));
+		// The T-bar's bones in the detonator's own terms (where the T-bar really is).
+		tString sParts = "";
+		cMatrixf mtxToDet = cMath_MatrixInverse(mtxDet);
+		array<tString> vBarBones = { "j_detonator_root", "j_handle", "j_handle_end" };
+		for(uint i = 0; pMesh !is null && i < vBarBones.length(); ++i)
+		{
+			cBoneState@ pBone = pMesh.GetBoneStateFromName(vBarBones[i]);
+			if(pBone is null) continue;
+			sParts += "; " + vBarBones[i] + " " + VRTapText(cMath_MatrixMul(mtxToDet, pBone.GetWorldPosition())) + " (its y " +
+					  VRTapText(cMath_MatrixMul3x3(mtxToDet, cMath_MatrixMul3x3(pBone.GetWorldMatrix(), cVector3f(0.0f, 1.0f, 0.0f)))) + ")";
+		}
+		cVR_Say("finale parts (the detonator's terms)" + sParts);
+		// The cord's shape: its sharpest bend along it and where, the sharpest by its end (where it meets the terminal), its
+		// points lying on something, its lowest point against its start (on the floor), how long it is, at rest or not.
+		int lCordPoints = int(mvVRFinaleCordAt.length());
+		if(lCordPoints >= 3)
+		{
+			float fSharpest = 0.0f;
+			int lSharpest = 0;
+			float fByEnd = 0.0f;
+			int lLying = 0;
+			float fLowest = 100.0f;
+			float fLength = 0.0f;
+			for(int i = 0; i < lCordPoints; ++i)
+			{
+				if(mvVRFinaleCordLying[i]) lLying++;
+				fLowest = cMath_Min(fLowest, mvVRFinaleCordAt[i].y - vStart.y);
+				if(i > 0) fLength += (mvVRFinaleCordAt[i] - mvVRFinaleCordAt[i - 1]).Length();
+				if(i == 0 || i == lCordPoints - 1) continue;
+				cVector3f vIn = cMath_Vector3Normalize(mvVRFinaleCordAt[i] - mvVRFinaleCordAt[i - 1]);
+				cVector3f vOut = cMath_Vector3Normalize(mvVRFinaleCordAt[i + 1] - mvVRFinaleCordAt[i]);
+				float fBend = cMath_ToDeg(cMath_ACos(cMath_Clamp(cMath_Vector3Dot(vIn, vOut), -1.0f, 1.0f)));
+				if(i >= lCordPoints - 3) fByEnd = cMath_Max(fByEnd, fBend);
+				else if(fBend > fSharpest)
+				{
+					fSharpest = fBend;
+					lSharpest = i;
+				}
+			}
+			cVR_Say("finale cord: its sharpest bend " + int(fSharpest + 0.5f) + " degrees (point " + lSharpest + " of " + lCordPoints + "), by its end " + int(fByEnd + 0.5f) +
+				" degrees, " + lLying + " points lying on something, its lowest " +
+				BunkerVR_Fixed(fLowest * 100.0f, 1) + " cm from its start's height, " + BunkerVR_Fixed(fLength, 3) + " m long, " + (mlVRFinaleCordStill >= glVRFinaleCordRest ? "at rest" : "moving"));
+		}
+	}
+
+	// BunkerVR, for testing (script 91): how the dynamite bundle in the right hand sits in it: the right hand's
+	// finger joints inside it, taken as the round bunch of sticks it is (read from its model: 25.3 cm long along its x,
+	// 11.0 by 10.1 cm across; a box's corners are empty), each and the deepest; and, in the palm's own terms, the
+	// joints, the bundle's middle and its axes (to work its grip out from).
+	void VRStandInHeldFit()
+	{
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		iLuxEntity@ pHeld = pMap !is null ? pMap.GetEntityByName(Item_GetHeldEntity(eItemHandlerHand_Right)) : null;
+		cLuxProp@ pBody = cLux_ID_Prop(m_idBody);
+		cMeshEntity@ pMesh = pBody !is null ? pBody.GetMeshEntity() : null;
+		if(pHeld is null || pMesh is null)
+		{
+			cVR_Say("held fit: nothing in the right hand");
+			return;
+		}
+		cVector3f vHalf = cVector3f(0.1265f, 0.055f, 0.0505f);
+		array<tString> vBones = { "j_R_Thumb_1", "j_R_Thumb_2", "j_R_Thumb_3", "j_R_Index_1", "j_R_Index_2", "j_R_Index_3", "j_R_Index_4", "j_R_Mid_1", "j_R_Mid_2",
+								  "j_R_Mid_3", "j_R_Mid_4", "j_R_Ring_1", "j_R_Ring_2", "j_R_Ring_3", "j_R_Ring_4", "j_R_Pinky_1", "j_R_Pinky_2", "j_R_Pinky_3", "j_R_Pinky_4" };
+		cMatrixf mtxInv = cMath_MatrixInverse(pHeld.GetMatrix());
+		cMatrixf mtxPalm;
+		float fArmScale;
+		bool bPalm = BunkerVR_ReadFollowedPalm(1, mtxPalm, fArmScale);
+		cMatrixf mtxToPalm = cMath_MatrixInverse(mtxPalm);
+		int lInside = 0;
+		float fDeepest = -1.0f;
+		tString sDeepest = "";
+		tString sInside = "";
+		tString sInPalm = "";
+		for(uint i = 0; i < vBones.length(); ++i)
+		{
+			cBoneState@ pBone = pMesh.GetBoneStateFromName(vBones[i]);
+			if(pBone is null) continue;
+			cVector3f vLocal = cMath_MatrixMul(mtxInv, pBone.GetWorldPosition());
+			float fAcross = cMath_Sqrt((vLocal.y / vHalf.y) * (vLocal.y / vHalf.y) + (vLocal.z / vHalf.z) * (vLocal.z / vHalf.z));
+			float fIn = cMath_Min(vHalf.x - cMath_Abs(vLocal.x), (1.0f - fAcross) * cMath_Min(vHalf.y, vHalf.z));
+			if(fIn > 0.0f)
+			{
+				lInside++;
+				sInside += " " + cString_Sub(vBones[i], 4, -1) + " " + int(fIn * 1000.0f);
+			}
+			if(fIn > fDeepest)
+			{
+				fDeepest = fIn;
+				sDeepest = vBones[i];
+			}
+			if(bPalm) sInPalm += "; " + cString_Sub(vBones[i], 4, -1) + " " + VRTapText(cMath_MatrixMul(mtxToPalm, pBone.GetWorldPosition()));
+		}
+		cMatrixf mtxHeldInPalm = cMath_MatrixMul(mtxToPalm, pHeld.GetMatrix());
+		cVR_Say("held fit: '" + Item_GetHeldType(eItemHandlerHand_Right) + "': " + lInside + " of " + vBones.length() + " finger joints inside it (mm:" + sInside +
+			"), the deepest " + sDeepest + " " + int(fDeepest * 1000.0f) + " mm (+ inside, - clear); the right hand held back " +
+			VRTapText(cScript_GetGlobalVarVector3f("BunkerVR_HandBack1")) + ", its arm short by " + VRTapText(cScript_GetGlobalVarVector3f("BunkerVR_ReachShortRight")));
+		if(bPalm)
+			cVR_Say("held fit in the palm's terms: its middle " + VRTapText(mtxHeldInPalm.GetTranslation()) + ", its x " + VRTapText(cMath_MatrixMul3x3(mtxHeldInPalm, cVector3f(1.0f, 0.0f, 0.0f))) +
+				", y " + VRTapText(cMath_MatrixMul3x3(mtxHeldInPalm, cVector3f(0.0f, 1.0f, 0.0f))) + ", z " + VRTapText(cMath_MatrixMul3x3(mtxHeldInPalm, cVector3f(0.0f, 0.0f, 1.0f))) + sInPalm);
+	}
+
+	void VRFinaleNote(const tString &in asWhat)
+	{
+		if(mlVRFinaleNotes >= 120) return;
+		mlVRFinaleNotes++;
+		Log("BunkerVR finale: " + asWhat + "\n");
+	}
+
+
+	// Is a can or bottle tipped so that it pours: its opening (avOpening)
+	// below its middle (avMiddle), in the world? (The can, its opening at the
+	// top on one side: tipped about 55 degrees towards that side, or past
+	// 125 the other way; a bottle past 90. Script test: test_pour.hps.)
+	// The can also pours once it is tipped gfVRPourCanTilt from upright with
+	// its opening gfVRPourCanLow or more below the middle of its top (avTop;
+	// the opening on the low side): from 25 degrees towards its opening, or a
+	// little more to the side the opening is on. The first test alone would
+	// need an awkwardly steep tilt (55 degrees towards the opening, more the
+	// other ways); a full can pours as soon as its spout is low. The bottle
+	// uses the first test only.
+	bool VRPourTipped(const cVector3f &in avOpening, const cVector3f &in avMiddle, const cVector3f &in avTop, bool abCan)
+	{
+		if(avOpening.y < avMiddle.y - gfVRPourBelow) return true;
+		if(abCan == false) return false;
+		cVector3f vUp = avTop - avMiddle;
+		if(vUp.Length() < 0.001f) return false;
+		float fTilt = cMath_ACos(cMath_Clamp(cMath_Vector3Normalize(vUp).y, -1.0f, 1.0f));
+		return fTilt >= cMath_ToRad(gfVRPourCanTilt) && avOpening.y < avTop.y - gfVRPourCanLow;
+	}
+
+	// BunkerVR: fuel thrown from the open can, as the game's own throw does on a
+	// flat screen: a shove of the can held in both hands, the left on its bottom
+	// or end (VRUpdateFuelHands; the shove is recognized by cBunkerVRFuelShove in
+	// helper_bunkervr_items.hps). The can in the right hand, its lid off
+	// (VRUpdateLid), not pouring into anything: the hand followed as the game's
+	// own camera sees it, level (so walking and turning are no swing); thrown, one
+	// splash: the game's own splash at the opening (as its throw makes them), its
+	// splash sound, a tap in the hand, and a spill where it lands, as the game's
+	// (on the ground, at least 0.75 m from this can's last, and it can be set
+	// alight). The third empties the can: used up, as after the game's throw.
+	// (The game's own throw, by its use button, is left out in VR:
+	// PlayerState_UsingFuel.hps.)
+	void VRUpdateFuelSplash(float afTimeStep)
+	{
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		bool bCan = Item_GetHeldType(eItemHandlerHand_Right) == "Fuel";
+		cLuxProp@ pCan = bCan && pMap !is null ? cLux_ToProp(pMap.GetEntityByName(Item_GetHeldEntity(eItemHandlerHand_Right))) : null;
+		if(pCan is null)
+		{
+			m_idVRFuelSplashCan = tID_Invalid;
+			mbVRFuelOpeningKnown = false;
+			mVRFuelShove.Reset();
+			return;
+		}
+		if(pCan.GetID() != m_idVRFuelSplashCan)
+		{
+			m_idVRFuelSplashCan = pCan.GetID();
+			mlVRFuelSplashes = 0;
+			mvVRFuelLastSpill = cVector3f(100000.0f);
+			mbVRFuelOpeningKnown = false;
+			mVRFuelShove.Reset();
+		}
+		iPhysicsBody@ pOpeningBody = pCan.GetBodyFromName("Opening");
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		cCamera@ pCam = pPlayer !is null ? pPlayer.GetCamera() : null;
+		// (How long the lid has been off: no throw in the first gfBunkerVR_FuelLidCalm, while the left
+		// hand comes away from it; otherwise opening the lid can throw fuel by itself.)
+		if(mbVRLidOff == false || pCan.GetID() != m_idVRPourVessel) mfVRFuelLidOffFor = 0.0f;
+		else mfVRFuelLidOffFor += afTimeStep;
+		if(pOpeningBody is null || pCam is null || pCan.GetID() != m_idVRPourVessel || mbVRLidOff == false || afTimeStep <= 0.0f || mfVRFuelLidOffFor < gfBunkerVR_FuelLidCalm ||
+		   mbVRFuelTwo == false) // (only held in both hands)
+		{
+			mbVRFuelOpeningKnown = false;
+			mVRFuelShove.Reset();
+			return;
+		}
+		cMatrixf mtxOpening = pOpeningBody.GetWorldMatrix();
+		cVector3f vOpening = mtxOpening.GetTranslation();
+		mvVRHintFuelOpening = vOpening;
+		if(mfVRFuelFlickWait > 0.0f) mfVRFuelFlickWait -= afTimeStep;
+
+		// The swing is the right hand's as the game's own camera sees it, level
+		// (special roll values 7007 and 7012, asked of the mod at once: it
+		// places the palm in the world from that same camera, camera.cpp), so
+		// that it is the controller's own in the room: walking, running and
+		// turning, and the game's updates between the headset's frames, move
+		// it nowhere. (Don't follow the can's opening against the character's
+		// body: walking and turning then throw fuel.) A jump of the view (a
+		// snap turn, a scene's place) is no swing: the shove starts again.
+		float fRealRoll = pCam.GetRoll();
+		pCam.SetRoll(7014.0f);
+		cVector3f vStatus = pCam.GetMatrix().GetTranslation();
+		bool bAnswered = vStatus.x > 12344.0f && vStatus.x < 12346.0f;
+		cMatrixf mtxView = cMatrixf_Identity;
+		cVector3f vPalm = cVector3f(0.0f);
+		if(bAnswered)
+		{
+			pCam.SetRoll(7007.0f); // (the game's camera, level: a view matrix, world to camera)
+			mtxView = pCam.GetMatrix();
+			pCam.SetRoll(7012.0f); // (the right palm, in the world)
+			vPalm = pCam.GetMatrix().GetTranslation();
+		}
+		pCam.SetRoll(fRealRoll);
+		if(bAnswered == false)
+		{
+			mbVRFuelOpeningKnown = false;
+			mVRFuelShove.Reset();
+			return;
+		}
+		float fTurn = pCam.GetYaw();
+		cVector3f vSeen = cMath_MatrixMul(mtxView, vPalm);
+		if(mbVRFuelOpeningKnown && (cMath_Abs(cMath_GetAngleDistanceRad(mfVRFuelTurnWas, fTurn)) > cMath_ToRad(10.0f) ||
+			(vSeen - mvVRFuelOpeningWas).Length() > 0.4f))
+			mVRFuelShove.Reset();
+		mbVRFuelOpeningKnown = true;
+		mvVRFuelOpeningWas = vSeen;
+		mfVRFuelTurnWas = fTurn;
+		cVector3f vThrowSeen;
+		if(mVRFuelShove.Add(vSeen, afTimeStep, vThrowSeen) == false) return;
+		if(mfVRFuelFlickWait > 0.0f || mfVRPourTime > 0.0f) return;
+		mfVRFuelFlickWait = gfBunkerVR_FuelThrowGap;
+		VRFuelSplash(pMap, pCan, mtxOpening, cMath_MatrixMul3x3(cMath_MatrixInverse(mtxView), vThrowSeen));
+	}
+
+	// BunkerVR: the fuel can held in both hands, as in the game's own animation: the left hand grips it
+	// low and a shove throws the fuel, with no throwing motion and no awkward wrist. The right hand
+	// holds it by its bar as the game's own animation does (the grips file, read from
+	// player_fuel_cannister_idle_rarm.fbx), not inside the model. The left palm brought to its side, its end
+	// or its bottom (not its top: below gfBunkerVR_FuelLeftTopMost; and with the lid still on, not at
+	// the opening, whose squeeze opens it: VRUpdateLid), within gfBunkerVR_FuelLeftReach, and squeezed
+	// takes it there (the mod's cVR_LeftAtPump, as for the cutters' second handle), drawn flat against
+	// it (its palm facing in), turned about that as the real hand was. Held so, the can is where both
+	// hands have it, an even share (BunkerVR_HeldBetween: the line between the hands, its up as the
+	// right hand's grip has it; tipped by raising the left hand), each hand drawn where it holds it;
+	// the right hand's squeeze is the hold's own (cVR_RightFitted). A shove of it then splashes fuel
+	// (VRUpdateFuelSplash). Let go of with the left hand, or that hand pulled gfVRFuelLetGoReach from
+	// where it is drawn, it is in the right hand alone again. Logged as "BunkerVR fuel:" (the first 40).
+	void VRUpdateFuelHands(float afTimeStep)
+	{
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		bool bCan = pMap !is null && Item_GetHeldType(eItemHandlerHand_Right) == "Fuel" && Item_GetHeldType(eItemHandlerHand_Left) == "";
+		cLuxProp@ pCan = bCan ? cLux_ToProp(pMap.GetEntityByName(Item_GetHeldEntity(eItemHandlerHand_Right))) : null;
+		cMatrixf mtxRight = cMatrixf_Identity;
+		cMatrixf mtxLeft = cMatrixf_Identity;
+		float fArmScale = 1.0f;
+		bool bHeld = pCan !is null && BunkerVR_ReadFollowedPalm(1, mtxRight, fArmScale) && BunkerVR_ReadFollowedPalm(0, mtxLeft, fArmScale);
+		if(bHeld == false)
+		{
+			if(mbVRFuelTwo) VRFuelLetGo("the can is put away, or a hand is not followed");
+			if(mbVRFuelAtWas) cVR_LeftAtPump(false);
+			mbVRFuelAtWas = false;
+			mbVRFuelPalmKnown = false;
+			mbVRFuelLeftOnWas = false;
+			mbVRHintFuelLeftAt = false;
+			return;
+		}
+		bool bLeftOn = VRLeftHoldsTool();
+		bool bLeftTook = bLeftOn && mbVRFuelLeftOnWas == false;
+		mbVRFuelLeftOnWas = bLeftOn;
+		if(bLeftOn == false) mbVRFuelBroke = false;
+
+		// One hand: is the left palm at the can's side, end or bottom (the can placed by the right
+		// palm of the update before)? Squeezed there, it takes the can.
+		if(mbVRFuelTwo == false)
+		{
+			if(mbVRFuelPalmKnown)
+			{
+				cMatrixf mtxNow = pCan.GetMatrix();
+				cMatrixf mtxToCan = cMath_MatrixInverse(mtxNow);
+				cVector3f vOut = cVector3f(0.0f, -1.0f, 0.0f);
+				cVector3f vOn = BunkerVR_FuelNearestOnCan(cMath_MatrixMul(mtxToCan, mtxLeft.GetTranslation()), vOut);
+				cVector3f vOnWorld = cMath_MatrixMul(mtxNow, vOn);
+				float fOff = (mtxLeft.GetTranslation() - vOnWorld).Length();
+				iPhysicsBody@ pOpening = pCan.GetBodyFromName("Opening");
+				float fFromOpening = pOpening !is null ? (vOnWorld - pOpening.GetWorldMatrix().GetTranslation()).Length() : 1.0f;
+				bool bAt = fOff <= gfBunkerVR_FuelLeftReach && vOn.y < gfBunkerVR_FuelLeftTopMost && (mbVRLidOff || fFromOpening > gfVRLidReach);
+				cVR_LeftAtPump(bAt);
+				mvVRHintFuelLeft = cMath_MatrixMul(mtxNow, cVector3f(0.0f, 0.02f, 0.0f)); // (the hint: under it)
+				mbVRHintFuelLeftAt = true;
+				if(bAt && mbVRFuelAtWas == false && mlVRFuelNotes < 12)
+					VRFuelNote("the left palm is at the can's " + VRFuelFaceName(vOut) + " (" + int(fOff * 100.0f + 0.5f) + " cm from it, " + int(vOn.y * 100.0f + 0.5f) +
+							   " cm up it): a squeeze takes it");
+				if(bLeftTook && (bAt || mbVRFuelAtWas) && mbVRFuelBroke == false)
+				{
+					mfVRFuelScale = cMath_Max(cMath_MatrixMul3x3(mtxNow, cVector3f(1.0f, 0.0f, 0.0f)).Length(), 0.01f);
+					// The right palm in the can's terms, as it held it; the left palm flat against it
+					// where it took it (its middle gfBunkerVR_FuelPalmOff off it, its palm, the hand's
+					// +x, facing in), turned about that as the real hand was.
+					m_mtxVRFuelRightIn = cMath_MatrixMul(mtxToCan, m_mtxVRFuelPalmWas);
+					cMatrixf mtxCanTurn = cMath_MatrixMul(mtxNow, cMath_MatrixScale(cVector3f(1.0f / mfVRFuelScale, 1.0f / mfVRFuelScale, 1.0f / mfVRFuelScale)));
+					cMatrixf mtxLeftTurn = cMath_MatrixMul(mtxCanTurn.GetRotation().GetTranspose(), mtxLeft.GetRotation()); // (unit: the left palm turned in the can's terms)
+					cVector3f vPalmWay = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxLeftTurn, cVector3f(1.0f, 0.0f, 0.0f)));
+					cMatrixf mtxFlat = cMath_MatrixMul(BunkerVR_TurnBetween(vPalmWay, vOut * -1.0f, cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxLeftTurn, cVector3f(0.0f, 1.0f, 0.0f)))), mtxLeftTurn);
+					m_mtxVRFuelLeftIn = cMath_MatrixMul(mtxFlat, cMath_MatrixScale(cVector3f(1.0f / mfVRFuelScale, 1.0f / mfVRFuelScale, 1.0f / mfVRFuelScale)));
+					m_mtxVRFuelLeftIn.SetTranslation(vOn + vOut * (gfBunkerVR_FuelPalmOff / mfVRFuelScale));
+					mbVRFuelTwo = true;
+					mbVRHintFuelLeftAt = false;
+					VRBuzzHand(0, 0.03f, 0.35f);
+					cVR_HintUsed("fuel_hold");
+					VRFuelNote("the left hand takes the can by its " + VRFuelFaceName(vOut) + " (" + int(fOff * 100.0f + 0.5f) + " cm from it, " +
+							   int(vOn.y * 100.0f + 0.5f) + " cm up it): held in both hands (a shove throws fuel)");
+				}
+				mbVRFuelAtWas = bAt;
+			}
+			m_mtxVRFuelPalmWas = mtxRight;
+			mbVRFuelPalmKnown = true;
+			if(mbVRFuelTwo == false) return;
+		}
+		if(bLeftOn == false)
+		{
+			VRFuelLetGo("the left hand lets go of it");
+			return;
+		}
+
+		// Both hands: where the can is (an even share), each hand drawn where it holds it. Its turn
+		// about the line between the hands as the right hand's grip has it, by whichever of its own
+		// axes lies most across that line (held under its bottom, the line runs nearly along its up).
+		cVector3f vAcrossIn = cMath_Vector3Normalize(m_mtxVRFuelLeftIn.GetTranslation() - m_mtxVRFuelRightIn.GetTranslation());
+		cVector3f vSecondIn = cVector3f(1.0f, 0.0f, 0.0f);
+		if(cMath_Abs(vAcrossIn.y) < cMath_Abs(vSecondIn.x * vAcrossIn.x)) vSecondIn = cVector3f(0.0f, 1.0f, 0.0f);
+		if(cMath_Abs(vAcrossIn.z) < cMath_Abs(cMath_Vector3Dot(vSecondIn, vAcrossIn))) vSecondIn = cVector3f(0.0f, 0.0f, 1.0f);
+		cVector3f vSecond = cMath_Vector3Normalize(cMath_MatrixMul3x3(cMath_MatrixMul(mtxRight, cMath_MatrixInverse(m_mtxVRFuelRightIn)), vSecondIn));
+		cMatrixf mtxCan = BunkerVR_HeldBetween(m_mtxVRFuelRightIn.GetTranslation(), m_mtxVRFuelLeftIn.GetTranslation(), mtxRight.GetTranslation(), mtxLeft.GetTranslation(),
+											   vSecondIn, vSecond, mfVRFuelScale);
+		cMatrixf mtxRightDrawn = cMath_MatrixMul(mtxCan, m_mtxVRFuelRightIn);
+		cMatrixf mtxLeftDrawn = cMath_MatrixMul(mtxCan, m_mtxVRFuelLeftIn);
+		float fLeftOff = (mtxLeft.GetTranslation() - mtxLeftDrawn.GetTranslation()).Length();
+		if(fLeftOff > gfVRFuelLetGoReach)
+		{
+			mbVRFuelBroke = true;
+			VRFuelLetGo("the left hand is pulled off it (" + int(fLeftOff * 100.0f + 0.5f) + " cm from where it is drawn)");
+			return;
+		}
+		cVR_LeftAtPump(true);
+		cVR_RightFitted();
+		VRFitPublish(mtxRightDrawn, mtxCan);
+		VRLeftFitPublish(mtxLeftDrawn);
+	}
+
+	// BunkerVR: the fuel can let go of with the left hand (VRUpdateFuelHands): in the
+	// right hand alone again, as its grip holds it.
+	void VRFuelLetGo(const tString &in asNote)
+	{
+		if(mbVRFuelTwo == false) return;
+		mbVRFuelTwo = false;
+		cScript_SetGlobalVarInt("BunkerVR_FitStamp", 0);
+		VRLeftFitEnd();
+		mbVRFuelPalmKnown = false;
+		VRFuelNote(asNote + ": in the right hand alone");
+	}
+
+	// BunkerVR: the can's side a way out of it is (its own terms: x its ends, the spout's +x; z its sides).
+	tString VRFuelFaceName(const cVector3f &in avOut)
+	{
+		if(avOut.y < -0.5f) return "bottom";
+		if(avOut.y > 0.5f) return "top";
+		if(avOut.x > 0.5f) return "spout's end";
+		if(avOut.x < -0.5f) return "other end";
+		return "side";
+	}
+
+	// BunkerVR: a "BunkerVR fuel:" line in hpl.log (the first 40).
+	void VRFuelNote(const tString &in asText)
+	{
+		if(mlVRFuelNotes >= 40) return;
+		mlVRFuelNotes++;
+		Log("BunkerVR fuel: " + asText + "\n");
+	}
+
+	// BunkerVR: one splash of fuel from the can (see VRUpdateFuelSplash).
+	void VRFuelSplash(cLuxMap@ apMap, cLuxProp@ apCan, const cMatrixf &in a_mtxOpening, const cVector3f &in avVelocity)
+	{
+		mlVRFuelSplashes++;
+		mlVRFuelSpills++;
+		cParticleSystem@ pSplash = apCan.CreateParticleSystem("VRFuelSplash_" + mlVRFuelSpills, "fuel_throw.ps", true, false);
+		if(pSplash !is null) pSplash.SetWorldMatrix(a_mtxOpening);
+		VRPlayTrySound(apCan, "BunkerVR_FuelSplash", gvVRFuelSplashSounds, 1.0f);
+		VRBuzzHand(1, 0.08f, 0.7f);
+		VRBuzzHand(0, 0.08f, 0.6f); // (both hands on it)
+		cVR_HintUsed("fuel_splash");
+		cScript_SetGlobalVarBool("HasUsedFuelItem", true); // (as the game's throw)
+
+		// Where it lands: along the flick's level way, as far as it was fast
+		// (short of a wall), then down onto what is below.
+		float fSpeed = avVelocity.Length();
+		cVector3f vDir = cMath_Vector3Normalize(cVector3f(avVelocity.x, 0.0f, avVelocity.z));
+		float fReach = BunkerVR_FuelSplashReach(fSpeed);
+		cVector3f vFrom = a_mtxOpening.GetTranslation() + vDir * 0.15f; // (clear of the can)
+		float fHitDist = 0.0f;
+		cVector3f vHitNrm = cVector3f(0.0f, 1.0f, 0.0f);
+		iPhysicsBody@ pWall = cLux_GetClosestBody(vFrom, vDir, fReach, fHitDist, vHitNrm);
+		if(pWall is null) fHitDist = fReach;
+		cVector3f vTarget = vFrom + vDir * cMath_Max(fHitDist - 0.1f, 0.0f);
+		iPhysicsBody@ pGround = cLux_GetClosestBody(vTarget, cVector3f_Down, 100.0f, fHitDist, vHitNrm);
+		tString sWhere = "nothing below it";
+		if(pGround !is null)
+		{
+			vTarget = vTarget + cVector3f_Down * (fHitDist - 0.01f);
+			sWhere = "a spill " + BunkerVR_Fixed((vTarget - a_mtxOpening.GetTranslation()).Length(), 2) + " m away";
+			if((vTarget - mvVRFuelLastSpill).Length() > 0.75f)
+			{
+				mvVRFuelLastSpill = vTarget;
+				cVector3f vRight = cMath_Vector3Cross(vHitNrm, cVector3f_Forward);
+				cVector3f vFwd = cMath_Vector3Cross(vRight, vHitNrm);
+				cMatrixf mtxSpill = cMath_MatrixUnitVectors(vRight, vHitNrm, vFwd, vTarget);
+				apMap.CreateEntity(apCan.GetName() + "_VRspill_" + mlVRFuelSpills, "fuel_spill.ent", mtxSpill, cVector3f(1.0f));
+				iLuxEntity@ pSpill = apMap.GetLatestEntity();
+				if(pSpill !is null && pSpill.GetMeshEntity() !is null)
+				{
+					pSpill.SetVarBool("SpillGenerated", true);
+					Player_AddAimAssistTarget(pSpill.GetID());
+					cMeshEntity@ pSpillMesh = pSpill.GetMeshEntity();
+					pSpillMesh.SetRenderLayer(2); // (above the world's other decals, as the game's)
+					cSubMeshEntity@ pSub = pSpillMesh.GetSubMeshEntity(0);
+					if(pSub !is null && pSub.GetMaterial() !is null) pSub.SetCurrentSubDiv(cMath_RandRectl(0, pSub.GetMaterial().GetUvSubDivNum() - 1));
+					// (On a thing that moves: it goes with it.)
+					iLuxEntity@ pOn = cLux_GetBodyEntity(pGround);
+					if(pOn !is null && pOn.GetMeshEntity() !is null && pOn.GetMeshEntity().IsStatic() == false)
+						pSpill.AttachToEntity(pOn, pGround, true, false, false);
+				}
+			}
+			else sWhere += " (within 0.75 m of the last: no new spill)";
+		}
+		Log("BunkerVR: FUEL: splash " + mlVRFuelSplashes + " of " + glBunkerVR_FuelSplashes + " by a throw at " + BunkerVR_Fixed(fSpeed, 1) + " m/s: " + sWhere + "\n");
+
+		// The can empty: used up, as after the game's own throw.
+		if(mlVRFuelSplashes >= glBunkerVR_FuelSplashes)
+		{
+			tString sItem = Item_GetHeld(eItemHandlerHand_Right);
+			Item_SetPlayUnequipAnim(sItem, false);
+			Item_Unequip(sItem, true);
+			Item_RemoveFromInventory(sItem);
+			Log("BunkerVR: FUEL: the can is empty: used up\n");
+		}
+	}
+
+	// BunkerVR: the flare's cord (see "the flare by hand" in
+	// PlayerState_UsingFlare.hps). The flare in the right hand, not lit, and
+	// the left hand empty: the left palm at the cap on the end of its handle
+	// (within gfBunkerVR_FlareCordTake) is told to the mod (cVR_LeftAtPump, as
+	// for the shotgun's fore-end); squeezed there, the left hand has the cord
+	// (the mod's word: VRLeftHoldsTool). Then the fingers' distance from the
+	// handle's end draws the cord out (BunkerVR_FlareCapOut; drawn to the
+	// fingers by Prop_PlayerBody.hps, VRUpdateFlareInHand, from
+	// "BunkerVR_FlareCord"), with a tick in the hands every 3 cm; out to
+	// gfBunkerVR_FlareLightAt the flare is lit (State_UsingFlare's
+	// _Global_VRIgnite). Let go sooner, the cord goes back in. Lit: its throw
+	// move is told to the mod (see the moves' news); and once the flare is no
+	// longer in the right hand (put away, swapped, dropped, or the level gone)
+	// the burning one is let fall (_Global_VRDropLit).
+	void VRUpdateFlare(float afTimeStep)
+	{
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		cScript_SetGlobalVarFloat("BunkerVR_FlareCord", -100.0f);
+		bool bFlare = pMap !is null && Item_GetHeldType(eItemHandlerHand_Right) == "Flare";
+		tString sHand = bFlare ? Item_GetHeldEntity(eItemHandlerHand_Right) : "";
+		tString sLit = cScript_GetGlobalVarString("BunkerVR_FlareLit");
+		mbVRFlareLitNow = false;
+		if(sLit != "")
+		{
+			iLuxEntity@ pLit = pMap !is null ? pMap.GetEntityByName(sLit) : null;
+			if(pLit is null || sHand != cScript_GetGlobalVarString("BunkerVR_FlareLitHand"))
+			{
+				VRFlareNote(pLit is null ? "the burning flare is gone (the level left?): forgotten" : "the burning flare is out of the hand: it falls");
+				cScript_SetGlobalArgVector3f(0, cVector3f(0.0f));
+				cScript_RunGlobalFunc("State_UsingFlare", "", "_Global_VRDropLit");
+				VRFlareLetGoCord(false);
+				return;
+			}
+			mbVRFlareLitNow = true;
+			VRFlareLetGoCord(false);
+			return;
+		}
+		if(bFlare == false)
+		{
+			VRFlareLetGoCord(true);
+			return;
+		}
+		cLuxProp@ pHand = cLux_ToProp(pMap.GetEntityByName(sHand));
+		cMeshEntity@ pMesh = pHand !is null ? pHand.GetMeshEntity() : null;
+		cBoneState@ pRoot = pMesh !is null ? pMesh.GetBoneStateFromName("j_flare") : null;
+		cMatrixf mtxLeft = cMatrixf_Identity;
+		float fArmScale = 1.0f;
+		bool bLeft = Item_GetHeldType(eItemHandlerHand_Left) == "" && BunkerVR_ReadFollowedPalm(0, mtxLeft, fArmScale);
+		if(pRoot is null || bLeft == false)
+		{
+			VRFlareLetGoCord(true);
+			return;
+		}
+
+		// The flare's own measures: its handle's end, its cap's middle, and how
+		// long one of its centimeters is in the world (its model in cm, or in m
+		// with the bones carrying the 1/100: as the flashlight's string).
+		cMatrixf mtxRoot = pRoot.GetWorldMatrix();
+		cMatrixf mtxRest = mtxRoot;
+		mtxRest.SetTranslation(cVector3f(0.0f));
+		float fSize = cMath_MatrixMul3x3(mtxRest, cVector3f(0.0f, 1.0f, 0.0f)).Length();
+		if(fSize < 0.000001f) return;
+		float fUnit = fSize < 0.1f ? 1.0f : 0.01f;
+		float fCm = fSize * fUnit;
+		cVector3f vExit = cMath_MatrixMul(mtxRoot, cVector3f(0.0f, gfBunkerVR_FlareExit * fUnit, 0.0f));
+		cVector3f vCap = cMath_MatrixMul(mtxRoot, cVector3f(0.0f, (gfBunkerVR_FlareCapAt - gfBunkerVR_FlareCapHalf) * fUnit, 0.0f));
+		mvVRHintFlareCap = vCap;
+
+		bool bLeftOn = VRLeftHoldsTool();
+		if(mbVRFlareCordHeld == false)
+		{
+			bool bAt = (mtxLeft.GetTranslation() - vCap).Length() <= gfBunkerVR_FlareCordTake;
+			cVR_LeftAtPump(bAt);
+			if(bLeftOn && mbVRFlareLeftOnWas == false && (bAt || mbVRFlareAtWas))
+			{
+				mbVRFlareCordHeld = true;
+				mfVRFlareCapOutWas = 0.0f;
+				VRBuzzHand(0, 0.03f, 0.5f);
+				VRFlareNote("the left hand takes the cord's cap (its palm " + int((mtxLeft.GetTranslation() - vCap).Length() * 100.0f) + " cm from it)");
+			}
+			mbVRFlareAtWas = bAt;
+		}
+		mbVRFlareLeftOnWas = bLeftOn;
+		if(mbVRFlareCordHeld == false) return;
+		if(bLeftOn == false)
+		{
+			VRFlareNote("the cord let go of " + int(mfVRFlareCapOutWas) + " cm out, before it lit: it goes back in");
+			VRFlareLetGoCord(true);
+			return;
+		}
+		cVR_LeftAtPump(true);
+
+		// Drawn out to the fingers.
+		float fCapOut = BunkerVR_FlareCapOut((VRLeftPinchPoint(mtxLeft) - vExit).Length() / fCm);
+		cScript_SetGlobalVarFloat("BunkerVR_FlareCord", fCapOut);
+		if(int(fCapOut / 3.0f) > int(mfVRFlareCapOutWas / 3.0f) && fCapOut > 0.0f) VRBuzzHand(0, 0.02f, 0.35f);
+		mfVRFlareCapOutWas = fCapOut;
+		if(fCapOut < gfBunkerVR_FlareLightAt) return;
+
+		// Out far enough: lit.
+		cScript_RunGlobalFunc("State_UsingFlare", "", "_Global_VRIgnite");
+		if(cScript_GetGlobalVarString("BunkerVR_FlareLit") == "") return;
+		cScript_SetGlobalVarFloat("BunkerVR_FlareCord", -100.0f);
+		cVR_HintUsed("flare_cord");
+		VRBuzzHand(0, 0.12f, 0.9f);
+		VRBuzzHand(1, 0.3f, 0.6f);
+		VRFlareNote("the cord pulled " + int(fCapOut) + " cm of the model out: lit");
+		mbVRFlareCordHeld = false;
+		mbVRFlareLitNow = true;
+	}
+
+	// BunkerVR: the flare's cord no longer held (or never): the mod told so.
+	void VRFlareLetGoCord(bool abTellMod)
+	{
+		if(abTellMod && (mbVRFlareCordHeld || mbVRFlareAtWas)) cVR_LeftAtPump(false);
+		mbVRFlareCordHeld = false;
+		mbVRFlareAtWas = false;
+		mfVRFlareCapOutWas = 0.0f;
+	}
+
+	// BunkerVR: where the left hand's thumb and first finger meet, from the
+	// body's own finger bones (as the shotgun's VRLeftPinch); failing that, a
+	// little above the palm.
+	cVector3f VRLeftPinchPoint(const cMatrixf &in a_mtxPalm)
+	{
+		cVector3f vPinch = a_mtxPalm.GetTranslation() + cMath_MatrixMul3x3(a_mtxPalm, cVector3f(0.0f, 0.03f, -0.01f));
+		iLuxEntity@ pBody = cLux_ID_Entity(PlayerBody_GetEntityID());
+		cMeshEntity@ pBodyMesh = pBody !is null ? pBody.GetMeshEntity() : null;
+		if(pBodyMesh is null) return vPinch;
+		cBoneState@ pIndexA = pBodyMesh.GetBoneStateFromName("j_L_Index_3");
+		cBoneState@ pIndexB = pBodyMesh.GetBoneStateFromName("j_L_Index_4");
+		cBoneState@ pThumb = pBodyMesh.GetBoneStateFromName("j_L_Thumb_3");
+		if(pIndexA is null || pIndexB is null || pThumb is null) return vPinch;
+		cVector3f vIndexPad = pIndexA.GetWorldPosition() + (pIndexB.GetWorldPosition() - pIndexA.GetWorldPosition()) * 0.6f;
+		return (vIndexPad + pThumb.GetWorldPosition()) * 0.5f;
+	}
+
+	// BunkerVR: a "BunkerVR: FLARE:" line in hpl.log (the first 40).
+	void VRFlareNote(const tString &in asText)
+	{
+		if(mlVRFlareNotes >= 40) return;
+		mlVRFlareNotes++;
+		Log("BunkerVR: FLARE: " + asText + "\n");
+	}
+
+	// BunkerVR: the fit, the hands-on items' shared "bring it to something"
+	// move. An item with a fit (BunkerVR_ItemFit in helper_bunkervr_items.hps:
+	// the keys and the fuse) in the right hand: its tip brought to
+	// the face of what the game says it is used on (its "use" box, the same one
+	// the game's use button looks for), pointing in, starts the fit
+	// (cBunkerVRFit in helper_bunkervr.hps): pushed in, it goes in along the
+	// box's middle, and the rest of the way by itself; then a turn of the wrist
+	// the way it unlocks (stiffly) throws its bolt, or twists of the wrist
+	// screw it in (the fuse), and it is used there, as the game's use
+	// button does (Item_UseHeldOnWorld, after the game's own "can it be used";
+	// the levels' scripts then do in VR what their scene does:
+	// maintenance.hps OnUse_PillboxKey, soldier_quarters.hps
+	// OnUse_CommunicationsKey, helper_props_custom.hps Fuse_OnUse). Meanwhile
+	// the right hand is drawn where that puts the item ("BunkerVR_FitStamp" and
+	// the hand's place, read by UpdateVRArms in Prop_PlayerBody.hps), and
+	// "BunkerVR_FitIn" says the item is in (the levels put the game's used key,
+	// or the fuse box's own fuse, where the held one is). Pulled
+	// back out, or the hand gone off, it comes out and is in the hand again.
+	// Its grip in the hand is taken as it starts (where the hand placed it from
+	// the palm of the update before). Every start, end and use is logged
+	// ("BunkerVR fit:" in hpl.log, the first 60).
+	void VRUpdateFit(float afTimeStep)
+	{
+		if(mbVRWrenchOn || mbVRCuttersTwo || mbVRFuelTwo) return; // (the wrench on a bolt, the cutters or the fuel can in both hands, draw the hand themselves: VRUpdateWrench, VRUpdateCutters, VRUpdateFuelHands)
+		tString sType = Item_GetHeldType(eItemHandlerHand_Right);
+		cVector3f vTip = cVector3f(0.0f);
+		cVector3f vPoints = cVector3f(0.0f);
+		float fDepth = 0.0f;
+		float fTurn = 0.0f;
+		float fThread = 0.0f;
+		tString sSoundBolt = "";
+		tString sSoundForced = "";
+		bool bFits = BunkerVR_ItemFit(sType, vTip, vPoints, fDepth, fTurn, fThread, sSoundBolt, sSoundForced);
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		cLuxProp@ pThing = bFits && pMap !is null ? cLux_ToProp(pMap.GetEntityByName(Item_GetHeldEntity(eItemHandlerHand_Right))) : null;
+		cMatrixf mtxPalm = cMatrixf_Identity;
+		float fArmScale = 1.0f;
+		if(pThing is null || BunkerVR_ReadFollowedPalm(1, mtxPalm, fArmScale) == false)
+		{
+			// (Only a fit that was on is ended: the right hand drawn on the exit's detonator or its cable by the finale,
+			// with no item, uses the same place to be drawn at, VRFinaleDrawHand.)
+			if(mVRFit.mlState != 0) VRFitEnd("");
+			m_idVRFitThing = tID_Invalid;
+			mbVRFitPalmKnown = false;
+			return;
+		}
+		if(pThing.GetID() != m_idVRFitThing)
+		{
+			VRFitEnd("");
+			m_idVRFitThing = pThing.GetID();
+			mbVRFitPalmKnown = false;
+		}
+		if(mfVRFitRest > 0.0f) mfVRFitRest -= afTimeStep;
+
+		// Not in: what it goes into, from where it is (placed by the hand from
+		// the palm of the update before).
+		if(mVRFit.mlState == 0 && mbVRFitPalmKnown && mfVRFitRest <= 0.0f)
+		{
+			cMatrixf mtxThing = pThing.GetMatrix();
+			tString sTarget = "";
+			cVector3f vAlong = cVector3f(0.0f);
+			cVector3f vFace = cVector3f(0.0f);
+			if(VRFitFindTarget(mtxThing, vTip, vPoints, sTarget, vAlong, vFace))
+			{
+				m_mtxVRFitGrip = cMath_MatrixMul(cMath_MatrixInverse(m_mtxVRFitPalmWas), mtxThing);
+				mVRFit.Start(cMath_MatrixMul(mtxPalm, m_mtxVRFitGrip), vTip, vPoints, vAlong, vFace, fDepth, fTurn, fThread);
+				msVRFitTarget = sTarget;
+				mbVRFitUsed = false;
+				cScript_SetGlobalVarInt("BunkerVR_FitIn", 1);
+				VRBuzzHand(1, 0.03f, 0.35f);
+				VRFitNote("the " + sType + " goes into " + sTarget + ", its tip " + int(mVRFit.mfIn * 100.0f) + " cm in; in along " + VRFitText(vAlong) +
+						  " (hundredths), the face's middle at " + VRFitText(vFace) + " cm");
+			}
+		}
+
+		if(mVRFit.mlState > 0)
+		{
+			cMatrixf mtxFree = cMath_MatrixMul(mtxPalm, m_mtxVRFitGrip);
+			int lWas = mVRFit.mlState;
+			// The grip held: a screw turns only then. Read from the grip button
+			// itself (cVR_HandSqueeze: the fingers' curl stays the item's pose
+			// while it is held). The mod is told that a right squeeze is the
+			// fit's own meanwhile (cVR_RightFitted), not the game's use button;
+			// otherwise pressing the grip to twist the fuse would use it at once.
+			mVRFit.mbGripped = cVR_HandSqueeze(1) > (mVRFit.mbGripped ? gfVRFitGripLetGo : gfVRFitGripPress);
+			cVR_RightFitted();
+			if(mVRFit.Step(mtxFree, mtxPalm, afTimeStep) == false)
+			{
+				VRFitEnd("the " + sType + " comes out of " + msVRFitTarget);
+			}
+			else
+			{
+				// What the step did, felt and heard: a pin passed going in, a light
+				// tick; all the way in, a firm one; a stiff turn, a grind growing as
+				// the bolt comes near; forced the wrong way, the lock's rattle; the
+				// bolt gone, its sound and a strong buzz (only if the game still
+				// says it can be used there: otherwise it comes out).
+				// A screw: its thread caught, the firm tick; screwed in, a tick
+				// every 15 degrees growing as it comes tight; taken hold of with the
+				// grip, a light tick, and let go of, the faintest; tight, as the bolt.
+				int lEvents = mVRFit.mlEvents;
+				bool bScrew = mVRFit.mfThread > 0.0f;
+				if((lEvents & glBunkerVR_FitPin) != 0 && (lEvents & glBunkerVR_FitSeated) == 0) VRBuzzHand(1, 0.015f, 0.22f);
+				if((lEvents & glBunkerVR_FitSeated) != 0)
+				{
+					cVR_HintUsed(bScrew ? "fuse_in" : "key_in");
+					VRBuzzHand(1, 0.04f, 0.55f);
+					VRFitNote("the " + sType + (bScrew ? " sits in " + msVRFitTarget + ", its thread caught: to be screwed in, the grip held" : " is all the way into " + msVRFitTarget));
+				}
+				if((lEvents & glBunkerVR_FitGrind) != 0)
+					VRBuzzHand(1, 0.025f, 0.2f + 0.45f * cMath_Clamp(mVRFit.mfKeyTurn / cMath_Max(mVRFit.mfTurnNeeded, 0.01f), 0.0f, 1.0f));
+				if((lEvents & glBunkerVR_FitHoldNow) != 0)
+				{
+					VRBuzzHand(1, 0.015f, 0.25f);
+					VRFitNote("the " + sType + " is taken hold of with the grip (turned " + int(cMath_ToDeg(mVRFit.mfKeyTurn)) + " degrees so far)");
+				}
+				if((lEvents & glBunkerVR_FitLetGoNow) != 0)
+				{
+					VRBuzzHand(1, 0.01f, 0.12f);
+					VRFitNote("the " + sType + "'s grip let go of (turned " + int(cMath_ToDeg(mVRFit.mfKeyTurn)) + " degrees so far)");
+				}
+				if((lEvents & glBunkerVR_FitForcedNow) != 0)
+				{
+					VRBuzzHand(1, 0.06f, 0.6f);
+					if(sSoundForced != "") Sound_CreateAtEntity("BunkerVR_FitForced", sSoundForced, msVRFitTarget, 0.0f, false);
+					VRFitNote("the " + sType + " is forced the wrong way in " + msVRFitTarget);
+				}
+				if((lEvents & glBunkerVR_FitThrown) != 0)
+				{
+					if(Item_GetCanUseOnWorld(eItemHandlerHand_Right, msVRFitTarget) == false)
+					{
+						VRFitEnd("the " + sType + " is turned in " + msVRFitTarget + ", but the game says it cannot be used there now");
+						m_mtxVRFitPalmWas = mtxPalm;
+						mbVRFitPalmKnown = true;
+						return;
+					}
+					VRBuzzHand(1, 0.12f, 0.9f);
+					if(sSoundBolt != "") Sound_CreateAtEntity("BunkerVR_FitBolt", sSoundBolt, msVRFitTarget, 0.0f, false);
+					if(bScrew)
+						VRFitNote("the " + sType + " is screwed tight in " + msVRFitTarget + " (turned " + int(cMath_ToDeg(mVRFit.mfKeyTurn)) + " degrees; the wrist now " +
+								  int(cMath_ToDeg(mVRFit.mfTurn)) + " from where its thread caught)");
+					else
+						VRFitNote("the " + sType + "'s bolt goes in " + msVRFitTarget + " (the wrist turned " + int(cMath_ToDeg(mVRFit.mfTurn)) + " degrees, the key " +
+								  int(cMath_ToDeg(mVRFit.mfKeyTurn)) + ")");
+				}
+				VRFitPublish(mVRFit.HandFor(mtxFree, mtxPalm), mVRFit.Placed());
+				// Turned on to the end of its turn: used there, as the game's use button does.
+				if(mVRFit.mlState == 4 && mbVRFitUsed == false)
+				{
+					mbVRFitUsed = true;
+					cVR_HintUsed(bScrew ? "fuse_turn" : "key_turn");
+					if(Item_GetCanUseOnWorld(eItemHandlerHand_Right, msVRFitTarget))
+					{
+						VRFitNote("the " + sType + " is used on " + msVRFitTarget + " (the game's own use)");
+						Item_UseHeldOnWorld(eItemHandlerHand_Right, msVRFitTarget);
+					}
+					else
+					{
+						VRFitEnd("the " + sType + " is all the way in " + msVRFitTarget + ", but the game says it cannot be used there now");
+					}
+				}
+			}
+		}
+		m_mtxVRFitPalmWas = mtxPalm;
+		mbVRFitPalmKnown = true;
+	}
+
+	// BunkerVR: the hints on the objects (helper_bunkervr_hints.hps, the
+	// mod's hints.cpp). Every update, for each hand: the hint for what it is
+	// at, and where (cVR_Hint), the first that would show of: what another
+	// script offers for it (the shotgun, a button, the number lock), what the
+	// item held asks of it, what an empty hand touches. If none applies, the mod
+	// gives its own if it has one (the holster, the pouch, the flashlight at the
+	// chest, the revolver, the bandage, the grenade, the lighter, a thing to
+	// throw), for which it is told what the player carries (cVR_HintCarried).
+	void VRUpdateHints(float afTimeStep)
+	{
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		if(pPlayer is null || pMap is null) return;
+
+		// What the player carries (hints.h kCarry...), looked at twice a second.
+		float fNow = float(cEngine_GetGameTime());
+		if(fNow - mfVRHintCarriedAt > 0.5f || fNow < mfVRHintCarriedAt)
+		{
+			mfVRHintCarriedAt = fNow;
+			mlVRHintCarried = 0;
+			if(ItemType_GetFirstInInventory("Gun") != "") mlVRHintCarried |= 1;
+			if(ItemType_GetFirstInInventory("Shotgun") != "") mlVRHintCarried |= 2;
+			if(ItemType_GetFirstInInventory("DynamoLantern") != "") mlVRHintCarried |= 4;
+			if(ItemType_GetCountInInventory("Ammunition") > 0) mlVRHintCarried |= 8;
+			if(ItemType_GetCountInInventory("ShotgunAmmunition") > 0) mlVRHintCarried |= 16;
+			tString sSlotType = Item_GetAssignedToHotkey(1); // (the right chest's item slot is the game's hotkey 1)
+			if(sSlotType != "" && ItemType_GetFirstInInventory(sSlotType) != "") mlVRHintCarried |= 32;
+		}
+		// (Whether the item in the right hand may go into the right chest's item slot, every
+		// update: the hand's item changes at once. Looked at again only when it is another item.)
+		tString sSlotHeld = Item_GetHeld(eItemHandlerHand_Right);
+		if(sSlotHeld != msVRSlotCheckedID)
+		{
+			msVRSlotCheckedID = sSlotHeld;
+			mbVRSlotCheckedTakes = VRChestSlotTakes(sSlotHeld);
+		}
+		cVR_HintCarried(mbVRSlotCheckedTakes ? (mlVRHintCarried | 64) : mlVRHintCarried);
+
+		bool bNormal = pPlayer.GetCurrentStateId() == ePlayerState_Normal;
+		tString sRight = Item_GetHeldType(eItemHandlerHand_Right);
+		tString sLeft = Item_GetHeldType(eItemHandlerHand_Left);
+		iLuxEntity@ pRightThing = sRight != "" ? pMap.GetEntityByName(Item_GetHeldEntity(eItemHandlerHand_Right)) : null;
+		bool bMaskOn = mlVRMaskHand < 0 && mbVRHintFaceKnown && Player_GetGasMaskEquipped();
+		for(int h = 0; h < 2; ++h)
+		{
+			array<tString> vKeys;
+			array<cVector3f> vAt;
+
+			// Offered by another script.
+			cVector3f vOffered;
+			tString sOffered = BunkerVR_HintOffered(h, vOffered);
+			if(sOffered != "")
+			{
+				vKeys.push_back(sOffered);
+				vAt.push_back(vOffered);
+			}
+
+			// The finale's step for this hand (VRUpdateFinale).
+			if(mvVRFinaleHintKey[h] != "")
+			{
+				vKeys.push_back(mvVRFinaleHintKey[h]);
+				vAt.push_back(mvVRFinaleHintAt[h]);
+			}
+
+			// What the item in the right hand asks of this hand.
+			if(pRightThing !is null)
+				VRHintsForItem(h, sRight, sLeft, pRightThing, vKeys, vAt);
+
+			// The gas mask in this hand (VRUpdateMask): put on at
+			// the face. On the face, an empty hand near it: taken off.
+			// (The palm asked for only then.)
+			cMatrixf mtxPalm;
+			float fArmScale;
+			bool bMaskHere = mlVRMaskHand == h || (bMaskOn && (h == 0 ? sLeft : sRight) == "");
+			bool bPalm = bMaskHere && BunkerVR_ReadFollowedPalm(h, mtxPalm, fArmScale);
+			if(bPalm && mlVRMaskHand == h)
+			{
+				vKeys.push_back("mask_on");
+				vAt.push_back(mtxPalm.GetTranslation());
+			}
+			else if(bPalm && bMaskOn && (mtxPalm.GetTranslation() - mvVRHintFace).Length() < gfVRHintMaskNear)
+			{
+				vKeys.push_back("mask_off");
+				vAt.push_back(mtxPalm.GetTranslation());
+			}
+
+			// A thing held loose by this hand: thrown by a swing.
+			tID idHold = h == 0 ? mVRHoldLeft.m_idBody : mVRHoldRight.m_idBody;
+			bool bHoldLoose = h == 0 ? (mVRHoldLeft.mbHelping == false && mVRHoldLeft.mbHeavy == false) : (mVRHoldRight.mbHelping == false && mVRHoldRight.mbHeavy == false);
+			iPhysicsBody@ pHeld = idHold != tID_Invalid && bHoldLoose ? cLux_ID_Body(idHold) : null;
+			if(pHeld is null && pPlayer.GetCurrentStateId() == ePlayerState_Grab && cScript_GetGlobalVarInt("BunkerVR_GrabHand") == h &&
+			   cScript_GetGlobalVarBool("BunkerVR_GrabHeavy") == false && cMath_Abs(fNow - cScript_GetGlobalVarFloat("BunkerVR_GrabTime")) < 0.25f)
+				@pHeld = cLux_ID_Body(cScript_GetGlobalVarID("BunkerVR_GrabBody"));
+			if(pHeld !is null)
+			{
+				vKeys.push_back("throw");
+				vAt.push_back(pHeld.GetWorldPosition());
+			}
+
+			// What an empty hand touches (only in the game's ordinary state,
+			// where a squeeze takes hold of it), its hint worked out again for
+			// a new thing, or twice a second.
+			tString sHand = h == 0 ? "0" : "1";
+			float fTouchAge = fNow - cScript_GetGlobalVarFloat("BunkerVR_TouchTime" + sHand);
+			if(bNormal && (h == 0 ? sLeft : sRight) == "" && fTouchAge > -0.001f && fTouchAge < 0.25f)
+			{
+				tID idTouched = cScript_GetGlobalVarID("BunkerVR_TouchEntity" + sHand);
+				iLuxEntity@ pTouched = cLux_ID_Entity(idTouched);
+				iPhysicsBody@ pTouchedBody = cLux_ID_Body(cScript_GetGlobalVarID("BunkerVR_TouchBody" + sHand));
+				if(pTouched !is null && pTouchedBody !is null)
+				{
+					if(idTouched != mvVRHintTouchId[h] || fNow - mvVRHintTouchAt[h] > 0.5f || fNow < mvVRHintTouchAt[h])
+					{
+						mvVRHintTouchId[h] = idTouched;
+						mvVRHintTouchAt[h] = fNow;
+						mvVRHintTouchKey[h] = BunkerVR_HintForThing(pTouched.GetInteractIconId(0, pTouchedBody), VRHintThing(pMap, pTouched));
+					}
+					if(mvVRHintTouchKey[h] != "")
+					{
+						vKeys.push_back(mvVRHintTouchKey[h]);
+						vAt.push_back(cScript_GetGlobalVarVector3f("BunkerVR_TouchSpot" + sHand));
+					}
+				}
+			}
+
+			// The first that would show.
+			for(uint i = 0; i < vKeys.length(); ++i)
+			{
+				if(cVR_HintWanted(vKeys[i]) == false) continue;
+				cVR_Hint(h, vKeys[i], vAt[i].x, vAt[i].y, vAt[i].z);
+				break;
+			}
+		}
+	}
+
+	// BunkerVR: the hints the item in the right hand (asType, apThing) asks of a
+	// hand (alHand), in order, with where each is (see VRUpdateHints).
+	void VRHintsForItem(int alHand, const tString &in asType, const tString &in asLeftType, iLuxEntity@ apThing, array<tString> &inout avKeys, array<cVector3f> &inout avAt)
+	{
+		cVector3f vThing = apThing.GetPosition();
+		bool bLeftFree = asLeftType == "";
+		if(asType == "Wrench")
+		{
+			if(alHand != 1) return;
+			avKeys.push_back(mbVRWrenchOn ? "wrench_turn" : "wrench_fit");
+			avAt.push_back(mbVRWrenchOn ? mvVRWrenchMouth : vThing);
+		}
+		else if(asType == "Cutters")
+		{
+			if(mbVRCuttersTwo == false)
+			{
+				if(alHand == 0 && bLeftFree)
+				{
+					avKeys.push_back("cutters_hold");
+					avAt.push_back(vThing);
+				}
+			}
+			else if(alHand == 1)
+			{
+				bool bBiting = mVRCut.mlState == 1;
+				avKeys.push_back(bBiting ? "cutters_cut" : "cutters_aim");
+				avAt.push_back(bBiting ? mvVRCutPin : vThing);
+			}
+		}
+		else if(asType == "PillboxKey" || asType == "CommunicationsKey" || asType == "Fuse")
+		{
+			if(alHand != 1 || m_idVRFitThing != apThing.GetID() || mVRFit.mlState >= 4) return;
+			bool bKey = asType != "Fuse";
+			bool bIn = mVRFit.mlState >= 2;
+			avKeys.push_back(bKey ? (bIn ? "key_turn" : "key_in") : (bIn ? "fuse_turn" : "fuse_in"));
+			avAt.push_back(vThing);
+		}
+		else if(asType == "Fuel" || asType == "FuelBottle")
+		{
+			if(m_idVRPourVessel != apThing.GetID()) return;
+			if(mbVRLidOff == false)
+			{
+				if(alHand == 0 && bLeftFree)
+				{
+					avKeys.push_back("lid_open");
+					avAt.push_back(mvVRHintOpening);
+				}
+			}
+			else if(alHand == 1 && VRHintPourNear(mvVRHintOpening))
+			{
+				avKeys.push_back("pour");
+				avAt.push_back(mvVRHintOpening);
+			}
+			else if(alHand == 1 && asType == "Fuel" && mbVRFuelTwo)
+			{
+				// (Away from what it is poured into, held in both hands: a shove splashes it.)
+				avKeys.push_back("fuel_splash");
+				avAt.push_back(mvVRHintOpening);
+			}
+			else if(alHand == 0 && asType == "Fuel" && mbVRFuelTwo == false && bLeftFree && mbVRHintFuelLeftAt)
+			{
+				// (The left hand takes it underneath, or by its end.)
+				avKeys.push_back("fuel_hold");
+				avAt.push_back(mvVRHintFuelLeft);
+			}
+		}
+		else if(asType == "EmptyBottle" || asType == "EmptyMolotovCocktail")
+		{
+			// (At the fuel tap: its lever's handle, for the left hand; VRUpdateFuelTap.)
+			if(alHand == 0 && bLeftFree && mbVRTapNearNow && mbVRTapHeld == false)
+			{
+				avKeys.push_back("tap_turn");
+				avAt.push_back(mvVRTapHintAt);
+			}
+		}
+		else if(asType == "Flare")
+		{
+			// (The cord at the end of its handle, for the left hand. Once lit,
+			// the mod's own Throw for the right hand.)
+			if(alHand == 0 && bLeftFree && mbVRFlareLitNow == false && cScript_GetGlobalVarString("BunkerVR_FlareLit") == "")
+			{
+				avKeys.push_back("flare_cord");
+				avAt.push_back(mvVRHintFlareCap);
+			}
+		}
+		else if(asType == "MolotovCocktail")
+		{
+			if(alHand == 1 && m_idVRMolotovLit == tID_Invalid)
+			{
+				avKeys.push_back("light_it");
+				avAt.push_back(vThing);
+			}
+		}
+		else if(asType == "Torch")
+		{
+			if(alHand != 1) return;
+			cLuxProp@ pTorch = VRHeldTorch();
+			if(pTorch is null) return;
+			if(VRTorchWaitingForFlame(pTorch))
+			{
+				avKeys.push_back("light_it");
+				avAt.push_back(vThing);
+			}
+			else if(pTorch.GetEffectsActive() && mbVRBrandishing == false)
+			{
+				avKeys.push_back("torch_out");
+				avAt.push_back(vThing);
+			}
+		}
+		else if(asType == "PocketWatch")
+		{
+			if(alHand != 1) return; // (the right trigger winds and starts it)
+			if(cScript_GetGlobalVarInt("BunkerVR_WatchPress") == 1 || (mbVRWatchWinding && mVRWatchWind.Wound() == false))
+			{
+				avKeys.push_back("watch_wind");
+				avAt.push_back(mvVRHintCrown);
+			}
+		}
+	}
+
+	// BunkerVR: what kind of thing a hand touches, for its hint
+	// (glBunkerVR_HintThing..., helper_bunkervr_hints.hps).
+	int VRHintThing(cLuxMap@ apMap, iLuxEntity@ apEntity)
+	{
+		tString sName = apEntity.GetName();
+		if(apMap.GetEntityByName(sName, eLuxEntityType_Prop, "cScrPropReadable") !is null) return glBunkerVR_HintThingNote;
+		if(apMap.GetEntityByName(sName, eLuxEntityType_Prop, "cScrPropReadableDogTag") !is null) return glBunkerVR_HintThingDogTag;
+		if(apMap.GetEntityByName(sName, eLuxEntityType_Prop, "cScrPropCombinationLock") !is null) return glBunkerVR_HintThingLock;
+		if(apMap.GetEntityByName(sName, eLuxEntityType_Prop, "cScrPropAuxiliaryInventory") !is null) return glBunkerVR_HintThingBox;
+		if(apMap.GetEntityByName(sName, eLuxEntityType_Area, "cScrAreaZoom") !is null) return glBunkerVR_HintThingMap;
+		if(apMap.GetEntityByName(sName, eLuxEntityType_Area, "cScrAreaLadder") !is null) return glBunkerVR_HintThingLadder;
+		return glBunkerVR_HintThingOther;
+	}
+
+	// BunkerVR: is what fuel is poured into (the generator's hatch, a save
+	// lamp's opening, as VRUpdatePour knows them) within 1.2 m of the held
+	// can's or bottle's opening, and usable by it now? (The pour's hint.)
+	bool VRHintPourNear(const cVector3f &in avOpening)
+	{
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		if(pMap is null) return false;
+		float fNow = float(cEngine_GetGameTime());
+		if(fNow - mfVRHintPourListTime > 1.0f || fNow < mfVRHintPourListTime)
+		{
+			mfVRHintPourListTime = fNow;
+			mvVRHintPourTargets.resize(0);
+			iLuxEntity@ pHatch = pMap.GetEntityByName("Trigger_FuelHatch");
+			if(pHatch !is null) mvVRHintPourTargets.push_back(pHatch.GetID());
+			iLuxEntity@ pLampOpening = pMap.GetEntityByName("SaveLamp_SavingCostsFuel_Aux");
+			if(pLampOpening !is null) mvVRHintPourTargets.push_back(pLampOpening.GetID());
+		}
+		for(uint i = 0; i < mvVRHintPourTargets.length(); ++i)
+		{
+			iLuxEntity@ pTarget = cLux_ID_Entity(mvVRHintPourTargets[i]);
+			if(pTarget is null || pTarget.IsActive() == false) continue;
+			if((pTarget.GetPosition() - avOpening).Length() > 1.2f) continue;
+			if(Item_GetCanUseOnWorld(eItemHandlerHand_Right, pTarget.GetName())) return true;
+		}
+		return false;
+	}
+
+	// BunkerVR: what an item with a fit (VRUpdateFit) held as a_mtxThing is
+	// brought to: the thing the game says it can be used on, found along the
+	// way it points from gfBunkerVR_FitInside behind its tip to
+	// gfBunkerVR_FitReach ahead; that thing's box (its first body's), the side
+	// of it most in line with the item (within 35 degrees: gfBunkerVR_FitAim),
+	// and the face it goes in by: its tip there (gfBunkerVR_FitReach before it
+	// to gfBunkerVR_FitInside in) and within gfBunkerVR_FitAcross of its middle.
+	// Then asTarget, the way in (avAlong) and the face's middle (avFace).
+	bool VRFitFindTarget(const cMatrixf &in a_mtxThing, const cVector3f &in avTip, const cVector3f &in avPoints,
+						 tString &out asTarget, cVector3f &out avAlong, cVector3f &out avFace)
+	{
+		asTarget = "";
+		avAlong = cVector3f(0.0f);
+		avFace = cVector3f(0.0f);
+		cVector3f vTip = cMath_MatrixMul(a_mtxThing, avTip);
+		cVector3f vPoints = cMath_Vector3Normalize(cMath_MatrixMul3x3(a_mtxThing, avPoints));
+		cLuxClosestEntityData hit;
+		if(cLux_GetClosestEntity(vTip - vPoints * gfBunkerVR_FitInside, vPoints, gfBunkerVR_FitInside + gfBunkerVR_FitReach, 0, false, hit) == false) return false;
+		iLuxEntity@ pTarget = hit.mpEntity;
+		if(pTarget is null || Item_GetCanUseOnWorld(eItemHandlerHand_Right, pTarget.GetName()) == false) return false;
+		iPhysicsBody@ pBody = hit.mpBody;
+		if(pBody is null && pTarget.GetBodyNum() > 0) @pBody = pTarget.GetBody(0);
+		cBoundingVolume@ pBox = pBody !is null ? pBody.GetBoundingVolume() : null;
+		if(pBox is null) return false;
+		cMatrixf mtxBox = pBody.GetWorldMatrix();
+		cVector3f vBest = cVector3f(0.0f);
+		float fBest = 0.0f;
+		for(int i = 0; i < 3; ++i)
+		{
+			cVector3f vAxis = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxBox, cVector3f(i == 0 ? 1.0f : 0.0f, i == 1 ? 1.0f : 0.0f, i == 2 ? 1.0f : 0.0f)));
+			float fDot = cMath_Vector3Dot(vAxis, vPoints);
+			if(cMath_Abs(fDot) <= cMath_Abs(fBest)) continue;
+			fBest = fDot;
+			vBest = fDot < 0.0f ? vAxis * -1.0f : vAxis;
+		}
+		if(cMath_Abs(fBest) < gfBunkerVR_FitAim) return false;
+		cVector3f vSize = pBox.GetMax() - pBox.GetMin();
+		float fHalf = 0.5f * (cMath_Abs(vBest.x) * vSize.x + cMath_Abs(vBest.y) * vSize.y + cMath_Abs(vBest.z) * vSize.z);
+		cVector3f vFace = pBox.GetWorldCenter() - vBest * fHalf;
+		float fIn = cMath_Vector3Dot(vTip - vFace, vBest);
+		cVector3f vAcross = (vTip - vFace) - vBest * fIn;
+		if(fIn < -gfBunkerVR_FitReach || fIn > gfBunkerVR_FitInside || vAcross.Length() > gfBunkerVR_FitAcross) return false;
+		asTarget = pTarget.GetName();
+		avAlong = vBest;
+		avFace = vFace;
+		return true;
+	}
+
+	// BunkerVR: where the right hand is drawn while it fits an item in, and
+	// where the item is (see VRUpdateFit; read by UpdateVRArms and
+	// VRPlaceHeldByGrip in Prop_PlayerBody.hps), with a new stamp each update.
+	void VRFitPublish(const cMatrixf &in a_mtxHand, const cMatrixf &in a_mtxThing)
+	{
+		mlVRFitStamp = mlVRFitStamp % 1000000 + 1;
+		cScript_SetGlobalVarVector3f("BunkerVR_FitAt", a_mtxHand.GetTranslation());
+		cScript_SetGlobalVarVector3f("BunkerVR_FitRight", a_mtxHand.GetRight());
+		cScript_SetGlobalVarVector3f("BunkerVR_FitUp", a_mtxHand.GetUp());
+		cScript_SetGlobalVarVector3f("BunkerVR_FitForward", a_mtxHand.GetForward());
+		cScript_SetGlobalVarVector3f("BunkerVR_FitThingAt", a_mtxThing.GetTranslation());
+		cScript_SetGlobalVarVector3f("BunkerVR_FitThingRight", a_mtxThing.GetRight());
+		cScript_SetGlobalVarVector3f("BunkerVR_FitThingUp", a_mtxThing.GetUp());
+		cScript_SetGlobalVarVector3f("BunkerVR_FitThingForward", a_mtxThing.GetForward());
+		cScript_SetGlobalVarInt("BunkerVR_FitStamp", mlVRFitStamp);
+	}
+
+	// BunkerVR: a fit ends (the item out again, gone from the hand, or not
+	// usable): the hand on its controller again, and no new fit for 0.3 s
+	// (the item, placed from the fitted hand at the last frame, is still where
+	// the fit had it). asNote: for the log ("" none).
+	void VRFitEnd(const tString &in asNote)
+	{
+		if(mVRFit.mlState == 0 && cScript_GetGlobalVarInt("BunkerVR_FitStamp") == 0) return;
+		mVRFit.mlState = 0;
+		cScript_SetGlobalVarInt("BunkerVR_FitStamp", 0);
+		cScript_SetGlobalVarInt("BunkerVR_FitIn", 0);
+		mfVRFitRest = 0.3f;
+		mbVRFitPalmKnown = false;
+		if(asNote != "") VRFitNote(asNote);
+	}
+
+	// BunkerVR: a "BunkerVR fit:" line in hpl.log (the first 60).
+	void VRFitNote(const tString &in asText)
+	{
+		if(mlVRFitNotes >= 60) return;
+		mlVRFitNotes++;
+		Log("BunkerVR fit: " + asText + "\n");
+	}
+
+	// BunkerVR: a direction (or a place, given in cm) for the fit's notes, in
+	// whole numbers.
+	tString VRFitText(const cVector3f &in avWhat)
+	{
+		return "(" + int(avWhat.x * 100.0f) + " " + int(avWhat.y * 100.0f) + " " + int(avWhat.z * 100.0f) + ")";
+	}
+
+	// BunkerVR: the wrench, fitted onto a bolt and cranked around by hand. The
+	// wrench in the right hand (the game's T-handled socket spanner: the open
+	// end of its socket bar is the model's origin, the bar along its x, the
+	// handle hanging along its -y), its socket brought onto a bolt's head
+	// (within gfBunkerVR_WrenchFitReach) with the bar pointing out along the
+	// bolt (within 41 degrees: gfBunkerVR_WrenchFitAim), goes on, with the
+	// game's own sound and a firm buzz. From then on, the right grip let go,
+	// it spins around the bolt with the hand either way, turning nothing and
+	// with nothing felt or heard; the grip held (a light click), it turns about
+	// the bolt as the hand goes around it, one way only (cBunkerVRBoltTurn,
+	// helper_bunkervr_tools.hps): cranked the way the bolt comes out
+	// (anticlockwise, seen from in front) it turns the bolt with it (a bolt not
+	// yet turned is seized: it holds, trembling, until the hand is 15 degrees
+	// ahead), and the bolt is drawn turning and backing out: see "Felt and
+	// heard the right way" below. The other way it won't go: the wrench and
+	// the hand drawn on it stay where they are, shuddering, with a locked
+	// rattle and a jolt (again every 15 degrees pushed further); 70 degrees
+	// past it the hand slips off. Two cranks of 100 degrees take it out: a
+	// puff of dust, it falls out (the game's loose bolt), the wrench comes off,
+	// and its grating is told (Grating_RemoveBolt: with both gone it swings
+	// open, as after the game's own scene). Meanwhile the right hand is drawn
+	// on the wrench where it went on (VRFitPublish, as a key in its lock); the
+	// real hand drawn back gfBunkerVR_WrenchPullOut along the bolt from there
+	// (or gfBunkerVR_WrenchPullOff any way, not counting how far it has gone
+	// around), or the wrench put away, it comes off (the bolt stays as far out
+	// as it is, and goes on from there). The game's own use of the wrench, its
+	// scene, is left out in VR (PlayerState_UsingWrench.hps OnUse). Logged as
+	// "BunkerVR wrench:" in hpl.log (the first 60).
+	void VRUpdateWrench(float afTimeStep)
+	{
+		if(mfVRWrenchRest > 0.0f) mfVRWrenchRest -= afTimeStep;
+		VRWatchLooseBolt(afTimeStep);
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		bool bWrench = pMap !is null && Item_GetHeldType(eItemHandlerHand_Right) == "Wrench";
+		cLuxProp@ pWrench = bWrench ? cLux_ToProp(pMap.GetEntityByName(Item_GetHeldEntity(eItemHandlerHand_Right))) : null;
+		cMatrixf mtxPalm = cMatrixf_Identity;
+		float fArmScale = 1.0f;
+		if(pWrench is null || BunkerVR_ReadFollowedPalm(1, mtxPalm, fArmScale) == false)
+		{
+			if(mbVRWrenchOn) VRWrenchOff(pWrench, "the wrench comes off the bolt: put away, or the hand not followed");
+			mbVRWrenchPalmKnown = false;
+			return;
+		}
+		
+		// Off: does it go on a bolt now (placed by the hand from the palm of
+		// the update before)?
+		if(mbVRWrenchOn == false)
+		{
+			if(mbVRWrenchPalmKnown && mfVRWrenchRest <= 0.0f) VRWrenchTryOn(pMap, pWrench);
+			m_mtxVRWrenchPalmWas = mtxPalm;
+			mbVRWrenchPalmKnown = true;
+			if(mbVRWrenchOn == false) return;
+		}
+		
+		iLuxEntity@ pBolt = cLux_ID_Entity(m_idVRWrenchBolt);
+		if(pBolt is null || pBolt.IsActive() == false)
+		{
+			VRWrenchOff(pWrench, "the wrench comes off: its bolt is gone");
+			return;
+		}
+		
+		// The hand's angle around the bolt, counted on from where it went on
+		// (not read right by the bolt's line, where it would jump).
+		cVector3f vFromLine = mtxPalm.GetTranslation() - mvVRWrenchMouth;
+		vFromLine = vFromLine - mvVRWrenchOut * cMath_Vector3Dot(vFromLine, mvVRWrenchOut);
+		if(vFromLine.Length() >= gfBunkerVR_WrenchAxisNear)
+			mfVRWrenchAngle = BunkerVR_Unwrap(mfVRWrenchAngle, BunkerVR_AngleAbout(mvVRWrenchOut, mvVRWrenchRef, vFromLine));
+		// Gripped (the right grip held) it cranks the bolt, with all
+		// that is felt and heard; not, it spins with the hand, turning nothing
+		// (a light click in the hand as it is gripped).
+		bool bGrip = cVR_HandSqueeze(1) > (mVRWrenchTurn.mbGripped ? gfVRFitGripLetGo : gfVRFitGripPress);
+		if(bGrip != mVRWrenchTurn.mbGripped)
+		{
+			mVRWrenchTurn.Grip(bGrip);
+			if(bGrip)
+			{
+				VRBuzzHand(1, 0.03f, 0.45f);
+				mlVRWrenchGrips++;
+			}
+			if(mlVRWrenchGrips <= 6) VRWrenchNote(bGrip ? "gripped (" + mlVRWrenchGrips + " so far): it cranks the bolt" : "let go of: it spins free");
+		}
+		float fBoltWas = mVRWrenchTurn.mfBolt;
+		mVRWrenchTurn.Step(mfVRWrenchAngle);
+		int lEvents = mVRWrenchTurn.mlEvents;
+		
+		// The wrench and the bolt where that puts them: the wrench turned about
+		// the bolt's line as far as it has gone (never back: pushed the wrong
+		// way it stays, shuddering a little more the further it is pushed), the
+		// bolt by its own turn, both out by as far as the bolt has backed out
+		// since the wrench went on.
+		float fShudder = 0.0f;
+		if(mVRWrenchTurn.mfForced >= gfBunkerVR_WrenchForcedStart)
+		{
+			mlVRWrenchShudder++;
+			fShudder = (mlVRWrenchShudder % 2 == 0 ? 1.0f : -1.0f) * cMath_Min(0.006f + 0.02f * mVRWrenchTurn.mfForced, 0.03f);
+		}
+		else if(mVRWrenchTurn.mfStrain > 0.02f)
+		{
+			// (A seized bolt pushed: the wrench trembles, more as the push grows.)
+			mlVRWrenchShudder++;
+			fShudder = (mlVRWrenchShudder % 2 == 0 ? 1.0f : -1.0f) * 0.02f * mVRWrenchTurn.mfStrain / gfBunkerVR_WrenchBreakaway;
+		}
+		cVector3f vShift = mvVRWrenchOut * (mVRWrenchTurn.BackedOut() - BunkerVR_BoltBackedOut(mfVRWrenchBoltFrom));
+		cMatrixf mtxWrench = BunkerVR_TurnAboutLine(m_mtxVRWrenchSeated, mvVRWrenchMouth, mvVRWrenchOut, mVRWrenchTurn.mfWrench + fShudder, vShift);
+		pBolt.SetMatrix(BunkerVR_TurnAboutLine(m_mtxVRWrenchBoltAt, BunkerVR_BoltLinePoint(m_mtxVRWrenchBoltAt), mvVRWrenchOut,
+											   mVRWrenchTurn.mfBolt - mfVRWrenchBoltFrom, vShift));
+		VRWrenchRemember(m_idVRWrenchBolt, mVRWrenchTurn.mfBolt);
+		cMatrixf mtxHand = cMath_MatrixMul(mtxWrench, m_mtxVRWrenchHandIn);
+		cVector3f vBoltHead = mvVRWrenchMouth + vShift;
+		
+		// Felt and heard the right way. Seized, pushed: it holds, trembling, a
+		// strain in the hand growing with the push; then it breaks loose: a
+		// creak, a hard jolt, dust.
+		// While it turns: the turning wheel's grinding, faster and louder the
+		// faster it is cranked (and a little freer as it loosens), a crisp notch
+		// in the hand every 20 degrees over a low rumble, and at each crank's
+		// worth (100 degrees) a firm knock and a little dust, the bolt 1.5 cm
+		// further out. Stopped a moment, the grinding ends with the wheel's stop.
+		bool bTurned = (lEvents & glBunkerVR_WrenchTurned) != 0;
+		float fSpeed = afTimeStep > 0.0001f ? (mVRWrenchTurn.mfBolt - fBoltWas) / afTimeStep : 0.0f; // (radians a second)
+		if((lEvents & glBunkerVR_WrenchBrokeLoose) != 0)
+		{
+			VRBuzzHand(1, 0.14f, 1.0f);
+			pWrench.PlaySound("BunkerVR_BoltLoose", gsVRBoltLooseSound, true, true);
+			VRWrenchDust(pMap, vBoltHead);
+			VRWrenchNote("the bolt breaks loose (the hand " + int(cMath_ToDeg(mVRWrenchTurn.mfBolt)) + " degrees ahead of the wrench)");
+		}
+		else if((lEvents & glBunkerVR_WrenchCrankDone) != 0)
+		{
+			VRBuzzHand(1, 0.09f, 0.9f);
+			VRWrenchDust(pMap, vBoltHead);
+			int lCrank = int(mVRWrenchTurn.mfBolt / gfBunkerVR_WrenchCrank + 0.0001f);
+			VRWrenchNote("crank " + lCrank + " of " + glBunkerVR_WrenchCranks + " done: the bolt turned " + int(cMath_ToDeg(mVRWrenchTurn.mfBolt)) + " degrees, " +
+						 BunkerVR_Fixed(mVRWrenchTurn.BackedOut() * 100.0f, 2) + " cm out");
+		}
+		else if((lEvents & glBunkerVR_WrenchNotch) != 0)
+		{
+			VRBuzzHand(1, 0.02f, 0.65f);
+		}
+		else if(bTurned)
+		{
+			VRBuzzHand(1, 0.04f, cMath_Clamp(0.15f + 0.07f * fSpeed, 0.15f, 0.4f) * (1.0f - 0.35f * mVRWrenchTurn.Done()));
+		}
+		else if((lEvents & glBunkerVR_WrenchStraining) != 0)
+		{
+			VRBuzzHand(1, 0.04f, 0.3f + 0.55f * cMath_Clamp(mVRWrenchTurn.mfStrain / gfBunkerVR_WrenchBreakaway, 0.0f, 1.0f));
+			if(mbVRWrenchStrainTold == false)
+			{
+				mbVRWrenchStrainTold = true;
+				VRWrenchNote("pushed the right way, the bolt is seized: it holds until the hand is " + int(cMath_ToDeg(gfBunkerVR_WrenchBreakaway)) + " degrees ahead");
+			}
+		}
+		if(bTurned && fSpeed > 0.25f)
+		{
+			mfVRWrenchStill = 0.0f;
+			cSoundEntity@ pGrind = cLux_ID_SoundEntity(m_idVRWrenchGrind);
+			if(pGrind is null) @pGrind = VRWrenchGrindStart(pWrench);
+			if(pGrind !is null)
+			{
+				pGrind.FadeSpeedMul(cMath_Clamp(0.75f + 0.12f * fSpeed + 0.15f * mVRWrenchTurn.Done(), 0.7f, 1.5f), 4.0f);
+				pGrind.FadeVolumeMul(cMath_Clamp(0.45f + 0.18f * fSpeed, 0.45f, 1.0f), 4.0f);
+			}
+		}
+		else
+		{
+			mfVRWrenchStill += afTimeStep;
+			if(mfVRWrenchStill > 0.2f) VRWrenchGrindStop(pWrench, true);
+		}
+		
+		// The wrong way: it will not go (held, a locked rattle and a jolt,
+		// again further on); pushed on, the hand slips off.
+		if((lEvents & glBunkerVR_WrenchForced) != 0)
+		{
+			VRBuzzHand(1, 0.1f, 0.85f);
+			pWrench.PlaySound("BunkerVR_WrenchForced", gsVRWrenchForcedSound, true, true);
+			mlVRWrenchForcedTimes++;
+			VRWrenchNote("pushed the wrong way (clockwise): it will not go (" + mlVRWrenchForcedTimes + " so far)");
+		}
+		else if((lEvents & glBunkerVR_WrenchForcedMore) != 0)
+		{
+			VRBuzzHand(1, 0.06f, 0.7f);
+		}
+		if(mVRWrenchTurn.SlippedOff())
+		{
+			VRBuzzHand(1, 0.1f, 0.6f);
+			VRWrenchOff(pWrench, "pushed the wrong way " + int(cMath_ToDeg(mVRWrenchTurn.mfForced)) + " degrees: the hand slips off the handle");
+			return;
+		}
+		
+		// Out: a puff of dust, it falls out, the wrench comes off with it.
+		if((lEvents & glBunkerVR_WrenchOut) != 0)
+		{
+			VRBuzzHand(1, 0.15f, 1.0f);
+			VRWrenchDust(pMap, vBoltHead);
+			VRWrenchBoltOut(pMap, pBolt);
+			VRWrenchOff(pWrench, "the bolt is out: the wrench comes off with it");
+			return;
+		}
+		
+		// Pulled off the bolt: drawn back along it, or well away from where the
+		// hand is drawn (not counting how far it has gone around the bolt the
+		// wrong way: that holds it).
+		cVector3f vOff = mtxPalm.GetTranslation() - BunkerVR_TurnAboutLine(mtxHand, vBoltHead, mvVRWrenchOut, mfVRWrenchAngle - mVRWrenchTurn.mfWrench - fShudder,
+																		   cVector3f(0.0f)).GetTranslation();
+		float fBack = cMath_Vector3Dot(vOff, mvVRWrenchOut);
+		if(fBack > gfBunkerVR_WrenchPullOut || vOff.Length() > gfBunkerVR_WrenchPullOff)
+		{
+			VRWrenchOff(pWrench, "the wrench is pulled off the bolt (the hand " + int(vOff.Length() * 100.0f) + " cm from it, " + int(fBack * 100.0f) +
+						" back along it; the bolt turned " + int(cMath_ToDeg(mVRWrenchTurn.mfBolt)) + " degrees so far)");
+			return;
+		}
+		
+		cVR_RightFitted();
+		VRFitPublish(mtxHand, mtxWrench);
+	}
+	
+	// BunkerVR: does the wrench, placed at its hand's last palm, go on a bolt
+	// (see VRUpdateWrench)? If so it is put on the nearest.
+	void VRWrenchTryOn(cLuxMap@ apMap, cLuxProp@ apWrench)
+	{
+		cMatrixf mtxWrench = apWrench.GetMatrix();
+		cVector3f vRoot = mtxWrench.GetTranslation();
+		cVector3f vBar = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxWrench, cVector3f(1.0f, 0.0f, 0.0f)));
+		VRWrenchListBolts(apMap);
+		float fBest = gfBunkerVR_WrenchFitReach;
+		int lBest = -1;
+		for(uint i = 0; i < mvVRWrenchBolts.length(); ++i)
+		{
+			iLuxEntity@ pBolt = cLux_ID_Entity(mvVRWrenchBolts[i]);
+			if(pBolt is null || pBolt.IsActive() == false) continue;
+			cMatrixf mtxBolt = pBolt.GetMatrix();
+			if(cMath_Vector3Dot(vBar, BunkerVR_BoltOut(mtxBolt)) < gfBunkerVR_WrenchFitAim) continue;
+			float fOff = (vRoot - BunkerVR_BoltMouth(mtxBolt)).Length();
+			if(fOff > fBest) continue;
+			fBest = fOff;
+			lBest = int(i);
+		}
+		if(lBest < 0) return;
+		
+		iLuxEntity@ pBolt = cLux_ID_Entity(mvVRWrenchBolts[lBest]);
+		cMatrixf mtxBolt = pBolt.GetMatrix();
+		m_idVRWrenchBolt = pBolt.GetID();
+		msVRWrenchGrating = mvVRWrenchGratings[lBest];
+		mvVRWrenchOut = BunkerVR_BoltOut(mtxBolt);
+		mvVRWrenchMouth = BunkerVR_BoltMouth(mtxBolt);
+		m_mtxVRWrenchBoltAt = mtxBolt;
+		// Seated: its bar turned onto the bolt's way out, its socket on the head.
+		cVector3f vAcross = cMath_Vector3Cross(mvVRWrenchOut, cVector3f(0.0f, 1.0f, 0.0f));
+		if(vAcross.Length() < 0.1f) vAcross = cVector3f(1.0f, 0.0f, 0.0f);
+		cMatrixf mtxSeated = cMath_MatrixMul(BunkerVR_TurnBetween(vBar, mvVRWrenchOut, vAcross), mtxWrench);
+		mtxSeated.SetTranslation(mvVRWrenchMouth);
+		// The hand where it holds the wrench (as drawn from the last palm).
+		m_mtxVRWrenchHandIn = cMath_MatrixMul(cMath_MatrixInverse(mtxWrench), m_mtxVRWrenchPalmWas);
+		// Angles around the bolt are counted from the real hand's way from its
+		// line now; the seated wrench is turned about the line so that the hand
+		// drawn on it is that way too (seating it may have swung the handle a
+		// little around). Right by the line, from the handle's way.
+		cVector3f vFromLine = m_mtxVRWrenchPalmWas.GetTranslation() - mvVRWrenchMouth;
+		vFromLine = vFromLine - mvVRWrenchOut * cMath_Vector3Dot(vFromLine, mvVRWrenchOut);
+		cVector3f vDrawn = cMath_MatrixMul(mtxSeated, m_mtxVRWrenchHandIn.GetTranslation()) - mvVRWrenchMouth;
+		vDrawn = vDrawn - mvVRWrenchOut * cMath_Vector3Dot(vDrawn, mvVRWrenchOut);
+		if(vFromLine.Length() >= gfBunkerVR_WrenchAxisNear && vDrawn.Length() >= gfBunkerVR_WrenchAxisNear)
+		{
+			mtxSeated = BunkerVR_TurnAboutLine(mtxSeated, mvVRWrenchMouth, mvVRWrenchOut, -BunkerVR_AngleAbout(mvVRWrenchOut, cMath_Vector3Normalize(vFromLine), vDrawn), cVector3f(0.0f));
+		}
+		else
+		{
+			vFromLine = cMath_MatrixMul3x3(mtxSeated, cVector3f(0.0f, -1.0f, 0.0f));
+			vFromLine = vFromLine - mvVRWrenchOut * cMath_Vector3Dot(vFromLine, mvVRWrenchOut);
+		}
+		m_mtxVRWrenchSeated = mtxSeated;
+		mvVRWrenchRef = cMath_Vector3Normalize(vFromLine);
+		mfVRWrenchAngle = 0.0f;
+		mfVRWrenchBoltFrom = VRWrenchTurnedOf(m_idVRWrenchBolt);
+		mVRWrenchTurn.mfBolt = mfVRWrenchBoltFrom;
+		mVRWrenchTurn.Start(0.0f);
+		mlVRWrenchShudder = 0;
+		mbVRWrenchStrainTold = false;
+		mfVRWrenchStill = 0.0f;
+		mbVRWrenchOn = true;
+		cVR_HintUsed("wrench_fit");
+		apWrench.PlaySound("BunkerVR_WrenchOn", "player/tools/wrench/attach", true, true);
+		apWrench.PlaySound("BunkerVR_WrenchSeated", gsVRBoltStopSound, true, true); // (a clunk as the socket seats: the game's own attach sound is very quiet)
+		VRBuzzHand(1, 0.08f, 0.75f);
+		VRWrenchNote("the wrench goes on " + pBolt.GetName() + (msVRWrenchGrating != "" ? " (" + msVRWrenchGrating + ")" : "") + ", its socket " +
+					 BunkerVR_Fixed(fBest * 100.0f, 1) + " cm off the head, turned " + int(cMath_ToDeg(cMath_ACos(cMath_Clamp(cMath_Vector3Dot(vBar, mvVRWrenchOut), -1.0f, 1.0f)))) +
+					 " degrees off its line; the bolt turned " + int(cMath_ToDeg(mfVRWrenchBoltFrom)) + " degrees so far; out along " + VRFitText(mvVRWrenchOut) +
+					 ", the hand " + int(vFromLine.Length() * 100.0f) + " cm from the line");
+	}
+	
+	// BunkerVR: the wrench comes off its bolt (see VRUpdateWrench): the hand
+	// on its controller again, and it goes on nothing for half a second.
+	// apWrench: the wrench, for its sound (null: none). asNote: for the log.
+	void VRWrenchOff(cLuxProp@ apWrench, const tString &in asNote)
+	{
+		if(mbVRWrenchOn == false) return;
+		mbVRWrenchOn = false;
+		VRWrenchGrindStop(apWrench, false);
+		cScript_SetGlobalVarInt("BunkerVR_FitStamp", 0);
+		mfVRWrenchRest = 0.5f;
+		mbVRWrenchPalmKnown = false;
+		if(apWrench !is null) apWrench.PlaySound("BunkerVR_WrenchOff", "player/tools/wrench/detach", true, true);
+		VRWrenchNote(asNote);
+	}
+	
+	// BunkerVR: the bolt's grinding (see VRUpdateWrench) starts: the first of
+	// gvVRBoltGrindSounds that plays (one that does not is not tried again, and
+	// is logged), each time under a name of its own, gone when stopped. Null: none plays.
+	cSoundEntity@ VRWrenchGrindStart(cLuxProp@ apWrench)
+	{
+		while(mlVRGrindSoundAt < int(gvVRBoltGrindSounds.length()))
+		{
+			mlVRWrenchGrinds++;
+			cSoundEntity@ pGrind = apWrench.PlaySound("BunkerVR_BoltGrind_" + mlVRWrenchGrinds, gvVRBoltGrindSounds[mlVRGrindSoundAt], true, true);
+			if(pGrind !is null)
+			{
+				m_idVRWrenchGrind = pGrind.GetID();
+				if(mbVRGrindSoundTold == false)
+				{
+					mbVRGrindSoundTold = true;
+					VRWrenchNote("the grinding heard: " + gvVRBoltGrindSounds[mlVRGrindSoundAt]);
+				}
+				return pGrind;
+			}
+			VRWrenchNote("the grinding sound " + gvVRBoltGrindSounds[mlVRGrindSoundAt] + " could not be played: the next is tried");
+			mlVRGrindSoundAt++;
+		}
+		return null;
+	}
+	
+	// BunkerVR: the bolt's grinding (see VRUpdateWrench) ends, with the
+	// turning wheel's own stop when abStopSound (and the wrench there to sound it).
+	void VRWrenchGrindStop(cLuxProp@ apWrench, bool abStopSound)
+	{
+		cSoundEntity@ pGrind = cLux_ID_SoundEntity(m_idVRWrenchGrind);
+		m_idVRWrenchGrind = tID_Invalid;
+		if(pGrind is null) return;
+		pGrind.Stop(false);
+		if(abStopSound && apWrench !is null) apWrench.PlaySound("BunkerVR_BoltStop", gsVRBoltStopSound, true, true);
+	}
+	
+	// BunkerVR: a little puff of dust at the bolt's head (breaking loose,
+	// coming out: see VRUpdateWrench).
+	void VRWrenchDust(cLuxMap@ apMap, const cVector3f &in avAt)
+	{
+		cParticleSystem@ pDust = apMap.GetWorld().CreateParticleSystem("BunkerVR_BoltDust_" + (++mlVRWrenchDusts), gsVRBoltDust, cVector3f(0.5f), true, false);
+		if(pDust !is null) pDust.SetWorldPosition(avAt);
+	}
+	
+	// BunkerVR: the bolt the wrench has turned out (see VRUpdateWrench) falls:
+	// the game's loose bolt (bolt_rigid.ent, a body without weight: given one
+	// here) put where it is, sent out and down, not touching anything for its
+	// first 0.15 s (it starts inside the grating); the bolt itself goes, and
+	// its grating is told (or, the item test map's bolts, its count).
+	void VRWrenchBoltOut(cLuxMap@ apMap, iLuxEntity@ apBolt)
+	{
+		cMatrixf mtxBolt = apBolt.GetMatrix();
+		float fSize = cMath_MatrixMul3x3(mtxBolt, cVector3f(0.0f, 0.0f, 1.0f)).Length();
+		cVector3f vOut = BunkerVR_BoltOut(mtxBolt);
+		mlVRLooseBolts++;
+		tString sLoose = "BunkerVR_LooseBolt_" + mlVRLooseBolts;
+		apMap.ResetLatestEntity();
+		apMap.CreateEntity(sLoose, "bolt_rigid.ent", BunkerVR_LooseBoltPlace(mtxBolt), cVector3f(fSize, fSize, fSize));
+		iLuxEntity@ pLoose = apMap.GetLatestEntity();
+		if(pLoose !is null && pLoose.GetName() == sLoose)
+		{
+			for(int i = 0; i < pLoose.GetBodyNum(); ++i)
+			{
+				iPhysicsBody@ pBody = pLoose.GetBody(i);
+				if(pBody is null) continue;
+				pBody.SetMass(gfVRLooseBoltMass);
+				pBody.SetGravity(true);
+				pBody.SetCollide(false);
+				pBody.Enable();
+				pBody.SetLinearVelocity(vOut * 0.6f + cVector3f(0.0f, 0.4f, 0.0f));
+			}
+			m_idVRLooseBolt = pLoose.GetID();
+			mvVRLooseBoltFrom = pLoose.GetPosition();
+			mfVRLooseBoltTime = 0.0f;
+		}
+		else
+		{
+			VRWrenchNote("the loose bolt could not be made");
+		}
+		tString sBolt = apBolt.GetName();
+		apMap.DestroyEntity(apBolt);
+		cVR_HintUsed("wrench_turn"); // (a bolt is out)
+		if(msVRWrenchGrating != "")
+		{
+			Grating_RemoveBolt(msVRWrenchGrating);
+			VRWrenchNote(sBolt + " is out of " + msVRWrenchGrating + (Grating_GetIsOpen(msVRWrenchGrating) ? ": both out, it opens" : ""));
+		}
+		else
+		{
+			cScript_SetGlobalVarInt("BunkerVR_TestBoltsOut", cScript_GetGlobalVarInt("BunkerVR_TestBoltsOut") + 1);
+			VRWrenchNote(sBolt + " is out (a test bolt)");
+		}
+		mfVRWrenchListTime = -100.0f;
+	}
+	
+	// BunkerVR: the loose bolt's fall (see VRWrenchBoltOut): after 0.15 s it
+	// touches things again; should it not have fallen at all in a second (the
+	// engine kept it weightless), it is taken away rather than left hanging.
+	void VRWatchLooseBolt(float afTimeStep)
+	{
+		if(m_idVRLooseBolt == tID_Invalid) return;
+		iLuxEntity@ pLoose = cLux_ID_Entity(m_idVRLooseBolt);
+		if(pLoose is null)
+		{
+			m_idVRLooseBolt = tID_Invalid;
+			return;
+		}
+		float fWas = mfVRLooseBoltTime;
+		mfVRLooseBoltTime += afTimeStep;
+		if(fWas < 0.15f && mfVRLooseBoltTime >= 0.15f)
+		{
+			for(int i = 0; i < pLoose.GetBodyNum(); ++i)
+			{
+				iPhysicsBody@ pBody = pLoose.GetBody(i);
+				if(pBody !is null) pBody.SetCollide(true);
+			}
+		}
+		if(mfVRLooseBoltTime < 1.0f) return;
+		float fFell = mvVRLooseBoltFrom.y - pLoose.GetPosition().y;
+		if(fFell < 0.05f)
+		{
+			VRWrenchNote("the loose bolt did not fall (" + int(fFell * 100.0f) + " cm in a second): taken away");
+			cLux_GetCurrentMap().DestroyEntity(pLoose);
+		}
+		else
+		{
+			VRWrenchNote("the loose bolt fell " + int(fFell * 100.0f) + " cm in its first second");
+		}
+		m_idVRLooseBolt = tID_Invalid;
+	}
+	
+	// BunkerVR: the bolts the wrench can go on: each shut grating's two
+	// (Grating_GetBolt, as the game's own use of the wrench finds them), and
+	// the item test map's ("BunkerVR_TestBolts": names, each ended by ";").
+	// Listed again every 2 seconds while it is wanted.
+	void VRWrenchListBolts(cLuxMap@ apMap)
+	{
+		float fNow = float(cEngine_GetGameTime());
+		if(fNow - mfVRWrenchListTime < 2.0f && fNow >= mfVRWrenchListTime) return;
+		mfVRWrenchListTime = fNow;
+		mvVRWrenchBolts.resize(0);
+		mvVRWrenchGratings.resize(0);
+		array<iLuxEntity@> vGratings;
+		apMap.GetEntityArray("*", eLuxEntityType_Prop, "cScrPropGrating", vGratings);
+		for(uint i = 0; i < vGratings.length(); ++i)
+		{
+			if(vGratings[i] is null) continue;
+			tString sGrating = vGratings[i].GetName();
+			if(Grating_GetIsOpen(sGrating)) continue;
+			for(int lSide = 0; lSide < 2; ++lSide)
+			{
+				tString sBolt = Grating_GetBolt(sGrating, lSide == 1);
+				iLuxEntity@ pBolt = sBolt != "" ? apMap.GetEntityByName(sBolt, eLuxEntityType_Prop) : null;
+				if(pBolt is null) continue;
+				mvVRWrenchBolts.insertLast(pBolt.GetID());
+				mvVRWrenchGratings.insertLast(sGrating);
+			}
+		}
+		tString sTest = cScript_GetGlobalVarString("BunkerVR_TestBolts");
+		int lFrom = 0;
+		for(int lEnd = cString_GetFirstStringPos(sTest, ";", 0); lEnd >= 0; lEnd = cString_GetFirstStringPos(sTest, ";", lFrom))
+		{
+			iLuxEntity@ pBolt = lEnd > lFrom ? apMap.GetEntityByName(cString_Sub(sTest, lFrom, lEnd - lFrom)) : null;
+			lFrom = lEnd + 1;
+			if(pBolt is null) continue;
+			mvVRWrenchBolts.insertLast(pBolt.GetID());
+			mvVRWrenchGratings.insertLast("");
+		}
+	}
+	
+	// BunkerVR: how far a bolt has been turned out so far (radians; 0 if not
+	// at all), and that remembered (see VRUpdateWrench).
+	float VRWrenchTurnedOf(tID aidBolt)
+	{
+		for(uint i = 0; i < mvVRWrenchTurnedIds.length(); ++i)
+			if(mvVRWrenchTurnedIds[i] == aidBolt) return mvVRWrenchTurned[i];
+		return 0.0f;
+	}
+	
+	void VRWrenchRemember(tID aidBolt, float afTurned)
+	{
+		for(uint i = 0; i < mvVRWrenchTurnedIds.length(); ++i)
+		{
+			if(mvVRWrenchTurnedIds[i] != aidBolt) continue;
+			mvVRWrenchTurned[i] = afTurned;
+			return;
+		}
+		mvVRWrenchTurnedIds.insertLast(aidBolt);
+		mvVRWrenchTurned.insertLast(afTurned);
+	}
+	
+	// BunkerVR: a "BunkerVR wrench:" line in hpl.log (the first 60).
+	void VRWrenchNote(const tString &in asText)
+	{
+		if(mlVRWrenchNotes >= 60) return;
+		mlVRWrenchNotes++;
+		Log("BunkerVR wrench: " + asText + "\n");
+	}
+	
+	// BunkerVR: the bolt cutters with both hands, squeezed shut. The cutters in
+	// the right hand are held by one handle (by default jaws forward, the other
+	// handle on the hand's left, the handle along the fist: BunkerVR_grips.txt);
+	// the left palm brought to the other handle, anywhere along its grip
+	// (within gfBunkerVR_CutterTake of its middle: BunkerVR_CutterOtherGrip),
+	// and squeezed takes it (the mod's cVR_LeftAtPump, as for the shotgun's
+	// fore-end; it comes before the left hip's holster), until let go. Both
+	// hands then hold them alike (cBunkerVRCut and the rest are in
+	// helper_bunkervr_tools.hps): how far open they are is how far apart the
+	// hands are (BunkerVR_CutterOpeningApart); they are drawn between both
+	// hands (VRCutterFrame, BunkerVR_CutterBetween) by their own
+	// "cutter_cut_air" held at that opening (the game's linkage, the jaws
+	// opening as the handles part), each hand on its handle turned as the real
+	// one is (BunkerVR_PalmRolled; VRFitPublish, VRLeftFitPublish).
+	// Opened around a chain lock's chain, a padlock's shackle or a trap's wire
+	// (the jaws' middle within gfBunkerVR_CutterInJaws of it) and closed, the
+	// jaws bite on it from any opening (felt in both hands, a chain rattling).
+	// Then the hands squeezing hard, for a time, cut it (a chain takes 1.5 s of
+	// a full squeeze, BunkerVR_CutSeconds; a quick close doesn't cut at once):
+	// the jaws give only a little as the hands press (gfBunkerVR_CutterGive;
+	// the hands drawn on the handles stay behind the real ones, held back), a
+	// strain in both hands growing as it goes and a crunch at each sixth; a
+	// chain needs the hands all the way shut, a padlock's shackle nearly, a
+	// wire a little way (BunkerVR_CutThrough); through, a snap and a jolt, the
+	// jaws shut. Bitten, the cutters stay on it, turning about it to the hands
+	// (BunkerVR_CutterPinned), and slip off only when the hands pull away from
+	// it (gfVRCutterPullSlip). Cut, a padlock falls at once
+	// (VRUpdatePadlockFall), and each goes as after the game's own scene (the
+	// chain lock's and the padlock's break, which unlock their doors, and the
+	// achievement's count; the trap disarmed). Opened again, it lets go. Shut
+	// quickly on nothing, the game's snip of air. The game's own use of the
+	// cutters is left out in VR (PlayerState_UsingCutters.hps), as are its own
+	// animations of them while both hands hold them ("BunkerVR_CuttersPosed").
+	// Logged as "BunkerVR cutters:" in hpl.log (the first 60).
+	void VRUpdateCutters(float afTimeStep)
+	{
+		if(mbVRCuttersTwo == false && cScript_GetGlobalVarInt("BunkerVR_CuttersPosed") != 0) cScript_SetGlobalVarInt("BunkerVR_CuttersPosed", 0); // (none left over, after a reload of the scripts)
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		bool bCutters = pMap !is null && Item_GetHeldType(eItemHandlerHand_Right) == "Cutters";
+		cLuxProp@ pCutters = bCutters ? cLux_ToProp(pMap.GetEntityByName(Item_GetHeldEntity(eItemHandlerHand_Right))) : null;
+		cMeshEntity@ pMesh = pCutters !is null ? pCutters.GetMeshEntity() : null;
+		cMatrixf mtxRight = cMatrixf_Identity;
+		cMatrixf mtxLeft = cMatrixf_Identity;
+		float fArmScale = 1.0f;
+		bool bHeld = pMesh !is null && BunkerVR_ReadFollowedPalm(1, mtxRight, fArmScale) && BunkerVR_ReadFollowedPalm(0, mtxLeft, fArmScale);
+		if(bHeld == false)
+		{
+			if(mbVRCuttersHeldWas)
+			{
+				cVR_LeftAtPump(false);
+				VRCuttersLetGo(pCutters, "the cutters are put away, or a hand is not followed");
+			}
+			mbVRCuttersHeldWas = false;
+			mbVRCuttersPalmKnown = false;
+			return;
+		}
+		mbVRCuttersHeldWas = true;
+		bool bLeftOn = VRLeftHoldsTool();
+		bool bLeftTook = bLeftOn && mbVRCuttersLeftOnWas == false;
+		mbVRCuttersLeftOnWas = bLeftOn;
+		if(bLeftOn == false) mbVRCuttersBroke = false;
+		
+		// One hand: is the left palm at the other handle, anywhere along its
+		// grip (the cutters placed by the right palm of the update before)?
+		// Squeezed there, the mod gives it the handle (before the left hip's
+		// holster, which would otherwise take every squeeze).
+		if(mbVRCuttersTwo == false)
+		{
+			if(mbVRCuttersPalmKnown)
+			{
+				cMatrixf mtxNow = pCutters.GetMatrix();
+				cMatrixf mtxToModel = cMath_MatrixInverse(mtxNow);
+				cMatrixf mtxRightIn = cMath_MatrixMul(mtxToModel, m_mtxVRCuttersPalmWas);
+				float fHand = BunkerVR_CutterHand(mtxRightIn.GetTranslation());
+				cVector3f vLeftAt = BunkerVR_CutterOtherGrip(fHand, cMath_MatrixMul(mtxToModel, mtxLeft.GetTranslation()));
+				float fToHandle = (mtxLeft.GetTranslation() - cMath_MatrixMul(mtxNow, vLeftAt)).Length();
+				bool bAt = fToHandle <= gfBunkerVR_CutterTake;
+				cVR_LeftAtPump(bAt);
+				if(bAt && mbVRCuttersAtWas == false && mlVRCutterAtNotes < 8)
+				{
+					mlVRCutterAtNotes++;
+					VRCutterNote("the left palm is at the other handle (" + int(fToHandle * 100.0f) + " cm from its middle, " + int(vLeftAt.y * 100.0f) +
+								 " cm along it): a squeeze takes it");
+				}
+				if(bLeftTook && (bAt || mbVRCuttersAtWas) && mbVRCuttersBroke == false)
+				{
+					m_mtxVRCuttersGrip = cMath_MatrixMul(cMath_MatrixInverse(m_mtxVRCuttersPalmWas), mtxNow);
+					m_mtxVRCuttersRightIn = cMath_MatrixInverse(m_mtxVRCuttersGrip);
+					mfVRCuttersHand = fHand;
+					mvVRCuttersLeftAt = vLeftAt;
+					// (The size they are drawn at; how far apart the real hands are against their
+					// places on the handles, shut: the opening is how much further apart they come.)
+					mfVRCutScale = cMath_Max(cMath_MatrixMul3x3(mtxNow, cVector3f(1.0f, 0.0f, 0.0f)).Length(), 0.01f);
+					mfVRCutApartOff = (mtxLeft.GetTranslation() - mtxRight.GetTranslation()).Length() -
+									  mfVRCutScale * BunkerVR_CutterPalmsApart(m_mtxVRCuttersRightIn.GetTranslation(), vLeftAt, fHand, 0.0f);
+					mbVRCutPinnedWas = false;
+					mVRCut.mfOpen = 0.0f;
+					mVRCut.mlState = 0;
+					mVRCut.mfCut = 0.0f;
+					mVRCut.mfPress = 0.0f;
+					mVRCut.mlCrunches = 0;
+					mfVRCutLag = 0.0f;
+					msVRCutTarget = "";
+					mlVRCutKind = 0;
+					mfVRCutSinceOpen = 100.0f;
+					mfVRCutBuzzWait = 0.0f;
+					mbVRCuttersTwo = true;
+					cScript_SetGlobalVarInt("BunkerVR_CuttersPosed", 1);
+					pCutters.PlayAnimation(gsVRCutterPoseAnim, 0.1f, false);
+					VRBuzzHand(1, 0.03f, 0.35f);
+					VRCutterNote("the left hand takes the other handle (" + int(fToHandle * 100.0f) + " cm from it; the right hand on handle " + (fHand > 0.0f ? "1" : "2") +
+								 ", " + VRFitText(mtxRightIn.GetTranslation()) + " cm in the cutters)");
+				}
+				mbVRCuttersAtWas = bAt;
+			}
+			m_mtxVRCuttersPalmWas = mtxRight;
+			mbVRCuttersPalmKnown = true;
+			if(mbVRCuttersTwo == false) return;
+		}
+		if(bLeftOn == false)
+		{
+			VRCuttersLetGo(pCutters, "the left hand lets go of the handle");
+			return;
+		}
+		
+		// Both hands (helper_bunkervr_tools.hps): the palms' places on their handles shut; how far
+		// open the hands hold them, from how far apart they are; where the cutters are at the
+		// opening last drawn (the jaws where they were drawn), what is in the jaws, the jaws' step.
+		cMatrixf mtxRightShut = m_mtxVRCuttersRightIn;
+		cMatrixf mtxLeftShut = BunkerVR_CutterLeftPalm(m_mtxVRCuttersRightIn, mvVRCuttersLeftAt, mfVRCuttersHand, 0.0f);
+		float fApart = ((mtxLeft.GetTranslation() - mtxRight.GetTranslation()).Length() - mfVRCutApartOff) / mfVRCutScale; // (in their own terms)
+		float fWanted = BunkerVR_CutterOpeningApart(mtxRightShut.GetTranslation(), mtxLeftShut.GetTranslation(), mfVRCuttersHand, fApart);
+		cMatrixf mtxFrameWas = VRCutterFrame(mtxRight, mtxLeft, mtxRightShut, mtxLeftShut, mVRCut.mfOpen, mVRCut.mlState == 1);
+		// Bitten, the cutters stay on what they bite while the jaws close; they turn
+		// about it to the hands (BunkerVR_CutterPinned: pushing down or lifting, they
+		// pivot on it), and slip off only when the hands pull away from it,
+		// gfVRCutterPullSlip further from it than they are drawn.
+		bool bSlipped = false;
+		float fPinPull = 0.0f;
+		if(mVRCut.mlState == 1)
+		{
+			cVector3f vMiddleReal = (mtxRight.GetTranslation() + mtxLeft.GetTranslation()) * 0.5f;
+			cVector3f vMiddleDrawn = cMath_MatrixMul(mtxFrameWas, (BunkerVR_CutterPalmOpen(mtxRightShut, mfVRCuttersHand, mVRCut.mfOpen).GetTranslation() +
+																   BunkerVR_CutterPalmOpen(mtxLeftShut, -mfVRCuttersHand, mVRCut.mfOpen).GetTranslation()) * 0.5f);
+			fPinPull = (vMiddleReal - mvVRCutPin).Length() - (vMiddleDrawn - mvVRCutPin).Length();
+			bSlipped = fPinPull > gfVRCutterPullSlip;
+		}
+		cVector3f vJaws = cMath_MatrixMul(mtxFrameWas, gvBunkerVR_CutterJaws);
+		int lKind = 0;
+		tString sTarget = VRCutterTarget(pMap, vJaws, mVRCut.mlState > 0 ? msVRCutTarget : "", lKind);
+		if(mVRCut.mlState == 0)
+		{
+			msVRCutTarget = sTarget;
+			mlVRCutKind = lKind;
+		}
+		bool bInJaws = sTarget != "" && sTarget == msVRCutTarget && bSlipped == false;
+		float fWas = mVRCut.mfOpen;
+		float fCutWas = mVRCut.mfCut;
+		mVRCut.Step(fWanted, bInJaws, BunkerVR_CutThrough(mlVRCutKind), BunkerVR_CutSeconds(mlVRCutKind), afTimeStep);
+		int lEvents = mVRCut.mlEvents;
+		// The hold-back (the jaws more open than the hands, biting): both hands drawn on the
+		// handles at the jaws' opening, each as far behind its real hand (the cutters between
+		// the hands).
+		mfVRCutLag = mVRCut.mlState == 1 ? mVRCut.mfOpen - cMath_Clamp(fWanted, 0.0f, 1.0f) : 0.0f;
+		if((lEvents & glBunkerVR_CutBite) != 0) mvVRCutPin = vJaws; // (where they bit)
+		bool bPinned = mVRCut.mlState == 1;
+		cMatrixf mtxFrame = VRCutterFrame(mtxRight, mtxLeft, mtxRightShut, mtxLeftShut, mVRCut.mfOpen, bPinned);
+		// Let go of what they bit (opened, slipped, cut): from where they were drawn, eased over 0.08 s.
+		if(mbVRCutPinnedWas && bPinned == false) mvVRCutPinShift = m_mtxVRCutFrameWas.GetTranslation() - mtxFrame.GetTranslation();
+		else if(bPinned) mvVRCutPinShift = cVector3f(0.0f);
+		else mvVRCutPinShift = mvVRCutPinShift * cMath_Max(0.0f, 1.0f - afTimeStep / 0.08f);
+		mbVRCutPinnedWas = bPinned;
+		mtxFrame.SetTranslation(mtxFrame.GetTranslation() + mvVRCutPinShift);
+		m_mtxVRCutFrameWas = mtxFrame;
+		
+		// Felt and heard (not the sound of the game's whole scene: the hands'
+		// closing does it). Biting: a knock in both
+		// hands, the chain rattling on its door (its own animation and sound).
+		// Squeezing through: a strain in both hands growing as it goes, while the
+		// hands press on; a crunch (and a creak of metal, if the game has it) at
+		// each sixth of the way. Through: a jolt in both hands, the snap of the
+		// cut (the game's own), the jaws shut with the hands.
+		iLuxEntity@ pTarget = msVRCutTarget != "" ? pMap.GetEntityByName(msVRCutTarget) : null;
+		mfVRCutBiteQuiet -= afTimeStep;
+		if((lEvents & glBunkerVR_CutBite) != 0)
+		{
+			// (Felt and heard once: not again within gfVRCutterBiteQuiet of the last.)
+			bool bHeard = mfVRCutBiteQuiet <= 0.0f;
+			mfVRCutBiteQuiet = gfVRCutterBiteQuiet;
+			if(bHeard)
+			{
+				VRBuzzHand(0, 0.05f, 0.65f);
+				VRBuzzHand(1, 0.05f, 0.65f);
+			}
+			if(bHeard && pTarget !is null && mlVRCutKind == 1)
+			{
+				cLuxProp@ pChain = cLux_ToProp(pTarget);
+				if(pChain !is null) pChain.PlayAnimation("chain_rattle", 0.1f, false);
+				VRPlayTrySound(pTarget, "BunkerVR_CutBite", gvVRCutBiteChainSounds, 1.0f);
+			}
+			else if(bHeard && pTarget !is null && mlVRCutKind == 2) VRPlayTrySound(pTarget, "BunkerVR_CutBite", gvVRCutBitePadlockSounds, 1.0f);
+			VRCutterNote("the jaws close on " + msVRCutTarget + " (" + VRCutterKindName(mlVRCutKind) + "), opened " + int(fWas * 100.0f) + "%, bitten at " + int(mVRCut.mfBiteAt * 100.0f) +
+						 "%: squeezed hard (the hands to " + int(BunkerVR_CutThrough(mlVRCutKind) * 100.0f) + "%) it cuts in " + BunkerVR_Fixed(BunkerVR_CutSeconds(mlVRCutKind), 2) + " s");
+		}
+		if((lEvents & glBunkerVR_CutSqueeze) != 0) VRCutterNote("squeezing " + msVRCutTarget + " through (pressed " + int(mVRCut.mfPress * 100.0f) + "% of the way)");
+		if(mVRCut.mlState == 1)
+		{
+			// (Strained while the hands press: past gfBunkerVR_CutterPress it cuts, and the strain grows as
+			// it goes and the harder they squeeze; short of it, a faint strain: the metal holding.)
+			mfVRCutBuzzWait -= afTimeStep;
+			if(mVRCut.mfPress > 0.05f && mfVRCutBuzzWait <= 0.0f)
+			{
+				mfVRCutBuzzWait = 0.06f;
+				float fKind = mlVRCutKind == 1 ? 1.0f : (mlVRCutKind == 2 ? 0.85f : 0.6f);
+				float fStrain = mVRCut.mfPress > gfBunkerVR_CutterPress ? (0.3f + 0.35f * mVRCut.mfCut + 0.3f * mVRCut.mfPress) * fKind : 0.15f;
+				VRBuzzHand(0, 0.05f, fStrain);
+				VRBuzzHand(1, 0.05f, fStrain);
+			}
+		}
+		if((lEvents & glBunkerVR_CutCrunch) != 0)
+		{
+			VRBuzzHand(0, 0.03f, 0.95f);
+			VRBuzzHand(1, 0.03f, 0.95f);
+			mfVRCutBuzzWait = 0.05f;
+			if(pTarget !is null && mVRCut.mlCrunches % 2 == 0) VRPlayTrySound(pTarget, "BunkerVR_CutCrunch", gvVRCutCrunchSounds, 0.6f + 0.4f * mVRCut.mfCut); // (every other one: they would run into each other)
+		}
+		if((lEvents & glBunkerVR_CutLetGo) != 0)
+		{
+			if(bSlipped)
+			{
+				VRBuzzHand(0, 0.06f, 0.6f);
+				VRBuzzHand(1, 0.06f, 0.6f);
+			}
+			VRCutterNote((bSlipped ? "the jaws slip off " : "let go of ") + msVRCutTarget + " (squeezed " + int(fCutWas * 100.0f) + "% through" +
+						 (bSlipped ? "; the hands pulled " + int(fPinPull * 100.0f) + " cm further from it than the cutters held them" : "") + ")");
+			msVRCutTarget = "";
+			mlVRCutKind = 0;
+		}
+		if((lEvents & glBunkerVR_Cut) != 0)
+		{
+			VRBuzzHand(0, 0.15f, 1.0f);
+			VRBuzzHand(1, 0.15f, 1.0f);
+			if(pTarget !is null) VRPlayTrySound(pTarget, "BunkerVR_CutSnap", gvVRCutSnapSounds, 1.0f);
+			cVR_HintUsed("cutters_aim");
+			cVR_HintUsed("cutters_cut");
+			VRCutterCut(msVRCutTarget, mlVRCutKind);
+			msVRCutTarget = "";
+			mlVRCutKind = 0;
+			mfVRCutListTime = -100.0f;
+		}
+		// Shut quickly on nothing: the snip.
+		if(mVRCut.mfOpen >= 0.45f) mfVRCutSinceOpen = 0.0f;
+		else mfVRCutSinceOpen += afTimeStep;
+		if(mVRCut.mlState == 0 && (lEvents & glBunkerVR_Cut) == 0 && fWas > 0.06f && mVRCut.mfOpen <= 0.06f && mfVRCutSinceOpen < 0.35f)
+		{
+			Sound_CreateAtEntity("BunkerVR_CutterSnip", "player/tools/cutter/cut_air", pCutters.GetName(), 0.0f, false, 0.7f);
+			VRBuzzHand(0, 0.02f, 0.3f);
+			VRBuzzHand(1, 0.02f, 0.3f);
+		}
+		
+		// Drawn: the cutters between the hands at the jaws' opening (their own animation
+		// held there turns both handles), each hand on its handle, turned about it as its real
+		// hand is (BunkerVR_PalmRolled: the wrists as the player holds them); all eased from where
+		// they were drawn after letting go of what they bit (mvVRCutPinShift, in mtxFrame).
+		cMatrixf mtxDrawn = mtxFrame;
+		cMatrixf mtxRightIn = BunkerVR_CutterPalmOpen(mtxRightShut, mfVRCuttersHand, mVRCut.mfOpen);
+		cMatrixf mtxLeftIn = BunkerVR_CutterPalmOpen(mtxLeftShut, -mfVRCuttersHand, mVRCut.mfOpen);
+		cVector3f vRightBar = cMath_MatrixMul3x3(mtxRightIn.GetRotation().GetTranspose(), BunkerVR_CutterHandleWay(mfVRCuttersHand, mVRCut.mfOpen));
+		cVector3f vLeftBar = cMath_MatrixMul3x3(mtxLeftIn.GetRotation().GetTranspose(), BunkerVR_CutterHandleWay(-mfVRCuttersHand, mVRCut.mfOpen));
+		cMatrixf mtxRightDrawn = BunkerVR_PalmRolled(cMath_MatrixMul(mtxFrame, mtxRightIn), mtxRight, vRightBar);
+		cMatrixf mtxLeftOn = BunkerVR_PalmRolled(cMath_MatrixMul(mtxFrame, mtxLeftIn), mtxLeft, vLeftBar);
+		cAnimationState@ pPose = pMesh.GetAnimationStateFromName(gsVRCutterPoseAnim);
+		if(pPose !is null)
+		{
+			if(pPose.IsActive() == false) pCutters.PlayAnimation(gsVRCutterPoseAnim, 0.1f, false);
+			pPose.SetRelativeTimePosition(BunkerVR_CutterPoseTime(mVRCut.mfOpen));
+			pPose.SetPaused(true);
+		}
+		
+		// The real left hand pulled well away from its handle: it lets go of it
+		// (until the grip is let go of and squeezed again). Closing the hands
+		// further than the drawn handles (squeezing through, the jaws held back; or
+		// past shut) is not pulling away, or squeezing on a chain would make it let
+		// go: the share of its way off towards the right hand is left out.
+		cVector3f vLeftOff = mtxLeft.GetTranslation() - mtxLeftOn.GetTranslation();
+		cVector3f vToRight = mtxRightDrawn.GetTranslation() - mtxLeftOn.GetTranslation();
+		if(vToRight.Length() > 0.001f)
+		{
+			vToRight.Normalize();
+			float fIn = cMath_Vector3Dot(vLeftOff, vToRight);
+			if(fIn > 0.0f) vLeftOff = vLeftOff - vToRight * fIn;
+		}
+		float fLeftOff = vLeftOff.Length();
+		float fRoundOff = cMath_Abs(fWanted - mVRCut.mfOpen);
+		if(fLeftOff > gfVRCutterLetGoReach || fRoundOff > 1.0f)
+		{
+			mbVRCuttersBroke = true;
+			VRCuttersLetGo(pCutters, "the left hand is pulled off the handle (" + int(fLeftOff * 100.0f) + " cm off it, " + int(fRoundOff * 100.0f) +
+						   "% of the opening round from it)");
+			return;
+		}
+		
+		cVR_LeftAtPump(true);
+		cVR_RightFitted();
+		VRFitPublish(mtxRightDrawn, mtxDrawn);
+		VRLeftFitPublish(mtxLeftOn);
+	}
+	
+	// BunkerVR: where the cutters are held by both hands (see VRUpdateCutters and
+	// helper_bunkervr_tools.hps): the real palms a_mtxRight and a_mtxLeft, their places on the
+	// handles shut a_mtxRightShut and a_mtxLeftShut, the cutters afOpen of the way open; abPinned,
+	// on what they bit (mvVRCutPin): turned about it to the hands. Otherwise the jaws point the way
+	// both handles point in the real hands, taken alike (the handles' own lines, which a hand turned
+	// about its handle does not change).
+	cMatrixf VRCutterFrame(const cMatrixf &in a_mtxRight, const cMatrixf &in a_mtxLeft, const cMatrixf &in a_mtxRightShut, const cMatrixf &in a_mtxLeftShut,
+						   float afOpen, bool abPinned)
+	{
+		cMatrixf mtxRightIn = BunkerVR_CutterPalmOpen(a_mtxRightShut, mfVRCuttersHand, afOpen);
+		cMatrixf mtxLeftIn = BunkerVR_CutterPalmOpen(a_mtxLeftShut, -mfVRCuttersHand, afOpen);
+		if(abPinned)
+			return BunkerVR_CutterPinned(mtxRightIn.GetTranslation(), mtxLeftIn.GetTranslation(), a_mtxRight.GetTranslation(), a_mtxLeft.GetTranslation(), mvVRCutPin, mfVRCutScale);
+		// Each handle's way (towards the hinge) as the real hand holds it; their sum lies along the jaws.
+		cVector3f vRightBar = cMath_MatrixMul3x3(mtxRightIn.GetRotation().GetTranspose(), BunkerVR_CutterHandleWay(mfVRCuttersHand, afOpen));
+		cVector3f vLeftBar = cMath_MatrixMul3x3(mtxLeftIn.GetRotation().GetTranspose(), BunkerVR_CutterHandleWay(-mfVRCuttersHand, afOpen));
+		cVector3f vForward = cMath_MatrixMul3x3(a_mtxRight, vRightBar) + cMath_MatrixMul3x3(a_mtxLeft, vLeftBar);
+		if(vForward.Length() < 0.2f) vForward = cMath_MatrixMul3x3(a_mtxRight, vRightBar); // (the handles held the wrong way round: the right hand's)
+		return BunkerVR_CutterBetween(mtxRightIn.GetTranslation(), mtxLeftIn.GetTranslation(), a_mtxRight.GetTranslation(), a_mtxLeft.GetTranslation(),
+									  cMath_Vector3Normalize(vForward), mfVRCutScale);
+	}
+
+	// BunkerVR: the cutters are let go of with the left hand (see
+	// VRUpdateCutters): both hands on their controllers again, the cutters in
+	// the right hand as it holds them, their own animation run on to its end
+	// (shut), and the game's own animations of them again.
+	void VRCuttersLetGo(cLuxProp@ apCutters, const tString &in asNote)
+	{
+		if(mbVRCuttersTwo == false) return;
+		mbVRCuttersTwo = false;
+		cScript_SetGlobalVarInt("BunkerVR_CuttersPosed", 0);
+		cScript_SetGlobalVarInt("BunkerVR_FitStamp", 0);
+		VRLeftFitEnd();
+		cMeshEntity@ pMesh = apCutters !is null ? apCutters.GetMeshEntity() : null;
+		cAnimationState@ pPose = pMesh !is null ? pMesh.GetAnimationStateFromName(gsVRCutterPoseAnim) : null;
+		if(pPose !is null && pPose.IsActive())
+		{
+			pPose.SetRelativeTimePosition(gfVRCutterShutAfter);
+			pPose.SetPaused(false);
+		}
+		mVRCut.mlState = 0;
+		mVRCut.mfCut = 0.0f;
+		mVRCut.mfPress = 0.0f;
+		mVRCut.mlCrunches = 0;
+		mvVRCutPinShift = cVector3f(0.0f); // (back in the right hand as it holds them)
+		mbVRCutPinnedWas = false;
+		mfVRCutLag = 0.0f;
+		msVRCutTarget = "";
+		mlVRCutKind = 0;
+		mbVRCuttersPalmKnown = false;
+		VRCutterNote(asNote);
+	}
+	
+	// BunkerVR: what the cutters' jaws (their middle at avJaws) are on: the
+	// nearest chain lock's chain, padlock's shackle or trap's wire within
+	// gfBunkerVR_CutterInJaws of it (asKeep, if not "": only that one, the
+	// one bitten, within gfBunkerVR_CutterHold). alKind: 1 a chain lock, 2 a
+	// padlock, 3 a trap's wire; "" none.
+	tString VRCutterTarget(cLuxMap@ apMap, const cVector3f &in avJaws, const tString &in asKeep, int &out alKind)
+	{
+		alKind = 0;
+		VRCutterListTargets(apMap);
+		float fReach = asKeep != "" ? gfBunkerVR_CutterHold : gfBunkerVR_CutterInJaws;
+		tString sBest = "";
+		for(uint i = 0; i < mvVRCutTargets.length(); ++i)
+		{
+			iLuxEntity@ pThing = cLux_ID_Entity(mvVRCutTargets[i]);
+			if(pThing is null || pThing.IsActive() == false) continue;
+			if(asKeep != "" && pThing.GetName() != asKeep) continue;
+			cVector3f vMiddle, vX, vY, vZ, vHalf;
+			if(VRCutterBox(pThing, mvVRCutKinds[i], vMiddle, vX, vY, vZ, vHalf) == false) continue;
+			float fOff = (BunkerVR_NearestInBox(avJaws, vMiddle, vX, vY, vZ, vHalf) - avJaws).Length();
+			if(fOff > fReach) continue;
+			fReach = fOff;
+			sBest = pThing.GetName();
+			alKind = mvVRCutKinds[i];
+		}
+		return sBest;
+	}
+	
+	// BunkerVR: the box of what is cut of a thing the cutters can cut (see
+	// VRCutterTarget): a chain lock's body (its chain, around the handles), the
+	// top 30% of a padlock's lock (its shackle, under the hasp), a trap's
+	// wire. Its middle, its own x, y and z (unit), its half sizes.
+	bool VRCutterBox(iLuxEntity@ apThing, int alKind, cVector3f &out avMiddle, cVector3f &out avX, cVector3f &out avY, cVector3f &out avZ, cVector3f &out avHalf)
+	{
+		avMiddle = cVector3f(0.0f);
+		avX = cVector3f(1.0f, 0.0f, 0.0f);
+		avY = cVector3f(0.0f, 1.0f, 0.0f);
+		avZ = cVector3f(0.0f, 0.0f, 1.0f);
+		avHalf = cVector3f(0.0f);
+		iPhysicsBody@ pBody = null;
+		if(alKind == 1) @pBody = apThing.GetMainBody();
+		else if(alKind == 2) @pBody = apThing.GetBodyFromName("Body_1");
+		else if(alKind == 3)
+		{
+			cScript_RunGlobalFunc(apThing.GetName(), "cScrPropTrap", "_Global_VRWireBody");
+			int lWire = cScript_GetGlobalReturnInt();
+			if(lWire >= 0 && lWire < apThing.GetBodyNum()) @pBody = apThing.GetBody(lWire);
+		}
+		cBoundingVolume@ pBox = pBody !is null ? pBody.GetBoundingVolume() : null;
+		if(pBox is null) return false;
+		cVector3f vMin = pBox.GetLocalMin();
+		cVector3f vMax = pBox.GetLocalMax();
+		if(alKind == 2) vMin.y = vMax.y - (vMax.y - vMin.y) * 0.3f;
+		cMatrixf mtxBody = pBody.GetWorldMatrix();
+		avX = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxBody, cVector3f(1.0f, 0.0f, 0.0f)));
+		avY = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxBody, cVector3f(0.0f, 1.0f, 0.0f)));
+		avZ = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxBody, cVector3f(0.0f, 0.0f, 1.0f)));
+		avMiddle = cMath_MatrixMul(mtxBody, (vMin + vMax) * 0.5f);
+		avHalf = (vMax - vMin) * 0.5f;
+		return avHalf.x > 0.0f || avHalf.y > 0.0f || avHalf.z > 0.0f;
+	}
+	
+	// BunkerVR: the things the cutters can cut (see VRCutterTarget): each
+	// chain lock not yet cut, each padlock still there, each trap still armed.
+	// Listed again every 2 seconds while wanted.
+	void VRCutterListTargets(cLuxMap@ apMap)
+	{
+		float fNow = float(cEngine_GetGameTime());
+		if(fNow - mfVRCutListTime < 2.0f && fNow >= mfVRCutListTime) return;
+		mfVRCutListTime = fNow;
+		mvVRCutTargets.resize(0);
+		mvVRCutKinds.resize(0);
+		array<tString> vClass = {"cScrPropChainLock", "cScrPropPadlock", "cScrPropTrap"};
+		for(int lKind = 1; lKind <= 3; ++lKind)
+		{
+			array<iLuxEntity@> vThings;
+			apMap.GetEntityArray("*", eLuxEntityType_Prop, vClass[lKind - 1], vThings);
+			for(uint i = 0; i < vThings.length(); ++i)
+			{
+				if(vThings[i] is null || vThings[i].IsActive() == false) continue;
+				tString sName = vThings[i].GetName();
+				if(lKind == 1 && ChainLock_GetIsBroken(sName)) continue;
+				if(lKind == 3 && Trap_GetIsArmed(sName) == false) continue;
+				mvVRCutTargets.insertLast(vThings[i].GetID());
+				mvVRCutKinds.insertLast(lKind);
+			}
+		}
+	}
+	
+	// BunkerVR: cut through (see VRUpdateCutters): what the game's own scenes
+	// do at their cut (PlayerState_UsingCutters.hps, helper_props_custom.hps).
+	void VRCutterCut(const tString &in asThing, int alKind)
+	{
+		if(alKind == 1)
+		{
+			cScript_RunGlobalFunc(asThing, "cScrPropChainLock", "_Global_Break");
+			Achievement_IncreaseCleithrophobistCount();
+		}
+		else if(alKind == 2)
+		{
+			cScript_RunGlobalFunc(asThing, "cScrPropPadlock", "_Global_Break");
+			Achievement_IncreaseCleithrophobistCount();
+			msVRPadlockFalling = asThing + "_Cut"; // (it falls at once: VRUpdatePadlockFall)
+			mfVRPadlockFallWait = 0.5f;
+			VRUpdatePadlockFall(0.0f);
+		}
+		else if(alKind == 3)
+		{
+			cScript_RunGlobalFunc(asThing, "cScrPropTrap", "_Global_Disarm");
+		}
+		VRCutterNote(asThing + " is cut through (" + VRCutterKindName(alKind) + ")");
+	}
+	
+	// BunkerVR: a padlock cut by hand falls at once. The game's break puts the
+	// cut padlock in its place (padlock_cut.ent, Prop_PadlockCut.hps), whose
+	// "padlock_cut" (5 s, from its .fbx) is timed for the game's own scene:
+	// still until 0.9 s, the shackle giving then, a wiggle at 1.8 s, the fall
+	// from 2.3 s (landing by 3.2 s, a meter down); and it is faded in over a
+	// whole second, so the lock would fall about 2 s after the cut. Here it is
+	// taken, as soon as it plays, to gfVRPadlockFallFrom at full weight, its fade
+	// stopped: it falls at once. (Its door is still unlocked by its own script,
+	// at 75% of the animation.) Tried for up to half a second after the cut.
+	void VRUpdatePadlockFall(float afTimeStep)
+	{
+		if(msVRPadlockFalling == "") return;
+		mfVRPadlockFallWait -= afTimeStep;
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		cLuxProp@ pCut = pMap !is null ? cLux_ToProp(pMap.GetEntityByName(msVRPadlockFalling)) : null;
+		cMeshEntity@ pMesh = pCut !is null ? pCut.GetMeshEntity() : null;
+		cAnimationState@ pAnim = pMesh !is null ? pMesh.GetAnimationStateFromName("padlock_cut") : null;
+		if(pAnim !is null && pAnim.IsActive() && pAnim.GetLength() > gfVRPadlockFallFrom)
+		{
+			if(pAnim.GetTimePosition() < gfVRPadlockFallFrom)
+			{
+				pAnim.SetFadeStep(0.0f);
+				pAnim.SetWeight(1.0f);
+				pAnim.SetTimePosition(gfVRPadlockFallFrom);
+				VRCutterNote(msVRPadlockFalling + " falls at once (its animation taken to " + BunkerVR_Fixed(gfVRPadlockFallFrom, 1) + " s of " +
+							 BunkerVR_Fixed(pAnim.GetLength(), 1) + ", unfaded)");
+			}
+			msVRPadlockFalling = "";
+			return;
+		}
+		if(mfVRPadlockFallWait <= 0.0f)
+		{
+			VRCutterNote(msVRPadlockFalling + ": its animation was not found playing (left as the game has it)");
+			msVRPadlockFalling = "";
+		}
+	}
+	
+	tString VRCutterKindName(int alKind)
+	{
+		if(alKind == 1) return "a chain lock";
+		if(alKind == 2) return "a padlock";
+		if(alKind == 3) return "a trap's wire";
+		return "nothing";
+	}
+	
+	// BunkerVR: does the left hand hold the other handle of a tool in the right
+	// hand (the mod's word: special roll 7014, its third number +2, as for the
+	// left hand on a gun)?
+	bool VRLeftHoldsTool()
+	{
+		cCamera@ pCam = cLux_GetPlayer().GetCamera();
+		if(pCam is null) return false;
+		float fRealRoll = pCam.GetRoll();
+		pCam.SetRoll(7014.0f);
+		cVector3f vStatus = pCam.GetMatrix().GetTranslation();
+		pCam.SetRoll(fRealRoll);
+		if(vStatus.x < 12344.0f || vStatus.x > 12346.0f) return false;
+		return (int(vStatus.z + 0.5f) & 2) != 0;
+	}
+	
+	// BunkerVR: where the left hand is drawn while it holds a tool's other
+	// handle (see VRUpdateCutters; read by UpdateVRArms in Prop_PlayerBody.hps,
+	// VRFittedLeftHand), with a new stamp each update; and its end.
+	void VRLeftFitPublish(const cMatrixf &in a_mtxHand)
+	{
+		mlVRLeftFitStamp = mlVRLeftFitStamp % 1000000 + 1;
+		cScript_SetGlobalVarVector3f("BunkerVR_LeftFitAt", a_mtxHand.GetTranslation());
+		cScript_SetGlobalVarVector3f("BunkerVR_LeftFitRight", a_mtxHand.GetRight());
+		cScript_SetGlobalVarVector3f("BunkerVR_LeftFitUp", a_mtxHand.GetUp());
+		cScript_SetGlobalVarVector3f("BunkerVR_LeftFitForward", a_mtxHand.GetForward());
+		cScript_SetGlobalVarInt("BunkerVR_LeftFitStamp", mlVRLeftFitStamp);
+	}
+	
+	void VRLeftFitEnd()
+	{
+		cScript_SetGlobalVarInt("BunkerVR_LeftFitStamp", 0);
+	}
+	
+	// BunkerVR: the first of avFiles that plays, at apAt (not attached), under
+	// asName and a number of its own, afVolume of its own loudness.
+	// One that does not play (no such event: PlaySound gives null, the engine
+	// logs "Failed to play sound") is logged as "BunkerVR sound:" and not tried
+	// again. False: none played.
+	bool VRPlayTrySound(iLuxEntity@ apAt, const tString &in asName, const tString[] &in avFiles, float afVolume)
+	{
+		if(apAt is null) return false;
+		for(uint i = 0; i < avFiles.length(); ++i)
+		{
+			if(mvVRSoundsMissing.find(avFiles[i]) >= 0) continue;
+			mlVRTrySounds++;
+			cSoundEntity@ pSound = apAt.PlaySound(asName + "_" + mlVRTrySounds, avFiles[i], true, false);
+			if(pSound !is null)
+			{
+				if(afVolume < 0.999f) pSound.FadeVolumeMul(afVolume, 0.0f);
+				return true;
+			}
+			mvVRSoundsMissing.insertLast(avFiles[i]);
+			Log("BunkerVR sound: " + avFiles[i] + " could not be played (not tried again)\n");
+		}
+		return false;
+	}
+	
+	// BunkerVR: a "BunkerVR cutters:" line in hpl.log (the first 60).
+	void VRCutterNote(const tString &in asText)
+	{
+		if(mlVRCutterNotes >= 60) return;
+		mlVRCutterNotes++;
+		Log("BunkerVR cutters: " + asText + "\n");
+	}
+	
+	// BunkerVR: the gas mask by hand, taken out from the inventory. Used from
+	// the inventory (or its key: ItemCallbacks.hps
+	// asks, "BunkerVR_MaskAsked"), the mask comes into the right hand (what
+	// that hand held put away meanwhile), held by its front, its top along
+	// the fingers (BunkerVR_MaskInPalm; the game's own model of it in the
+	// hand). Brought to the face facing out (its middle within
+	// gfBunkerVR_MaskOnReach of the face, its front within 60 degrees of the
+	// way the head looks; once it has been gfBunkerVR_MaskBackOn away), it
+	// goes on at once (Player_Custom.hps _Global_VRPutOnGasMask: as the game's
+	// own putting on ends, without its animation), and what the right hand
+	// held comes back. Squeezed and let go of away from the face, it goes back
+	// in the pockets. On the face, an empty hand squeezed at it
+	// (gfBunkerVR_MaskTakeReach) takes hold of it, and pulled away
+	// (gfBunkerVR_MaskOffPull) takes it off into that hand (held while
+	// squeezed); used from the inventory, it stays on.
+	// The game's own putting on and taking off (a level's, as in the prologue)
+	// are left as they are, and end any mask in the hand. Logged as "BunkerVR
+	// mask:" in hpl.log (the first 60).
+	void VRUpdateMask(float afTimeStep)
+	{
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		cCamera@ pCam = cLux_GetPlayer().GetCamera();
+		if(pMap is null || pCam is null) return;
+		bool bAsked = cScript_GetGlobalVarInt("BunkerVR_MaskAsked") == 1;
+		if(bAsked) cScript_SetGlobalVarInt("BunkerVR_MaskAsked", 0);
+		bool bOn = Player_GetGasMaskEquipped();
+		cScript_RunGlobalFunc("LuxPlayer", "", "_Global_VRGasMaskEquipping");
+		bool bGameBusy = cScript_GetGlobalReturnBool();
+		cMatrixf mtxHead = cMatrixf_Identity;
+		bool bHead = VRReadRealHead(pCam, mtxHead);
+		cVector3f vFace = BunkerVR_FacePoint(mtxHead.GetTranslation(), cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxHead, cVector3f(0.0f, 0.0f, -1.0f))),
+											 cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxHead, cVector3f(0.0f, 1.0f, 0.0f))));
+		cVector3f vLooks = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxHead, cVector3f(0.0f, 0.0f, -1.0f)));
+		mvVRHintFace = vFace; // (for the hints: VRUpdateHints)
+		mbVRHintFaceKnown = bHead;
+		array<cMatrixf> vPalm = {cMatrixf_Identity, cMatrixf_Identity};
+		array<bool> vPalmKnown = {false, false};
+		array<bool> vSqueeze = {false, false};
+		float fArmScale = 1.0f;
+		for(int h = 0; h < 2; ++h)
+		{
+			cMatrixf mtxPalm = cMatrixf_Identity;
+			vPalmKnown[h] = BunkerVR_ReadFollowedPalm(h, mtxPalm, fArmScale);
+			vPalm[h] = mtxPalm;
+			vSqueeze[h] = cVR_HandSqueeze(h) > (mvVRMaskSqueezeWas[h] ? gfVRFitGripLetGo : gfVRFitGripPress);
+		}
+		
+		// The game's own putting on or taking off (a level's), the mask on by
+		// the game, or gone from the pockets: none in the hand.
+		if(mlVRMaskHand >= 0 && (bGameBusy || bOn || ItemType_GetFirstInInventory("GasMask") == ""))
+			VRMaskOutOfHand(pMap, true, "the mask in the hand goes: the game puts it on or off itself, or it has left the pockets");
+		
+		// Used from the inventory.
+		if(bAsked && bGameBusy == false)
+		{
+			if(mlVRMaskHand >= 0)
+			{
+				VRMaskOutOfHand(pMap, true, "the mask in the hand is put back from the inventory");
+			}
+			else if(bOn)
+			{
+				// (On the face it stays on: it comes off only when pulled off by hand.)
+				VRMaskNote("used from the inventory while on the face: it stays on (it comes off only pulled off by hand)");
+			}
+			else
+			{
+				VRMaskIntoHand(pMap, 1, false, vPalm[1]);
+				VRMaskNote("the mask is taken out into the right hand (from the inventory)" + (msVRMaskReEquip != "" ? ", what it held put away" : ""));
+			}
+		}
+		
+		// In a hand.
+		if(mlVRMaskHand >= 0)
+		{
+			int lHand = mlVRMaskHand;
+			iLuxEntity@ pMask = cLux_ID_Entity(m_idVRHandMask);
+			if(pMask is null)
+			{
+				VRMaskOutOfHand(pMap, true, "the mask in the hand is gone (a change of map?)");
+			}
+			else if(vPalmKnown[lHand])
+			{
+				cMatrixf mtxMask = cMath_MatrixMul(vPalm[lHand], BunkerVR_MaskInPalm(lHand));
+				pMask.SetMatrix(mtxMask);
+				if(lHand == 1) cVR_RightFitted(); // (the right squeeze is the mask's, not the game's)
+				cVector3f vSeat = cMath_MatrixMul(mtxMask, gvBunkerVR_MaskSeat);
+				float fToFace = (vSeat - vFace).Length();
+				float fFacing = cMath_Vector3Dot(cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxMask, cVector3f(0.0f, 0.0f, 1.0f))), vLooks);
+				if(bHead && fToFace >= gfBunkerVR_MaskBackOn) mbVRMaskFar = true;
+				if(vSqueeze[lHand] && mvVRMaskSqueezeWas[lHand] == false) mbVRMaskGripped = true; // (a squeeze begun with it in the hand: not the menu's press that brought it)
+				if(bHead && mbVRMaskFar && fToFace <= gfBunkerVR_MaskOnReach && fFacing >= gfBunkerVR_MaskFacing)
+				{
+					VRBuzzHand(lHand, 0.06f, 0.6f);
+					VRMaskOutOfHand(pMap, false, "the mask goes on (" + int(fToFace * 100.0f) + " cm from the face, its front " +
+									int(cMath_ToDeg(cMath_ACos(cMath_Clamp(fFacing, -1.0f, 1.0f)))) + " degrees off the way the head looks)");
+					cScript_RunGlobalFunc("LuxPlayer", "", "_Global_VRPutOnGasMask");
+					cVR_HintUsed("mask_on");
+					Sound_CreateAtEntity("BunkerVR_MaskOn", "player/tools/gasmask/equip", "player", 0.0f, false);
+					VRMaskGiveBack();
+					bOn = true;
+				}
+				else if(mbVRMaskGripped && vSqueeze[lHand] == false)
+				{
+					VRMaskOutOfHand(pMap, true, "the mask is let go of " + int(fToFace * 100.0f) + " cm from the face: back in the pockets");
+				}
+			}
+		}
+		cScript_SetGlobalVarInt("BunkerVR_MaskHand", mlVRMaskHand + 1);
+		
+		// On the face: an empty hand squeezed at it takes hold of it; pulled
+		// away, it comes off into that hand.
+		if(bOn && bGameBusy == false && bHead && mlVRMaskHand < 0)
+		{
+			if(mlVRMaskOnHand >= 0)
+			{
+				int lHand = mlVRMaskOnHand;
+				float fOff = vPalmKnown[lHand] ? (vPalm[lHand].GetTranslation() - vFace).Length() : 0.0f;
+				if(vSqueeze[lHand] == false || vPalmKnown[lHand] == false)
+				{
+					mlVRMaskOnHand = -1;
+				}
+				else if(fOff > gfBunkerVR_MaskOffPull)
+				{
+					mlVRMaskOnHand = -1;
+					cScript_RunGlobalFunc("LuxPlayer", "", "_Global_VRTakeOffGasMask");
+					cVR_HintUsed("mask_off");
+					Sound_CreateAtEntity("BunkerVR_MaskOff", "player/tools/gasmask/unequip", "player", 0.0f, false);
+					VRMaskIntoHand(pMap, lHand, true, vPalm[lHand]);
+					VRBuzzHand(lHand, 0.05f, 0.5f);
+					VRMaskNote("the mask is pulled off the face into the " + (lHand == 0 ? "left" : "right") + " hand");
+				}
+			}
+			else
+			{
+				for(int h = 0; h < 2; ++h)
+				{
+					if(vSqueeze[h] == false || mvVRMaskSqueezeWas[h] || vPalmKnown[h] == false) continue;
+					if(Item_GetHeldType(h == 0 ? eItemHandlerHand_Left : eItemHandlerHand_Right) != "") continue;
+					if((vPalm[h].GetTranslation() - vFace).Length() > gfBunkerVR_MaskTakeReach) continue;
+					mlVRMaskOnHand = h;
+					VRBuzzHand(h, 0.025f, 0.35f);
+					VRMaskNote("the " + (h == 0 ? "left" : "right") + " hand takes hold of the mask on the face");
+					break;
+				}
+			}
+		}
+		else
+		{
+			mlVRMaskOnHand = -1;
+		}
+		mvVRMaskSqueezeWas[0] = vSqueeze[0];
+		mvVRMaskSqueezeWas[1] = vSqueeze[1];
+	}
+	
+	// BunkerVR: the mask into a hand (see VRUpdateMask): the game's own model
+	// of it, placed in the palm. Into the right hand from the inventory, what
+	// that hand held is put away until the mask is on or back in the pockets.
+	// abGripped: held by the grip now (let go of, it goes back), or else held
+	// until the grip is first squeezed.
+	void VRMaskIntoHand(cLuxMap@ apMap, int alHand, bool abGripped, const cMatrixf &in a_mtxPalm)
+	{
+		if(alHand == 1 && abGripped == false)
+		{
+			msVRMaskReEquip = Item_GetHeld(eItemHandlerHand_Right);
+			if(msVRMaskReEquip != "") Item_Unequip(msVRMaskReEquip, true);
+		}
+		mlVRMasksMade++;
+		tString sName = "BunkerVR_HandMask_" + mlVRMasksMade;
+		apMap.ResetLatestEntity();
+		apMap.CreateEntity(sName, "gas_mask_cutscene.ent", cMath_MatrixMul(a_mtxPalm, BunkerVR_MaskInPalm(alHand)), cVector3f(1.0f, 1.0f, 1.0f));
+		iLuxEntity@ pMask = apMap.GetLatestEntity();
+		if(pMask is null || pMask.GetName() != sName)
+		{
+			VRMaskNote("the mask in the hand could not be made");
+			VRMaskGiveBack();
+			return;
+		}
+		Entity_SetInteractionDisabled(sName, true);
+		m_idVRHandMask = pMask.GetID();
+		mlVRMaskHand = alHand;
+		mbVRMaskGripped = abGripped;
+		mbVRMaskFar = false;
+		Sound_CreateAtEntity("BunkerVR_MaskTaken", "player/foley/action/pickup/gasmask", "player", 0.0f, false);
+	}
+	
+	// BunkerVR: the mask in the hand goes (on the face, or back in the
+	// pockets: abBack, with its sound and what the right hand held given back).
+	void VRMaskOutOfHand(cLuxMap@ apMap, bool abBack, const tString &in asNote)
+	{
+		iLuxEntity@ pMask = cLux_ID_Entity(m_idVRHandMask);
+		if(pMask !is null) apMap.DestroyEntity(pMask);
+		m_idVRHandMask = tID_Invalid;
+		mlVRMaskHand = -1;
+		if(abBack)
+		{
+			Sound_CreateAtEntity("BunkerVR_MaskBack", "player/foley/action/pickup/gasmask", "player", 0.0f, false);
+			VRMaskGiveBack();
+		}
+		VRMaskNote(asNote);
+	}
+	
+	// BunkerVR: what the right hand held before the mask came into it, back in it.
+	void VRMaskGiveBack()
+	{
+		if(msVRMaskReEquip != "" && Item_GetHeld(eItemHandlerHand_Right) == "") Item_Equip(msVRMaskReEquip);
+		msVRMaskReEquip = "";
+	}
+	
+	// BunkerVR: a "BunkerVR mask:" line in hpl.log (the first 60).
+	void VRMaskNote(const tString &in asText)
+	{
+		if(mlVRMaskNotes >= 60) return;
+		mlVRMaskNotes++;
+		Log("BunkerVR mask: " + asText + "\n");
+	}
+	
+	// BunkerVR: the pocket watch by hand. Held in the right hand it is read as
+	// it is. When the game wants it wound (after the generator is fed:
+	// helper_items.hps PocketWatch_WindUp, which in VR only marks it wanted
+	// and keeps it stopped), it waits, stopped, with a double buzz. A pull of
+	// the right trigger, the hand that holds it, winds it at once (the watch's
+	// hand climbs from where it stopped to the generator's new time,
+	// Prop_PocketWatch.hps _Global_VRWind, with a tick) and starts it ticking,
+	// with its click (and the game told it is wound: _Global_SetWindupTimestamp).
+	// The same pull starts it when the game would start it with its own click
+	// (PocketWatch_Run: "BunkerVR_WatchPress"). Not pulled in
+	// gfBunkerVR_WatchStartWait, it starts by itself. Logged as "BunkerVR
+	// watch:" (the first 60).
+	void VRUpdateWatch(float afTimeStep)
+	{
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		bool bWatch = pMap !is null && Item_GetHeldType(eItemHandlerHand_Right) == "PocketWatch";
+		iLuxEntity@ pWatch = bWatch ? pMap.GetEntityByName(Item_GetHeldEntity(eItemHandlerHand_Right)) : null;
+		// (The right trigger: pulled past gfBunkerVR_WatchTriggerPull, let go below gfBunkerVR_WatchTriggerLetGo, as the
+		// mod's own presses go.)
+		float fTrigger = cVR_HandTrigger(1);
+		bool bTrigger = fTrigger > (mbVRWatchTriggerWas ? gfBunkerVR_WatchTriggerLetGo : gfBunkerVR_WatchTriggerPull);
+		bool bPull = bTrigger && mbVRWatchTriggerWas == false;
+		mbVRWatchTriggerWas = bTrigger;
+		if(pWatch is null)
+		{
+			if(mbVRWatchWinding) VRWatchWindEnd(null, "the watch is put away while it wants winding");
+			mbVRWatchPinched = false;
+			mfVRWatchPressWait = 0.0f;
+			if(cScript_GetGlobalVarInt("BunkerVR_WatchPress") != 0) cScript_SetGlobalVarInt("BunkerVR_WatchPress", 0); // (taken out again, it is as the game has it then)
+			return;
+		}
+		bool bWindNeeded = PocketWatch_GetWindUpNeeded();
+		bool bPressWanted = cScript_GetGlobalVarInt("BunkerVR_WatchPress") == 1;
+		mvVRHintCrown = cMath_MatrixMul(pWatch.GetMatrix(), gvBunkerVR_WatchCrownTop); // (for the hints: VRUpdateHints)
+
+		// Wanted wound: a pull of the trigger winds it.
+		if(bWindNeeded)
+		{
+			if(mbVRWatchWinding == false)
+			{
+				mbVRWatchWinding = true;
+				mVRWatchWind.mfTurned = 0.0f;
+				mVRWatchWind.mfSlip = 0.0f;
+				mbVRWatchPinched = false;
+				VRWatchTellWound(pWatch, 0.0f);
+				VRBuzzHand(1, 0.08f, 0.35f);
+				VRWatchNote("the watch wants winding: stopped, waiting for the right trigger");
+			}
+			if(mVRWatchWind.Wound() == false && bPull)
+			{
+				mVRWatchWind.mfTurned = gfBunkerVR_WindTurn * float(glBunkerVR_WindsNeeded);
+				VRWatchTellWound(pWatch, 1.0f);
+				pWatch.PlaySound("BunkerVR_WatchTick", "player/tools/stopwatch/stopwatch_tick_old", true, true);
+				cScript_SetGlobalVarInt("BunkerVR_WatchPress", 1);
+				bPressWanted = true;
+				VRWatchNote("wound by the right trigger");
+			}
+		}
+		else if(mbVRWatchWinding)
+		{
+			VRWatchWindEnd(pWatch, "the watch no longer wants winding (the game has it)");
+		}
+
+		// Started: by the same pull (wound and started at once), or by a pull when the game would start it.
+		if(bPressWanted)
+		{
+			if(bWindNeeded && mVRWatchWind.Wound() == false)
+			{
+				mfVRWatchPressWait = 0.0f; // (wound first)
+			}
+			else
+			{
+				mfVRWatchPressWait += afTimeStep;
+				if(bPull || mfVRWatchPressWait >= gfBunkerVR_WatchStartWait)
+				{
+					if(bWindNeeded) cScript_RunGlobalFunc("State_UsingPocketWatch", "", "_Global_SetWindupTimestamp");
+					cScript_RunGlobalFunc(pWatch.GetName(), "cScrPropPocketWatch", "_Global_VRStart");
+					cScript_SetGlobalVarInt("BunkerVR_WatchPress", 0);
+					if(bPull) cVR_HintUsed("watch_wind");
+					pWatch.PlaySound("BunkerVR_WatchStart", "player/tools/stopwatch/stopwatch_start", true, true);
+					VRBuzzHand(1, 0.05f, 0.55f);
+					mbVRWatchWinding = false;
+					mbVRWatchPinched = false;
+					VRWatchNote(bPull ? "started by the right trigger: it runs" :
+								"not started in " + int(gfBunkerVR_WatchStartWait) + " s: it runs by itself");
+				}
+			}
+		}
+		else
+		{
+			mfVRWatchPressWait = 0.0f;
+			mbVRWatchTipAway = false;
+		}
+	}
+
+	// BunkerVR: tells the watch how far it is wound by hand (-1 not).
+	void VRWatchTellWound(iLuxEntity@ apWatch, float afWound)
+	{
+		if(apWatch is null) return;
+		cScript_SetGlobalArgFloat(0, afWound);
+		cScript_RunGlobalFunc(apWatch.GetName(), "cScrPropPocketWatch", "_Global_VRWind");
+	}
+	
+	// BunkerVR: the winding by hand ends unfinished (see VRUpdateWatch): the
+	// watch as the game has it again (apWatch null: put away; it is wound from
+	// the start next time).
+	void VRWatchWindEnd(iLuxEntity@ apWatch, const tString &in asNote)
+	{
+		mbVRWatchWinding = false;
+		mbVRWatchPinched = false;
+		VRWatchTellWound(apWatch, -1.0f);
+		VRWatchNote(asNote);
+	}
+	
+	// BunkerVR: a "BunkerVR watch:" line in hpl.log (the first 60).
+	void VRWatchNote(const tString &in asText)
+	{
+		if(mlVRWatchNotes >= 60) return;
+		mlVRWatchNotes++;
+		Log("BunkerVR watch: " + asText + "\n");
+	}
+	
+	// BunkerVR: the fuel can's lid or the bottle's cork, taken off by hand
+	// before the fuel can be poured or thrown. A can or bottle in the right
+	// hand comes closed. The left hand, holding
+	// nothing, squeezed at it (its palm or its first fingertip within
+	// gfVRLidReach of the opening, the squeeze begun there) opens it: the
+	// can's lid by the can's own pose with it open (gsVRLidOpenAnim, as the
+	// game's pouring opens it; kept while the can is out), the bottle's cork
+	// taken out (hidden), with a tick in both hands. Until then nothing pours
+	// (VRUpdatePour), and the game's use button does nothing with it
+	// (PlayerState_UsingFuel.hps and PlayerState_UsingFuelBottle.hps OnUse,
+	// by "BunkerVR_FuelOpen"). Put away and taken out again, it is closed.
+	// A bottle thrown by hand is thrown either way (it breaks).
+	void VRUpdateLid(cLuxProp@ apVessel, bool abCan, const cVector3f &in avOpening)
+	{
+		float fCurl = BunkerVR_HandCurl(0);
+		bool bSqueeze = fCurl > (mbVRLidSqueezeWas ? gfVRLidLetGo : gfVRLidSqueeze);
+		bool bFresh = bSqueeze && mbVRLidSqueezeWas == false;
+		mbVRLidSqueezeWas = bSqueeze;
+
+		if(mbVRLidOff)
+		{
+			// The can's lid kept open (the game's own animations, as its
+			// throwing of fuel, may have closed it in between).
+			if(abCan && cLux_GetPlayer().GetCurrentStateId() == ePlayerState_Normal)
+			{
+				cMeshEntity@ pMesh = apVessel.GetMeshEntity();
+				cAnimationState@ pOpen = pMesh !is null ? pMesh.GetAnimationStateFromName(gsVRLidOpenAnim) : null;
+				if(pOpen !is null && pOpen.IsActive() == false) apVessel.PlayAnimation(gsVRLidOpenAnim, 0.1f, true);
+			}
+			return;
+		}
+		if(bFresh == false || Item_GetHeldType(eItemHandlerHand_Left) != "") return;
+
+		// The squeeze begun at its opening?
+		cMatrixf mtxPalm;
+		float fArmScale;
+		if(BunkerVR_ReadFollowedPalm(0, mtxPalm, fArmScale) == false) return;
+		float fNear = (mtxPalm.GetTranslation() - avOpening).Length();
+		if(cMath_Abs(float(cEngine_GetGameTime()) - cScript_GetGlobalVarFloat("BunkerVR_IndexTipTime0")) < 0.25f)
+			fNear = cMath_Min(fNear, (cScript_GetGlobalVarVector3f("BunkerVR_IndexTip0") - avOpening).Length());
+		if(fNear > gfVRLidReach) return;
+
+		mbVRLidOff = true;
+		cVR_HintUsed("lid_open");
+		if(abCan) apVessel.PlayAnimation(gsVRLidOpenAnim, 0.1f, true);
+		else
+		{
+			cMeshEntity@ pMesh = apVessel.GetMeshEntity();
+			cSubMeshEntity@ pCork = pMesh !is null ? pMesh.GetSubMeshEntityName("cork") : null;
+			if(pCork !is null) pCork.SetVisible(false);
+		}
+		VRBuzzHand(0, 0.03f, 0.5f);
+		VRBuzzHand(1, 0.02f, 0.3f);
+		Log("BunkerVR: the left hand opens the " + (abCan ? "fuel can's lid" : "fuel bottle's cork") + " (" + int(fNear * 100.0f + 0.5f) + " cm from its opening)\n");
+	}
+
+	// BunkerVR: the molotov in the right hand, or null.
+	cLuxProp@ VRHeldMolotov()
+	{
+		if(Item_GetHeldType(eItemHandlerHand_Right) != "MolotovCocktail") return null;
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		return pMap !is null ? cLux_ToProp(pMap.GetEntityByName(Item_GetHeldEntity(eItemHandlerHand_Right))) : null;
+	}
+
+	// BunkerVR: where a molotov's cloth is: from its lowest bone to its
+	// highest (j_cloth_1 to j_cloth_5, 26 to 39 cm up the bottle), as the
+	// hand holds it now. False if they are not found.
+	bool VRMolotovCloth(cLuxProp@ apMolotov, cVector3f &out avLow, cVector3f &out avHigh)
+	{
+		avLow = cVector3f(0.0f);
+		avHigh = cVector3f(0.0f);
+		cMeshEntity@ pMesh = apMolotov !is null ? apMolotov.GetMeshEntity() : null;
+		if(pMesh is null) return false;
+		cBoneState@ pLow = pMesh.GetBoneStateFromName("j_cloth_1");
+		cBoneState@ pHigh = pMesh.GetBoneStateFromName("j_cloth_5");
+		if(pLow is null || pHigh is null) return false;
+		avLow = pLow.GetWorldPosition();
+		avHigh = pHigh.GetWorldPosition();
+		return true;
+	}
+
+	// BunkerVR: a molotov's cloth set burning or put out: its Light_Fire at 3,
+	// as the game's throw lights it
+	// (PlayerState_UsingMolotovCocktail.hps), or 0, as the game has it while it
+	// is held (ItemCallbacks.hps OnTakeOut); the cloth's fire goes with that
+	// light. The torch's start or end sound with it.
+	void VRSetMolotovFire(cLuxProp@ apMolotov, bool abBurning)
+	{
+		if(apMolotov is null) return;
+		iLight@ pLight = apMolotov.GetLightFromName("Light_Fire");
+		if(pLight !is null) pLight.SetBrightness(abBurning ? 3.0f : 0.0f);
+		apMolotov.PlaySound("BunkerVR_ClothFire", abBurning ? "player/tools/torch/start" : "player/tools/torch/end", true, true);
+	}
+	
+	// BunkerVR: things done with the hands instead of buttons. The VR mod
+	// watches the hands and asks for these (special roll value 7016, second
+	// number):
+	//   4  the bandage or medkit in the right hand has been wound around the left forearm three times: use it
+	//  10  the bandage was pulled out of its tin (hands pulled apart)
+	//  11  the bandage has gone once more around the left forearm
+	//   5  take out / put away the flashlight
+	//   6  the flashlight's cord was pulled: charge it once
+	//   7  the grenade in the right hand was thrown
+	//   8  the pin of the grenade in the right hand was pulled
+	//   9  the right stick was pushed up while crouched: stand up
+	//  12  X was pressed twice quickly: put away what is in the right hand
+	//  13  the right trigger is held with the lighter in the right hand: open and light it (VRLighterTrigger)
+	//  14  ...and let go: shut it
+	//  15  the right grip let go of an item to throw with the hand still: put it down where it is
+	//  16  the left trigger is held with the game's lighter in the left hand (a molotov held ready, the torch's first lighting): open and light it
+	//  17  ...and let go: shut it
+	//  18  the torch in the right hand is held out: brandish it (while it burns: VRUpdateBrandish)
+	//  19  ...and brought back in (or gone from the hand): no longer
+	//  60  the torch was waved (swung around in front of the head): the rats run off
+	//  (7 also throws a bottle, and anything whose profile has the throw move:
+	//  see helper_bunkervr_items.hps)
+	void VRDoItemCommand(int alCommand)
+	{
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		if(pPlayer is null) return;
+		int lState = pPlayer.GetCurrentStateId();
+		
+		if(alCommand == 4)
+		{
+			// The health item's own script does it (see _Global_VRUseNow there).
+			cScript_RunGlobalFunc("State_UsingHealthItem", "", "_Global_VRUseNow");
+			mlVRBandageTurn = 0;
+		}
+		else if(alCommand == 12)
+		{
+			// X pressed twice quickly: put away what is in the right hand, the
+			// game's own way (Item_PutAway, as the inventory's "put away" does),
+			// once the game is out of that item's own state (see
+			// VRDoPutAwayWait, straight after this in the same update).
+			if(Item_GetHeld(eItemHandlerHand_Right) != "") mfVRPutAwayWait = 2.0f;
+		}
+		else if(alCommand == 10 || alCommand == 11)
+		{
+			// Sounds only: the cloth coming out of the tin, and each time it
+			// goes around the arm.
+			tString sType = Item_GetHeldType(eItemHandlerHand_Right);
+			if(sType != "Bandage" && sType != "Medkit") return;
+			tString sFolder = sType == "Medkit" ? "player/tools/medkit/ready/" : "player/tools/bandage/ready/";
+
+			if(alCommand == 10)
+			{
+				mlVRBandageTurn = 0;
+				Sound_PlayGui(sFolder + "focus_start_1", 1.0f, eSoundEntryType_GuiWorld);
+			}
+			else
+			{
+				mlVRBandageTurn++;
+				int lSound = 1 + (mlVRBandageTurn % 3);
+				Sound_PlayGui(sFolder + "focus_stop_" + lSound, 1.0f, eSoundEntryType_GuiWorld);
+			}
+		}
+		else if(alCommand == 5)
+		{
+			bool bAiming = lState == ePlayerState_Custom_UsingGun_Aim || lState == ePlayerState_Custom_UsingShotgun_Aim;
+			bool bReloading = lState == ePlayerState_Custom_UsingGun_Reload || lState == ePlayerState_Custom_UsingShotgun_Reload;
+			if(lState != ePlayerState_Normal && bAiming == false && bReloading == false) return;
+			// The gun open (its reload state): the lamp can only be put away, as
+			// the game itself does before loading (Item_Unequip, see
+			// PlayerState_UsingWeapon_Reload_Base.hps), so the lamp can still be
+			// holstered with the revolver's cylinder open.
+			if(bReloading)
+			{
+				if(Item_GetHeldType(eItemHandlerHand_Left) == "DynamoLantern") Item_Unequip(Item_GetHeld(eItemHandlerHand_Left));
+				return;
+			}
+			if(Player_GetCanUseLightSource() == false) return;
+			// With a gun out, the gun's own state takes the lamp out or puts it
+			// away, as the game's flashlight key does there (see
+			// _Global_VRToggleLantern in PlayerState_UsingWeapon_Aim_Base.hps).
+			if(bAiming)
+			{
+				cScript_RunGlobalFunc(lState == ePlayerState_Custom_UsingGun_Aim ? "State_UsingGun_Aim" : "State_UsingShotgun_Aim", "", "_Global_VRToggleLantern");
+				return;
+			}
+			Player_ToggleLightSource();
+		}
+		else if(alCommand == 6)
+		{
+			DynamoLantern_Charge(); // does nothing unless the flashlight is in the left hand
+			// (And the hint about winding it is done with: _Global_VRLanternWound in Player_Custom.hps.)
+			if(Item_GetHeldType(eItemHandlerHand_Left) == "DynamoLantern") cScript_RunGlobalFunc("LuxPlayer", "", "_Global_VRLanternWound");
+		}
+		else if(alCommand == 8)
+		{
+			tString sLow = cString_ToLowerCase(Item_GetHeldType(eItemHandlerHand_Right));
+			if(cString_GetFirstStringPos(sLow, "grenade") < 0) return;
+			
+			// The grenade's own script takes the pin off (see _Global_VRPullPin
+			// in PlayerState_UsingThrowable.hps).
+			if(cString_GetFirstStringPos(sLow, "gas") >= 0)
+				cScript_RunGlobalFunc("State_UsingGasGrenade", "", "_Global_VRPullPin");
+			else
+				cScript_RunGlobalFunc("State_UsingGrenade", "", "_Global_VRPullPin");
+		}
+		else if(alCommand == 9)
+		{
+			// The right stick was pushed up while crouched: stand up (if there
+			// is room; the game checks). A crouch started by ducking the real
+			// head is over with that too, until the head has been up and down again.
+			if(Player_GetCrouching() && Player_GetCrawling() == false)
+			{
+				Player_SetCrouching(false);
+				if(Player_GetCrouching() == false) mbVRDuckCrouched = false;
+			}
+		}
+		else if(alCommand == 7)
+		{
+			// Thrown by hand: the grenades, the bottles, and anything whose
+			// profile has the throw move (see helper_bunkervr_items.hps), its
+			// item state making the thrown thing.
+			tString sType = Item_GetHeldType(eItemHandlerHand_Right);
+			tString sThrowState = BunkerVR_ItemThrowState(sType);
+			if(sThrowState == "") return;
+			
+			// It leaves with the speed the hand had at its fastest moment of
+			// the last 20 updates (people let go a little late, when the hand is already
+			// slowing and dropping).
+			cVector3f vThrow = cVector3f(0);
+			if(mVRThrowHand.mlHandTrailCount > 3 && mVRThrowHand.mfHandTrailStep > 0.0001f)
+			{
+				int lFirst = 20 - mVRThrowHand.mlHandTrailCount;
+				float fBest = -1.0f;
+				for(int i = lFirst + 3; i < 20; ++i)
+				{
+					cVector3f vSpeed = (mVRThrowHand.mvHandTrail[i] - mVRThrowHand.mvHandTrail[i - 3]) / (mVRThrowHand.mfHandTrailStep * 3.0f);
+					float fSpeed = vSpeed.Length();
+					if(fSpeed > fBest)
+					{
+						fBest = fSpeed;
+						vThrow = vSpeed;
+					}
+				}
+			}
+			vThrow = vThrow * mfVRThrowBoost;
+			float fThrow = vThrow.Length();
+			if(fThrow > gfVRFreeHoldMaxThrowSpeed) vThrow = vThrow * (gfVRFreeHoldMaxThrowSpeed / fThrow);
+			mVRThrowHand.mlHandTrailCount = 0;
+			
+			// The item's own state makes the thrown thing (see _Global_VRThrowAs
+			// in PlayerState_UsingThrowable.hps): as what the profile names (a
+			// bottle's state only learns that as it is entered), or as its own.
+			// A molotov whose cloth is not burning goes unlit: it only breaks into
+			// spilled fuel (VRUpdateFlames).
+			bool bUnlit = false;
+			if(sType == "MolotovCocktail")
+			{
+				cLuxProp@ pMolotov = VRHeldMolotov();
+				bUnlit = pMolotov is null || pMolotov.GetID() != m_idVRMolotovLit;
+				m_idVRMolotovLit = tID_Invalid;
+			}
+			Log("BunkerVR: the right hand throws " + sType + (bUnlit ? " (unlit)" : "") + " at " + vThrow.Length() + " m/s (" + sThrowState + ")\n");
+			cScript_SetGlobalArgVector3f(0, vThrow);
+			cScript_SetGlobalArgString(1, BunkerVR_ItemThrownAs(sType));
+			cScript_SetGlobalArgBool(2, bUnlit);
+			cScript_RunGlobalFunc(sThrowState, "", "_Global_VRThrowAs");
+		}
+		else if(alCommand == 15)
+		{
+			// The right grip let go of an item to throw with the hand still:
+			// an item whose profile says so (meat, the rabbit doll: they don't
+			// break) is put down where it is in the hand, moving as the hand
+			// was, not thrown. (The mod sends this only for such items; any
+			// other stays in the hand.)
+			tString sType = Item_GetHeldType(eItemHandlerHand_Right);
+			tString sThrowState = BunkerVR_ItemThrowState(sType);
+			if(sThrowState == "" || (BunkerVR_ItemMoves(sType) & glBunkerVR_Move_LetGoPutsDown) == 0) return;
+			
+			// How the hand moves now: over its last three updates.
+			cVector3f vHand = cVector3f(0);
+			if(mVRThrowHand.mlHandTrailCount > 3 && mVRThrowHand.mfHandTrailStep > 0.0001f)
+				vHand = (mVRThrowHand.mvHandTrail[19] - mVRThrowHand.mvHandTrail[16]) / (mVRThrowHand.mfHandTrailStep * 3.0f);
+			mVRThrowHand.mlHandTrailCount = 0;
+			
+			Log("BunkerVR: the right hand puts down " + sType + " where it is, moving at " + vHand.Length() + " m/s (" + sThrowState + ")\n");
+			cScript_SetGlobalArgVector3f(0, vHand);
+			cScript_SetGlobalArgString(1, BunkerVR_ItemThrownAs(sType));
+			cScript_RunGlobalFunc(sThrowState, "", "_Global_VRPutDown");
+		}
+		else if(alCommand == 13 || alCommand == 14 || alCommand == 16 || alCommand == 17)
+		{
+			// A lighter's trigger held, or let go (VRLighterTrigger, with the
+			// lid's flick). 13 and 14: the lighter in the right hand, lit only
+			// while the trigger is held, so letting go puts it out (in VR it is
+			// never held "ready", so the game's own lighting of it is not
+			// used). 16 and 17: the game's own lighter in the left hand, which
+			// it puts there while a molotov is held ready and for the torch's
+			// first lighting. The lighter's own script makes the click, the
+			// flame, its light and its sound; its flame lights what burns
+			// (VRUpdateFlames).
+			VRLighterTrigger(alCommand >= 16 ? 0 : 1, alCommand == 13 || alCommand == 16);
+		}
+		else if(alCommand == 18 || alCommand == 19)
+		{
+			// The torch held out, or brought back in; the mod also sends 19
+			// when the torch leaves the hand. It is brandished while it is held out and burns
+			// (VRUpdateBrandish, from VRUpdateFlames, later in this update).
+			mbVRTorchHeldOut = alCommand == 18;
+		}
+		else if(alCommand == 60)
+		{
+			// The torch waved: as the game's wave (Sway in
+			// PlayerState_UsingTorch.hps), the rats near are threatened and run
+			// off. (Its wave animations are not played: the arm follows the
+			// controller, and they would move the torch in the hand.)
+			// (Only a burning torch scares the rats: not one out unlit, waiting
+			// to be lit by hand.)
+			cLuxProp@ pTorch = VRHeldTorch();
+			if(pTorch is null || VRTorchWaitingForFlame(pTorch) || pTorch.GetEffectsActive() == false) return;
+			cLuxMap@ pMap = cLux_GetCurrentMap();
+			if(pMap is null) return;
+			array<iLuxEntity@> vRats;
+			pMap.GetEntityArray("*", eLuxEntityType_Agent, "cScrAgentRat", vRats);
+			for(uint i = 0; i < vRats.length(); ++i)
+			{
+				if(vRats[i] is null) continue;
+				vRats[i].BroadcastMessage(eCustomEntityMessage_ThreatenedAttack, null, cVector3f(0), 0);
+			}
+			Log("BunkerVR: FIRE: the torch was waved: " + vRats.length() + " rat(s) told\n");
+		}
+	}
+	
+	//------------------------------------------------------------
+	
+	// BunkerVR, for testing: the things a debug jump asks to have made where it
+	// arrives (its spawn=... entries, cVR_JumpText 30 on): in a row ahead, as
+	// the Spawn page makes one, each facing the player.
+	void VRJumpMakeThings()
+	{
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		if(pPlayer is null || pMap is null) return;
+		cCamera@ pCam = pPlayer.GetCamera();
+		iCharacterBody@ pCharBody = pPlayer.GetCharacterBody();
+		if(pCam is null || pCharBody is null) return;
+		cVector3f vAhead = pCam.GetForward();
+		vAhead.y = 0.0f;
+		if(vAhead.Length() < 0.01f) return;
+		vAhead = cMath_Vector3Normalize(vAhead);
+		cVector3f vRight = cVector3f(vAhead.z * -1.0f, 0.0f, vAhead.x);
+		cVector3f vFeet = pCharBody.GetFeetPosition();
+		for(int i = 0; i < 6; ++i)
+		{
+			tString sFile = cVR_JumpText(30 + i);
+			if(sFile == "") break;
+			cVector3f vPos = vFeet + vAhead * 2.2f + vRight * (float(i) * 1.6f) + cVector3f(0.0f, 0.05f, 0.0f);
+			mlVRTestMade++;
+			Log("BunkerVR: jump: making " + sFile + "\n");
+			pMap.CreateEntity("VRTestOne_" + mlVRTestMade, sFile, VRFacingPlayer(vPos, vAhead), cVector3f(1.0f, 1.0f, 1.0f));
+		}
+	}
+
+	//------------------------------------------------------------
+	
+	// BunkerVR, for testing: where things stand, into the mod's log, for an
+	// automated test run to read.
+	void VRStandInReport()
+	{
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		if(pPlayer is null) return;
+		cCamera@ pCam = pPlayer.GetCamera();
+		iCharacterBody@ pCharBody = pPlayer.GetCharacterBody();
+		if(pCam is null || pCharBody is null) return;
+		cVector3f vFeet = pCharBody.GetFeetPosition();
+		cVector3f vEyes = pCam.GetPosition();
+		cVector3f vAhead = pCam.GetForward();
+		float fRealRoll = pCam.GetRoll();
+		pCam.SetRoll(7011.0f);
+		cVector3f vLeft = pCam.GetMatrix().GetTranslation();
+		pCam.SetRoll(7012.0f);
+		cVector3f vRight = pCam.GetMatrix().GetTranslation();
+		pCam.SetRoll(fRealRoll);
+		cVR_Say("report: state " + pPlayer.GetCurrentStateId() +
+			", feet " + vFeet.x + " " + vFeet.y + " " + vFeet.z +
+			", eyes " + vEyes.x + " " + vEyes.y + " " + vEyes.z +
+			", looking " + vAhead.x + " " + vAhead.y + " " + vAhead.z +
+			", left palm " + vLeft.x + " " + vLeft.y + " " + vLeft.z +
+			", right palm " + vRight.x + " " + vRight.y + " " + vRight.z +
+			" camera anim " + (mbCameraAnimation_Active ? msCameraAnimation_Name : "none") + ", body state " + int(mCurrentAnimationState));
+		// (The real head too, where the view is drawn from, which "eyes" above is not: that is the
+		// game's camera before the head's own place in the room is added. And the follow's numbers.)
+		pCam.SetRoll(7005.0f);
+		cVector3f vHead = pCam.GetMatrix().GetTranslation();
+		pCam.SetRoll(fRealRoll);
+		cVR_Say("report head: " + vHead.x + " " + vHead.y + " " + vHead.z + "; the view darkened " + int(mfVRHeadFade * 100.0f + 0.5f) +
+			"%; the neck " + int(mfVRFollowFar * 100.0f + 0.5f) + " cm from the body");
+		// (Real-body stealth: how low the player really is, and the Beast's sight range against them now.)
+		cVR_Say("report stealth: low " + BunkerVR_Fixed(mfVRStealthLow, 2) + "; crouched " + (Player_GetCrouching() ? "yes" : "no") +
+			"; the sight range x " + BunkerVR_Fixed(pPlayer.GetVisibilityRangeMul(), 2) + "; standing eyes " + BunkerVR_Fixed(mfVRStealthStandEye, 2) + " m");
+		// (The creatures' sight at the real head's height.)
+		cVR_Say("report sight: " + (mbVRSightOn ? "the real head counts" : "the game's own") + "; the real head " +
+			BunkerVR_Fixed(mfVRSightUp, 3) + " m from the game's eye");
+		// (Healing, done only by wrapping the arm: the health, and what the right hand holds.)
+		tString sRightHeld = Item_GetHeldType(eItemHandlerHand_Right);
+		cVR_Say("report health: " + BunkerVR_Fixed(Player_GetHealth(), 3) + "; the right hand holds " + (sRightHeld == "" ? "nothing" : sRightHeld));
+	}
+
+	//------------------------------------------------------------
+
+	// BunkerVR, for testing: the player put where the survey list says (cVR_SurveyNumber 0 to 2),
+	// the feet at x, y, z, for an automated test run: to go and see a thing, or how far a floor
+	// lies under it (the player falls from there as anyone would).
+	void VRStandInMoveTo()
+	{
+		cLux_GetPlayer().GetCharacterBody();
+		iCharacterBody@ pCharBody = cLux_GetPlayer().GetCharacterBody();
+		if(pCharBody is null) return;
+		cVR_SurveyName(0);
+		pCharBody.SetFeetPosition(cVector3f(cVR_SurveyNumber(0), cVR_SurveyNumber(1), cVR_SurveyNumber(2)), false);
+	}
+
+	//------------------------------------------------------------
+
+	// BunkerVR, for testing: every thing a hand can take as it stands in the level now, for an
+	// automated test run: the level's scripts place some things by chance on each visit, so a
+	// list from another run names things that are not there.
+	void VRStandInThings()
+	{
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		if(pMap is null) return;
+		cVR_Say("things start");
+		for(int lKind = 0; lKind < 6; ++lKind)
+		{
+			array<iLuxEntity@> vItems;
+			if(lKind < 3) pMap.GetEntityArray("*", eLuxEntityType_Prop, lKind == 0 ? "cScrPropPickup" : (lKind == 1 ? "cScrPropReadable" : "cScrPropReadableDogTag"), vItems);
+			else pMap.GetEntityArray("*", eLuxEntityType_Area, lKind == 3 ? "cScrAreaInteractAux" : (lKind == 4 ? "cScrAreaZoom" : "cScrAreaTrigger"), vItems);
+			for(uint i = 0; i < vItems.length(); ++i)
+			{
+				iLuxEntity@ pItem = vItems[i];
+				if(pItem is null || pItem.IsActive() == false) continue;
+				if(lKind == 5 && pItem.HasPlayerInteractCallback() == false) continue;
+				cMeshEntity@ pMesh = lKind < 3 ? pItem.GetMeshEntity() : null;
+				iPhysicsBody@ pBody = lKind < 3 ? pItem.GetMainBody() : pItem.GetBody(0);
+				cBoundingVolume@ pBounds = pBody !is null ? pBody.GetBoundingVolume() : (pMesh !is null ? pMesh.GetBoundingVolume() : null);
+				if(pBounds is null) continue;
+				cVector3f vMiddle = pBounds.GetWorldCenter();
+				cVector3f vSize = pBounds.GetMax() - pBounds.GetMin();
+				cVR_Say("thing: " + lKind + " " + pItem.GetName() + " " + vMiddle.x + " " + vMiddle.y + " " + vMiddle.z + " " + vSize.x + " " + vSize.y + " " + vSize.z + " " + (pItem.GetInteractionDisabled() ? "disabled" : "open") + " " + (pBody !is null ? "body" : "nobody"));
+			}
+		}
+		cVR_Say("things done");
+	}
+
+	//------------------------------------------------------------
+
+	// BunkerVR, for testing: is the thing named on run\survey.txt's first line still in the level? (A
+	// thing the game has put away was taken.)
+	void VRStandInThingThere()
+	{
+		tString sName = cVR_SurveyName(0);
+		iLuxEntity@ pThing = cLux_GetCurrentMap().GetEntityByName(sName, eLuxEntityType_LastEnum, "");
+		cVR_Say("there: " + sName + " " + (pThing !is null && pThing.IsActive() ? "yes" : "no"));
+		// (And where the middle of its main body is, and its size.)
+		iPhysicsBody@ pBody = pThing !is null ? pThing.GetMainBody() : null;
+		cBoundingVolume@ pBounds = pBody !is null ? pBody.GetBoundingVolume() : null;
+		if(pBounds is null) return;
+		cVector3f vMiddle = pBounds.GetWorldCenter();
+		cVector3f vSize = pBounds.GetMax() - pBounds.GetMin();
+		cVR_Say("where: " + sName + " " + vMiddle.x + " " + vMiddle.y + " " + vMiddle.z + " " + vSize.x + " " + vSize.y + " " + vSize.z +
+				"; can be used " + (pThing.CanInteract(0, pBody) ? 1 : 0) + ", use switched off " + (pThing.GetInteractionDisabled() ? 1 : 0) +
+				", collides " + (pBody.GetCollide() ? 1 : 0) + ", mass " + pBody.GetMass());
+	}
+
+	//------------------------------------------------------------
+
+	// BunkerVR, for testing: what the right hand touches now.
+	void VRStandInTouch()
+	{
+		iLuxEntity@ pTouched = cLux_ID_Entity(cScript_GetGlobalVarID("BunkerVR_TouchEntity1"));
+		float fAge = float(cEngine_GetGameTime()) - cScript_GetGlobalVarFloat("BunkerVR_TouchTime1");
+		cVector3f vBack = cScript_GetGlobalVarVector3f("BunkerVR_HandBack1");
+		// (And what the right hand holds by itself, then what the game's grab holds, by name: things
+		// carried by hand drop again when the grip lets go, so a test asks with the grip squeezed.)
+		tString sHolds = "";
+		iPhysicsBody@ pHoldBody = mVRHoldRight.m_idBody != tID_Invalid ? cLux_ID_Body(mVRHoldRight.m_idBody) : null;
+		iLuxEntity@ pHoldThing = pHoldBody !is null ? cLux_GetBodyEntity(pHoldBody) : null;
+		if(pHoldThing !is null) sHolds = pHoldThing.GetName();
+		tID idGrab = VRGrabBodyNow();
+		iPhysicsBody@ pGrabBody = idGrab != tID_Invalid ? cLux_ID_Body(idGrab) : null;
+		iLuxEntity@ pGrabThing = pGrabBody !is null ? cLux_GetBodyEntity(pGrabBody) : null;
+		if(pGrabThing !is null) sHolds += (sHolds != "" ? "," : "") + pGrabThing.GetName();
+		cVR_Say("touch: right " + (pTouched !is null ? pTouched.GetName() : "nothing") + " said " + int(fAge * 1000.0f) + " ms ago; held back " + int(vBack.Length() * 100.0f) + " cm; way " + int(vBack.x * 100.0f) + " " + int(vBack.y * 100.0f) + " " + int(vBack.z * 100.0f) + "; held " + Item_GetHeld(eItemHandlerHand_Right) + "; holds " + sHolds);
+	}
+
+	//------------------------------------------------------------
+
+	// BunkerVR, for testing: an item from run\survey.txt (its first line) put in the hand; with a
+	// second line, the item in the hand used on that thing, as the game's use button does it
+	// (for playing through the scenes where an item is used on something).
+	void VRStandInUseItem()
+	{
+		tString sType = cVR_SurveyName(0);
+		tString sTarget = cVR_SurveyName(1);
+		if(sTarget == "")
+		{
+			if(ItemType_GetCountInInventory(sType) == 0) Item_AddToInventory(sType);
+			Item_Equip(ItemType_GetFirstInInventory(sType));
+			cVR_Say("use: " + sType + " put in the hand: held " + Item_GetHeld(eItemHandlerHand_Right));
+			return;
+		}
+		bool bCan = Item_GetCanUseOnWorld(eItemHandlerHand_Right, sTarget);
+		cVR_Say("use: held " + Item_GetHeld(eItemHandlerHand_Right) + " on " + sTarget + ": " + (bCan ? "can" : "CANNOT"));
+		if(bCan) Item_UseHeldOnWorld(eItemHandlerHand_Right, sTarget);
+	}
+
+	//------------------------------------------------------------
+
+	// BunkerVR, for testing: a function of the level's script run, by the name on run\survey.txt's
+	// first line, void and given the second line as its one word, or one called as two things meet
+	// (OnCollide_, OnTrigger_) (for the scenes a hand or the game's rays would start).
+	void VRStandInMapFunction()
+	{
+		tString sName = cVR_SurveyName(0);
+		tString sWord = cVR_SurveyName(1);
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		tString sMethod = "void " + sName + "(const tString &in asEntity)";
+		bool bThere = pMap !is null && pMap.ScriptMethodExists(sMethod) && pMap.ScriptPrepare(sMethod);
+		if(bThere == false && pMap !is null && pMap.ScriptMethodExists("void " + sName + "()") && pMap.ScriptPrepare("void " + sName + "()"))
+		{
+			cVR_Say("map function " + sName + "(): run");
+			pMap.ScriptExecute();
+			return;
+		}
+		bool bMeet = false;
+		if(bThere == false && pMap !is null)
+		{
+			sMethod = "bool " + sName + "(const tString &in asParent, const tString &in asChild, int alState)";
+			bMeet = pMap.ScriptMethodExists(sMethod) && pMap.ScriptPrepare(sMethod);
+		}
+		cVR_Say("map function " + sName + "(" + sWord + "): " + (bThere || bMeet ? "run" : "NOT THERE"));
+		if(bThere == false && bMeet == false) return;
+		pMap.SetArgString(0, sWord);
+		if(bMeet)
+		{
+			pMap.SetArgString(1, sWord);
+			pMap.SetArgInt(2, 1);
+		}
+		pMap.ScriptExecute();
+	}
+
+	//------------------------------------------------------------
+
+	// BunkerVR, for testing: how high the things named in the list stand above the
+	// floor near them, into the log: straight down
+	// from a ring around each, 70 cm out, and the next to lowest of what is hit (so past
+	// a table or a shelf it stands on, and not down one hole). Some a frame.
+	void VRStandInSurvey()
+	{
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		if(pMap is null) return;
+		cVector3f vDown = cVector3f(0.0f, -1.0f, 0.0f);
+		for(int lThing = 0; lThing < 20; ++lThing)
+		{
+			tString sName = cVR_SurveyName(mlVRSurveyNext);
+			if(sName == "")
+			{
+				cVR_Say("survey: done, " + mlVRSurveyNext + " names");
+				mlVRSurveyNext = -1;
+				return;
+			}
+			mlVRSurveyNext++;
+			iLuxEntity@ pEnt = pMap.GetEntityByName(sName, eLuxEntityType_LastEnum, "");
+			if(pEnt is null)
+			{
+				cVR_Say("survey: " + sName + " not here");
+				continue;
+			}
+			cVector3f vAt = pEnt.GetMatrix().GetTranslation();
+			float fLowest = 100000.0f, fNext = 100000.0f;
+			for(int lRay = 0; lRay < 8; ++lRay)
+			{
+				float fAngle = float(lRay) * cMath_Pi / 4.0f;
+				cVector3f vFrom = vAt + cVector3f(cMath_Cos(fAngle) * 0.7f, 0.1f, cMath_Sin(fAngle) * 0.7f);
+				float fHit = 0.0f;
+				cVector3f vNormal = cVector3f(0.0f);
+				if(cLux_GetClosestBody(vFrom, vDown, 6.0f, fHit, vNormal) is null) continue;
+				float fY = vFrom.y - fHit;
+				if(fY < fLowest)
+				{
+					fNext = fLowest;
+					fLowest = fY;
+				}
+				else if(fY < fNext) fNext = fY;
+			}
+			float fFloor = fNext < 99999.0f ? fNext : fLowest;
+			cVR_Say("survey: " + sName + " at " + vAt.y + " floor " + (fFloor < 99999.0f ? ("" + fFloor) : "none") + (pEnt.GetInteractionDisabled() ? " nointeract" : "") + (pEnt.IsActive() ? "" : " inactive"));
+		}
+	}
+
+	//------------------------------------------------------------
+
+	// BunkerVR, for testing: the view this frame, into the log, so that a snap of the view
+	// can be followed frame by frame.
+	void VRStandInTrace(cCamera@ apCam)
+	{
+		mlVRTraceLeft--;
+		cVector3f vEyes = apCam.GetPosition();
+		cVector3f vAhead = apCam.GetForward();
+		cVector3f vHead = cVector3f(0.0f);
+		iLuxEntity@ pEnt = cLux_ID_Entity(m_idBody);
+		cMeshEntity@ pMesh = pEnt !is null ? pEnt.GetMeshEntity() : null;
+		cBoneState@ pHead = pMesh !is null ? pMesh.GetBoneStateFromName("j_Head") : null;
+		if(pHead !is null) vHead = pHead.GetWorldPosition();
+		cVector3f vFeet = cLux_GetPlayer().GetCharacterBody().GetFeetPosition();
+		cVR_Say("trace " + float(cEngine_GetGameTime()) + " kind " + mlVRRoughKind +
+			" eyes " + vEyes.x + " " + vEyes.y + " " + vEyes.z +
+			" ahead " + vAhead.x + " " + vAhead.y + " " + vAhead.z +
+			" head " + vHead.x + " " + vHead.y + " " + vHead.z +
+			" turn " + mfVRBodyTurnApplied +
+			" feet " + vFeet.x + " " + vFeet.y + " " + vFeet.z);
+	}
+
+	//------------------------------------------------------------
+
+	// BunkerVR: for testing. Logs the turn, the view and the drawn body as they are drawn this frame
+	// (after the camera and the arms are placed), as a "trace2" line: the game's camera yaw and the
+	// character's, the drawn body's feet yaw (mfYaw) and its turn after the head, where the game's
+	// camera is (the view minus the head), its point on the drawn head (the CameraSocket), the eyes'
+	// steadying (VRSteadyEyes), both collar bones and hips (which way the chest and the hips face),
+	// the right palm and what it holds.
+	void VRStandInTrace2(cCamera@ apCam, cNode3D@ apSocket, cMeshEntity@ apMesh)
+	{
+		if(apCam is null || apSocket is null || apMesh is null) return;
+		cBoneState@ pLClav = apMesh.GetBoneStateFromName("j_L_Clavicle");
+		cBoneState@ pRClav = apMesh.GetBoneStateFromName("j_R_Clavicle");
+		cBoneState@ pLLeg = apMesh.GetBoneStateFromName("j_L_Leg_1");
+		cBoneState@ pRLeg = apMesh.GetBoneStateFromName("j_R_Leg_1");
+		cBoneState@ pPalm = apMesh.GetBoneStateFromName("j_R_HandSocket");
+		if(pLClav is null || pRClav is null || pLLeg is null || pRLeg is null || pPalm is null) return;
+		cVector3f vCam = apCam.GetPosition();
+		cVector3f vSocket = apSocket.GetWorldPosition();
+		cVector3f vLC = pLClav.GetWorldPosition();
+		cVector3f vRC = pRClav.GetWorldPosition();
+		cVector3f vLL = pLLeg.GetWorldPosition();
+		cVector3f vRL = pRLeg.GetWorldPosition();
+		cVector3f vPalm = pPalm.GetWorldPosition();
+		// The center of what the right hand holds (by the mod's hold or the game's grab), or the palm if nothing.
+		cVector3f vHeld = vPalm;
+		tID idHeld = mVRHoldRight.m_idBody != tID_Invalid ? mVRHoldRight.m_idBody : VRGrabBodyNow();
+		iPhysicsBody@ pHeld = idHeld != tID_Invalid ? cLux_ID_Body(idHeld) : null;
+		cBoundingVolume@ pHeldBox = pHeld !is null ? pHeld.GetBoundingVolume() : null;
+		if(pHeldBox !is null) vHeld = pHeldBox.GetWorldCenter();
+		cVR_Say("trace2 " + float(cEngine_GetGameTime()) + " cam " + apCam.GetYaw() + " char " + cLux_GetPlayer().GetCharacterBody().GetYaw() +
+			" feet " + mfYaw + " vr " + mfVRBodyTurnApplied +
+			" campos " + vCam.x + " " + vCam.y + " " + vCam.z +
+			" fwd " + apCam.GetForward().x + " " + apCam.GetForward().y + " " + apCam.GetForward().z +
+			" socket " + vSocket.x + " " + vSocket.y + " " + vSocket.z +
+			" steady " + mvVRSteadyLast.x + " " + mvVRSteadyLast.y + " " + mvVRSteadyLast.z +
+			" lclav " + vLC.x + " " + vLC.y + " " + vLC.z + " rclav " + vRC.x + " " + vRC.y + " " + vRC.z +
+			" lleg " + vLL.x + " " + vLL.y + " " + vLL.z + " rleg " + vRL.x + " " + vRL.y + " " + vRL.z +
+			" palm " + vPalm.x + " " + vPalm.y + " " + vPalm.z +
+			" held " + vHeld.x + " " + vHeld.y + " " + vHeld.z +
+			" feet " + VRTraceFoot(apMesh, "j_L_") + " " + VRTraceFoot(apMesh, "j_R_"));
+	}
+
+	// For VRStandInTrace2: a drawn foot's ankle and toes positions, as six numbers.
+	tString VRTraceFoot(cMeshEntity@ apMesh, const tString &in asSide)
+	{
+		cBoneState@ pFoot = apMesh.GetBoneStateFromName(asSide + "Foot");
+		cBoneState@ pToes = apMesh.GetBoneStateFromName(asSide + "Toes");
+		if(pFoot is null || pToes is null) return "0 0 0 0 0 0";
+		cVector3f vA = pFoot.GetWorldPosition();
+		cVector3f vT = pToes.GetWorldPosition();
+		return "" + vA.x + " " + vA.y + " " + vA.z + " " + vT.x + " " + vT.y + " " + vT.z;
+	}
+
+	//------------------------------------------------------------
+
+	// BunkerVR: for testing. The buttons on the "Tools" page of the mod's menu. They work in any level.
+	//   20 hurt me            21 heal me fully        22 every item
+	//   23 bandage + medkit   24 grenades             25 bullets and shells
+	//   26 the Beast in front of me   27 remove it    28 empty the flashlight
+	//   44 to 50: the Beast page's knockdowns, kills and death (VRBeastTestStart)
+	void VRDoTestCommand(int alCommand)
+	{
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		if(pPlayer is null || pMap is null) return;
+		
+		if(alCommand == 20)
+		{
+			// Never below a little health, so that it cannot kill.
+			pPlayer.GiveDamage(0.3f, 0, eDamageType_Default, 0.05f, tID_Invalid, -1);
+		}
+		else if(alCommand == 21)
+		{
+			Player_ApplyHeal(true);
+		}
+		else if(alCommand == 22)
+		{
+			Item_SetCurrentSlotsCount(Item_GetMaxSlotsCount());
+			array<tString> vTypes = { "Gun", "Shotgun", "DynamoLantern", "Lighter", "Bandage", "Medkit", "Grenade", "GasGrenade",
+									  "MolotovCocktail", "Flare", "Fuel", "Torch", "Cutters", "Wrench", "Meat", "RabbitDoll",
+									  "PocketWatch", "GasMask" };
+			for(uint i = 0; i < vTypes.length(); ++i)
+			{
+				// The gun, the flashlight and the like are only given once.
+				if(i < 4 && ItemType_GetFirstInInventory(vTypes[i]) != "") continue;
+				Item_AddToInventory(vTypes[i]);
+			}
+			Item_AddManyToInventory("Ammunition", 6);
+			Item_AddManyToInventory("ShotgunAmmunition", 4);
+		}
+		else if(alCommand == 23)
+		{
+			Item_AddToInventory("Bandage");
+			Item_AddToInventory("Medkit");
+		}
+		else if(alCommand == 24)
+		{
+			Item_AddToInventory("Grenade");
+			Item_AddToInventory("Grenade");
+			Item_AddToInventory("GasGrenade");
+		}
+		else if(alCommand == 25)
+		{
+			Item_AddManyToInventory("Ammunition", 6);
+			Item_AddManyToInventory("ShotgunAmmunition", 4);
+		}
+		else if(alCommand == 26 || alCommand == 27)
+		{
+			iLuxEntity@ pOld = pMap.GetEntityByName("VRTestBeast");
+			if(pOld !is null) pMap.DestroyEntity(pOld);
+			// Also remove the still Beast standing in for it (VRBeastStandIn).
+			iLuxEntity@ pOldBody = pMap.GetEntityByName(gsVRBeastBodyName);
+			if(pOldBody !is null) pMap.DestroyEntity(pOldBody);
+			mfVRBeastBodyCheck = -1.0f;
+			mfVRBeastBodyAnimLeft = -1.0f;
+			if(alCommand == 27) return;
+			
+			// Five meters ahead, the way the head is turned, a little above
+			// the level of the feet.
+			cCamera@ pCam = pPlayer.GetCamera();
+			iCharacterBody@ pCharBody = pPlayer.GetCharacterBody();
+			if(pCam is null || pCharBody is null) return;
+			cVector3f vAhead = pCam.GetForward();
+			vAhead.y = 0.0f;
+			if(vAhead.Length() < 0.01f) return;
+			vAhead = cMath_Vector3Normalize(vAhead);
+			
+			cVector3f vPlace = pCharBody.GetFeetPosition() + vAhead * 5.0f + cVector3f(0.0f, 0.3f, 0.0f);
+			pMap.CreateEntity("VRTestBeast", "stalker.ent", cMath_MatrixTranslate(vPlace), cVector3f(1.0f, 1.0f, 1.0f));
+
+			// Once it has started (a quarter of a second), a map without path
+			// nodes has it switched off: then a still Beast stands in for it,
+			// on the floor there, facing the player (VRBeastStandIn).
+			mvVRBeastBodyPos = pCharBody.GetFeetPosition() + vAhead * 5.0f;
+			mfVRBeastBodyYaw = cMath_GetAngleFromPoints3D(cVector3f(0.0f), vAhead).y + cMath_Pi;
+			mfVRBeastBodyCheck = 0.25f;
+		}
+		else if(alCommand >= 30 && alCommand <= 42)
+		{
+			// The Spawn page of the mod's menu: one thing at a time, two meters
+			// ahead (30 to 41, in the order below), or the small things in a
+			// row on the floor (42). Each press makes another one.
+			cCamera@ pCam = pPlayer.GetCamera();
+			iCharacterBody@ pCharBody = pPlayer.GetCharacterBody();
+			if(pCam is null || pCharBody is null) return;
+			cVector3f vAhead = pCam.GetForward();
+			vAhead.y = 0.0f;
+			if(vAhead.Length() < 0.01f) return;
+			vAhead = cMath_Vector3Normalize(vAhead);
+			cVector3f vRight = cVector3f(vAhead.z * -1.0f, 0.0f, vAhead.x);
+			cVector3f vFeet = pCharBody.GetFeetPosition();
+
+			if(alCommand <= 41)
+			{
+				array<tString> vOne = { "wooden_door.ent", "metal_door_window.ent", "locker_metal.ent", "locker_metal_half.ent",
+										"lockbox.ent", "generator.ent", "fusebox.ent", "power_switch_lever_short.ent",
+										"lockdown_wheel.ent", "water_pump.ent", "door_chain_winecellar.ent", "fuel_medium_pickup.ent" };
+				tString sFile = vOne[alCommand - 30];
+
+				// One at a time: the last one made here is removed first. Doors
+				// made on the same spot end up inside each other and jam: a metal
+				// door inside a wooden one won't open and its far side can't be
+				// grabbed.
+				if(msVRTestLastOne != "")
+				{
+					iLuxEntity@ pOld = pMap.GetEntityByName(msVRTestLastOne);
+					if(pOld !is null) pMap.DestroyEntity(pOld);
+					msVRTestLastOne = "";
+				}
+
+				// The fuel can is a small thing: nearer, and dropped from a little height.
+				cVector3f vPos = vFeet + vAhead * 2.2f + cVector3f(0.0f, 0.05f, 0.0f);
+				if(alCommand == 41) vPos = vFeet + vAhead * 1.2f + cVector3f(0.0f, 0.6f, 0.0f);
+
+				mlVRTestMade++;
+				msVRTestLastOne = "VRTestOne_" + mlVRTestMade;
+				Log("BunkerVR: Spawn page: making " + sFile + "\n");
+				pMap.CreateEntity(msVRTestLastOne, sFile, VRFacingPlayer(vPos, vAhead), cVector3f(1.0f, 1.0f, 1.0f));
+			}
+			else
+			{
+				array<tString> vSmall = { "dogtag_auclair_3397_withstring.ent", "dogtag_bardin_1889_withstring.ent", "dogtag_fortin_7750_withstring.ent",
+										  "lockdown_wheel_pickup.ent", "chain_cutters_pickup.ent", "fuse_pickup.ent" };
+				for(uint i = 0; i < vSmall.length(); ++i)
+				{
+					mlVRTestMade++;
+					cVector3f vPos = vFeet + vAhead * 1.3f + vRight * ((float(i) - 2.5f) * 0.35f) + cVector3f(0.0f, 0.5f, 0.0f);
+					pMap.CreateEntity("VRTestOne_" + mlVRTestMade, vSmall[i], cMath_MatrixTranslate(vPos), cVector3f(1.0f, 1.0f, 1.0f));
+				}
+			}
+		}
+		else if(alCommand == 29)
+		{
+			// A row of the game's working furniture three meters ahead, to try
+			// the hands on, with a few small things in front of it. They are
+			// made as they come, without the set-up a level gives them (lock
+			// codes, what a switch powers, which door a chain holds), so some
+			// will only half work. Pressing the button again clears the last lot.
+			cCamera@ pCam = pPlayer.GetCamera();
+			iCharacterBody@ pCharBody = pPlayer.GetCharacterBody();
+			if(pCam is null || pCharBody is null) return;
+			cVector3f vAhead = pCam.GetForward();
+			vAhead.y = 0.0f;
+			if(vAhead.Length() < 0.01f) return;
+			vAhead = cMath_Vector3Normalize(vAhead);
+			cVector3f vRight = cVector3f(vAhead.z * -1.0f, 0.0f, vAhead.x);
+			cVector3f vFeet = pCharBody.GetFeetPosition();
+
+			array<tString> vProps = { "wooden_door.ent", "metal_door_window.ent", "locker_metal.ent", "locker_metal_half.ent",
+									  "lockbox.ent", "generator.ent", "fusebox.ent",
+									  "power_switch_lever_short.ent", "lockdown_wheel.ent", "water_pump.ent", "door_chain_winecellar.ent" };
+			array<tString> vSmall = { "dogtag_auclair_3397_withstring.ent", "dogtag_bardin_1889_withstring.ent", "dogtag_fortin_7750_withstring.ent",
+									  "lockdown_wheel_pickup.ent", "chain_cutters_pickup.ent",
+									  "fuel_medium_pickup.ent", "fuse_pickup.ent" };
+
+			Log("BunkerVR: the Tools page's furniture button was pressed; making " + (vProps.length() + vSmall.length()) + " things\n");
+			for(uint i = 0; i < vProps.length() + vSmall.length(); ++i)
+			{
+				iLuxEntity@ pOld = pMap.GetEntityByName("VRTestProp_" + i);
+				if(pOld !is null) pMap.DestroyEntity(pOld);
+			}
+
+			for(uint i = 0; i < vProps.length(); ++i)
+			{
+				// Two rows of six, 1.8 meters apart, each facing the player. A
+				// door in its frame is up to 1.72 m wide, so any closer, side by
+				// side, they can reach into each other.
+				float fAside = (float(i % 6) - 2.5f) * 1.8f;
+				float fAhead = 3.0f + float(i / 6) * 2.5f;
+				cVector3f vPos = vFeet + vAhead * fAhead + vRight * fAside + cVector3f(0.0f, 0.05f, 0.0f);
+				pMap.CreateEntity("VRTestProp_" + i, vProps[i], VRFacingPlayer(vPos, vAhead), cVector3f(1.0f, 1.0f, 1.0f));
+			}
+			for(uint i = 0; i < vSmall.length(); ++i)
+			{
+				float fAside = (float(i) - 3.5f) * 0.4f;
+				cVector3f vPos = vFeet + vAhead * 1.6f + vRight * fAside + cVector3f(0.0f, 0.5f, 0.0f);
+				pMap.CreateEntity("VRTestProp_" + (vProps.length() + i), vSmall[i], cMath_MatrixTranslate(vPos), cVector3f(1.0f, 1.0f, 1.0f));
+			}
+		}
+		else if(alCommand == 28)
+		{
+			if(Item_GetHeldType(eItemHandlerHand_Left) != "DynamoLantern") return;
+			cScript_SetGlobalArgFloat(0, 0.0f);
+			cScript_RunGlobalFunc(Item_GetHeldEntity(eItemHandlerHand_Left), "cScrPropDynamoLantern", "_Global_VRSetCharge");
+		}
+		else if(alCommand == 43)
+		{
+			// Reload: the game's own reload (the button on its debug options
+			// page, MenuHandler.hps), which builds the scripts again from their
+			// files and loads the map again, so that a change to the scripts
+			// can be tried without restarting the game. Changes to the VR mod
+			// itself (version.dll) need a restart.
+			Log("BunkerVR: reloading the game (testing button)\n");
+			cLux_ReloadGame();
+		}
+		else if(alCommand >= 44 && alCommand <= 53) // 51 to 53: the hole, hiding and ladder kills
+		{
+			// The Beast page: a knockdown, a kill or a death, to see how each
+			// looks in VR; one at a time. It starts at the next update: the
+			// menu closes itself as the button is pressed.
+			if(mlVRBeastTest != 0 || mbVRBeastKillPlaying)
+			{
+				Log("BunkerVR: Beast page: test " + alCommand + " not started: test " + mlVRBeastTest + " or a test kill is under way\n");
+				return;
+			}
+			mlVRBeastTest = alCommand;
+			mlVRBeastTries = 0;
+			mfVRBeastTestWait = 0.0f;
+			Log("BunkerVR: Beast page: test " + alCommand + "\n");
+		}
+	}
+
+	// BunkerVR: is a knockdown (1), or a kill or a death (2), playing on the
+	// player's body now? Only while an animation moves the camera, and not
+	// the game's interactive cutscenes. A death counts whatever its
+	// animation. The game plays a big fall, a shotgun hit and the Beast's
+	// kills as cutscene animations (PlayCutsceneAnimation puts the player in
+	// its cutscene state), so in that state these animations count too;
+	// otherwise they would always be shown on the cutscene screen, whatever
+	// the menu's choice. The game's other cutscenes stay on the cutscene
+	// screen.
+	int VRRoughMoveKind()
+	{
+		if(mbCameraAnimation_Active == false) return 0;
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		if(pPlayer is null) return 0;
+		int lState = pPlayer.GetCurrentStateId();
+		if(lState == ePlayerState_InteractiveCutsceneAnimation) return 0;
+		if(lState == ePlayerState_Dead) return 2;
+		return BunkerVR_RoughMoveOfAnimation(msCameraAnimation_Name);
+	}
+
+	// BunkerVR: follows the knockdowns, kills and deaths, every frame before
+	// the camera is placed. In VR the game's way, the view turned
+	// and tipped by the animated head (thrown through the air, falling, the
+	// Beast's kills), turns the whole world about the player.
+	// - While none plays, the camera's yaw is noted (mfVRRoughYaw): the way the
+	//   player faces when one begins, kept to its end. The camera code above
+	//   then turns the view only by that, level, while the animation still
+	//   carries it (the view goes where the head goes).
+	// - When one begins: the menu's choice for them is read (VR option 35,
+	//   see below) into mlVRRoughView: 0 through the eyes, level; 1 on the
+	//   cutscene screen, the game's own view. The code also handles 2 (faded
+	//   to black) and 3 (through the eyes, gentle: VRGentleView), which the
+	//   menu doesn't offer. Both controllers buzz (longer and stronger for a
+	//   kill or a death), and hpl.log says what began and how it is seen.
+	// - Faded to black: the view darkens in a quarter of a second and comes
+	//   back in half a second after (sent with the game's own fades, see
+	//   VRSendGunNews); a death stays dark into the game's own fade.
+	// - Through the eyes, the view faces the way the animated head faces in
+	//   a kill (VRRoughYawNow), keeps the eyes where they were on the head
+	//   (VRRoughViewPlace), and eases back after it (VRRoughReturn). In a
+	//   knockdown the body keeps the slide under the head it had as it began
+	//   (mvVRRoughShift0, noted while none plays; UpdateOrientation).
+	void VRUpdateRoughMove(float afTimeStep)
+	{
+		cCamera@ pCam = cLux_GetPlayer().GetCamera();
+		if(pCam is null) return;
+		int lKind = VRRoughMoveKind();
+		if(lKind == 0 && pCam.GetRotateMode() == eCameraRotateMode_EulerAngles)
+		{
+			mfVRRoughYaw = pCam.GetYaw();
+			mfVRRoughYaw0 = mfVRRoughYaw;
+		}
+		if(lKind == 0)
+		{
+			mvVRRoughShift0 = mvVRBodyShift;
+			mbVRRoughYawStarted = false;
+		}
+		else
+		{
+			mfVRRoughYawFor += afTimeStep;
+			if(mbVRKillCovered) mfVRKillCoveredFor += afTimeStep;
+		}
+		if(lKind == 0 && mlVRRoughKind != 0 && mlVRRoughView == 0) mbVRRoughReturnDue = true;
+
+		if(lKind != mlVRRoughKind)
+		{
+			if(mlVRRoughKind == 0)
+			{
+				// The menu's choice: 0 no comfort and 2 the vignette are both seen through the eyes, the vignette
+				// darkening the view's edges as it moves fast (VRVignetteView); 1 the cutscene screen. The menu
+				// offers no fade to black or gentle view (mlVRRoughView 2 and 3).
+				int lView = VRModOption(35);
+				mbVRRoughVignette = lView == 2;
+				mlVRRoughView = lView == 1 ? 1 : 0;
+				mfVRKillBlinkHold = 0.0f; // no blink carried over from an earlier one
+				mbVRRoughEyesNoted = false; // VRRoughViewPlace
+				mbVRRoughStartDue = true; // VRRoughStartEase
+				mbVRRoughEndChecked = false;
+				VRBuzzHand(0, lKind == 2 ? 0.6f : 0.3f, lKind == 2 ? 1.0f : 0.6f);
+				VRBuzzHand(1, lKind == 2 ? 0.6f : 0.3f, lKind == 2 ? 1.0f : 0.6f);
+			}
+			array<tString> vKinds = { "nothing", "a knockdown", "a kill or a death" };
+			array<tString> vViews = { "through the eyes, level", "on the cutscene screen", "faded to black", "through the eyes, gentle" };
+			if(lKind != 0)
+				Log("BunkerVR: " + vKinds[lKind] + " begins (" + msCameraAnimation_Name + "), seen " + vViews[mlVRRoughView] + "\n");
+			else
+				Log("BunkerVR: " + vKinds[mlVRRoughKind] + " is over\n");
+			mlVRRoughKind = lKind;
+			if(lKind == 2) VRStartKillView(pCam);
+			else if(lKind == 0) mVRKillBeastID = tID_Invalid;
+		}
+		VRUpdateKillView(afTimeStep);
+
+		// While one plays, seen through the eyes or faded, the arms follow its
+		// animation, not the controllers (Prop_PlayerBody.hps VRArmsLeftToMove:
+		// they return to the controllers as it ends). On the cutscene screen
+		// the mod already leaves them to it.
+		if(mlVRRoughKind != 0 && mlVRRoughView != 1)
+		{
+			cScript_SetGlobalVarInt("BunkerVR_ArmsToMove", 1);
+			cScript_SetGlobalVarFloat("BunkerVR_ArmsToMoveTime", float(cEngine_GetGameTime()));
+		}
+		else cScript_SetGlobalVarInt("BunkerVR_ArmsToMove", 0);
+		VRBuzzBlows(pCam, afTimeStep);
+
+		float fGoal = (mlVRRoughKind != 0 && mlVRRoughView == 2) ? 1.0f : 0.0f;
+		mfVRRoughFade = cMath_IncreaseTo(mfVRRoughFade, afTimeStep * (fGoal > mfVRRoughFade ? 4.0f : 2.0f), fGoal);
+		VRHideTorsoWhenLying();
+	}
+
+	// BunkerVR: lying down in a knockdown, a kill or a death seen through the eyes,
+	// the eyes look along the body from where its head is, so into the torso and the
+	// headless neck. So in a kill or a death the torso and legs are not drawn while
+	// the line from the hips to the head lies low; the arms and hands still are.
+	// A knockdown is over in about 3 seconds, and all through it the eyes look at the
+	// body from where it never is: the inside of the jacket, then a sleeve with
+	// nothing at its end floating past. Hiding by the hips-to-head line alone comes
+	// too late and flickers as the body bounces. So none of the body is drawn from
+	// its first frame until the view and the body are settled after it
+	// (VRKnockBodyTurn), when it is back under the player, the arms on the controllers.
+	// On a ladder in VR, while the upper body cannot bend as far as the real head
+	// (Prop_PlayerBody.hps VRLadderLean says how far its eyes still are from the real
+	// ones, for example when crouched down low), the torso and legs are left out and
+	// only the arms and hands drawn, as VR games that climb by hand draw them
+	// (Half-Life: Alyx); they are drawn again once it can. VRLadderLean fits the body
+	// under the real neck, the hips going down with a duck, so this only covers where
+	// it cannot follow (gfVRLadderLeanHide, gfVRLadderLeanShow).
+	void VRHideTorsoWhenLying()
+	{
+		bool bKnock = mbVRSeen && mlVRRoughView == 0 && (mlVRRoughKind == 1 || mbVRKnockTurning);
+		bool bLadder = false;
+		if(mbVRSeen && VROnLadder())
+		{
+			float fLeanAge = float(cEngine_GetGameTime()) - cScript_GetGlobalVarFloat("BunkerVR_LadderLeanTime");
+			float fMiss = cScript_GetGlobalVarFloat("BunkerVR_LadderLeanMiss");
+			bLadder = fLeanAge > -0.001f && fLeanAge < 0.25f && fMiss > (mbVRTorsoHidden ? gfVRLadderLeanShow : gfVRLadderLeanHide);
+		}
+		if(mlVRRoughKind == 0 && bKnock == false && bLadder == false && mbVRTorsoHidden == false && mbVRArmsHidden == false) return;
+		iLuxEntity@ pEnt = cLux_ID_Entity(m_idBody);
+		cMeshEntity@ pMesh = pEnt !is null ? pEnt.GetMeshEntity() : null;
+		if(pMesh is null) return;
+		if(bKnock != mbVRArmsHidden)
+		{
+			mbVRArmsHidden = bKnock;
+			int lArms = pMesh.GetSubMeshEntityIndex(pEnt.GetName() + "_player_body_soldier_arms");
+			int lHand = pMesh.GetSubMeshEntityIndex(pEnt.GetName() + "_player_body_soldier_hand");
+			if(lArms > -1) pMesh.GetSubMeshEntity(lArms).SetVisible(bKnock == false);
+			if(lHand > -1) pMesh.GetSubMeshEntity(lHand).SetVisible(bKnock == false);
+			Log("BunkerVR: a knockdown: the body is " + (bKnock ? "hidden" : "drawn again") + "\n");
+		}
+		bool bHide = bKnock || bLadder;
+		if(bHide == false && mbVRSeen && mlVRRoughKind != 0 && mlVRRoughView == 0)
+		{
+			cBoneState@ pHead = pMesh.GetBoneStateFromName("j_Head");
+			cBoneState@ pHips = pMesh.GetBoneStateFromName("j_Spine_1");
+			if(pHead !is null && pHips !is null)
+			{
+				cVector3f vUp = pHead.GetWorldPosition() - pHips.GetWorldPosition();
+				float fLength = vUp.Length();
+				if(fLength > 0.01f) bHide = vUp.y / fLength < (mbVRTorsoHidden ? gfVRTorsoShowAbove : gfVRTorsoHideBelow);
+			}
+		}
+		if(bHide == mbVRTorsoHidden) return;
+		mbVRTorsoHidden = bHide;
+		int lBody = pMesh.GetSubMeshEntityIndex(pEnt.GetName() + "_player_body_soldier_body");
+		if(lBody > -1) pMesh.GetSubMeshEntity(lBody).SetVisible(bHide == false);
+		if(mlVRTorsoNotes < 12)
+		{
+			mlVRTorsoNotes++;
+			tString sVRMiss = "";
+			if(VROnLadder()) sVRMiss = " (the shoulders " + int(cScript_GetGlobalVarFloat("BunkerVR_LadderLeanMiss") * 100.0f + 0.5f) + " cm from under the real neck)";
+			Log("BunkerVR: " + (bLadder ? "on a ladder" : "lying down") + ", the torso is " + (bHide ? "hidden" : "drawn again") + sVRMiss + "\n");
+		}
+	}
+
+	// BunkerVR: the turn to draw the body with. A knockdown through the eyes: the
+	// view keeps its facing, and the animation turns the body under it; the one
+	// from behind by a whole half turn in its last second, as the player gets up,
+	// and on as it blends back to standing. So the drawn body is turned against
+	// that, about the eyes (see below), keeping its hips lying the way they did as it
+	// began: it never turns away from the view, and at the end it faces as play has
+	// it. Goes on through the blend back, then eases to the turn play gives it
+	// (afPlayTurn). Anything else: afPlayTurn.
+	float VRKnockBodyTurn(iLuxEntity@ apEntity, float afPlayTurn, float afTimeStep)
+	{
+		bool bKnock = mbVRSeen && mbAttached == false && VRRoughMoveKind() == 1 && mlVRRoughView == 0;
+		if(bKnock == false && mbVRKnockTurning == false) return afPlayTurn;
+		cMeshEntity@ pMesh = apEntity.GetMeshEntity();
+		cBoneState@ pLeft = pMesh !is null ? pMesh.GetBoneStateFromName("j_L_Hip") : null;
+		cBoneState@ pRight = pMesh !is null ? pMesh.GetBoneStateFromName("j_R_Hip") : null;
+		if(pLeft is null || pRight is null)
+		{
+			mbVRKnockTurning = false;
+			return afPlayTurn;
+		}
+		cVector3f vLine = pLeft.GetWorldPosition() - pRight.GetWorldPosition();
+		if(mbVRKnockTurning == false)
+		{
+			mbVRKnockTurning = true;
+			mvVRKnockLineFirst = vLine;
+			mfVRKnockTurn = mfVRBodyTurnApplied;
+		}
+		if(bKnock) mfVRKnockSettle = gfVRKnockSettle;
+		else mfVRKnockSettle -= afTimeStep;
+		if(mfVRKnockSettle > 0.0f)
+		{
+			mfVRKnockTurn = BunkerVR_KeepLineTurn(vLine, mvVRKnockLineFirst, mfVRBodyTurnApplied, gfVRKnockTurnSpeed * afTimeStep);
+			return mfVRKnockTurn;
+		}
+		float fLeft = afPlayTurn - mfVRKnockTurn;
+		while(fLeft > cMath_Pi) fLeft -= cMath_PiMul2;
+		while(fLeft < -cMath_Pi) fLeft += cMath_PiMul2;
+		float fMost = gfVRKnockBackSpeed * afTimeStep;
+		if(cMath_Abs(fLeft) <= fMost)
+		{
+			mbVRKnockTurning = false;
+			return afPlayTurn;
+		}
+		mfVRKnockTurn += cMath_Clamp(fLeft, -fMost, fMost);
+		return mfVRKnockTurn;
+	}
+
+	// BunkerVR: a kill by the Beast seen through the eyes, as it begins. The
+	// Beast says where it and the player are put for it (agent_stalker.hps
+	// State_KillPlayer_Enter; the Beast page's test kills the same:
+	// "BunkerVR_Kill..."). Where the player is moved further than
+	// gfVRKillMovedFar for it (to a hole, out from under a hiding place), a
+	// blink, dark for gfVRKillBlinkMoved, hides the slide. The view faces the
+	// way the body does (VRRoughYawNow), not the Beast: in the kill from
+	// behind the player is meant to face away from it. Where the Beast is only
+	// goes to the log. Seen on the cutscene screen or faded to black (the
+	// menu's choice), the game's own view is left alone.
+	void VRStartKillView(cCamera@ apCam)
+	{
+		mVRKillBeastID = tID_Invalid;
+		mbVRKillCovered = false;
+		mfVRKillCoveredFor = 0.0f;
+		mfVRKillNearest = 100.0f;
+		msVRKillNearestBone = "";
+		mfVRKillTime = 0.0f;
+		mbVRKillEndNoted = false;
+		mfVRKillStartHeight = apCam.GetPosition().y;
+		mvVRKillOpenEye = apCam.GetPosition(); // VRKillEyesInside
+		mbVRKillEyesIn = false;
+		mbVRKillFalling = false;
+		mfVRKillFallFor = 0.0f;
+		mfVRKillHeightWait = 0.0f;
+		mlVRKillHeightKills++;
+		mfVRKillLookOff = 0.0f;
+		mbVRKillPinned = false;
+		mbVRKillLookExact = false;
+		mbVRKillHoldWanted = mlVRRoughView == 0 && VRKillHoldsHead(msCameraAnimation_Name); // the view isn't turned by the head in it
+		mbVRKillHoldAsked = false;
+		mbVRKillHoldSeen = false;
+		if(mlVRRoughView == 0) VRKillLineUp(apCam); // before the kill moves the camera
+		if(mlVRRoughView != 0 && mlVRRoughView != 3) return;
+		if(cString_Sub(msCameraAnimation_Name, 0, 13) != "player_death_") return;
+		float fAge = cMath_Abs(float(cEngine_GetGameTime()) - cScript_GetGlobalVarFloat("BunkerVR_KillTime"));
+		if(fAge > gfVRKillFresh)
+		{
+			Log("BunkerVR: a Beast kill (" + msCameraAnimation_Name + ") without the Beast's word on where it is: seen as it comes\n");
+			return;
+		}
+		mVRKillBeastID = cScript_GetGlobalVarID("BunkerVR_KillBeast");
+		cVector3f vBeast = cScript_GetGlobalVarVector3f("BunkerVR_KillBeastAt");
+		cVector3f vPlayerAt = cScript_GetGlobalVarVector3f("BunkerVR_KillPlayerAt");
+
+		// Where the real head is and looks (level; the game's camera if it is
+		// not known), for the log: how far round the Beast is from the look.
+		cMatrixf mtxHead;
+		bool bHead = VRReadRealHead(apCam, mtxHead);
+		cVector3f vLook = bHead ? VRHeadFacing(mtxHead) : cVector3f(0.0f);
+		if(vLook.Length() < 0.5f)
+		{
+			vLook = apCam.GetForward();
+			vLook.y = 0.0f;
+		}
+		cVector3f vEyes = bHead ? mtxHead.GetTranslation() : apCam.GetPosition();
+		cVector3f vToBeast = vBeast - vEyes;
+		vToBeast.y = 0.0f;
+		float fTurn = 0.0f;
+		if(vToBeast.Length() > 0.1f && vLook.Length() > 0.01f)
+		{
+			fTurn = BunkerVR_YawFacing(vToBeast) - BunkerVR_YawFacing(vLook);
+			while(fTurn > cMath_Pi) fTurn -= cMath_PiMul2;
+			while(fTurn < -cMath_Pi) fTurn += cMath_PiMul2;
+		}
+
+		// How far the player is moved for the kill: far, a blink; and a
+		// shorter one where the body had been slid under the head, as it is
+		// not in a kill (the body, and the eyes on it, move by that much as
+		// it begins).
+		cVector3f vFeet = cLux_GetPlayer().GetCharacterBody().GetFeetPosition();
+		cVector3f vMoved = vPlayerAt - vFeet;
+		vMoved.y = 0.0f;
+		bool bMoved = vMoved.Length() > gfVRKillMovedFar;
+		bool bSlid = mvVRRoughShift0.Length() > gfVRKillSlidFar;
+		if(bMoved || bSlid)
+		{
+			mfVRKillBlinkAgo = 0.0f;
+			mfVRKillBlinkHold = bMoved ? gfVRKillBlinkMoved : gfVRKillBlinkDark;
+		}
+		Log("BunkerVR: the Beast's kill: the Beast is " + int(cMath_ToDeg(fTurn) + (fTurn < 0.0f ? -0.5f : 0.5f)) + " degrees round from the look, " + BunkerVR_Fixed(vToBeast.Length(), 1) +
+			" m off; the player is moved " + BunkerVR_Fixed(vMoved.Length(), 1) + " m" + (bMoved || bSlid ? ", in a blink" : "") + "\n");
+	}
+
+	// BunkerVR: is the real head's turn held in this kill, the view looking exactly as the game's
+	// camera does? True for the kill from the front, the one from behind and the one on a ladder.
+	bool VRKillHoldsHead(const tString &in asAnimation)
+	{
+		return asAnimation == gsVRKillHeldAnim || asAnimation == gsVRKillHeldAnimBack || asAnimation == gsVRKillHeldAnimLadder;
+	}
+
+	// BunkerVR: a Beast kill seen with No Comfort (VRUpdateKillView): dark (1) while the
+	// eyes are where nothing can be seen from, clear (0) otherwise. Each frame the line from where they
+	// were last in the open to where they are now is tried (VRWallAlong: a wall, the floor, a door or
+	// anything heavy; the Beast and the player's own body looked past): met, they are inside; not met,
+	// they are in the open, and that place moves on. So a head dragged through a real opening (the
+	// Beast's hole) stays seen, and one pulled into the floor or a wall goes black.
+	float VRKillEyesInside(const cVector3f &in avEye)
+	{
+		cVector3f vStep = avEye - mvVRKillOpenEye;
+		float fLength = vStep.Length();
+		if(fLength < 0.001f) return mbVRKillEyesIn ? 1.0f : 0.0f;
+		bool bIn = VRWallAlong(mvVRKillOpenEye, vStep * (1.0f / fLength), fLength) >= 0.0f;
+		if(bIn == false) mvVRKillOpenEye = avEye;
+		if(bIn != mbVRKillEyesIn && mlVRKillInsideNotes < 20)
+		{
+			mlVRKillInsideNotes++;
+			Log("BunkerVR: the Beast's kill " + BunkerVR_Fixed(mfVRKillTime, 2) + " s: the eyes " + (bIn ? "go past a wall or the floor: dark" : "are in the open again") + " (No Comfort)\n");
+		}
+		mbVRKillEyesIn = bIn;
+		return bIn ? 1.0f : 0.0f;
+	}
+
+	// BunkerVR: how dark the view is this long after the body fell in a Beast kill
+	// (0 not at all, 1 dark).
+	float VRKillFallDark(const tString &in asAnimation, float afSinceFall)
+	{
+		if(asAnimation == "player_death_back") return cMath_Clamp((afSinceFall - gfVRKillBehindWait) / gfVRKillBehindFade, 0.0f, 1.0f);
+		return cMath_Clamp(afSinceFall / gfVRKillFallFade, 0.0f, 1.0f);
+	}
+
+	// BunkerVR: a Beast kill's view each frame (see VRStartKillView), and the
+	// blink of any knockdown, kill or death (VRRoughYawNow, and the turn it
+	// hides, made once the view is dark, gfVRKillTurnAfter):
+	// - the blink: dark for its hold, clearing over gfVRKillBlinkClear;
+	// - the fall: once the head is gfVRKillFallBelow lower than as the kill
+	//   began, the view fades out slowly over gfVRKillFallFade and stays dark;
+	// - the end: dark over gfVRKillEndFade until the game's own fade begins
+	//   (0.1 s before the player's kill animation ends, as
+	//   State_KillPlayer_TimerUp has it: a cut from the kill to black until then).
+	void VRUpdateKillView(float afTimeStep)
+	{
+		mfVRKillBlinkAgo += afTimeStep;
+		if(mbVRRoughYawSnapDue && mfVRKillBlinkAgo >= gfVRKillTurnAfter)
+		{
+			mfVRRoughYawOff = 0.0f;
+			mbVRRoughYawSnapDue = false;
+		}
+		VRUpdateKillHold(afTimeStep); // the kills whose head turn is held (VRKillHoldsHead)
+
+		// A knockdown through the eyes, near its end: how far the animated body has
+		// turned from the view, for the log. The view is not turned to the body here:
+		// VRKnockBodyTurn keeps the body with the view, so such a turn would only spin
+		// the player (about 90 degrees in one frame). The player keeps facing the way
+		// they faced.
+		if(mlVRRoughKind == 1 && mlVRRoughView == 0 && mbVRRoughEndChecked == false)
+		{
+			cAnimationState@ pThrow = GetAnimationState(msCameraAnimation_Name);
+			if(pThrow !is null && pThrow.GetLength() - pThrow.GetTimePosition() < gfVRRoughEndNoteAt)
+			{
+				mbVRRoughEndChecked = true;
+				float fOff = mfVRRoughAnimYaw - mfVRRoughYaw;
+				while(fOff > cMath_Pi) fOff -= cMath_PiMul2;
+				while(fOff < -cMath_Pi) fOff += cMath_PiMul2;
+				Log("BunkerVR: the knockdown (" + msCameraAnimation_Name + ") nearly over: the body faces " + int(cMath_ToDeg(cMath_Abs(fOff)) + 0.5f) + " degrees from the view\n");
+			}
+		}
+		float fDark = mfVRKillBlinkAgo < mfVRKillBlinkHold ? 1.0f : cMath_Max(0.0f, 1.0f - (mfVRKillBlinkAgo - mfVRKillBlinkHold) / gfVRKillBlinkClear);
+
+		if(mVRKillBeastID != tID_Invalid && mlVRRoughKind == 2)
+		{
+			mfVRKillTime += afTimeStep;
+
+			// The head's height, for tuning the fall (the first two kills, every
+			// gfVRKillHeightEvery).
+			cCamera@ pCam = cLux_GetPlayer().GetCamera();
+			mfVRKillHeightWait -= afTimeStep;
+			if(pCam !is null && mlVRKillHeightKills <= 2 && mfVRKillHeightWait <= 0.0f)
+			{
+				mfVRKillHeightWait = gfVRKillHeightEvery;
+				Log("BunkerVR: the Beast's kill (" + msCameraAnimation_Name + ") " + BunkerVR_Fixed(mfVRKillTime, 2) + " s: the head " + BunkerVR_Fixed(pCam.GetPosition().y - mfVRKillStartHeight, 2) + " m from as it began\n");
+				if(mlVRRoughView == 0 && mfVRKillTime > afTimeStep * 1.5f) VRKillCheckPlace(pCam); // from the second frame, once the kill has placed the camera
+			}
+
+			// The fall: the head (where the camera was put last frame) low enough.
+			if(mbVRKillFalling == false && pCam !is null && pCam.GetPosition().y < mfVRKillStartHeight - gfVRKillFallBelow)
+			{
+				mbVRKillFalling = true;
+				mfVRKillFallFor = 0.0f;
+				Log("BunkerVR: the Beast's kill: the body falls " + BunkerVR_Fixed(mfVRKillTime, 2) + " s in\n");
+			}
+			// With No Comfort chosen, the fall's fade and the hole's darkening below are left out, so the hole and
+			// ladder kills don't go dark from their start: the view is dark only while the eyes are where nothing can
+			// be seen from, past a wall or the floor (VRKillEyesInside). With the vignette, both apply.
+			bool bNoComfort = mlVRRoughView == 0 && mbVRRoughVignette == false;
+			if(bNoComfort && pCam !is null) fDark = cMath_Max(fDark, VRKillEyesInside(pCam.GetPosition()));
+			if(mbVRKillFalling)
+			{
+				mfVRKillFallFor += afTimeStep;
+				if(bNoComfort == false) fDark = cMath_Max(fDark, VRKillFallDark(msCameraAnimation_Name, mfVRKillFallFor));
+			}
+			// The kills through a hole drag the head down into it fast (1.7 m in 0.27 s, 2.8 m by 0.52 s), too fast
+			// for the fall's fade over gfVRKillFallFade: the eyes would go below the floor half seen. There the view
+			// darkens by how far the head has been pulled down, from gfVRKillHoleDarkFrom to black at
+			// gfVRKillHoleDarkFrom + gfVRKillHoleDarkOver, the eyes still well above the floor: the grab is seen,
+			// the floor's underside never.
+			if(bNoComfort == false && pCam !is null && cString_Sub(msCameraAnimation_Name, 0, 18) == "player_death_hole_")
+				fDark = cMath_Max(fDark, cMath_Clamp((mfVRKillStartHeight - pCam.GetPosition().y - gfVRKillHoleDarkFrom) / gfVRKillHoleDarkOver, 0.0f, 1.0f));
+
+			cAnimationState@ pAnim = GetAnimationState(msCameraAnimation_Name);
+			if(pAnim !is null)
+			{
+				float fLeft = pAnim.GetLength() - 0.1f - pAnim.GetTimePosition();
+				float fEnd = cMath_Clamp(1.0f - fLeft / gfVRKillEndFade, 0.0f, 1.0f);
+				if(fEnd > 0.0f && mbVRKillEndNoted == false)
+				{
+					mbVRKillEndNoted = true;
+					Log("BunkerVR: the Beast's kill ends: dark over " + BunkerVR_Fixed(gfVRKillEndFade, 1) + " s; the Beast came within " + int(mfVRKillNearest * 100.0f + 0.5f) +
+						" cm of the eyes (" + msVRKillNearestBone + ")" + (mbVRKillCovered ? "" : "; the view stayed level throughout") + (mbVRKillFalling ? "" : "; no fall seen") + "\n");
+				}
+				fDark = cMath_Max(fDark, fEnd);
+			}
+		}
+		mfVRKillDark = fDark;
+	}
+
+	// BunkerVR: the real head's turn held in a kill (VRKillHoldsHead; see gsVRKillHeldAnim),
+	// each update (VRUpdateKillView, its blink's time already moved on): asked for from when
+	// its blink is dark (VRKillPinNow), let go as soon as the kill is over. Once the mod holds
+	// it, the facing is read again (VRKillHeldLookAgain); until then the blink stays dark (at
+	// most gfVRKillHoldWaitMost from its start).
+	void VRUpdateKillHold(float afTimeStep)
+	{
+		if(mlVRRoughKind == 0) mbVRKillHoldAsked = false;
+		bool bHoldAsk = mbVRKillHoldAsked && mlVRRoughKind == 2;
+		bool bHeld = cVR_HoldHeadTurn(bHoldAsk);
+		if(bHoldAsk && bHeld && mbVRKillHoldSeen == false)
+		{
+			mbVRKillHoldSeen = true;
+			VRKillHeldLookAgain();
+		}
+		if(bHoldAsk == false || mbVRKillHoldSeen) return;
+		if(mfVRKillBlinkAgo < mfVRKillBlinkHold && mfVRKillBlinkAgo < gfVRKillHoldWaitMost)
+			mfVRKillBlinkHold = cMath_Max(mfVRKillBlinkHold, cMath_Min(mfVRKillBlinkAgo + afTimeStep * 2.0f, gfVRKillHoldWaitMost));
+		if(mfVRKillBlinkAgo >= gfVRKillHoldWaitMost && mfVRKillBlinkAgo - afTimeStep < gfVRKillHoldWaitMost)
+			Log("BunkerVR: the kill (" + msCameraAnimation_Name + "): the mod has not held the real head's turn " + BunkerVR_Fixed(gfVRKillHoldWaitMost, 1) + " s into the blink: the view turns with the head\n");
+	}
+
+	// BunkerVR: how near anything of the Beast doing the kill (its bones: a
+	// hand, its face) is to the eyes (avEyes), in meters; 100 if it is not
+	// known. Called every frame of the kill. Its nearest so far is kept for
+	// the log, and the bone nearest now (msVRKillNearBone).
+	float VRKillNear(const cVector3f &in avEyes)
+	{
+		iLuxEntity@ pBeast = cLux_ID_Entity(mVRKillBeastID);
+		cMeshEntity@ pMesh = pBeast !is null ? pBeast.GetMeshEntity() : null;
+		if(pMesh is null) return 100.0f;
+		float fNearest = 100.0f;
+		for(int i = 0; i < pMesh.GetBoneStateNum(); ++i)
+		{
+			cBoneState@ pBone = pMesh.GetBoneState(i);
+			if(pBone is null) continue;
+			float fDist = (pBone.GetWorldPosition() - avEyes).Length();
+			if(fDist < fNearest)
+			{
+				fNearest = fDist;
+				msVRKillNearBone = pBone.GetName();
+			}
+		}
+		if(fNearest < mfVRKillNearest)
+		{
+			mfVRKillNearest = fNearest;
+			msVRKillNearestBone = msVRKillNearBone;
+		}
+		return fNearest;
+	}
+
+	// BunkerVR: the way the view faces in a knockdown, a kill or a death seen
+	// through the eyes (see gfVRRoughYawSettle): the animated
+	// head's (afAnimYaw, level), plus the difference from the way the view
+	// faced as the move began, eased out over gfVRRoughYawSettle; a difference
+	// of more than gfVRRoughYawBlink is taken out in a blink instead (the turn
+	// made once the view is dark: VRUpdateKillView). Logged as each begins.
+	float VRRoughYawNow(float afAnimYaw)
+	{
+		if(mbVRRoughYawStarted == false)
+		{
+			mbVRRoughYawStarted = true;
+			mfVRRoughYawFor = 0.0f;
+			mfVRRoughYawOff = mfVRRoughYaw0 - afAnimYaw;
+			while(mfVRRoughYawOff > cMath_Pi) mfVRRoughYawOff -= cMath_PiMul2;
+			while(mfVRRoughYawOff < -cMath_Pi) mfVRRoughYawOff += cMath_PiMul2;
+			// Also in a blink already begun (VRKillLineUp's), whatever its size.
+			bool bBlinking = mfVRKillBlinkAgo < mfVRKillBlinkHold;
+			mbVRRoughYawSnapDue = cMath_Abs(mfVRRoughYawOff) > gfVRRoughYawBlink || bBlinking;
+			if(mbVRRoughYawSnapDue && bBlinking == false)
+			{
+				mfVRKillBlinkAgo = 0.0f;
+				mfVRKillBlinkHold = cMath_Max(mfVRKillBlinkHold, gfVRKillBlinkDark);
+			}
+			Log("BunkerVR: the view faces the way the body does (" + msCameraAnimation_Name + "): " + int(cMath_ToDeg(cMath_Abs(mfVRRoughYawOff)) + 0.5f) + " degrees from the way it faced, " +
+				(mbVRRoughYawSnapDue ? "turned in a blink" : "eased out over " + BunkerVR_Fixed(gfVRRoughYawSettle, 1) + " s") + "\n");
+		}
+		float fLeft = 1.0f - BunkerVR_SmoothStep(0.0f, gfVRRoughYawSettle, mfVRRoughYawFor);
+		return afAnimYaw + mfVRRoughYawOff * fLeft;
+	}
+
+	// BunkerVR: where the eyes are on the head as a knockdown, a kill or a death
+	// begins. In play the eyes are not at the game's camera point (the game
+	// hangs that out in front of the face; the mod puts the body so that its
+	// neck is under the real head: mvVRBodyShift). Taking the body's whole
+	// slide off the view in the room's directions, not the head's, would
+	// leave the view some 20 cm off the head, and more as the body tips over:
+	// the head looks detached, and the Beast's hand misses it in a kill. So
+	// the eyes (the real head's middle, roll 7005) as the move begins are
+	// noted from the camera point as play last placed it (mvVRRoughSocket0,
+	// turned m_mtxVRRoughSocketTurn0), in the head's own terms
+	// (mvVRRoughEyesOnHead), and where the real eyes were from the view's
+	// place (mvVRRoughEyes0): VRRoughViewPlace keeps them there. Not more than
+	// gfVRRoughEyesFar off the camera point (anything more is a stale reading).
+	// Noted at the move's first placing of the view (VRRoughViewPlace), the
+	// view still where play put it, turned level as for the move.
+	void VRNoteEyesOnHead(cCamera@ apCam)
+	{
+		mvVRRoughEyesOnHead = cVector3f(0.0f);
+		mvVRRoughEyes0 = cVector3f(0.0f);
+		cMatrixf mtxHead;
+		if(VRReadRealHead(apCam, mtxHead) == false) return;
+		mvVRRoughEyes0 = mtxHead.GetTranslation() - apCam.GetPosition();
+		cVector3f vOnHead = mtxHead.GetTranslation() - mvVRRoughSocket0;
+		if(vOnHead.Length() > gfVRRoughEyesFar)
+		{
+			Log("BunkerVR: the eyes were " + int(vOnHead.Length() * 100.0f + 0.5f) + " cm from the game's camera point as it began: taken as at it\n");
+			return;
+		}
+		mvVRRoughEyesOnHead = cMath_MatrixMul3x3(m_mtxVRRoughSocketTurn0.GetTranspose(), vOnHead);
+		Log("BunkerVR: the eyes are " + int(vOnHead.Length() * 100.0f + 0.5f) + " cm from the game's camera point on the head (" + BunkerVR_Fixed(mvVRRoughEyesOnHead.x * 100.0f, 0) + " " +
+			BunkerVR_Fixed(mvVRRoughEyesOnHead.y * 100.0f, 0) + " " + BunkerVR_Fixed(mvVRRoughEyesOnHead.z * 100.0f, 0) + " cm in its own terms); the real eyes " +
+			int(mvVRRoughEyes0.Length() * 100.0f + 0.5f) + " cm from the view's place\n");
+	}
+
+	// BunkerVR: where the view goes this frame, through the eyes:
+	// the eyes kept where they were on the head (VRNoteEyesOnHead), as the
+	// animated head (its camera point avSocket, turned a_mtxSocketTurn) moves,
+	// tips and turns, and as far as the real head has moved since it began,
+	// up to gfVRRoughHeadRoom (no further: the head stays on the body). The
+	// real eyes' place from the view's (from roll 7005, with the turn the
+	// camera has been given this frame) is taken off, as the mod adds it.
+	cVector3f VRRoughViewPlace(cCamera@ apCam, const cVector3f &in avSocket, const cMatrixf &in a_mtxSocketTurn)
+	{
+		if(mbVRRoughEyesNoted == false)
+		{
+			mbVRRoughEyesNoted = true;
+			VRNoteEyesOnHead(apCam);
+		}
+		cVector3f vEyesNow = mvVRRoughEyes0;
+		cMatrixf mtxHead;
+		if(VRReadRealHead(apCam, mtxHead))
+		{
+			vEyesNow = mtxHead.GetTranslation() - apCam.GetPosition();
+			if(mlVRRoughKind == 2 && mbVRKillLookExact == false) VRKillLookExact(mtxHead);
+		}
+		// A kill or a death: the real eyes on the camera point itself.
+		if(mlVRRoughKind == 2 && VRKillPinNow()) return VRKillPinnedView(avSocket, vEyesNow);
+		return VRRoughViewFor(avSocket, a_mtxSocketTurn, vEyesNow);
+	}
+
+	// BunkerVR: the view's place that puts the real eyes (avEyesNow from the view's
+	// place, as the mod adds them) on the game's camera point avSocket.
+	cVector3f VRKillPinnedView(const cVector3f &in avSocket, const cVector3f &in avEyesNow)
+	{
+		return avSocket - avEyesNow;
+	}
+
+	// BunkerVR: are the real eyes to be kept on the game's camera point in this kill
+	// from now on? Once the view is dark, if the kill began with a blink
+	// (when the turn is made too: gfVRKillTurnAfter, VRUpdateKillView), else at once.
+	bool VRKillPinNow()
+	{
+		if(mbVRKillPinned) return true;
+		if(mfVRKillBlinkAgo < gfVRKillTurnAfter) return false;
+		mbVRKillPinned = true;
+		if(mbVRKillHoldWanted) mbVRKillHoldAsked = true; // hold the head's turn from now, the view dark (VRUpdateKillView)
+		Log("BunkerVR: the kill (" + msCameraAnimation_Name + "): the eyes are on the game's camera point from " + BunkerVR_Fixed(mfVRKillTime, 2) + " s in\n");
+		return true;
+	}
+
+	// BunkerVR: as a kill or a death seen through the eyes begins (see
+	// gfVRKillPinBlinkFar): how far the real head is turned from the way the game
+	// faces (mfVRKillLookOff: the view is lined up by it, VRRoughYawNow's facing and
+	// VRKillCoveredTurn), and how far the eyes are from the game's camera point (as play
+	// last put it); a blink when either is large. Read before the kill moves the camera.
+	void VRKillLineUp(cCamera@ apCam)
+	{
+		cMatrixf mtxHead;
+		if(VRReadRealHead(apCam, mtxHead) == false)
+		{
+			mbVRKillHoldWanted = false; // nothing to hold
+			Log("BunkerVR: the kill (" + msCameraAnimation_Name + ") begins with the real head not followed: the eyes are put on the game's camera point, facing as the game does\n");
+			return;
+		}
+		float fCamYaw = apCam.GetRotateMode() == eCameraRotateMode_EulerAngles ? apCam.GetYaw() : mfVRRoughYaw0;
+		cVector3f vLook = VRHeadFacing(mtxHead);
+		if(vLook.Length() > 0.5f) mfVRKillLookOff = VRAngleWrapped(BunkerVR_YawFacing(vLook) - fCamYaw);
+		float fFar = (mtxHead.GetTranslation() - mvVRRoughSocket0).Length();
+		// Always a blink in a kill whose head turn is held (VRKillHoldsHead): it is held from the blink on.
+		bool bBlink = fFar > gfVRKillPinBlinkFar || cMath_Abs(mfVRKillLookOff) > gfVRKillLineUpBlink || mbVRKillHoldWanted;
+		if(bBlink)
+		{
+			mfVRKillBlinkAgo = 0.0f;
+			mfVRKillBlinkHold = cMath_Max(mfVRKillBlinkHold, gfVRKillBlinkDark);
+		}
+		Log("BunkerVR: the kill (" + msCameraAnimation_Name + "): the eyes go onto the game's camera point (" + int(fFar * 100.0f + 0.5f) + " cm from it) and face as the animated head does (the real head turned " +
+			int(cMath_ToDeg(mfVRKillLookOff) + (mfVRKillLookOff < 0.0f ? -0.5f : 0.5f)) + " degrees from the game's facing)" + (bBlink ? ", in a blink" : "") +
+			(mbVRKillHoldWanted ? "; the real head's turn to be held from then on" : "") + "\n");
+	}
+
+	// BunkerVR: the real head's turn from the game's facing read again once the mod holds it
+	// (see gsVRKillHeldAnim), the view still dark: the turn it holds is the head's a
+	// frame or more after the line-up's readings (VRKillLineUp, VRKillLookExact), so the kill's
+	// facing is lined up by it (mfVRKillLookOff) at once, not eased (as VRKillLookExact must, in
+	// the light). Read with the camera as last placed: level, facing mfVRRoughYaw; not once the
+	// Beast's hand is over the eyes (the camera tipped by then).
+	void VRKillHeldLookAgain()
+	{
+		cCamera@ pCam = cLux_GetPlayer().GetCamera();
+		cMatrixf mtxHead;
+		if(pCam is null || mbVRKillCovered || VRReadRealHead(pCam, mtxHead) == false)
+		{
+			Log("BunkerVR: the kill (" + msCameraAnimation_Name + "): the real head's turn is held; not read again\n");
+			return;
+		}
+		VRKillHeldLook(mtxHead);
+	}
+
+	// BunkerVR: VRKillHeldLookAgain's sum: the held head a_mtxHead, read with the
+	// kill's level camera of yaw mfVRRoughYaw.
+	void VRKillHeldLook(const cMatrixf &in a_mtxHead)
+	{
+		cVector3f vLook = VRHeadFacing(a_mtxHead);
+		if(vLook.Length() < 0.5f) return;
+		float fHeld = VRAngleWrapped(BunkerVR_YawFacing(vLook) - mfVRRoughYaw);
+		Log("BunkerVR: the kill (" + msCameraAnimation_Name + "): the real head's turn is held, " + int(cMath_ToDeg(fHeld) + (fHeld < 0.0f ? -0.5f : 0.5f)) + " degrees from the game's facing (" +
+			BunkerVR_Fixed(cMath_ToDeg(VRAngleWrapped(fHeld - mfVRKillLookOff)), 1) + " from the reading before): the view no longer turns with the head\n");
+		mfVRKillLookOff = fHeld;
+	}
+
+	// BunkerVR: the real head's turn from the game's facing read again in the kill's
+	// first frame, the camera as the kill has just turned it (level, facing mfVRRoughYaw)
+	// rather than as play left it: VRKillLineUp's reading, with play's camera, falls short
+	// (3 degrees with the head turned 40 in the kill from behind), and the eyes would then
+	// look that far off the animated head's look all through. VRRoughYawNow's offset is
+	// moved by as much, so that the view does not jump.
+	void VRKillLookExact(const cMatrixf &in a_mtxHead)
+	{
+		mbVRKillLookExact = true;
+		cVector3f vLook = VRHeadFacing(a_mtxHead);
+		if(vLook.Length() < 0.5f) return;
+		float fExact = VRAngleWrapped(BunkerVR_YawFacing(vLook) - mfVRRoughYaw);
+		float fChange = VRAngleWrapped(fExact - mfVRKillLookOff);
+		mfVRRoughYawOff += fChange;
+		mfVRKillLookOff = fExact;
+		Log("BunkerVR: the kill (" + msCameraAnimation_Name + "): the real head turned " + int(cMath_ToDeg(fExact) + (fExact < 0.0f ? -0.5f : 0.5f)) + " degrees from the game's facing, read with the kill's camera (" +
+			BunkerVR_Fixed(cMath_ToDeg(fChange), 1) + " from the first reading)\n");
+	}
+
+	// BunkerVR: an angle brought within a half turn either way (radians).
+	float VRAngleWrapped(float afAngle)
+	{
+		float fAngle = afAngle;
+		while(fAngle > cMath_Pi) fAngle -= cMath_PiMul2;
+		while(fAngle < -cMath_Pi) fAngle += cMath_PiMul2;
+		return fAngle;
+	}
+
+	// BunkerVR: the camera's turn (as the cutscene code builds it, before it is
+	// transposed) that has the eyes look as the animated head (its turn a_mtxAnimated)
+	// does, the real head turned afLookOff from the game's facing as the kill began.
+	// The mod puts the headset's turn on the camera's in the camera's own
+	// terms, so that much is first taken off about the camera's own up. Level, it is
+	// BunkerVR_LevelCameraRotation of the animated head's yaw less afLookOff, the turn
+	// VRRoughYawNow settles on, so the grab's blend into it starts with no jump.
+	cMatrixf VRKillCoveredTurn(const cMatrixf &in a_mtxAnimated, float afLookOff)
+	{
+		return cMath_MatrixMul(a_mtxAnimated, cMath_MatrixRotateY(-afLookOff));
+	}
+
+	// BunkerVR: the log's check of a kill seen through the eyes, with the
+	// camera as last frame placed it: how far the real eyes are from the game's camera
+	// point then (mvVRKillEyesGoal), how far their facing is turned from the animated
+	// head's (level), and once the Beast's hand is over the eyes how far their look is
+	// from where the animated head looks.
+	void VRKillCheckPlace(cCamera@ apCam)
+	{
+		cMatrixf mtxHead;
+		if(VRReadRealHead(apCam, mtxHead) == false) return;
+		float fOff = (mtxHead.GetTranslation() - mvVRKillEyesGoal).Length();
+		tString sLook = "";
+		if(mbVRKillCovered)
+		{
+			// The animated head is tipped and rolled, so its whole look is compared. The
+			// level facing alone, read two ways for a tipped head, can be up to 71 degrees
+			// apart while the looks agree.
+			cVector3f vFwd = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxHead, cVector3f(0.0f, 0.0f, -1.0f)));
+			cVector3f vGoal = cMath_Vector3Normalize(cMath_MatrixMul3x3(m_mtxVRKillLookGoal, cVector3f(0.0f, 0.0f, -1.0f)));
+			float fApart = cMath_ACos(cMath_Clamp(cMath_Vector3Dot(vFwd, vGoal), -1.0f, 1.0f));
+			sLook = "looking " + int(cMath_ToDeg(fApart) + 0.5f) + " degrees from where the animated head looks";
+		}
+		else
+		{
+			cVector3f vLook = VRHeadFacing(mtxHead);
+			float fTurn = vLook.Length() > 0.5f ? VRAngleWrapped(BunkerVR_YawFacing(vLook) - mfVRRoughAnimYaw) : 0.0f;
+			sLook = "turned " + int(cMath_ToDeg(fTurn) + (fTurn < 0.0f ? -0.5f : 0.5f)) + " degrees from the animated head's facing";
+		}
+		Log("BunkerVR: the kill (" + msCameraAnimation_Name + ") " + BunkerVR_Fixed(mfVRKillTime, 2) + " s: the eyes " + BunkerVR_Fixed(fOff * 100.0f, 1) + " cm from the game's camera point" +
+			(mbVRKillPinned ? "" : " (not yet put on it)") + ", " + sLook + "\n");
+	}
+
+	// BunkerVR: VRRoughViewPlace's sum: the view's place for the
+	// camera point avSocket turned a_mtxSocketTurn, the real eyes avEyesNow
+	// from the view's place.
+	cVector3f VRRoughViewFor(const cVector3f &in avSocket, const cMatrixf &in a_mtxSocketTurn, const cVector3f &in avEyesNow)
+	{
+		cVector3f vMoved = avEyesNow - mvVRRoughEyes0;
+		if(vMoved.Length() > gfVRRoughHeadRoom) vMoved = cMath_Vector3Normalize(vMoved) * gfVRRoughHeadRoom;
+		cVector3f vEyes = avSocket + cMath_MatrixMul3x3(a_mtxSocketTurn, mvVRRoughEyesOnHead) + vMoved;
+		return vEyes - avEyesNow;
+	}
+
+	// BunkerVR: as a knockdown begins, seen through the eyes, the view goes to the
+	// animated head at once: 62 cm in two frames, as the one from behind begins.
+	// So it is eased there from where it was over gfVRRoughStartTime. What to add
+	// to avPlace this frame.
+	cVector3f VRRoughStartEase(const cVector3f &in avPlace, float afTimeStep)
+	{
+		bool bStart = mbVRRoughStartDue;
+		if(mbVRRoughStartDue)
+		{
+			mbVRRoughStartDue = false;
+			mfVRRoughStartWatch = gfVRRoughStartWatch;
+		}
+		else if(mfVRRoughStartWatch > 0.0f)
+		{
+			mfVRRoughStartWatch -= afTimeStep;
+			bStart = (avPlace - mvVRRoughStartPlaceLast).Length() > gfVRRoughReturnJump;
+		}
+		mvVRRoughStartPlaceLast = avPlace;
+		if(bStart)
+		{
+			cVector3f vGap = mvVRRoughLastCam - avPlace;
+			if(vGap.Length() < gfVRRoughReturnMost)
+			{
+				mvVRRoughStartOff = vGap;
+				mfVRRoughStartFor = 0.0f;
+			}
+		}
+		if(mfVRRoughStartFor >= gfVRRoughStartTime) return cVector3f(0.0f);
+		mfVRRoughStartFor += afTimeStep;
+		return mvVRRoughStartOff * (1.0f - BunkerVR_SmoothStep(0.0f, gfVRRoughStartTime, mfVRRoughStartFor));
+	}
+
+	// BunkerVR: just after a knockdown, a kill or a death seen through the eyes,
+	// the view eases from where the move left it to where play puts it (avNow),
+	// over gfVRRoughReturnTime, so that it doesn't snap as the animation ends.
+	// What to add to avNow this frame. Not for a jump of gfVRRoughReturnMost or
+	// more (a new place, a level loaded). Logged.
+	// Play's own place jumps too, the frame after the end, as the body's slide under
+	// the head is worked out afresh (by some 44 cm): for gfVRRoughReturnWatch a jump
+	// of more than gfVRRoughReturnJump starts the easing again from where the view is.
+	cVector3f VRRoughReturn(const cVector3f &in avNow, float afTimeStep)
+	{
+		bool bStart = mbVRRoughReturnDue;
+		if(mbVRRoughReturnDue)
+		{
+			mbVRRoughReturnDue = false;
+			mfVRRoughReturnWatch = gfVRRoughReturnWatch;
+		}
+		else if(mfVRRoughReturnWatch > 0.0f)
+		{
+			mfVRRoughReturnWatch -= afTimeStep;
+			bStart = (avNow - mvVRRoughReturnNowLast).Length() > gfVRRoughReturnJump;
+		}
+		mvVRRoughReturnNowLast = avNow;
+		if(bStart)
+		{
+			cVector3f vGap = mvVRRoughLastCam - avNow;
+			if(vGap.Length() > 0.005f && vGap.Length() < gfVRRoughReturnMost)
+			{
+				mvVRRoughReturnOff = vGap;
+				mfVRRoughReturnFor = 0.0f;
+				Log("BunkerVR: the view eases back to play from " + int(vGap.Length() * 100.0f + 0.5f) + " cm off, over " + BunkerVR_Fixed(gfVRRoughReturnTime, 1) + " s\n");
+			}
+		}
+		cVector3f vOff = cVector3f(0.0f);
+		if(mfVRRoughReturnFor < gfVRRoughReturnTime)
+		{
+			mfVRRoughReturnFor += afTimeStep;
+			vOff = mvVRRoughReturnOff * (1.0f - BunkerVR_SmoothStep(0.0f, gfVRRoughReturnTime, mfVRRoughReturnFor));
+		}
+		mvVRRoughLastCam = avNow + vOff;
+		return vOff;
+	}
+
+	// BunkerVR: the blows of a knockdown, a kill or a death, felt all through it,
+	// not only at the start: both controllers buzz (gfVRBlowBuzz long,
+	// gfVRBlowStrength strong) when the
+	// animated head stops suddenly (a landing, a hit), found as the gentle
+	// view finds its blink (VRGentleView: from faster than gfVRGentleStopFast
+	// to slower than gfVRGentleStopSlow within gfVRGentleStopWithin), at most
+	// one every gfVRBlowApart. The head as the camera was put last frame. The
+	// first ten logged.
+	void VRBuzzBlows(cCamera@ apCam, float afTimeStep)
+	{
+		if(mlVRRoughKind == 0 || afTimeStep <= 0.0f)
+		{
+			mbVRBlowKnown = false;
+			return;
+		}
+		cVector3f vHead = apCam.GetPosition();
+		float fSpeed = mbVRBlowKnown ? (vHead - mvVRBlowLastHead).Length() / afTimeStep : 0.0f;
+		if(mbVRBlowKnown == false)
+		{
+			mfVRBlowSpeed = 0.0f;
+			mfVRBlowFastAgo = 100.0f;
+			mfVRBlowAgo = 100.0f;
+		}
+		mvVRBlowLastHead = vHead;
+		mbVRBlowKnown = true;
+		mfVRBlowSpeed += (fSpeed - mfVRBlowSpeed) * afTimeStep / (0.05f + afTimeStep);
+		mfVRBlowFastAgo = mfVRBlowSpeed > gfVRGentleStopFast ? 0.0f : mfVRBlowFastAgo + afTimeStep;
+		mfVRBlowAgo += afTimeStep;
+		if(mfVRBlowSpeed < gfVRGentleStopSlow && mfVRBlowFastAgo < gfVRGentleStopWithin && mfVRBlowAgo > gfVRBlowApart)
+		{
+			VRBuzzHand(0, gfVRBlowBuzz, gfVRBlowStrength);
+			VRBuzzHand(1, gfVRBlowBuzz, gfVRBlowStrength);
+			mfVRBlowAgo = 0.0f;
+			mfVRBlowFastAgo = 100.0f;
+			if(mlVRBlowNotes < 10)
+			{
+				mlVRBlowNotes++;
+				Log("BunkerVR: a blow (" + msCameraAnimation_Name + "): the head down to " + BunkerVR_Fixed(mfVRBlowSpeed, 1) + " m/s; both hands buzz\n");
+			}
+		}
+	}
+
+	// BunkerVR: the real head (the mod's roll 7006: is it followed; 7005:
+	// where), as a matrix; false when it is not followed.
+	bool VRReadRealHead(cCamera@ apCam, cMatrixf &out a_mtxHead)
+	{
+		a_mtxHead = cMatrixf_Identity;
+		float fRealRoll = apCam.GetRoll();
+		apCam.SetRoll(7006.0f);
+		cVector3f vStatus = apCam.GetMatrix().GetTranslation();
+		bool bHead = vStatus.x > 12344.0f && vStatus.x < 12346.0f && vStatus.y > 0.5f;
+		if(bHead)
+		{
+			apCam.SetRoll(7005.0f);
+			a_mtxHead = apCam.GetMatrix();
+		}
+		apCam.SetRoll(fRealRoll);
+		return bHead;
+	}
+
+	// BunkerVR: notes the game's own cutscenes as they begin, for the log.
+	// They are always shown on the cutscene screen.
+	void VRNoteCutscene(bool abNow)
+	{
+		if(abNow == mbVRInCutscene) return;
+		mbVRInCutscene = abNow;
+		if(abNow) Log("BunkerVR: a cutscene begins (" + msCameraAnimation_Name + "), seen on the cutscene screen\n");
+	}
+
+	// BunkerVR: the gentle view of knockdowns, kills and deaths (mlVRRoughView 3,
+	// which the menu doesn't offer; see VRUpdateRoughMove): a view through the
+	// eyes that is less disorienting and doesn't let the body clip through the
+	// head. Every frame, once the camera is placed (the animated head, level,
+	// facing the way the player faced, as with no comfort), while one plays and
+	// for gfVRGentleEaseBack after:
+	// - The body and everything hung on it (what the hands hold) are hidden,
+	//   so nothing of it comes through the view (VRGentleHide); shown again
+	//   as the move ends.
+	// - The view follows the animated head as a soft spring
+	//   (BunkerVR_SpringFollow, gfVRGentleSpring), from where the view was:
+	//   the throw's start, the hit on the floor and the getting up are rounded
+	//   off, and it never goes lower than the head went.
+	// - A dark ring closes in from the edges of the view as the view goes
+	//   faster (gfVRGentleRingSlow to gfVRGentleRingFast; the mod draws it,
+	//   cVR_ComfortRing), most of all in the flight.
+	// - A blink, the view dark for a moment (sent with the fades,
+	//   VRSendGunNews), when the head stops suddenly (the impact): its speed
+	//   from above gfVRGentleStopFast to below gfVRGentleStopSlow within
+	//   gfVRGentleStopWithin.
+	// - When it is over, the view eases back to where the game puts it, over
+	//   gfVRGentleEaseBack (no jump).
+	// The real head still looks about and moves the view as ever (the mod adds
+	// it after this). Logged: the start and the end, each blink, and (the first
+	// three) every 0.1 s the speeds, the lag and the ring, to tune by.
+	// BunkerVR: a knockdown, a kill or a death through the eyes with the vignette (the menu's "Knockdown and Death
+	// View": Vignette): the view goes as with no comfort (mlVRRoughView 0, all of it), and a dark ring closes in
+	// from its edges as the view goes faster, as the gentle view's ring does (gfVRGentleRingSlow to gfVRGentleRingFast,
+	// closing quickly and opening slowly; the mod draws it, cVR_ComfortRing), opening again as it ends. Narrowing the
+	// view while it moves is a common comfort setting in VR games: Road to VR's "VR Comfort Settings Checklist &
+	// Glossary" (a "comfort vignette", or tunneling); Fernandes and Feiner, "Combating VR Sickness through Subtle
+	// Dynamic Field-Of-View Modification" (IEEE 3DUI 2016).
+	void VRVignetteView(cCamera@ apCam, float afTimeStep)
+	{
+		bool bOn = mbVRSeen && mlVRRoughKind != 0 && mlVRRoughView == 0 && mbVRRoughVignette;
+		if(bOn == false && mfVRVignetteRing <= 0.0f) return;
+		if(afTimeStep <= 0.0f) return;
+		cVector3f vHead = apCam.GetPosition();
+		if(mbVRVignetteOn == false && bOn)
+		{
+			mbVRVignetteOn = true;
+			mvVRVignetteLastHead = vHead;
+			mfVRVignetteSpeed = 0.0f;
+			Log("BunkerVR: a knockdown, a kill or a death with the vignette begins\n");
+		}
+		// The animated head's speed, smoothed a little, as in the gentle view; a jump of the game's (a new place) is not a speed.
+		float fMoved = (vHead - mvVRVignetteLastHead).Length();
+		mvVRVignetteLastHead = vHead;
+		float fSpeed = fMoved < gfVRGentleJump ? fMoved / afTimeStep : 0.0f;
+		mfVRVignetteSpeed += (fSpeed - mfVRVignetteSpeed) * afTimeStep / (0.05f + afTimeStep);
+		float fRing = bOn ? BunkerVR_SmoothStep(gfVRGentleRingSlow, gfVRGentleRingFast, mfVRVignetteSpeed) : 0.0f;
+		mfVRVignetteRing = cMath_IncreaseTo(mfVRVignetteRing, afTimeStep * (fRing > mfVRVignetteRing ? 6.0f : 2.0f), fRing);
+		if(bOn == false && mfVRVignetteRing <= 0.0f)
+		{
+			mbVRVignetteOn = false;
+			cVR_ComfortRing(0.0f);
+			Log("BunkerVR: the vignette is open again\n");
+			return;
+		}
+		cVR_ComfortRing(mfVRVignetteRing);
+	}
+
+	void VRGentleView(cCamera@ apCam, float afTimeStep)
+	{
+		// With the headset off (mbVRSeen false) it counts as over, so that the body is shown.
+		bool bRough = mlVRRoughKind != 0 && mlVRRoughView == 3;
+		bool bMove = mbVRSeen && bRough;
+		if(bMove == false && mbVRGentle == false) return;
+		if(afTimeStep <= 0.0f) return;
+		cVector3f vHead = apCam.GetPosition();
+
+		if(mbVRGentle == false)
+		{
+			// Begins: from where the view was a frame ago (mvCameraPos, not yet
+			// this frame's), still; at the head if that is far off.
+			mbVRGentle = true;
+			float fFrom = (mvCameraPos - vHead).Length();
+			mvVRGentlePos = fFrom < gfVRGentleJump ? mvCameraPos : vHead;
+			mvVRGentleVel = cVector3f(0.0f);
+			mvVRGentleLastHead = vHead;
+			mfVRGentleHeadSpeed = 0.0f;
+			mfVRGentleFastAgo = 100.0f;
+			mfVRGentleBlinkAgo = 100.0f;
+			mfVRGentleDark = 0.0f;
+			mfVRGentleRing = 0.0f;
+			mfVRGentleBack = -1.0f;
+			mfVRGentleTime = 0.0f;
+			mfVRGentleNoteWait = 0.0f;
+			mlVRGentleCount++;
+			mlVRGentleBlinks = 0;
+			mfVRGentleTopHead = 0.0f;
+			mfVRGentleTopView = 0.0f;
+			mfVRGentleMostLag = 0.0f;
+			int lHidden = bRough ? VRGentleHide(true) : 0;
+			Log("BunkerVR: gentle view " + mlVRGentleCount + " begins (" + (bRough ? "a knockdown, a kill or a death" : "a cutscene") + "): " + lHidden + " thing(s) hidden (the body and what hangs on it); the view starts " + (fFrom < gfVRGentleJump ? BunkerVR_Fixed(fFrom * 100.0f, 0) + " cm from the head" : "at the head (it was " + BunkerVR_Fixed(fFrom, 1) + " m off)") + "\n");
+		}
+		else if(bMove && mfVRGentleBack >= 0.0f)
+		{
+			// Another begins during the eased return: on with it, hidden again.
+			mfVRGentleBack = -1.0f;
+			int lHidden = bRough ? VRGentleHide(true) : 0;
+			Log("BunkerVR: gentle view " + mlVRGentleCount + ": another move begins during the return; " + lHidden + " thing(s) hidden again\n");
+		}
+		mfVRGentleTime += afTimeStep;
+		if(mbVRGentleBlinkNow)
+		{
+			// (Asked as the view turned to a cutscene's facing: see the camera code.)
+			mbVRGentleBlinkNow = false;
+			mfVRGentleBlinkAgo = 0.0f;
+			mlVRGentleBlinks++;
+		}
+
+		// A jump of the game's (a new place, a map loaded): there at once.
+		float fGap = (vHead - mvVRGentlePos).Length();
+		if(fGap > gfVRGentleJump)
+		{
+			Log("BunkerVR: gentle view " + mlVRGentleCount + ": the head is " + BunkerVR_Fixed(fGap, 1) + " m off: the view goes there at once\n");
+			mvVRGentlePos = vHead;
+			mvVRGentleVel = cVector3f(0.0f);
+			mvVRGentleLastHead = vHead;
+		}
+
+		// The head's own speed, smoothed a little (the body's animation can
+		// move it on some frames and not on others), and a sudden stop of it.
+		float fHeadSpeed = (vHead - mvVRGentleLastHead).Length() / afTimeStep;
+		mvVRGentleLastHead = vHead;
+		mfVRGentleHeadSpeed += (fHeadSpeed - mfVRGentleHeadSpeed) * afTimeStep / (0.05f + afTimeStep);
+		mfVRGentleTopHead = cMath_Max(mfVRGentleTopHead, mfVRGentleHeadSpeed);
+		mfVRGentleFastAgo = mfVRGentleHeadSpeed > gfVRGentleStopFast ? 0.0f : mfVRGentleFastAgo + afTimeStep;
+		mfVRGentleBlinkAgo += afTimeStep;
+		if(bMove && mfVRGentleHeadSpeed < gfVRGentleStopSlow && mfVRGentleFastAgo < gfVRGentleStopWithin && mfVRGentleBlinkAgo > 0.6f)
+		{
+			Log("BunkerVR: gentle view " + mlVRGentleCount + ": a blink at " + BunkerVR_Fixed(mfVRGentleTime, 2) + " s (the head down to " + BunkerVR_Fixed(mfVRGentleHeadSpeed, 1) + " m/s, " + BunkerVR_Fixed(mfVRGentleFastAgo, 2) + " s after it was above " + BunkerVR_Fixed(gfVRGentleStopFast, 1) + ")\n");
+			mfVRGentleBlinkAgo = 0.0f;
+			mfVRGentleFastAgo = 100.0f;
+			mlVRGentleBlinks++;
+		}
+		mfVRGentleDark = mfVRGentleBlinkAgo < gfVRGentleBlinkDark ? 1.0f : cMath_Max(0.0f, 1.0f - (mfVRGentleBlinkAgo - gfVRGentleBlinkDark) / gfVRGentleBlinkClear);
+
+		// The view follows the head as a soft spring.
+		cVector3f vVelAfter;
+		mvVRGentlePos = BunkerVR_SpringFollow(mvVRGentlePos, mvVRGentleVel, vHead, gfVRGentleSpring, afTimeStep, vVelAfter);
+		mvVRGentleVel = vVelAfter;
+		cVector3f vView = mvVRGentlePos;
+		mfVRGentleMostLag = cMath_Max(mfVRGentleMostLag, (vHead - mvVRGentlePos).Length());
+
+		// Over: back to where the game puts the view, eased.
+		if(bMove == false)
+		{
+			if(mfVRGentleBack < 0.0f)
+			{
+				// The body is shown again now, not after the return: outside
+				// the game's cutscene code, which keeps a hidden body's bones
+				// up to date, the view's place on the head could stand still.
+				mfVRGentleBack = 0.0f;
+				int lShown = VRGentleHide(false);
+				Log("BunkerVR: gentle view " + mlVRGentleCount + ": the move is over at " + BunkerVR_Fixed(mfVRGentleTime, 2) + " s; " + lShown + " thing(s) shown again; easing back from " + BunkerVR_Fixed((vHead - mvVRGentlePos).Length() * 100.0f, 0) + " cm\n");
+			}
+			mfVRGentleBack += afTimeStep;
+			vView = vView + (vHead - vView) * BunkerVR_SmoothStep(0.0f, gfVRGentleEaseBack, mfVRGentleBack);
+		}
+
+		// The dark ring, closed further as the view goes faster.
+		float fViewSpeed = mvVRGentleVel.Length();
+		mfVRGentleTopView = cMath_Max(mfVRGentleTopView, fViewSpeed);
+		float fRing = BunkerVR_SmoothStep(gfVRGentleRingSlow, gfVRGentleRingFast, fViewSpeed);
+		mfVRGentleRing = cMath_IncreaseTo(mfVRGentleRing, afTimeStep * (fRing > mfVRGentleRing ? 6.0f : 2.0f), fRing);
+
+		mfVRGentleNoteWait -= afTimeStep;
+		if(mlVRGentleCount <= 3 && mfVRGentleNoteWait <= 0.0f)
+		{
+			mfVRGentleNoteWait = 0.1f;
+			Log("BunkerVR: gentle view " + mlVRGentleCount + " at " + BunkerVR_Fixed(mfVRGentleTime, 2) + " s: the head " + BunkerVR_Fixed(mfVRGentleHeadSpeed, 1) + " m/s, the view " + BunkerVR_Fixed(fViewSpeed, 1) + " m/s and " + BunkerVR_Fixed((vHead - vView).Length() * 100.0f, 0) + " cm behind, the ring " + BunkerVR_Fixed(mfVRGentleRing, 2) + (mfVRGentleDark > 0.0f ? ", dark " + BunkerVR_Fixed(mfVRGentleDark, 2) : "") + (bMove ? "" : " (returning)") + "\n");
+		}
+
+		if(bMove == false && mfVRGentleBack >= gfVRGentleEaseBack)
+		{
+			// Done: the view is the game's own again (vHead, as placed).
+			mbVRGentle = false;
+			mfVRGentleRing = 0.0f;
+			mfVRGentleDark = 0.0f;
+			cVR_ComfortRing(0.0f);
+			VRGentleHide(false); // (shown already as the move ended: nothing is left)
+			Log("BunkerVR: gentle view " + mlVRGentleCount + " over after " + BunkerVR_Fixed(mfVRGentleTime, 2) + " s: " + mlVRGentleBlinks + " blink(s); the head's top speed " + BunkerVR_Fixed(mfVRGentleTopHead, 1) + " m/s, the view's " + BunkerVR_Fixed(mfVRGentleTopView, 1) + "; the view at most " + BunkerVR_Fixed(mfVRGentleMostLag * 100.0f, 0) + " cm behind\n");
+			return;
+		}
+		cVR_ComfortRing(mfVRGentleRing);
+		apCam.SetPosition(vView);
+	}
+
+	// BunkerVR: hides the body and everything hung on it (what the hands hold,
+	// the game's lighter, a healing item; the body's own list, asked of it by
+	// _Global_VRGetAttachedProp in Prop_PlayerBody.hps), noting each it hid;
+	// or shows those again, if they are still there (VRGentleView).
+	// What was already hidden is left as it is. The game's cutscene code copes
+	// with a hidden body (it shows it for a moment to move its bones); outside
+	// it the body is shown again. Gives how many it hid, or showed again.
+	int VRGentleHide(bool abHide)
+	{
+		if(abHide == false)
+		{
+			int lShown = 0;
+			for(uint i = 0; i < mvVRGentleHidden.length(); ++i)
+			{
+				iLuxEntity@ pThing = cLux_ID_Entity(mvVRGentleHidden[i]);
+				if(pThing is null || pThing.GetMeshEntity() is null) continue;
+				pThing.GetMeshEntity().SetVisible(true);
+				lShown++;
+			}
+			mvVRGentleHidden.resize(0);
+			return lShown;
+		}
+
+		mvVRGentleHidden.resize(0);
+		iLuxEntity@ pBody = cLux_ID_Entity(m_idBody);
+		if(pBody is null) return 0;
+		array<iLuxEntity@> vThings = { pBody };
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		for(int i = 0; i < 16 && pMap !is null; ++i)
+		{
+			cScript_SetGlobalArgInt(0, i);
+			cScript_SetGlobalReturnString("");
+			cScript_RunGlobalFunc(pBody.GetName(), "cScrPropPlayerBody", "_Global_VRGetAttachedProp");
+			tString sName = cScript_GetGlobalReturnString();
+			if(sName != "") vThings.push_back(pMap.GetEntityByName(sName));
+		}
+		for(uint i = 0; i < vThings.length(); ++i)
+		{
+			iLuxEntity@ pThing = vThings[i];
+			if(pThing is null || pThing.GetMeshEntity() is null || pThing.GetMeshEntity().IsVisible() == false) continue;
+			pThing.GetMeshEntity().SetVisible(false);
+			mvVRGentleHidden.push_back(pThing.GetID());
+		}
+		return int(mvVRGentleHidden.length());
+	}
+
+	// BunkerVR: buzzes a controller (0 left, 1 right) for so many seconds (at
+	// most 1), so strongly (0 to 1); the menu's vibration setting scales it.
+	void VRBuzzHand(int alHand, float afSeconds, float afStrength)
+	{
+		cCamera@ pCam = cLux_GetPlayer().GetCamera();
+		if(pCam is null) return;
+		float fRealRoll = pCam.GetRoll();
+		cVector3f vRealPos = pCam.GetPosition();
+		pCam.SetPosition(cVector3f(float(alHand), afSeconds, afStrength));
+		pCam.SetRoll(7064.0f);
+		pCam.GetMatrix();
+		pCam.SetPosition(vRealPos);
+		pCam.SetRoll(fRealRoll);
+	}
+
+	// BunkerVR: the Beast page's moves, counted down here: each
+	// starts when its wait is over (VRBeastTestStart); a test kill then waits
+	// for its animation and ends in the game's own death (VRBeastTestKillEnd).
+	void VRUpdateBeastTest(float afTimeStep)
+	{
+		// The Beast just put in front: a stand-in if it is switched off
+		// (VRBeastStandIn). And a stand-in's throw over: it stands idle.
+		if(mfVRBeastBodyCheck >= 0.0f)
+		{
+			mfVRBeastBodyCheck -= afTimeStep;
+			if(mfVRBeastBodyCheck < 0.0f)
+				VRBeastStandIn("VRTestBeast", mvVRBeastBodyPos, mfVRBeastBodyYaw, "idle_stalk", true);
+		}
+		if(mfVRBeastBodyAnimLeft >= 0.0f)
+		{
+			mfVRBeastBodyAnimLeft -= afTimeStep;
+			cLuxMap@ pMap = cLux_GetCurrentMap();
+			iLuxEntity@ pBody = pMap !is null ? pMap.GetEntityByName(gsVRBeastBodyName) : null;
+			if(mfVRBeastBodyAnimLeft < 0.0f && pBody !is null)
+				pBody.PlayAnimation("idle_stalk", 0.5f, true);
+		}
+
+		if(mlVRBeastTest == 0 && mbVRBeastKillPlaying == false) return;
+		mfVRBeastTestWait -= afTimeStep;
+		if(mfVRBeastTestWait > 0.0f) return;
+		if(mbVRBeastKillPlaying)
+		{
+			mbVRBeastKillPlaying = false;
+			VRBeastTestKillEnd();
+			return;
+		}
+		int lTest = mlVRBeastTest;
+		mlVRBeastTest = 0;
+		VRBeastTestStart(lTest);
+	}
+
+	// BunkerVR: the Beast kept out of the level, so that the menu's Places page can jump to parts of
+	// the game safe from it (cVR_BeastAway, which says so only after a jump, when nothing is saved).
+	// While it says so, every half second the level's Beasts (the game's cScrAgentStalker; not the
+	// Beast page's own test Beast) are switched off, each noted with the level; once it stops saying
+	// so, those still in this level are switched on
+	// again (a Beast left in another level stays off there: nothing of a jumped game is saved). Not
+	// while a knockdown, a kill or a death plays. The Beast page's kills then play with its stand-in.
+	void VRUpdateBeastAway(float afTimeStep)
+	{
+		mfVRBeastAwayWait -= afTimeStep;
+		if(mfVRBeastAwayWait > 0.0f) return;
+		mfVRBeastAwayWait = 0.5f;
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		if(pMap is null) return;
+		if(msVRBeastAwayMap != pMap.GetName())
+		{
+			mvVRBeastAwayNames.resize(0);
+			msVRBeastAwayMap = pMap.GetName();
+		}
+		bool bAway = cVR_BeastAway();
+		if(bAway)
+		{
+			if(mlVRRoughKind != 0) return;
+			array<iLuxEntity@> vEnts;
+			pMap.GetEntityArray("*", eLuxEntityType_Agent, "cScrAgentStalker", vEnts);
+			for(uint i = 0; i < vEnts.length(); ++i)
+			{
+				if(vEnts[i] is null || vEnts[i].GetName() == "VRTestBeast" || vEnts[i].IsActive() == false) continue;
+				vEnts[i].SetActive(false);
+				if(mvVRBeastAwayNames.find(vEnts[i].GetName()) < 0) mvVRBeastAwayNames.insertLast(vEnts[i].GetName());
+				Log("BunkerVR: the Beast " + vEnts[i].GetName() + " is kept out of " + pMap.GetName() + " (switched off: the Places page)\n");
+			}
+			return;
+		}
+		for(uint i = 0; i < mvVRBeastAwayNames.length(); ++i)
+		{
+			iLuxEntity@ pBeast = pMap.GetEntityByName(mvVRBeastAwayNames[i]);
+			if(pBeast is null || pBeast.IsActive()) continue;
+			pBeast.SetActive(true);
+			Log("BunkerVR: the Beast " + mvVRBeastAwayNames[i] + " is back in " + pMap.GetName() + " (switched on again)\n");
+		}
+		mvVRBeastAwayNames.resize(0);
+	}
+
+	// BunkerVR: is a Beast of the game's (cScrAgentStalker) in the level? The
+	// game's thrown state looks for one the same way, and without one it
+	// never ends. If there is none, the test Beast is made at avPlace (as the
+	// Tools page's test command 26 makes it), to be used from
+	// a later update, once it is set up. asName: the Beast to use, the test
+	// Beast if there is one.
+	bool VRBeastTestReady(const cVector3f &in avPlace, tString &out asName)
+	{
+		asName = "";
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		if(pMap is null) return false;
+		array<iLuxEntity@> vEnts;
+		pMap.GetEntityArray("*", eLuxEntityType_Agent, "cScrAgentStalker", vEnts);
+		for(uint i = 0; i < vEnts.length(); ++i)
+		{
+			if(vEnts[i] is null) continue;
+			if(asName == "" || vEnts[i].GetName() == "VRTestBeast") asName = vEnts[i].GetName();
+		}
+		if(asName != "") return true;
+		if(pMap.GetEntityByName("VRTestBeast") is null)
+			pMap.CreateEntity("VRTestBeast", "stalker.ent", cMath_MatrixTranslate(avPlace + cVector3f(0.0f, 0.3f, 0.0f)), cVector3f(1.0f, 1.0f, 1.0f));
+		return false;
+	}
+
+	// BunkerVR: the Beast page's stand-in. In a map without the AI's path
+	// nodes (the mod's test maps have none) the game's Beast switches itself
+	// off as it starts (agent_stalker.hps OnStart: "No path nodes found"), so
+	// it is there for the game's thrown state but never seen. A still Beast
+	// then stands in for it: gsVRBeastBodyFile, the game's stalker_static.ent
+	// (the Beast's look, with no AI and nothing to bump into) with the Beast's
+	// own idle, throws and kills from stalker.ent, kept in the item test map's
+	// entities folder and in entities\bunkervr, so that it can also be made in
+	// levels where the game's Beast is not out yet (the safe room). It is put
+	// at avPos (on the floor),
+	// turned to afYaw (the game's yaw, as the camera's: the Beast's model and
+	// the player's both face +Z, and the player's body is drawn turned by pi
+	// plus its yaw, so the same here), and plays asAnim (looped if abLoop).
+	// Made the first time. False when the Beast asBeast is on (it is seen
+	// itself) or gone, or the stand-in cannot be made.
+	bool VRBeastStandIn(const tString &in asBeast, const cVector3f &in avPos, float afYaw, const tString &in asAnim, bool abLoop)
+	{
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		if(pMap is null) return false;
+		iLuxEntity@ pBeast = pMap.GetEntityByName(asBeast);
+		if(pBeast is null || pBeast.IsActive()) return false;
+
+		cMatrixf mtxPlace = cMath_MatrixRotateY(cMath_Pi + afYaw);
+		mtxPlace.SetTranslation(avPos);
+		iLuxEntity@ pBody = pMap.GetEntityByName(gsVRBeastBodyName);
+		if(pBody is null)
+		{
+			pMap.CreateEntity(gsVRBeastBodyName, gsVRBeastBodyFile, mtxPlace, cVector3f(1.0f, 1.0f, 1.0f));
+			@pBody = pMap.GetEntityByName(gsVRBeastBodyName);
+			if(pBody is null)
+			{
+				if(mbVRBeastBodyMissingLogged == false)
+					Log("BunkerVR: Beast page: the Beast is switched off in this map, and its stand-in (" + gsVRBeastBodyFile + ") could not be made: it is not seen\n");
+				mbVRBeastBodyMissingLogged = true;
+				return false;
+			}
+			Log("BunkerVR: Beast page: the Beast is switched off in this map: a still Beast stands in for it\n");
+		}
+		else
+		{
+			pBody.SetMatrix(mtxPlace);
+		}
+		pBody.PlayAnimation(asAnim, 0.2f, abLoop);
+
+		// A move (not looped): back to its idle when it is over (VRUpdateBeastTest).
+		mfVRBeastBodyAnimLeft = -1.0f;
+		if(abLoop == false)
+		{
+			cMeshEntity@ pMesh = pBody.GetMeshEntity();
+			cAnimationState@ pAnim = pMesh !is null ? pMesh.GetAnimationStateFromName(asAnim) : null;
+			mfVRBeastBodyAnimLeft = pAnim !is null ? pAnim.GetLength() : 2.0f;
+		}
+		return true;
+	}
+
+	// BunkerVR: starts one of the Beast page's moves, each as the game itself
+	// starts it, facing the way the player looks:
+	//   44 thrown by the Beast, facing it   45 thrown by it from behind
+	//   46 a big fall                       47 hit by a shotgun
+	//   48 killed by the Beast from behind  49 killed by it from the front
+	//   50 an ordinary death (the game's die_fall)
+	//   51 killed through a hole            52 killed while hiding
+	//   53 killed on a ladder
+	// Nothing is hurt by the knockdowns; the kills and the death end in the
+	// game's own death: the game over (the last save loaded) or, in the mod's
+	// test maps, the level started again, as dying there does.
+	void VRBeastTestStart(int alTest)
+	{
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		cCamera@ pCam = pPlayer !is null ? pPlayer.GetCamera() : null;
+		iCharacterBody@ pCharBody = pPlayer !is null ? pPlayer.GetCharacterBody() : null;
+		if(pCam is null || pCharBody is null) return;
+		bool bStateOk = pPlayer.GetCurrentStateId() == ePlayerState_Normal || (alTest == 53 && pPlayer.GetCurrentStateId() == ePlayerState_Ladder);
+		if(bStateOk == false || mbCameraAnimation_Active || IsActive() == false)
+		{
+			Log("BunkerVR: Beast page: test " + alTest + " not started: the player is busy (state " + pPlayer.GetCurrentStateId() + ")" +
+				(alTest == 53 ? ": the ladder kill is only on a ladder" : "") + "\n");
+			return;
+		}
+
+		// The way the player looks, level, and the game's angle for a player
+		// facing that way (as agent_stalker.hps works it out).
+		cVector3f vAhead = pCam.GetForward();
+		vAhead.y = 0.0f;
+		if(vAhead.Length() < 0.01f) return;
+		vAhead = cMath_Vector3Normalize(vAhead);
+		cVector3f vFeet = pCharBody.GetFeetPosition();
+		float fFacing = cMath_GetAngleFromPoints3D(cVector3f(0.0f), vAhead).y;
+
+		if(alTest == 44 || alTest == 45 || alTest == 48 || alTest == 49)
+		{
+			// The Beast: 2.5 m ahead (44), 2.5 m behind (45), 1.4 m behind (48)
+			// or 2.425 m ahead (49), as the game places it. If it first has
+			// to be made, the move waits a quarter of a second more (three
+			// times at most).
+			float fBeastAhead = alTest == 44 ? 2.5f : (alTest == 45 ? -2.5f : (alTest == 48 ? -1.4f : 2.425f));
+			cVector3f vBeast = vFeet + vAhead * fBeastAhead;
+			tString sBeast = "";
+			if(VRBeastTestReady(vBeast, sBeast) == false)
+			{
+				mlVRBeastTries++;
+				if(mlVRBeastTries > 3)
+				{
+					Log("BunkerVR: Beast page: test " + alTest + " not started: no Beast of the game's in the level\n");
+					return;
+				}
+				mlVRBeastTest = alTest;
+				mfVRBeastTestWait = 0.25f;
+				return;
+			}
+
+			// The way the Beast faces: towards the player, as the game turns
+			// it (ThrowPlayer_DoThrow, State_KillPlayer): from ahead (44, 49)
+			// back the way the player looks; from behind (45, 48) the same way.
+			float fBeastYaw = (alTest == 44 || alTest == 49) ? fFacing + cMath_Pi : fFacing;
+
+			if(alTest == 44 || alTest == 45)
+			{
+				// As the Beast's throw (ThrowPlayer_DoThrow), without its own
+				// animation: the game's thrown state, the player facing the Beast
+				// (the "forward" throw, 0) or with it behind ("behind player", 4).
+				// A Beast switched off in this map: its stand-in throws, there
+				// and then, as the Beast's own would.
+				VRBeastStandIn(sBeast, vBeast, fBeastYaw, alTest == 44 ? "throw_forward_stand" : "throw_behind_player_stand", false);
+				cScript_SetGlobalArgInt(0, alTest == 44 ? 0 : 4);
+				cScript_SetGlobalArgVector3f(1, vFeet);
+				cScript_SetGlobalArgFloat(2, fFacing);
+				cScript_SetGlobalArgVector3f(3, vBeast);
+				cScript_SetGlobalArgBool(4, false);
+				cScript_SetGlobalArgFloat(5, 0.3f);
+				cScript_RunGlobalFunc("State_Thrown", "", "_Global_Setup");
+				Log("BunkerVR: Beast page: thrown " + (alTest == 44 ? "facing the Beast" : "from behind") + " (" + sBeast + ")\n");
+				return;
+			}
+
+			// As the Beast's kill (State_KillPlayer_Enter): VRBeastTestKill.
+			bool bFront = alTest == 49;
+			VRBeastTestKill(sBeast, vBeast, fBeastYaw, bFront ? "death_front" : "death_back", 0.3f, vFeet, fFacing,
+							bFront ? "player_death_front" : "player_death_back", bFront ? "from the front" : "from behind");
+			return;
+		}
+
+		if(alTest == 51 || alTest == 52 || alTest == 53)
+		{
+			// The kills through a hole, while hiding and on a ladder, each placed as the Beast's own kill places it
+			// (State_KillPlayer_Enter).
+			cLuxMap@ pMap = cLux_GetCurrentMap();
+			if(pMap is null) return;
+			cVector3f vBeast = vFeet;
+			cVector3f vPlayerAt = vFeet;
+			float fBeastYaw = fFacing;
+			float fPlayerYaw = fFacing;
+			float fBeastFade = 0.3f;
+			tString sBeastAnim = "";
+			tString sPlayerAnim = "";
+			tString sWhat = "";
+			if(alTest == 51)
+			{
+				// 51: through a hole. The hole nearest the player of the level's (the Beast's GhoulHole_ areas), and
+				// which way the player faces it: the hole's own four kills, the player put 0.439 m out from its foot
+				// and the Beast 2.382 m back from there, inside the wall, as the game puts them.
+				array<iLuxEntity@> vHoles;
+				pMap.GetEntityArray("GhoulHole_*", eLuxEntityType_Area, "", vHoles);
+				cLuxArea@ pHole = null;
+				float fNearest = 100000.0f;
+				for(uint i = 0; i < vHoles.length(); ++i)
+				{
+					if(vHoles[i] is null) continue;
+					float fGap = (vHoles[i].GetPosition() - vFeet).Length();
+					if(fGap >= fNearest) continue;
+					cLuxArea@ pArea = cLux_ID_Area(vHoles[i].GetID());
+					if(pArea is null || pArea.GetAreaBody() is null) continue;
+					fNearest = fGap;
+					@pHole = pArea;
+				}
+				if(pHole is null)
+				{
+					Log("BunkerVR: Beast page: test 51 not started: no hole of the Beast's (GhoulHole_) in this level\n");
+					return;
+				}
+				cMatrixf mtxHole = pHole.GetMatrix().GetTranspose();
+				cVector3f vHoleFwd = mtxHole.GetForward();
+				cVector3f vHoleRight = mtxHole.GetRight();
+				float fFwdDot = cMath_Vector3Dot(vAhead, vHoleFwd);
+				float fRightDot = cMath_Vector3Dot(vAhead, vHoleRight) * -1.0f;
+				tString sDir = cMath_Abs(fFwdDot) > cMath_Abs(fRightDot) ? (fFwdDot > 0.0f ? "back" : "front") : (fRightDot > 0.0f ? "right" : "left");
+				cVector3f vOffset = cVector3f(0.0f);
+				if(sDir == "right") vOffset = vHoleRight * 0.15f;
+				else if(sDir == "left") vOffset = vHoleRight * -0.15f;
+				else if(sDir == "front") vOffset = vHoleRight * 0.05f + vHoleFwd * 0.15f;
+				else vOffset = vHoleRight * -0.05f + vHoleFwd * 0.15f;
+				cVector3f vGround = pHole.GetPosition() + vHoleFwd * -0.25f;
+				vGround.y = pHole.GetAreaBody().GetBoundingVolume().GetMin().y;
+				vPlayerAt = vGround + vHoleFwd * 0.439f + vOffset;
+				fPlayerYaw = cMath_GetAngleFromPoints3D(cVector3f(0.0f), vHoleFwd).y;
+				fBeastYaw = fPlayerYaw; // (the Beast turned the hole's way as it is put at it: PositionAtGhoulHole)
+				vBeast = vPlayerAt + vHoleFwd * -2.382f;
+				if(sDir == "front") fPlayerYaw += cMath_Pi;
+				else fBeastFade = 0.0f;
+				sBeastAnim = "death_hole_" + sDir;
+				sPlayerAnim = "player_death_hole_" + sDir;
+				sWhat = "through " + pHole.GetName() + " (" + sDir + ", the hole " + BunkerVR_Fixed(fNearest, 1) + " m off)";
+				// The Beast kills through a hole only a player beside it. Further off, the player is put there first,
+				// facing as now, and the kill starts a moment later: otherwise the move can be long (several meters)
+				// and the kill's blink for so far a move hides its start.
+				cVector3f vToSpot = vPlayerAt - vFeet;
+				vToSpot.y = 0.0f;
+				if(vToSpot.Length() > 1.0f && mbVRBeastHoleMoved == false)
+				{
+					mbVRBeastHoleMoved = true;
+					pCharBody.SetFeetPosition(vPlayerAt + cVector3f(0.0f, 0.05f, 0.0f), false); // (on the hole's own floor, as the kill puts the player)
+					mlVRBeastTest = 51;
+					mfVRBeastTestWait = 1.5f;
+					Log("BunkerVR: Beast page: test 51: the player put beside " + pHole.GetName() + " first (" + BunkerVR_Fixed(vToSpot.Length(), 1) + " m), the kill in a moment\n");
+					return;
+				}
+				mbVRBeastHoleMoved = false;
+			}
+			else if(alTest == 52)
+			{
+				// 52: hiding (under a bed, a table). The hiding place's own kill: the player where the place is, the
+				// Beast 2.5 m off along its kill's line, from the side the Beast comes (here the way the player looks).
+				tID idArea = Player_GetCurrentHideArea();
+				cLuxArea@ pArea = cLux_ID_Area(idArea);
+				if(pArea is null || pArea.GetAreaBody() is null)
+				{
+					Log("BunkerVR: Beast page: test 52 not started: the player is not hiding (under a bed or a table)\n");
+					return;
+				}
+				cVector3f vAreaPos = pArea.GetPosition();
+				vAreaPos.y = pArea.GetAreaBody().GetBoundingVolume().GetMin().y;
+				cMatrixf mtxArea = pArea.GetMatrix().GetTranspose();
+				int lAxis = Player_GetCurrentHideAreaAnimKillDir();
+				cVector3f vKillDir = lAxis == eAxis3D_X ? mtxArea.GetRight() : (lAxis == eAxis3D_Y ? mtxArea.GetUp() : mtxArea.GetForward());
+				cVector3f vToArea = vAreaPos - (vFeet + vAhead * 2.0f);
+				if(cMath_Vector3Dot(vKillDir, vToArea) > 0.0f)
+				{
+					vBeast = vAreaPos + vKillDir * -2.5f;
+					fBeastYaw = cMath_GetAngleFromPoints3D(cVector3f(0.0f), vKillDir).y;
+				}
+				else
+				{
+					vBeast = vAreaPos + vKillDir * 2.5f;
+					fBeastYaw = cMath_GetAngleFromPoints3D(cVector3f(0.0f), vKillDir * -1.0f).y;
+				}
+				fPlayerYaw = fBeastYaw + cMath_Pi;
+				vPlayerAt = vAreaPos;
+				sBeastAnim = "death_under";
+				sPlayerAnim = "player_death_under";
+				sWhat = "while hiding (" + pArea.GetName() + ")";
+			}
+			else
+			{
+				// 53: on a ladder. Below the ladder's foot, as the game has it: the player 0.555 m out along the ladder,
+				// at the ground under the feet (found down to 5 m when off the ground), the Beast 1.224 m further.
+				cScript_RunGlobalFunc("State_Ladder", "", "_Global_GetLadderAreaPos");
+				cVector3f vLadderPos = cScript_GetGlobalReturnVector3f();
+				cScript_RunGlobalFunc("State_Ladder", "", "_Global_GetYaw");
+				float fLadderYaw = cScript_GetGlobalReturnFloat();
+				cVector3f vGroundFeet = vFeet;
+				if(pCharBody.IsOnGround() == false)
+				{
+					float fDown = 0.0f;
+					cVector3f vNormal;
+					cLux_GetClosestBody(vFeet, cVector3f(0.0f, -1.0f, 0.0f), 5.0f, fDown, vNormal);
+					if(fDown < 5.0f) vGroundFeet.y -= fDown;
+				}
+				cVector3f vLadderDir = cMath_MatrixMul(cMath_MatrixRotateY(fLadderYaw), cVector3f(0.0f, 0.0f, 1.0f));
+				vPlayerAt = vLadderPos + vLadderDir * 0.555f;
+				vPlayerAt.y = vGroundFeet.y;
+				vBeast = vPlayerAt + vLadderDir * 1.224f;
+				fPlayerYaw = fLadderYaw;
+				fBeastYaw = fLadderYaw;
+				sBeastAnim = "death_ladder";
+				sPlayerAnim = "player_death_ladder";
+				sWhat = "on a ladder";
+			}
+			tString sBeast = "";
+			if(VRBeastTestReady(vBeast, sBeast) == false)
+			{
+				mlVRBeastTries++;
+				if(mlVRBeastTries > 3)
+				{
+					Log("BunkerVR: Beast page: test " + alTest + " not started: no Beast of the game's in the level\n");
+					return;
+				}
+				mlVRBeastTest = alTest;
+				mfVRBeastTestWait = 0.25f;
+				return;
+			}
+			VRBeastTestKill(sBeast, vBeast, fBeastYaw, sBeastAnim, fBeastFade, vPlayerAt, fPlayerYaw, sPlayerAnim, sWhat);
+			return;
+		}
+
+		if(alTest == 46 || alTest == 47)
+		{
+			// As Player_Custom.hps plays them when the player is hurt (without
+			// the hurt): a big fall, or hit by the shotgun man.
+			if(alTest == 46)
+				PlayCutsceneAnimation("fall_and_get_up_quickly", false, 0.3f, "", 1.3f, 0.0f, false, cVector3f(0.0f), 0.0f, false, false);
+			else
+				PlayCutsceneAnimation(Player_GetCrouching() ? "player_shot_shotgun_crouched_1" : "player_shot_shotgun_1", false, 0.3f, "", 1.0f, 0.0f, false, cVector3f(0.0f), 0.0f, false, false);
+			Cutscene_SetMaxPitch(0.0f);
+			Cutscene_SetMaxYaw(0.0f);
+			Log("BunkerVR: Beast page: " + (alTest == 46 ? "a big fall" : "hit by a shotgun") + "\n");
+			return;
+		}
+
+		if(alTest == 50)
+		{
+			// An ordinary death, the game's own way: damage enough to die.
+			Log("BunkerVR: Beast page: an ordinary death\n");
+			pPlayer.GiveDamage(10.0f, 0, eDamageType_Default, 0.0f, tID_Invalid, -1);
+		}
+	}
+
+	// BunkerVR: a test kill, any of the Beast's kills, as the Beast's kill plays it (State_KillPlayer_Enter): the
+	// Beast's animation (asBeastAnim, faded in over afBeastFade) at avBeast turned to afBeastYaw, and the player's
+	// (asPlayerAnim) at avPlayer turned to afPlayerYaw, together, the camera's near clip at 1 cm (its face comes
+	// close). The end is at the player's animation's length less 0.1 s, as there. A Beast switched off in this map:
+	// its stand-in plays the kill instead (bunkervr_test_beast.ent has every kill). Where the Beast and the player are
+	// put, and which Beast, are said as the Beast's own kill says them (VRStartKillView). asWhat: for the log.
+	void VRBeastTestKill(const tString &in asBeast, const cVector3f &in avBeast, float afBeastYaw, const tString &in asBeastAnim, float afBeastFade,
+						 const cVector3f &in avPlayer, float afPlayerYaw, const tString &in asPlayerAnim, const tString &in asWhat)
+	{
+		cCamera@ pCam = cLux_GetPlayer().GetCamera();
+		if(pCam is null) return;
+		bool bStandIn = VRBeastStandIn(asBeast, avBeast, afBeastYaw, asBeastAnim, false);
+		if(bStandIn == false)
+		{
+			cScript_SetGlobalArgString(0, asBeastAnim);
+			cScript_SetGlobalArgBool(1, false);
+			cScript_SetGlobalArgFloat(2, afBeastFade);
+			cScript_SetGlobalArgString(3, "");
+			cScript_SetGlobalArgFloat(4, 1.0f);
+			cScript_SetGlobalArgFloat(5, 0.0f);
+			cScript_SetGlobalArgBool(6, true);
+			cScript_SetGlobalArgVector3f(7, avBeast);
+			cScript_SetGlobalArgFloat(8, afBeastYaw);
+			cScript_SetGlobalArgBool(9, false);
+			cScript_SetGlobalArgBool(10, false);
+			cScript_SetGlobalArgBool(11, false);
+			if(cScript_RunGlobalFunc(asBeast, "cScrAgentHumanoid", "_Global_Humanoid_PlayCutsceneAnimation") == false)
+				Log("BunkerVR: Beast page: the Beast (" + asBeast + ") could not play its kill\n");
+		}
+		cLuxMap@ pVRMap = cLux_GetCurrentMap();
+		iLuxEntity@ pKiller = pVRMap !is null ? pVRMap.GetEntityByName(bStandIn ? gsVRBeastBodyName : asBeast) : null;
+		cScript_SetGlobalVarVector3f("BunkerVR_KillBeastAt", avBeast);
+		cScript_SetGlobalVarVector3f("BunkerVR_KillPlayerAt", avPlayer);
+		cScript_SetGlobalVarID("BunkerVR_KillBeast", pKiller !is null ? pKiller.GetID() : tID_Invalid);
+		cScript_SetGlobalVarFloat("BunkerVR_KillTime", float(cEngine_GetGameTime()));
+
+		mfVRBeastNearClip = pCam.GetNearClipPlane();
+		pCam.SetNearClipPlane(0.01f);
+
+		PlayCutsceneAnimation(asPlayerAnim, false, 0.3f, "", 1.0f, 0.0f, true, avPlayer, afPlayerYaw, false, false);
+		float fEnd = 1.0f;
+		cAnimationState@ pAnim = GetAnimationState(asPlayerAnim);
+		if(pAnim !is null) fEnd = pAnim.GetLength() - 0.1f;
+		mbVRBeastKillPlaying = true;
+		mfVRBeastTestWait = fEnd;
+		Log("BunkerVR: Beast page: killed by the Beast " + asWhat + " (" + asBeast + (bStandIn ? ", its stand-in" : "") + "), " + fEnd + " s\n");
+	}
+
+	// BunkerVR: the end of a test kill, as the Beast's kill ends
+	// (State_KillPlayer_TimerUp): the view goes black and the near clip back.
+	// Then the game's own death, with no animation of its own (the kill's is
+	// still on the body), which ends in the game over or, in the mod's test
+	// maps, the level started again. (The death animation is then put back to
+	// die_fall, the game's only other one besides a gun's, which sets its own.)
+	void VRBeastTestKillEnd()
+	{
+		cLux_GetEffectHandler().FadeOut(0.1f); // (as Effect_Fade_Out(0.1f), which this script does not include)
+		cCamera@ pCam = cLux_GetPlayer().GetCamera();
+		if(pCam !is null && mfVRBeastNearClip > 0.0f) pCam.SetNearClipPlane(mfVRBeastNearClip);
+		mfVRBeastNearClip = 0.0f;
+		Death_SetDeathAnimation("");
+		Death_Start("Monster");
+		Death_SetDeathAnimation("die_fall");
+		Log("BunkerVR: Beast page: the test kill ends in the game's death\n");
+	}
+	
+	//------------------------------------------------------------
+	
+	// BunkerVR: the game's own body follows the player's real head.
+	// The game's body is the upright capsule that bumps into walls and doors,
+	// that a swinging door hits, and that the Beast hunts. In VR the view and
+	// the drawn body go wherever the real head goes, but left alone that
+	// capsule only moves with the stick: leaning or stepping leaves it behind.
+	// A door then hits it where the player doesn't stand, and with the head
+	// pushed through a door the view, the body and the door stop agreeing
+	// (an invisible barrier, the arms all wrong) until the view is re-centered.
+	// So the capsule is moved under the real neck, a step at a time
+	// (`gfVRFollowStep`), and only where it fits (CheckCharacterFits: a wall
+	// or a shut door stops it, as walking would). The drawn body and the
+	// camera are placed by the room, not by the capsule: they are put back by
+	// all that the capsule has been moved this way (`mvVRFollow`), so
+	// following never moves the view.
+	// Where the capsule cannot follow (the head in or through a wall or a
+	// door, or too far beyond the body), the view is darkened, to black
+	// (`mfVRHeadFade`, sent with the game's own fade): nothing can be seen
+	// through walls. Black for `gfVRHeadReturnTime`, the view is brought back
+	// to the body, as re-centering does.
+	void VRFollowHead(float afTimeStep)
+	{
+		if(afTimeStep <= 0.0f) return;
+		mbVRLegsOk = false;
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		iCharacterBody@ pCharBody = pPlayer !is null ? pPlayer.GetCharacterBody() : null;
+		cCamera@ pCam = pPlayer !is null ? pPlayer.GetCamera() : null;
+		if(pCharBody is null || pCam is null) return;
+
+		// A teleport of the game's body (see gfVRTeleportMoved): how far it went since the last update, counted
+		// only when that update followed the head as in play (not a camera animation, a ladder or a state the body
+		// does not follow in: those place the body themselves).
+		cVector3f vFeetNow = pCharBody.GetFeetPosition();
+		cVector3f vFeetMoved = vFeetNow - mvVRFollowLastFeet;
+		vFeetMoved.y = 0.0f;
+		bool bTeleported = mbVRFollowWasNormal && mbVRFollowLastFeetKnown && vFeetMoved.Length() > gfVRTeleportMoved;
+		mvVRFollowLastFeet = vFeetNow;
+		mbVRFollowLastFeetKnown = true;
+		mbVRFollowWasNormal = false;
+		VRTeleportWatch(afTimeStep);
+
+		// In a camera animation the game places the body and the view itself.
+		if(mbCameraAnimation_Active)
+		{
+			mvVRFollow = cVector3f(0);
+			mfVRHeadFade = 0.0f;
+			mfVRHeadBlackTime = 0.0f;
+			return;
+		}
+
+		// The real head (7006: is it tracked? 7005: where).
+		float fRealRoll = pCam.GetRoll();
+		pCam.SetRoll(7006.0f);
+		cVector3f vStatus = pCam.GetMatrix().GetTranslation();
+		bool bHead = vStatus.x > 12344.0f && vStatus.x < 12346.0f && vStatus.y > 0.5f;
+		cMatrixf mtxHead = cMatrixf_Identity;
+		if(bHead)
+		{
+			pCam.SetRoll(7005.0f);
+			mtxHead = pCam.GetMatrix();
+		}
+		pCam.SetRoll(fRealRoll);
+
+		int lState = pPlayer.GetCurrentStateId();
+		bool bStateOk = VRFollowStateOk(lState);
+		// (The drawn legs may be placed now: see UpdateVRLegs in Prop_PlayerBody.hps.
+		// In a few more states than the body follows the head: VRLegsStateOk.)
+		mbVRLegsOk = bHead && VRLegsStateOk(lState) && Player_GetCrawling() == false;
+		// (On a ladder: nothing here; the view is put over the body and darkened near the rungs
+		// once the camera is placed, VRLadderHead. Here the camera is still where the
+		// game puts it each update on a ladder, over its body, not where the view is.)
+		if(lState == ePlayerState_Ladder)
+		{
+			mfVRHeadBlackTime = 0.0f;
+			return;
+		}
+		if(bHead == false || bStateOk == false)
+		{
+			mfVRHeadFade = cMath_Max(mfVRHeadFade - afTimeStep * gfVRHeadFadeOutSpeed, 0.0f);
+			mfVRHeadBlackTime = 0.0f;
+			return;
+		}
+		cVector3f vHead = mtxHead.GetTranslation();
+		cVector3f vNeck = vHead - cMath_MatrixMul3x3(mtxHead, cVector3f(0.0f, gfVRNeckToEyesUp, -gfVRNeckToEyesForward));
+
+		// (Always, but not while crawling.)
+		bool bFollow = Player_GetCrawling() == false;
+
+		/////////////////////////////
+		// The game's body goes under the neck, where it fits.
+		cVector3f vFeet = pCharBody.GetFeetPosition();
+
+		// The room's offset from the game's body, mvVRFollow, grows as the player walks about the real room and the
+		// body follows. OnMapEnter clears it on a map change, and the first update here in the new map puts the view
+		// over the body at once, as gfVRHeadReturnTime's return does. Otherwise the view, and the drawn body it hangs
+		// on, would come into the next map that far from the start spot, into a wall if one is that way. The main
+		// menu's jumps also center the view in the mod; the game's own map changes do not.
+		// After a teleport of the game's body: gfVRTeleportWait without darkening or following, while the head is
+		// still read where the camera was before; then the view is put over the body, as on a new map, below.
+		mbVRFollowWasNormal = true;
+		if(bTeleported)
+		{
+			mfVRTeleportWait = gfVRTeleportWait;
+			mfVRTeleportWatch = gfVRTeleportWatch;
+			mfVRTeleportDarkest = 0.0f;
+			mfVRTeleportMoved = vFeetMoved.Length();
+			mbVRFollowArriveTeleport = true;
+		}
+		if(mfVRTeleportWait > 0.0f)
+		{
+			mfVRTeleportWait -= afTimeStep;
+			mfVRHeadFade = cMath_Max(mfVRHeadFade - afTimeStep * gfVRHeadFadeOutSpeed, 0.0f);
+			mfVRHeadBlackTime = 0.0f;
+			if(mfVRTeleportWait <= 0.0f) mbVRFollowArrive = true;
+			mvVRWalkFeet = vFeet;
+			return;
+		}
+
+		if(mbVRFollowArrive)
+		{
+			mbVRFollowArrive = false;
+			cVector3f vArriveOff = vNeck - vFeet;
+			vArriveOff.y = 0.0f;
+			mvVRFollow = mvVRFollow + vArriveOff;
+			if(mlVRArriveNotes < 20)
+			{
+				mlVRArriveNotes++;
+				cVector3f vLast = mvVRFollowLastMap;
+				vLast.y = 0.0f;
+				if(mbVRFollowArriveTeleport)
+					Log("BunkerVR: after the game's body was moved " + int(mfVRTeleportMoved + 0.5f) + " m at once (a jump in the level, or the game placing the player), the view is put over the body (the neck was " +
+						int(vArriveOff.Length() * 100.0f + 0.5f) + " cm off it)\n");
+				else
+					Log("BunkerVR: in a new map, the view is put over the body (the neck was " + int(vArriveOff.Length() * 100.0f + 0.5f) +
+						" cm off it; the last map's offset, " + int(vLast.Length() * 100.0f + 0.5f) + " cm, cleared)\n");
+			}
+			mbVRFollowArriveTeleport = false;
+			mvVRWalkFeet = vFeet;
+			return;
+		}
+		VRWalkCheck(pCam, pCharBody, mtxHead, vFeet, afTimeStep); // for the log
+		cVector3f vOff = vNeck - vFeet;
+		vOff.y = 0.0f;
+		if(bFollow && vOff.Length() > gfVRFollowStart)
+		{
+			cVector3f vStep = vOff;
+			if(vStep.Length() > gfVRFollowStep) vStep = cMath_Vector3Normalize(vStep) * gfVRFollowStep;
+			int lSize = pCharBody.GetActiveSize();
+			cVector3f vPush = cVector3f(0.0f);
+			cVector3f vTo = vFeet + vStep;
+			bool bFits = pCharBody.CheckCharacterFits(vTo, true, lSize, vPush);
+			if(bFits == false)
+			{
+				// Along what is in the way: the check says which way is out.
+				vPush.y = 0.0f;
+				if(vPush.Length() > 0.0001f && vPush.Length() < 0.1f)
+				{
+					vTo = vTo + vPush;
+					bFits = pCharBody.CheckCharacterFits(vTo, true, lSize, vPush);
+				}
+			}
+			if(bFits == false)
+			{
+				// Half the step, straight.
+				vTo = vFeet + vStep * 0.5f;
+				bFits = pCharBody.CheckCharacterFits(vTo, true, lSize, vPush);
+			}
+			if(bFits)
+			{
+				cVector3f vMoved = vTo - vFeet;
+				vMoved.y = 0.0f;
+				vTo = vFeet + vMoved;
+				pCharBody.SetFeetPosition(vTo, false);
+				// The drawn body's smoothing (in UpdateOrientation) is moved
+				// with it, so that it does not see this as a movement.
+				mvPrevSmoothPos = mvPrevSmoothPos + vMoved;
+				mvVRFollow = mvVRFollow + vMoved;
+				vFeet = vTo;
+				if(mlVRFollowNotes < 3)
+				{
+					mlVRFollowNotes++;
+					VRFollowNote(92, vMoved);
+				}
+			}
+		}
+		mvVRWalkFeet = vFeet; // (where the feet are after following: see VRWalkCheck)
+
+		/////////////////////////////
+		// How dark the view should be: a wall or a door (or anything heavy) on
+		// the line from the game's body to the head, at the head's height...
+		// (Where the head will be a moment from now, from how fast it moves
+		// against the game's body: the real head's own movement, not walking
+		// with the stick, which moves both. At most 3 m/s is believed.)
+		cVector3f vHeadSoon = vHead;
+		cVector3f vHeadOff = vHead - vFeet;
+		if(mbVRLastHeadKnown && afTimeStep > 0.0001f)
+		{
+			cVector3f vSpeed = (vHeadOff - mvVRLastHead) * (1.0f / afTimeStep);
+			if(vSpeed.Length() > 3.0f) vSpeed = cMath_Vector3Normalize(vSpeed) * 3.0f;
+			vHeadSoon = vHead + vSpeed * gfVRHeadLookAhead;
+		}
+		mvVRLastHead = vHeadOff;
+		mbVRLastHeadKnown = true;
+		float fWanted = 0.0f;
+		int lWhy = 0;			// for the log: what darkens it most (see VRHeadFadeNote)
+		float fWhyGap = -1.0f;	// and how near that is, in meters
+		float fDeep = 0.0f; // how far into a wall the head is now (1: gfVRHeadReturnDepth)
+		cVector3f vFrom = vFeet;
+		vFrom.y = vHead.y;
+		cVector3f vToHead = vHead - vFrom;
+		float fToHead = vToHead.Length();
+		cVector3f vToSoon = vHeadSoon - vFrom;
+		vToSoon.y = vToHead.y;
+		float fToSoon = cMath_Max(vToSoon.Length(), fToHead);
+		mfVRFollowWall = -1.0f;
+		if(fToHead > 0.02f)
+		{
+			cVector3f vDir = vToHead * (1.0f / fToHead);
+			mfVRFollowWall = VRWallAlong(vFrom, vDir, fToSoon + gfVRHeadFadeAhead);
+			if(mfVRFollowWall >= 0.0f)
+			{
+				// (Nearer for a door: see gfVRHeadDoorStart.)
+				float fAhead = mbVRWallIsDoor ? gfVRHeadDoorStart : gfVRHeadFadeAhead;
+				float fBefore = mbVRWallIsDoor ? gfVRHeadDoorBlack : gfVRHeadFadeBefore;
+				fWanted = cMath_Clamp((fToSoon + fAhead - mfVRFollowWall) / (fAhead - fBefore), 0.0f, 1.0f);
+				fDeep = cMath_Clamp((fToHead - mfVRFollowWall) / gfVRHeadReturnDepth, 0.0f, 1.0f);
+				if(fWanted > 0.0f)
+				{
+					lWhy = 1;
+					fWhyGap = mfVRFollowWall - fToHead;
+				}
+			}
+		}
+		// ...or anything near the eyes, in any direction: ten short rays from
+		// where the head is going, eight round it and one up and one down, so
+		// that no wall can be seen through, however slowly or quickly the head moves.
+		// Not while a door is held: the door is stopped at the body by itself
+		// (PlayerState_Interact_SwingDoor.hps), and may swing past near the face.
+		// (Each ray darkens by what it meets: a door only from nearer, see
+		// gfVRHeadDoorStart.)
+		for(int lRay = 0; lRay < 10 && lState != ePlayerState_SwingDoor; ++lRay)
+		{
+			cVector3f vRay = cVector3f(0.0f, lRay == 8 ? 1.0f : -1.0f, 0.0f);
+			if(lRay < 8)
+			{
+				float fAngle = float(lRay) * 0.7853982f;
+				vRay = cVector3f(cMath_Cos(fAngle), 0.0f, cMath_Sin(fAngle));
+			}
+			float fHit = VRWallAlong(vHeadSoon, vRay, gfVRHeadNearStart);
+			if(fHit < 0.0f) continue;
+			// Straight up and down: gfVRHeadUpStart.
+			float fStart = mbVRWallIsDoor ? gfVRHeadDoorStart : (lRay >= 8 ? gfVRHeadUpStart : gfVRHeadNearStart);
+			float fBlack = mbVRWallIsDoor ? gfVRHeadDoorBlack : (lRay >= 8 ? gfVRHeadUpBlack : gfVRHeadNearBlack);
+			float fRayDark = cMath_Clamp((fStart - fHit) / (fStart - fBlack), 0.0f, 1.0f);
+			if(fRayDark > fWanted)
+			{
+				fWanted = fRayDark;
+				lWhy = lRay == 8 ? 3 : (lRay == 9 ? 4 : 2);
+				fWhyGap = fHit;
+			}
+		}
+		// ...or the neck too far from the game's body (only while it follows;
+		// switched off, the body stays where the stick put it).
+		cVector3f vNeckOff = vNeck - vFeet;
+		vNeckOff.y = 0.0f;
+		mfVRFollowFar = vNeckOff.Length();
+		float fFar = 0.0f;
+		if(bFollow) fFar = cMath_Clamp((mfVRFollowFar - gfVRHeadFarStart) / (gfVRHeadFarBlack - gfVRHeadFarStart), 0.0f, 1.0f);
+		if(fFar > fWanted)
+		{
+			lWhy = 5;
+			fWhyGap = mfVRFollowFar;
+		}
+		fWanted = cMath_Max(fWanted, fFar);
+		float fWantedLevel = cMath_Max(fDeep, fFar); // (these two bring the view back to the body, below)
+		// ...or the head down at the floor (lower than a crouch, under a table,
+		// the head could otherwise go under the map): dark from
+		// gfVRHeadFloorStart above the ground the game's body
+		// stands on, black at gfVRHeadFloorBlack; or the head up into something
+		// above the game's body (standing up while crouched under something): a
+		// ray straight up from the game's eye height to the head. (Neither
+		// brings the view back to the body: the head has to come back itself.)
+		float fWantedUpDown = cMath_Clamp((vFeet.y + gfVRHeadFloorStart - vHead.y) / (gfVRHeadFloorStart - gfVRHeadFloorBlack), 0.0f, 1.0f);
+		if(fWantedUpDown > fWanted)
+		{
+			lWhy = 6;
+			fWhyGap = vHead.y - vFeet.y;
+		}
+		float fEyeHeight = pCam.GetPosition().y;
+		// From where the head will be a moment later, and only from gfVRHeadUpStart under what is above
+		// (not gfVRHeadFadeAhead, as for a wall ahead).
+		float fHeadUp = cMath_Max(vHead.y, vHeadSoon.y);
+		if(fHeadUp > fEyeHeight + 0.02f)
+		{
+			float fUp = fHeadUp - fEyeHeight;
+			float fRoof = VRWallAlong(cVector3f(vFeet.x, fEyeHeight, vFeet.z), cVector3f(0.0f, 1.0f, 0.0f), fUp + gfVRHeadUpStart);
+			if(fRoof >= 0.0f)
+			{
+				float fRoofDark = cMath_Clamp((gfVRHeadUpStart - (fRoof - fUp)) / (gfVRHeadUpStart - gfVRHeadUpBlack), 0.0f, 1.0f);
+				if(fRoofDark > cMath_Max(fWanted, fWantedUpDown))
+				{
+					lWhy = 7;
+					fWhyGap = fRoof - fUp;
+				}
+				fWantedUpDown = cMath_Max(fWantedUpDown, fRoofDark);
+			}
+		}
+		fWanted = cMath_Max(fWanted, fWantedUpDown);
+		VRHeadFadeNote(fWanted, lWhy, fWhyGap);
+
+		if(fWanted > mfVRHeadFade)	mfVRHeadFade = cMath_Min(mfVRHeadFade + afTimeStep * gfVRHeadFadeInSpeed, fWanted);
+		else						mfVRHeadFade = cMath_Max(mfVRHeadFade - afTimeStep * gfVRHeadFadeOutSpeed, fWanted);
+
+		/////////////////////////////
+		// Black for a while: the view is brought back to the body. The room
+		// (and with it the camera and the drawn body) is moved so that the
+		// neck is over the game's body again; the view then clears.
+		mfVRHeadBlackTime = (mfVRHeadFade > 0.98f && fWantedLevel > 0.98f) ? mfVRHeadBlackTime + afTimeStep : 0.0f;
+		if(mfVRHeadBlackTime > gfVRHeadReturnTime)
+		{
+			mvVRFollow = mvVRFollow + vNeckOff;
+			mfVRHeadBlackTime = 0.0f;
+			VRFollowNote(91, cVector3f(mfVRFollowFar, mfVRFollowWall, fToHead));
+		}
+	}
+
+	// BunkerVR: real-body stealth. How low the player's real head is: its height above the feet (roll 7005) against the
+	// standing eye height, in steps of the game's crouch (body 1.95 m standing, 1.15 m crouched), up to
+	// gfVRStealthLowMost. The standing eye height is taken from the game's own camera (roll 7007, head movement left
+	// out) while not crouching, so a real duck doesn't move it. Don't use mfVRStandEye (VRUpdateDuckLift's) here: it
+	// follows the drawn head, which ducks with the player, so a duck short of the crouch would count for nothing.
+	// Read by Player.hps UpdateHidingInDark ("BunkerVR_StealthLow") for the Beast's sight in the dark. Zero during
+	// camera animations, on ladders, with the headset off, and until the standing height is known: then only the
+	// game's own crouch counts. Also drives the creatures' sight at the real head's height (VRSightWhyNot,
+	// VRSightRise, cVR_BeastSight).
+	void VRUpdateStealthLow(float afTimeStep)
+	{
+		float fLow = 0.0f;
+		int lSightWhy = 1;
+		float fSightUp = 0.0f;
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		cCamera@ pCam = pPlayer !is null ? pPlayer.GetCamera() : null;
+		iCharacterBody@ pCharBody = pPlayer !is null ? pPlayer.GetCharacterBody() : null;
+		cMatrixf mtxHead;
+		if(mbVRSeen && mbCameraAnimation_Active == false && VROnLadder() == false &&
+		   pCam !is null && pCharBody !is null && VRReadRealHead(pCam, mtxHead))
+		{
+			float fFeet = pCharBody.GetFeetPosition().y;
+			float fRealRoll = pCam.GetRoll();
+			pCam.SetRoll(7007.0f);
+			float fGameEye = pCam.GetMatrix().GetTranslation().y - fFeet;
+			pCam.SetRoll(fRealRoll);
+			if(Player_GetCrouching() == false && Player_GetCrawling() == false && GetCrouchTransitionActive() == false &&
+			   pCharBody.IsOnGround() && fGameEye > 1.0f && fGameEye < 2.5f)
+			{
+				if(mfVRStealthStandEye < 0.0f)	mfVRStealthStandEye = fGameEye;
+				else							mfVRStealthStandEye += (fGameEye - mfVRStealthStandEye) * cMath_Min(1.0f, afTimeStep * 3.0f);
+			}
+			if(mfVRStealthStandEye > 0.0f)
+			{
+				float fEye = mtxHead.GetTranslation().y - fFeet;
+				fLow = cMath_Clamp((mfVRStealthStandEye - fEye) / (gvBodySize.y - gvBodyCrouchSize.y), 0.0f, gfVRStealthLowMost);
+			}
+			// The creatures' sight at the real head's height (gfVRSightEyeLowest).
+			lSightWhy = VRSightWhyNot(pPlayer, pCharBody, mtxHead.GetTranslation());
+			if(lSightWhy == 0) fSightUp = VRSightRise(pPlayer, pCharBody, mtxHead.GetTranslation().y);
+		}
+		mfVRStealthLow = fLow;
+		cScript_SetGlobalVarFloat("BunkerVR_StealthLow", fLow);
+		mbVRSightOn = lSightWhy == 0;
+		mfVRSightUp = fSightUp;
+		cVR_BeastSight(mbVRSightOn, fSightUp);
+		// Also for the sight test map, which asks once more with the game's own height and then puts this back.
+		cScript_SetGlobalVarInt("BunkerVR_SightOn", mbVRSightOn ? 1 : 0);
+		cScript_SetGlobalVarFloat("BunkerVR_SightUp", fSightUp);
+		VRSightNote(lSightWhy, fSightUp);
+	}
+
+	// BunkerVR: may the real head count for the creatures' sight of the player now? 0 yes; why not: 2 the game
+	// moves or holds the body itself in this state (VRFollowStateOk: ledges, sitting, reading, the inventory, being
+	// thrown...), 3 crawling (the body does not follow the head), 4 the view darkened (the head in a wall or come up into
+	// something over the body: the game's body is where the player is), 5 the game's body just moved at once (a jump, or
+	// the game placing the player: for gfVRTeleportWait the real head is still read where the view was, until the view
+	// is put over the body), 6 the real head (avHead) far from the body: more than gfVRSightHeadFar across, below the
+	// feet, or more than that over the standing eye (the same, where the move was not seen as a jump: a map placing the
+	// player as it starts, such as the test maps' starts, where the head is read for a moment far from where the body
+	// now is). (1, a knockdown, a cutscene, a ladder or no real head, is VRUpdateStealthLow's own.)
+	int VRSightWhyNot(cLuxPlayer@ apPlayer, iCharacterBody@ apCharBody, const cVector3f &in avHead)
+	{
+		if(VRFollowStateOk(apPlayer.GetCurrentStateId()) == false) return 2;
+		if(Player_GetCrawling()) return 3;
+		if(mfVRHeadFade >= 0.5f) return 4;
+		if(mfVRTeleportWait > 0.0f) return 5;
+		cVector3f vMiddle = apCharBody.GetPosition();
+		float fFeet = vMiddle.y - apCharBody.GetSize().y * 0.5f;
+		cVector3f vAcross = avHead - vMiddle;
+		vAcross.y = 0.0f;
+		if(vAcross.Length() > gfVRSightHeadFar || avHead.y < fFeet ||
+		   avHead.y > fFeet + gvBodySize.y + apPlayer.GetBaseCameraPosAdd().y + gfVRSightHeadFar) return 6;
+		return 0;
+	}
+
+	// BunkerVR: how far the real eye (afRealEye, its height in the world) is above (+) or below (-) the game's own eye as the
+	// engine's sight takes it (GetPlayerHeadPos: the body's middle, half its height and the base camera offset), the real
+	// eye kept between gfVRSightEyeLowest above the feet and gfVRSightAboveMost over the standing eye.
+	float VRSightRise(cLuxPlayer@ apPlayer, iCharacterBody@ apCharBody, float afRealEye)
+	{
+		float fBase = apPlayer.GetBaseCameraPosAdd().y;
+		float fMiddle = apCharBody.GetPosition().y;
+		float fHalf = apCharBody.GetSize().y * 0.5f;
+		float fFeet = fMiddle - fHalf;
+		float fEye = cMath_Clamp(afRealEye, fFeet + gfVRSightEyeLowest, fFeet + gvBodySize.y + fBase + gfVRSightAboveMost);
+		return fEye - (fMiddle + fHalf + fBase);
+	}
+
+	// BunkerVR: the creatures' sight in the log, the first 40 changes: as the real head begins or stops counting
+	// (and why not), and as it goes 10 cm or more from the game's eye or comes back within 5 cm.
+	void VRSightNote(int alWhy, float afUp)
+	{
+		int lBand = mlVRSightBand;
+		if(alWhy != 0)						lBand = 100 + alWhy;
+		else if(afUp <= -0.1f)				lBand = -1;
+		else if(afUp >= 0.1f)				lBand = 1;
+		else if(cMath_Abs(afUp) < 0.05f)	lBand = 0;
+		else if(lBand >= 99)				lBand = 0;
+		if(lBand == mlVRSightBand) return;
+		mlVRSightBand = lBand;
+		if(mlVRSightNotes >= 40) return;
+		mlVRSightNotes++;
+		if(lBand >= 100)
+		{
+			tString sWhy = "no real head, or the game places the view: a knockdown, a cutscene, a ladder";
+			if(alWhy == 2)		sWhy = "the game moves or holds the body in this state";
+			else if(alWhy == 3)	sWhy = "crawling";
+			else if(alWhy == 4)	sWhy = "the view darkened: the head in a wall or under something";
+			else if(alWhy == 5)	sWhy = "the body just moved at once: a jump, or the game placing the player";
+			else if(alWhy == 6)	sWhy = "the real head far from the body: the body just placed, the view not yet over it";
+			Log("BunkerVR sight: the creatures see the player at the game's own height (" + sWhy + ")\n");
+			return;
+		}
+		Log("BunkerVR sight: the creatures look for the player's head at the real head's height, " + BunkerVR_Fixed(afUp * 100.0f, 0) +
+			" cm from the game's eye (" + (Player_GetCrouching() ? "crouched" : "standing") + ")\n");
+	}
+
+	// BunkerVR: for testing (script command 82): the Beast's own sight of the player asked now, through the engine
+	// functions the mod hooks (sight.cpp writes its own lines to BunkerVR.log): the
+	// head as it sees it (GetPlayerHeadPos), against the real head and the game's eye, all above the feet; whether it has
+	// the player in its line of sight at once, with and without its field of view checked (not checked: its direction
+	// does not count); and the same two asked to be answered later (to its own OnLosResult, as its sight every half second
+	// is). The level's Beast, switched off or not (the engine's sight works the same), or the Beast page's.
+	void VRSightTest()
+	{
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		if(pPlayer is null || pMap is null) return;
+		array<iLuxEntity@> vEnts;
+		pMap.GetEntityArray("*", eLuxEntityType_Agent, "cScrAgentStalker", vEnts);
+		cLuxAgent@ pAgent = null;
+		tString sName = "";
+		for(uint i = 0; i < vEnts.length() && pAgent is null; ++i)
+		{
+			if(vEnts[i] is null) continue;
+			@pAgent = cLux_ID_Agent(vEnts[i].GetID());
+			sName = vEnts[i].GetName();
+		}
+		if(pAgent is null)
+		{
+			cVR_Say("sight test: no Beast in " + pMap.GetName());
+			return;
+		}
+		iCharacterBody@ pCharBody = pPlayer.GetCharacterBody();
+		cCamera@ pCam = pPlayer.GetCamera();
+		cMatrixf mtxHead;
+		bool bHead = pCam !is null && VRReadRealHead(pCam, mtxHead);
+		float fFeet = pCharBody.GetPosition().y - pCharBody.GetSize().y * 0.5f;
+		float fGameEye = pCharBody.GetSize().y + pPlayer.GetBaseCameraPosAdd().y;
+		cVector3f vSeen = pAgent.GetPlayerHeadPos();
+		bool bNow = pAgent.GetPlayerIsInLineOfSight();
+		bool bNowAhead = pAgent.GetPlayerIsInLineOfSight(pAgent.GetFOV(), pAgent.GetLookDirection(), false);
+		pAgent.GetPlayerIsInLineOfSight("OnLosResult");
+		pAgent.GetPlayerIsInLineOfSight("OnLosResult", pAgent.GetFOV(), pAgent.GetLookDirection(), false);
+		tString sLine = "sight test: the Beast " + sName + (pAgent.IsActive() ? "" : " (switched off)") + " " +
+			int(cMath_Vector3Dist(pAgent.GetPosition(), pCharBody.GetPosition()) + 0.5f) + " m away; above the feet, the head as it sees it " +
+			BunkerVR_Fixed(vSeen.y - fFeet, 3) + ", the real head " + (bHead ? BunkerVR_Fixed(mtxHead.GetTranslation().y - fFeet, 3) : "unknown") +
+			", the game's eye " + BunkerVR_Fixed(fGameEye, 3) + "; the real head " + (mbVRSightOn ? "counts" : "does not count") + ", " +
+			BunkerVR_Fixed(mfVRSightUp, 3) + " from the game's eye; crouched " + (Player_GetCrouching() ? "yes" : "no") +
+			"; in its line of sight at once: " + (bNow ? "yes" : "no") + ", without its field of view: " + (bNowAhead ? "yes" : "no");
+		Log("BunkerVR: " + sLine + "\n");
+		cVR_Say(sLine);
+	}
+
+	// BunkerVR: after a teleport of the game's body (gfVRTeleportMoved), the darkest the view got in the next
+	// gfVRTeleportWatch, and how far the neck then is from the body, in the log (the first 20): for the jumps' checks.
+	void VRTeleportWatch(float afTimeStep)
+	{
+		if(mfVRTeleportWatch <= 0.0f) return;
+		mfVRTeleportDarkest = cMath_Max(mfVRTeleportDarkest, mfVRHeadFade);
+		mfVRTeleportWatch -= afTimeStep;
+		if(mfVRTeleportWatch > 0.0f || mlVRTeleportNotes >= 20) return;
+		mlVRTeleportNotes++;
+		Log("BunkerVR: " + int(gfVRTeleportWatch + 0.5f) + " s after the body was moved " + int(mfVRTeleportMoved + 0.5f) + " m at once: the view darkened at most " +
+			int(mfVRTeleportDarkest * 100.0f + 0.5f) + "%, the neck now " + int(mfVRFollowFar * 100.0f + 0.5f) + " cm from the body\n");
+	}
+
+	// BunkerVR: why the view is being darkened, in the log as it first goes past half dark each time (the first 40),
+	// for example when hiding under a table or crawling under something: alWhy 1 a wall or door on the line from the
+	// body to the head, 2 something beside the eyes, 3 above them, 4 below them, 5 the neck too far from the body,
+	// 6 the head down at the floor, 7 the head come up into something over the body; afGap how near (meters; for 5
+	// the neck's distance, for 6 the head's height over the feet).
+	void VRHeadFadeNote(float afWanted, int alWhy, float afGap)
+	{
+		bool bDark = afWanted > 0.5f;
+		if(bDark && mbVRHeadFadeNoted == false && mlVRHeadFadeNotes < 40)
+		{
+			mlVRHeadFadeNotes++;
+			tString sWhy = "?";
+			if(alWhy == 1) sWhy = "a wall or door between the body and the head";
+			else if(alWhy == 2) sWhy = "something beside the eyes";
+			else if(alWhy == 3) sWhy = "something just above the eyes";
+			else if(alWhy == 4) sWhy = "something just below the eyes";
+			else if(alWhy == 5) sWhy = "the neck too far from the body";
+			else if(alWhy == 6) sWhy = "the head down at the floor";
+			else if(alWhy == 7) sWhy = "the head come up into something over the body";
+			Log("BunkerVR: the view darkens: " + sWhy + " (" + int(afGap * 100.0f + (afGap < 0.0f ? -0.5f : 0.5f)) + " cm; " +
+				(Player_GetCrawling() ? "crawling" : (Player_GetCrouching() ? "crouched" : "standing")) + ")\n");
+		}
+		mbVRHeadFadeNoted = bDark;
+	}
+
+	// BunkerVR: for the log: which way walking with the stick really goes, to
+	// find walking that doesn't follow the head. While the stick is pushed
+	// (nearly) straight forwards and the body walks, twice a second at most,
+	// 30 lines in all: how far the head is turned from where the game's camera
+	// faces, and how far the way walked is (degrees, plus to the left); and the
+	// camera's and the body's own turns. Walking should go the way the head
+	// faces. avFeet: the feet now, before following the head; mvVRWalkFeet:
+	// after following, at the last update (following is not walking).
+	void VRWalkCheck(cCamera@ apCam, iCharacterBody@ apCharBody, const cMatrixf &in a_mtxHead, const cVector3f &in avFeet, float afTimeStep)
+	{
+		cVector3f vWalk = avFeet - mvVRWalkFeet;
+		bool bKnown = mbVRWalkFeetKnown;
+		mbVRWalkFeetKnown = true;
+		mfVRWalkCheckWait -= afTimeStep;
+		if(bKnown == false || mlVRWalkChecks >= 30 || mfVRWalkCheckWait > 0.0f || afTimeStep < 0.0001f) return;
+		vWalk.y = 0.0f;
+		float fSpeed = vWalk.Length() / afTimeStep;
+		if(fSpeed < 0.4f || fSpeed > 10.0f) return;
+
+		// The stick, as the player script reads it (7018: 12345, sideways, forwards).
+		float fRealRoll = apCam.GetRoll();
+		apCam.SetRoll(7018.0f);
+		cVector3f vStick = apCam.GetMatrix().GetTranslation();
+		apCam.SetRoll(fRealRoll);
+		if(vStick.x < 12344.0f || vStick.x > 12346.0f) return;
+		if(vStick.z < 0.6f || cMath_Abs(vStick.y) > 0.35f) return;
+
+		cVector3f vHeadFace = cMath_MatrixMul3x3(a_mtxHead, cVector3f(0.0f, 0.0f, -1.0f));
+		cVector3f vCamFace = apCam.GetForward();
+		vHeadFace.y = 0.0f;
+		vCamFace.y = 0.0f;
+		if(vHeadFace.Length() < 0.2f || vCamFace.Length() < 0.2f) return; // (looking nearly straight up or down)
+		vHeadFace.Normalize();
+		vCamFace.Normalize();
+		vWalk.Normalize();
+		float fHeadTurn = cMath_ToDeg(cMath_ATan2(cMath_Vector3Cross(vCamFace, vHeadFace).y, cMath_Vector3Dot(vCamFace, vHeadFace)));
+		float fWalkTurn = cMath_ToDeg(cMath_ATan2(cMath_Vector3Cross(vCamFace, vWalk).y, cMath_Vector3Dot(vCamFace, vWalk)));
+		mlVRWalkChecks++;
+		mfVRWalkCheckWait = 0.5f;
+		Log("BunkerVR walk check: stick forwards " + int(vStick.z * 100.0f) + "%, sideways " + int(vStick.y * 100.0f) + "%; " +
+			int(fSpeed * 100.0f) + " cm a second; player state " + cLux_GetPlayer().GetCurrentStateId() + ". From where the game's camera faces: the head " +
+			int(fHeadTurn) + ", walking " + int(fWalkTurn) + " (degrees, plus to the left; walking off the head by " + int(fWalkTurn - fHeadTurn) +
+			"). Camera turn " + int(cMath_ToDeg(apCam.GetYaw())) + ", body turn " + int(cMath_ToDeg(apCharBody.GetYaw())) + "\n");
+	}
+
+	// BunkerVR: the real head on a ladder. Climbing on, in its blink, the
+	// ladder asks for the view to be put over the body ("BunkerVR_LadderCentre",
+	// PlayerState_Ladder.hps VRClimbOnByBlink), as on arriving in a map: the
+	// room's offset (mvVRFollow) takes on as far as the neck is from the
+	// game's body across the floor, so that the eyes are where the game has
+	// the climber's, not off to one side or too close to the rungs. Then the
+	// drawn body stays on the ladder (UpdateOrientation, VROnLadder), so its
+	// legs don't move with the head, and the real head moves the view on its
+	// own: the further the neck goes from over the body, past
+	// gfVRLadderHeadFree, the darker the view, black at gfVRLadderHeadBlack
+	// (as a head in a wall, mfVRHeadFade), so that nobody leans out of their
+	// body or into the rungs.
+	// Called once the camera is placed for the update, from where the view is
+	// (UpdateCamera, after VRCameraPlace). Don't do this in VRFollowHead: there
+	// the camera on a ladder is still where the game puts it, over its body, so
+	// the head read there doesn't move with the room's offset, and an offset set
+	// from it would put the view as far off as the player has walked about the
+	// real room. Putting the view over the body moves the camera at once too.
+	void VRLadderHead(cCamera@ apCam, iCharacterBody@ apCharBody, float afTimeStep)
+	{
+		mfVRHeadBlackTime = 0.0f;
+		bool bCentre = cScript_GetGlobalVarBool("BunkerVR_LadderCentre");
+		cMatrixf mtxHead;
+		if(apCam is null || apCharBody is null || VRReadRealHead(apCam, mtxHead) == false)
+		{
+			if(bCentre) cScript_SetGlobalVarBool("BunkerVR_LadderCentre", false);
+			mfVRHeadFade = cMath_Max(mfVRHeadFade - afTimeStep * gfVRHeadFadeOutSpeed, 0.0f);
+			return;
+		}
+		cVector3f vHead = mtxHead.GetTranslation();
+		cVector3f vNeck = vHead - cMath_MatrixMul3x3(mtxHead, cVector3f(0.0f, gfVRNeckToEyesUp, -gfVRNeckToEyesForward));
+		cVector3f vFeet = apCharBody.GetFeetPosition();
+		// The ladder's plane, through its area, and which way is out of it towards the climber: the side the
+		// game's body is on.
+		cScript_RunGlobalFunc("State_Ladder", "", "_Global_GetLadderAreaPos");
+		cVector3f vLadder = cScript_GetGlobalReturnVector3f();
+		cVector3f vOut = vFeet - vLadder;
+		vOut.y = 0.0f;
+		bool bPlane = vOut.Length() > 0.05f;
+		if(bPlane) vOut.Normalize();
+		else vOut = cVector3f(0.0f);
+		// (Where the neck is wanted: over the body, gfVRLadderNeckBack further from the ladder.)
+		cVector3f vOff = vNeck - vFeet - vOut * gfVRLadderNeckBack;
+		vOff.y = 0.0f;
+		if(bCentre)
+		{
+			// Measured from where the view is, and the camera moved with it at once; checked again
+			// each update until near twice running, the ladder keeping the view dark meanwhile.
+			if(mlVRLadderCentreSteps == 0) mfVRLadderCentreFirst = vOff.Length();
+			mlVRLadderCentreSteps++;
+			mvVRFollow = mvVRFollow + vOff * gfVRLadderCentreShare;
+			apCam.SetPosition(apCam.GetPosition() - vOff * gfVRLadderCentreShare);
+			mfVRHeadFade = 0.0f;
+			if(vOff.Length() < gfVRLadderCentreNear) mlVRLadderCentreNear++;
+			else mlVRLadderCentreNear = 0;
+			if(mlVRLadderCentreNear >= 2 || mlVRLadderCentreSteps >= glVRLadderCentreMost)
+			{
+				cScript_SetGlobalVarBool("BunkerVR_LadderCentre", false);
+				if(mlVRLadderNotes < 30)
+				{
+					mlVRLadderNotes++;
+					float fEyesUp = vHead.y - VRBodyEyesY();
+					Log("BunkerVR ladder: the view put over the body in " + mlVRLadderCentreSteps + " updates (the neck was " + int(mfVRLadderCentreFirst * 100.0f + 0.5f) +
+						" cm off where it is wanted, now " + int(vOff.Length() * 100.0f + 0.5f) + " cm; the eyes " + int(cMath_Vector3Dot(vHead - vLadder, vOut) * 100.0f + 0.5f) +
+						" cm from the rungs, the real eyes " + int(fEyesUp * 100.0f + (fEyesUp < 0.0f ? -0.5f : 0.5f)) + " cm above the body's)\n");
+				}
+				mlVRLadderCentreSteps = 0;
+				mlVRLadderCentreNear = 0;
+			}
+			return;
+		}
+		mlVRLadderCentreSteps = 0;
+		mlVRLadderCentreNear = 0;
+		// Darker as the eyes come near the rungs (into the ladder), and as the neck goes far from where it
+		// was put (leaning back or aside).
+		float fEyes = bPlane ? cMath_Vector3Dot(vHead - vLadder, vOut) : 1.0f;
+		float fNearDark = cMath_Clamp((gfVRLadderEyesClear - fEyes) / (gfVRLadderEyesClear - gfVRLadderEyesBlack), 0.0f, 1.0f);
+		float fFarDark = cMath_Clamp((vOff.Length() - gfVRLadderHeadFree) / (gfVRLadderHeadBlack - gfVRLadderHeadFree), 0.0f, 1.0f);
+		float fFade = cMath_Max(fNearDark, fFarDark);
+		// (Darker at once; clearing as a head out of a wall does.)
+		if(fFade >= mfVRHeadFade)	mfVRHeadFade = fFade;
+		else						mfVRHeadFade = cMath_Max(mfVRHeadFade - afTimeStep * gfVRHeadFadeOutSpeed, fFade);
+		if(fFade > 0.5f && mbVRLadderFarNoted == false && mlVRLadderNotes < 30)
+		{
+			mlVRLadderNotes++;
+			Log("BunkerVR ladder: the view darkens: the eyes " + int(fEyes * 100.0f + 0.5f) + " cm from the rungs, the neck " + int(vOff.Length() * 100.0f + 0.5f) + " cm from where it was put\n");
+		}
+		mbVRLadderFarNoted = fFade > 0.5f;
+	}
+
+	// BunkerVR: the drawn body's eyes' height in the world (its CameraSocket; 0 if not known; for the log).
+	float VRBodyEyesY()
+	{
+		iLuxEntity@ pEnt = cLux_ID_Entity(m_idBody);
+		cMeshEntity@ pMesh = pEnt !is null ? pEnt.GetMeshEntity() : null;
+		cNode3D@ pSocket = pMesh !is null ? pMesh.GetSocket("CameraSocket") : null;
+		return pSocket !is null ? pSocket.GetWorldPosition().y : 0.0f;
+	}
+
+	// BunkerVR: is the player on a ladder?
+	bool VROnLadder()
+	{
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		return pPlayer !is null && pPlayer.GetCurrentStateId() == ePlayerState_Ladder;
+	}
+
+	// BunkerVR: may the game's body follow the head in this state of the
+	// player? Yes in the game's own play and while holding or using things.
+	// Not where the game moves or holds the body itself: ladders, ledges,
+	// cutscenes, sitting, conversations, reading, the inventory, being thrown.
+	bool VRFollowStateOk(int alState)
+	{
+		if(alState == ePlayerState_Normal || alState == ePlayerState_Grab || alState == ePlayerState_Push ||
+		   alState == ePlayerState_Wheel || alState == ePlayerState_Slide || alState == ePlayerState_SwingDoor ||
+		   alState == ePlayerState_Lever || alState == ePlayerState_MovingButton) return true;
+		// Using what is in the hands (the gun, the lamp, healing, throwing, tools, ...).
+		if(alState >= ePlayerState_Custom_UsingGun_Aim && alState <= ePlayerState_Custom_UsingMeat) return true;
+		if(alState == ePlayerState_Custom_UsingWrench) return true;
+		if(alState >= ePlayerState_Custom_UsingDynamite && alState <= ePlayerState_Custom_UsingRabbitDoll) return true;
+		// The pillbox key's own state and the fuse's: the game has them
+		// (config\PlayerStates.cfg, 97 and 98), the scripts' list stops at 96.
+		// Without them, holding the fuse, the legs go back to the game, whose
+		// foot placement raises the body and the view (the game's camera ends
+		// up about 2 m above the floor).
+		if(alState == glVRStateUsingPillboxKey || alState == glVRStateUsingFuse) return true;
+		// A dogtag held in the hand: the player walks with it
+		// (PlayerState_Interact_ReadDogTag.hps); at a number lock too
+		// (PlayerState_Interact_CombinationLock.hps).
+		if(alState == ePlayerState_Custom_ReadDogTag || alState == ePlayerState_Custom_CombinationLock) return true;
+		return false;
+	}
+
+	// BunkerVR: may the drawn legs be the mod's own (UpdateVRLegs in
+	// Prop_PlayerBody.hps) in this state of the player? Wherever the body
+	// follows the head, and also where the game holds the body still without
+	// animating or moving it: reading (a dogtag, a sign, a memory cylinder),
+	// tearing, a number lock, the storage box's inventory. In those states the
+	// legs would otherwise go back to the game, whose foot placement raises the
+	// pelvis until the feet stand on the floor, by up to 50 cm
+	// (player_bunker.ent, FootPlacement_MaxPelvisAlign). The body is drawn
+	// bigger about its eyes, which puts its feet under the floor (29 cm at a
+	// world scale of 1.156), so the body would rise that far, and the view
+	// with it, which hangs on the body's eyes: the player floats.
+	bool VRLegsStateOk(int alState)
+	{
+		if(VRFollowStateOk(alState)) return true;
+		return alState == ePlayerState_Read || alState == ePlayerState_Tear ||
+			   alState == ePlayerState_Custom_ReadDogTag || alState == ePlayerState_Custom_ReadMemoryCylinder ||
+			   alState == ePlayerState_Custom_CombinationLock || alState == ePlayerState_Custom_Inventory;
+	}
+
+	// BunkerVR: how far along a line something stands that the view must not
+	// pass: a wall, floor or ceiling (no mass), a door or hatch (on a joint),
+	// or anything of 20 kg or more. Light loose things (a can, a box, what the
+	// hands hold) and bodies (the player's own, the Beast's) are looked past.
+	// -1: nothing within afLength. mbVRWallIsDoor: was what it met a door (a
+	// body that moves, on a joint)?
+	float VRWallAlong(const cVector3f &in avStart, const cVector3f &in avDir, float afLength)
+	{
+		mbVRWallIsDoor = false;
+		float fGone = 0.0f;
+		for(int i = 0; i < 4; ++i)
+		{
+			float fLeft = afLength - fGone;
+			if(fLeft <= 0.0f) return -1.0f;
+			float fHit = 0.0f;
+			cVector3f vNormal = cVector3f(0.0f);
+			iPhysicsBody@ pHit = cLux_GetClosestBody(avStart + avDir * fGone, avDir, fLeft, fHit, vNormal);
+			if(pHit is null) return -1.0f;
+			if(pHit.IsCharacter() == false && (pHit.GetMass() <= 0.0f || pHit.GetJointNum() > 0 || pHit.GetMass() >= 20.0f))
+			{
+				mbVRWallIsDoor = pHit.GetMass() > 0.0f && pHit.GetJointNum() > 0;
+				return fGone + fHit;
+			}
+			fGone += fHit + 0.01f;
+		}
+		return -1.0f;
+	}
+
+	// BunkerVR: how far the view is clear in front of the real head, for the
+	// interface's pieces (the subtitles and hints are put 2.2 m away, and
+	// seen beyond a wall a meter off they are hard on the eyes): the nearest
+	// wall, door or heavy thing
+	// (VRWallAlong) along the look, gfVRRoomBelow under it (where the
+	// subtitles are), gfVRRoomAbove over it (the hints) and gfVRRoomSide to
+	// each side, each counted along the look; -1 for nothing within
+	// gfVRRoomReach. The mod puts the pieces in front of it, as big to the
+	// eye (cVR_InterfaceRoom; PiecesWantedDistance in vr.cpp).
+	float VRInterfaceRoom(const cMatrixf &in a_mtxHead)
+	{
+		cVector3f vHead = a_mtxHead.GetTranslation();
+		float fRoom = -1.0f;
+		for(int i = 0; i < 5; ++i)
+		{
+			float fAcross = 0.0f;
+			float fUp = 0.0f;
+			if(i == 1)		fUp = -gfVRRoomBelow;
+			else if(i == 2)	fUp = gfVRRoomAbove;
+			else if(i == 3)	fAcross = -gfVRRoomSide;
+			else if(i == 4)	fAcross = gfVRRoomSide;
+			// (In the head's own terms: x right, y up, z back.)
+			cVector3f vOwn = cVector3f(cMath_Sin(fAcross) * cMath_Cos(fUp), cMath_Sin(fUp), -cMath_Cos(fAcross) * cMath_Cos(fUp));
+			float fHit = VRWallAlong(vHead, cMath_MatrixMul3x3(a_mtxHead, vOwn), gfVRRoomReach);
+			if(fHit < 0.0f) continue;
+			float fAlong = fHit * cMath_Cos(fAcross) * cMath_Cos(fUp);
+			if(fRoom < 0.0f || fAlong < fRoom) fRoom = fAlong;
+		}
+		return fRoom;
+	}
+
+	// BunkerVR: tells the mod how far the view is clear in front
+	// (VRInterfaceRoom), from the real head (7006: is it tracked? 7005:
+	// where); -1 (as far as it likes) when the head is not known.
+	void VRSendInterfaceRoom(cCamera@ apCam)
+	{
+		float fRealRoll = apCam.GetRoll();
+		apCam.SetRoll(7006.0f);
+		cVector3f vStatus = apCam.GetMatrix().GetTranslation();
+		bool bHead = vStatus.x > 12344.0f && vStatus.x < 12346.0f && vStatus.y > 0.5f;
+		cMatrixf mtxHead = cMatrixf_Identity;
+		if(bHead)
+		{
+			apCam.SetRoll(7005.0f);
+			mtxHead = apCam.GetMatrix();
+		}
+		apCam.SetRoll(fRealRoll);
+		cVR_InterfaceRoom(bHead ? VRInterfaceRoom(mtxHead) : -1.0f);
+	}
+
+	// BunkerVR: what a VR option is set to (special roll 7060; -1: no answer).
+	int VRModOption(int alIndex)
+	{
+		cCamera@ pCam = cLux_GetPlayer().GetCamera();
+		if(pCam is null) return -1;
+		float fRealRoll = pCam.GetRoll();
+		cVector3f vRealPos = pCam.GetPosition();
+		pCam.SetPosition(cVector3f(float(alIndex), 0.0f, 0.0f));
+		pCam.SetRoll(7060.0f);
+		cVector3f vAnswer = pCam.GetMatrix().GetTranslation();
+		pCam.SetPosition(vRealPos);
+		pCam.SetRoll(fRealRoll);
+		if(vAnswer.x < 12344.0f || vAnswer.x > 12346.0f) return -1;
+		return int(vAnswer.y + 0.5f);
+	}
+
+	// BunkerVR: a note for the mod's log (BunkerVR.log) about following the
+	// head: 91 the view was brought back to the body (how far the neck was,
+	// where a wall was on the way or -1, how far the head was); 92 the body
+	// moved to follow (the first few times: by how much); 93 following
+	// switched on (1) or off (0); 97 the game's logic rate changed (from,
+	// to, the slowest it may go). At most 40 in all. Sent through cVR_Note.
+	void VRFollowNote(int alNote, const cVector3f &in avNumbers)
+	{
+		if(mlVRFollowNotesAll >= 40) return;
+		mlVRFollowNotesAll++;
+		cVR_Note(alNote, avNumbers.x, avNumbers.y, avNumbers.z);
+	}
+
+	//------------------------------------------------------------
+
+	// BunkerVR: a timing mark for the VR mod's log (7070 + 2 x the piece of
+	// work's number at its start, 7071 + 2 x it at its end; the mod times the
+	// gap, see CameraLogScriptTimings). Nothing happens without it. Sent
+	// through cVR_TimeMark.
+	void VRTimeMark(int alCode)
+	{
+		cVR_TimeMark(alCode);
+	}
+
+	// BunkerVR: the game's own logic at the headset's rate.
+	// The game runs its logic, physics, AI and scripts at its monitor's rate
+	// (taken from its display settings), for example 120 times a second: 1.3
+	// updates for each of the headset's 90 pictures, and 2.7 once the headset
+	// falls back to 45. In a real level that logic, not the graphics card,
+	// takes most of a frame. At the headset's own rate there is one update to
+	// each picture. The mod says the rate (special roll 7066; 0: leave the
+	// game's own, as when the VR menu's "Game logic at the headset's rate" is
+	// off). The second number is the rate below which the game would rather
+	// slow down than catch up: for the headset's rate the mod says it too (the
+	// rate itself: one update to a picture at most, never a second to make up
+	// for a slow frame; if the mod gives none, the largest whole share of the
+	// rate no higher than 30); for the game's own rate as the game itself
+	// works it out (its settings code: halved while even and still at least
+	// 30; 120: 15). While the headset has fallen back to 45 pictures a second
+	// the mod says half its rate, one update to each picture, which leaves the
+	// time to climb back to 90. So it is asked 20 times a second, and the
+	// rates are given to the game whenever either number changes.
+	void VRMatchLogicRate(float afTimeStep)
+	{
+		mfVRLogicRateWait -= afTimeStep;
+		if(mfVRLogicRateWait > 0.0f) return;
+		mfVRLogicRateWait = 0.05f;
+
+		cCamera@ pCam = cLux_GetPlayer().GetCamera();
+		if(pCam is null) return;
+		float fRealRoll = pCam.GetRoll();
+		pCam.SetRoll(7066.0f);
+		cVector3f vAnswer = pCam.GetMatrix().GetTranslation();
+		pCam.SetRoll(fRealRoll);
+		if(vAnswer.x < 12344.0f || vAnswer.x > 12346.0f) return; // no VR mod: the game's own rate
+
+		int lNow = cEngine_GetUpdatesPerSec();
+		if(mlVRGameLogicRate == 0) mlVRGameLogicRate = lNow; // the game's own, before any change
+		int lWanted = int(vAnswer.y + 0.5f);
+		int lRate = lWanted >= 30 ? lWanted : mlVRGameLogicRate;
+
+		int lSlowest = lRate;
+		if(lWanted >= 30 && vAnswer.z >= 1.0f)
+		{
+			lSlowest = int(vAnswer.z + 0.5f); // the mod's
+		}
+		else if(lWanted >= 30)
+		{
+			for(int d = 30; d >= 10; --d)
+			{
+				if(lRate % d == 0)
+				{
+					lSlowest = d;
+					break;
+				}
+			}
+		}
+		else
+		{
+			while(lSlowest % 2 == 0 && lSlowest / 2 >= 15) lSlowest = lSlowest / 2;
+		}
+		VRMatchPhysicsStep(lRate);
+		if(lRate == lNow && lSlowest == mlVRLogicSlowestSet) return;
+		cEngine_SetUpdatesPerSec(lRate, lSlowest);
+		mlVRLogicSlowestSet = lSlowest;
+		if(mlVRLogicNotes < 4) // (the mod logs each change of its own; the notes are shared with others)
+		{
+			mlVRLogicNotes++;
+			VRFollowNote(97, cVector3f(float(lNow), float(lRate), float(lSlowest)));
+		}
+	}
+
+	// BunkerVR: one physics step to each update of the game's logic. The physics
+	// world steps at most its own step at a time (PhysicsWorldNewton.cpp:
+	// NewtonUpdate in a loop while time is left); with the logic at half the
+	// headset's rate (45 updates a second) each update would run a whole step and
+	// a short one, the physics' work twice over just when the frames are late,
+	// which can keep a level at half speed. Its own step is kept, read from each
+	// level's physics world, and while an update (alRate a second) is longer the
+	// step is set to a little over it; back to its own at the full rate. Logged
+	// per level and for the first changes.
+	void VRMatchPhysicsStep(int alRate)
+	{
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		iPhysicsWorld@ pPhysics = pMap !is null ? pMap.GetPhysicsWorld() : null;
+		if(pPhysics is null || alRate <= 0) return;
+		if(pMap.GetFileName() != msVRPhysicsMap)
+		{
+			msVRPhysicsMap = pMap.GetFileName();
+			mfVRPhysicsOwnStep = pPhysics.GetMaxTimeStep();
+			Log("BunkerVR: the physics of " + pMap.GetName() + " steps at most " + BunkerVR_Fixed(mfVRPhysicsOwnStep * 1000.0f, 2) + " ms at a time, on " +
+				pPhysics.GetNumberOfThreads() + " thread(s)\n");
+		}
+		if(mfVRPhysicsOwnStep <= 0.0001f) return;
+		float fUpdate = 1.0f / float(alRate);
+		float fWanted = fUpdate > mfVRPhysicsOwnStep ? fUpdate * 1.02f : mfVRPhysicsOwnStep;
+		if(cMath_Abs(pPhysics.GetMaxTimeStep() - fWanted) < 0.00005f) return;
+		pPhysics.SetMaxTimeStep(fWanted);
+		if(mlVRPhysicsStepNotes < 8)
+		{
+			mlVRPhysicsStepNotes++;
+			Log("BunkerVR: " + alRate + " updates a second: the physics steps at most " + BunkerVR_Fixed(fWanted * 1000.0f, 2) + " ms at a time (" +
+				(fWanted > mfVRPhysicsOwnStep ? "one step to an update" : "its own") + ")\n");
+		}
+	}
+
+	// BunkerVR: for testing. Where to put a thing made by the menu, turned so
+	// that its face (its own z) looks back at the player, who looks along
+	// avAhead (level). The game's doors are 1.35 m wide along their own x, so
+	// a door made this way stands square across the player's view.
+	cMatrixf VRFacingPlayer(const cVector3f &in avPos, const cVector3f &in avAhead)
+	{
+		cVector3f vFace = avAhead * -1.0f;
+		float fYaw = cMath_ATan2(vFace.x, vFace.z);
+		cMatrixf mtxPlace = cMath_MatrixRotateY(fYaw);
+		// (Whichever way round the turn is counted, one of the two puts the
+		// thing's z on vFace.)
+		if(cMath_Vector3Dot(cMath_MatrixMul3x3(mtxPlace, cVector3f(0.0f, 0.0f, 1.0f)), vFace) < 0.99f) mtxPlace = cMath_MatrixRotateY(-fYaw);
+		mtxPlace.SetTranslation(avPos);
+		return mtxPlace;
+	}
+	
+	//------------------------------------------------------------
+	
+	void VRKeepArmsInWorld()
+	{
+		iLuxEntity@ pEnt = cLux_ID_Entity(m_idBody);
+		cMeshEntity@ pMeshEnt = pEnt !is null ? pEnt.GetMeshEntity() : null;
+		if(pMeshEnt is null) return;
+		
+		int lArms = pMeshEnt.GetSubMeshEntityIndex(pEnt.GetName() + "_player_body_soldier_arms");
+		int lHand = pMeshEnt.GetSubMeshEntityIndex(pEnt.GetName() + "_player_body_soldier_hand");
+		
+		// What they were set to (sent to the VR mod's log the first few times one was not 0).
+		cVector3f vWas(-1.0f, -1.0f, float(pMeshEnt.GetRenderLayer()));
+		if(lArms > -1) vWas.x = float(pMeshEnt.GetSubMeshEntity(lArms).GetRenderLayer());
+		if(lHand > -1) vWas.y = float(pMeshEnt.GetSubMeshEntity(lHand).GetRenderLayer());
+		
+		if(lArms > -1) pMeshEnt.GetSubMeshEntity(lArms).SetRenderLayer(0);
+		if(lHand > -1) pMeshEnt.GetSubMeshEntity(lHand).SetRenderLayer(0);
+		
+		tString sItem = Item_GetHeldEntity(eItemHandlerHand_Right);
+		if (sItem != "") Prop_SetRenderLayer(sItem, 0);
+		sItem = Item_GetHeldEntity(eItemHandlerHand_Left);
+		if (sItem != "") Prop_SetRenderLayer(sItem, 0);
+		
+		bool bAllZero = vWas.x < 0.5f && vWas.y < 0.5f && vWas.z < 0.5f && lArms > -1 && lHand > -1;
+		if((bAllZero == false || mlVRLayerNotes == 0) && mlVRLayerNotes < 12)
+		{
+			mlVRLayerNotes++;
+			// "Note 90" for the VR mod's log: arms layer, hand layer, body layer
+			// (-1 = part not found).
+			cVR_Note(90, vWas.x, vWas.y, vWas.z);
+		}
+	}
+	
