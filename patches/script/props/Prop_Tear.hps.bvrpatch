+		// BunkerVR: stored on the object itself for a hand's own hold (VRUpdateFreeHand
+		// in PlayerBodyHandler.hps), which drags a heavy object as the grab does.
+		mBaseObj.SetVarBool("BunkerVR_IsHeavy", mbGrab_IsHeavy);
=619
+	// BunkerVR: the way the joint pointed to its body when the level was
+	// loaded: a ball joint's rest, which GetJointAngle measures its bend from
+	// (for a VR hand's pull: VRTearBend in PlayerState_Interact_Tear.hps).
+	void _Global_VRRestDir()
+	{
+		cScript_SetGlobalReturnVector3f(mvOnLoadJointToBody);
+	}
