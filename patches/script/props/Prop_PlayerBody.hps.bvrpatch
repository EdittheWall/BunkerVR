+			mtxVRRight = VRRevolverKicked(mtxVRRight, mtxVRRightBeforeKick);
+			if(mbVRLeftOnGun && (lVRPalms & 1) != 0) mtxVRLeft = VRRevolverKicked(mtxVRLeft, mtxVRRightBeforeKick);
+		}
+		VRTimeMark(7088);
+		if(bVRLeftPump)
+		{
