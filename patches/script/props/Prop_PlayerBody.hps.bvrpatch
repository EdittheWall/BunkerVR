+// BunkerVR: the direction the fingers point relative to the controller's
+// forward axis: mostly along it (0.94), tilted down a little (0.34), about
+// 20 degrees.
+const float gfVRHandForward = 0.94f;
+const float gfVRHandDip = 0.34f;
+// BunkerVR: both hands must be empty for this many fresh updates (1.3 s at 90 fps)
+// before the arms' own pose and the palm's position in the hand are learned again,
+// so that an item's own animation has finished by then.
+const int glVRHandsSettleFrames = 120;
+// BunkerVR: a relearned palm position more than this far (meters) from the known one is accepted only
+// after this many fresh updates with empty hands, so that one bad reading (it can be 26 cm off) doesn't replace it at once.
+const float gfVRPalmRelearnMost = 0.04f;
+const int glVRPalmRelearnFarFrames = 600;
+// BunkerVR: the palm's position in each hand bone's local space, as it is always learned, used for a hand that holds
+// something the mod places before the palm position has been learned.
+const cVector3f gvVRPalmPointUsualLeft = cVector3f(6.949f, -2.650f, 0.194f);
+const cVector3f gvVRPalmPointUsualRight = cVector3f(-6.949f, 2.650f, -0.194f);
+// BunkerVR: the left arm with its hand on the shotgun's pump: how far the elbow moves
+// from where the arm's own rules put it towards where the forearm continues straight
+// from the hand (0 none, 1 all the way), so the wrist doesn't bend oddly...
+const float gfVRPumpElbowStraight = 0.3f;
+// ...and towards where the pump grip expects the forearm to come from: from the
+// fore-end back towards the stock, down and to the gun's left (gvVRPumpForearmFrom,
+// in the fore-end's local space: x towards the stock, y up, z towards the gun's left;
+// see the grip's note in helper_bunkervr_shotgun.hps), as a shooter's support arm
+// comes up from below. The rules' own placement keeps the rest.
+const float gfVRPumpElbowNatural = 0.6f;
+const cVector3f gvVRPumpForearmFrom = cVector3f(0.75f, -0.35f, 0.45f);
+// BunkerVR: keeps the revolver in the hand as it was aimed while the aim is released (VRSteadyGunHand):
+// the right hand's own bones (the gun's socket and the fingers). The aimed pose is captured once it has
+// been steady for gfVRGunHandSettled seconds, eased into over gfVRGunHandIn and out of over gfVRGunHandOut,
+// and held after aiming again until that has settled, for at most gfVRGunHandBackMost.
+const tString[] gvVRGunHandBones = { "j_R_HandSocket", "j_R_Thumb_1", "j_R_Thumb_2", "j_R_Thumb_3", "j_R_Index_1", "j_R_Index_2", "j_R_Index_3", "j_R_Index_4",
+									 "j_R_Mid_1", "j_R_Mid_2", "j_R_Mid_3", "j_R_Mid_4", "j_R_Ring_1", "j_R_Ring_2", "j_R_Ring_3", "j_R_Ring_4",
+									 "j_R_Pinky_1", "j_R_Pinky_2", "j_R_Pinky_3", "j_R_Pinky_4" };
+// BunkerVR: the revolver's kick in both hands (VRRevolverKicked): the muzzle is thrown up
+// this far at the kick's peak (radians: 7 degrees)...
+const float gfVRRevolverKickTurn = 0.12f;
+// ...and the gun pushed back into the hands this far (meters).
+const float gfVRRevolverKickBack = 0.025f;
+// BunkerVR: the left hand steadying the revolver follows the gun's kick in the right hand
+// (VRGunKickMotion), but not a move of more than this (meters)...
+const float gfVRGunKickCarryMost = 0.15f;
+// ...or a turn of more than 40 degrees (its cosine): the gun raised or lowered, not kicked.
+const float gfVRGunKickTurnCosMost = 0.766f;
+const float gfVRGunHandSettled = 0.25f;
+const float gfVRGunHandIn = 0.12f;
+const float gfVRGunHandOut = 0.15f;
+const float gfVRGunHandBackMost = 1.5f;
+
+//------------------------------------------------------------
+
+// BunkerVR: the left hand steadying the gun. How far its palm point sits to
+// the left of and below the right hand's (meters), and how far its fingers close.
+const float gfVRSupportLeft = 0.02f;
+const float gfVRSupportDown = 0.015f;
+const float gfVRSupportCurl = 0.85f;
+// BunkerVR: how far the left hand's fingers close while it carries a bullet to the revolver.
+const float gfVRBulletCurl = 0.55f;
+// BunkerVR: the shotgun's pump in the left hand: how far the fingers close
+// around the fore-end if the hand is drawn without its pose. (Normally the hand
+// is drawn fixed on the fore-end, posed and placed as "Holding the shotgun's
+// pump": VRLeftOnPump, glVRWorkShotgunPump.)
+const float gfVRForeEndCurl = 0.6f;
+// BunkerVR: how far the left hand's fingers close around a tool's other handle
+// (the bolt cutters' second handle; see VRFittedLeftHand).
+const float gfVRToolHandleCurl = 0.8f;
+// BunkerVR: ...and against the fuel can's bottom or end, held in both hands.
+const float gfVRCanSideCurl = 0.35f;
+// BunkerVR: ...and around the gas mask's front.
+const float gfVRMaskCurl = 0.5f;
+// BunkerVR: how far a posed hand's fingers are bent when "open" (0 = flat, 1 = a fist).
+const float gfVRRestCurl = 0.1f;
+// BunkerVR: the hand tasks that can have poses of their own (see VRWorkPose).
+// The same numbers as kSlotGunSupport... in the mod's grips.h
+// (after the game's 33 items).
+const int glVRWorkGunSupport = 33;	// the left hand steadying the gun
+const int glVRWorkBullet = 34;		// the left hand carrying a bullet to the open revolver
+const int glVRWorkCord = 35;		// the right hand pulling the flashlight's cord
+const int glVRWorkDoor = 36;		// a hand holding a door's handle
+const int glVRWorkLoose = 37;		// a hand holding a loose thing (the game's grab, or a hand's own hold)
+// BunkerVR: the bandage's place in the game's item list (as VRHeldItemIndex in
+// PlayerBodyHandler.hps): while it is wound, its tin in the left hand is posed
+// and placed as "the bandage in the left hand" (see VRAskPlacement).
+const int glVRItemBandage = 23;
+// BunkerVR: the right hand holding the bandage's roll while it is wound
+// (kSlotBandageRoll in the mod's grips.h): posed and placed as that (see
+// VRAskPlacement and VRUpdateBandage).
+const int glVRWorkBandageRoll = 38;
+// BunkerVR: a hand holding a dogtag pinched to read it (kSlotDogtag in the
+// mod's grips.h): posed as that, and the point where its thumb and first
+// finger meet is passed to the reading state (see VRNoteTagPinch).
+const int glVRWorkDogtag = 39;
+// BunkerVR: the left hand holding the shotgun's pump (kSlotShotgunPump in
+// the mod's grips.h): posed and placed as that, the hand drawn fixed on the
