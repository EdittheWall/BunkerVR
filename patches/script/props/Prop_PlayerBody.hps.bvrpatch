+const int glVRWorkShotgunPump = 40;
+// BunkerVR: the bandage wound round the left forearm (see VRUpdateBandage).
+const float gfVRBandageRadius = 0.045f;	// how thick the forearm is taken to be (meters from its center), if the mod doesn't say
+const float gfVRBandagePitch = 0.03f;	// how far each turn lies further up the arm
+const float gfVRBandageWidth = 0.6f;	// how wide the cloth is drawn (1 = 10 cm)
+const float gfVRArmNearest = 0.35f;	// the hand is never nearer the shoulder than this fraction of the arm's length (the arm backs away at its collar bone)
+const float gfVRArmStretch = 1.15f;	// a reaching arm may be stretched to this much of its own length, spread evenly along it, before the shoulder has to move
+const float gfVRBarTurnMax = 1.2f;	// a hand on a door's pull bar turns about it at most this far (radians, about 70 degrees) either side of facing the door
+
+// BunkerVR: empty hands that stop at things and push loose things (see
+// VRHandBlock). Sizes in meters at the arms' own size (they scale with them).
+// The balls are small so the hand gets down to small things on a table. Steps
+// are never longer than gfVRHandStep, and a step that can't be pushed clear
+// isn't taken, so the hand never goes through anything.
+const float gfVRHandRadius = 0.035f;	// the ball around the palm
+const float gfVRFingerRadius = 0.025f;	// the ball around the fingers
+const float gfVRFingerReach = 0.06f;	// how far ahead of the palm the fingers' ball is with the hand open (half that in a fist)
+const float gfVRHandStep = 0.015f;	// the balls move at most this far between checks
+const int glVRHandSteps = 10;		// and are checked at most this many times a frame (then they catch up next frame)
+const float gfVRHandClear = 0.002f;	// a ball still this deep in something after being pushed out has not come clear, and that step isn't taken
+const float gfVRHandJump = 0.3f;	// a palm that moves further than this in one frame has jumped (a snap turn, the view moved): the balls go along with it
+const float gfVRHandFromHeldMost = 1.0f;	// a hand let go of a handle or a rung starts from where it was held if the real hand is within this of it (meters)
+const float gfVRHandJumpBackMost = 0.6f;	// a hand that jumped into something goes back to where it was only if that is within this of the real hand; else from the eyes (meters)
+const float gfVRHandSolidMass = 15.0f;	// (only for the log: a touch on a loose thing is logged with this number; every loose thing stops a hand)
+const float gfVRHandMaxPushSpeed = 4.0f;	// a push never makes a thing faster than this
+const float gfVRHandPushForce = 25.0f;	// the most a hand pushes a loose thing with (newtons; a 1 kg can goes along easily, an 8 kg crate on the floor hardly moves)
+const float gfVRHandPressRate = 5.0f;	// pressed on a thing that holds still, it is pushed to close the gap in about 1/this of a second
+const float gfVRHandPushAccel = 20.0f;	// and a pushed thing gains speed at most this fast (m/s per second; giving it the hand's speed at once feels rigid)
+const float gfVRHandPushReach = 0.003f;	// a thing this close ahead of a moving hand counts as touched (meters; so a hand going along with a thing keeps pushing it)
+const float gfVRDoorPushForce = 30.0f;	// the most an open hand pushes a door, hatch, lid or drawer with (newtons; see VRPushPart)...
+const float gfVRDoorShoveForce = 90.0f;	// ...and this much more for each m/s the palm moves into it, up to 3 m/s (a shove; see VRHandPushForce)
+const float gfVRDoorBraceForce = 250.0f;	// a door coming at a hand is held back with up to this (newtons, or the push if more: a hand held out braces; without it a heavy door swung at a still hand passes through it)
+const float gfVRPushMakeUp = 3.0f;	// a hand pressed into a door or drawer it pushes asks for the depth to be made up at this many times it a second (see VRPushAsked)
+const float gfVRDoorFeltDensity = 15.0f;	// a door is pushed as if it weighed this much per square meter at the Feel page's "Weight" 100% (kg; the game's 1.35 x 2.4 m wooden door weighs 5, pushed as 49)
+const float gfVRDrawerFeltMass = 3.0f;	// and a drawer as if it weighed at least this (kg, at "Weight" 100%)
+const float gfVRHandLost = 1.0f;	// a hand held back further than this (beyond an arm's reach) for two seconds starts again at the real hand
+const float gfVRHandBuzzGap = 0.3f;	// a touch buzzes only after the hand has touched nothing for this long (seconds)
+const float gfVRHandTouchRoom = 0.025f;	// a thing this close to a hand's balls is touched: it can be taken hold of (meters; see VRHandTouchFind)
+const float gfVRHandNearReach = 0.05f;	// and, when nothing is, a pick-up or a small thing this much further off (small things such as bullets are hard to grab otherwise)
+const float gfVRHandNearSmall = 0.3f;	// (a small thing: the longest side of its box at most this, meters)
+const float gfVRPushDepth = 0.015f;		// a hand's ball this far into a door lock, button or switch presses it (meters; see VRPushButtons)...
+const float gfVRPushOut = 0.004f;		// ...and must come out to under this...
+const float gfVRPushRearm = 0.1f;		// ...for this long (seconds) before it presses one again
+const float gfVRPushNear = 0.6f;		// (buttons this far from the palm are checked; meters)
+const float gfVRPushBuzz = 0.05f;		// the buzz of a press (seconds)...
+const float gfVRPushBuzzStrength = 0.7f;	// ...and its strength
+const float gfVRIndexTipBeyond = 0.8f;	// the index fingertip: beyond its last bone by this much of the bone before (see VRNoteIndexTip)
+const float gfVRThumbPadBeyond = 0.45f;	// the thumb's pad: beyond its last joint by this much of the bone before (see VRNoteTagPinch)
+const float gfVRIndexPadBeyond = 0.45f;	// the first finger's tip pad: beyond its last joint by this much of the bone before
+const float gfVRTagPadOff = 0.008f;		// a dogtag lies this far from that fingertip's bone towards the thumb (its pad's thickness; meters)
+const float gfVRLockHintNear = 0.25f;	// a fingertip this near a number lock gets the hint on how to use it (meters)
+const float gfVRLockTipRadius = 0.01f;	// a number lock is touched by a ball this big around the index fingertip (meters)...
+const float gfVRLockStill = 0.3f;		// ...with the player walking no faster than this (meters per second)
+const float gfVRHandleBar = 0.015f;	// a door's handle bar, as thick each side of its center line (meters; see VRDoorHandleNear)
+const float gfVRHandleSearch = 0.12f;	// doors are looked for this much further around the hand, for their handles (the bars stand 7 to 12 cm off the door's own shape)
+const float gfVRPickupNearRadius = 6.0f;	// pick-ups this far from a hand are listed for VRNearPickupByLook (meters)...
+const float gfVRPickupNearEvery = 0.2f;	// ...and listed again this often (seconds)
+// A hand is at a ladder (VRHandAtLadder) in its area or this far around it
+// (meters; the hand's balls)...
+const float gfVRLadderReachAround = 0.08f;
+// ...and up to this far above its top, so it can be climbed onto from above by
+// reaching down towards it (the pillbox ladder's top is under the floor, and
+// the game's helper area over its hole is at floor level).
+const float gfVRLadderReachTop = 1.0f;
+// On a ladder the upper body is bent towards the real head by at most this much
+// (radians, 45 degrees; VRLadderLean).
+const float gfVRLadderLeanMost = 0.79f;
+// On a ladder the drawn shoulders are placed where they are when standing (VRLadderLean;
+// PlayerBodyHandler.hps gfVRChestBehindNeck and gfVRChestBelowNeck): their center this
+// far behind the real neck and this far below it (meters)...
+const float gfVRLadderBodyChestBehind = 0.05f;
+const float gfVRLadderBodyChestBelow = 0.15f;
+// ...the real neck this far below the real eyes and this far behind them, along the
+// head (as gfVRNeckToEyesUp and gfVRNeckToEyesForward there)...
+const float gfVRLadderBodyNeckUp = 0.14f;
+const float gfVRLadderBodyNeckIn = 0.11f;
+// ...for which the whole body is moved, as standing (the legs bent back to the feet
+// on the rungs), at most this far down, up, out from the ladder, in towards it and
+// aside (meters; VRLadderHipsMove)...
+const float gfVRLadderHipsDownMost = 0.35f;
+const float gfVRLadderHipsUpMost = 0.12f;
+const float gfVRLadderHipsOutMost = 0.35f;
+const float gfVRLadderHipsInMost = 0.25f;
+const float gfVRLadderHipsAsideMost = 0.30f;
+// The bones VRLadderLean moves (VRLadderBoneName).
+const int glVRLadderBones = 17;
+// hpl.log counts the updates on a ladder with the shoulders further than this from
+// under the real neck (meters; as PlayerBodyHandler.hps gfVRLadderLeanHide, where
+// the torso is left out).
+const float gfVRLadderMissNoted = 0.25f;
+// ...and logs each new body pose held this long (seconds), the first this many
+// each time on a ladder.
+const float gfVRLadderPoseHeld = 0.5f;
+const int glVRLadderPoseNotes = 8;
+const int glVRFingerPoseChecks = 8;		// a hand's kept finger pose is checked against posing it afresh this many times each map before it is reused (VRFingersKeptFits)...
+const float gfVRFingerPoseSame = 0.01f;	// ...and is the same while no axis of any bone differs by more than this (about half a degree), nor its position by this fraction
+// (Posing afresh itself differs by rounding from one place in the world to another, up to about 0.0012 in Soldier
+// Quarters, far from the world's origin; a real fault, a finger bent the wrong way or not at all, differs by tenths or more.)
+const float gfVRGlueTurnMost = 1.0f;	// a hand fixed to what it holds is turned at most this far from the real hand (radians, 57 degrees; see VRGlueToHeld)
+const float gfVRHandOnThingMost = 1.0f;	// and drawn on it only while that is at most this far from the real hand (meters; as gfBunkerVR_HandOffMost in helper_bunkervr.hps)
+const float gfVRTouchHintKeep = 0.3f;	// touching the same thing again within this long does not tick again (seconds)
+const float gfVRTouchHintBuzz = 0.02f;	// each of the two ticks for a thing the hand can take hold of: this long (seconds)...
+const float gfVRTouchHintStrength = 0.3f;	// ...this strong (0 to 1)...
+const float gfVRTouchHintGap = 0.09f;	// ...and the second this long after the first (seconds)
+const float gfVRArmsBackTime = 0.5f;	// after a knockdown, a kill or a death that took the arms, they return to the controllers over this (seconds; VRArmsLeftToMove)
+const float gfVRCarryClear = 0.25f;	// a person carried over the shoulder: his bones kept at least this far from the real eyes (meters; see VRKeepCarriedClear)...
+const float gfVRCarryPushMost = 0.4f;	// ...moved off by at most this much (meters)...
+const float gfVRCarryRoom = 0.05f;	// ...and, once the eyes are further away than that by this much, moved back...
+const float gfVRCarryBack = 0.3f;	// ...at this speed (meters per second)
+const int glVRBandagePieces = 80;		// how many flat pieces the cloth can be made of (sixteen per turn around the arm, and up to sixteen through the air)
+// BunkerVR: the legs (see UpdateVRLegs). A planted foot steps once it is this
+// far (meters) from where the body wants it...
+const float gfVRStepStart = 0.22f;
+// ...or turned this far from it (radians: about 26 degrees; small enough that turning
+// while seated, with the body following the head after 30 degrees, still takes steps),
+const float gfVRStepTurn = 0.45f;
+// A step is one for turning on the spot (a quieter footstep: see
+// VRFootstepSound) if the body has gone less than this far (meters, level)
+// since that foot last came down. (Walking, it goes a stride: 30 cm or more.)
+const float gfVRStepQuietTravel = 0.15f;
+// Real-body stealth: a real step's pace is how fast the body went (level, game meters per second) while that
+// foot was in the air. Slower than gfVRStepPaceCareful is a careful step, played as the game's sneaking step (its
+// soft sound, heard within 2 m); faster than gfVRStepPaceHurried is a hurried one, played as its running step
+// (heard within 10 m; crouched, as its walking step); in between is walking (3 m), the game's own step
+// (MoveState_Normal.hps _Global_VRPacedFootSound). Other VR stealth designs count the real body's pace too: Espire 1's
+// guards react to the speed of physical movement, and a CHI 2021 study of sneaking in VR (arXiv 2102.02024)
+// makes every real step make noise.
+// At the world's scale (1.162), careful is under about 0.4 m/s in the room and hurried over about 1.55. Faster
+// than gfVRStepPaceNotAStep is the game moving the body (a jump, a push), not a pace: counted as walking.
+const float gfVRStepPaceCareful = 0.45f;
+const float gfVRStepPaceHurried = 1.8f;
+const float gfVRStepPaceNotAStep = 5.0f;
+// A step takes this long (seconds) and lifts the foot this high at its middle (meters, at the
+// body's own size).
+const float gfVRStepTime = 0.3f;
+const float gfVRStepLift = 0.08f;
+// While the game turns the body (the stick), a step takes this long,
+const float gfVRStepTimeTurning = 0.2f;
+// a planted foot is carried around only past this twist off the body's facing (radians:
+// about 46 degrees; VRFootCarry),
+const float gfVRFootTwistMost = 0.8f;
+// and a turn of more than this in one update (radians: about 20 degrees) is a snap turn: both feet
+// are carried around whole.
+const float gfVRSnapTurnLeast = 0.35f;
+// The shortest the legs may be made (a fraction of their length) to fit under the hips.
+const float gfVRLegFitMin = 0.55f;
+// Out of reach, a leg may be stretched to this much of that length (as the
+// arms are) before its foot leaves its place.
+const float gfVRLegStretch = 1.12f;
