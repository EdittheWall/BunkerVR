+	[nosave] float mfVRElbowMove = 0.0f;	// BunkerVR: how much the elbows move with the hands (set by the mod)
+	[nosave] cVector3f[] mvVRElbowSide = {0, 0};	// BunkerVR: which side each elbow was on last frame (left, right), in the body's own directions (outwards, up, backwards)
+	[nosave] bool mbVRFootPlacementOff = false;	// BunkerVR: did we switch the foot placement off?
+	[nosave] bool mbVRReloadOpen = false;	// BunkerVR: is the revolver open (ammo check)?
+	[nosave] bool mbVRGunInHand = false;	// BunkerVR: is a gun held in the tracked right hand?
+	[nosave] array<cMatrixf> mvVRGunHandPose;	// BunkerVR: the right hand's own bones (gvVRGunHandBones) as the revolver's aim had them (VRSteadyGunHand)...
+	[nosave] array<cMatrixf> mvVRGunHandSet;	// ...as last set
+	[nosave] bool mbVRGunHandPoseKnown = false;	// ...taken
+	[nosave] bool mbVRGunHandHolding = false;	// ...held in it (or easing out of it)
+	[nosave] float mfVRGunHandWeight = 0.0f;	// ...how far (0 .. 1)
+	[nosave] int mlVRGunHandState = -1;			// ...the player's state at the last update
+	[nosave] float mfVRGunHandStateFor = 0.0f;	// ...and for how long
+	[nosave] float mfVRGunHandStillFor = 0.0f;	// ...how long the gun's socket has been settled in the animation
+	[nosave] cMatrixf m_mtxVRGunSocketWas = cMatrixf_Identity;	// ...the socket as animated at the last update
+	[nosave] int mlVRGunHandNotes = 0;			// ...notes written to the log
+	[nosave] bool mbVRLeftOnGun = false;	// BunkerVR: has the left hand taken hold of the gun?
+	[nosave] bool mbVRBarrelKnown = false;	// BunkerVR: has the barrel's direction within the hand been worked out?
+	[nosave] float mfVRBarrelHold = 0.0f;	// BunkerVR: seconds until the barrel may be worked out again (after the revolver is flicked shut)
+	[nosave] cVector3f mvVRGunAngles = cVector3f(0.0f);	// BunkerVR: how the gun sits in the hand (radians): barrel right, barrel up, top leaning right
+	[nosave] cVector3f mvVRBarrelInHand = cVector3f(0.0f, 0.0f, 1.0f);	// BunkerVR: that direction, as the hand bone sees it
+	[nosave] bool mbVRShotgunInHand = false;	// BunkerVR: is the gun in the right hand the shotgun?...
+	[nosave] bool mbVRForeEndKnown = false;		// ...has where its fore-end lies within the hand been worked out...
+	[nosave] cVector3f mvVRForeEndInHand = cVector3f(0.0f);	// ...and that place, as the hand bone sees it (VRMeasureGunBarrel)...
+	[nosave] float mfVRGunSize = 1.0f;			// ...and the size the gun is drawn at (VRLeftOnPump)...
+	[nosave] bool mbVRGunUpKnown = false;		// ...and whether which way is up on it is known in the hand...
+	[nosave] cVector3f mvVRGunUpInHand = cVector3f(0.0f, 1.0f, 0.0f);	// ...and that, as the hand bone sees it (VRMeasureGunBarrel)
+	[nosave] bool mbVRPumpGrip = false;			// BunkerVR: has "Holding the shotgun's pump" its own placement (see VRAskPlacement)...
+	[nosave] cMatrixf m_mtxVRPumpGrip = cMatrixf_Identity;	// ...that placement (the fore-end in the left palm's terms)...
+	[nosave] bool mbVRPumpSend = false;			// ...does the mod want the helper's told (7086 .. 7088)...
+	[nosave] cVector3f mvVRPumpGripAt = gvBunkerVR_PumpGripAt;	// ...and the grip used: where the fore-end's middle is in the palm...
+	[nosave] cVector3f mvVRPumpGripY = gvBunkerVR_PumpGripY;	// ...its own y (up)...
+	[nosave] cVector3f mvVRPumpGripZ = gvBunkerVR_PumpGripZ;	// ...and its own z (towards the gun's left; VRLeftOnPump)
+	[nosave] cVector3f mvVRFingerMarkL = cVector3f(99.0f);	// BunkerVR: how each hand's first finger bone was left after its fingers were bent
+	[nosave] cVector3f mvVRFingerMarkR = cVector3f(99.0f);
+	[nosave] array<int> mvVRFingersLeftMode = {0, 0};	// BunkerVR: how each hand's fingers were last posed from their rest shape (0 not, 1 UpdateVRFingersPosed, 2 UpdateVRFingersFull)...
+	[nosave] array<cVector3f> mvVRFingersLeftMark = {cVector3f(99.0f), cVector3f(99.0f)};	// ...how its first finger bone was left then...
+	[nosave] bool mbVRFingersKeptLogged = false;	// BunkerVR: the first time they were kept, logged
+	[nosave] array<cMatrixf> mvVRFingerPoseKept;		// BunkerVR: each finger bone as a hand was last posed from rest (its own matrix; 20 slots a hand, see VRFindBones)...
+	[nosave] array<int> mvVRFingerPoseKeptMode = {0, 0};	// ...by which way (0 none kept, 1 UpdateVRFingersPosed, 2 UpdateVRFingersFull)...
+	[nosave] array<cVector3f> mvVRFingerPoseKeptFrom = {cVector3f(0.0f), cVector3f(0.0f), cVector3f(0.0f), cVector3f(0.0f), cVector3f(0.0f), cVector3f(0.0f), cVector3f(0.0f), cVector3f(0.0f)};	// ...from what numbers (four for each hand)...
+	[nosave] cMeshEntity@ mpVRFingerPoseKeptMesh = null;	// ...and in which mesh
+	[nosave] int mlVRFingerPoseChecks = 0;				// BunkerVR: how many times the kept pose has been checked against posing afresh (VRFingersKeptCheck)...
+	[nosave] float mfVRFingerPoseWorst = 0.0f;			// ...the largest difference found (of the axes, and of the places)...
+	[nosave] float mfVRFingerPoseWorstAxes = 0.0f;
+	[nosave] float mfVRFingerPoseWorstPlace = 0.0f;
+	[nosave] bool mbVRFingerPoseOff = false;			// ...and whether they differed, so that none is put back in this map
+	[nosave] array<cVector3f> mvVRFingersLeftFrom = {cVector3f(0.0f), cVector3f(0.0f), cVector3f(0.0f), cVector3f(0.0f), cVector3f(0.0f), cVector3f(0.0f), cVector3f(0.0f), cVector3f(0.0f)};	// ...and from what numbers (four for each hand)
