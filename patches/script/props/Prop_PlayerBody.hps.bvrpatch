+
+			if(mbVRLeftOnGun && mbVRShotgunInHand)
+			{
+				// The shotgun's pump in the left hand: the hand stays
+				// where the real one is (the barrel is aimed through it, see
+				// UpdateVRArm, and the fore-end slides with it: Prop_Shotgun.hps),
+				// its fingers round the fore-end.
+				fVRCurlLeft = gfVRForeEndCurl;
+				if(lVRFingersLeft != 0)
+				{
+					lVRFingersLeft = 1;
+					vVRFingersLeft = cVector3f(gfVRForeEndCurl * 0.8f, gfVRForeEndCurl, gfVRForeEndCurl * 1.1f);
+				}
+			}
+			else if(mbVRLeftOnGun)
+			{
+				// Turned the same way as the right hand (so its palm faces the
+				// gun and its fingers lie along the right hand's). Both palm
+				// points are the middle of what the hand holds, so the left one
+				// goes almost on top of the right one: just far enough left to
+				// lie over the right hand's fingers, and a little lower.
+				cVector3f vSupport = mtxVRRight.GetTranslation() + cMath_MatrixMul3x3(mtxVRRight, cVector3f(vVRSupport.x * -1.0f, vVRSupport.y * -1.0f, vVRSupport.z * -1.0f));
+				mtxVRLeft = mtxVRRight;
+				mtxVRLeft.SetTranslation(vSupport);
+				fVRCurlLeft = fVRSupportCurl;
+				if(lVRFingersLeft != 0)
+				{
+					lVRFingersLeft = 1;
+					vVRFingersLeft = cVector3f(fVRSupportCurl * 0.8f, fVRSupportCurl, fVRSupportCurl);
+				}
+			}
+		}
+
+		// The left hand on a tool's other handle (see VRFittedLeftHand): its
+		// fingers closed around it. A hand holding the gas mask: its fingers
+		// around the mask's front.
+		if(mbVRLeftFittedNow)
+		{
+			// (The fuel can is held flat against its bottom or end: the fingers only bent
+			// around its edge, gfVRCanSideCurl.)
+			float fVRToolCurl = Item_GetHeldType(eItemHandlerHand_Right) == "Fuel" ? gfVRCanSideCurl : gfVRToolHandleCurl;
+			fVRCurlLeft = fVRToolCurl;
+			if(lVRFingersLeft != 0)
+			{
+				lVRFingersLeft = 1;
+				vVRFingersLeft = cVector3f(fVRToolCurl * 0.8f, fVRToolCurl, fVRToolCurl * 1.05f);
+			}
+		}
+		if(mlVRMaskHandNow == 1 || mlVRMaskHandNow == 2)
+		{
+			if(mlVRMaskHandNow == 1)
+			{
+				fVRCurlLeft = gfVRMaskCurl;
+				if(lVRFingersLeft != 0)
+				{
+					lVRFingersLeft = 1;
+					vVRFingersLeft = cVector3f(gfVRMaskCurl * 0.7f, gfVRMaskCurl, gfVRMaskCurl);
+				}
+			}
+			else
+			{
+				fVRCurlRight = gfVRMaskCurl;
+				if(lVRFingersRight != 0)
+				{
+					lVRFingersRight = 1;
+					vVRFingersRight = cVector3f(gfVRMaskCurl * 0.7f, gfVRMaskCurl, gfVRMaskCurl);
+				}
+			}
+		}
+		// A hand drawn holding something (PlayerBodyHandler.hps VRHandFingers: the finale's detonator and cord, and the
+		// fuel tap's lever): the fingers it asks for, the thumb, the first finger and the rest (a pinch on a wing nut
+		// or the cord's end, a fist around the T-bar or the lever), for as long as it keeps asking
+		// ("BunkerVR_HandFingersAt0/1": the game time it last did).
+		float fVRFinaleNow = float(cEngine_GetGameTime());
+		for(int h = 0; h < 2; ++h)
+		{
+			float fVRAsked = cScript_GetGlobalVarFloat(h == 0 ? "BunkerVR_HandFingersAt0" : "BunkerVR_HandFingersAt1");
+			if(fVRAsked <= 0.0f || fVRFinaleNow - fVRAsked > 0.15f || fVRFinaleNow < fVRAsked) continue;
+			cVector3f vVRAskedFingers = cScript_GetGlobalVarVector3f(h == 0 ? "BunkerVR_HandFingers0" : "BunkerVR_HandFingers1");
+			if(h == 0 && lVRFingersLeft != 0)
+			{
+				fVRCurlLeft = vVRAskedFingers.y;
+				lVRFingersLeft = 1;
+				vVRFingersLeft = vVRAskedFingers;
+			}
+			else if(h == 1 && lVRFingersRight != 0)
+			{
+				fVRCurlRight = vVRAskedFingers.y;
+				lVRFingersRight = 1;
+				vVRFingersRight = vVRAskedFingers;
+			}
+		}
+		
+		// (Don't lean the spine to put the chest under the real head: the game
+		// places the whole body by a point on its head, "CameraSocket", so moving
+		// the spine moves that point, the game moves the body to make up for it,
+		// and the player is pushed about whenever the head moves. Each arm is
+		// brought under the head by its collar bone instead, see UpdateVRArm.)
+		// Is nothing held in either hand? (Then the arms' animated pose is kept, see UpdateVRArm.)
+		mbVRBothHandsEmpty = lVRFingersLeft == 1 && lVRFingersRight == 1 && bVRGun == false && mbVRBulletInHand == false && mbVRCordHeld == false && mbVRLeftOnGun == false;
+		// ...and for long enough that an item's own animation, put away or used
+		// up (a holster, a bandage's use), is over: only then are the arms' own
+		// pose and the palm's position in the hand learned. (Learned any sooner,
+		// an item's animation can leave the hands in the wrong place.)
+		if(mbVRFreshPose) mlVRHandsEmptyFrames = mbVRBothHandsEmpty ? mlVRHandsEmptyFrames + 1 : 0;
