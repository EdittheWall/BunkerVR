+			mvVRPumpGripY = mbVRPumpGrip ? cMath_MatrixMul3x3(m_mtxVRPumpGrip, cVector3f(0.0f, 1.0f, 0.0f)) : gvBunkerVR_PumpGripY;
+			mvVRPumpGripZ = mbVRPumpGrip ? cMath_MatrixMul3x3(m_mtxVRPumpGrip, cVector3f(0.0f, 0.0f, 1.0f)) : gvBunkerVR_PumpGripZ;
