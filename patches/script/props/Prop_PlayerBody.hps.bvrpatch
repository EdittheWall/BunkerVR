+				// real hand, not the drawn one: the drawn hand stops at the
+				// knob's face, so it would never go in.)
+				VRTimeMark(7086);
+				if(lVRPalms == 1 || lVRPalms == 3) VRPushButtons(0, mtxVRLeftReal, fVRCurlLeft, fVRArmScale, bVRLeftHolds == false && bVRLeftBusy == false);
+				if(lVRPalms == 2 || lVRPalms == 3) VRPushButtons(1, mtxVRRightReal, fVRCurlRight, fVRArmScale, bVRRightHolds == false && bVRRightBusy == false);
+				VRTimeMark(7087);
+			}
+		}
+
+		// Kept for the bandage's code (VRUpdateBandage), which runs later.
+		mlVRPalmsNow = lVRPalms;
+		m_mtxVRPalmLeft = mtxVRLeft;
+		m_mtxVRPalmRight = mtxVRRight;
+
+		// While the body is drawn bigger (see PlayerBodyHandler.hps) its feet are
+		// below the floor. The engine's foot placement would bend the legs to
+		// lift them back up, so it is switched off for that time.
+		if(mpFootPlacement !is null)
+		{
+			float fVRBodySize = cMath_MatrixMul3x3(mBaseObj.GetMatrix(), cVector3f(1.0f, 0.0f, 0.0f)).Length();
+			bool bVRBigBody = fVRBodySize > 1.01f;
+			if(bVRBigBody && mbVRFootPlacementOff == false)
+			{
+				mpFootPlacement.SetActive(false);
+				mbVRFootPlacementOff = true;
+			}
+			else if(bVRBigBody == false && mbVRFootPlacementOff)
+			{
+				mpFootPlacement.SetActive(true);
+				mbVRFootPlacementOff = false;
+			}
+		}
+		
+		// (How far short of its hand each arm is, for the body's handler: nothing, until UpdateVRArm says otherwise.)
+		cScript_SetGlobalVarVector3f("BunkerVR_ReachShortLeft", cVector3f(0.0f, 0.0f, 0.0f));
+		cScript_SetGlobalVarVector3f("BunkerVR_ReachShortRight", cVector3f(0.0f, 0.0f, 0.0f));
