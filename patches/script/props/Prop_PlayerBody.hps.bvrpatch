+			mvVRStillFacing = vVRFacing;
+		}
+		mbVRStill = mlVRStillFrames > 40;
+
+		// Hand poses of their own (the mod's hand poses tool and its Grips
+		// page): for what each hand is doing (steadying the gun,
+		// carrying a bullet, pulling the cord, holding a door or a loose
