+		}
+		else if(mbVRLeftOnGun && mbVRGunInHand && mbVRShotgunInHand == false && lVRPalms == 3)
+		{
+			// The left hand steadying the revolver: the right arm first, then the left hand
+			// carried by the gun's own kick in the right hand (VRGunKickMotion), so that it
+			// follows the gun at each shot.
+			UpdateVRArm(pVRMesh, false, "j_R_Arm_1", "j_R_Arm_3", "j_R_Wrist", mtxVRRight, fVRArmScale, fVRCurlRight, lVRFingersRight, vVRFingersRight, bVRPoseRight, bVRPalmAsEmptyRight);
+			UpdateVRArm(pVRMesh, true, "j_L_Arm_1", "j_L_Arm_3", "j_L_Wrist", cMath_MatrixMul(VRGunKickMotion(pVRMesh), mtxVRLeft), fVRArmScale, fVRCurlLeft, lVRFingersLeft, vVRFingersLeft, bVRPoseLeft, bVRPalmAsEmptyLeft);
+		}
+		else
+		{
+			if(lVRPalms == 1 || lVRPalms == 3)
+				UpdateVRArm(pVRMesh, true, "j_L_Arm_1", "j_L_Arm_3", "j_L_Wrist", mtxVRLeft, fVRArmScale, fVRCurlLeft, lVRFingersLeft, vVRFingersLeft, bVRPoseLeft, bVRPalmAsEmptyLeft);
+			if(lVRPalms == 2 || lVRPalms == 3)
+				UpdateVRArm(pVRMesh, false, "j_R_Arm_1", "j_R_Arm_3", "j_R_Wrist", mtxVRRight, fVRArmScale, fVRCurlRight, lVRFingersRight, vVRFingersRight, bVRPoseRight, bVRPalmAsEmptyRight);
+		}
+		VRTimeMark(7089);
+		VRArmsComeBack(pVRMesh); // (after a knockdown, a kill or a death)
+		
+		if(mbVRArmNote) VRBodyNotes();
+		mbVRArmNote = false;
+	}
+	
+	//------------------------------------------------------------
+	
+	// The palm of a hand holding a thing (a_mtxPalm: as drawn so far; alHand:
+	// 0 left, 1 right), put where the holding code says it sits on the thing,
+	// on the thing as it is now (see BunkerVR_HoldGlue in helper_bunkervr.hps),
+	// so the hand doesn't lag behind the thing when it moves or turns. Turned
+	// with it ("BunkerVR_HoldGlueTurn0/1": one hand, with weight), at most
+	// gfVRGlueTurnMost from the real hand; or only moved with it (on its place
+	// on a heavy thing, or with both hands). As drawn so far when nothing is
+	// set, or when it would be more than gfVRHandOnThingMost from there.
+	cMatrixf VRGlueToHeld(int alHand, const cMatrixf &in a_mtxPalm)
+	{
+		tID idBody = cScript_GetGlobalVarID("BunkerVR_HoldBody" + alHand);
+		if(idBody == tID_Invalid) return a_mtxPalm;
+		iPhysicsBody@ pBody = cLux_ID_Body(idBody);
+		if(pBody is null) return a_mtxPalm;
+		cMatrixf mtxOnIt = cScript_GetGlobalVarMatrix("BunkerVR_HoldPalm" + alHand);
+		float fSize = cMath_MatrixMul3x3(mtxOnIt, cVector3f(1.0f, 0.0f, 0.0f)).Length();
+		if(fSize < 0.9f || fSize > 1.1f) return a_mtxPalm; // (not a pure rotation: never set)
+		cMatrixf mtxGlued = cMath_MatrixMul(pBody.GetLocalMatrix(), mtxOnIt);
+		if((mtxGlued.GetTranslation() - a_mtxPalm.GetTranslation()).Length() > gfVRHandOnThingMost) return a_mtxPalm;
+
+		// For the log, a few times while a held thing moves: how far it has
+		// moved since its holding code last looked at it ("BunkerVR_HoldSeen0/1").
+		// About an update's move means the physics moves things between the
+		// holding code and this, so the hold-back alone would be an update behind
+		// (which this fixes). About none means this runs before the physics moves
+		// it, and the hand still trails it by an update's move.
+		float fSpeed = pBody.GetLinearVelocity().Length();
+		if(mbVRFreshPose && mlVRGlueNotes < 12 && fSpeed > 0.5f && mfVRArmStep > 0.0001f)
+		{
+			mlVRGlueNotes++;
+			cVector3f vSeen = cScript_GetGlobalVarMatrix("BunkerVR_HoldSeen" + alHand).GetTranslation();
+			Log("BunkerVR: arms posed with a held thing moving at " + int(fSpeed * 100.0f + 0.5f) + " cm a second: it had moved " +
+				int((pBody.GetLocalPosition() - vSeen).Length() * 1000.0f + 0.5f) + " mm since its hold last looked at it (an update's move: " +
+				int(fSpeed * mfVRArmStep * 1000.0f + 0.5f) + " mm)\n");
+		}
+
+		cMatrixf mtxPalm = a_mtxPalm;
+		mtxPalm.SetTranslation(mtxGlued.GetTranslation());
+		if(cScript_GetGlobalVarBool("BunkerVR_HoldGlueTurn" + alHand) == false) return mtxPalm;
+		// Turned with it, but never further than gfVRGlueTurnMost from how the
+		// real hand is turned (a thing knocked round by something it hit).
+		cMatrixf mtxReal = a_mtxPalm.GetRotation();
+		cMatrixf mtxTurned = mtxGlued.GetRotation();
+		cMatrixf mtxOff = cMath_MatrixMul(mtxTurned, cMath_MatrixInverse(mtxReal));
+		float fTrace = cMath_MatrixMul3x3(mtxOff, cVector3f(1.0f, 0.0f, 0.0f)).x + cMath_MatrixMul3x3(mtxOff, cVector3f(0.0f, 1.0f, 0.0f)).y + cMath_MatrixMul3x3(mtxOff, cVector3f(0.0f, 0.0f, 1.0f)).z;
+		float fAngle = cMath_ACos(cMath_Clamp((fTrace - 1.0f) * 0.5f, -1.0f, 1.0f));
+		if(fAngle > gfVRGlueTurnMost) mtxTurned = BunkerVR_Slerp(gfVRGlueTurnMost / fAngle, mtxReal, mtxTurned); // (without the engine's NaN)
+		mtxTurned.SetTranslation(mtxGlued.GetTranslation());
+		return mtxTurned;
+	}
+
+	// The turn that brings direction avFrom onto direction avTo by the shortest way.
+	cMatrixf VRTurnBetween(const cVector3f &in avFrom, const cVector3f &in avTo, const cVector3f &in avAxisIfOpposite)
+	{
+		cVector3f vA = cMath_Vector3Normalize(avFrom);
+		cVector3f vB = cMath_Vector3Normalize(avTo);
+		cVector3f vAxis = cMath_Vector3Cross(vA, vB);
+		float fSin = vAxis.Length();
+		float fCos = cMath_Vector3Dot(vA, vB);
+		
+		if(fSin < 0.0001f)
+		{
+			if(fCos > 0.0f) return cMatrixf_Identity; // already there
+			vAxis = cMath_Vector3Normalize(avAxisIfOpposite); // exactly the other way: half a turn
+			fSin = 0.0f;
+		}
+		else
+		{
+			vAxis = vAxis * (1.0f / fSin);
+		}
+		float fAngle = cMath_ATan2(fSin, fCos);
+		
+		// Maths libraries differ in which way round a positive angle turns.
+		// Make both, and keep the one that really brings avFrom onto avTo.
+		cQuaternion qOneWay;
+		qOneWay.FromAngleAxis(fAngle, vAxis);
+		cMatrixf mtxOneWay = cMath_MatrixQuaternion(qOneWay);
+		
+		cQuaternion qOtherWay;
+		qOtherWay.FromAngleAxis(-fAngle, vAxis);
+		cMatrixf mtxOtherWay = cMath_MatrixQuaternion(qOtherWay);
+		
+		if(cMath_Vector3Dot(cMath_MatrixMul3x3(mtxOneWay, vA), vB) >= cMath_Vector3Dot(cMath_MatrixMul3x3(mtxOtherWay, vA), vB))
+			return mtxOneWay;
+		return mtxOtherWay;
+	}
+	
+	// BunkerVR: on a ladder. The body stands on the ladder where the game's
+	// climbing has it (PlayerBodyHandler.hps doesn't slide it under the real head
+	// there: its legs and feet would float with every lean), and here it is fitted
+	// under the real head as a climber's would be. Bending the upper body towards
+	// the real eyes is not enough: eyes that look down at the rungs, or duck a
+	// little, come lower and nearer than a bend can reach, and then the torso is
+	// left out, or the view looks down into the collar from above it. So, as when
+	// standing (PlayerBodyHandler.hps UpdateOrientation: the whole body moved so
+	// that the middle of its shoulders is under the real neck,
+	// gfVRLadderBodyChestBehind and gfVRLadderBodyChestBelow, which nodding or
+	// turning the head doesn't move):
+	//  1. the whole body is moved there (the spine and both hips, off which all of
+	//     it hangs) as far as gfVRLadderHips*Most allow (VRLadderHipsMove), the
+	//     legs bent back so that the feet stay where the climbing has them on the
+	//     rungs (VRBendLeg: ducking bends the knees);
+	//  2. what that leaves (the head further off still) the upper body leans
+	//     towards, bent at the bottom of the spine (j_Spine_1, with all that hangs
+	//     off it: the chest, the collar bones and arms, the neck and the head), by
+	//     up to gfVRLadderLeanMost.
+	// (Don't leave all of it to the bend with the hips moving only up or down: at
+	// rest that puts the hips at their highest with a 36 degree bend, the neck out
+	// in front of the eyes, and the torso is sometimes left out.) How far the
+	// shoulders still are from there goes to the body script
+	// ("BunkerVR_LadderLeanMiss"), which leaves the torso out only while that is
+	// far (VRHideTorsoWhenLying). Only in the frame's second pass, once the
+	// camera is in its place (_Global_VRUpdateArms; the camera hangs on the
+	// CameraSocket, which no bone moves), each time from the bones as the animation
+	// left them (VRLadderKeepFresh, VRLadderPutBack), and not in the game's own
+	// camera animations (a kill on the ladder: "BunkerVR_LadderBend").
+	void VRLadderLean(cMeshEntity@ apMesh)
+	{
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		if(apMesh is null || pPlayer is null || pPlayer.GetCurrentStateId() != ePlayerState_Ladder) return;
+		if(cScript_GetGlobalVarBool("BunkerVR_LadderBend") == false) return;
+		cCamera@ pCam = pPlayer.GetCamera();
+		if(pCam is null) return;
+		float fRealRoll = pCam.GetRoll();
+		pCam.SetRoll(7006.0f);
+		cVector3f vStatus = pCam.GetMatrix().GetTranslation();
+		bool bHead = vStatus.x > 12344.0f && vStatus.x < 12346.0f && vStatus.y > 0.5f;
+		cMatrixf mtxHead = cMatrixf_Identity;
+		if(bHead)
+		{
+			pCam.SetRoll(7005.0f);
+			mtxHead = pCam.GetMatrix();
+		}
+		pCam.SetRoll(fRealRoll);
+		if(bHead == false) return;
+		VRLadderPutBack(apMesh);
+		cBoneState@ pSpine = apMesh.GetBoneStateFromName("j_Spine_1");
+		cBoneState@ pChest = apMesh.GetBoneStateFromName("j_Spine_3");
+		cBoneState@ pLeftHip = apMesh.GetBoneStateFromName("j_L_Hip");
+		cBoneState@ pRightHip = apMesh.GetBoneStateFromName("j_R_Hip");
+		if(pSpine is null || pChest is null || pLeftHip is null || pRightHip is null) return;
+		// (Which way the body faces, level: at the ladder; and its right.)
+		cVector3f vFwd = cMath_MatrixMul3x3(mBaseObj.GetMatrix(), cVector3f(0.0f, 0.0f, 1.0f));
+		vFwd.y = 0.0f;
+		if(vFwd.Length() < 0.0001f) return;
+		vFwd.Normalize();
+		cVector3f vSide = cMath_Vector3Cross(cVector3f(0.0f, 1.0f, 0.0f), vFwd);
+		// Where the middle of the shoulders is wanted: under the real neck, as when standing.
+		cVector3f vNeck = mtxHead.GetTranslation() - cMath_MatrixMul3x3(mtxHead, cVector3f(0.0f, gfVRLadderBodyNeckUp, -gfVRLadderBodyNeckIn));
+		cVector3f vWanted = vNeck - vFwd * gfVRLadderBodyChestBehind;
+		vWanted.y = vNeck.y - gfVRLadderBodyChestBelow;
+		// (The middle of the shoulders, from the chest bone, as PlayerBodyHandler.hps finds it.)
+		cVector3f vNeed = vWanted - cMath_MatrixMul(pChest.GetWorldMatrix(), cVector3f(5.5855f, 12.3856f, 0.0f));
+
+		// 1. The whole body moved there, as far as it may; the legs bent back to the feet.
+		cVector3f vHipsMove = VRLadderHipsMove(vNeed, vFwd);
+		if(vHipsMove.Length() > 0.0005f)
+		{
+			// (Each foot as the climbing has it, and which way its knee bends: as animated, or
+			// towards the ladder for a leg nearly straight.)
+			array<cMatrixf> vFoot(2);
+			array<cVector3f> vKneeSide(2);
+			bool bLegs = true;
+			for(int lSide = 0; lSide < 2; ++lSide)
+			{
+				tString sSide = lSide == 0 ? "j_L_" : "j_R_";
+				cBoneState@ pThigh = apMesh.GetBoneStateFromName(sSide + "Leg_1");
+				cBoneState@ pKnee = apMesh.GetBoneStateFromName(sSide + "Leg_3");
+				cBoneState@ pFoot = apMesh.GetBoneStateFromName(sSide + "Foot");
+				if(pThigh is null || pKnee is null || pFoot is null)
+				{
+					bLegs = false;
+					break;
+				}
+				vFoot[lSide] = pFoot.GetWorldMatrix();
+				cVector3f vHip = pThigh.GetWorldPosition();
+				cVector3f vLine = vFoot[lSide].GetTranslation() - vHip;
+				if(vLine.Length() < 0.01f)
+				{
+					bLegs = false;
+					break;
+				}
+				vLine.Normalize();
+				cVector3f vBent = (pKnee.GetWorldPosition() - vHip) - vLine * cMath_Vector3Dot(pKnee.GetWorldPosition() - vHip, vLine);
+				vKneeSide[lSide] = vBent.Length() > 0.01f ? cMath_Vector3Normalize(vBent) : vFwd;
+			}
+			// (All the body hangs off these three: the spine and the two hips.)
+			VRMoveBoneTo(pSpine, pSpine.GetWorldPosition() + vHipsMove);
+			VRMoveBoneTo(pLeftHip, pLeftHip.GetWorldPosition() + vHipsMove);
+			VRMoveBoneTo(pRightHip, pRightHip.GetWorldPosition() + vHipsMove);
+			if(bLegs)
+			{
+				// (At the leg's own length: VRBendLeg shortens or draws out a leg by mfVRLegFit, for standing.)
+				float fFitWas = mfVRLegFit;
+				mfVRLegFit = 1.0f;
+				for(int lSide = 0; lSide < 2; ++lSide)
+				{
+					tString sSide = lSide == 0 ? "j_L_" : "j_R_";
+					cBoneState@ pThigh = apMesh.GetBoneStateFromName(sSide + "Leg_1");
+					cBoneState@ pKnee = apMesh.GetBoneStateFromName(sSide + "Leg_3");
+					cBoneState@ pFoot = apMesh.GetBoneStateFromName(sSide + "Foot");
+					cVector3f vHip = pThigh.GetWorldPosition();
+					float fLeg = (pKnee.GetWorldPosition() - vHip).Length() + (pFoot.GetWorldPosition() - pKnee.GetWorldPosition()).Length();
+					// (Out of reach: the foot lifts, the leg no longer than it is.)
+					cVector3f vTarget = vFoot[lSide].GetTranslation();
+					cVector3f vReach = vTarget - vHip;
+					if(vReach.Length() > fLeg * 0.995f) vTarget = vHip + cMath_Vector3Normalize(vReach) * (fLeg * 0.995f);
+					VRBendLeg(apMesh, sSide, vTarget, vFoot[lSide], vKneeSide[lSide]);
+				}
+				mfVRLegFit = fFitWas;
+			}
+		}
+
+		// 2. The upper body leaned towards what is left, no further than gfVRLadderLeanMost.
+		cVector3f vPivot = pSpine.GetWorldPosition();
+		cVector3f vDrawn = cMath_MatrixMul(pChest.GetWorldMatrix(), cVector3f(5.5855f, 12.3856f, 0.0f)) - vPivot;
+		cVector3f vToWanted = vWanted - vPivot;
+		cMatrixf mtxTurn = cMatrixf_Identity;
+		float fBend = 0.0f;
+		if(vDrawn.Length() > 0.1f && vToWanted.Length() > 0.1f)
+		{
+			cVector3f vFrom = cMath_Vector3Normalize(vDrawn);
+			cVector3f vTo = cMath_Vector3Normalize(vToWanted);
+			float fCos = cMath_Clamp(cMath_Vector3Dot(vFrom, vTo), -1.0f, 1.0f);
+			if(fCos < cMath_Cos(gfVRLadderLeanMost))
+			{
+				cVector3f vAcross = vTo - vFrom * fCos;
+				if(vAcross.Length() < 0.0001f) vTo = vFrom;
+				else vTo = vFrom * cMath_Cos(gfVRLadderLeanMost) + cMath_Vector3Normalize(vAcross) * cMath_Sin(gfVRLadderLeanMost);
+			}
+			fBend = cMath_ACos(cMath_Clamp(cMath_Vector3Dot(vFrom, vTo), -1.0f, 1.0f));
+			if(fBend > 0.0005f)
+			{
+				mtxTurn = VRTurnBetween(vFrom, vTo, cMath_Vector3Cross(vFrom, cVector3f(0.0f, 1.0f, 0.0f)));
+				VRTurnBoneAbout(pSpine, mtxTurn, vPivot);
+			}
+		}
+		VRLadderNoteSet(apMesh);
+		float fMiss = (vPivot + cMath_MatrixMul3x3(mtxTurn, vDrawn) - vWanted).Length();
+		cScript_SetGlobalVarFloat("BunkerVR_LadderLeanMiss", fMiss);
+		cScript_SetGlobalVarFloat("BunkerVR_LadderLeanTime", float(cEngine_GetGameTime()));
+
+		// (For hpl.log: each new pose held still for gfVRLadderPoseHeld, the first glVRLadderPoseNotes
+		// each time on a ladder; and the largest of each once off it, VRLadderKeepFresh.)
+		mlVRLadderLeanUpdates++;
+		mfVRLadderMostDown = cMath_Max(mfVRLadderMostDown, -vHipsMove.y);
+		mfVRLadderMostUp = cMath_Max(mfVRLadderMostUp, vHipsMove.y);
+		mfVRLadderMostAcross = cMath_Max(mfVRLadderMostAcross, cVector3f(vHipsMove.x, 0.0f, vHipsMove.z).Length());
+		mfVRLadderMostBend = cMath_Max(mfVRLadderMostBend, fBend);
+		mfVRLadderMostMiss = cMath_Max(mfVRLadderMostMiss, fMiss);
+		if(fMiss > gfVRLadderMissNoted) mlVRLadderFarUpdates++;
+		double fNow = cEngine_GetGameTime();
+		if((vHipsMove - mvVRLadderPoseMove).Length() > 0.01f || cMath_Abs(fBend - mfVRLadderPoseBend) > 0.035f)
+		{
+			mvVRLadderPoseMove = vHipsMove;
+			mfVRLadderPoseBend = fBend;
+			mfVRLadderPoseSince = fNow;
+		}
+		else if(mlVRLadderLeanNotes < glVRLadderPoseNotes && float(fNow - mfVRLadderPoseSince) > gfVRLadderPoseHeld &&
+				(mbVRLadderPoseNoted == false || (vHipsMove - mvVRLadderNotedMove).Length() > 0.04f || cMath_Abs(fBend - mfVRLadderNotedBend) > 0.14f))
+		{
+			mlVRLadderLeanNotes++;
+			mbVRLadderPoseNoted = true;
+			mvVRLadderNotedMove = vHipsMove;
+			mfVRLadderNotedBend = fBend;
+			// (And how near the drawn neck is to the real one: the head on the body.)
+			cBoneState@ pDrawnNeck = apMesh.GetBoneStateFromName("j_Neck");
+			tString sNeck = "";
+			if(pDrawnNeck !is null) sNeck = "; the drawn neck " + VRLadderCm(pDrawnNeck.GetWorldPosition() - vNeck, vFwd, vSide) + " of the real one";
+			Log("BunkerVR ladder: the body fitted under the real head: the shoulders as climbing has them " + VRLadderCm(vNeed * -1.0f, vFwd, vSide) +
+				" of where wanted; the body moved " + VRLadderCm(vHipsMove, vFwd, vSide) + ", the upper body leant " + int(cMath_ToDeg(fBend) + 0.5f) +
+				" degrees, the shoulders then " + int(fMiss * 100.0f + 0.5f) + " cm off" + sNeck + "\n");
+		}
+	}
+
+	// BunkerVR: how far the whole body is moved on a ladder (VRLadderLean)
+	// for the shoulders to go avNeed further: in towards the ladder (avFwd, level),
+	// up and aside each no further than gfVRLadderHips*Most.
+	cVector3f VRLadderHipsMove(const cVector3f &in avNeed, const cVector3f &in avFwd)
+	{
+		cVector3f vSide = cMath_Vector3Cross(cVector3f(0.0f, 1.0f, 0.0f), avFwd);
+		float fIn = cMath_Clamp(cMath_Vector3Dot(avNeed, avFwd), -gfVRLadderHipsOutMost, gfVRLadderHipsInMost);
+		float fAside = cMath_Clamp(cMath_Vector3Dot(avNeed, vSide), -gfVRLadderHipsAsideMost, gfVRLadderHipsAsideMost);
+		float fUp = cMath_Clamp(avNeed.y, -gfVRLadderHipsDownMost, gfVRLadderHipsUpMost);
+		return avFwd * fIn + vSide * fAside + cVector3f(0.0f, fUp, 0.0f);
+	}
+
+	// BunkerVR: a move in the ladder's terms for hpl.log, in whole centimeters: "N in, N up, N aside"
+	// (in: towards the ladder, avFwd; aside: avSide).
+	tString VRLadderCm(const cVector3f &in avMove, const cVector3f &in avFwd, const cVector3f &in avSide)
+	{
+		return "" + VRLadderCmOne(cMath_Vector3Dot(avMove, avFwd)) + " in, " + VRLadderCmOne(avMove.y) + " up, " + VRLadderCmOne(cMath_Vector3Dot(avMove, avSide)) + " aside";
+	}
+
+	int VRLadderCmOne(float afMetres)
+	{
+		return int(afMetres * 100.0f + (afMetres < 0.0f ? -0.5f : 0.5f));
+	}
+
+	// BunkerVR: the bones VRLadderLean moves, glVRLadderBones of them:
+	// the bottom of the spine, the two hips, and each leg's bones down to its foot.
+	tString VRLadderBoneName(int alIndex)
+	{
+		if(alIndex == 0) return "j_Spine_1";
+		if(alIndex == 1) return "j_L_Hip";
+		if(alIndex == 2) return "j_R_Hip";
+		int lLink = (alIndex - 3) % 7;
+		tString sSide = alIndex - 3 < 7 ? "j_L_" : "j_R_";
+		if(lLink == 6) return sSide + "Foot";
+		return sSide + "Leg_" + (lLink + 1);
+	}
+
+	// BunkerVR: in the frame's first pass (the bones as the animation has just left
+	// them), on a ladder, those bones are stored as they are, for VRLadderLean to start
+	// from each time it runs: it moves the body by how far the shoulders
+	// are from where they are wanted, so it must not start from where it left them
+	// (a frame with no animation update between: VRLadderPutBack). A bone the
+	// animation has not posed since VRLadderLean set it (it is still as that left
+	// it, VRLadderNoteSet) keeps what was kept for it. Off a ladder: nothing kept,
+	// and one line for hpl.log on how the body was fitted while on it.
+	void VRLadderKeepFresh(cMeshEntity@ apMesh)
+	{
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		if(apMesh is null || pPlayer is null || pPlayer.GetCurrentStateId() != ePlayerState_Ladder)
+		{
+			if(mlVRLadderLeanUpdates > 0)
+			{
+				Log("BunkerVR ladder: off the ladder; the body was fitted under the real head " + mlVRLadderLeanUpdates + " times: moved down at most " +
+					int(mfVRLadderMostDown * 100.0f + 0.5f) + " cm, up at most " + int(mfVRLadderMostUp * 100.0f + 0.5f) + " cm, across at most " +
+					int(mfVRLadderMostAcross * 100.0f + 0.5f) + " cm; the upper body leant at most " + int(cMath_ToDeg(mfVRLadderMostBend) + 0.5f) +
+					" degrees; the shoulders at most " + int(mfVRLadderMostMiss * 100.0f + 0.5f) + " cm from under the real neck, more than " +
+					int(gfVRLadderMissNoted * 100.0f + 0.5f) + " cm " + mlVRLadderFarUpdates + " times\n");
+			}
+			mlVRLadderLeanUpdates = 0;
+			mlVRLadderFarUpdates = 0;
+			mfVRLadderMostDown = 0.0f;
+			mfVRLadderMostUp = 0.0f;
+			mfVRLadderMostAcross = 0.0f;
+			mfVRLadderMostBend = 0.0f;
+			mfVRLadderMostMiss = 0.0f;
+			mlVRLadderLeanNotes = 0;
+			mbVRLadderPoseNoted = false;
+			mbVRLadderFreshKnown = false;
+			mbVRLadderSetKnown = false;
+			return;
+		}
+		if(mvVRLadderFresh.length() < uint(glVRLadderBones)) mvVRLadderFresh.resize(glVRLadderBones);
+		bool bSetKnown = mbVRLadderFreshKnown && mbVRLadderSetKnown && mvVRLadderSet.length() >= uint(glVRLadderBones);
+		for(int i = 0; i < glVRLadderBones; ++i)
+		{
+			cBoneState@ pBone = apMesh.GetBoneStateFromName(VRLadderBoneName(i));
+			if(pBone is null)
+			{
+				mbVRLadderFreshKnown = false;
+				return;
+			}
+			cMatrixf mtxNow = pBone.GetLocalMatrix();
+			if(bSetKnown && VRSameMatrix(mtxNow, mvVRLadderSet[i])) continue;
+			mvVRLadderFresh[i] = mtxNow;
+		}
+		mbVRLadderFreshKnown = true;
+	}
+
+	// BunkerVR: those bones put back as the animation left them (VRLadderKeepFresh).
+	void VRLadderPutBack(cMeshEntity@ apMesh)
+	{
+		if(mbVRLadderFreshKnown == false || mvVRLadderFresh.length() < uint(glVRLadderBones)) return;
+		for(int i = 0; i < glVRLadderBones; ++i)
+		{
+			cBoneState@ pBone = apMesh.GetBoneStateFromName(VRLadderBoneName(i));
+			if(pBone !is null) pBone.SetMatrix(mvVRLadderFresh[i]);
+		}
+	}
+
+	// BunkerVR: and as VRLadderLean leaves them, to tell in the next
+	// first pass whether the animation has posed them since.
+	void VRLadderNoteSet(cMeshEntity@ apMesh)
+	{
+		if(mvVRLadderSet.length() < uint(glVRLadderBones)) mvVRLadderSet.resize(glVRLadderBones);
+		for(int i = 0; i < glVRLadderBones; ++i)
+		{
+			cBoneState@ pBone = apMesh.GetBoneStateFromName(VRLadderBoneName(i));
+			if(pBone is null)
+			{
+				mbVRLadderSetKnown = false;
+				return;
+			}
+			mvVRLadderSet[i] = pBone.GetLocalMatrix();
+		}
+		mbVRLadderSetKnown = true;
+	}
+
+	// BunkerVR: are two bone matrices the same, position and rotation (up to rounding)?
+	bool VRSameMatrix(const cMatrixf &in a_mtxA, const cMatrixf &in a_mtxB)
+	{
+		if((a_mtxA.GetTranslation() - a_mtxB.GetTranslation()).Length() > 0.0001f) return false;
+		if((cMath_MatrixMul3x3(a_mtxA, cVector3f(1.0f, 0.0f, 0.0f)) - cMath_MatrixMul3x3(a_mtxB, cVector3f(1.0f, 0.0f, 0.0f))).Length() > 0.0001f) return false;
+		return (cMath_MatrixMul3x3(a_mtxA, cVector3f(0.0f, 1.0f, 0.0f)) - cMath_MatrixMul3x3(a_mtxB, cVector3f(0.0f, 1.0f, 0.0f))).Length() <= 0.0001f;
+	}
+
+	// Turns a bone (and everything hanging off it) about a point in the world.
+	void VRTurnBoneAbout(cBoneState@ apBone, const cMatrixf &in a_mtxTurn, const cVector3f &in avPivot)
+	{
+		cMatrixf mtxOld = apBone.GetWorldMatrix();
+		cVector3f vOldPos = mtxOld.GetTranslation();
+		
+		cMatrixf mtxNew = cMath_MatrixMul(a_mtxTurn, mtxOld);
+		mtxNew.SetTranslation(avPivot + cMath_MatrixMul3x3(a_mtxTurn, vOldPos - avPivot));
+		apBone.SetWorldMatrix(mtxNew);
+	}
+
+	// BunkerVR: the turn that brings direction avFromA onto avToA and, about
+	// that, direction avFromB as near onto avToB as it can go (as when a
+	// hinge's arm and its pin are both put where they are wanted).
+	cMatrixf VRTurnFrame(const cVector3f &in avFromA, const cVector3f &in avFromB, const cVector3f &in avToA, const cVector3f &in avToB)
+	{
+		cMatrixf mtxFirst = VRTurnBetween(avFromA, avToA, avFromB);
+		cVector3f vA = cMath_Vector3Normalize(avToA);
+		cVector3f vBNow = cMath_MatrixMul3x3(mtxFirst, avFromB);
+		vBNow = vBNow - vA * cMath_Vector3Dot(vBNow, vA);
+		cVector3f vBWanted = avToB - vA * cMath_Vector3Dot(avToB, vA);
+		if(vBNow.Length() < 0.000001f || vBWanted.Length() < 0.000001f) return mtxFirst;
+		return cMath_MatrixMul(VRTurnBetween(vBNow, vBWanted, vA), mtxFirst);
+	}
+
+	// BunkerVR: a hand on a door's pull bar. The line through its fist (where
+	// a held rod runs: the controller's own grip line, (0, 0.87, -0.5) in its
+	// pointing directions, from the palm pose relative to the pointing pose)
+	// lies along the bar, its thumb's end always at the bar's top, so the hand
+	// closes around the bar. About the bar it turns left and right with the
+	// controller, but only so far either side of facing the door
+	// (`gfVRBarTurnMax`). (Following the controller freely, the hand would go
+	// through the bar when tilted up or down, and turn upside down when
+	// twisted far enough.) Without a bar (0 0 0) only the position is set.
+	cMatrixf VRHoldBar(const cMatrixf &in a_mtxPalm, const cVector3f &in avGrip, const cVector3f &in avBar, const cVector3f &in avOut)
+	{
+		cMatrixf mtxHeld = a_mtxPalm;
+		if(avBar.Length() > 0.5f)
+		{
+			cVector3f vBar = cMath_Vector3Normalize(avBar);
+			cVector3f vRod = cMath_Vector3Normalize(cMath_MatrixMul3x3(a_mtxPalm, cVector3f(0.0f, 0.866f, -0.5f)));
+			// A bar to be held either way round (given as twice as long: a
+			// drawer's handle, a wheel's rim) is held the way the
+			// hand already lies along it, so neither hand is turned palm up.
+			if(avBar.Length() > 1.5f && cMath_Vector3Dot(vBar, vRod) < 0.0f) vBar = vBar * -1.0f;
+			// The way the fist points, square to the rod (the controller's
+			// pointing direction with the rod's share taken out).
+			cVector3f vPointNow = cMath_MatrixMul3x3(a_mtxPalm, cVector3f(0.0f, -0.5f, -0.866f));
+			cVector3f vPoint = vPointNow - vBar * cMath_Vector3Dot(vPointNow, vBar);
+			if(vPoint.Length() < 0.05f) vPoint = avOut.Length() > 0.5f ? avOut * -1.0f : cMath_MatrixMul3x3(a_mtxPalm, cVector3f(1.0f, 0.0f, 0.0f));
+			vPoint = vPoint - vBar * cMath_Vector3Dot(vPoint, vBar);
+			if(vPoint.Length() < 0.05f) return mtxHeld;
+			vPoint.Normalize();
+
+			if(avOut.Length() > 0.5f)
+			{
+				cVector3f vFacing = avOut * -1.0f; // towards the door
+				vFacing = vFacing - vBar * cMath_Vector3Dot(vFacing, vBar);
+				if(vFacing.Length() > 0.05f)
+				{
+					vFacing.Normalize();
+					float fAngle = cMath_ATan2(cMath_Vector3Dot(vBar, cMath_Vector3Cross(vFacing, vPoint)), cMath_Vector3Dot(vFacing, vPoint));
+					float fKept = cMath_Clamp(fAngle, -gfVRBarTurnMax, gfVRBarTurnMax);
+					if(fKept != fAngle) vPoint = vFacing * cMath_Cos(fKept) + cMath_Vector3Cross(vBar, vFacing) * cMath_Sin(fKept);
+				}
+			}
+			mtxHeld = cMath_MatrixMul(VRTurnFrame(vRod, vPointNow, vBar, vPoint), a_mtxPalm);
+		}
+		mtxHeld.SetTranslation(avGrip);
+		return mtxHeld;
+	}
+
+	// BunkerVR: the right hand fitting an item into what it is used on (a key
+	// in its lock; see VRUpdateFit in PlayerBodyHandler.hps): the body script
+	// says each update where the hand is to be drawn, with a new stamp
+	// ("BunkerVR_FitStamp"; 0 when it has stopped, and one unchanged for three
+	// updates has stopped too). abFollowed: the right hand is being followed.
+	// True, and a_mtxHand that place, while it fits.
+	bool VRFittedHand(bool abFollowed, cMatrixf &out a_mtxHand)
+	{
+		a_mtxHand = cMatrixf_Identity;
+		int lStamp = cScript_GetGlobalVarInt("BunkerVR_FitStamp");
+		if(lStamp != mlVRFitStampSeen)
+		{
+			mlVRFitStampSeen = lStamp;
+			mlVRFitStaleFrames = 0;
+		}
+		else if(mbVRFreshPose)
+		{
+			mlVRFitStaleFrames++;
+		}
+		if(lStamp == 0 || mlVRFitStaleFrames >= 3 || abFollowed == false) return false;
+		cMatrixf mtxHand = cMatrixf_Identity;
+		mtxHand.SetRight(cScript_GetGlobalVarVector3f("BunkerVR_FitRight"));
+		mtxHand.SetUp(cScript_GetGlobalVarVector3f("BunkerVR_FitUp"));
+		mtxHand.SetForward(cScript_GetGlobalVarVector3f("BunkerVR_FitForward"));
+		mtxHand.SetTranslation(cScript_GetGlobalVarVector3f("BunkerVR_FitAt"));
+		a_mtxHand = mtxHand;
+		return true;
+	}
+
+	// BunkerVR: where the item fitted by the right hand is (see VRFittedHand),
+	// while the hand is drawn fitted this frame: put exactly there, not left to
+	// follow the hand (the game's own animation of a held item can move it on
+	// the hand's socket a little). True, and a_mtxThing that place, while so.
+	bool VRFittedThing(cMatrixf &out a_mtxThing)
+	{
+		a_mtxThing = cMatrixf_Identity;
+		if(mbVRRightFittedNow == false) return false;
+		cMatrixf mtxThing = cMatrixf_Identity;
+		mtxThing.SetRight(cScript_GetGlobalVarVector3f("BunkerVR_FitThingRight"));
+		mtxThing.SetUp(cScript_GetGlobalVarVector3f("BunkerVR_FitThingUp"));
+		mtxThing.SetForward(cScript_GetGlobalVarVector3f("BunkerVR_FitThingForward"));
+		mtxThing.SetTranslation(cScript_GetGlobalVarVector3f("BunkerVR_FitThingAt"));
+		a_mtxThing = mtxThing;
+		return true;
+	}
+
+	// BunkerVR: the left hand holding the other handle of a tool held with both
+	// hands (the bolt cutters; VRUpdateCutters in
+	// PlayerBodyHandler.hps): as VRFittedHand, from "BunkerVR_LeftFitStamp"
+	// and its place. True, and a_mtxHand that place, while it holds it.
+	bool VRFittedLeftHand(bool abFollowed, cMatrixf &out a_mtxHand)
+	{
+		a_mtxHand = cMatrixf_Identity;
+		int lStamp = cScript_GetGlobalVarInt("BunkerVR_LeftFitStamp");
+		if(lStamp != mlVRLeftFitStampSeen)
+		{
+			mlVRLeftFitStampSeen = lStamp;
+			mlVRLeftFitStaleFrames = 0;
+		}
+		else if(mbVRFreshPose)
+		{
+			mlVRLeftFitStaleFrames++;
+		}
+		if(lStamp == 0 || mlVRLeftFitStaleFrames >= 3 || abFollowed == false) return false;
+		cMatrixf mtxHand = cMatrixf_Identity;
+		mtxHand.SetRight(cScript_GetGlobalVarVector3f("BunkerVR_LeftFitRight"));
+		mtxHand.SetUp(cScript_GetGlobalVarVector3f("BunkerVR_LeftFitUp"));
+		mtxHand.SetForward(cScript_GetGlobalVarVector3f("BunkerVR_LeftFitForward"));
+		mtxHand.SetTranslation(cScript_GetGlobalVarVector3f("BunkerVR_LeftFitAt"));
+		a_mtxHand = mtxHand;
+		return true;
+	}
+	
+	// BunkerVR: a hand pressing against a door, hatch, lid or drawer (anything
+	// on a hinge or a rail: a body with a joint of its own). The first touch is
+	// found by casting the palm's path since last frame (from 3 cm behind it to
+	// 4 cm ahead), or the path of a thing coming at the palm (VRFirstPress);
+	// from then on the touch is kept as a place and a direction on the thing,
+	// which move with it. While the palm is less than 4 cm from that face (its
+	// own thickness), the thing is moved so that its face comes back to the
+	// hand (VRPushPart), the deeper the faster, and the hand is drawn on the
+	// face, not through it. Let go when the palm is 10 cm off the face, 35 cm
+	// along it, or 40 cm through it. Loose things are left alone, so that
+	// reaching for a can doesn't knock it away. (Pushed by knocks instead, the
+	// door feels punched, and the hand goes through.)
+	// Returns how far the drawn hand is moved from the palm (0 0 0: not at all).
+	cVector3f VRHandPress(int alHand, const cVector3f &in avPalm, bool abBusy)
+	{
+		cVector3f vLast = mvVRPushLast[alHand];
+		mvVRPushLast[alHand] = avPalm;
+		if(mfVRPushBuzzWait[alHand] > 0.0f) mfVRPushBuzzWait[alHand] -= mfVRArmStep;
+		if(mfVRPushNoteWait[alHand] > 0.0f) mfVRPushNoteWait[alHand] -= mfVRArmStep;
+		if(mfVRTouchNotFor[alHand] > 0.0f) mfVRTouchNotFor[alHand] -= mfVRArmStep;
+		if(mbVRPushKnown[alHand] == false)
+		{
+			mbVRPushKnown[alHand] = true;
+			return cVector3f(0.0f);
+		}
+		if(abBusy || mfVRArmStep < 0.0001f)
+		{
+			if(abBusy) mfVRPressFreeFor[alHand] = 0.0f;
+			mvVRTouchBody[alHand] = tID_Invalid;
+			return cVector3f(0.0f);
+		}
+		mfVRPressFreeFor[alHand] += mfVRArmStep;
+
+		iPhysicsBody@ pBody = null;
+		if(mvVRTouchBody[alHand] != tID_Invalid) @pBody = cLux_ID_Body(mvVRTouchBody[alHand]);
+		if(pBody is null)
+		{
+			mvVRTouchBody[alHand] = tID_Invalid;
+			@pBody = VRFirstPress(alHand, avPalm, vLast);
+			if(pBody is null) return cVector3f(0.0f);
+		}
+
+		cMatrixf mtxBody = pBody.GetLocalMatrix();
+		cVector3f vFace = cMath_MatrixMul(mtxBody, mvVRTouchPoint[alHand]);
+		cVector3f vOut = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxBody, mvVRTouchOut[alHand]));
+		float fOff = cMath_Vector3Dot(avPalm - vFace, vOut); // how far in front of the face
+		cVector3f vAlong = (avPalm - vFace) - vOut * fOff;
+		if(fOff > 0.10f || fOff < -0.40f || vAlong.Length() > 0.35f)
+		{
+			// Gone through it: that hand doesn't touch it again while it is
+			// behind that face (see VRTouchRefused).
+			if(fOff < -0.40f)
+			{
+				mvVRTouchNot[alHand] = pBody.GetID();
+				mvVRTouchNotPoint[alHand] = mvVRTouchPoint[alHand];
+				mvVRTouchNotOut[alHand] = mvVRTouchOut[alHand];
+				mfVRTouchNotFor[alHand] = 10.0f;
+			}
+			VRDoorNote(alHand, pBody, "lets go of", fOff > 0.10f ? "the palm 10 cm off its face" : (fOff < -0.40f ? "the palm 40 cm through it" : "the palm 35 cm along its face"));
+			mvVRTouchBody[alHand] = tID_Invalid;
+			return cVector3f(0.0f);
+		}
+		VRLearnHinge(alHand, pBody);
+
+		float fDepth = 0.04f - fOff; // how far the palm is into the hand's own thickness from the face
+		// The palm's own speed into the face (from where it was at the last
+		// update, as drawn on the face then), the mean of this update's and the
+		// last one's (one update's alone carries the tracking's own tremble
+		// straight into the door).
+		float fInto = cMath_Vector3Dot(avPalm - vLast, vOut * -1.0f) / mfVRArmStep;
+		if((avPalm - vLast).Length() > 0.3f) fInto = 0.0f; // (not across a jump of the view)
+		float fIntoMean = (fInto + mfVRPushIntoWas[alHand]) * 0.5f;
+		mfVRPushIntoWas[alHand] = fInto;
+		fInto = fIntoMean < 0.05f ? 0.0f : fIntoMean; // (under 5 cm a second it is the tracking's own tremble)
+		if(fDepth <= -0.01f || (fDepth <= 0.0f && fInto <= 0.0f)) return cVector3f(0.0f); // near, not pressing
+
+		// Pushed: the face goes with the palm (while the palm is within a centimeter of the hand's
+		// thickness from it and moving in, or pressed in). The speed asked for is VRPushAsked's: the
+		// palm's own speed into it, or, if more, the depth it is pressed in made up at gfVRPushMakeUp.
+		// (Moved by the depth alone, a quick shove goes 40 cm through before the door has come up to
+		// speed, and a slow one shoves, lets the door coast off the hand, and shoves again, many times a
+		// second.) (Not a wheel: see VRFirstPress.) No faster than the hand's own force moves it,
+		// against the weight it is pushed as (VRPushPart), so a heavy door lags the hand and the palm
+		// goes deeper in; and the harder the hand pushes, the stronger the buzz.
+		float fSpeed = VRPushAsked(fInto, fDepth);
+		if(mbVRTouchNoPush[alHand]) return vOut * cMath_Max(fDepth, 0.0f);
+		float fPushed = 0.0f; // (how much of the hand's force it took)
+		if(fSpeed > 0.01f) fPushed = VRPushPart(alHand, pBody, avPalm - vOut * fOff, vOut * -1.0f, fSpeed, fInto, fDepth);
+		if(fDepth > 0.0f && mfVRPushBuzzWait[alHand] <= 0.0f)
+		{
+			VRBuzzHand(alHand, 0.03f, 0.25f + 0.5f * fPushed);
+			mfVRPushBuzzWait[alHand] = 0.25f;
+		}
+		return vOut * cMath_Max(fDepth, 0.0f);
+	}
+
+	// BunkerVR: the first touch of a hand on a thing on a joint (see
+	// VRHandPress): along the palm's own path since the last update, or else a
+	// thing coming at the palm (so that a door swung at a hand held still, or
+	// at one moving slower than the door, doesn't go through it). Keeps the
+	// touch; returns what is pushed (null: nothing).
+	iPhysicsBody@ VRFirstPress(int alHand, const cVector3f &in avPalm, const cVector3f &in avLast)
+	{
+		iPhysicsBody@ pBody = null;
+		cVector3f vHitAt = avPalm;
+		cVector3f vHitOut = cVector3f(0.0f);
+		bool bOncoming = false;
+		cVector3f vMove = avPalm - avLast;
+		float fMove = vMove.Length();
+		// (Not along the palm's path while it is still, under half a millimeter
+		// a frame (4.5 cm a second), or across a jump: the view moved. A larger
+		// "still" lets a hand reaching slowly for a door go through it.)
+		if(fMove >= 0.0005f && fMove <= 0.5f)
+		{
+			cVector3f vDir = vMove * (1.0f / fMove);
+			cVector3f vStart = avLast - vDir * 0.03f;
+			float fHit = 0.0f;
+			cVector3f vNormal = cVector3f(0.0f);
+			@pBody = VRPushedBody(cLux_GetClosestBody(vStart, vDir, fMove + 0.07f, fHit, vNormal));
+			if(pBody !is null)
+			{
+				vHitOut = vNormal.Length() > 0.1f ? cMath_Vector3Normalize(vNormal) : vDir * -1.0f;
+				if(cMath_Vector3Dot(vHitOut, vDir) > 0.0f) vHitOut = vHitOut * -1.0f; // towards the hand
+				vHitAt = vStart + vDir * fHit;
+			}
+		}
+		// (Not in the first 0.4 seconds after the hand let go of a door's
+		// handle or a drawer's, or anything else it held: it is still right in
+		// front of what it pulled, which would have stopped on it.)
+		if(pBody is null && mfVRPressFreeFor[alHand] > 0.4f)
+		{
+			cVector3f vPalmSpeed = fMove <= 0.3f ? vMove * (1.0f / mfVRArmStep) : cVector3f(0.0f);
+			@pBody = VRPushedBody(VRFindOncoming(avPalm, vPalmSpeed, vHitAt, vHitOut));
+			bOncoming = true;
+		}
+		if(pBody is null) return null;
+
+		// On a rail, only a face that looks towards the eyes: a hand inside a
+		// drawer (after letting go of its handle) would find the inside of its
+		// front coming out and "push" it towards the player, so the drawer would
+		// come with the hand and the hand stick to it. Not on a hinge: a door
+		// that has swung open away from the player is pushed back by a hand
+		// behind it, on its face that looks away from the eyes; a hand that went
+		// through a door is kept off its far face by VRTouchRefused instead.
+		if(VRBodyOwnJoint(pBody).GetType() == ePhysicsJointType_Slider &&
+		   cMath_Vector3Dot(vHitOut, cLux_GetPlayer().GetCamera().GetPosition() - vHitAt) <= 0.0f) return null;
+		if(VRTouchRefused(alHand, pBody, avPalm)) return null;
+
+		cMatrixf mtxInto = cMath_MatrixInverse(pBody.GetLocalMatrix());
+		mvVRTouchBody[alHand] = pBody.GetID();
+		mvVRTouchPoint[alHand] = cMath_MatrixMul(mtxInto, vHitAt);
+		mvVRTouchOut[alHand] = cMath_MatrixMul3x3(mtxInto, vHitOut);
+		mfVRPushIntoWas[alHand] = 0.0f;
+		mbVRPushAngleKnown[alHand] = false;
+		// A wheel isn't turned by an open hand pressed on it and rubbed
+		// around, only by holding it: the hand is still drawn on its face.
+		iLuxEntity@ pTouched = cLux_GetBodyEntity(pBody);
+		cLuxMap@ pTouchMap = cLux_GetCurrentMap();
+		mbVRTouchNoPush[alHand] = pTouched !is null && pTouchMap !is null &&
+								  pTouchMap.GetEntityByName(pTouched.GetName(), eLuxEntityType_Prop, "cScrPropWheel") !is null;
+		VRDoorNote(alHand, pBody, "touches", bOncoming ? "it came at the palm" : "along the palm's path");
+		return pBody;
+	}
+
+	// BunkerVR: a thing on a joint coming at the palm (see VRFirstPress).
+	// Each body near the palm whose face there comes at the
+	// palm at over 5 cm a second (its own speed less the palm's, avPalmSpeed)
+	// is looked for from the palm back the way it comes, from where the palm
+	// was against it at the last update (as along the palm's own path, but
+	// the other way about) to 7 cm ahead. avAt, avOut: where its face was
+	// found and which way it looks (towards the palm).
+	iPhysicsBody@ VRFindOncoming(const cVector3f &in avPalm, const cVector3f &in avPalmSpeed, cVector3f &out avAt, cVector3f &out avOut)
+	{
+		avAt = avPalm;
+		avOut = cVector3f(0.0f);
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		if(pMap is null || pMap.GetPhysicsWorld() is null) return null;
+		array<iPhysicsBody@> vBodies;
+		pMap.GetPhysicsWorld().GetBodiesInAABB(avPalm - cVector3f(0.15f), avPalm + cVector3f(0.15f), true, false, vBodies);
+		for(uint i = 0; i < vBodies.length(); i++)
+		{
+			iPhysicsBody@ pNear = vBodies[i];
+			if(pNear is null || VRPushedBody(pNear) is null) continue;
+			cVector3f vSpeed = pNear.GetVelocityAtPosition(avPalm) - avPalmSpeed;
+			float fSpeed = vSpeed.Length();
+			if(fSpeed < 0.05f) continue;
+			cVector3f vWay = vSpeed * (1.0f / fSpeed);
+			float fBack = fSpeed * mfVRArmStep + 0.03f;
+			float fHit = 0.0f;
+			cVector3f vNormal = cVector3f(0.0f);
+			iPhysicsBody@ pHit = cLux_GetClosestBody(avPalm + vWay * fBack, vWay * -1.0f, fBack + 0.07f, fHit, vNormal);
+			if(pHit is null || pHit !is pNear || vNormal.Length() < 0.1f) continue;
+			cVector3f vHitOut = cMath_Vector3Normalize(vNormal);
+			if(cMath_Vector3Dot(vHitOut, vWay) < 0.2f) continue; // (not the face that comes first)
+			avAt = avPalm + vWay * (fBack - fHit);
+			avOut = vHitOut;
+			return pNear;
+		}
+		return null;
+	}
+
+	// BunkerVR: the joint a body turns or slides on: the one it hangs from
+	// (as its child), not one that hangs from it (on a door with a handle,
+	// the body's first joint can be the handle's own little hinge). Null:
+	// none.
+	iPhysicsJoint@ VRBodyOwnJoint(iPhysicsBody@ apBody)
+	{
+		if(apBody is null) return null;
+		for(int i = 0; i < apBody.GetJointNum(); i++)
+		{
+			iPhysicsJoint@ pJoint = apBody.GetJoint(i);
+			if(pJoint !is null && pJoint.GetChildBody() is apBody) return pJoint;
+		}
+		return null;
+	}
+
+	// BunkerVR: what a hand that touches apBody pushes: the body
+	// itself when it is on a joint of its own, or what it hangs from when that
+	// is on one too (a handle pushes its door). Null: nothing (a loose thing,
+	// or a fixed one).
+	iPhysicsBody@ VRPushedBody(iPhysicsBody@ apBody)
+	{
+		iPhysicsBody@ pBody = apBody;
+		for(int i = 0; i < 3 && pBody !is null; i++)
+		{
+			if(pBody.GetMass() <= 0.0f) return null;
+			iPhysicsJoint@ pJoint = VRBodyOwnJoint(pBody);
+			if(pJoint is null) return null;
+			iPhysicsBody@ pParent = pJoint.GetParentBody();
+			if(pParent is null || pParent.GetMass() <= 0.0f || VRBodyOwnJoint(pParent) is null) return pBody;
+			@pBody = pParent;
+		}
+		return null;
+	}
+
+	// BunkerVR: is this hand's palm still behind the face of apBody that it
+	// went 40 cm through? Then it doesn't touch apBody again until it is back
+	// in front of that face, or for ten seconds at most: taking the hand back
+	// out of a door it went through (one at its stop, or latched shut) would
+	// find the door's far face and pull the door with it.
+	bool VRTouchRefused(int alHand, iPhysicsBody@ apBody, const cVector3f &in avPalm)
+	{
+		if(mvVRTouchNot[alHand] == tID_Invalid || mfVRTouchNotFor[alHand] <= 0.0f || apBody.GetID() != mvVRTouchNot[alHand]) return false;
+		cMatrixf mtxBody = apBody.GetLocalMatrix();
+		cVector3f vFace = cMath_MatrixMul(mtxBody, mvVRTouchNotPoint[alHand]);
+		cVector3f vOut = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxBody, mvVRTouchNotOut[alHand]));
+		if(cMath_Vector3Dot(avPalm - vFace, vOut) > 0.02f)
+		{
+			mvVRTouchNot[alHand] = tID_Invalid; // back in front of it
+			return false;
+		}
+		return true;
+	}
+
+	// BunkerVR: which way a hinge's angle counts (see VRPushPart): learned
+	// from a touched door turning about its hinge, by how its angle changed
+	// since the last update against how fast it turns about the hinge's pin.
+	// The physics measures every hinge's angle the same way against its own
+	// pin, so one door tells it for all; it is changed only by three readings
+	// in a row the other way.
+	void VRLearnHinge(int alHand, iPhysicsBody@ apBody)
+	{
+		iPhysicsJoint@ pJoint = VRBodyOwnJoint(apBody);
+		if(pJoint is null || pJoint.GetType() != ePhysicsJointType_Hinge) return;
+		iPhysicsJointHinge@ pHinge = cPhysics_ToJointHinge(pJoint);
+		if(pHinge is null) return;
+		float fAngle = pHinge.GetAngle();
+		float fSpin = cMath_Vector3Dot(cMath_Vector3Normalize(pJoint.GetPinDir()), apBody.GetAngularVelocity());
+		float fTurned = fAngle - mfVRPushAngleWas[alHand];
+		bool bKnown = mbVRPushAngleKnown[alHand];
+		mfVRPushAngleWas[alHand] = fAngle;
+		mbVRPushAngleKnown[alHand] = true;
+		int lSign = bKnown ? VRHingeSignFrom(fTurned, fSpin, mfVRArmStep) : 0;
+		if(lSign == 0) return;
+		if(float(lSign) == mfVRHingeSign)
+		{
+			mlVRHingeStreak = 0;
+			return;
+		}
+		mlVRHingeStreak = mlVRHingeStreak * lSign > 0 ? mlVRHingeStreak + lSign : lSign;
+		if(mlVRHingeStreak * lSign < 3) return;
+		Log("BunkerVR door: a hinge's angle grows as its body turns " + (lSign > 0 ? "about" : "against") + " its pin (from " + apBody.GetName() + ": " +
+			int(fTurned * 1000.0f) + " mrad in " + int(mfVRArmStep * 1000.0f) + " ms, turning at " + int(fSpin * 100.0f) + " crad/s" +
+			(mfVRHingeSign != 0.0f ? "; until now the other way" : "") + ")\n");
+		mfVRHingeSign = float(lSign);
+		mlVRHingeStreak = 0;
+	}
+
+	// BunkerVR: a line in hpl.log when a hand touches a door (or anything on a
+	// joint) or lets go of it, the first 60.
+	void VRDoorNote(int alHand, iPhysicsBody@ apBody, const tString &in asWhat, const tString &in asHow)
+	{
+		if(mlVRDoorNotes >= 60) return;
+		mlVRDoorNotes++;
+		tString sJoint = ", with no joint of its own";
+		iPhysicsJoint@ pJoint = VRBodyOwnJoint(apBody);
+		if(pJoint !is null && pJoint.GetType() == ePhysicsJointType_Hinge)
+		{
+			iPhysicsJointHinge@ pHinge = cPhysics_ToJointHinge(pJoint);
+			if(pHinge !is null) sJoint = ", its hinge at " + int(cMath_ToDeg(pHinge.GetAngle())) + " degrees (stops " + int(cMath_ToDeg(pHinge.GetMinAngle())) + " and " + int(cMath_ToDeg(pHinge.GetMaxAngle())) + "), turning at " +
+										 int(cMath_Vector3Dot(cMath_Vector3Normalize(pJoint.GetPinDir()), apBody.GetAngularVelocity()) * 100.0f) + " crad/s";
+		}
+		else if(pJoint !is null) sJoint = ", on a rail";
+		cMatrixf mtxBody = apBody.GetLocalMatrix();
+		cVector3f vFace = cMath_MatrixMul(mtxBody, mvVRTouchPoint[alHand]);
+		cVector3f vOut = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxBody, mvVRTouchOut[alHand]));
+		bool bSeen = cMath_Vector3Dot(vOut, cLux_GetPlayer().GetCamera().GetPosition() - vFace) > 0.0f;
+		Log("BunkerVR door: the " + (alHand == 0 ? "left" : "right") + " hand " + asWhat + " " + apBody.GetName() + " (" + asHow + ")" + sJoint +
+			", " + apBody.GetJointNum() + " joint(s); the face at " + VRCmText(vFace) + " cm looks " + VRCmText(vOut) + " hundredths, " + (bSeen ? "towards" : "away from") + " the eyes\n");
+	}
+
+	// BunkerVR: where the fingers' ball is from the palm's (see VRHandBlock):
+	// the way the drawn fingers lie (as in UpdateVRArm), less far ahead in a
+	// fist. afCurl: how far the fingers are closed (0 open, 1 a fist);
+	// afScale: how big the arms are drawn.
+	cVector3f VRToFingers(const cMatrixf &in a_mtxPalm, float afCurl, float afScale)
+	{
+		cVector3f vCtrlY = cMath_MatrixMul3x3(a_mtxPalm, cVector3f(0.0f, 1.0f, 0.0f));
+		cVector3f vCtrlZ = cMath_MatrixMul3x3(a_mtxPalm, cVector3f(0.0f, 0.0f, 1.0f));
+		cVector3f vFingersDir = vCtrlZ * -gfVRHandForward + vCtrlY * -gfVRHandDip;
+		if(vFingersDir.Length() < 0.0001f) vFingersDir = cVector3f(0.0f, 0.0f, -1.0f);
+		vFingersDir.Normalize();
+		return vFingersDir * (gfVRFingerReach * afScale * (1.0f - 0.5f * cMath_Clamp(afCurl, 0.0f, 1.0f)));
+	}
+
+	// BunkerVR: the grips of the items in the hands (see VRPlaceHeldByGrip,
+	// and grips.h in the mod). Asked of the mod with the special roll value
+	// 7085 and, in the camera's position, the hand and the part wanted (see
+	// VRAskGrip): first whether the item has its own grip and its own fingers
+	// (each independently), and whether the mod wants to know where the game
+	// places it; then where the item's center point is in the palm's space
+	// (the controller's: x right, y up, z backwards), where its own z and y
+	// point; and its fingers (VRReadPose). The grip is built from the two
+	// directions: its z turned onto the first, then its y onto the second
+	// about it.
+	void VRReadGrips(cCamera@ apCam)
+	{
+		for(int lHand = 0; lHand < 2; ++lHand)
+		{
+			mvVRGripSet[lHand] = false;
+			mvVRGripFingers[lHand] = false;
+			mvVRGripSendGame[lHand] = false;
+			mvVRHeldModSays[lHand] = -3;
+			int lItem = cScript_GetGlobalVarInt("BunkerVR_HeldItem" + lHand);
+			if(lItem < 0) continue;
+			mvVRHeldModSays[lHand] = -1;
+			cVector3f vStatus = VRAskGrip(apCam, lHand, 0, 0);
+			if(vStatus.x < 12344.0f || vStatus.x > 12346.0f) continue; // (a mod without grips)
+			mvVRHeldModSays[lHand] = -2;
+			int lModItem = int(vStatus.z + (vStatus.z < 0.0f ? -0.5f : 0.5f));
+			if(lModItem != lItem) continue; // (the mod has not heard of this item yet)
+			int lFlags = int(vStatus.y + 0.5f);
+			mvVRHeldModSays[lHand] = lFlags;
+			mvVRGripSendGame[lHand] = (lFlags & 4) != 0;
+			if((lFlags & 2) != 0) mvVRGripFingers[lHand] = VRReadPose(apCam, lHand, 0);
+			if((lFlags & 1) == 0) continue;
+			cMatrixf mtxGrip = cMatrixf_Identity;
+			if(VRReadPlacement(apCam, lHand, 0, mtxGrip) == false) continue; // (not a sensible answer)
+			mvVRGrip[lHand] = mtxGrip;
+			mvVRGripSet[lHand] = true;
+		}
+	}
+
+	// BunkerVR: an item's own placement in a hand, from the mod (parts 1 to 3
+	// of a grip; alWhich as for VRAskGrip): where its center point is in the
+	// palm's space, and where its own z and y point; built into a rotation and
+	// a position (its z turned onto the first direction, then its y onto the
+	// second about it). False if the answer is not sensible. (Shared by
+	// VRReadGrips and the bandage's tin.)
+	bool VRReadPlacement(cCamera@ apCam, int alHand, int alWhich, cMatrixf &out a_mtxGrip)
+	{
+		a_mtxGrip = cMatrixf_Identity;
+		cVector3f vPos = VRAskGrip(apCam, alHand, 1, alWhich);
+		cVector3f vZ = VRAskGrip(apCam, alHand, 2, alWhich);
+		cVector3f vY = VRAskGrip(apCam, alHand, 3, alWhich);
+		if(vPos.Length() > 0.9f || cMath_Abs(vZ.Length() - 1.0f) > 0.05f || cMath_Abs(vY.Length() - 1.0f) > 0.05f || // (0.9: about 50 cm along each axis)
+		   cMath_Abs(cMath_Vector3Dot(vZ, vY)) > 0.05f) return false;
+		cMatrixf mtxGrip = VRTurnBetween(cVector3f(0.0f, 0.0f, 1.0f), vZ, vY);
+		cVector3f vYNow = cMath_MatrixMul3x3(mtxGrip, cVector3f(0.0f, 1.0f, 0.0f));
+		mtxGrip = cMath_MatrixMul(VRTurnBetween(vYNow, vY, vZ), mtxGrip);
+		mtxGrip.SetTranslation(vPos);
+		a_mtxGrip = mtxGrip;
+		return true;
+	}
+
+	// BunkerVR: a thing a hand holds that the game doesn't know of, while
+	// the bandage is wound (made by the winding: the bandage's tin in the left
+	// hand, alSlot glVRItemBandage; its roll in the right hand,
+	// glVRWorkBandageRoll). The hand is asked about as holding it (the asking
+	// itself tells the mod: the hand poses tool shows that pose as the hand's
+	// current one). abHas: that pose has a placement of its own (a_mtxGrip, in
+	// the palm's space; VRUpdateBandage then places the thing by it); abSend:
+	// otherwise, the mod wants to know where the thing is (the tool is open:
+	// VRUpdateBandage tells it, as VRPlaceHeldByGrip does for a held item, so
+	// that a placement of its own starts from there).
+	void VRAskPlacement(cCamera@ apCam, int alHand, int alSlot, bool &out abHas, cMatrixf &out a_mtxGrip, bool &out abSend)
+	{
+		abHas = false;
+		abSend = false;
+		a_mtxGrip = cMatrixf_Identity;
+		cVector3f vStatus = VRAskGrip(apCam, alHand, 0, alSlot + 1);
+		if(vStatus.x < 12344.0f || vStatus.x > 12346.0f) return; // (a mod without it)
+		if(int(vStatus.z + (vStatus.z < 0.0f ? -0.5f : 0.5f)) != alSlot) return;
+		int lFlags = int(vStatus.y + 0.5f);
+		abSend = (lFlags & 4) != 0;
+		if((lFlags & 1) == 0) return;
+		cMatrixf mtxGrip = cMatrixf_Identity;
+		abHas = VRReadPlacement(apCam, alHand, alSlot + 1, mtxGrip);
+		if(abHas) a_mtxGrip = mtxGrip;
+	}
+
+	// BunkerVR: one part of a hand's grip (VRReadGrips, VRWorkPose): the mod
+	// reads the hand, the part and which pose (0 the item the hand holds, or
+	// 1 + a slot: a hand at work's number, glVRWorkGunSupport..., or an item
+	// the hand holds in a way the game does not tell, glVRItemBandage + 1)
+	// from the camera's position while its roll is 7085, and answers in the
+	// matrix's position. Both are put straight back.
+	cVector3f VRAskGrip(cCamera@ apCam, int alHand, int alPart, int alWhich)
+	{
+		float fRealRoll = apCam.GetRoll();
+		cVector3f vRealPos = apCam.GetPosition();
+		apCam.SetPosition(cVector3f(float(alHand), float(alPart), float(alWhich)));
+		apCam.SetRoll(7085.0f);
+		cVector3f vAnswer = apCam.GetMatrix().GetTranslation();
+		apCam.SetPosition(vRealPos);
+		apCam.SetRoll(fRealRoll);
+		return vAnswer;
+	}
+
+	// BunkerVR: a hand's own pose for what it is doing (set in the mod's
+	// hand poses tool or on its Grips page): alWork, the hand at work
+	// (glVRWorkGunSupport...), or -1 when the hand does nothing in particular:
+	// then the pose of the item it holds counts (read by VRReadGrips). Asking
+	// about a hand at work also tells the mod that the hand is doing it now
+	// (the tool shows that). True if there is a pose: it is then in
+	// mvVRPoseCurlsA... for that hand.
+	bool VRWorkPose(cCamera@ apCam, int alHand, int alWork)
+	{
+		if(alWork < 0) return mvVRGripFingers[alHand];
+		cVector3f vStatus = VRAskGrip(apCam, alHand, 0, alWork + 1);
+		if(vStatus.x < 12344.0f || vStatus.x > 12346.0f) return false; // (a mod without hand poses)
+		if(int(vStatus.z + (vStatus.z < 0.0f ? -0.5f : 0.5f)) != alWork) return false; // (that hand cannot do it)
+		int lFlags = int(vStatus.y + 0.5f);
+		if((lFlags & 2) == 0) return false;
+		return VRReadPose(apCam, alHand, alWork + 1);
+	}
+
+	// BunkerVR: reads a hand's own pose from the mod (parts 4 to 7 of a grip;
+	// alWhich as for VRAskGrip): how far each finger closes (0 straight to 1
+	// closed), how far each is spread sideways at its knuckle (degrees: +
+	// towards the little finger; the thumb's + out from the hand), and how
+	// cupped the palm is (0 flat to 1). See UpdateVRFingersFull.
+	bool VRReadPose(cCamera@ apCam, int alHand, int alWhich)
+	{
+		cVector3f vCurlsA = VRAskGrip(apCam, alHand, 4, alWhich);	// thumb, first, middle
+		cVector3f vCurlsB = VRAskGrip(apCam, alHand, 5, alWhich);	// ring, little, the palm's cup
+		cVector3f vSpreadA = VRAskGrip(apCam, alHand, 6, alWhich);	// thumb, first, middle
+		cVector3f vSpreadB = VRAskGrip(apCam, alHand, 7, alWhich);	// ring, little, 0
+		mvVRPoseCurlsA[alHand] = cVector3f(cMath_Clamp(vCurlsA.x, 0.0f, 1.0f), cMath_Clamp(vCurlsA.y, 0.0f, 1.0f), cMath_Clamp(vCurlsA.z, 0.0f, 1.0f));
+		mvVRPoseCurlsB[alHand] = cVector3f(cMath_Clamp(vCurlsB.x, 0.0f, 1.0f), cMath_Clamp(vCurlsB.y, 0.0f, 1.0f), cMath_Clamp(vCurlsB.z, 0.0f, 1.0f));
+		mvVRPoseSpreadA[alHand] = cVector3f(cMath_Clamp(vSpreadA.x, -60.0f, 60.0f), cMath_Clamp(vSpreadA.y, -40.0f, 40.0f), cMath_Clamp(vSpreadA.z, -40.0f, 40.0f));
+		mvVRPoseSpreadB[alHand] = cVector3f(cMath_Clamp(vSpreadB.x, -40.0f, 40.0f), cMath_Clamp(vSpreadB.y, -40.0f, 40.0f), 0.0f);
+		return true;
+	}
+
+	// BunkerVR: the item a hand holds, put where its own grip has it in the
+	// palm, after the game has hung it on the hand (as the game hangs them,
+	// items such as the fuel can sit at an odd angle in the hand). Only the
+	// thing the game says that hand holds ("BunkerVR_HeldItem0/1" and
+	// "BunkerVR_HeldEntity0/1", set by VRSendGunNews in
+	// PlayerBodyHandler.hps), so never the gun, nor what the game hangs on a
+	// hand for a moment (the bandage's tin and roll as they are used). The
+	// palm is the hand as drawn this frame (m_mtxVRPalmLeft/Right: where the
+	// controller is, or held back at a wall), as the bandage's tin is placed.
+	// An item without a grip stays as the game places it; the mod is told
+	// where that is in the palm's space while it asks (special roll values
+	// 7086 .. 7091), so that a grip set on the Grips page starts from there.
+	// abParentRotation: the game turns it as the socket's bone (as the socket
+	// loops do; see VRGameHang).
+	void VRPlaceHeldByGrip(iLuxEntity@ apProp, const tString &in asSocket, bool abParentRotation)
+	{
+		int lHand = asSocket == "L_Hand" ? 0 : (asSocket == "R_Hand" ? 1 : -1);
+		if(lHand < 0 || apProp is null) return;
+		// Where the game hangs it: as it is now, or for a thing the mod has
+		// taken off the socket (see VRHeldLetGo) where the socket
+		// would put it; such a thing is put there whenever it is not placed
+		// otherwise below.
+		bool bLoose = VRHeldIsLoose(apProp.GetID());
+		cMatrixf mtxHang = apProp.GetMatrix();
+		if(bLoose && VRGameHang(asSocket, abParentRotation, mtxHang) == false) mtxHang = apProp.GetMatrix();
+		int lLeft = -1; // (left as the game hangs it, and why: see VRHeldNote)
+		if(m_idVRBandageHidden != tID_Invalid && apProp.GetID() == m_idVRBandageHidden) lLeft = 0; // (put away while a bandage is wound: not drawn, and not reported)
+		else if((mlVRPalmsNow & (lHand == 0 ? 1 : 2)) == 0) lLeft = 1;
+		else if(cScript_GetGlobalVarInt("BunkerVR_HeldItem" + lHand) < 0) lLeft = 2;
+		else if(apProp.GetName() != cScript_GetGlobalVarString("BunkerVR_HeldEntity" + lHand)) lLeft = 3;
+		cMatrixf mtxPalm = lHand == 0 ? m_mtxVRPalmLeft : m_mtxVRPalmRight;
+		cMatrixf mtxNow = mtxHang;
+		float fSize = cMath_MatrixMul3x3(mtxNow, cVector3f(1.0f, 0.0f, 0.0f)).Length(); // (its own size, kept)
+		if(lLeft < 0 && fSize < 0.01f) lLeft = 4;
+		if(lLeft >= 0)
+		{
+			if(bLoose) apProp.SetMatrix(mtxHang);
+			VRHeldNote(lHand, apProp, lLeft);
+			return;
+		}
+		// Fitted into what it is used on (a key in its lock: see
+		// VRUpdateFit in PlayerBodyHandler.hps): exactly where the fit has it,
+		// off the socket.
+		cMatrixf mtxFitted = cMatrixf_Identity;
+		if(lHand == 1 && VRFittedThing(mtxFitted))
+		{
+			if(bLoose == false) bLoose = VRHeldLetGo(apProp, asSocket, abParentRotation);
+			apProp.SetMatrix(mtxFitted);
+			VRHeldNote(lHand, apProp, 11);
+			return;
+		}
+		// A thing with no bones is placed, and turned, by the center of what
+		// is drawn: the game hangs it by its model's origin, which for the
+		// bottle is on the palm while the bottle's center is 14 cm away, so
+		// every turn would swing it around the palm. Its own placement says
+		// where that center is; with none, the center is on the palm's center,
+		// turned as the game turns it. (A thing with bones isn't placed by its
+		// center: what the game gives as its outline doesn't fit it, the
+		// molotov's being 60 cm across.)
+		bool bByMiddle = false;
+		cVector3f vMiddle = cVector3f(0.0f); // the center of what is drawn, in the thing's local space
+		cMeshEntity@ pMesh = apProp.GetMeshEntity();
+		if(pMesh !is null && pMesh.GetBoneStateNum() == 0)
+		{
+			cBoundingVolume@ pBounds = pMesh.GetBoundingVolume();
+			if(pBounds !is null)
+			{
+				// (Measured from where it is now, which is where its outline is.)
+				vMiddle = cMath_MatrixMul(cMath_MatrixInverse(apProp.GetMatrix()), pBounds.GetWorldCenter());
+				bByMiddle = vMiddle.Length() * fSize < 0.5f;
+				if(bByMiddle == false) vMiddle = cVector3f(0.0f);
+			}
+		}
+		// Placed by the mod: off the socket first, so that it is drawn where
+		// it is put (see VRHeldLetGo).
+		if((mvVRGripSet[lHand] || bByMiddle) && bLoose == false) bLoose = VRHeldLetGo(apProp, asSocket, abParentRotation);
+		if(mvVRGripSet[lHand])
+		{
+			cMatrixf mtxItem = cMath_MatrixMul(mtxPalm, mvVRGrip[lHand]);
+			if(fSize < 0.999f || fSize > 1.001f) mtxItem = cMath_MatrixMul(mtxItem, cMath_MatrixScale(cVector3f(fSize, fSize, fSize)));
+			if(bByMiddle) mtxItem.SetTranslation(mtxItem.GetTranslation() - cMath_MatrixMul3x3(mtxItem, vMiddle));
+			apProp.SetMatrix(mtxItem);
+			VRHeldNote(lHand, apProp, bByMiddle ? 10 : 5);
+			return;
+		}
+		if(bByMiddle) mtxNow.SetTranslation(mtxPalm.GetTranslation() - cMath_MatrixMul3x3(mtxNow, vMiddle));
+		if(bByMiddle || bLoose) apProp.SetMatrix(mtxNow);
+		if(mvVRGripSendGame[lHand] == false)
+		{
+			VRHeldNote(lHand, apProp, bByMiddle ? 9 : 7);
+			return;
+		}
+		cMatrixf mtxToPalm = cMath_MatrixInverse(mtxPalm);
+		cMatrixf mtxInPalm = cMath_MatrixMul(mtxToPalm, mtxNow);
+		cVector3f vZ = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxInPalm, cVector3f(0.0f, 0.0f, 1.0f)));
+		cVector3f vY = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxInPalm, cVector3f(0.0f, 1.0f, 0.0f)));
+		cVector3f vAt = cMath_MatrixMul(mtxToPalm, mtxNow.GetTranslation() + cMath_MatrixMul3x3(mtxNow, vMiddle)); // (its center, or with bones its origin)
+		VRSendGripNews(7086 + lHand * 3, vAt);
+		VRSendGripNews(7087 + lHand * 3, vZ);
+		VRSendGripNews(7088 + lHand * 3, vY);
+		VRHeldNote(lHand, apProp, bByMiddle ? 8 : 6);
+	}
+
+	// BunkerVR: does nothing hang on this hand's socket? (The palm's position is learned only
+	// then, see UpdateVRArm.)
+	bool VRHandHangsNothing(bool abLeft)
+	{
+		tString sSocket = abLeft ? "L_Hand" : "R_Hand";
+		for(uint i = 0; i < mvSocketAttachments.length(); ++i)
+		{
+			if(mvSocketAttachments[i].msSocket != sSocket) continue;
+			tID idProp = mvSocketAttachments[i].m_idEntity;
+			if(idProp != tID_Invalid && cLux_ID_Entity(idProp) !is null) return false;
+		}
+		return true;
+	}
+
+	// BunkerVR: is a thing hung on this hand (0 left, 1 right) one the mod has
+	// taken off the socket and places itself (see VRHeldLetGo)?
+	bool VRHandHoldsLoose(int alHand)
+	{
+		tString sSocket = alHand == 0 ? "L_Hand" : "R_Hand";
+		for(uint i = 0; i < mvSocketAttachments.length(); ++i)
+		{
+			if(mvSocketAttachments[i].msSocket != sSocket) continue;
+			tID idProp = mvSocketAttachments[i].m_idEntity;
+			if(idProp != tID_Invalid && cLux_ID_Entity(idProp) !is null && VRHeldIsLoose(idProp)) return true;
+		}
+		return false;
+	}
+
+	// BunkerVR: has the mod taken this held thing off the hand's socket (see
+	// VRHeldLetGo)?
+	bool VRHeldIsLoose(tID aidProp)
+	{
+		for(uint i = 0; i < mvVRLooseHeld.length(); ++i)
+			if(mvVRLooseHeld[i] == aidProp) return true;
+		return false;
+	}
+
+	// BunkerVR: where the game hangs a thing on a socket of the body, as the
+	// socket loops do (UpdateEntityAttachment puts it at the socket, then,
+	// with abParentRotation, it is turned as the socket's bone, made a
+	// hundred times bigger as that bone is drawn a hundredth of its size).
+	// False if the socket is not found.
+	bool VRGameHang(const tString &in asSocket, bool abParentRotation, cMatrixf &out a_mtxHang)
+	{
+		a_mtxHang = cMatrixf_Identity;
+		cMeshEntity@ pBodyMesh = mBaseObj.GetMeshEntity();
+		if(pBodyMesh is null) return false;
+		cNode3D@ pSocket = pBodyMesh.GetSocket(asSocket);
+		if(pSocket is null) return false;
+		cMatrixf mtxHang = pSocket.GetWorldMatrix();
+		if(abParentRotation)
+		{
+			cNode3D@ pParent = pSocket.GetParent();
+			if(pParent is null) return false;
+			mtxHang.SetRotation(cMath_MatrixMul(cMath_MatrixScale(100.f), pParent.GetWorldMatrix().GetRotation()));
+		}
+		a_mtxHang = mtxHang;
+		return true;
+	}
+
+	// BunkerVR: takes a held thing off the hand's socket, so that the mod alone
+	// places it from then on. A thing kept on the socket is hung back on it
+	// after these scripts have placed it: an empty bottle placed with its
+	// center in the palm would still be drawn hanging from the hand by its
+	// neck, as the game hangs it. Only done if where the game hangs it can be
+	// worked out here (VRGameHang) to within 1 cm and a few degrees of where
+	// it hangs now, because the mod then puts it there itself whenever it
+	// doesn't place it otherwise; if not, it stays on the socket and that is
+	// logged once in hpl.log. True if it is off the socket.
+	bool VRHeldLetGo(iLuxEntity@ apProp, const tString &in asSocket, bool abParentRotation)
+	{
+		tID idProp = apProp.GetID();
+		for(uint i = 0; i < mvVRLetGoRefused.length(); ++i)
+			if(mvVRLetGoRefused[i] == idProp) return false;
+		cMatrixf mtxHang = cMatrixf_Identity;
+		bool bWorkedOut = VRGameHang(asSocket, abParentRotation, mtxHang);
+		cMatrixf mtxNow = apProp.GetMatrix();
+		float fOff = (mtxHang.GetTranslation() - mtxNow.GetTranslation()).Length();
+		float fTurn = 0.0f;
+		array<cVector3f> vAxes = {cVector3f(1.0f, 0.0f, 0.0f), cVector3f(0.0f, 1.0f, 0.0f), cVector3f(0.0f, 0.0f, 1.0f)};
+		for(uint i = 0; i < vAxes.length(); ++i)
+			fTurn = cMath_Max(fTurn, (cMath_MatrixMul3x3(mtxHang, vAxes[i]) - cMath_MatrixMul3x3(mtxNow, vAxes[i])).Length());
+		if(bWorkedOut == false || fOff > 0.01f || fTurn > 0.05f)
+		{
+			mvVRLetGoRefused.insertLast(idProp);
+			if(mlVRHeldNotes < 300)
+			{
+				mlVRHeldNotes++;
+				Log("BunkerVR: held " + apProp.GetName() + " left on the hand's socket: where the game hangs it could not be worked out (" +
+					(bWorkedOut ? "off by " + VRCm(fOff) + " cm, turned off by " + int(fTurn * 100.0f + 0.5f) + "/100" : "no socket " + asSocket) +
+					"), so the mod's placing of it may not show\n");
+			}
+			return false;
+		}
+		// (Things no longer there are forgotten first.)
+		for(int i = int(mvVRLooseHeld.length()) - 1; i >= 0; --i)
+			if(cLux_ID_Entity(mvVRLooseHeld[i]) is null) mvVRLooseHeld.removeAt(uint(i));
+		apProp.RemoveEntityAttachment();
+		mvVRLooseHeld.insertLast(idProp);
+		if(mlVRHeldNotes < 300)
+		{
+			mlVRHeldNotes++;
+			Log("BunkerVR: held " + apProp.GetName() + " taken off the hand's socket: placed by the mod from now on\n");
+		}
+		return true;
+	}
+
+	// BunkerVR: notes in hpl.log on how each thing hung on a hand is placed.
+	// A line "BunkerVR: held ..." whenever how a thing is placed changes, and
+	// every 5 seconds for the thing in a hand while the mod wants to know
+	// where it is (the hand poses tool open); the first 300 in all. alHow: 0
+	// the bandage's tin put away while winding, 1 that palm not followed, 2 no
+	// item number for the hand, 3 not the thing the game says the hand holds,
+	// 4 drawn at no size, 5 placed by its own placement, 6 the game's
+	// placement told to the mod, 7 the game's placement, the mod not asking;
+	// by the center of what is drawn (see VRPlaceHeldByGrip): 8 on the palm's
+	// center, told to the mod, 9 the same, the mod not asking, 10 placed by
+	// its own placement; 11 fitted into what it is used on (see
+	// VRFittedThing). When how it is placed changes, a thing with bones also
+	// has its parts logged (each part's center and size, and its first 12
+	// bones), to find what can be taken as its center.
+	void VRHeldNote(int alHand, iLuxEntity@ apProp, int alHow)
+	{
+		if(mlVRHeldNotes >= 300) return;
+		tID idProp = apProp.GetID();
+		int lKnown = -1;
+		for(uint i = 0; i < mvVRHeldNoteIds.length(); ++i)
+			if(mvVRHeldNoteIds[i] == idProp) lKnown = int(i);
+		bool bChanged = lKnown < 0 || mvVRHeldNoteHows[lKnown] != alHow;
+		float fNow = float(cEngine_GetGameTime());
+		bool bDue = alHow >= 5 && mvVRGripSendGame[alHand] && fNow - mvVRHeldNoteTime[alHand] >= 5.0f;
+		if(bChanged == false && bDue == false) return;
+		if(lKnown < 0)
+		{
+			if(mvVRHeldNoteIds.length() >= 32)
+			{
+				mvVRHeldNoteIds.resize(0);
+				mvVRHeldNoteHows.resize(0);
+			}
+			mvVRHeldNoteIds.insertLast(idProp);
+			mvVRHeldNoteHows.insertLast(alHow);
+		}
+		else mvVRHeldNoteHows[lKnown] = alHow;
+		if(alHow >= 5) mvVRHeldNoteTime[alHand] = fNow;
+		mlVRHeldNotes++;
+
+		array<tString> vHow = {"not drawn (the bandage's tin, put away while winding)",
+							   "that palm is not followed now: left as the game hangs it",
+							   "the game says this hand holds no item: left as the game hangs it",
+							   "not the thing the game says this hand holds (" + cScript_GetGlobalVarString("BunkerVR_HeldEntity" + alHand) + "): left as the game hangs it",
+							   "drawn at no size: left alone",
+							   "placed by its own placement",
+							   "the game's placement, told to the mod (the hand poses tool can move it from there)",
+							   "the game's placement, not told to the mod (it did not ask)",
+							   "its middle on the palm's middle, turned as the game turns it; told to the mod (the hand poses tool can move it from there)",
+							   "its middle on the palm's middle, turned as the game turns it; not told to the mod (it did not ask)",
+							   "placed by its own placement, by its middle",
+							   "fitted into what it is used on, where the fit has it"};
+		// (A number past the list is logged as a number: indexing past it throws, which would leave
+		// the rest of that frame's held things unplaced.)
+		tString sHow = alHow >= 0 && alHow < int(vHow.length()) ? vHow[alHow] : "placed as " + alHow;
+		tString sModSays = "no item";
+		int lModSays = mvVRHeldModSays[alHand];
+		if(lModSays == -1) sModSays = "no answer";
+		else if(lModSays == -2) sModSays = "has not heard of this item";
+		else if(lModSays >= 0) sModSays = "flags " + lModSays;
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		tString sState = "?";
+		if(pPlayer !is null) sState = pPlayer.GetCurrentStateName();
+		cMatrixf mtxToPalm = cMath_MatrixInverse(alHand == 0 ? m_mtxVRPalmLeft : m_mtxVRPalmRight);
+		tString sLine = "BunkerVR: held " + (alHand == 0 ? "left" : "right") + ": " + apProp.GetName() + " (item " +
+						cScript_GetGlobalVarInt("BunkerVR_HeldItem" + alHand) + "; the mod: " + sModSays + "; " + sState + (VRHeldIsLoose(idProp) ? "; off the socket" : "") + "): " + sHow +
+						". In the palm's terms (cm): the model's origin " + VRCmText(cMath_MatrixMul(mtxToPalm, apProp.GetMatrix().GetTranslation()));
+		cMeshEntity@ pMesh = apProp.GetMeshEntity();
+		if(pMesh !is null)
+		{
+			cBoundingVolume@ pBounds = pMesh.GetBoundingVolume();
+			if(pBounds !is null) sLine += ", the middle of what is drawn " + VRCmText(cMath_MatrixMul(mtxToPalm, pBounds.GetWorldCenter())) + " (" + VRCmText(pBounds.GetSize()) + " across; in its own terms " + VRCmText(pBounds.GetLocalCenter()) + ")";
+			if(pMesh.GetBoneStateNum() > 0)
+			{
+				cBoneState@ pRoot = pMesh.GetBoneState(0);
+				if(pRoot !is null) sLine += ", its first bone (" + pRoot.GetName() + ") " + VRCmText(cMath_MatrixMul(mtxToPalm, pRoot.GetWorldPosition()));
+				if(bChanged)
+				{
+					for(int i = 0; i < pMesh.GetSubMeshEntityNum(); ++i)
+					{
+						cSubMeshEntity@ pPart = pMesh.GetSubMeshEntity(i);
+						if(pPart is null) continue;
+						cBoundingVolume@ pPartBounds = pPart.GetBoundingVolume();
+						if(pPartBounds !is null)
+							sLine += "; part " + pPart.GetName() + (pPart.IsVisible() ? "" : " (not drawn)") + ": middle " + VRCmText(cMath_MatrixMul(mtxToPalm, pPartBounds.GetWorldCenter())) + ", " + VRCmText(pPartBounds.GetSize()) + " across";
+					}
+					sLine += "; bones:";
+					for(int i = 0; i < pMesh.GetBoneStateNum() && i < 12; ++i)
+					{
+						cBoneState@ pBone = pMesh.GetBoneState(i);
+						if(pBone !is null) sLine += " " + pBone.GetName() + " " + VRCmText(cMath_MatrixMul(mtxToPalm, pBone.GetWorldPosition()));
+					}
+				}
+			}
+			tString sPlaying = "";
+			for(int i = 0; i < pMesh.GetAnimationStateNum(); ++i)
+			{
+				cAnimationState@ pAnim = pMesh.GetAnimationState(i);
+				if(pAnim !is null && pAnim.IsActive() && pAnim.GetWeight() > 0.01f) sPlaying += " " + pAnim.GetName();
+			}
+			if(sPlaying != "") sLine += "; playing:" + sPlaying;
+		}
+		Log(sLine + "\n");
+	}
+
+	// Meters as whole centimeters, rounded (for the log).
+	int VRCm(float afMetres)
+	{
+		return int(afMetres * 100.0f + (afMetres < 0.0f ? -0.5f : 0.5f));
+	}
+
+	tString VRCmText(const cVector3f &in avMetres)
+	{
+		return "(" + VRCm(avMetres.x) + " " + VRCm(avMetres.y) + " " + VRCm(avMetres.z) + ")";
+	}
+
+	// BunkerVR: three numbers for the mod (in the camera's position, while its
+	// roll holds the special value alCode); both are put straight back.
+	void VRSendGripNews(int alCode, const cVector3f &in avNumbers)
+	{
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		cCamera@ pCam = pPlayer !is null ? pPlayer.GetCamera() : null;
+		if(pCam is null) return;
+		cVector3f vRealPos = pCam.GetPosition();
+		float fRealRoll = pCam.GetRoll();
+		pCam.SetPosition(avNumbers);
+		pCam.SetRoll(float(alCode));
+		pCam.GetMatrix();
+		pCam.SetRoll(fRealRoll);
+		pCam.SetPosition(vRealPos);
+	}
+
+	// BunkerVR: is a hand at one of this door's handles? The handles of the
+	// game's doors are not solid: they are drawn on the door, and the door's
+	// own shape is a flat slab, from which the bars stand 7 cm (the metal
+	// doors) to 9 cm (the wooden ones) off. A hand closed around a bar is too
+	// far from the slab to touch it. So the door's own script is asked for
+	// its handle nearest each of the hand's balls (_Global_VRFindGrip in
+	// Prop_SwingDoor.hps, which the held door also uses to put the hand on
+	// its handle), and a ball within reach of a bar touches the door.
+	// Returns how far the nearer ball is inside that reach (its ball's size,
+	// afPalmRadius or afFingerRadius with the touch room, plus the bar's own
+	// thickness): as deep as a ball in a shape would be; -1 if neither is, or
+	// this is not one of the game's swinging doors. Where on the handle:
+	// mvVRHandleSpot.
+	float VRDoorHandleNear(iLuxEntity@ apEntity, const cVector3f &in avPalm, float afPalmRadius, const cVector3f &in avFingers, float afFingerRadius)
+	{
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		if(pMap is null || pMap.GetEntityByName(apEntity.GetName(), eLuxEntityType_Prop, "cScrPropSwingDoor") is null) return -1.0f;
+		float fBest = -1.0f;
+		for(int lBall = 0; lBall < 2; ++lBall)
+		{
+			cVector3f vBall = lBall == 0 ? avPalm : avFingers;
+			cScript_SetGlobalArgVector3f(0, vBall);
+			cScript_RunGlobalFunc(apEntity.GetName(), "cScrPropSwingDoor", "_Global_VRFindGrip");
+			cVector3f vHandle = cScript_GetGlobalReturnVector3f();
+			cScript_RunGlobalFunc(apEntity.GetName(), "cScrPropSwingDoor", "_Global_VRGripFound");
+			if(cScript_GetGlobalReturnBool() == false) continue;
+			float fIn = (lBall == 0 ? afPalmRadius : afFingerRadius) + gfVRHandleBar - (vHandle - vBall).Length();
+			if(fIn < 0.0f || fIn <= fBest) continue;
+			fBest = fIn;
+			mvVRHandleSpot = vHandle;
+		}
+		return fBest;
+	}
+
+	// BunkerVR: where the tip of a drawn hand's index finger is, as posed
+	// (for the number locks' rollers, turned by the fingertip:
+	// PlayerState_Interact_CombinationLock.hps, and VRPushButtons): beyond
+	// the end of its last bone by gfVRIndexTipBeyond of the bone before.
+	// Published as "BunkerVR_IndexTip0/1", with the game time it was set at
+	// ("BunkerVR_IndexTipTime0/1"), and kept (mvVRIndexTip).
+	void VRNoteIndexTip(cMeshEntity@ apMesh, bool abLeft)
+	{
+		cBoneState@ pMiddle = VRFingerBone(apMesh, abLeft, 0, 3); // (j_?_Index_3)
+		cBoneState@ pLast = VRFingerBone(apMesh, abLeft, 0, 4);
+		if(pMiddle is null || pLast is null) return;
+		cVector3f vLast = pLast.GetWorldPosition();
+		cVector3f vTip = vLast + (vLast - pMiddle.GetWorldPosition()) * gfVRIndexTipBeyond;
+		int lHand = abLeft ? 0 : 1;
+		mvVRIndexTip[lHand] = vTip;
+		mfVRIndexTipTime[lHand] = float(cEngine_GetGameTime());
+		cScript_SetGlobalVarVector3f("BunkerVR_IndexTip" + lHand, vTip);
+		cScript_SetGlobalVarFloat("BunkerVR_IndexTipTime" + lHand, mfVRIndexTipTime[lHand]);
+	}
+
+	// BunkerVR: the hand pinching a dogtag to read it (0 left, 1 right; -1
+	// none). The reading state says so each update ("BunkerVR_TagHand", the
+	// hand + 1, at "BunkerVR_TagTime").
+	int VRTagHand()
+	{
+		int lHand = cScript_GetGlobalVarInt("BunkerVR_TagHand") - 1;
+		if(lHand < 0 || lHand > 1) return -1;
+		if(cMath_Abs(float(cEngine_GetGameTime()) - cScript_GetGlobalVarFloat("BunkerVR_TagTime")) > 0.25f) return -1;
+		return lHand;
+	}
+
+	// BunkerVR: a dogtag's own placement in the hand: "Holding a dogtag" can
+	// be placed in the hand poses tool and on the Grips page (kSlotDogtag in
+	// the mod's grips.cpp). Asked as the bandage's roll is (VRAskPlacement):
+	// one that is set is passed to the reading state
+	// ("BunkerVR_TagGripMiddle0/1", its own y "...Y0/1", its own z "...Z0/1",
+	// in the palm's space, and when, "...Time0/1"), which places the tag by it
+	// instead of by the pinch; with none set and the tool open, where the tag
+	// is now (the reading state's "BunkerVR_TagShown...") is sent to the mod,
+	// so that a placement starts from there.
+	void VRTagPlacement(cCamera@ apCam, int alHand)
+	{
+		bool bHas = false;
+		bool bSend = false;
+		cMatrixf mtxGrip = cMatrixf_Identity;
+		VRAskPlacement(apCam, alHand, glVRWorkDogtag, bHas, mtxGrip, bSend);
+		float fNow = float(cEngine_GetGameTime());
+		if(bHas)
+		{
+			cScript_SetGlobalVarVector3f("BunkerVR_TagGripMiddle" + alHand, mtxGrip.GetTranslation());
+			cScript_SetGlobalVarVector3f("BunkerVR_TagGripY" + alHand, cMath_MatrixMul3x3(mtxGrip, cVector3f(0.0f, 1.0f, 0.0f)));
+			cScript_SetGlobalVarVector3f("BunkerVR_TagGripZ" + alHand, cMath_MatrixMul3x3(mtxGrip, cVector3f(0.0f, 0.0f, 1.0f)));
+			cScript_SetGlobalVarFloat("BunkerVR_TagGripTime" + alHand, fNow);
+			return;
+		}
+		if(bSend == false || cMath_Abs(fNow - cScript_GetGlobalVarFloat("BunkerVR_TagShownTime")) > 0.25f) return;
+		int lNews = alHand == 0 ? 7086 : 7089; // (its center, its own z, its own y: as for a held item)
+		VRSendGripNews(lNews, cScript_GetGlobalVarVector3f("BunkerVR_TagShownMiddle"));
+		VRSendGripNews(lNews + 1, cMath_Vector3Normalize(cScript_GetGlobalVarVector3f("BunkerVR_TagShownZ")));
+		VRSendGripNews(lNews + 2, cMath_Vector3Normalize(cScript_GetGlobalVarVector3f("BunkerVR_TagShownY")));
+	}
+
+	// BunkerVR: where a hand pinching a dogtag holds it, from the fingers as
+	// drawn this frame in the pose "Holding a dogtag". Passed to the reading
+	// state (PlayerState_Interact_ReadDogTag.hps, VRPlaceInHand) in the
+	// palm's own space, which stays the same while the pose holds, so the tag
+	// is placed by the palm of the frame it is drawn in:
+	// "BunkerVR_TagPinch0/1" the point, "BunkerVR_TagFace0/1" towards the
+	// thumb (the tag's front looks that way), "BunkerVR_TagOut0/1" out of
+	// the hand through the pinch (its top points that way), and when
+	// ("BunkerVR_TagPinchTime0/1"). Whatever pose is set for it in the hand
+	// poses tool, the tag goes where its thumb and finger meet.
+	// The tag lies against the pad of the first finger's tip, gfVRTagPadOff
+	// in front of the bone towards the thumb, its front towards the thumb,
+	// its top out along that fingertip, as a coin is held up between the tips
+	// of the thumb and the first finger; the pose "Holding a dogtag" brings
+	// the thumb's tip onto its front. (Held between the thumb's pad and the
+	// side of the first finger's middle bone instead, the two can be 57 mm
+	// apart, and the tag hangs in the air between them.)
+	void VRNoteTagPinch(cMeshEntity@ apMesh, bool abLeft, const cMatrixf &in a_mtxPalm)
+	{
+		tString sSide = abLeft ? "j_L_" : "j_R_";
+		cBoneState@ pThumb2 = apMesh.GetBoneStateFromName(sSide + "Thumb_2");
+		cBoneState@ pThumb3 = apMesh.GetBoneStateFromName(sSide + "Thumb_3");
+		cBoneState@ pIndex3 = apMesh.GetBoneStateFromName(sSide + "Index_3");
+		cBoneState@ pIndex4 = apMesh.GetBoneStateFromName(sSide + "Index_4");
+		if(pThumb2 is null || pThumb3 is null || pIndex3 is null || pIndex4 is null) return;
+		cVector3f vThumbLast = pThumb3.GetWorldPosition();
+		cVector3f vThumbPad = vThumbLast + (vThumbLast - pThumb2.GetWorldPosition()) * gfVRThumbPadBeyond;
+		cVector3f vIndexLast = pIndex4.GetWorldPosition();
+		cVector3f vIndexWay = vIndexLast - pIndex3.GetWorldPosition(); // (along the fingertip)
+		cVector3f vIndexPad = vIndexLast + vIndexWay * gfVRIndexPadBeyond;
+		cVector3f vFace = vThumbPad - vIndexPad;
+		if(vFace.Length() < 0.002f || vIndexWay.Length() < 0.002f) return;
+		vFace.Normalize();
+		cVector3f vPinch = vIndexPad + vFace * gfVRTagPadOff;
+		cVector3f vOut = vIndexWay - vFace * cMath_Vector3Dot(vIndexWay, vFace);
+		if(vOut.Length() < 0.002f) return;
+		vOut.Normalize();
+		cMatrixf mtxToPalm = cMath_MatrixInverse(a_mtxPalm);
+		int lHand = abLeft ? 0 : 1;
+		// (For the log, once a hold: how the pose's thumb and fingertip meet,
+		// and where each is in the palm's space, to set the pose from.)
+		if(mbVRTagPinchLogged == false)
+		{
+			mbVRTagPinchLogged = true;
+			cVector3f vThumbInPalm = cMath_MatrixMul(mtxToPalm, vThumbPad) * 1000.0f;
+			cVector3f vIndexInPalm = cMath_MatrixMul(mtxToPalm, vIndexPad) * 1000.0f;
+			Log("BunkerVR: the dogtag's pinch: the thumb's pad " + int((vThumbPad - vIndexPad).Length() * 1000.0f + 0.5f) + " mm from the first finger's tip pad; in the palm's terms (mm, x right, y up, z back) the thumb's pad " +
+				int(cMath_Floor(vThumbInPalm.x + 0.5f)) + " " + int(cMath_Floor(vThumbInPalm.y + 0.5f)) + " " + int(cMath_Floor(vThumbInPalm.z + 0.5f)) + ", the fingertip's " +
+				int(cMath_Floor(vIndexInPalm.x + 0.5f)) + " " + int(cMath_Floor(vIndexInPalm.y + 0.5f)) + " " + int(cMath_Floor(vIndexInPalm.z + 0.5f)) + "\n");
+		}
+		cScript_SetGlobalVarVector3f("BunkerVR_TagPinch" + lHand, cMath_MatrixMul(mtxToPalm, vPinch));
+		cScript_SetGlobalVarVector3f("BunkerVR_TagFace" + lHand, cMath_MatrixMul3x3(mtxToPalm, vFace));
+		cScript_SetGlobalVarVector3f("BunkerVR_TagOut" + lHand, cMath_MatrixMul3x3(mtxToPalm, vOut));
+		cScript_SetGlobalVarFloat("BunkerVR_TagPinchTime" + lHand, float(cEngine_GetGameTime()));
+	}
+
+	// BunkerVR: buttons pushed in by a hand (such as the safe room's door
+	// locks). The bunker's door locks, buttons, switches and the power plant's
+	// control board buttons are the game's simple-press moving buttons
+	// (Prop_MovingButton.hps, SimplePressInteraction): one press of the
+	// interact button on one switches it (a lock's bolt slides across, a
+	// switch flips), or rattles it if it is locked. An empty hand that goes
+	// gfVRPushDepth into one (its palm's or its fingers' ball, where the hand
+	// is drawn: these things don't stop the hand) presses it: the
+	// game's own interaction with it, when the player could interact
+	// (PlayerState_Normal.hps _Global_VRPushed; through the engine's
+	// interaction, so the map's callbacks run), with a buzz. The hand must
+	// come out of every button (under gfVRPushOut for gfVRPushRearm) before
+	// it presses again, and the game's own wait after a press applies too.
+	// Gripping one still works as in the game. The map's buttons are listed
+	// again once a second.
+	void VRPushButtons(int alHand, const cMatrixf &in a_mtxPalm, float afCurl, float afScale, bool abFree)
+	{
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		iPhysicsWorld@ pPhysics = pMap !is null ? pMap.GetPhysicsWorld() : null;
+		if(pPhysics is null) return;
+		if(abFree == false)
+		{
+			// (Holding or busy: never pressing, and not ready to until it has
+			// been out of every button again.)
+			mbVRPushReady[alHand] = false;
+			mfVRPushOutTime[alHand] = 0.0f;
+			return;
+		}
+		float fNow = float(cEngine_GetGameTime());
+		if(fNow - mfVRButtonListTime > 1.0f || fNow < mfVRButtonListTime)
+		{
+			mfVRButtonListTime = fNow;
+			mvVRButtonList.resize(0);
+			array<iLuxEntity@> vButtons;
+			pMap.GetEntityArray("*", eLuxEntityType_Prop, "cScrPropMovingButton", vButtons);
+			for(uint i = 0; i < vButtons.length(); ++i)
+			{
+				if(vButtons[i] is null) continue;
+				cScript_SetGlobalReturnBool(false);
+				cScript_RunGlobalFunc(vButtons[i].GetName(), "cScrPropMovingButton", "_Global_VRSimplePress");
+				if(cScript_GetGlobalReturnBool()) mvVRButtonList.push_back(vButtons[i].GetID());
+			}
+			// (And the number locks, see below.)
+			mvVRLockList.resize(0);
+			array<iLuxEntity@> vLocks;
+			pMap.GetEntityArray("*", eLuxEntityType_Prop, "cScrPropCombinationLock", vLocks);
+			for(uint i = 0; i < vLocks.length(); ++i)
+				if(vLocks[i] !is null) mvVRLockList.push_back(vLocks[i].GetID());
+		}
+
+		// How far the hand's balls are in the button they are deepest in, of
+		// those the game would let be used now (fDepth), and of all of them,
+		// whatever the game says now (fDepthAny: a hand left in one after
+		// pressing it, through the game's wait after a press, must not press
+		// it again).
+		cVector3f vPalm = a_mtxPalm.GetTranslation();
+		cVector3f vFingers = vPalm + VRToFingers(a_mtxPalm, afCurl, afScale);
+		float fDepth = 0.0f;
+		float fDepthAny = 0.0f;
+		tID idButton = tID_Invalid;
+		tID idButtonBody = tID_Invalid;
+		cVector3f vSpot = vPalm;
+		iCollideShape@ pPalmBall = null;
+		iCollideShape@ pFingerBall = null;
+		for(uint i = 0; i < mvVRButtonList.length(); ++i)
+		{
+			iLuxEntity@ pButton = cLux_ID_Entity(mvVRButtonList[i]);
+			if(pButton is null || pButton.IsActive() == false || pButton.GetInteractionDisabled()) continue;
+			if((pButton.GetPosition() - vPalm).Length() > gfVRPushNear) continue;
+			if(pPalmBall is null)
+			{
+				float fPalmRadius = gfVRHandRadius * afScale;
+				float fFingerRadius = gfVRFingerRadius * afScale;
+				@pPalmBall = VRKeptBall(pMap, pPhysics, fPalmRadius); // (kept from frame to frame)
+				@pFingerBall = VRKeptBall(pMap, pPhysics, fFingerRadius);
+				if(pPalmBall is null || pFingerBall is null) break;
+			}
+			for(int b = 0; b < pButton.GetBodyNum(); ++b)
+			{
+				iPhysicsBody@ pBody = pButton.GetBody(b);
+				if(pBody is null) continue;
+				iCollideShape@ pShape = pBody.GetShape();
+				if(pShape is null) continue;
+				bool bUsable = pButton.CanInteract(0, pBody);
+				for(int lBall = 0; lBall < 2; ++lBall)
+				{
+					cCollideData data;
+					data.SetMaxSize(4);
+					cVector3f vBall = lBall == 0 ? vPalm : vFingers;
+					if(pPhysics.CheckShapeCollision(pShape, pBody.GetWorldMatrix(), lBall == 0 ? pPalmBall : pFingerBall, cMath_MatrixTranslate(vBall), data, 4, false) == false) continue;
+					for(int p = 0; p < data.GetPointNum() && p < 4; ++p)
+					{
+						float fIn = data.GetPoint(p).mfDepth;
+						if(fIn > fDepthAny) fDepthAny = fIn;
+						if(bUsable == false || fIn <= fDepth) continue;
+						fDepth = fIn;
+						idButton = pButton.GetID();
+						idButtonBody = pBody.GetID();
+						vSpot = data.GetPoint(p).mvPoint;
+					}
+				}
+			}
+		}
+		// (The balls are kept for the next frame: VRKeptBall.)
+
+		// A number lock: the index fingertip on one,
+		// the player standing still, is taken as a squeeze on it, into the
+		// game's lock state, where the fingertip turns its rollers
+		// (PlayerState_Interact_CombinationLock.hps). (The lock does not
+		// collide with anything, so the hand's touch never found it.) It
+		// counts as being in a button for the readiness above: after leaving
+		// the lock, the finger must come off it before it takes it again.
+		tID idLock = tID_Invalid;
+		tID idLockBody = tID_Invalid;
+		cVector3f vTip = mvVRIndexTip[alHand];
+		bool bTipFresh = cMath_Abs(fNow - mfVRIndexTipTime[alHand]) < 0.25f;
+		tID idLockNear = tID_Invalid; // (for the hints: a lock the fingertip is near)
+		if(bTipFresh && mvVRLockList.length() > 0)
+		{
+			iCollideShape@ pTipBall = null;
+			for(uint i = 0; i < mvVRLockList.length(); ++i)
+			{
+				iLuxEntity@ pLock = cLux_ID_Entity(mvVRLockList[i]);
+				if(pLock is null || pLock.IsActive() == false || pLock.GetInteractionDisabled()) continue;
+				if((pLock.GetPosition() - vTip).Length() > gfVRPushNear) continue;
+				if((pLock.GetPosition() - vTip).Length() < gfVRLockHintNear) idLockNear = pLock.GetID();
+				iPhysicsBody@ pBody = pLock.GetMainBody();
+				iCollideShape@ pShape = pBody !is null ? pBody.GetShape() : null;
+				if(pShape is null) continue;
+				if(pTipBall is null)
+				{
+					@pTipBall = VRKeptBall(pMap, pPhysics, gfVRLockTipRadius); // (kept from frame to frame)
+					if(pTipBall is null) break;
+				}
+				cCollideData data;
+				data.SetMaxSize(1);
+				if(pPhysics.CheckShapeCollision(pShape, pBody.GetWorldMatrix(), pTipBall, cMath_MatrixTranslate(vTip), data, 1, false) == false) continue;
+				fDepthAny = cMath_Max(fDepthAny, gfVRPushDepth);
+				if(idLock == tID_Invalid && pLock.CanInteract(0, pBody))
+				{
+					idLock = pLock.GetID();
+					idLockBody = pBody.GetID();
+				}
+			}
+			// (The tip's ball is kept for the next frame: VRKeptBall.)
+		}
+
+		// Out of every button for long enough: ready to press again.
+		if(fDepthAny < gfVRPushOut)
+		{
+			mfVRPushOutTime[alHand] += mfVRArmStep;
+			if(mfVRPushOutTime[alHand] >= gfVRPushRearm) mbVRPushReady[alHand] = true;
+		}
+		else mfVRPushOutTime[alHand] = 0.0f;
+		// (Only in the game's normal state, where a squeeze could use them;
+		// in any other, such as the lock state itself, nothing is tried.)
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		if(pPlayer is null || pPlayer.GetCurrentStateId() != ePlayerState_Normal) return;
+
+		// The hints (VRUpdateHints in PlayerBodyHandler.hps): a
+		// button the hand is in, how it is pressed; a number lock the fingertip
+		// is near, how it is taken.
+		if(idButton != tID_Invalid) BunkerVR_HintOffer(alHand, "button", vSpot);
+		else if(idLockNear != tID_Invalid)
+		{
+			iLuxEntity@ pNearLock = cLux_ID_Entity(idLockNear);
+			if(pNearLock !is null) BunkerVR_HintOffer(alHand, "lock_touch", pNearLock.GetPosition());
+		}
+
+		// A number lock touched, standing still: into it.
+		if(idLock != tID_Invalid && mbVRPushReady[alHand] && (idButton == tID_Invalid || fDepth < gfVRPushDepth))
+		{
+			iCharacterBody@ pCharBody = pPlayer.GetCharacterBody();
+			if(pCharBody is null || cMath_Abs(pCharBody.GetMoveSpeed(eCharDir_Forward)) + cMath_Abs(pCharBody.GetMoveSpeed(eCharDir_Right)) > gfVRLockStill) return;
+			mbVRPushReady[alHand] = false;
+			cScript_SetGlobalArgID(0, idLock);
+			cScript_SetGlobalArgID(1, idLockBody);
+			cScript_SetGlobalArgVector3f(2, vTip);
+			cScript_SetGlobalReturnBool(false);
+			cScript_RunGlobalFunc("State_Normal", "", "_Global_VRPushed");
+			bool bTaken = cScript_GetGlobalReturnBool();
+			iLuxEntity@ pLock = cLux_ID_Entity(idLock);
+			if(bTaken) VRBuzzHand(alHand, 0.03f, 0.4f);
+			if(mlVRPushLogs < 40)
+			{
+				mlVRPushLogs++;
+				Log("BunkerVR: the " + (alHand == 0 ? "left" : "right") + " index finger touches the number lock " + (pLock !is null ? pLock.GetName() : "?") +
+					": " + (bTaken ? "taken, its rollers turned by the fingertip" : "not now (the game lets nothing be used now)") + "\n");
+			}
+			return;
+		}
+		if(fDepth < gfVRPushDepth || mbVRPushReady[alHand] == false || idButton == tID_Invalid) return;
+
+		// Pushed in: pressed, as the game's interaction would (once; then
+		// out again first).
+		mbVRPushReady[alHand] = false;
+		cScript_SetGlobalArgID(0, idButton);
+		cScript_SetGlobalArgID(1, idButtonBody);
+		cScript_SetGlobalArgVector3f(2, vSpot);
+		cScript_SetGlobalReturnBool(false);
+		cScript_RunGlobalFunc("State_Normal", "", "_Global_VRPushed");
+		bool bPressed = cScript_GetGlobalReturnBool();
+		iLuxEntity@ pPushed = cLux_ID_Entity(idButton);
+		if(bPressed) VRBuzzHand(alHand, gfVRPushBuzz, gfVRPushBuzzStrength);
+		if(bPressed) cVR_HintUsed("button"); // (the hints)
+		if(mlVRPushLogs < 40)
+		{
+			mlVRPushLogs++;
+			Log("BunkerVR: the " + (alHand == 0 ? "left" : "right") + " hand pushes " + (pPushed !is null ? pPushed.GetName() : "?") + " in " +
+				int(fDepth * 1000.0f + 0.5f) + " mm: " + (bPressed ? "pressed" : "not now (the game lets nothing be used now)") + "\n");
+		}
+	}
+
+	// BunkerVR: a thing the hand takes whole, as the game takes it: a
+	// pick-up, or a note or dogtag (Prop_Readable, Prop_ReadableDogTag, read
+	// or put in the sketchbook as they are taken). Counted as pick-ups below:
+	// otherwise a note lying on a desk loses to the desk the hand touches as
+	// deep, and one just beyond the hand is never taken (it doesn't move).
+	bool VRIsTakeable(cLuxMap@ apMap, iLuxEntity@ apEntity)
+	{
+		tString sName = apEntity.GetName();
+		return apMap.GetEntityByName(sName, eLuxEntityType_Prop, "cScrPropPickup") !is null ||
+			   apMap.GetEntityByName(sName, eLuxEntityType_Prop, "cScrPropReadable") !is null ||
+			   apMap.GetEntityByName(sName, eLuxEntityType_Prop, "cScrPropReadableDogTag") !is null;
+	}
+
+	// BunkerVR: the area the game lets a thing with no body of its own be used
+	// through (Area_InteractAux.hps, whose "InteractParent" it is),
+	// if there is one and it is on. The gun the soldier holds out in the
+	// bunker is such a thing (revolver_pickup_soldiers_hand.ent has no shapes
+	// and no bodies): the game's rays hit a box on it, Trigger_GunPickupPrompt.
+	// Areas are not among what the hand's touch finds, so it would never find one.
+	iLuxEntity@ VRStandInFor(iLuxEntity@ apItem)
+	{
+		tString sName = apItem.GetName();
+		for(uint i = 0; i < mvVRStandInList.length(); ++i)
+		{
+			iLuxEntity@ pArea = cLux_ID_Entity(mvVRStandInList[i]);
+			if(pArea is null || pArea.IsActive() == false) continue;
+			if(cScript_RunGlobalFunc(pArea.GetName(), "cScrAreaInteractAux", "_Global_GetInteractParent") == false) continue;
+			if(cScript_GetGlobalReturnString() == sName) return pArea;
+		}
+		return null;
+	}
+
+	// BunkerVR: a pick-up with no body of its own that a hand comes near, in
+	// the log once each, for finding why a hand doesn't take it:
+	// the size of its drawn box, how far off that is, and its stand-in.
+	void VRNoteNoBody(iLuxEntity@ apItem, cBoundingVolume@ apBounds, const cVector3f &in avPalm)
+	{
+		float fGap = (apBounds.GetWorldCenter() - avPalm).Length();
+		if(fGap > 0.5f || mvVRNoBodyLogged.length() >= 8 || mvVRNoBodyLogged.find(apItem.GetID()) >= 0) return;
+		mvVRNoBodyLogged.push_back(apItem.GetID());
+		cVector3f vSize = (apBounds.GetMax() - apBounds.GetMin()) * 100.0f;
+		iLuxEntity@ pStandIn = VRStandInFor(apItem);
+		Log("BunkerVR: a hand is near " + apItem.GetName() + ", which has no body of its own: its drawn box " + int(vSize.x + 0.5f) + " x " + int(vSize.y + 0.5f) + " x " + int(vSize.z + 0.5f) +
+			" cm, its middle " + int(fGap * 100.0f + 0.5f) + " cm from the palm; " + (pStandIn !is null ? "taken through " + pStandIn.GetName() : "nothing to take it through") + "\n");
+	}
+
+	// BunkerVR: the nearest pick-up whose drawn model comes within reach of
+	// the hand's balls (afPalmReach around the palm, afFingerReach around the
+	// fingers), going by the model's box in the world. A pick-up's own shape
+	// need not be where it is drawn. Only pick-ups the game would let the
+	// player use now. The map's pick-ups are listed again once a second.
+	// Returns whether one was found; its center's distance from the palm in
+	// afGap. A pick-up with no body at all (the soldier's gun in the bunker)
+	// is returned as its stand-in and that area's body, see VRStandInFor: the
+	// game's own way, and the map hears of it as it does from the game's rays.
+	bool VRNearPickupByLook(const cVector3f &in avPalm, float afPalmReach, const cVector3f &in avFingers, float afFingerReach,
+							tID &out a_idEntity, tID &out a_idBody, cVector3f &out avSpot, float &out afGap)
+	{
+		a_idEntity = tID_Invalid;
+		a_idBody = tID_Invalid;
+		avSpot = avPalm;
+		afGap = 1000.0f;
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		if(pMap is null) return false;
+		float fNow = float(cEngine_GetGameTime());
+		if(fNow - mfVRPickupListTime > 1.0f || fNow < mfVRPickupListTime)
+		{
+			mfVRPickupListTime = fNow;
+			mvVRPickupList.resize(0);
+			for(int lKind = 0; lKind < 3; ++lKind) // (notes and dogtags too, see VRIsTakeable)
+			{
+				array<iLuxEntity@> vItems;
+				pMap.GetEntityArray("*", eLuxEntityType_Prop, lKind == 0 ? "cScrPropPickup" : (lKind == 1 ? "cScrPropReadable" : "cScrPropReadableDogTag"), vItems);
+				for(uint i = 0; i < vItems.length(); ++i)
+					if(vItems[i] !is null) mvVRPickupList.push_back(vItems[i].GetID());
+			}
+			mvVRStandInList.resize(0);
+			pMap.GetEntityArrayID("*", eLuxEntityType_Area, "cScrAreaInteractAux", mvVRStandInList);
+			// (And the areas a hand can use, see VRAreaInHand: those, a map on a wall, and a
+			// trigger the level gave something to do when used. Not a trigger only for an item
+			// to be used on, which does nothing for an empty hand.)
+			mvVRAreaList = mvVRStandInList;
+			{
+				array<iLuxEntity@> vAreas;
+				pMap.GetEntityArray("*", eLuxEntityType_Area, "cScrAreaZoom", vAreas);
+				for(uint i = 0; i < vAreas.length(); ++i)
+					if(vAreas[i] !is null) mvVRAreaList.push_back(vAreas[i].GetID());
+				vAreas.resize(0);
+				pMap.GetEntityArray("*", eLuxEntityType_Area, "cScrAreaTrigger", vAreas);
+				for(uint i = 0; i < vAreas.length(); ++i)
+					if(vAreas[i] !is null && vAreas[i].HasPlayerInteractCallback()) mvVRAreaList.push_back(vAreas[i].GetID());
+				// (And a ladder, climbed onto by a hand in it and a squeeze. It has to be listed: the
+				// touch passes over bodies that don't collide, as an area's, and the squeeze takes
+				// only what the hand touches.)
+				vAreas.resize(0);
+				mvVRLadderAreas.resize(0);
+				pMap.GetEntityArray("*", eLuxEntityType_Area, "cScrAreaLadder", vAreas);
+				for(uint i = 0; i < vAreas.length(); ++i)
+				{
+					if(vAreas[i] is null) continue;
+					mvVRAreaList.push_back(vAreas[i].GetID());
+					mvVRLadderAreas.push_back(vAreas[i].GetID());
+				}
+			}
+			mfVRPickupNearTime = -100.0f;
+		}
+		// (Those in reach of being in reach are listed separately, a few times a second, so
+		// that each hand doesn't go through the whole level's list every frame only to pass
+		// over nearly all of it as more than 2 m off: gfVRPickupNearRadius is more than the
+		// 2 m below, plus the width of two arms, plus a run for that long.)
+		if(fNow - mfVRPickupNearTime > gfVRPickupNearEvery || fNow < mfVRPickupNearTime)
+		{
+			mfVRPickupNearTime = fNow;
+			mvVRPickupNear.resize(0);
+			for(uint i = 0; i < mvVRPickupList.length(); ++i)
+			{
+				iLuxEntity@ pItem = cLux_ID_Entity(mvVRPickupList[i]);
+				if(pItem !is null && (pItem.GetPosition() - avPalm).Length() <= gfVRPickupNearRadius) mvVRPickupNear.push_back(mvVRPickupList[i]);
+			}
+			mvVRAreaNear.resize(0);
+			for(uint i = 0; i < mvVRAreaList.length(); ++i)
+			{
+				iLuxEntity@ pArea = cLux_ID_Entity(mvVRAreaList[i]);
+				if(pArea !is null && (pArea.GetPosition() - avPalm).Length() <= gfVRPickupNearRadius) mvVRAreaNear.push_back(mvVRAreaList[i]);
+			}
+		}
+		for(uint i = 0; i < mvVRPickupNear.length(); ++i)
+		{
+			iLuxEntity@ pItem = cLux_ID_Entity(mvVRPickupNear[i]);
+			if(pItem is null || pItem.IsActive() == false || pItem.GetInteractionDisabled()) continue;
+			if((pItem.GetPosition() - avPalm).Length() > 2.0f) continue; // (far off, whatever its size)
+			cMeshEntity@ pMesh = pItem.GetMeshEntity();
+			cBoundingVolume@ pBounds = pMesh !is null ? pMesh.GetBoundingVolume() : null;
+			if(pBounds is null) continue;
+			iPhysicsBody@ pBody = pItem.GetMainBody();
+			if(pBody is null) VRNoteNoBody(pItem, pBounds, avPalm);
+			cVector3f vLow = pBounds.GetMin(), vHigh = pBounds.GetMax();
+			cVector3f vPalmIn = cVector3f(cMath_Clamp(avPalm.x, vLow.x, vHigh.x), cMath_Clamp(avPalm.y, vLow.y, vHigh.y), cMath_Clamp(avPalm.z, vLow.z, vHigh.z));
+			cVector3f vFingersIn = cVector3f(cMath_Clamp(avFingers.x, vLow.x, vHigh.x), cMath_Clamp(avFingers.y, vLow.y, vHigh.y), cMath_Clamp(avFingers.z, vLow.z, vHigh.z));
+			if((vPalmIn - avPalm).Length() > afPalmReach && (vFingersIn - avFingers).Length() > afFingerReach) continue;
+			iLuxEntity@ pTake = pItem;
+			if(pBody is null)
+			{
+				@pTake = VRStandInFor(pItem);
+				if(pTake !is null) @pBody = pTake.GetBody(0);
+			}
+			if(pBody is null || pTake.CanInteract(0, pBody) == false) continue;
+			float fGap = (pBounds.GetWorldCenter() - avPalm).Length();
+			if(fGap >= afGap) continue;
+			afGap = fGap;
+			a_idEntity = pTake.GetID();
+			a_idBody = pBody.GetID();
+			avSpot = pBounds.GetWorldCenter();
+		}
+		return a_idEntity != tID_Invalid;
+	}
+
+	// BunkerVR: an area the game lets the player use, that the hand is in. Some things can only be
+	// used through one: with the handle and the dynamite in, the detonator is only such an area,
+	// Detonator_InteractArea, and the game can't go on until it is set off. Areas have no solid body,
+	// so they are not among what the touch finds. The game's rays hit them as they hit anything.
+	// Taken only when the hand touches nothing else (VRHandTouchFind): what stands in one, or the
+	// wall behind it, comes first.
+	bool VRAreaInHand(iPhysicsWorld@ apPhysics, iCollideShape@ apPalmBall, const cMatrixf &in a_mtxPalmBall, iCollideShape@ apFingerBall, const cMatrixf &in a_mtxFingerBall, tID &out a_idEntity, tID &out a_idBody)
+	{
+		a_idEntity = tID_Invalid;
+		a_idBody = tID_Invalid;
+		for(uint i = 0; i < mvVRAreaNear.length(); ++i)
+		{
+			iLuxEntity@ pArea = cLux_ID_Entity(mvVRAreaNear[i]);
+			if(pArea is null || pArea.IsActive() == false || pArea.GetInteractionDisabled()) continue;
+			iPhysicsBody@ pBody = pArea.GetBody(0);
+			iCollideShape@ pShape = pBody !is null ? pBody.GetShape() : null;
+			if(pShape is null) continue;
+			if(VRIsLadderArea(mvVRAreaNear[i]))
+			{
+				// (A ladder: also from above its top.)
+				if(VRHandAtLadder(pBody, a_mtxPalmBall.GetTranslation(), a_mtxFingerBall.GetTranslation()) == false) continue;
+			}
+			else
+			{
+				cCollideData data;
+				data.SetMaxSize(1);
+				if(apPhysics.CheckShapeCollision(pShape, pBody.GetWorldMatrix(), apPalmBall, a_mtxPalmBall, data, 1, false) == false &&
+				   apPhysics.CheckShapeCollision(pShape, pBody.GetWorldMatrix(), apFingerBall, a_mtxFingerBall, data, 1, false) == false) continue;
+			}
+			if(pArea.CanInteract(0, pBody) == false) continue;
+			a_idEntity = pArea.GetID();
+			a_idBody = pBody.GetID();
+			return true;
+		}
+		return false;
+	}
+
+	// BunkerVR: is this area one of the map's ladders?
+	bool VRIsLadderArea(tID a_idArea)
+	{
+		for(uint i = 0; i < mvVRLadderAreas.length(); ++i)
+			if(mvVRLadderAreas[i] == a_idArea) return true;
+		return false;
+	}
+
+	// BunkerVR: is a hand (its palm's or fingers' ball at avPalm, avFingers) at a ladder whose area's body is
+	// apBody: in the area or within gfVRLadderReachAround of it, or up to gfVRLadderReachTop above its top (in
+	// its local space: x across, y up, z out)?
+	bool VRHandAtLadder(iPhysicsBody@ apBody, const cVector3f &in avPalm, const cVector3f &in avFingers)
+	{
+		iCollideShape@ pShape = apBody !is null ? apBody.GetShape() : null;
+		if(pShape is null) return false;
+		cMatrixf mtxToLadder = cMath_MatrixInverse(apBody.GetWorldMatrix());
+		cVector3f vHalf = pShape.GetSize() * 0.5f;
+		for(int lBall = 0; lBall < 2; ++lBall)
+		{
+			cVector3f vAt = cMath_MatrixMul(mtxToLadder, lBall == 0 ? avPalm : avFingers);
+			if(cMath_Abs(vAt.x) <= vHalf.x + gfVRLadderReachAround && cMath_Abs(vAt.z) <= vHalf.z + gfVRLadderReachAround &&
+			   vAt.y >= -vHalf.y - gfVRLadderReachAround && vAt.y <= vHalf.y + gfVRLadderReachTop) return true;
+		}
+		return false;
+	}
+
+	// BunkerVR: a ball of this size (afRadius, meters) for the hands' checks, kept from frame to
+	// frame. Made and destroyed again each frame, the balls cost the most of what a hand touches:
+	// the engine's DestroyShape looks for the shape in the list of every shape in the map, from the
+	// front, and a new one is at the back, so each destroy walks all of them (about half a
+	// millisecond a frame in Soldier Quarters, with areas near the hands). Kept while the map and
+	// its physics are the same, as VRHandBlock's own two; this body goes with its map (the body
+	// handler's DestroyBodyModel), so a shape of another map's physics is never used, nor destroyed
+	// here. A kept ball is the same as one made afresh: a ball about its center, placed by the
+	// matrix each check is given.
+	iCollideShape@ VRKeptBall(cLuxMap@ apMap, iPhysicsWorld@ apPhysics, float afRadius)
+	{
+		if(apMap is null || apPhysics is null) return null;
+		if(apMap !is mpVRKeptBallsMap || apPhysics !is mpVRKeptBallsPhysics)
+		{
+			mvVRKeptBalls.resize(0);
+			mvVRKeptBallRadii.resize(0);
+			@mpVRKeptBallsMap = apMap;
+			@mpVRKeptBallsPhysics = apPhysics;
+		}
+		for(uint i = 0; i < mvVRKeptBallRadii.length(); ++i)
+			if(cMath_Abs(mvVRKeptBallRadii[i] - afRadius) < 0.00001f) return mvVRKeptBalls[i];
+		// (Only a few sizes are asked for, seven in all. Should the hands' size change many times,
+		// those kept are let go and made again as needed.)
+		if(mvVRKeptBalls.length() >= 16)
+		{
+			for(uint i = 0; i < mvVRKeptBalls.length(); ++i)
+				if(mvVRKeptBalls[i] !is null) apPhysics.DestroyShape(mvVRKeptBalls[i]);
+			mvVRKeptBalls.resize(0);
+			mvVRKeptBallRadii.resize(0);
+		}
+		iCollideShape@ pBall = apPhysics.CreateSphereShape(cVector3f(afRadius, afRadius, afRadius), cMatrixf_Identity);
+		if(pBall is null) return null;
+		mvVRKeptBalls.push_back(pBall);
+		mvVRKeptBallRadii.push_back(afRadius);
+		if(mlVRKeptBallLogs < 12)
+		{
+			mlVRKeptBallLogs++;
+			Log("BunkerVR: a ball for the hands' checks made, " + int(afRadius * 1000.0f + 0.5f) + " mm from its middle to its edge, kept from frame to frame (" +
+				mvVRKeptBalls.length() + " kept)\n");
+		}
+		return pBall;
+	}
+
+	// BunkerVR: what a hand touches that it can take hold of or use. Only what comes within
+	// gfVRHandTouchRoom of the hand's two balls (the palm's and the fingers', as in VRHandBlock), placed
+	// where the hand is drawn, counts. The drawn hand stops at walls, tables and loose things, so what is
+	// behind them is never touched (the game's own pick, a fan of rays in Utility_PickBasics.hps, can find
+	// a thing behind a thin wall). Of the things touched that can be used (the game's own "can interact"),
+	// the one whose surface is nearest the balls (the deepest contact, then the smallest) is reported to the
+	// picks: "BunkerVR_TouchEntity0/1", "BunkerVR_TouchBody0/1", "BunkerVR_TouchSpot0/1" (where on it the
+	// hand touches) and "BunkerVR_TouchTime0/1" (when it was reported; a report older than a quarter of a
+	// second is ignored and the picks fall back to their rays). Nothing is reported for a hand that holds
+	// something (abHolds). abHint: an open hand that does nothing else gives two light ticks when it comes
+	// onto a thing it did not touch a moment ago (gfVRTouchHintKeep).
+	// When nothing is touched, a pick-up or a small thing up to gfVRHandNearReach further off counts, the
+	// one whose center is nearest the palm: otherwise a box of bullets on a table is hard to touch, as the
+	// drawn hand is stopped by the table and pushes the box along.
+	void VRHandTouchFind(int alHand, const cMatrixf &in a_mtxPalm, float afCurl, float afScale, bool abHolds, bool abHint)
+	{
+		tID idTouchEntity = tID_Invalid;
+		tID idTouchBody = tID_Invalid;
+		cVector3f vSpot = a_mtxPalm.GetTranslation();
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		iPhysicsWorld@ pPhysics = pMap !is null ? pMap.GetPhysicsWorld() : null;
+		if(abHolds == false && pPhysics !is null)
+		{
+			cVector3f vPalm = a_mtxPalm.GetTranslation();
+			cVector3f vFingers = vPalm + VRToFingers(a_mtxPalm, afCurl, afScale);
+			float fPalmRadius = gfVRHandRadius * afScale + gfVRHandTouchRoom;
+			float fFingerRadius = gfVRFingerRadius * afScale + gfVRHandTouchRoom;
+			cVector3f vLow = cVector3f(cMath_Min(vPalm.x - fPalmRadius, vFingers.x - fFingerRadius), cMath_Min(vPalm.y - fPalmRadius, vFingers.y - fFingerRadius),
+									   cMath_Min(vPalm.z - fPalmRadius, vFingers.z - fFingerRadius));
+			cVector3f vHigh = cVector3f(cMath_Max(vPalm.x + fPalmRadius, vFingers.x + fFingerRadius), cMath_Max(vPalm.y + fPalmRadius, vFingers.y + fFingerRadius),
+										cMath_Max(vPalm.z + fPalmRadius, vFingers.z + fFingerRadius));
+			// (Search further out, for doors whose handle the hand is at: see
+			// VRDoorHandleNear. Anything else found only that far off is not
+			// touched by the balls, and is passed over below.)
+			vLow = vLow - cVector3f(gfVRHandleSearch, gfVRHandleSearch, gfVRHandleSearch);
+			vHigh = vHigh + cVector3f(gfVRHandleSearch, gfVRHandleSearch, gfVRHandleSearch);
+			array<iPhysicsBody@> vNear;
+			VRTimeMark(7114); // (timing: finding the bodies near, to 7115)
+			pPhysics.GetBodiesInAABB(vLow, vHigh, false, false, vNear); // (things that do not move too: a button on a wall)
+			VRTimeMark(7115);
+			// (The balls are fetched only once a body near needs them: most frames
+			// nothing near does.)
+			iCollideShape@ pPalmBall = null;
+			iCollideShape@ pFingerBall = null;
+			// (The same, gfVRHandNearReach bigger, for a pick-up or a small
+			// thing just beyond the touch, taken when nothing is touched.)
+			float fNearPalm = fPalmRadius + gfVRHandNearReach, fNearFinger = fFingerRadius + gfVRHandNearReach;
+			iCollideShape@ pNearPalmBall = null;
+			iCollideShape@ pNearFingerBall = null;
+			tID idNearEntity = tID_Invalid;
+			tID idNearBody = tID_Invalid;
+			cVector3f vNearSpot = vSpot;
+			float fNearGap = 1000.0f;
+			// (The nearest pick-up just beyond, kept on its own; and whether
+			// the thing touched is a pick-up, or something big and plain.)
+			tID idNearPickupEntity = tID_Invalid;
+			tID idNearPickupBody = tID_Invalid;
+			cVector3f vNearPickupSpot = vSpot;
+			float fNearPickupGap = 1000.0f;
+			bool bBestPickup = false;
+			bool bBestPlainBig = false;
+			tID idAreaEntity = tID_Invalid; // (an area the hand is in, VRAreaInHand)
+			tID idAreaBody = tID_Invalid;
+			{
+				cMatrixf mtxPalmBall = cMath_MatrixTranslate(vPalm);
+				cMatrixf mtxFingerBall = cMath_MatrixTranslate(vFingers);
+				float fBestDepth = -1.0f;	// how deep the balls are in the best so far (from the contact's own figure; 0 if it gave none)
+				float fBestSize = 0.0f;		// and how big its box is
+				// (What the other hand holds with the game's grab counts whatever
+				// the game says of it then, so that this hand can help hold it:
+				// "BunkerVR_GrabBody", set on every update of that grab.)
+				tID idGrabBody = cScript_GetGlobalVarID("BunkerVR_GrabBody");
+				if(cMath_Abs(float(cEngine_GetGameTime()) - cScript_GetGlobalVarFloat("BunkerVR_GrabTime")) > 0.25f) idGrabBody = tID_Invalid;
+				VRTimeMark(7122); // (timing: all the bodies near tried, to 7123)
+				for(uint i = 0; i < vNear.length(); ++i)
+				{
+					iPhysicsBody@ pBody = vNear[i];
+					if(pBody is null || pBody.IsCharacter() || pBody.GetCollide() == false) continue;
+					iLuxEntity@ pEntity = cLux_GetBodyEntity(pBody);
+					if(pEntity is null || VRIsOwnEntity(pEntity)) continue;
+					// (Nothing the game has deactivated: a note taken or a dog tag
+					// read is, but its body stays where it lay, and taking it again
+					// would make the game read it again.)
+					if(pEntity.IsActive() == false) continue;
+					bool bGrabbed = idGrabBody != tID_Invalid && pBody.GetID() == idGrabBody;
+					VRTimeMark(7116); // (timing: the game's can-use check, to 7117)
+					bool bMayUse = bGrabbed || (pEntity.GetInteractionDisabled() == false && pEntity.CanInteract(0, pBody));
+					VRTimeMark(7117);
+					if(bMayUse == false) continue;
+					iCollideShape@ pShape = pBody.GetShape();
+					if(pShape is null) continue;
+					if(pPalmBall is null) @pPalmBall = VRKeptBall(pMap, pPhysics, fPalmRadius);
+					if(pFingerBall is null) @pFingerBall = VRKeptBall(pMap, pPhysics, fFingerRadius);
+					if(pPalmBall is null || pFingerBall is null) continue;
+
+					// Each ball against this body's own shape (the engine's check,
+					// as the game's traps use it), with where they meet.
+					float fDepth = -1.0f;
+					cVector3f vContact = cVector3f(0.0f);
+					VRTimeMark(7118); // (timing: the balls against it, to 7119)
+					for(int lBall = 0; lBall < 2; ++lBall)
+					{
+						cCollideData data;
+						data.SetMaxSize(4);
+						if(pPhysics.CheckShapeCollision(pShape, pBody.GetWorldMatrix(), lBall == 0 ? pPalmBall : pFingerBall, lBall == 0 ? mtxPalmBall : mtxFingerBall, data, 4, false) == false) continue;
+						if(fDepth < 0.0f)
+						{
+							fDepth = 0.0f;
+							vContact = lBall == 0 ? vPalm : vFingers;
+						}
+						for(int p = 0; p < data.GetPointNum() && p < 4; ++p)
+						{
+							if(data.GetPoint(p).mfDepth <= fDepth) continue;
+							fDepth = data.GetPoint(p).mfDepth;
+							vContact = data.GetPoint(p).mvPoint;
+						}
+					}
+					VRTimeMark(7119);
+					// A door's handle counts as the door (see VRDoorHandleNear):
+					// how far a ball is inside the handle's reach counts as deep as
+					// a ball in a shape.
+					if(pBody.GetMass() > 0.0f && pBody.GetJointNum() > 0)
+					{
+						VRTimeMark(7120); // (timing: a door's handles, to 7121)
+						float fHandle = VRDoorHandleNear(pEntity, vPalm, fPalmRadius, vFingers, fFingerRadius);
+						VRTimeMark(7121);
+						if(fHandle >= 0.0f && fHandle > fDepth)
+						{
+							fDepth = fHandle;
+							vContact = mvVRHandleSpot;
+						}
+					}
+					cBoundingVolume@ pBox = pBody.GetBoundingVolume();
+					cVector3f vSize = pBox !is null ? pBox.GetMax() - pBox.GetMin() : cVector3f(1.0f);
+					bool bPickup = VRIsTakeable(pMap, pEntity);
+					if(fDepth < 0.0f)
+					{
+						// Not touched. A pick-up or a small thing loose in the world,
+						// within the bigger balls: kept, the nearest to the palm, in
+						// case nothing is touched. A pick-up counts even if it does
+						// not move, and the nearest pick-up is also kept on its own
+						// (see below).
+						if(bGrabbed || (pBody.GetMass() <= 0.0f && bPickup == false)) continue;
+						if(bPickup == false && cMath_Max(vSize.x, cMath_Max(vSize.y, vSize.z)) > gfVRHandNearSmall) continue;
+						float fGap = (pBody.GetWorldPosition() - vPalm).Length();
+						if(fGap >= fNearGap && (bPickup == false || fGap >= fNearPickupGap)) continue;
+						if(pNearPalmBall is null) @pNearPalmBall = VRKeptBall(pMap, pPhysics, fNearPalm);
+						if(pNearFingerBall is null) @pNearFingerBall = VRKeptBall(pMap, pPhysics, fNearFinger);
+						if(pNearPalmBall is null || pNearFingerBall is null) continue;
+						cCollideData nearData;
+						nearData.SetMaxSize(1);
+						if(pPhysics.CheckShapeCollision(pShape, pBody.GetWorldMatrix(), pNearPalmBall, mtxPalmBall, nearData, 1, false) == false &&
+						   pPhysics.CheckShapeCollision(pShape, pBody.GetWorldMatrix(), pNearFingerBall, mtxFingerBall, nearData, 1, false) == false) continue;
+						if(fGap < fNearGap)
+						{
+							fNearGap = fGap;
+							idNearEntity = pEntity.GetID();
+							idNearBody = pBody.GetID();
+							vNearSpot = pBody.GetWorldPosition();
+						}
+						if(bPickup && fGap < fNearPickupGap)
+						{
+							fNearPickupGap = fGap;
+							idNearPickupEntity = pEntity.GetID();
+							idNearPickupBody = pBody.GetID();
+							vNearPickupSpot = pBody.GetWorldPosition();
+						}
+						continue;
+					}
+
+					// Of the things touched: a pick-up before anything else (a hand
+					// put on a box of bullets touches what the box lies on as deep
+					// or deeper, and would take that); then the deepest; as deep,
+					// the smaller one (the thing in the crate rather than the crate).
+					float fSize = vSize.x * vSize.y * vSize.z;
+					if(bPickup == false && bBestPickup) continue;
+					if(bPickup == bBestPickup)
+					{
+						if(fDepth < fBestDepth - 0.002f) continue;
+						if(fDepth < fBestDepth + 0.002f && fSize >= fBestSize) continue;
+					}
+					fBestDepth = fDepth;
+					fBestSize = fSize;
+					bBestPickup = bPickup;
+					// (Something big that is not on a hinge or a rail, not a pick-up,
+					// not what the other hand holds: a pick-up just beyond the hand
+					// is taken rather than it, below.)
+					bBestPlainBig = bPickup == false && bGrabbed == false && pBody.GetJointNum() == 0 &&
+									cMath_Max(vSize.x, cMath_Max(vSize.y, vSize.z)) > gfVRHandNearSmall;
+					idTouchEntity = pEntity.GetID();
+					idTouchBody = pBody.GetID();
+					vSpot = vContact;
+				}
+				VRTimeMark(7123);
+				if(idTouchEntity == tID_Invalid && mvVRAreaNear.length() > 0)
+				{
+					if(pPalmBall is null) @pPalmBall = VRKeptBall(pMap, pPhysics, fPalmRadius);
+					if(pFingerBall is null) @pFingerBall = VRKeptBall(pMap, pPhysics, fFingerRadius);
+					if(pPalmBall !is null && pFingerBall !is null) VRAreaInHand(pPhysics, pPalmBall, mtxPalmBall, pFingerBall, mtxFingerBall, idAreaEntity, idAreaBody);
+				}
+			}
+			// (The balls are kept for the next frame: VRKeptBall.)
+			// A pick-up whose drawn model is within the bigger balls, though its
+			// own shape was not found (VRNearPickupByLook), when no pick-up was
+			// found by its shape.
+			bool bByLook = false;
+			if(idNearPickupEntity == tID_Invalid && (idTouchEntity == tID_Invalid || bBestPlainBig))
+			{
+				VRTimeMark(7124); // (timing: the pick-ups by their look, to 7125)
+				bByLook = VRNearPickupByLook(vPalm, fPalmRadius + gfVRHandNearReach, vFingers, fFingerRadius + gfVRHandNearReach,
+											 idNearPickupEntity, idNearPickupBody, vNearPickupSpot, fNearPickupGap);
+				VRTimeMark(7125);
+			}
+			// A pick-up just beyond the hand, rather than something big and plain
+			// the hand touches (what it lies on or leans against), or than a small
+			// thing beside it; noted in the log the first time for each.
+			if(idNearPickupEntity != tID_Invalid && (idTouchEntity == tID_Invalid || bBestPlainBig))
+			{
+				iLuxEntity@ pNear = cLux_ID_Entity(idNearPickupEntity);
+				iLuxEntity@ pInstead = cLux_ID_Entity(idTouchEntity);
+				if(idNearPickupEntity != mvVRNearLogged[alHand] && mlVRNearLogs < 30)
+				{
+					mlVRNearLogs++;
+					Log("BunkerVR: the " + (alHand == 0 ? "left" : "right") + " hand is near enough to take " + (pNear !is null ? pNear.GetName() : "?") +
+						" (not touched; " + (bByLook ? "its drawn model's middle " : "its middle ") + int(fNearPickupGap * 100.0f + 0.5f) + " cm from the palm" +
+						(pInstead !is null ? "; rather than " + pInstead.GetName() + ", which it touches" : "") + ")\n");
+				}
+				mvVRNearLogged[alHand] = idNearPickupEntity;
+				idTouchEntity = idNearPickupEntity;
+				idTouchBody = idNearPickupBody;
+				vSpot = vNearPickupSpot;
+			}
+			// Nothing touched: the pick-up or small thing just beyond, if any,
+			// noted in the log the first time for each.
+			else if(idTouchEntity == tID_Invalid && idNearEntity != tID_Invalid)
+			{
+				idTouchEntity = idNearEntity;
+				idTouchBody = idNearBody;
+				vSpot = vNearSpot;
+				if(idNearEntity != mvVRNearLogged[alHand] && mlVRNearLogs < 30)
+				{
+					mlVRNearLogs++;
+					iLuxEntity@ pNear = cLux_ID_Entity(idNearEntity);
+					Log("BunkerVR: the " + (alHand == 0 ? "left" : "right") + " hand is near enough to take " + (pNear !is null ? pNear.GetName() : "?") +
+						" (not touched; its middle " + int(fNearGap * 100.0f + 0.5f) + " cm from the palm)\n");
+				}
+				mvVRNearLogged[alHand] = idNearEntity;
+			}
+			// Nothing else: the area the hand is in, if any.
+			else if(idTouchEntity == tID_Invalid && idAreaEntity != tID_Invalid)
+			{
+				idTouchEntity = idAreaEntity;
+				idTouchBody = idAreaBody;
+				if(idAreaEntity != mvVRNearLogged[alHand] && mlVRNearLogs < 30)
+				{
+					mlVRNearLogs++;
+					iLuxEntity@ pArea = cLux_ID_Entity(idAreaEntity);
+					Log("BunkerVR: the " + (alHand == 0 ? "left" : "right") + " hand is in " + (pArea !is null ? pArea.GetName() : "?") + ", an area it can use\n");
+				}
+				mvVRNearLogged[alHand] = idAreaEntity;
+			}
+		}
+		VRTimeMark(7126); // (timing: reporting what was found, and the ticks, to 7127)
+		tString sHand = alHand == 0 ? "0" : "1";
+		cScript_SetGlobalVarID("BunkerVR_TouchEntity" + sHand, idTouchEntity);
+		cScript_SetGlobalVarID("BunkerVR_TouchBody" + sHand, idTouchBody);
+		cScript_SetGlobalVarVector3f("BunkerVR_TouchSpot" + sHand, vSpot);
+		cScript_SetGlobalVarFloat("BunkerVR_TouchTime" + sHand, float(cEngine_GetGameTime()));
+
+		// The ticks: two, a moment apart, for a thing not touched just before.
+		// (Holding: the thing held counts as touched, so letting go of it does
+		// not tick.)
+		if(mfVRTouchHintSecond[alHand] >= 0.0f)
+		{
+			mfVRTouchHintSecond[alHand] -= mfVRArmStep;
+			if(mfVRTouchHintSecond[alHand] < 0.0f) VRBuzzHand(alHand, gfVRTouchHintBuzz, gfVRTouchHintStrength);
+		}
+		if(idTouchEntity != tID_Invalid)
+		{
+			if(idTouchEntity != mvVRTouchHintLast[alHand] && abHint)
+			{
+				VRBuzzHand(alHand, gfVRTouchHintBuzz, gfVRTouchHintStrength);
+				mfVRTouchHintSecond[alHand] = gfVRTouchHintGap;
+				mfVRPushBuzzWait[alHand] = 0.25f; // (no bump buzz on top of it)
+			}
+			mvVRTouchHintLast[alHand] = idTouchEntity;
+			mfVRTouchHintGone[alHand] = 0.0f;
+		}
+		else if(abHolds == false)
+		{
+			mfVRTouchHintGone[alHand] += mfVRArmStep;
+			if(mfVRTouchHintGone[alHand] > gfVRTouchHintKeep) mvVRTouchHintLast[alHand] = tID_Invalid;
+		}
+		VRTimeMark(7127);
+	}
+
+	// BunkerVR: a hand stops at walls, floors, tables and anything else solid,
+	// and an empty one pushes loose things it moves into (a can along a table).
+	//
+	// The hand is two balls: one round the palm, and a smaller one round the
+	// fingers (ahead of the palm, the way UpdateVRArm lays the drawn fingers).
+	// They go towards the real hand in steps of at most gfVRHandStep. A step
+	// that ends in the world's solid parts (anything that does not move:
+	// walls, floors, tables, shelves) is pushed back out by the engine's own
+	// check, the one its characters use, so the hand slides along a wall or a
+	// table top. A step that cannot be pushed clear is not taken: the hand
+	// stays where it was and never goes through. (Longer steps when the real
+	// hand is far in, or letting a stuck hand through after a while, make the
+	// arm jump around and clip through the wall.) Loose things stop the hand
+	// too (a step into one is taken back, as far along each way as it will
+	// go, so the hand slides along it), and a hand pressed against one pushes
+	// it with a hand's strength (gfVRHandPushForce), open or closed; a hand
+	// holding something (abHolds) pushes nothing. Doors and other things on a
+	// hinge or a rail are left to VRHandPress. Not while the hand holds an
+	// item, a door or the gun (abBusy): it then goes where the real hand is.
+	// abFixed: the hand is drawn held on a door's handle or a ladder's rung, or fitting an item
+	// (a_mtxPalm is that place, not the real hand's): let go, it starts from there.
+	// Returns how far the drawn hand is held back from the palm (0 0 0: not).
+	cVector3f VRHandBlock(int alHand, const cMatrixf &in a_mtxPalm, float afCurl, float afScale, bool abBusy, bool abHolds, bool abFixed)
+	{
+		cVector3f vPalm = a_mtxPalm.GetTranslation();
+		cVector3f vPalmMove = vPalm - mvVRBlockPalmWas[alHand];
+		mvVRBlockPalmWas[alHand] = vPalm;
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		iPhysicsWorld@ pPhysics = pMap !is null ? pMap.GetPhysicsWorld() : null;
+		if(abBusy || pPhysics is null || mfVRArmStep < 0.0001f)
+		{
+			mvVRBlockAt[alHand] = vPalm;
+			mbVRBlockKnown[alHand] = false;
+			mbVRBlockTouching[alHand] = false;
+			mfVRBlockStuck[alHand] = 0.0f;
+			mbVRBlockWasFixed[alHand] = abFixed && abBusy && pPhysics !is null;
+			return cVector3f(0.0f);
+		}
+
+		// Where the fingers' ball is, from the palm's (VRToFingers).
+		cVector3f vToFingers = VRToFingers(a_mtxPalm, afCurl, afScale);
+		float fPalmRadius = gfVRHandRadius * afScale;
+		float fFingerRadius = gfVRFingerRadius * afScale;
+
+		// Where the balls were last frame. The first time (or after holding
+		// an item) they start at the palm; after a jump of the whole view (a
+		// snap turn) they go along with the palm.
+		cVector3f vFrom = mvVRBlockAt[alHand];
+		cVector3f vBeforeJump = vFrom;
+		bool bJumped = false;
+		if(mbVRBlockKnown[alHand] == false)
+		{
+			// (From where the hand was drawn last frame: after holding a thing
+			// pressed into a table, that is on the table top, while the real
+			// hand is in it. Started from the real hand, a hand that has just
+			// let go can come out far from where it was drawn.)
+			vFrom = vPalm + (mvVRBlockShift[alHand].Length() < 0.6f ? mvVRBlockShift[alHand] : cVector3f(0.0f));
+			// (A hand let go of a ladder's rung or a door's handle starts from there, where it was drawn, and walks
+			// to the real hand as usual, stopped by what is between. Climbing onto a ladder moves the body, and so the
+			// real hand, into the wall behind the rungs: started from the real hand, the balls would start in the wall
+			// and stay there, the arm clipped through it.)
+			if(mbVRBlockWasFixed[alHand] && (mvVRBlockAt[alHand] - vPalm).Length() < gfVRHandFromHeldMost) vFrom = mvVRBlockAt[alHand];
+			bJumped = true;
+		}
+		else if(vPalmMove.Length() > gfVRHandJump)
+		{
+			vFrom = vFrom + vPalmMove;
+			bJumped = true;
+		}
+		mbVRBlockWasFixed[alHand] = false;
+
+		// The loose things near the way the balls may go this frame: each one
+		// stops the hand (vSolid), and may be pushed (vLight, vLightEntity).
+		// (Whatever its weight: if light things were given the hand's speed
+		// instead, hands would push them too easily and pass through big ones.)
+		float fNear = fPalmRadius + gfVRFingerReach * afScale + fFingerRadius + gfVRHandStep * float(glVRHandSteps) + 0.02f;
+		cVector3f vLow = cVector3f(cMath_Min(vFrom.x, vPalm.x) - fNear, cMath_Min(vFrom.y, vPalm.y) - fNear, cMath_Min(vFrom.z, vPalm.z) - fNear);
+		cVector3f vHigh = cVector3f(cMath_Max(vFrom.x, vPalm.x) + fNear, cMath_Max(vFrom.y, vPalm.y) + fNear, cMath_Max(vFrom.z, vPalm.z) + fNear);
+		array<iPhysicsBody@> vNear;
+		pPhysics.GetBodiesInAABB(vLow, vHigh, true, false, vNear);
+		array<iLuxEntity@> vSolid;
+		array<iPhysicsBody@> vLight;
+		array<iLuxEntity@> vLightEntity;
+		for(uint i = 0; i < vNear.length(); ++i)
+		{
+			iPhysicsBody@ pBody = vNear[i];
+			if(VRHandMayTouch(pBody) == false) continue;
+			iLuxEntity@ pEntity = cLux_GetBodyEntity(pBody);
+			if(pEntity is null || VRIsOwnEntity(pEntity)) continue;
+			vSolid.insertLast(pEntity);
+			vLight.insertLast(pBody);
+			vLightEntity.insertLast(pEntity);
+		}
+
+		// The world's solid parts near that way too: with none, no ball can meet them, and the
+		// checks against them are skipped (VRHandWorldOut). How often they are near goes to the
+		// log as note 86.
+		array<iPhysicsBody@> vWorldNear;
+		pPhysics.GetBodiesInAABB(vLow, vHigh, false, true, vWorldNear);
+		mbVRWorldNear = vWorldNear.length() > 0;
+		mlVRWorldNearCount += mbVRWorldNear ? 1 : 0;
+		mlVRWorldNearOf++;
+		if(mlVRWorldNearOf >= 1800) // (for the log: how often it was near, about every 10 seconds)
+		{
+			VRNote(86, cVector3f(float(mlVRWorldNearCount), float(mlVRWorldNearOf), float(vWorldNear.length())));
+			mlVRWorldNearCount = 0;
+			mlVRWorldNearOf = 0;
+		}
+
+		// (Both hands use one pair of balls, as making one costs about 85 microseconds. They are
+		// kept from frame to frame while the map, its physics and the hands' size are the same: a
+		// shape of another map's physics is never used, nor destroyed here, as that map's physics
+		// went with it.)
+		if(mpVRBlockPalmBall !is null || mpVRBlockFingerBall !is null)
+		{
+			if(pMap !is mpVRBlockMap || pPhysics !is mpVRBlockPhysics)
+			{
+				@mpVRBlockPalmBall = null;
+				@mpVRBlockFingerBall = null;
+			}
+			else if(cMath_Abs(afScale - mfVRBlockBallScale) > 0.0001f)
+			{
+				if(mpVRBlockPalmBall !is null) pPhysics.DestroyShape(mpVRBlockPalmBall);
+				if(mpVRBlockFingerBall !is null) pPhysics.DestroyShape(mpVRBlockFingerBall);
+				@mpVRBlockPalmBall = null;
+				@mpVRBlockFingerBall = null;
+			}
+		}
+		if(mpVRBlockPalmBall is null || mpVRBlockFingerBall is null)
+		{
+			@mpVRBlockMap = pMap;
+			@mpVRBlockPhysics = pPhysics;
+			mfVRBlockBallScale = afScale;
+		}
+		if(mpVRBlockPalmBall is null) @mpVRBlockPalmBall = pPhysics.CreateSphereShape(cVector3f(fPalmRadius, fPalmRadius, fPalmRadius), cMatrixf_Identity);
+		if(mpVRBlockFingerBall is null) @mpVRBlockFingerBall = pPhysics.CreateSphereShape(cVector3f(fFingerRadius, fFingerRadius, fFingerRadius), cMatrixf_Identity);
+		iCollideShape@ pPalmBall = mpVRBlockPalmBall;
+		iCollideShape@ pFingerBall = mpVRBlockFingerBall;
+		cVector3f vAt = vFrom;
+		bool bTouched = false;
+		float fTouchMass = 0.0f;	// (for the log: 0 = the world, else the weight limit: a heavy thing)
+		if(pPalmBall !is null && pFingerBall !is null)
+		{
+			// Start in the clear. (After a jump the balls may have landed in
+			// something: if they cannot be pushed clear there, they stay
+			// where they were before it, and walk over from there.)
+			vAt = VRHandMakeClear(pPhysics, pPalmBall, pFingerBall, vAt, vToFingers);
+			if(mbVRClearPushed) bTouched = true;
+			if(mbVRClearOk == false && bJumped && mbVRBlockKnown[alHand])
+			{
+				// (Unless where they were is now far from the real hand, the body having been moved a long way,
+				// as when climbing onto a ladder from its top, turned round. Then they start from the eyes (the
+				// game's camera, over the body, in the clear) and walk out to the real hand, stopped by what is
+				// between; started from where they were, on the ladder's top, they would stick there.)
+				cVector3f vStart = vBeforeJump;
+				cLuxPlayer@ pVRPlayer = cLux_GetPlayer();
+				cCamera@ pVRCam = pVRPlayer !is null ? pVRPlayer.GetCamera() : null;
+				if((vBeforeJump - vPalm).Length() > gfVRHandJumpBackMost && pVRCam !is null) vStart = pVRCam.GetPosition();
+				vAt = VRHandMakeClear(pPhysics, pPalmBall, pFingerBall, vStart, vToFingers);
+				if(mbVRClearPushed) bTouched = true;
+			}
+
+			// Steps towards the real hand, each at most gfVRHandStep long.
+			for(int i = 0; i < glVRHandSteps; ++i)
+			{
+				cVector3f vLeft = vPalm - vAt;
+				float fLeft = vLeft.Length();
+				if(fLeft < 0.0005f) break;
+				cVector3f vTry = vAt + vLeft * (cMath_Min(fLeft, gfVRHandStep) / fLeft);
+
+				// Out of the world's solid parts; a step that cannot be pushed
+				// clear is not taken.
+				vTry = VRHandMakeClear(pPhysics, pPalmBall, pFingerBall, vTry, vToFingers);
+				if(mbVRClearOk == false)
+				{
+					bTouched = true;
+					break;
+				}
+				if(mbVRClearPushed) bTouched = true;
+
+				// Into a loose thing, or deeper into one it is in already: back,
+				// but as far along each way as it will go (see VRHandStepOk).
+				if(vSolid.length() > 0 && VRHandStepOk(pPalmBall, pFingerBall, vAt, vTry, vToFingers, vSolid, vLight, pMap) == false)
+				{
+					// First as near to it as the step allows (the step halved
+					// four times: to within a millimeter), so that the hand is
+					// drawn touching it and pushes it, rather than stopping up to
+					// a whole step (1.5 cm) short of it.
+					cVector3f vSlide = vAt;
+					cVector3f vFar = vTry;
+					for(int lHalf = 0; lHalf < 4; ++lHalf)
+					{
+						cVector3f vMid = (vSlide + vFar) * 0.5f;
+						if(VRHandStepOk(pPalmBall, pFingerBall, vAt, vMid, vToFingers, vSolid, vLight, pMap) &&
+							VRHandWorldOut(pPhysics, pPalmBall, vMid).Length() < gfVRHandClear) vSlide = vMid;
+						else vFar = vMid;
+					}
+					// Then along each way as far as it will go.
+					for(int lAxis = 0; lAxis < 3; ++lAxis)
+					{
+						cVector3f vNext = vSlide;
+						if(lAxis == 0) vNext.x = vTry.x;
+						else if(lAxis == 1) vNext.y = vTry.y;
+						else vNext.z = vTry.z;
+						if(VRHandStepOk(pPalmBall, pFingerBall, vSlide, vNext, vToFingers, vSolid, vLight, pMap) &&
+							VRHandWorldOut(pPhysics, pPalmBall, vNext).Length() < gfVRHandClear) vSlide = vNext;
+					}
+					vTry = vSlide;
+					bTouched = true;
+					fTouchMass = gfVRHandSolidMass;
+				}
+
+				// No way on (pressed against something): stop here this frame.
+				if((vTry - vAt).Length() < 0.0005f) break;
+				vAt = vTry;
+			}
+
+			// Pushing loose things. The hand
+			// stops at them (above), open or closed, and pushes what it touches
+			// with a hand's strength, the way it goes: the real hand's way while
+			// it moves, otherwise the way it is pressed in (the real hand beyond
+			// the one that is seen). Touched: what the balls meet a little ahead
+			// that way (gfVRHandPushReach, or as far as the real hand is beyond,
+			// up to 1 cm), so a hand going along with a thing keeps pushing it,
+			// instead of stopping at it, shoving it off, catching up and shoving
+			// it again, which makes pushing jittery and rigid. The thing is sped up that way
+			// towards the real hand's own speed, plus a little for how far the
+			// real hand is beyond (gfVRHandPressRate), never faster than
+			// gfVRHandMaxPushSpeed, gaining at most gfVRHandPushAccel each
+			// second, and pushed with at most gfVRHandPushForce. So a can goes
+			// along with the hand, a bucket more slowly, and the crate, the urn
+			// and the block (more than one hand can shove) hardly move, and the
+			// hand stops at them. Not after a jump of the view.
+			cVector3f vPress = vPalm - vAt;
+			float fPress = vPress.Length();
+			cVector3f vHandSpeed = vPalmMove * (1.0f / mfVRArmStep);
+			float fHandSpeed = vHandSpeed.Length();
+			cVector3f vDir = cVector3f(0.0f);
+			if(fHandSpeed > 0.05f) vDir = vHandSpeed * (1.0f / fHandSpeed);
+			else if(fPress > 0.002f) vDir = vPress * (1.0f / fPress);
+			if(abHolds == false && bJumped == false && vLight.length() > 0 && vDir.Length() > 0.5f)
+			{
+				float fAlong = cMath_Max(cMath_Vector3Dot(vHandSpeed, vDir), 0.0f);
+				float fPressAlong = cMath_Max(cMath_Vector3Dot(vPress, vDir), 0.0f);
+				float fWant = cMath_Min(fAlong + fPressAlong * gfVRHandPressRate, gfVRHandMaxPushSpeed);
+				// What the hand touches: what the balls meet a little ahead.
+				cVector3f vIn = vAt + vDir * cMath_Max(gfVRHandPushReach, cMath_Min(fPressAlong, 0.01f));
+				cMatrixf mtxPalmBall = cMath_MatrixTranslate(vIn);
+				cMatrixf mtxFingerBall = cMath_MatrixTranslate(vIn + vToFingers);
+				for(uint i = 0; i < vLight.length(); ++i)
+				{
+					iPhysicsBody@ pBody = vLight[i];
+					iLuxEntity@ pEntity = vLightEntity[i];
+					bool bPalmIn = pEntity.CheckShapeCollision(pPalmBall, mtxPalmBall, pMap);
+					bool bFingersIn = bPalmIn == false && pEntity.CheckShapeCollision(pFingerBall, mtxFingerBall, pMap);
+					if(bPalmIn == false && bFingersIn == false) continue;
+					cVector3f vBall = bPalmIn ? vIn : vIn + vToFingers;
+					cVector3f vCentre = pBody.GetBoundingVolume().GetWorldCenter();
+					if(cMath_Vector3Dot(vDir, vCentre - vBall) <= 0.0f) continue; // going away from it
+					cVector3f vPoint = vBall + vDir * (bPalmIn ? fPalmRadius : fFingerRadius);
+					float fAlready = cMath_Vector3Dot(pBody.GetVelocityAtPosition(vPoint), vDir);
+					if(fAlready >= fWant) continue;
+					float fMost = cMath_Min(gfVRHandPushForce, gfVRHandPushAccel * pBody.GetMass()) * mfVRArmStep; // (this update's share)
+					float fImpulse = cMath_Min((fWant - fAlready) * pBody.GetMass(), fMost);
+					pBody.Enable();
+					pBody.AddImpulseAtPosition(vDir * fImpulse, vPoint);
+					if(mfVRPushBuzzWait[alHand] <= 0.0f && fWant > 0.3f)
+					{
+						VRBuzzHand(alHand, 0.02f, 0.25f);
+						mfVRPushBuzzWait[alHand] = 0.25f;
+						VRBlockNote(alHand, cVector3f(2.0f, fWant, pBody.GetMass()));
+					}
+				}
+			}
+		}
+
+		// A buzz as the hand comes up against something, after it has touched
+		// nothing for a moment (not again and again as it rests on a table).
+		float fBack = (vPalm - vAt).Length();
+		if(bTouched && mbVRBlockTouching[alHand] == false && mfVRBlockFree[alHand] >= gfVRHandBuzzGap && mfVRPushBuzzWait[alHand] <= 0.0f)
+		{
+			VRBuzzHand(alHand, 0.03f, 0.35f);
+			mfVRPushBuzzWait[alHand] = 0.25f;
+			VRBlockNote(alHand, cVector3f(1.0f, fBack, fTouchMass));
+		}
+		if(bTouched) mfVRBlockFree[alHand] = 0.0f;
+		else mfVRBlockFree[alHand] += mfVRArmStep;
+
+		// Held back beyond an arm's reach for two seconds (something has gone
+		// wrong): start again at the real hand.
+		if(fBack > gfVRHandLost) mfVRBlockStuck[alHand] += mfVRArmStep;
+		else mfVRBlockStuck[alHand] = 0.0f;
+		if(mfVRBlockStuck[alHand] > 2.0f)
+		{
+			VRBlockNote(alHand, cVector3f(3.0f, fBack, 0.0f));
+			vAt = vPalm;
+			mfVRBlockStuck[alHand] = 0.0f;
+		}
+
+		mvVRBlockAt[alHand] = vAt;
+		mbVRBlockKnown[alHand] = true;
+		mbVRBlockTouching[alHand] = bTouched;
+		return vAt - vPalm;
+	}
+
+
+	// Pushes the balls at avAt (the palm's, and the fingers' at avAt +
+	// avToFingers) out of the world's solid parts, up to four times (in a
+	// corner the first push can lead into the other wall). Returns where they
+	// end up; mbVRClearOk says whether they came clear (if not, the place
+	// returned is part way), mbVRClearPushed whether any push was needed.
+	// (Not with "&inout" arguments: the game's script engine refuses them for
+	// a vector or a bool, and the whole body then goes missing.)
+	cVector3f VRHandMakeClear(iPhysicsWorld@ apPhysics, iCollideShape@ apPalmBall, iCollideShape@ apFingerBall, const cVector3f &in avAt,
+							  const cVector3f &in avToFingers)
+	{
+		cVector3f vAt = avAt;
+		mbVRClearOk = false;
+		mbVRClearPushed = false;
+		for(int k = 0; k < 5; ++k)
+		{
+			cVector3f vOut = VRHandWorldOut(apPhysics, apPalmBall, vAt);
+			cVector3f vOutFingers = VRHandWorldOut(apPhysics, apFingerBall, vAt + avToFingers);
+			if(vOutFingers.Length() > vOut.Length()) vOut = vOutFingers;
+			if(vOut.Length() < gfVRHandClear)
+			{
+				mbVRClearOk = true;
+				return vAt;
+			}
+			if(k == 4) return vAt;
+			vAt = vAt + vOut;
+			mbVRClearPushed = true;
+		}
+		return vAt;
+	}
+
+	// How far a ball at avAt has to move to come out of the world's solid
+	// parts (the engine's check, leaving out things that move and characters).
+	cVector3f VRHandWorldOut(iPhysicsWorld@ apPhysics, iCollideShape@ apBall, const cVector3f &in avAt)
+	{
+		cVector3f vPush = cVector3f(0.0f);
+		if(mbVRWorldNear == false) return vPush; // (nothing of the world's solid parts near the hand's way this frame)
+		if(apPhysics.CheckShapeWorldCollision(vPush, apBall, cMath_MatrixTranslate(avAt), null, false, true, false, false) == false) return cVector3f(0.0f);
+		return vPush * VRBlockSign(apPhysics, apBall, avAt, vPush);
+	}
+
+	// Which way round the engine's "push out" points: found the first time a
+	// ball is in something, by trying both ways and keeping the one that
+	// comes out (sent to the mod's log as note 99: the way, and how far in
+	// each try still was).
+	float VRBlockSign(iPhysicsWorld@ apPhysics, iCollideShape@ apBall, const cVector3f &in avAt, const cVector3f &in avPush)
+	{
+		if(mfVRBlockSign != 0.0f) return mfVRBlockSign;
+		if(avPush.Length() < 0.003f) return 1.0f; // too little to tell: next time
+		cVector3f vPushA = cVector3f(0.0f);
+		cVector3f vPushB = cVector3f(0.0f);
+		bool bInA = apPhysics.CheckShapeWorldCollision(vPushA, apBall, cMath_MatrixTranslate(avAt + avPush), null, false, true, false, false);
+		bool bInB = apPhysics.CheckShapeWorldCollision(vPushB, apBall, cMath_MatrixTranslate(avAt - avPush), null, false, true, false, false);
+		float fInA = bInA ? vPushA.Length() : 0.0f;
+		float fInB = bInB ? vPushB.Length() : 0.0f;
+		mfVRBlockSign = fInA <= fInB ? 1.0f : -1.0f;
+		VRNote(99, cVector3f(mfVRBlockSign, fInA, fInB));
+		return mfVRBlockSign;
+	}
+
+	// May the hand's balls go from avFrom to avTo, as far as the loose things
+	// (avSolid, with one of each one's bodies in avBodies) go? Not into one
+	// they are not in at avFrom; and not deeper into one they are in already.
+	// (A hand in one already may not go anywhere it likes in it, though that
+	// would help it out of a thing it has just let go of: a thing pressed by
+	// the hand rocks back against it a little, the hand is then "in it
+	// already", and pushing hard would take it through.) How deep is told by
+	// VRHandDepthIn.
+	bool VRHandStepOk(iCollideShape@ apPalmBall, iCollideShape@ apFingerBall, const cVector3f &in avFrom, const cVector3f &in avTo,
+					  const cVector3f &in avToFingers, array<iLuxEntity@> &in avSolid, array<iPhysicsBody@> &in avBodies, cLuxMap@ apMap)
+	{
+		cMatrixf mtxPalmTo = cMath_MatrixTranslate(avTo);
+		cMatrixf mtxFingersTo = cMath_MatrixTranslate(avTo + avToFingers);
+		cMatrixf mtxPalmFrom = cMath_MatrixTranslate(avFrom);
+		cMatrixf mtxFingersFrom = cMath_MatrixTranslate(avFrom + avToFingers);
+		for(uint i = 0; i < avSolid.length() && i < avBodies.length(); ++i)
+		{
+			if(avSolid[i].CheckShapeCollision(apPalmBall, mtxPalmTo, apMap) == false &&
+				avSolid[i].CheckShapeCollision(apFingerBall, mtxFingersTo, apMap) == false) continue; // not in this one there
+			if(avSolid[i].CheckShapeCollision(apPalmBall, mtxPalmFrom, apMap) == false &&
+				avSolid[i].CheckShapeCollision(apFingerBall, mtxFingersFrom, apMap) == false) return false; // going into it
+			if(VRHandDepthIn(avBodies[i], avTo, avToFingers) > VRHandDepthIn(avBodies[i], avFrom, avToFingers) + 0.0005f) return false; // deeper
+		}
+		return true;
+	}
+
+	// How far the hand's balls (their middles: the palm's at avAt, the
+	// fingers' ahead of it) are into the box round this body: the deeper of
+	// the two, as far in from the nearest side as it is (or, when outside the
+	// box, as far out as it is, as a number below 0). Grows as the hand goes
+	// further in.
+	float VRHandDepthIn(iPhysicsBody@ apBody, const cVector3f &in avAt, const cVector3f &in avToFingers)
+	{
+		cBoundingVolume@ pBox = apBody is null ? null : apBody.GetBoundingVolume();
+		if(pBox is null) return 0.0f;
+		cVector3f vLow = pBox.GetMin();
+		cVector3f vHigh = pBox.GetMax();
+		return cMath_Max(VRBoxDepth(avAt, vLow, vHigh), VRBoxDepth(avAt + avToFingers, vLow, vHigh));
+	}
+
+	// How far a point is inside a box (from its nearest side), or, outside it,
+	// how far outside (as a number below 0).
+	float VRBoxDepth(const cVector3f &in avPoint, const cVector3f &in avLow, const cVector3f &in avHigh)
+	{
+		float fOutX = cMath_Max(cMath_Max(avLow.x - avPoint.x, avPoint.x - avHigh.x), 0.0f);
+		float fOutY = cMath_Max(cMath_Max(avLow.y - avPoint.y, avPoint.y - avHigh.y), 0.0f);
+		float fOutZ = cMath_Max(cMath_Max(avLow.z - avPoint.z, avPoint.z - avHigh.z), 0.0f);
+		float fOut = cMath_Sqrt(fOutX * fOutX + fOutY * fOutY + fOutZ * fOutZ);
+		if(fOut > 0.0f) return -fOut;
+		return cMath_Min(cMath_Min(cMath_Min(avPoint.x - avLow.x, avHigh.x - avPoint.x), cMath_Min(avPoint.y - avLow.y, avHigh.y - avPoint.y)),
+						 cMath_Min(avPoint.z - avLow.z, avHigh.z - avPoint.z));
+	}
+
+	// Can an empty hand bump into this body (a loose thing: not the world, not
+	// a character, not on a hinge or a rail, not held)?
+	bool VRHandMayTouch(iPhysicsBody@ apBody)
+	{
+		if(apBody is null) return false;
+		if(apBody.IsCharacter() || apBody.GetCollide() == false) return false;
+		if(apBody.GetMass() <= 0.0f) return false;
+		if(apBody.GetJointNum() > 0) return false; // doors, drawers and the like: VRHandPress
+		if(apBody.GetGravity() == false) return false; // held (the game's grab and a hand's own hold switch gravity off)
+		return true;
+	}
+
+	// Is this the player's own body, or a thing hung on it (the gun, the
+	// flashlight and other held things, on the body's sockets)?
+	bool VRIsOwnEntity(iLuxEntity@ apEntity)
+	{
+		if(apEntity.GetName() == mBaseObj.GetName()) return true;
+		tID idEntity = apEntity.GetID();
+		for(uint i = 0; i < mvSocketAttachments.length(); ++i)
+			if(mvSocketAttachments[i].m_idEntity == idEntity) return true;
+		return false;
+	}
+
+	// A note about a hand and what it touched, for the mod's log (38 left, 39
+	// right; the first number: 1 = came up against something solid (how far held back, 0
+	// = the world or the weight limit for a heavy thing), 2 = pushed a loose
+	// thing (how fast, its weight), 3 = held back beyond an arm's reach too
+	// long and started again (how far)). The first 60 only.
+	void VRBlockNote(int alHand, const cVector3f &in avNumbers)
+	{
+		if(mlVRBlockNotes >= 60) return;
+		mlVRBlockNotes++;
+		VRNote(alHand == 0 ? 38 : 39, avNumbers);
+	}
+
+	// BunkerVR: pushes a thing on a joint at avAt along avInto, so that its face
+	// there goes at afSpeed, with no more than an open hand's force
+	// (VRHandPushForce) against the weight it is pushed as, so that pushing a
+	// door open with an open hand is no easier than pulling it by its handle:
+	// a door as a slab of gfVRDoorFeltDensity a square meter turned about its
+	// edge (VRDoorFeltInertia; the game's own doors weigh 5 kg or less,
+	// however big), a drawer as gfVRDrawerFeltMass, both times the Feel page's
+	// "Weight" (0: as the game weighs them), or their own weight if more.
+	// What the push changes of its speed (VRPushChange) is given to it about the
+	// hinge, with the speed its middle needs to go round the hinge with it,
+	// woken first (the physics ignores a speed given to a sleeping body).
+	// Only ever faster the way it is pushed; no faster than the door may
+	// turn (its own most) or 4 m/s on a rail; not on into a hinge's
+	// stop (VRHingeAtStop). Not a door latched shut.
+	// (Don't give the face the speed asked at once, whatever that takes: a door
+	// pressed on its narrow edge, where a push hardly turns it, would spin at
+	// up to 10 radians a second, one way and then the other, and slam shut. A
+	// hand's force there hardly turns the door, as in life.)
+	// afPalmInto: the palm's own speed into it (a shove pushes harder:
+	// VRHandPushForce); afDepth: how far the palm is pressed in (for the log).
+	// Returns how much of the hand's force the push took (0 to 1; for the buzz).
+	float VRPushPart(int alHand, iPhysicsBody@ apBody, const cVector3f &in avAt, const cVector3f &in avInto, float afSpeed, float afPalmInto, float afDepth)
+	{
+		iPhysicsJoint@ pJoint = VRBodyOwnJoint(apBody);
+		if(pJoint is null) return 0.0f;
+		cVector3f vPin = cMath_Vector3Normalize(pJoint.GetPinDir());
+		float fMostPush = VRHandPushForce(afPalmInto) * mfVRArmStep; // (the hand's push in this update: newton seconds)
+		float fMostBrace = gfVRDoorBraceForce * mfVRArmStep;
+
+		if(pJoint.GetType() == ePhysicsJointType_Hinge)
+		{
+			iPhysicsJointHinge@ pHinge = cPhysics_ToJointHinge(pJoint);
+			if(pHinge !is null && pHinge.GetMaxAngle() - pHinge.GetMinAngle() < 0.01f) return 0.0f; // latched shut
+			cVector3f vPivot = pJoint.GetPivotPoint();
+			cVector3f vArm = avAt - vPivot;
+			vArm = vArm - vPin * cMath_Vector3Dot(vArm, vPin);
+			float fLever = cMath_Vector3Dot(cMath_Vector3Cross(vPin, vArm), avInto); // the face's speed for each radian a second
+			cVector3f vCentre = cMath_MatrixMul(apBody.GetLocalMatrix(), apBody.GetMassCenter());
+			cVector3f vMiddle = vCentre - vPivot;
+			vMiddle = vMiddle - vPin * cMath_Vector3Dot(vMiddle, vPin);
+			float fHard = VRDoorFeltInertia(apBody.GetMass(), VRReachAlong(apBody, vPin), vMiddle.Length(), mfVRFeelWeight);
+			float fNow = cMath_Vector3Dot(vPin, apBody.GetAngularVelocity());
+			float fChange = VRPushChange(fNow, afSpeed, fLever, fHard, fMostPush, fMostBrace);
+			float fAngle = pHinge !is null ? pHinge.GetAngle() : 0.0f;
+			bool bAtStop = pHinge !is null && VRHingeAtStop(fChange, mfVRHingeSign, fAngle, pHinge.GetMinAngle(), pHinge.GetMaxAngle());
+			VRPushNote(alHand, apBody, afDepth, afSpeed, fLever, fHard, fNow, fChange, fAngle, bAtStop);
+			if(bAtStop) return 1.0f; // (all the hand's push goes into the stop)
+			float fShare = VRPushShare(fChange, fLever, fHard, fMostPush);
+			if(fChange == 0.0f) return fShare;
+			float fMost = apBody.GetMaxAngularSpeed();
+			if(fMost <= 0.0f || fMost > 10.0f) fMost = 10.0f;
+			cVector3f vTurn = vPin * cMath_Clamp(fNow + fChange, -fMost, fMost);
+			apBody.Enable();
+			apBody.SetAngularVelocity(vTurn);
+			apBody.SetLinearVelocity(cMath_Vector3Cross(vTurn, vCentre - vPivot));
+			return fShare;
+		}
+		if(pJoint.GetType() == ePhysicsJointType_Slider)
+		{
+			float fLever = cMath_Vector3Dot(vPin, avInto);
+			if(cMath_Abs(fLever) < 0.2f) return 0.0f;
+			float fHard = cMath_Max(apBody.GetMass(), gfVRDrawerFeltMass * mfVRFeelWeight);
+			float fNow = cMath_Vector3Dot(vPin, apBody.GetLinearVelocity());
+			float fChange = VRPushChange(fNow, afSpeed, fLever, fHard, fMostPush, fMostBrace);
+			VRPushNote(alHand, apBody, afDepth, afSpeed, fLever, fHard, fNow, fChange, 0.0f, false);
+			float fShare = VRPushShare(fChange, fLever, fHard, fMostPush);
+			if(fChange == 0.0f) return fShare;
+			apBody.Enable();
+			apBody.SetLinearVelocity(vPin * cMath_Clamp(fNow + fChange, -4.0f, 4.0f));
+			return fShare;
+		}
+		return 0.0f;
+	}
+
+	// BunkerVR: what a hand's push changes of the speed of a thing on a joint
+	// (see VRPushPart): its turning speed about a hinge (rad/s), or its speed
+	// along a rail (m/s). afNow: that speed now; afWant: the speed
+	// asked of its face along the push; afLever: how fast the face goes along
+	// the push for each 1 of that speed (meters for a hinge: how far from the
+	// hinge the push turns it); afHard: how hard it is to move (kg m2 about a
+	// hinge; kg on a rail); afMostPush: the most the hand pushes in this
+	// update (newton seconds), afMostBrace against a face coming at the hand.
+	// Only ever towards the speed asked, never past it, and only the way the
+	// hand pushes (a hand does not pull).
+	float VRPushChange(float afNow, float afWant, float afLever, float afHard, float afMostPush, float afMostBrace)
+	{
+		if(cMath_Abs(afLever) < 0.0001f || afHard <= 0.0f) return 0.0f;
+		float fShort = afWant - afNow * afLever; // how much slower its face goes than asked
+		if(fShort <= 0.0f) return 0.0f;
+		float fMost = afNow * afLever < 0.0f ? cMath_Max(afMostPush, afMostBrace) : afMostPush;
+		float fPush = cMath_Min(fShort * afHard / (afLever * afLever), fMost);
+		return fPush * afLever / afHard;
+	}
+
+	// BunkerVR: the speed a hand asks of the face it presses on (m/s, along the
+	// push): the palm's own speed into it (afInto), or, if more, the depth it
+	// is pressed in (afDepth) made up in a third of a second; 6 m/s at most.
+	// (Not the palm's speed plus the depth made up faster: against the hand's
+	// force and the door's weight that depth acts as a spring, so a heavy door
+	// lags the palm, then shoots off ahead of it, and a door stopped by a still
+	// hand bounces back off it.)
+	float VRPushAsked(float afInto, float afDepth)
+	{
+		return cMath_Min(cMath_Max(afInto, afDepth * gfVRPushMakeUp), 6.0f);
+	}
+
+	// BunkerVR: the most an open hand pushes with (newtons): more
+	// the faster the palm goes into the thing (afInto, m/s), as a shove is
+	// harder than a lean: 30 N leaning on it, 210 N at 2 m/s, 300 at most.
+	float VRHandPushForce(float afInto)
+	{
+		return gfVRDoorPushForce + gfVRDoorShoveForce * cMath_Clamp(afInto, 0.0f, 3.0f);
+	}
+
+	// BunkerVR: how much of the hand's push a change of speed took (0 to 1,
+	// for the buzz; see VRPushChange).
+	float VRPushShare(float afChange, float afLever, float afHard, float afMostPush)
+	{
+		if(afMostPush <= 0.0f) return 0.0f;
+		if(cMath_Abs(afLever) < 0.0001f) return afChange == 0.0f ? 0.0f : 1.0f;
+		return cMath_Min(cMath_Abs(afChange) * afHard / (cMath_Abs(afLever) * afMostPush), 1.0f);
+	}
+
+	// BunkerVR: how hard a door is to turn about its hinge for a hand that
+	// pushes it (kg m2): a slab turned about its edge, 4/3 m d^2
+	// for its middle d from the hinge, of its own mass or, if more, of
+	// gfVRDoorFeltDensity a square meter times afShare (the Feel page's
+	// "Weight", 0 to 2) over its width (twice d) and afHeight (along the pin).
+	float VRDoorFeltInertia(float afMass, float afHeight, float afMiddle, float afShare)
+	{
+		float fMiddle = cMath_Max(afMiddle, 0.05f);
+		float fMass = cMath_Max(afMass, 2.0f * fMiddle * afHeight * gfVRDoorFeltDensity * afShare);
+		return fMass * fMiddle * fMiddle * 4.0f / 3.0f;
+	}
+
+	// BunkerVR: how far a body reaches along a direction (from its box in the
+	// world, 5 cm to 4 m): a door's height along its hinge's pin.
+	float VRReachAlong(iPhysicsBody@ apBody, const cVector3f &in avWay)
+	{
+		cBoundingVolume@ pBox = apBody.GetBoundingVolume();
+		if(pBox is null) return 1.0f;
+		cVector3f vSize = pBox.GetMax() - pBox.GetMin();
+		return cMath_Clamp(cMath_Abs(avWay.x) * vSize.x + cMath_Abs(avWay.y) * vSize.y + cMath_Abs(avWay.z) * vSize.z, 0.05f, 4.0f);
+	}
+
+	// BunkerVR: would a door turned at afWant (radians a second about its
+	// hinge's pin) go on into its stop? Within 0.03 radians of
+	// the stop it goes towards. afSign: which way the hinge's angle counts
+	// (mfVRHingeSign; 0 not known: never).
+	bool VRHingeAtStop(float afWant, float afSign, float afAngle, float afMin, float afMax)
+	{
+		float fGrows = afWant * afSign;
+		if(fGrows > 0.0f) return afAngle > afMax - 0.03f;
+		if(fGrows < 0.0f) return afAngle < afMin + 0.03f;
+		return false;
+	}
+
+	// BunkerVR: which way a hinge's angle counts, from one measure (see
+	// VRLearnHinge): +1 it grows as its body turns about the pin, -1
+	// against it, 0 the measure tells nothing (turning under 0.3 radians a
+	// second, under 2 milliradians or over half a radian turned, or not like
+	// a turn at that speed: a knock on its stop).
+	int VRHingeSignFrom(float afTurned, float afSpin, float afStep)
+	{
+		if(cMath_Abs(afSpin) < 0.3f || cMath_Abs(afTurned) < 0.002f || cMath_Abs(afTurned) > 0.5f || afStep <= 0.0f) return 0;
+		float fRatio = afTurned / (afSpin * afStep);
+		if(cMath_Abs(fRatio) < 0.3f || cMath_Abs(fRatio) > 3.0f) return 0;
+		return fRatio > 0.0f ? 1 : -1;
+	}
+
+	// BunkerVR: a line in hpl.log about a hand's push, two a second at most
+	// while it pushes, the first 200: how far the palm is
+	// pressed in (mm), the speed asked of the face (cm/s), the lever (cm: how
+	// far from the hinge the push turns it; on a rail, how much of the push
+	// goes along it, in hundredths), how hard it is to move (tenths of kg m2;
+	// on a rail, of kg), its speed (crad/s; on a rail cm/s) and what the push
+	// adds to it, its hinge's angle, and whether it is left alone at its stop.
+	void VRPushNote(int alHand, iPhysicsBody@ apBody, float afDepth, float afSpeed, float afLever, float afHard, float afNow, float afChange, float afAngle, bool abAtStop)
+	{
+		if(mfVRPushNoteWait[alHand] > 0.0f || mlVRPushNotes >= 200) return;
+		mfVRPushNoteWait[alHand] = 0.5f;
+		mlVRPushNotes++;
+		Log("BunkerVR door push: " + (alHand == 0 ? "left" : "right") + " " + apBody.GetName() + ": the palm " + int(afDepth * 1000.0f) + " mm in, " +
+			int(afSpeed * 100.0f) + " cm/s asked; lever " + int(afLever * 100.0f) + ", as hard as " + int(afHard * 10.0f) + " tenths (weight " + int(mfVRFeelWeight * 100.0f) + "%); " +
+			int(afNow * 100.0f) + " now, " + int(afChange * 100.0f) + " added; at " + int(cMath_ToDeg(afAngle)) + " degrees" + (abAtStop ? ", at its stop: left alone" : "") + "\n");
+	}
+
+	// BunkerVR: a step of the drawn feet has come down while the player moves
+	// in the room (walking about, turning, shuffling; see the steps in
+	// UpdateVRLegs): the game's own footstep, made as its walking makes it.
+	// So it is the floor's own sound, the quiet one while crouched, and the
+	// creatures hear it as a step, as they hear walking with the stick.
+	// (Walking with the stick the feet go as animated, and the animation's
+	// own steps make the sound: never both.)
+	// abQuiet: a step taken because the player turned on the spot: the game's
+	// soft sneaking step, less loud (MoveState_Normal's _Global_VRQuietFootSound).
+	// afPace (real-body stealth): the body's speed while the foot was in the air (gfVRStepPaceCareful): a
+	// careful step is made as the game's sneaking step, a hurried one as its running step.
+	void VRFootstepSound(bool abQuiet, float afPace)
+	{
+		if(abQuiet)
+		{
+			cScript_RunGlobalFunc("MoveState_Normal", "", "_Global_VRQuietFootSound");
+			return;
+		}
+		int lPace = 0;
+		if(afPace < gfVRStepPaceNotAStep)
+		{
+			if(afPace < gfVRStepPaceCareful) lPace = 1;
+			else if(afPace > gfVRStepPaceHurried) lPace = 2;
+		}
+		VRPaceNote(afPace, lPace);
+		if(lPace != 0)
+		{
+			cScript_SetGlobalArgInt(0, lPace);
+			cScript_RunGlobalFunc("MoveState_Normal", "", "_Global_VRPacedFootSound");
+			return;
+		}
+		cScript_SetGlobalArgInt(0, eFootSound_Step);
+		cScript_SetGlobalArgFloat(1, 0);
+		cScript_RunGlobalFunc("MoveState_Normal", "", "_Global_FootSound");
+	}
+
+	// BunkerVR: a "BunkerVR stealth:" line in hpl.log for a real step's pace: the first 40, and then each
+	// time the pace is another than the last step's (the first 200 in all).
+	void VRPaceNote(float afPace, int alPace)
+	{
+		if(mlVRPaceNotes >= 200 || (mlVRPaceNotes >= 40 && alPace == mlVRPaceLast)) return;
+		mlVRPaceNotes++;
+		mlVRPaceLast = alPace;
+		array<tString> vHeard = { "walking (3 m)", "careful: sneaking (2 m)", "hurried: running (10 m; crouched, walking)" };
+		Log("BunkerVR stealth: a real step, the body at " + int(afPace * 100.0f + 0.5f) + " cm/s while the foot was up" +
+			(afPace >= gfVRStepPaceNotAStep ? " (moved by the game, not a pace)" : "") + ": heard as " + vHeard[alPace] + (Player_GetCrouching() ? ", crouched" : "") + "\n");
+	}
+
+	// BunkerVR: notes for the mod's log (BunkerVR.log, "SCRIPT NOTE 98") about
+	// footsteps, to see which steps are quiet ones and why. For a step
+	// of the drawn feet: (the foot, 0 left or 10 right, + 1 if quiet; how far
+	// the body had gone since that foot last came down; how far the foot was
+	// from its place), the first 30. For the game's own animated footsteps
+	// while the stick is not walking (see OnRecieveMessage): (100 + 1 if the
+	// drawn legs are being placed; the body's speed; the stick's speed), the
+	// first 20.
+	void VRStepNote(int alSide, bool abQuiet, const cVector3f &in avWhy)
+	{
+		if(mlVRStepNotes >= 30) return;
+		mlVRStepNotes++;
+		VRNote(98, cVector3f(float(alSide * 10) + (abQuiet ? 1.0f : 0.0f), avWhy.x, avWhy.y));
+	}
+
+	void VRAnimStepNote()
+	{
+		if(mlVRAnimStepNotes >= 20) return;
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		iCharacterBody@ pCharBody = pPlayer !is null ? pPlayer.GetCharacterBody() : null;
+		if(pCharBody is null) return;
+		float fStick = cMath_Abs(pCharBody.GetMoveSpeed(eCharDir_Forward)) + cMath_Abs(pCharBody.GetMoveSpeed(eCharDir_Right));
+		if(fStick > 0.2f) return; // (walking with the stick: these are its steps, as they should be)
+		mlVRAnimStepNotes++;
+		cVector3f vSpeed = pCharBody.GetLastVelocity();
+		vSpeed.y = 0.0f;
+		VRNote(98, cVector3f(100.0f + (mbVRLegsOn ? 1.0f : 0.0f), vSpeed.Length(), fStick));
+	}
+
+	// BunkerVR: buzzes a controller (the mod's special roll 7064): 0 left, 1 right.
+	void VRBuzzHand(int alHand, float afSeconds, float afStrength)
+	{
+		cCamera@ pCam = cLux_GetPlayer().GetCamera();
+		if(pCam is null) return;
+		float fRealRoll = pCam.GetRoll();
+		cVector3f vRealPos = pCam.GetPosition();
+		pCam.SetPosition(cVector3f(float(alHand), afSeconds, afStrength));
+		pCam.SetRoll(7064.0f);
+		pCam.GetMatrix();
+		pCam.SetPosition(vRealPos);
+		pCam.SetRoll(fRealRoll);
+	}
+
+	// BunkerVR: the arms' and the fingers' bones, found once for the body's mesh rather than
+	// looked up by name every frame (some 400 bones, twice over, each name put together
+	// afresh). A bone's state is the same while its mesh lives, as is the rest shape the
+	// skeleton gives it. (Another mesh, which this body is never given, has them found again.)
+	// An arm's (VRArmBone): 0 Clavicle, 1 Arm_Zero, 2 Arm_Assist, 3 to 8 Arm_1 to Arm_6,
+	// 9 Wrist, 10 HandSocket. A finger's (VRFingerBone): 0 the first finger, 1 the middle,
+	// 2 the ring, 3 the little finger, 4 the thumb; its bones 1 to 4 (the thumb's 1 to 3).
+	void VRFindBones(cMeshEntity@ apMesh)
+	{
+		if(apMesh is mpVRBonesMesh && mvVRArmBoneStates.length() == 22) return;
+		@mpVRBonesMesh = apMesh;
+		mvVRArmBoneStates.resize(22);
+		mvVRFingerBones.resize(40);
+		mvVRFingerRest.resize(40);
+		mvVRFingerRestKnown.resize(40);
+		cMesh@ pMeshData = apMesh !is null ? apMesh.GetMesh() : null;
+		cSkeleton@ pSkeleton = pMeshData !is null ? pMeshData.GetSkeleton() : null;
+		array<tString> vArm = {"Clavicle", "Arm_Zero", "Arm_Assist", "Arm_1", "Arm_2", "Arm_3", "Arm_4", "Arm_5", "Arm_6", "Wrist", "HandSocket"};
+		array<tString> vFinger = {"Index_", "Mid_", "Ring_", "Pinky_", "Thumb_"};
+		for(int lHand = 0; lHand < 2; ++lHand)
+		{
+			tString sSide = lHand == 0 ? "j_L_" : "j_R_";
+			for(int i = 0; i < 11; ++i)
+				@mvVRArmBoneStates[lHand * 11 + i] = apMesh !is null ? apMesh.GetBoneStateFromName(sSide + vArm[i]) : null;
+			for(int lFinger = 0; lFinger < 5; ++lFinger)
+			{
+				for(int lBone = 1; lBone <= 4; ++lBone)
+				{
+					int lSlot = lHand * 20 + lFinger * 4 + lBone - 1;
+					@mvVRFingerBones[lSlot] = null;
+					mvVRFingerRestKnown[lSlot] = false;
+					if(lFinger == 4 && lBone == 4) continue; // (the thumb has three)
+					tString sName = sSide + vFinger[lFinger] + lBone;
+					if(apMesh !is null) @mvVRFingerBones[lSlot] = apMesh.GetBoneStateFromName(sName);
+					cBone@ pRest = pSkeleton !is null ? pSkeleton.GetBoneByName(sName) : null;
+					if(pRest is null) continue;
+					mvVRFingerRest[lSlot] = pRest.GetLocalTransform();
+					mvVRFingerRestKnown[lSlot] = true;
+				}
+			}
+		}
+	}
+
+	cBoneState@ VRArmBone(cMeshEntity@ apMesh, bool abLeft, int alBone)
+	{
+		VRFindBones(apMesh);
+		return mvVRArmBoneStates[(abLeft ? 0 : 11) + alBone];
+	}
+
+	cBoneState@ VRFingerBone(cMeshEntity@ apMesh, bool abLeft, int alFinger, int alBone)
+	{
+		VRFindBones(apMesh);
+		return mvVRFingerBones[(abLeft ? 0 : 20) + alFinger * 4 + alBone - 1];
+	}
+
+	// (A finger's bone back to the rest shape the skeleton gives it.)
+	void VRFingerBoneToRest(cMeshEntity@ apMesh, bool abLeft, int alFinger, int alBone)
+	{
+		cBoneState@ pState = VRFingerBone(apMesh, abLeft, alFinger, alBone);
+		int lSlot = (abLeft ? 0 : 20) + alFinger * 4 + alBone - 1;
+		if(pState is null || mvVRFingerRestKnown[lSlot] == false) return;
+		pState.SetMatrix(mvVRFingerRest[lSlot]);
+	}
+
+	// BunkerVR: moves a bone to another place without turning it.
+	void VRMoveBoneTo(cBoneState@ apBone, const cVector3f &in avPos)
+	{
+		cMatrixf mtxMoved = apBone.GetWorldMatrix();
+		mtxMoved.SetTranslation(avPos);
+		apBone.SetWorldMatrix(mtxMoved);
+	}
+
+	// BunkerVR: poses the fingers of an empty hand. Unlike UpdateVRFingers
+	// below, which bends the fingers further from wherever the game's
+	// animation has them, this starts every finger from the model's own rest
+	// shape (a flat, open hand) and bends it by a set amount. So the hand looks
+	// the same whatever the game's animation is doing with it: open, a fist,
+	// pointing, or thumb up, as the controller's finger sensors say.
+	//   avCurls: how far the thumb (x), the first finger (y) and the other
+	//            three fingers (z) are closed, 0 to 1.
+	//   The three directions are as for UpdateVRFingers.
+	void UpdateVRFingersPosed(cMeshEntity@ apMesh, bool abLeft, const cVector3f &in avCurls, const cVector3f &in avFingersDir,
+							  const cVector3f &in avPalmDir, const cVector3f &in avThumbDir)
+	{
+		cMesh@ pMeshData = apMesh.GetMesh();
+		cSkeleton@ pSkeleton = pMeshData !is null ? pMeshData.GetSkeleton() : null;
+		if(pSkeleton is null) return;
+		// (Not again when nothing has moved them since, from the same numbers: see VRFingersAsLeft.)
+		if(VRFingersAsLeft(apMesh, abLeft, 1, avCurls, cVector3f(0.0f), cVector3f(0.0f), cVector3f(0.0f))) return;
+		// (Put back as kept, when posed from the same numbers before: see VRFingersKeptFits.)
+		bool bKeptFits = VRFingersKeptFits(apMesh, abLeft, 1, avCurls, cVector3f(0.0f), cVector3f(0.0f), cVector3f(0.0f));
+		if(bKeptFits && mlVRFingerPoseChecks >= glVRFingerPoseChecks)
+		{
+			VRFingersPutBack(apMesh, abLeft);
+			if(abLeft) mfVRCurlAppliedL = 0.0f;
+			else mfVRCurlAppliedR = 0.0f;
+			VRFingersNoteLeft(apMesh, abLeft, 1, avCurls, cVector3f(0.0f), cVector3f(0.0f), cVector3f(0.0f));
+			return;
+		}
+
+		float fFoldWay = 1.0f;
+		if(cMath_Vector3Dot(cMath_Vector3Cross(avThumbDir, avFingersDir), avPalmDir) < 0.0f) fFoldWay = -1.0f;
+
+		// (The first finger, the middle, the ring, the little finger, the thumb: see VRFingerBone.)
+		for(int lFinger = 0; lFinger < 5; ++lFinger)
+		{
+			float fCurl = avCurls.z;
+			if(lFinger == 0) fCurl = avCurls.y;
+			if(lFinger == 4) fCurl = avCurls.x;
+			fCurl = cMath_Clamp(fCurl, 0.0f, 1.0f);
+
+			// Every bone of the finger back to its rest shape first (the first
+			// bone of a finger lies inside the palm; the thumb has three bones).
+			int lBones = 4;
+			if(lFinger == 4) lBones = 3;
+			for(int lBone = 1; lBone <= lBones; ++lBone)
+				VRFingerBoneToRest(apMesh, abLeft, lFinger, lBone);
+
+			// Then the three joints that bend: bones 2, 3 and 4 (thumb: 1, 2, 3).
+			int lFirstJoint = 2;
+			if(lFinger == 4) lFirstJoint = 1;
+
+			for(int lStep = 0; lStep < 3; ++lStep)
+			{
+				int lJoint = lFirstJoint + lStep;
+				cBoneState@ pJoint = VRFingerBone(apMesh, abLeft, lFinger, lJoint);
+				if(pJoint is null) continue;
+
+				// How far this joint bends when fully closed (radians): knuckle,
+				// middle joint, end joint. A little even when "open", so that the
+				// open hand is relaxed and not stiff as a board.
+				float fBend = 1.35f;
+				if(lStep == 1) fBend = 1.5f;
+				if(lStep == 2) fBend = 0.85f;
+				if(lFinger == 4)
+				{
+					fBend = 0.45f;
+					if(lStep == 1) fBend = 0.5f;
+					if(lStep == 2) fBend = 0.7f;
+				}
+				fBend *= gfVRRestCurl + (1.0f - gfVRRestCurl) * fCurl;
+				if(fBend < 0.001f) continue;
+
+				// The same hinges and fold directions as UpdateVRFingers.
+				cMatrixf mtxJoint = pJoint.GetWorldMatrix();
+				cVector3f vHingeInJoint = cVector3f(0.0f, 1.0f, 0.0f);
+				if(lFinger == 4) vHingeInJoint = cVector3f(0.0f, 0.0f, 1.0f);
+				cVector3f vHinge = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxJoint, vHingeInJoint));
+				cVector3f vAlong = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxJoint, cVector3f(abLeft ? 1.0f : -1.0f, 0.0f, 0.0f)));
+
+				cVector3f vFold;
+				if(lFinger < 4)
+				{
+					if(cMath_Vector3Dot(vHinge, avThumbDir) < 0.0f) vHinge = vHinge * -1.0f;
+					vFold = cMath_Vector3Cross(vHinge, vAlong) * fFoldWay;
+				}
+				else
+				{
+					vFold = cMath_Vector3Cross(vHinge, vAlong);
+					if(cMath_Vector3Dot(vFold, avPalmDir + avThumbDir * -0.6f) < 0.0f) vFold = vFold * -1.0f;
+				}
+
+				cVector3f vAlongWanted = vAlong * cMath_Cos(fBend) + vFold * cMath_Sin(fBend);
+				VRTurnBoneAbout(pJoint, VRTurnBetween(vAlong, vAlongWanted, vHinge), mtxJoint.GetTranslation());
+			}
+		}
+
+		// (Compared with the kept pose the first few times, and kept for next time.)
+		if(bKeptFits) VRFingersKeptCheck(apMesh, abLeft);
+		VRFingersKeep(apMesh, abLeft, 1, avCurls, cVector3f(0.0f), cVector3f(0.0f), cVector3f(0.0f));
+
+		// The other way of closing the fingers (UpdateVRFingers) keeps a note of
+		// what it last did to them; that note is now out of date.
+		if(abLeft)	mfVRCurlAppliedL = 0.0f;
+		else		mfVRCurlAppliedR = 0.0f;
+		VRFingersNoteLeft(apMesh, abLeft, 1, avCurls, cVector3f(0.0f), cVector3f(0.0f), cVector3f(0.0f));
+	}
+
+	// BunkerVR: are a hand's fingers still exactly as UpdateVRFingersPosed (alMode 1) or
+	// UpdateVRFingersFull (alMode 2) last left them, posed from these same numbers? Both start every
+	// finger from the model's rest shape, so posing them again then gives the very same bones. The arms are bent twice a frame (at the animation update, and again
+	// once the camera is placed: _Global_VRUpdateArms); the second time only the arm's own chain is
+	// set back (to the wrist: see "The arm always starts from the pose"), and the fingers, which hang
+	// off the hand, are carried with it as they were. The first finger's second bone tells whether
+	// anything has moved them since, as for UpdateVRFingers: the animation sets every finger, as do
+	// the revolver kept as aimed (gvVRGunHandBones) and the arms coming back after a knockdown
+	// (mvVRArmBones), each with that bone among them.
+	bool VRFingersAsLeft(cMeshEntity@ apMesh, bool abLeft, int alMode, const cVector3f &in avA, const cVector3f &in avB,
+						 const cVector3f &in avC, const cVector3f &in avD)
+	{
+		int lSide = abLeft ? 0 : 1;
+		if(mvVRFingersLeftMode[lSide] != alMode) return false;
+		cBoneState@ pMark = VRFingerBone(apMesh, abLeft, 0, 2); // (j_?_Index_2)
+		if(pMark is null) return false;
+		cMatrixf mtxMark = pMark.GetLocalMatrix();
+		if(((mtxMark.GetRight() + mtxMark.GetUp()) - mvVRFingersLeftMark[lSide]).Length() >= 0.00001f) return false;
+		int lFrom = lSide * 4;
+		bool bSame = (avA - mvVRFingersLeftFrom[lFrom]).Length() < 0.00001f && (avB - mvVRFingersLeftFrom[lFrom + 1]).Length() < 0.00001f &&
+					 (avC - mvVRFingersLeftFrom[lFrom + 2]).Length() < 0.00001f && (avD - mvVRFingersLeftFrom[lFrom + 3]).Length() < 0.00001f;
+		if(bSame && mbVRFingersKeptLogged == false)
+		{
+			mbVRFingersKeptLogged = true;
+			Log("BunkerVR: the fingers kept as posed, not posed again from the same numbers (" + (alMode == 1 ? "from the controller's sensors" : "a pose of their own") +
+				", the " + (abLeft ? "left" : "right") + " hand)\n");
+		}
+		return bSame;
+	}
+
+	// BunkerVR: notes how a hand's fingers were just posed, and from what (see VRFingersAsLeft).
+	void VRFingersNoteLeft(cMeshEntity@ apMesh, bool abLeft, int alMode, const cVector3f &in avA, const cVector3f &in avB,
+						   const cVector3f &in avC, const cVector3f &in avD)
+	{
+		int lSide = abLeft ? 0 : 1;
+		cBoneState@ pMark = VRFingerBone(apMesh, abLeft, 0, 2);
+		if(pMark is null)
+		{
+			mvVRFingersLeftMode[lSide] = 0;
+			return;
+		}
+		cMatrixf mtxMark = pMark.GetLocalMatrix();
+		mvVRFingersLeftMark[lSide] = mtxMark.GetRight() + mtxMark.GetUp();
+		mvVRFingersLeftMode[lSide] = alMode;
+		int lFrom = lSide * 4;
+		mvVRFingersLeftFrom[lFrom] = avA;
+		mvVRFingersLeftFrom[lFrom + 1] = avB;
+		mvVRFingersLeftFrom[lFrom + 2] = avC;
+		mvVRFingersLeftFrom[lFrom + 3] = avD;
+	}
+
+	// BunkerVR: a hand's fingers as posed from rest, kept to be put back. UpdateVRFingersPosed and
+	// UpdateVRFingersFull start every finger from the model's rest shape and bend it by the numbers given,
+	// along the hand's own directions: the same numbers give the same bones, each by its own matrix,
+	// wherever the hand is. At the animation update the game's animation has just set every finger again,
+	// so posing them afresh there every frame would cost some 15 joints a hand at about 35 script calls
+	// each, the largest part of the arms' bones. Instead each bone's own matrix as posed is kept, with the
+	// numbers; posed again from the same numbers (as near as VRFingersAsLeft takes them), they are put back. Only
+	// when all 19 of the hand's finger bones are there and their rest shapes known (posing would otherwise
+	// start some of them from the animation). The first glVRFingerPoseChecks times each map the hand is
+	// posed afresh all the same and compared with what was kept (VRFingersKeptCheck); should they ever
+	// differ, nothing is put back in this map.
+	bool VRFingersKeptFits(cMeshEntity@ apMesh, bool abLeft, int alMode, const cVector3f &in avA, const cVector3f &in avB,
+						   const cVector3f &in avC, const cVector3f &in avD)
+	{
+		int lSide = abLeft ? 0 : 1;
+		if(mbVRFingerPoseOff || apMesh is null || apMesh !is mpVRFingerPoseKeptMesh || mvVRFingerPoseKeptMode[lSide] != alMode) return false;
+		int lFrom = lSide * 4;
+		return (avA - mvVRFingerPoseKeptFrom[lFrom]).Length() < 0.00001f && (avB - mvVRFingerPoseKeptFrom[lFrom + 1]).Length() < 0.00001f &&
+			   (avC - mvVRFingerPoseKeptFrom[lFrom + 2]).Length() < 0.00001f && (avD - mvVRFingerPoseKeptFrom[lFrom + 3]).Length() < 0.00001f;
+	}
+
+	// (The kept bones put back: see VRFingersKeptFits.)
+	void VRFingersPutBack(cMeshEntity@ apMesh, bool abLeft)
+	{
+		int lBase = abLeft ? 0 : 20;
+		for(int lFinger = 0; lFinger < 5; ++lFinger)
+		{
+			int lBones = lFinger == 4 ? 3 : 4;
+			for(int lBone = 1; lBone <= lBones; ++lBone)
+			{
+				cBoneState@ pState = VRFingerBone(apMesh, abLeft, lFinger, lBone);
+				if(pState !is null) pState.SetMatrix(mvVRFingerPoseKept[lBase + lFinger * 4 + lBone - 1]);
+			}
+		}
+	}
+
+	// (Just posed afresh from rest: each bone's own matrix kept, with the numbers. See VRFingersKeptFits.)
+	void VRFingersKeep(cMeshEntity@ apMesh, bool abLeft, int alMode, const cVector3f &in avA, const cVector3f &in avB,
+					   const cVector3f &in avC, const cVector3f &in avD)
+	{
+		int lSide = abLeft ? 0 : 1;
+		mvVRFingerPoseKeptMode[lSide] = 0;
+		if(mbVRFingerPoseOff || apMesh is null) return;
+		if(mvVRFingerPoseKept.length() < 40) mvVRFingerPoseKept.resize(40);
+		int lBase = lSide * 20;
+		for(int lFinger = 0; lFinger < 5; ++lFinger)
+		{
+			int lBones = lFinger == 4 ? 3 : 4;
+			for(int lBone = 1; lBone <= lBones; ++lBone)
+			{
+				cBoneState@ pState = VRFingerBone(apMesh, abLeft, lFinger, lBone);
+				int lSlot = lBase + lFinger * 4 + lBone - 1;
+				if(pState is null || mvVRFingerRestKnown[lSlot] == false) return; // (not all there: nothing kept)
+				mvVRFingerPoseKept[lSlot] = pState.GetLocalMatrix();
+			}
+		}
+		@mpVRFingerPoseKeptMesh = apMesh;
+		mvVRFingerPoseKeptMode[lSide] = alMode;
+		int lFrom = lSide * 4;
+		mvVRFingerPoseKeptFrom[lFrom] = avA;
+		mvVRFingerPoseKeptFrom[lFrom + 1] = avB;
+		mvVRFingerPoseKeptFrom[lFrom + 2] = avC;
+		mvVRFingerPoseKeptFrom[lFrom + 3] = avD;
+	}
+
+	// (Posed afresh though the kept bones fitted: each bone's own matrix now against the kept one, its
+	// three axes and its place, the place as a share of its length. In the log after the last check, or at
+	// once should they differ: see VRFingersKeptFits.)
+	void VRFingersKeptCheck(cMeshEntity@ apMesh, bool abLeft)
+	{
+		float fAxes = 0.0f;		// the largest difference of any bone's axis
+		float fPlace = 0.0f;	// and of any bone's place, as a share of how far it is from its parent
+		int lBase = abLeft ? 0 : 20;
+		for(int lFinger = 0; lFinger < 5; ++lFinger)
+		{
+			int lBones = lFinger == 4 ? 3 : 4;
+			for(int lBone = 1; lBone <= lBones; ++lBone)
+			{
+				cBoneState@ pState = VRFingerBone(apMesh, abLeft, lFinger, lBone);
+				if(pState is null) continue;
+				cMatrixf mtxNow = pState.GetLocalMatrix();
+				cMatrixf mtxKept = mvVRFingerPoseKept[lBase + lFinger * 4 + lBone - 1];
+				fAxes = cMath_Max(fAxes, (mtxNow.GetRight() - mtxKept.GetRight()).Length());
+				fAxes = cMath_Max(fAxes, (mtxNow.GetUp() - mtxKept.GetUp()).Length());
+				fAxes = cMath_Max(fAxes, (mtxNow.GetForward() - mtxKept.GetForward()).Length());
+				fPlace = cMath_Max(fPlace, (mtxNow.GetTranslation() - mtxKept.GetTranslation()).Length() / cMath_Max(mtxKept.GetTranslation().Length(), 0.0001f));
+			}
+		}
+		float fWorst = cMath_Max(fAxes, fPlace);
+		mlVRFingerPoseChecks++;
+		mfVRFingerPoseWorst = cMath_Max(mfVRFingerPoseWorst, fWorst);
+		mfVRFingerPoseWorstAxes = cMath_Max(mfVRFingerPoseWorstAxes, fAxes);
+		mfVRFingerPoseWorstPlace = cMath_Max(mfVRFingerPoseWorstPlace, fPlace);
+		if(fWorst > gfVRFingerPoseSame)
+		{
+			mbVRFingerPoseOff = true;
+			mvVRFingerPoseKeptMode[0] = 0;
+			mvVRFingerPoseKeptMode[1] = 0;
+			Log("BunkerVR: the fingers' kept pose DIFFERED from posing them afresh (the " + (abLeft ? "left" : "right") + " hand; axes by " +
+				int(fAxes * 1000000.0f + 0.5f) + " millionths, places by " + int(fPlace * 1000000.0f + 0.5f) + "): none put back in this map\n");
+		}
+		else if(mlVRFingerPoseChecks == glVRFingerPoseChecks)
+		{
+			Log("BunkerVR: the fingers' kept pose matched posing them afresh " + mlVRFingerPoseChecks + " times (the largest difference: axes " +
+				int(mfVRFingerPoseWorstAxes * 1000000.0f + 0.5f) + " millionths, places " + int(mfVRFingerPoseWorstPlace * 1000000.0f + 0.5f) +
+				"): put back from now on in this map\n");
+		}
+	}
+
+	// BunkerVR: poses a hand's fingers from a pose of its own (set in the
+	// mod's hand poses tool, see VRReadPose; alHand: whose pose, 0 left,
+	// 1 right). As UpdateVRFingersPosed, from the model's own rest shape, but
+	// each finger by itself, spread sideways, and with the palm cupped:
+	//   - cupped: the bones inside the palm of the middle, ring and little
+	//     fingers bend towards the palm and in towards the thumb (the little
+	//     finger's most), and the thumb comes round in front of the palm;
+	//   - spread: each finger turns at its knuckle across the palm's face (+
+	//     towards the little finger), the thumb at its root (+ out, away from
+	//     the fingers);
+	//   - then each finger bends at its three joints, as UpdateVRFingersPosed.
+	// The way each bone lies is found from where the next bone starts (see
+	// VRTurnFingerBone), so the cup and the spread do not depend on how the
+	// model's bones are turned.
+	void UpdateVRFingersFull(cMeshEntity@ apMesh, bool abLeft, int alHand, const cVector3f &in avFingersDir,
+							 const cVector3f &in avPalmDir, const cVector3f &in avThumbDir)
+	{
+		cMesh@ pMeshData = apMesh.GetMesh();
+		cSkeleton@ pSkeleton = pMeshData !is null ? pMeshData.GetSkeleton() : null;
+		if(pSkeleton is null) return;
+
+		cVector3f vCurlsA = mvVRPoseCurlsA[alHand];	// thumb, first, middle
+		cVector3f vCurlsB = mvVRPoseCurlsB[alHand];	// ring, little, the palm's cup
+		cVector3f vSpreadA = mvVRPoseSpreadA[alHand];	// degrees: thumb, first, middle
+		cVector3f vSpreadB = mvVRPoseSpreadB[alHand];	// degrees: ring, little
+		// (Not again when nothing has moved them since, from the same pose: see VRFingersAsLeft.)
+		if(VRFingersAsLeft(apMesh, abLeft, 2, vCurlsA, vCurlsB, vSpreadA, vSpreadB)) return;
+		// (Put back as kept, when posed from the same pose before: see VRFingersKeptFits.)
+		bool bKeptFits = VRFingersKeptFits(apMesh, abLeft, 2, vCurlsA, vCurlsB, vSpreadA, vSpreadB);
+		if(bKeptFits && mlVRFingerPoseChecks >= glVRFingerPoseChecks)
+		{
+			VRFingersPutBack(apMesh, abLeft);
+			if(abLeft) mfVRCurlAppliedL = 0.0f;
+			else mfVRCurlAppliedR = 0.0f;
+			VRFingersNoteLeft(apMesh, abLeft, 2, vCurlsA, vCurlsB, vSpreadA, vSpreadB);
+			return;
+		}
+		float fCup = cMath_Clamp(vCurlsB.z, 0.0f, 1.0f);
+		cVector3f vPalm = cMath_Vector3Normalize(avPalmDir);
+		cVector3f vThumb = cMath_Vector3Normalize(avThumbDir);
+
+		float fFoldWay = 1.0f;
+		if(cMath_Vector3Dot(cMath_Vector3Cross(avThumbDir, avFingersDir), avPalmDir) < 0.0f) fFoldWay = -1.0f;
+
+		for(int lFinger = 0; lFinger < 5; ++lFinger)
+		{
+			// (The model's order: first, middle, ring, little finger, thumb; see VRFingerBone.)
+			float fCurl = vCurlsA.y;
+			float fSpread = vSpreadA.y;
+			float fCupBend = 0.0f;	// radians, with the palm fully cupped: the bone inside the palm towards the palm...
+			float fCupIn = 0.0f;	// ...and in towards the thumb
+			if(lFinger == 1) { fCurl = vCurlsA.z; fSpread = vSpreadA.z; fCupBend = 0.05f; }
+			if(lFinger == 2) { fCurl = vCurlsB.x; fSpread = vSpreadB.x; fCupBend = 0.14f; fCupIn = 0.04f; }
+			if(lFinger == 3) { fCurl = vCurlsB.y; fSpread = vSpreadB.y; fCupBend = 0.25f; fCupIn = 0.1f; }
+			if(lFinger == 4) { fCurl = vCurlsA.x; fSpread = vSpreadA.x; fCupBend = 0.3f; }
+			fCurl = cMath_Clamp(fCurl, 0.0f, 1.0f);
+
+			// Every bone of the finger back to its rest shape first (the first
+			// bone of a finger lies inside the palm; the thumb has three bones).
+			int lBones = 4;
+			if(lFinger == 4) lBones = 3;
+			for(int lBone = 1; lBone <= lBones; ++lBone)
+				VRFingerBoneToRest(apMesh, abLeft, lFinger, lBone);
+
+			// The cupped palm, then the spread.
+			cBoneState@ pBone1 = VRFingerBone(apMesh, abLeft, lFinger, 1);
+			cBoneState@ pBone2 = VRFingerBone(apMesh, abLeft, lFinger, 2);
+			cBoneState@ pBone3 = VRFingerBone(apMesh, abLeft, lFinger, 3);
+			VRTurnFingerBone(pBone1, pBone2, vPalm, fCupBend * fCup);
+			if(lFinger < 4)
+			{
+				VRTurnFingerBone(pBone1, pBone2, vThumb, fCupIn * fCup);
+				VRTurnFingerBone(pBone2, pBone3, vThumb * -1.0f, cMath_ToRad(fSpread));
+			}
+			else
+			{
+				VRTurnFingerBone(pBone1, pBone2, vThumb, cMath_ToRad(fSpread));
+			}
+
+			// Then the three joints that bend: bones 2, 3 and 4 (thumb: 1, 2, 3),
+			// as in UpdateVRFingersPosed.
+			int lFirstJoint = 2;
+			if(lFinger == 4) lFirstJoint = 1;
+
+			for(int lStep = 0; lStep < 3; ++lStep)
+			{
+				int lJoint = lFirstJoint + lStep;
+				cBoneState@ pJoint = VRFingerBone(apMesh, abLeft, lFinger, lJoint);
+				if(pJoint is null) continue;
+
+				float fBend = 1.35f;
+				if(lStep == 1) fBend = 1.5f;
+				if(lStep == 2) fBend = 0.85f;
+				if(lFinger == 4)
+				{
+					fBend = 0.45f;
+					if(lStep == 1) fBend = 0.5f;
+					if(lStep == 2) fBend = 0.7f;
+				}
+				fBend *= gfVRRestCurl + (1.0f - gfVRRestCurl) * fCurl;
+				if(fBend < 0.001f) continue;
+
+				cMatrixf mtxJoint = pJoint.GetWorldMatrix();
+				cVector3f vHingeInJoint = cVector3f(0.0f, 1.0f, 0.0f);
+				if(lFinger == 4) vHingeInJoint = cVector3f(0.0f, 0.0f, 1.0f);
+				cVector3f vHinge = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxJoint, vHingeInJoint));
+				cVector3f vAlong = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxJoint, cVector3f(abLeft ? 1.0f : -1.0f, 0.0f, 0.0f)));
+
+				cVector3f vFold;
+				if(lFinger < 4)
+				{
+					if(cMath_Vector3Dot(vHinge, avThumbDir) < 0.0f) vHinge = vHinge * -1.0f;
+					vFold = cMath_Vector3Cross(vHinge, vAlong) * fFoldWay;
+				}
+				else
+				{
+					vFold = cMath_Vector3Cross(vHinge, vAlong);
+					if(cMath_Vector3Dot(vFold, avPalmDir + avThumbDir * -0.6f) < 0.0f) vFold = vFold * -1.0f;
+				}
+
+				cVector3f vAlongWanted = vAlong * cMath_Cos(fBend) + vFold * cMath_Sin(fBend);
+				VRTurnBoneAbout(pJoint, VRTurnBetween(vAlong, vAlongWanted, vHinge), mtxJoint.GetTranslation());
+			}
+		}
+
+		// (Compared with the kept pose the first few times, and kept for next time.)
+		if(bKeptFits) VRFingersKeptCheck(apMesh, abLeft);
+		VRFingersKeep(apMesh, abLeft, 2, vCurlsA, vCurlsB, vSpreadA, vSpreadB);
+
+		// (As UpdateVRFingersPosed: the note of the other way of closing the
+		// fingers is now out of date.)
+		if(abLeft)	mfVRCurlAppliedL = 0.0f;
+		else		mfVRCurlAppliedR = 0.0f;
+		VRFingersNoteLeft(apMesh, abLeft, 2, vCurlsA, vCurlsB, vSpreadA, vSpreadB);
+	}
+
+	// BunkerVR: turns a finger's bone about its own start (its knuckle, or its
+	// end at the wrist) by afAngle radians towards avToward (a direction), in
+	// the plane of the bone and that direction. The way the bone lies is taken
+	// from where the next bone starts. (UpdateVRFingersFull.)
+	void VRTurnFingerBone(cBoneState@ apBone, cBoneState@ apNext, const cVector3f &in avToward, float afAngle)
+	{
+		if(apBone is null || apNext is null) return;
+		if(afAngle < 0.0005f && afAngle > -0.0005f) return;
+		cVector3f vStart = apBone.GetWorldMatrix().GetTranslation();
+		cVector3f vAlong = apNext.GetWorldMatrix().GetTranslation() - vStart;
+		if(vAlong.Length() < 0.0001f) return;
+		vAlong.Normalize();
+		cVector3f vSide = avToward - vAlong * cMath_Vector3Dot(avToward, vAlong);
+		if(vSide.Length() < 0.05f) return; // (it lies that way already)
+		vSide.Normalize();
+		cVector3f vWanted = vAlong * cMath_Cos(afAngle) + vSide * cMath_Sin(afAngle);
+		VRTurnBoneAbout(apBone, VRTurnBetween(vAlong, vWanted, cMath_Vector3Cross(vAlong, vSide)), vStart);
+	}
+
+	// Closes one hand's fingers by afCurl (0 = as animated, 1 = a full grip).
+	//   avFingersDir: the way the open fingers point
+	//   avPalmDir:    the way the palm faces
+	//   avThumbDir:   the side of the hand the thumb is on
+	void UpdateVRFingers(cMeshEntity@ apMesh, bool abLeft, float afCurl, const cVector3f &in avFingersDir,
+						 const cVector3f &in avPalmDir, const cVector3f &in avThumbDir)
+	{
+		cBoneState@ pMarkBone = VRFingerBone(apMesh, abLeft, 0, 2); // (j_?_Index_2)
+		if(pMarkBone is null) return;
+		
+		float fCurl = afCurl;
+		if(fCurl < 0.02f) fCurl = 0.0f;
+		
+		// This runs more often than the body's animation does. If the animation
+		// has run since last time, the fingers are back as animated and get the
+		// whole bend. If it has not, they still have the bend from last time and
+		// only get the difference. The first finger bone tells which it is: in the
+		// second case it is still exactly as this code left it.
+		cVector3f vMarkNow = pMarkBone.GetLocalMatrix().GetRight() + pMarkBone.GetLocalMatrix().GetUp();
+		cVector3f vMarkThen = abLeft ? mvVRFingerMarkL : mvVRFingerMarkR;
+		float fCurlThen = abLeft ? mfVRCurlAppliedL : mfVRCurlAppliedR;
+		
+		float fCurlToAdd = fCurl;
+		if((vMarkNow - vMarkThen).Length() < 0.00001f) fCurlToAdd = fCurl - fCurlThen;
+		if(fCurlToAdd < 0.002f && fCurlToAdd > -0.002f) return;
+		
+		// Each finger joint is a hinge. Which way round a hinge folds the finger
+		// towards the palm depends on whether this is a left or a right hand;
+		// this works it out from the hand's own directions (+1 or -1).
+		float fFoldWay = 1.0f;
+		if(cMath_Vector3Dot(cMath_Vector3Cross(avThumbDir, avFingersDir), avPalmDir) < 0.0f) fFoldWay = -1.0f;
+		
+		// (The first finger, the middle, the ring, the little finger, the thumb: see VRFingerBone.)
+		for(int lFinger = 0; lFinger < 5; ++lFinger)
+		{
+			
+			// In this model a finger's first bone lies inside the palm (it runs
+			// from the wrist to the knuckle), so the three joints that bend are its
+			// bones 2, 3 and 4. The thumb has one bone fewer: its joints are 1, 2 and 3.
+			int lFirstJoint = 2;
+			if(lFinger == 4) lFirstJoint = 1;
+			
+			for(int lStep = 0; lStep < 3; ++lStep)
+			{
+				int lJoint = lFirstJoint + lStep;
+				cBoneState@ pJoint = VRFingerBone(apMesh, abLeft, lFinger, lJoint);
+				if(pJoint is null) continue;
+				
+				// How far this joint bends in a full grip (radians): knuckle,
+				// middle joint, end joint.
+				float fBend = 1.15f;
+				if(lStep == 1) fBend = 1.35f;
+				if(lStep == 2) fBend = 0.7f;
+				if(lFinger == 4)
+				{
+					fBend = 0.35f;
+					if(lStep == 1) fBend = 0.4f;
+					if(lStep == 2) fBend = 0.6f;
+				}
+				fBend *= fCurlToAdd;
+				
+				// The joint's hinge is its own Y direction (its own Z for the thumb);
+				// its bone lies along its X (towards the fingertip that is +X on the
+				// left hand, -X on the right).
+				cMatrixf mtxJoint = pJoint.GetWorldMatrix();
+				cVector3f vHingeInJoint = cVector3f(0.0f, 1.0f, 0.0f);
+				if(lFinger == 4) vHingeInJoint = cVector3f(0.0f, 0.0f, 1.0f);
+				cVector3f vHinge = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxJoint, vHingeInJoint));
+				cVector3f vAlong = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxJoint, cVector3f(abLeft ? 1.0f : -1.0f, 0.0f, 0.0f)));
+				
+				// The four fingers' hinges lie across the hand (thumb side to little
+				// finger side) and fold the fingers towards the palm. Point each hinge
+				// towards the thumb side first, so that the fold always goes the same
+				// way however far the finger is already bent.
+				cVector3f vFold;
+				if(lFinger < 4)
+				{
+					if(cMath_Vector3Dot(vHinge, avThumbDir) < 0.0f) vHinge = vHinge * -1.0f;
+					vFold = cMath_Vector3Cross(vHinge, vAlong) * fFoldWay;
+				}
+				// The thumb bends much less, and folds in towards the palm and the
+				// little finger: of the two ways its hinge can turn, take that one.
+				else
+				{
+					vFold = cMath_Vector3Cross(vHinge, vAlong);
+					if(cMath_Vector3Dot(vFold, avPalmDir + avThumbDir * -0.6f) < 0.0f) vFold = vFold * -1.0f;
+				}
+				
+				cVector3f vAlongWanted = vAlong * cMath_Cos(fBend) + vFold * cMath_Sin(fBend);
+				VRTurnBoneAbout(pJoint, VRTurnBetween(vAlong, vAlongWanted, vHinge), mtxJoint.GetTranslation());
+			}
+		}
+		
+		cVector3f vMarkLeft = pMarkBone.GetLocalMatrix().GetRight() + pMarkBone.GetLocalMatrix().GetUp();
+		if(abLeft)
+		{
+			mvVRFingerMarkL = vMarkLeft;
+			mfVRCurlAppliedL = fCurl;
+		}
+		else
+		{
+			mvVRFingerMarkR = vMarkLeft;
+			mfVRCurlAppliedR = fCurl;
+		}
+	}
+	
+	// BunkerVR: is the gun hanging in the right hand the shotgun (it has a pump
+	// and a loading shell)?
+	bool VRShotgunHeld()
+	{
+		for (uint i = 0; i < mvSocketAttachments.length(); i++)
+		{
+			if(mvSocketAttachments[i].msSocket != "R_Hand") continue;
+			iLuxEntity@ pGun = cLux_ID_Entity(mvSocketAttachments[i].m_idEntity);
+			cMeshEntity@ pGunMesh = pGun !is null ? pGun.GetMeshEntity() : null;
+			if(pGunMesh is null) continue;
+			if(pGunMesh.GetBoneStateIndex("j_pump") >= 0 && pGunMesh.GetBoneStateIndex("j_shell_reload") >= 0) return true;
+		}
+		return false;
+	}
+	
+	// The left palm on the shotgun's fore-end: fixed on the fore-end as the gun
+	// is now (the right arm, which carries it, just placed: UpdateVRArms), so
+	// the hand stays still on the gun and cannot spin round it, as the grip
+	// "Holding the shotgun's pump" has the fore-end in the palm (its own
+	// placement, or the helper's: mvVRPumpGrip..., BunkerVR_PalmOnGrip), whichever
+	// way the real hand turns; the fore-end back by the pump's slide
+	// ("BunkerVR_PumpSlide", from the gun's own script: Prop_Shotgun.hps).
+	// a_mtxPalm, the real palm, until the gun's place in the hand is known
+	// (VRMeasureGunBarrel).
+	cMatrixf VRLeftOnPump(cMeshEntity@ apMesh, const cMatrixf &in a_mtxPalm)
+	{
+		if(mbVRForeEndKnown == false || mbVRBarrelKnown == false || mbVRGunUpKnown == false || mfVRGunSize < 0.000001f) return a_mtxPalm;
+		cBoneState@ pWrist = apMesh.GetBoneStateFromName("j_R_Wrist");
+		if(pWrist is null) return a_mtxPalm;
+		cMatrixf mtxWrist = pWrist.GetWorldMatrix();
+		cVector3f vBarrel = cMath_MatrixMul3x3(mtxWrist, mvVRBarrelInHand);
+		if(vBarrel.Length() < 0.000001f) return a_mtxPalm;
+		vBarrel.Normalize();
+		cVector3f vUp = cMath_MatrixMul3x3(mtxWrist, mvVRGunUpInHand);
+		vUp = vUp - vBarrel * cMath_Vector3Dot(vUp, vBarrel);
+		if(vUp.Length() < 0.000001f) return a_mtxPalm;
+		vUp.Normalize();
+		cVector3f vBack = vBarrel * -1.0f;
+		cVector3f vLeft = cMath_Vector3Cross(vBack, vUp); // (the fore-end's own x, y, z: towards the stock, up, towards the gun's left)
+		float fSlide = cMath_Clamp(cScript_GetGlobalVarFloat("BunkerVR_PumpSlide"), 0.0f, 1.0f);
+		cVector3f vMiddle = cMath_MatrixMul(mtxWrist, mvVRForeEndInHand) - vBarrel * (gfBunkerVR_PumpTravel * fSlide * mfVRGunSize);
+		cVector3f vPalm, vX, vY, vZ;
+		BunkerVR_PalmOnGrip(vMiddle, vBack, vUp, vLeft, mvVRPumpGripAt, mvVRPumpGripY, mvVRPumpGripZ, vPalm, vX, vY, vZ);
+		cMatrixf mtxOn = VRFrameMatrix(vX, vY);
+		mtxOn.SetTranslation(vPalm);
+		return mtxOn;
+	}
+	
+	// BunkerVR: the revolver kept in the hand as it is aimed (VRSteadyGunHand, below the
+	// two kick functions). With the revolver out, the left hand's squeeze on a thing the
+	// game uses (an ammo box, a button, a door) lets go of the aim (vr.cpp: the game
+	// takes its use button only in its ordinary state), and so does sprinting: the game
+	// then plays its lowering, its own carry pose and the raising again on the right arm,
+	// which moves the gun's socket (j_R_HandSocket) and the fingers about the wrist; the
+	// hand, put on the controller and turned to point the barrel, would wheel round the
+	// gun. So the hand's own bones (gvVRGunHandBones) are taken from the aim's pose
+	// once it has settled (gfVRGunHandSettled), and whenever the revolver is out but not
+	// aimed (nor open: the cylinder's own moves stay the game's), or the aim is being let
+	// go, they are held in it (eased in over gfVRGunHandIn), until the aim's pose has
+	// settled again (at most gfVRGunHandBackMost), then eased out (gfVRGunHandOut). abFresh:
+	// the first arm update of a frame, the bones as the animation has just left them; the
+	// second only sets them again as the first did.
+	// BunkerVR: how the revolver has been moved in the right hand by the game's own
+	// animation since its aim settled: the socket it hangs from as it is now,
+	// against where the aim's settled pose (VRSteadyGunHand: mvVRGunHandPose) would have it
+	// in the hand as the hand now is; a shot's kick throws it up and back. As a motion in
+	// the world, for the left hand steadying it to go with it. None (the identity) but
+	// while it is aimed, and none that is more than a kick (gfVRGunKickCarryMost).
+	cMatrixf VRGunKickMotion(cMeshEntity@ apMesh)
+	{
+		if(apMesh is null || mbVRGunHandPoseKnown == false || mvVRGunHandPose.length() == 0) return cMatrixf_Identity;
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		if(pPlayer is null || pPlayer.GetCurrentStateId() != ePlayerState_Custom_UsingGun_Aim) return cMatrixf_Identity;
+		cBoneState@ pSocket = apMesh.GetBoneStateFromName(gvVRGunHandBones[0]);
+		if(pSocket is null) return cMatrixf_Identity;
+		cMatrixf mtxNow = pSocket.GetWorldMatrix();
+		// (The socket's parent as it is now, times the aim's own socket: where the aim would have it.)
+		cMatrixf mtxMotion = cMath_MatrixMul(cMath_MatrixMul(mtxNow, cMath_MatrixInverse(mvVRGunHandPose[0])), cMath_MatrixMul(pSocket.GetLocalMatrix(), cMath_MatrixInverse(mtxNow)));
+		cVector3f vAt = mtxNow.GetTranslation();
+		float fMoved = (cMath_MatrixMul(mtxMotion, vAt) - vAt).Length();
+		float fTurnX = cMath_Vector3Dot(cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxMotion, cVector3f(1.0f, 0.0f, 0.0f))), cVector3f(1.0f, 0.0f, 0.0f));
+		float fTurnZ = cMath_Vector3Dot(cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxMotion, cVector3f(0.0f, 0.0f, 1.0f))), cVector3f(0.0f, 0.0f, 1.0f));
+		if(fMoved > gfVRGunKickCarryMost || fTurnX < gfVRGunKickTurnCosMost || fTurnZ < gfVRGunKickTurnCosMost) return cMatrixf_Identity;
+		return mtxMotion;
+	}
+
+	// BunkerVR: a palm's place (a_mtxPalm, in the world) moved by the revolver's kick, a shot's or
+	// the hammer's on an empty chamber. The
+	// game's own kick is the arm's (player_gun_shot_1: the wrist thrown 7.5 cm, the gun's socket
+	// under 1 cm within the hand; the empty click: under 1 cm), which the hands put on the
+	// controllers leave out. So, as the shotgun's (BunkerVR_GunKick, its shape): the right palm
+	// a_mtxRight's muzzle (its pointing, -z) thrown up gfVRRevolverKickTurn about that palm and the
+	// gun pushed back gfVRRevolverKickBack, by the size the shot set ("BunkerVR_RevolverKickSize": 1 a
+	// shot, a little for the hammer on an empty chamber: PlayerState_UsingGun_Aim.hps); any palm so
+	// moved, the left one steadying it as well.
+	cMatrixf VRRevolverKicked(const cMatrixf &in a_mtxPalm, const cMatrixf &in a_mtxRight)
+	{
+		float fSince = float(cEngine_GetGameTime()) - cScript_GetGlobalVarFloat("BunkerVR_RevolverKickAt");
+		float fShare = BunkerVR_GunKick(fSince) / gfBunkerVR_GunKickMost * cScript_GetGlobalVarFloat("BunkerVR_RevolverKickSize");
+		if(fShare < 0.0005f) return a_mtxPalm;
+		cVector3f vBarrel = cMath_Vector3Normalize(cMath_MatrixMul3x3(a_mtxRight, cVector3f(0.0f, 0.0f, -1.0f)));
+		cVector3f vUp = cMath_MatrixMul3x3(a_mtxRight, cVector3f(0.0f, 1.0f, 0.0f));
+		vUp = vUp - vBarrel * cMath_Vector3Dot(vUp, vBarrel);
+		if(vUp.Length() < 0.01f) return a_mtxPalm;
+		vUp.Normalize();
+		float fTurn = gfVRRevolverKickTurn * fShare;
+		cVector3f vKicked = vBarrel * cMath_Cos(fTurn) + vUp * cMath_Sin(fTurn);
+		cMatrixf mtxTurn = VRTurnBetween(vBarrel, vKicked, cMath_Vector3Normalize(cMath_Vector3Cross(vBarrel, vUp)));
+		cVector3f vPivot = a_mtxRight.GetTranslation();
+		cMatrixf mtxOut = cMath_MatrixMul(mtxTurn, a_mtxPalm.GetRotation());
+		mtxOut.SetTranslation(vPivot + cMath_MatrixMul3x3(mtxTurn, a_mtxPalm.GetTranslation() - vPivot) - vBarrel * (gfVRRevolverKickBack * fShare));
+		return mtxOut;
+	}
+
+	void VRSteadyGunHand(cMeshEntity@ apMesh, float afTimeStep, bool abFresh)
+	{
+		uint lCount = gvVRGunHandBones.length();
+		if(apMesh is null || mbVRGunInHand == false || mbVRShotgunInHand)
+		{
+			if(mbVRGunHandHolding && mlVRGunHandNotes < 20)
+			{
+				mlVRGunHandNotes++;
+				Log("BunkerVR: the revolver's hand no longer held as aimed (the gun put away)\n");
+			}
+			mbVRGunHandPoseKnown = false;
+			mbVRGunHandHolding = false;
+			mfVRGunHandWeight = 0.0f;
+			mlVRGunHandState = -1;
+			mfVRGunHandStillFor = 0.0f;
+			return;
+		}
+		if(abFresh == false)
+		{
+			if(mfVRGunHandWeight > 0.0f && mvVRGunHandSet.length() == lCount)
+			{
+				for(uint i = 0; i < lCount; ++i)
+				{
+					cBoneState@ pBone = apMesh.GetBoneStateFromName(gvVRGunHandBones[i]);
+					if(pBone !is null) pBone.SetMatrix(mvVRGunHandSet[i]);
+				}
+			}
+			return;
+		}
+		cBoneState@ pSocket = apMesh.GetBoneStateFromName(gvVRGunHandBones[0]);
+		if(pSocket is null) return;
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		int lState = pPlayer !is null ? pPlayer.GetCurrentStateId() : -1;
+		if(lState != mlVRGunHandState)
+		{
+			mlVRGunHandState = lState;
+			mfVRGunHandStateFor = 0.0f;
+			mfVRGunHandStillFor = 0.0f; // (settled afresh in the new state: the carry pose held still is not the aim's)
+		}
+		else mfVRGunHandStateFor += afTimeStep;
+		bool bAiming = lState == ePlayerState_Custom_UsingGun_Aim;
+		bool bOpen = lState == ePlayerState_Custom_UsingGun_Reload;
+		bool bLetGo = cVR_OtherHandWaits();
+
+		// Has the animation's socket settled (the aim's loop, not its raising or lowering)?
+		cMatrixf mtxSocket = pSocket.GetLocalMatrix();
+		cVector3f vNow = mtxSocket.GetTranslation();
+		cVector3f vWas = m_mtxVRGunSocketWas.GetTranslation();
+		float fMoved = (vNow - vWas).Length() / cMath_Max(vNow.Length(), 0.000001f);
+		cVector3f vXNow = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxSocket, cVector3f(1.0f, 0.0f, 0.0f)));
+		cVector3f vXWas = cMath_Vector3Normalize(cMath_MatrixMul3x3(m_mtxVRGunSocketWas, cVector3f(1.0f, 0.0f, 0.0f)));
+		cVector3f vYNow = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxSocket, cVector3f(0.0f, 1.0f, 0.0f)));
+		cVector3f vYWas = cMath_Vector3Normalize(cMath_MatrixMul3x3(m_mtxVRGunSocketWas, cVector3f(0.0f, 1.0f, 0.0f)));
+		bool bStill = fMoved < 0.02f && cMath_Vector3Dot(vXNow, vXWas) > 0.99966f && cMath_Vector3Dot(vYNow, vYWas) > 0.99966f; // (2% of its reach, 1.5 degrees)
+		m_mtxVRGunSocketWas = mtxSocket;
+		if(bStill) mfVRGunHandStillFor += afTimeStep;
+		else mfVRGunHandStillFor = 0.0f;
+
+		// The aim's pose, settled: taken (while it is not being held).
+		if(bAiming && bLetGo == false && mbVRGunHandHolding == false && mfVRGunHandStillFor >= gfVRGunHandSettled)
+		{
+			mvVRGunHandPose.resize(lCount);
+			for(uint i = 0; i < lCount; ++i)
+			{
+				cBoneState@ pBone = apMesh.GetBoneStateFromName(gvVRGunHandBones[i]);
+				if(pBone !is null) mvVRGunHandPose[i] = pBone.GetLocalMatrix();
+			}
+			if(mbVRGunHandPoseKnown == false && mlVRGunHandNotes < 20)
+			{
+				mlVRGunHandNotes++;
+				Log("BunkerVR: the revolver's aimed hand pose taken (" + lCount + " bones), to hold it in when it is not aimed\n");
+			}
+			mbVRGunHandPoseKnown = true;
+		}
+
+		// Held in it: out but not aimed (nor open), the aim being let go, or aimed again and not yet settled.
+		bool bHold = mbVRGunHandPoseKnown && bOpen == false &&
+					 (bAiming == false || bLetGo || (mbVRGunHandHolding && mfVRGunHandStillFor < gfVRGunHandSettled && mfVRGunHandStateFor < gfVRGunHandBackMost));
+		if(bHold && mbVRGunHandHolding == false && mlVRGunHandNotes < 20)
+		{
+			mlVRGunHandNotes++;
+			Log("BunkerVR: the revolver's hand held as aimed (the game's state " + lState + (bLetGo ? ", the aim let go for the left hand" : "") + ")\n");
+		}
+		if(bHold) mbVRGunHandHolding = true;
+		if(bHold) mfVRGunHandWeight = cMath_Min(1.0f, mfVRGunHandWeight + afTimeStep / gfVRGunHandIn);
+		else mfVRGunHandWeight = cMath_Max(0.0f, mfVRGunHandWeight - afTimeStep / gfVRGunHandOut);
+		if(bHold == false && mfVRGunHandWeight <= 0.0f && mbVRGunHandHolding)
+		{
+			mbVRGunHandHolding = false;
+			if(mlVRGunHandNotes < 20)
+			{
+				mlVRGunHandNotes++;
+				Log("BunkerVR: the revolver's hand let go to the game's animation again (the game's state " + lState + ")\n");
+			}
+		}
+		if(mfVRGunHandWeight <= 0.0f || mvVRGunHandPose.length() != lCount) return;
+		float fT = mfVRGunHandWeight * mfVRGunHandWeight * (3.0f - 2.0f * mfVRGunHandWeight);
+		mvVRGunHandSet.resize(lCount);
+		for(uint i = 0; i < lCount; ++i)
+		{
+			cBoneState@ pBone = apMesh.GetBoneStateFromName(gvVRGunHandBones[i]);
+			if(pBone is null) continue;
+			mvVRGunHandSet[i] = VRBlendBone(pBone.GetLocalMatrix(), mvVRGunHandPose[i], fT);
+			pBone.SetMatrix(mvVRGunHandSet[i]);
+		}
+	}
+
+	// Works out how the gun's barrel lies within the right hand: the direction
+	// its bullets leave in, as the hand bone sees it. Called after the things
+	// held in the hands have been placed, while a gun is held. The next time the
+	// hand is placed, this is used to point the barrel along the controller.
+	void VRMeasureGunBarrel()
+	{
+		if(mbVRGunInHand == false)
+		{
+			mbVRBarrelKnown = false;
+			mbVRForeEndKnown = false;
+			mbVRGunUpKnown = false;
+			return;
+		}
+		
+		// While the revolver is open the game's own animation tips the gun
+		// about in the hand; measuring then would turn the hand to follow it.
+		if(mbVRReloadOpen || mfVRBarrelHold > 0.0f) return;
+
+		cMeshEntity@ pMesh = mBaseObj.GetMeshEntity();
+		cBoneState@ pWrist = pMesh !is null ? pMesh.GetBoneStateFromName("j_R_Wrist") : null;
+		if(pWrist is null) return;
+		
+		for (uint i = 0; i < mvSocketAttachments.length(); i++)
+		{
+			if(mvSocketAttachments[i].msSocket != "R_Hand") continue;
+			
+			iLuxEntity@ pGun = cLux_ID_Entity(mvSocketAttachments[i].m_idEntity);
+			if(pGun is null) continue;
+			
+			// The game fires its bullets from this part of the gun, along its Z direction.
+			iPhysicsBody@ pMuzzle = pGun.GetBodyFromName("Body_BulletStart");
+			if(pMuzzle is null) continue;
+			
+			cVector3f vBarrel = cMath_MatrixMul3x3(pMuzzle.GetWorldMatrix(), cVector3f(0.0f, 0.0f, 1.0f));
+			cVector3f vInHand = cMath_MatrixMul3x3(cMath_MatrixInverse(pWrist.GetWorldMatrix()), vBarrel);
+			if(vInHand.Length() < 0.000001f) continue;
+			vInHand.Normalize();
+			
+			// Take it over gently, so one odd reading cannot make the hand jump.
+			if(mbVRBarrelKnown)	mvVRBarrelInHand = cMath_Vector3Normalize(mvVRBarrelInHand * 0.8f + vInHand * 0.2f);
+			else				mvVRBarrelInHand = vInHand;
+			mbVRBarrelKnown = true;
+			
+			// The shotgun: where its fore-end's middle lies in the
+			// hand (at rest, whatever the pump is doing), for aiming it through
+			// the left hand (UpdateVRArm). Taken over gently too.
+			cMeshEntity@ pGunMesh = pGun.GetMeshEntity();
+			cBoneState@ pGunRoot = (pGunMesh !is null && pGunMesh.GetBoneStateIndex("j_pump") >= 0) ? pGunMesh.GetBoneStateFromName("j_trench_shotgun") : null;
+			float fGunScale = pGunRoot !is null ? cMath_MatrixMul3x3(pGunRoot.GetWorldMatrix(), cVector3f(1.0f, 0.0f, 0.0f)).Length() : 0.0f;
+			float fGunSize = cMath_MatrixMul3x3(pGun.GetMatrix(), cVector3f(1.0f, 0.0f, 0.0f)).Length(); // (the gun may be drawn at another size, as held things are)
+			if(fGunScale > 0.000001f && fGunSize > 0.000001f)
+			{
+				cVector3f vForeEnd = cMath_MatrixMul(cMath_MatrixInverse(pWrist.GetWorldMatrix()), BunkerVR_ShotgunPoint(pGunRoot.GetWorldMatrix(), fGunScale / fGunSize, gvBunkerVR_ShotgunForeEnd));
+				if(mbVRForeEndKnown)	mvVRForeEndInHand = mvVRForeEndInHand * 0.8f + vForeEnd * 0.2f;
+				else					mvVRForeEndInHand = vForeEnd;
+				mbVRForeEndKnown = true;
+				mfVRGunSize = fGunSize; // (for the pump's slide: VRLeftOnPump)
+				// ...and which way is up on it (its model's y), for the left
+				// hand fixed on the fore-end (VRLeftOnPump).
+				cVector3f vUpInHand = cMath_MatrixMul3x3(cMath_MatrixInverse(pWrist.GetWorldMatrix()), cMath_MatrixMul3x3(pGunRoot.GetWorldMatrix(), cVector3f(0.0f, 1.0f, 0.0f)));
+				if(vUpInHand.Length() > 0.000001f)
+				{
+					vUpInHand.Normalize();
+					if(mbVRGunUpKnown)	mvVRGunUpInHand = cMath_Vector3Normalize(mvVRGunUpInHand * 0.8f + vUpInHand * 0.2f);
+					else				mvVRGunUpInHand = vUpInHand;
+					mbVRGunUpKnown = true;
+				}
+			}
+			else
+			{
+				mbVRForeEndKnown = false;
+				mbVRGunUpKnown = false;
+			}
+			return;
+		}
+	}
+	
+	// BunkerVR: the flashlight in the left hand is held the game's own way:
+	// the lamp's back flat in the palm, the lens looking out of the palm, the
+	// fingers (the game's own grip) over its rim. The hand itself follows the
+	// controller, so the light goes where the palm faces. (The lamp is a round
+	// box 8.6 cm across: magnetlampe.fbx, lens +Z, strap rings at the top +Y,
+	// string hanging from the bottom.)
+
+	// BunkerVR: notes for the mod's log after an F9 capture, on where the body
+	// is drawn compared with the real head. Each is three numbers:
+	//   40: the real head, from the game body's feet (world x, up, world z)
+	//   41: how far the body had to slide to be under the head, before the
+	//       limit of 1.5 m (world x, world z, length)
+	//   42: how far it did slide (world x, world z, length)
+	//   43: the chest's own shift (sideways, up, forwards)
+	//   44: the lean after a reaching hand (sideways, 0, forwards)
+	//   45: crouching (1 or 0), crouched by ducking (1 or 0), body size
+	//   46: the drawn body's own place, from the game body's feet (x, up, z)
+	//   47: all that the game's body has been moved to follow the head (x, up, z)
+	//   48: how dark the view is for a head in a wall (0 to 1), how far the
+	//       neck is from the game's body, where a wall is on the way (-1: none)
+	void VRBodyNotes()
+	{
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		iCharacterBody@ pCharBody = pPlayer !is null ? pPlayer.GetCharacterBody() : null;
+		if(pCharBody is null) return;
+		cVector3f vFeet = pCharBody.GetFeetPosition();
+		if(mbVRHeadKnown) VRNote(40, m_mtxVRHead.GetTranslation() - vFeet);
+		cVector3f vAsked = cScript_GetGlobalVarVector3f("BunkerVR_BodyShiftAsked");
+		cVector3f vShift = cScript_GetGlobalVarVector3f("BunkerVR_BodyShift");
+		VRNote(41, cVector3f(vAsked.x, vAsked.z, vAsked.Length()));
+		VRNote(42, cVector3f(vShift.x, vShift.z, vShift.Length()));
+		VRNote(43, cScript_GetGlobalVarVector3f("BunkerVR_BodyChestFix"));
+		VRNote(44, cScript_GetGlobalVarVector3f("BunkerVR_BodyLean"));
+		VRNote(45, cScript_GetGlobalVarVector3f("BunkerVR_BodyState"));
+		VRNote(46, mBaseObj.GetMatrix().GetTranslation() - vFeet);
+		VRNote(47, cScript_GetGlobalVarVector3f("BunkerVR_BodyFollow"));
+		VRNote(48, cScript_GetGlobalVarVector3f("BunkerVR_HeadFade"));
+		// The legs (see UpdateVRLegs): 49 how much they are shortened (1: not),
+		// walking (1 or 0), crouching (1 or 0); 94 and 95 left and right: how
+		// high the hip is above where the ankle goes, the leg's own length, how
+		// far the hip is from where the ankle goes; 96 how far each planted foot
+		// is from where the body wants it (left, right), and which is stepping
+		// (0 none, 1 left, 2 right).
+		if(mvVRLegNote.length() >= 4)
+		{
+			VRNote(49, mvVRLegNote[0]);
+			VRNote(94, mvVRLegNote[1]);
+			VRNote(95, mvVRLegNote[2]);
+			VRNote(96, mvVRLegNote[3]);
+		}
+	}
+	
+	/////////////////////////////////////////////
+	// BunkerVR: the legs.
+	// The body is drawn bigger (by the world scale) about the eyes, so that
+	// the arms and hands are the player's size; that sinks its feet into the
+	// floor. So, after the arms, each foot is put on the floor and its leg
+	// bent to reach it:
+	//  - walking (the game moving the body by the stick), each foot goes as
+	//    the game's walk animation has it, lifted onto the floor;
+	//  - otherwise each foot stays where it was put down, and takes a step
+	//    (lifted, and put down again where the body now wants it) once the
+	//    body has moved or turned too far from it (`gfVRStepStart`,
+	//    `gfVRStepTurn`); until then the leg only bends and leans.
+	// A leg too long for its hip's height is shortened along its bones
+	// (`mfVRLegFit`, learned slowly while standing), as the arms are drawn
+	// out: standing, it is nearly straight; crouching or ducking, it bends.
+	// The floor under each foot is found with a ray (steps, slopes), within
+	// 35 cm of where the game's body stands.
+	// The game's own foot placement is off meanwhile (it would fight this).
+	// Only while the body script says so (BunkerVR_LegsOk: the head tracked,
+	// the game's own play, not crawling; never in cutscenes, ladders and the
+	// like). Each time it starts from the legs as the game's animation last
+	// left them (kept at the animation update, `mvVRLegFresh`), as the arms do.
+	void UpdateVRLegs()
+	{
+		cMeshEntity@ pMesh = mBaseObj.GetMeshEntity();
+		if(pMesh is null) return;
+		if(cScript_GetGlobalVarInt("BunkerVR_LegsOk") != 1)
+		{
+			if(mbVRLegsOn)
+			{
+				// Back to the game's own legs: its foot placement on again, as
+				// the game has it when not crouching.
+				mbVRLegsOn = false;
+				cLuxFootPlacement@ pPlacementBack = VRFootPlacement();
+				if(pPlacementBack !is null && Player_GetCrouching() == false) pPlacementBack.SetActive(true);
+			}
+			return;
+		}
+		cLuxFootPlacement@ pPlacement = VRFootPlacement();
+		if(pPlacement !is null && pPlacement.IsActive()) pPlacement.SetActive(false);
+
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		iCharacterBody@ pCharBody = pPlayer !is null ? pPlayer.GetCharacterBody() : null;
+		if(pCharBody is null) return;
+
+		bool bFresh = mbVRFreshPose;
+		double fNow = cEngine_GetGameTime();
+		float fStep = cMath_Clamp(float(fNow - mfVRLegLastTime), 0.0f, 0.1f);
+		if(bFresh == false) mfVRLegLastTime = fNow;
+
+		if(mvVRLegFresh.length() < 14)
+		{
+			mvVRLegFresh.resize(14);
+			mvVRLegFreshKnown.resize(14);
+			for(int lSlot = 0; lSlot < 14; ++lSlot) mvVRLegFreshKnown[lSlot] = false;
+			mvVRFootAt.resize(2);
+			mvVRFootFwd.resize(2);
+			mfVRStepStart.resize(2);
+			mvVRStepFrom.resize(2);
+			mvVRLegNote.resize(4);
+			mfVRStepStart[0] = -1.0;
+			mfVRStepStart[1] = -1.0;
+		}
+		if(mfVRStepLength.length() < 2)
+		{
+			mfVRStepLength.resize(2);
+			mfVRStepLength[0] = gfVRStepTime;
+			mfVRStepLength[1] = gfVRStepTime;
+		}
+		array<tString> vChain = {"Leg_1", "Leg_2", "Leg_3", "Leg_4", "Leg_5", "Leg_6", "Foot"};
+		
+		// At the animation update only the legs' fresh pose is kept: they are
+		// placed every frame once the camera is placed (_Global_VRUpdateArms),
+		// and that starts again from this pose anyway. (Placing them here as
+		// well would cost about 0.15 ms a time, for nothing.)
+		if(bFresh)
+		{
+			for(int lSide = 0; lSide < 2; ++lSide)
+			{
+				tString sSide = lSide == 0 ? "j_L_" : "j_R_";
+				for(int lLink = 0; lLink < 7; ++lLink)
+				{
+					cBoneState@ pLink = pMesh.GetBoneStateFromName(sSide + vChain[lLink]);
+					if(pLink is null) continue;
+					mvVRLegFresh[lSide * 7 + lLink] = pLink.GetLocalMatrix();
+					mvVRLegFreshKnown[lSide * 7 + lLink] = true;
+				}
+			}
+			return;
+		}
+
+		cMatrixf mtxBody = mBaseObj.GetMatrix();
+		float fRoot = mtxBody.GetTranslation().y;
+		float fSize = cMath_MatrixMul3x3(mtxBody, cVector3f(1.0f, 0.0f, 0.0f)).Length(); // how big the body is drawn
+		cVector3f vBodyFwd = cMath_MatrixMul3x3(mtxBody, cVector3f(0.0f, 0.0f, 1.0f));
+		vBodyFwd.y = 0.0f;
+		vBodyFwd = vBodyFwd.Length() > 0.0001f ? cMath_Vector3Normalize(vBodyFwd) : cVector3f(0.0f, 0.0f, 1.0f);
+		float fFloor = pCharBody.GetFeetPosition().y;
+		// (In the air, jumping or falling, the feet also go as animated.)
+		bool bWalking = cMath_Abs(pCharBody.GetMoveSpeed(eCharDir_Forward)) + cMath_Abs(pCharBody.GetMoveSpeed(eCharDir_Right)) > 0.2f || pCharBody.IsOnGround() == false;
+		bool bCrouching = Player_GetCrouching();
+
+		/////////////////////////////
+		// 1. Each leg as animated, and where its foot would stand on the floor.
+		array<cVector3f> vHip(2);
+		array<cVector3f> vAnkle(2);
+		array<cVector3f> vHome(2);
+		array<cVector3f> vAnimFwd(2);
+		array<cVector3f> vKneeSide(2);
+		array<cMatrixf> vFootAnim(2);
+		array<float> vLegLength(2);
+		array<float> vGround(2);
+		for(int lSide = 0; lSide < 2; ++lSide)
+		{
+			tString sSide = lSide == 0 ? "j_L_" : "j_R_";
+			for(int lLink = 0; lLink < 7; ++lLink)
+			{
+				cBoneState@ pLink = pMesh.GetBoneStateFromName(sSide + vChain[lLink]);
+				if(pLink is null) continue;
+				int lSlot = lSide * 7 + lLink;
+				if(bFresh)
+				{
+					mvVRLegFresh[lSlot] = pLink.GetLocalMatrix();
+					mvVRLegFreshKnown[lSlot] = true;
+				}
+				else if(mvVRLegFreshKnown[lSlot])
+				{
+					pLink.SetMatrix(mvVRLegFresh[lSlot]);
+				}
+			}
+			cBoneState@ pThigh = pMesh.GetBoneStateFromName(sSide + "Leg_1");
+			cBoneState@ pKnee = pMesh.GetBoneStateFromName(sSide + "Leg_3");
+			cBoneState@ pFoot = pMesh.GetBoneStateFromName(sSide + "Foot");
+			cBoneState@ pToes = pMesh.GetBoneStateFromName(sSide + "Toes");
+			if(pThigh is null || pKnee is null || pFoot is null || pToes is null) return;
+
+			vHip[lSide] = pThigh.GetWorldPosition();
+			cVector3f vKnee = pKnee.GetWorldPosition();
+			vAnkle[lSide] = pFoot.GetWorldPosition();
+			vFootAnim[lSide] = pFoot.GetWorldMatrix();
+			vLegLength[lSide] = (vKnee - vHip[lSide]).Length() + (vAnkle[lSide] - vKnee).Length();
+
+			// Which way the foot points (heel to toes, level).
+			cVector3f vFwd = pToes.GetWorldPosition() - vAnkle[lSide];
+			vFwd.y = 0.0f;
+			vAnimFwd[lSide] = vFwd.Length() > 0.001f ? cMath_Vector3Normalize(vFwd) : vBodyFwd;
+
+			// Which way the knee bends: as animated (out from the line hip to
+			// ankle); nearly straight, the way the foot points.
+			cVector3f vLine = cMath_Vector3Normalize(vAnkle[lSide] - vHip[lSide]);
+			cVector3f vOut = (vKnee - vHip[lSide]) - vLine * cMath_Vector3Dot(vKnee - vHip[lSide], vLine);
+			vKneeSide[lSide] = vOut.Length() > 0.01f * fSize ? cMath_Vector3Normalize(vOut) : vAnimFwd[lSide];
+
+			// Where the foot stands: on the floor under it, as high above it as
+			// the animation has the ankle above the body's own floor.
+			vGround[lSide] = VRGroundBelow(vAnkle[lSide].x, vAnkle[lSide].z, vHip[lSide].y, fFloor);
+			vHome[lSide] = cVector3f(vAnkle[lSide].x, vGround[lSide] + cMath_Clamp(vAnkle[lSide].y - fRoot, 0.0f, 0.6f * fSize), vAnkle[lSide].z);
+		}
+
+		/////////////////////////////
+		// 2. How much the legs are shortened: so that a leg just about reaches
+		// (97% of its length: the knee a little bent, with room for a foot
+		// set a little aside) from the hip down to
+		// where the ankle goes. Learned while standing (not walking, crouching
+		// or stepping), a little at a time, so that ducking bends the knees.
+		float fFitWanted = 0.0f;
+		for(int lSide = 0; lSide < 2; ++lSide)
+		{
+			float fLength = cMath_Max(vLegLength[lSide], 0.01f);
+			fFitWanted += cMath_Clamp((vHip[lSide].y - vHome[lSide].y) / (fLength * 0.97f), gfVRLegFitMin, 1.0f) * 0.5f;
+		}
+		bool bStepping = mfVRStepStart[0] >= 0.0 || mfVRStepStart[1] >= 0.0;
+		// The fit is made each time the view is centered (special roll 7065:
+		// how many times so far), at once, for 0.6 seconds while the eyes are
+		// black and the body settles, and then kept: any duck bends the knees,
+		// and standing up after a re-center fits straight away. (If the mod
+		// does not give the count: learned slowly while standing.)
+		int lCentred = VRRecentreCount();
+		if(lCentred >= 0 && lCentred != mlVRLegCentred)
+		{
+			mlVRLegCentred = lCentred;
+			mfVRLegFitUntil = fNow + 0.6;
+		}
+		if(mbVRLegFitKnown == false)
+		{
+			mfVRLegFit = fFitWanted;
+			mbVRLegFitKnown = true;
+		}
+		else if(lCentred >= 0)
+		{
+			if(fNow < mfVRLegFitUntil && bWalking == false && bCrouching == false) mfVRLegFit = fFitWanted;
+		}
+		else if(bWalking == false && bCrouching == false && bStepping == false)
+		{
+			mfVRLegFit += (fFitWanted - mfVRLegFit) * cMath_Min(fStep * 0.7f, 1.0f);
+		}
+
+		/////////////////////////////
+		// A turn of the game's body (the stick, a snap turn) turns the player on the spot about
+		// the real head, and the body turns at once with it. Feet left planted until each steps
+		// end up as much as 100 degrees off the body in a fast turn; feet carried round whole, as on
+		// a turntable, never step. So in a smooth turn a planted foot stays where it stands and
+		// steps round after the body (quicker while it turns, gfVRStepTimeTurning); only what would
+		// twist it more than gfVRFootTwistMost off the way the body has it is carried round
+		// (VRFootCarry), so a fast turn that outruns the steps never leaves a foot pointing
+		// backwards. A snap turn (more than gfVRSnapTurnLeast in one update) and a foot in the air
+		// are carried round whole. The real body's own turn has them step.
+		float fVRGameTurn = cScript_GetGlobalVarFloat("BunkerVR_GameTurnSum");
+		float fVRTurnBy = cMath_GetAngleDistanceRad(mfVRLegGameTurnWas, fVRGameTurn);
+		mfVRLegGameTurnWas = fVRGameTurn;
+		if(mbVRLegGameTurnKnown && cMath_Abs(fVRTurnBy) > 0.00001f && cMath_Abs(fVRTurnBy) < cMath_Pi * 0.5f)
+		{
+			mfVRLegTurnedAt = fNow;
+			bool bSnap = cMath_Abs(fVRTurnBy) > gfVRSnapTurnLeast;
+			cVector3f vPivot = mbVRHeadKnown ? m_mtxVRHead.GetTranslation() : mtxBody.GetTranslation();
+			for(int lSide = 0; lSide < 2; ++lSide)
+			{
+				float fCarry = fVRTurnBy;
+				if(bSnap == false && mfVRStepStart[lSide] < 0.0) fCarry = VRFootCarry(mvVRFootFwd[lSide], vAnimFwd[lSide], gfVRFootTwistMost);
+				if(cMath_Abs(fCarry) < 0.00001f) continue;
+				cMatrixf mtxTurn = cMath_MatrixRotateY(fCarry);
+				cVector3f vOff = cMath_MatrixMul3x3(mtxTurn, cVector3f(mvVRFootAt[lSide].x - vPivot.x, 0.0f, mvVRFootAt[lSide].z - vPivot.z));
+				mvVRFootAt[lSide] = cVector3f(vPivot.x + vOff.x, mvVRFootAt[lSide].y, vPivot.z + vOff.z);
+				mvVRFootFwd[lSide] = cMath_MatrixMul3x3(mtxTurn, mvVRFootFwd[lSide]);
+				vOff = cMath_MatrixMul3x3(mtxTurn, cVector3f(mvVRStepFrom[lSide].x - vPivot.x, 0.0f, mvVRStepFrom[lSide].z - vPivot.z));
+				mvVRStepFrom[lSide] = cVector3f(vPivot.x + vOff.x, mvVRStepFrom[lSide].y, vPivot.z + vOff.z);
+			}
+		}
+		mbVRLegGameTurnKnown = true;
+		bool bVRTurningNow = float(fNow - mfVRLegTurnedAt) < 0.3f; // (the game turned the body within the last 0.3 s: steps quicker)
+
+		/////////////////////////////
+		// 3. Planted feet, and steps.
+		// (Where the body is, level: how far it has gone since a foot last came
+		// down tells a step for turning from one for walking; see below.)
+		cVector3f vBodyLevel = mtxBody.GetTranslation();
+		vBodyLevel.y = 0.0f;
+		if(mvVRStepBodyAt.length() < 2 || mvVRStepWhy.length() < 2 || mvVRStepTurn.length() < 2 || mvVRStepBodyStart.length() < 2)
+		{
+			mvVRStepBodyAt.resize(2);
+			mvVRStepWhy.resize(2);
+			mvVRStepTurn.resize(2);
+			mvVRStepBodyStart.resize(2);
+			for(int lSide = 0; lSide < 2; ++lSide)
+			{
+				mvVRStepBodyAt[lSide] = vBodyLevel;
+				mvVRStepWhy[lSide] = cVector3f(0.0f);
+				mvVRStepTurn[lSide] = false;
+				mvVRStepBodyStart[lSide] = vBodyLevel;
+			}
+		}
+		if(mbVRLegsOn == false || bWalking)
+		{
+			// Walking (or just started): the feet go as animated.
+			for(int lSide = 0; lSide < 2; ++lSide)
+			{
+				mvVRFootAt[lSide] = vHome[lSide];
+				mvVRFootFwd[lSide] = vAnimFwd[lSide];
+				mfVRStepStart[lSide] = -1.0;
+				mvVRStepBodyAt[lSide] = vBodyLevel;
+			}
+		}
+		else
+		{
+			// Just stopped walking: the feet are put down where they are, on the
+			// ground, at the ankle's height of the lower foot (a foot in the air
+			// mid-stride would otherwise stay there).
+			if(mbVRLegsWalked)
+			{
+				float fRest = cMath_Clamp(cMath_Min(vAnkle[0].y, vAnkle[1].y) - fRoot, 0.0f, 0.6f * fSize);
+				for(int lSide = 0; lSide < 2; ++lSide) mvVRFootAt[lSide].y = vGround[lSide] + fRest;
+			}
+			for(int lSide = 0; lSide < 2; ++lSide)
+			{
+				// A step done: put down where the body wants the foot.
+				if(mfVRStepStart[lSide] >= 0.0 && float(fNow - mfVRStepStart[lSide]) >= mfVRStepLength[lSide])
+				{
+					// (Its pace, the body's speed while the foot was in the air: gfVRStepPaceCareful.)
+					float fStepFor = float(fNow - mfVRStepStart[lSide]);
+					float fPace = fStepFor > 0.05f ? (vBodyLevel - mvVRStepBodyStart[lSide]).Length() / fStepFor : 0.0f;
+					mvVRFootAt[lSide] = vHome[lSide];
+					mvVRFootFwd[lSide] = vAnimFwd[lSide];
+					mfVRStepStart[lSide] = -1.0;
+					mfVRLastLanding = fNow;
+					VRFootstepSound(mvVRStepTurn[lSide], fPace);
+					VRStepNote(lSide, mvVRStepTurn[lSide], mvVRStepWhy[lSide]);
+					mvVRStepBodyAt[lSide] = vBodyLevel;
+				}
+				// Far too far (the game moved the body): put down there at once.
+				cVector3f vAway = vHome[lSide] - mvVRFootAt[lSide];
+				vAway.y = 0.0f;
+				if(vAway.Length() > 0.9f)
+				{
+					mvVRFootAt[lSide] = vHome[lSide];
+					mvVRFootFwd[lSide] = vAnimFwd[lSide];
+					mfVRStepStart[lSide] = -1.0;
+					mvVRStepBodyAt[lSide] = vBodyLevel;
+				}
+			}
+			// One foot at a time: the one furthest out, once one has to go.
+			if(mfVRStepStart[0] < 0.0 && mfVRStepStart[1] < 0.0 && float(fNow - mfVRLastLanding) > 0.06f)
+			{
+				float fNeedMost = 1.0f;
+				int lGo = -1;
+				float fGoAway = 0.0f;
+				for(int lSide = 0; lSide < 2; ++lSide)
+				{
+					cVector3f vAway = vHome[lSide] - mvVRFootAt[lSide];
+					vAway.y = 0.0f;
+					float fTurned = cMath_ACos(cMath_Clamp(cMath_Vector3Dot(mvVRFootFwd[lSide], vAnimFwd[lSide]), -1.0f, 1.0f));
+					float fNeed = cMath_Max(vAway.Length() / gfVRStepStart, fTurned / gfVRStepTurn);
+					if(fNeed >= fNeedMost)
+					{
+						fNeedMost = fNeed;
+						lGo = lSide;
+						fGoAway = vAway.Length();
+					}
+				}
+				if(lGo >= 0)
+				{
+					mfVRStepStart[lGo] = fNow;
+					mvVRStepBodyStart[lGo] = vBodyLevel; // (for the step's pace)
+					mfVRStepLength[lGo] = bVRTurningNow ? gfVRStepTimeTurning : gfVRStepTime; // (quicker while the game turns the body)
+					mvVRStepFrom[lGo] = mvVRFootAt[lGo];
+					// A step for turning on the spot (a quieter footstep) if the body
+					// has hardly gone anywhere since this foot last came down. (Not by
+					// how far the foot is from its place: while the body turns, the
+					// game plays its own turning animation, which steps the animated
+					// feet about, and they are what the drawn feet's places come from.)
+					float fGone = (vBodyLevel - mvVRStepBodyAt[lGo]).Length();
+					mvVRStepTurn[lGo] = fGone < gfVRStepQuietTravel;
+					mvVRStepWhy[lGo] = cVector3f(fGone, fGoAway, 0.0f);
+				}
+			}
+		}
+
+		/////////////////////////////
+		// 4. Each leg bent to reach its foot's place.
+		for(int lSide = 0; lSide < 2; ++lSide)
+		{
+			cVector3f vTarget = mvVRFootAt[lSide];
+			cVector3f vFacing = mvVRFootFwd[lSide];
+			if(mfVRStepStart[lSide] >= 0.0)
+			{
+				float fT = cMath_Clamp(float(fNow - mfVRStepStart[lSide]) / mfVRStepLength[lSide], 0.0f, 1.0f);
+				float fEase = fT * fT * (3.0f - 2.0f * fT);
+				vTarget = mvVRStepFrom[lSide] + (vHome[lSide] - mvVRStepFrom[lSide]) * fEase + cVector3f(0.0f, cMath_Sin(fT * cMath_Pi) * gfVRStepLift * fSize, 0.0f);
+				// (The foot turns to its new way in the air, through the step, not all at
+				// once at its top, which in a stick turn can be 46 degrees in a frame.)
+				cVector3f vTurning = mvVRFootFwd[lSide] * (1.0f - fEase) + vAnimFwd[lSide] * fEase;
+				vFacing = vTurning.Length() > 0.05f ? cMath_Vector3Normalize(vTurning) : (fT >= 0.5f ? vAnimFwd[lSide] : mvVRFootFwd[lSide]);
+			}
+			// The foot as animated, turned about the upright to point its way;
+			// the knee turned with it.
+			cMatrixf mtxYaw = VRTurnBetween(vAnimFwd[lSide], vFacing, cVector3f(0.0f, 1.0f, 0.0f));
+			VRBendLeg(pMesh, lSide == 0 ? "j_L_" : "j_R_", vTarget, cMath_MatrixMul(mtxYaw, vFootAnim[lSide]), cMath_MatrixMul3x3(mtxYaw, vKneeSide[lSide]));
+		}
+		mbVRLegsOn = true;
+		mbVRLegsWalked = bWalking;
+
+		// For the F9 notes (see VRBodyNotes).
+		cVector3f vAwayLeft = vHome[0] - mvVRFootAt[0];
+		cVector3f vAwayRight = vHome[1] - mvVRFootAt[1];
+		vAwayLeft.y = 0.0f;
+		vAwayRight.y = 0.0f;
+		mvVRLegNote[0] = cVector3f(mfVRLegFit, bWalking ? 1.0f : 0.0f, bCrouching ? 1.0f : 0.0f);
+		mvVRLegNote[1] = cVector3f(vHip[0].y - vHome[0].y, vLegLength[0], (vHome[0] - vHip[0]).Length());
+		mvVRLegNote[2] = cVector3f(vHip[1].y - vHome[1].y, vLegLength[1], (vHome[1] - vHip[1]).Length());
+		mvVRLegNote[3] = cVector3f(vAwayLeft.Length(), vAwayRight.Length(), mfVRStepStart[0] >= 0.0 ? 1.0f : (mfVRStepStart[1] >= 0.0 ? 2.0f : 0.0f));
+	}
+
+	// BunkerVR: how far a planted foot pointing avFootFwd is to be carried round
+	// the upright so that it is twisted no more than afMost (radians) from
+	// avBodyFwd, the way the body has it now (see UpdateVRLegs): 0
+	// within that; past it, the rest, as cMath_MatrixRotateY turns (both level).
+	float VRFootCarry(const cVector3f &in avFootFwd, const cVector3f &in avBodyFwd, float afMost)
+	{
+		float fTwist = cMath_ATan2(avBodyFwd.x, avBodyFwd.z) - cMath_ATan2(avFootFwd.x, avFootFwd.z);
+		if(fTwist > cMath_Pi) fTwist -= cMath_Pi * 2.0f;
+		if(fTwist < -cMath_Pi) fTwist += cMath_Pi * 2.0f;
+		if(fTwist > afMost) return fTwist - afMost;
+		if(fTwist < -afMost) return fTwist + afMost;
+		return 0.0f;
+	}
+
+	// BunkerVR: bends one leg (asSide: "j_L_" or "j_R_") so that its ankle is
+	// at avTarget, its foot turned as a_mtxFoot (its place is then set), the
+	// knee bending out towards avKneeSide. As the arm is bent (UpdateVRArm):
+	// the thigh (j_?_Leg_1) is turned about the hip so the knee (j_?_Leg_3)
+	// comes to its place, keeping the knee's hinge; the shin is turned about
+	// the knee so the ankle (j_?_Foot) comes to its place. The leg is
+	// `mfVRLegFit` of its own length: the bones along the thigh (Leg_2) and
+	// the shin (Leg_4 to Leg_6) move in by their share.
+	void VRBendLeg(cMeshEntity@ apMesh, const tString &in asSide, const cVector3f &in avTarget, const cMatrixf &in a_mtxFoot, const cVector3f &in avKneeSide)
+	{
+		cBoneState@ pThigh = apMesh.GetBoneStateFromName(asSide + "Leg_1");
+		cBoneState@ pKnee = apMesh.GetBoneStateFromName(asSide + "Leg_3");
+		cBoneState@ pFoot = apMesh.GetBoneStateFromName(asSide + "Foot");
+		if(pThigh is null || pKnee is null || pFoot is null) return;
+		cVector3f vHip = pThigh.GetWorldPosition();
+		cVector3f vKnee = pKnee.GetWorldPosition();
+		cVector3f vAnkle = pFoot.GetWorldPosition();
+		float fThighOwn = (vKnee - vHip).Length();
+		float fShinOwn = (vAnkle - vKnee).Length();
+		if(fThighOwn * mfVRLegFit < 0.01f || fShinOwn * mfVRLegFit < 0.01f) return;
+
+		cVector3f vDir = avTarget - vHip;
+		float fDist = vDir.Length();
+		if(fDist < 0.01f) return;
+		vDir = vDir * (1.0f / fDist);
+		// The leg's length: `mfVRLegFit` of its own; out of reach, drawn out up
+		// to gfVRLegStretch of that (standing taller than at the re-center, the
+		// feet stay down).
+		float fShare = mfVRLegFit * cMath_Clamp(fDist / ((fThighOwn + fShinOwn) * mfVRLegFit * 0.999f), 1.0f, gfVRLegStretch);
+		float fThigh = fThighOwn * fShare;
+		float fShin = fShinOwn * fShare;
+		// (Out of reach: the leg straight, towards the place.)
+		float fReach = cMath_Clamp(fDist, cMath_Abs(fThigh - fShin) + 0.002f, (fThigh + fShin) * 0.9995f);
+
+		cVector3f vSide = avKneeSide - vDir * cMath_Vector3Dot(avKneeSide, vDir);
+		if(vSide.Length() < 0.001f)
+		{
+			vSide = (vKnee - vHip) - vDir * cMath_Vector3Dot(vKnee - vHip, vDir);
+			if(vSide.Length() < 0.001f) return;
+		}
+		vSide.Normalize();
+
+		float fAlong = (fThigh * fThigh - fShin * fShin + fReach * fReach) / (2.0f * fReach);
+		float fAside = cMath_Sqrt(cMath_Max(fThigh * fThigh - fAlong * fAlong, 0.0f));
+		cVector3f vKneeWanted = vHip + vDir * fAlong + vSide * fAside;
+		cVector3f vAnkleWanted = vHip + vDir * fReach;
+
+		// Thigh: swing the knee to its place (the shin and foot swing along),
+		// keeping the knee's hinge as it is in the animated leg.
+		cMatrixf mtxThighTurn = VRTurnBetween(vKnee - vHip, vKneeWanted - vHip, vSide);
+		{
+			cVector3f vHingeWas = cMath_Vector3Cross(vKnee - vHip, vAnkle - vKnee);
+			cVector3f vHingeWanted = cMath_Vector3Cross(vKneeWanted - vHip, vAnkleWanted - vKneeWanted);
+			float fBendWas = vHingeWas.Length() / cMath_Max((vKnee - vHip).Length() * (vAnkle - vKnee).Length(), 0.000001f);
+			float fBendWanted = vHingeWanted.Length() / cMath_Max(fThigh * fShin, 0.000001f);
+			if(fBendWas > 0.1f && fBendWanted > 0.05f)
+				mtxThighTurn = VRTurnFrame(vKnee - vHip, vHingeWas, vKneeWanted - vHip, vHingeWanted);
+		}
+		VRTurnBoneAbout(pThigh, mtxThighTurn, vHip);
+
+		// The thigh's length: the bone along it by its share, the knee to its place.
+		VRLegBonesAlong(apMesh, asSide, 2, 2, vHip, vKneeWanted, fShare - 1.0f);
+		VRMoveBoneTo(pKnee, vKneeWanted);
+
+		// Shin: swing the ankle to its place.
+		cVector3f vAnkleSwung = pFoot.GetWorldPosition();
+		VRTurnBoneAbout(pKnee, VRTurnBetween(vAnkleSwung - vKneeWanted, vAnkleWanted - vKneeWanted, vSide), vKneeWanted);
+
+		// The shin's length: the bones along it by their shares; then the foot,
+		// in its place and turned its way.
+		VRLegBonesAlong(apMesh, asSide, 4, 6, vKneeWanted, vAnkleWanted, fShare - 1.0f);
+		cMatrixf mtxFootNew = a_mtxFoot;
+		mtxFootNew.SetTranslation(vAnkleWanted);
+		pFoot.SetWorldMatrix(mtxFootNew);
+	}
+
+	// BunkerVR: the leg's bones asSide + "Leg_" alFirst to alLast that lie
+	// along the line from avFrom to avTo (already turned onto it) are moved
+	// along it by afMoreBy of how far along it they are (-0.2: a fifth of the
+	// way back towards avFrom). All are worked out first, then moved in order
+	// from avFrom, each carrying the ones after it, as the forearm's are.
+	// A bone not between the two ends is left where it is.
+	void VRLegBonesAlong(cMeshEntity@ apMesh, const tString &in asSide, int alFirst, int alLast, const cVector3f &in avFrom, const cVector3f &in avTo, float afMoreBy)
+	{
+		if(cMath_Abs(afMoreBy) < 0.0005f) return;
+		cVector3f vLine = avTo - avFrom;
+		float fLine = vLine.Length();
+		if(fLine < 0.001f) return;
+		vLine = vLine * (1.0f / fLine);
+		int lCount = alLast - alFirst + 1;
+		array<cVector3f> vGoTo(lCount);
+		array<bool> vMove(lCount);
+		for(int i = 0; i < lCount; ++i)
+		{
+			vMove[i] = false;
+			cBoneState@ pBone = apMesh.GetBoneStateFromName(asSide + "Leg_" + (alFirst + i));
+			if(pBone is null) continue;
+			cVector3f vAt = pBone.GetWorldPosition();
+			// (Taken along the bones' own line: they still have their own lengths.)
+			float fAlong = cMath_Vector3Dot(vAt - avFrom, vLine);
+			if(fAlong <= 0.0f || fAlong >= fLine / cMath_Max(1.0f + afMoreBy, 0.1f)) continue;
+			vGoTo[i] = vAt + vLine * (fAlong * afMoreBy);
+			vMove[i] = true;
+		}
+		for(int i = 0; i < lCount; ++i)
+		{
+			if(vMove[i] == false) continue;
+			VRMoveBoneTo(apMesh.GetBoneStateFromName(asSide + "Leg_" + (alFirst + i)), vGoTo[i]);
+		}
+	}
+
+	// BunkerVR: the floor under a foot: a ray straight down at (afX, afZ) from
+	// afFromY (the hip), counting the ground (no mass) or anything of 20 kg or
+	// more, looking past bodies and light loose things. Kept within 35 cm of
+	// afFloor (where the game's body stands); nothing found there: afFloor.
+	float VRGroundBelow(float afX, float afZ, float afFromY, float afFloor)
+	{
+		float fLength = afFromY - (afFloor - 0.35f);
+		if(fLength <= 0.0f) return afFloor;
+		float fGone = 0.0f;
+		for(int i = 0; i < 4; ++i)
+		{
+			float fLeft = fLength - fGone;
+			if(fLeft <= 0.0f) return afFloor;
+			float fHit = 0.0f;
+			cVector3f vNormal = cVector3f(0.0f);
+			iPhysicsBody@ pHit = cLux_GetClosestBody(cVector3f(afX, afFromY - fGone, afZ), cVector3f(0.0f, -1.0f, 0.0f), fLeft, fHit, vNormal);
+			if(pHit is null) return afFloor;
+			if(pHit.IsCharacter() == false && (pHit.GetMass() <= 0.0f || pHit.GetMass() >= 20.0f))
+			{
+				float fGround = afFromY - fGone - fHit;
+				if(fGround > afFloor + 0.35f) return afFloor; // (something above the floor, such as a table: not stood on)
+				return cMath_Max(fGround, afFloor - 0.35f);
+			}
+			fGone += fHit + 0.01f;
+		}
+		return afFloor;
+	}
+
+	// BunkerVR: how many times the VR mod has centered the view (special roll
+	// 7065); -1 when it does not say.
+	int VRRecentreCount()
+	{
+		cCamera@ pCam = cLux_GetPlayer().GetCamera();
+		if(pCam is null) return -1;
+		float fRealRoll = pCam.GetRoll();
+		pCam.SetRoll(7065.0f);
+		cVector3f vAnswer = pCam.GetMatrix().GetTranslation();
+		pCam.SetRoll(fRealRoll);
+		if(vAnswer.x < 12344.0f || vAnswer.x > 12346.0f) return -1;
+		return int(vAnswer.y + 0.5f);
+	}
+	
+	// BunkerVR: the game's foot placement on this body (null if it has none).
+	cLuxFootPlacement@ VRFootPlacement()
+	{
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		if(pMap is null) return null;
+		iLuxEntity@ pSelf = pMap.GetEntityByName(mBaseObj.GetName());
+		if(pSelf is null) return null;
+		return cast<cLuxFootPlacement@>(pSelf.GetComponentByType(eLuxEntityComponentType_FootPlacement));
+	}
+
+	// BunkerVR: a timing mark for the VR mod's log (7070 + 2 x the piece of
+	// work's number at its start, 7071 + 2 x it at its end; the mod times the
+	// gap, see CameraLogScriptTimings). Nothing happens without it.
+	void VRTimeMark(int alCode)
+	{
+		cVR_TimeMark(alCode);
+	}
+
+	// Sends three numbers to the VR mod's log (BunkerVR.log), for checking this
+	// code from outside the game.
+	void VRNote(int alItem, const cVector3f &in avNumbers)
+	{
+		cVR_Note(alItem, avNumbers.x, avNumbers.y, avNumbers.z);
+	}
+	
+	// abPalmAsEmpty: the hand holds a thing the mod places itself; the hand is
+	// put on the controller by its palm as it is when empty.
+	void UpdateVRArm(cMeshEntity@ apMesh, bool abLeft, const tString &in asShoulder, const tString &in asElbow, const tString &in asWrist,
+					 const cMatrixf &in a_mtxPalm, float afArmScale, float afCurl, int alFingerMode, const cVector3f &in avFingers, bool abOwnPose,
+					 bool abPalmAsEmpty)
+	{
+		cBoneState@ pShoulder = apMesh.GetBoneStateFromName(asShoulder);
+		cBoneState@ pElbow = apMesh.GetBoneStateFromName(asElbow);
+		cBoneState@ pWrist = apMesh.GetBoneStateFromName(asWrist);
+		cBoneState@ pPalm = VRArmBone(apMesh, abLeft, 10); // (j_?_HandSocket; the arm's other bones are found once too: see VRFindBones)
+		if(pShoulder is null || pElbow is null || pWrist is null || pPalm is null) return;
+		VRTimeMark(7106); // (timing: the pose kept and the reach, to 7107)
+		
+		// Whenever the arm as a whole has to be moved (to stay under the
+		// head, to reach, to keep the elbow from folding up), it is moved by
+		// its collar bone, which carries the shoulder with it. Moved by the
+		// upper arm's own bone, the shoulder's skin stays behind on the body
+		// and is drawn out into a spike.
+		cBoneState@ pArmRoot = VRArmBone(apMesh, abLeft, 0); // (j_?_Clavicle)
+		if(pArmRoot is null) @pArmRoot = pShoulder;
+		
+		/////////////////////////////
+		// The arm always starts from the pose it has when both hands are
+		// empty. With the gun, the flashlight or anything else out, the game
+		// plays other arm animations, which raise and turn the collar bone and
+		// the upper arm their own way, and the arm bent from there looks
+		// broken at the shoulder. So while both hands are empty, the collar
+		// bone and the arm's bones as the game has just animated them are
+		// kept (only straight after an animation update, before anything here
+		// has moved them), and while anything is held they are put back to
+		// that before the arm is bent. The hand itself, and the fingers, are
+		// still as the game and the controller have them.
+		bool bLearnPalm = false; // (and the palm's place in the hand learned with it: see below)
+		{
+			if(mvVRNeutralChain.length() < 20)
+			{
+				mvVRNeutralChain.resize(20);
+				mvVRNeutralKnown.resize(20);
+				for(int lNeutral = 0; lNeutral < 20; ++lNeutral) mvVRNeutralKnown[lNeutral] = false;
+			}
+			// (The wrist too: the flashlight's animation turns the hand on the
+			// forearm, and the forearm would be twisted by that much as well.)
+			// (The chain: Clavicle, Arm_Zero, Arm_Assist, Arm_1 to Arm_6, Wrist: the arm's
+			// bones 0 to 9 in VRArmBone.)
+			// Is the arm, as just animated, hanging down (the hand well below
+			// the shoulder)? Only such a pose is learned. (Started from the
+			// flashlight's own animation, raised high, the arm bends oddly and
+			// the forearm is twisted as far as it may go.)
+			// Straight down, nearly: the wrist at least 0.85 of the arm's
+			// length below the shoulder. The game's own pose with empty hands
+			// has it 0.96 below; the bandage's lowering animation, stuck and
+			// started over every update (see PlayOutroAndLeaveState in
+			// PlayerState_UsingItem_Base.hps), has the left arm forward and
+			// out with the wrist 0.65 below, which must not pass: learned from
+			// it, the left forearm is twisted as far as it may go and the
+			// wrist wrung.
+			bool bHanging = false;
+			{
+				cVector3f vTop = pShoulder.GetWorldPosition();
+				cVector3f vMiddle = pElbow.GetWorldPosition();
+				cVector3f vEnd = pWrist.GetWorldPosition();
+				float fArmNow = (vMiddle - vTop).Length() + (vEnd - vMiddle).Length();
+				bHanging = fArmNow > 0.001f && vTop.y - vEnd.y > fArmNow * 0.85f;
+			}
+			// (And nothing hangs on the hand, in plain play: see the palm's place below.)
+			bool bArmClear = VRHandHangsNothing(abLeft) && cLux_GetPlayer() !is null && cLux_GetPlayer().GetCurrentStateId() == ePlayerState_Normal;
+			bLearnPalm = mbVRHandsSettled && mbVRFreshPose && bHanging && bArmClear;
+			for(uint lLink = 0; lLink < 10; ++lLink)
+			{
+				cBoneState@ pLink = VRArmBone(apMesh, abLeft, int(lLink));
+				if(pLink is null) continue;
+				int lSlot = (abLeft ? 0 : 10) + int(lLink);
+				// (Used always, empty hands too: the walk and run animations
+				// swing the arms, and arms bent from a swinging pose twist and
+				// shake while walking, running or turning. Learned the first
+				// time the hands are empty and the arm hangs, then again
+				// whenever standing still. Once learned,
+				// the second bending of each frame also starts from it, so
+				// nothing done the first time round is carried into the second.)
+				if(mbVRHandsSettled && mbVRFreshPose && bHanging && bArmClear && (mbVRStill || mvVRNeutralKnown[lSlot] == false))
+				{
+					mvVRNeutralChain[lSlot] = pLink.GetLocalMatrix();
+					mvVRNeutralKnown[lSlot] = true;
+				}
+				if(mvVRNeutralKnown[lSlot])
+				{
+					pLink.SetMatrix(mvVRNeutralChain[lSlot]);
+				}
+			}
+		}
+		
+		// Notes for the log, when the mod asks for them (it does after each F9 capture).
+		bool bNote = mbVRArmNote;
+		int lNote = abLeft ? 0 : 50;
+		
+		/////////////////////////////
+		// Where the arm is now (as animated).
+		cVector3f vShoulder = pShoulder.GetWorldPosition();
+		cVector3f vElbow = pElbow.GetWorldPosition();
+		cVector3f vWrist = pWrist.GetWorldPosition();
+		cMatrixf mtxWristWas = pWrist.GetWorldMatrix();
+		cVector3f vPalmInHand = cMath_MatrixMul(cMath_MatrixInverse(mtxWristWas), pPalm.GetWorldPosition()); // the palm's place within the hand bone
+		// That place is where the game hangs held things (the socket), and
+		// each thing's own animation moves it about in the hand: holding the
+		// empty bottle, 13 cm from where it is with the hand empty, so a
+		// hand put on the controller by it would be drawn 13 cm off. So it
+		// is learned with the arm's own pose above (both hands empty, the
+		// arm hanging, standing still or not known yet), and a hand is put
+		// on the controller by it whenever abPalmAsEmpty says so (see
+		// bVRPalmAsEmptyLeft in UpdateVRArms: not with the revolver out).
+		// Things the game still hangs hang from the socket's moving place
+		// in the hand, as the game has them.
+		int lPalmArm = abLeft ? 0 : 1;
+		// (Nothing is learned while anything hangs on that hand or the player is not in plain play: the
+		// game can say the hand holds nothing while the shotgun still hangs on it, being put away during
+		// the game's health check with its animation holding the socket far along the hand, and a place
+		// learned then is some 25 cm off, the hand and the gun drawn that far from the controller. A place
+		// more than gfVRPalmRelearnMost from the one known is taken only after glVRPalmRelearnFarFrames of
+		// empty hands.)
+		if(bLearnPalm && (mbVRStill || mvVRPalmPointKnown[lPalmArm] == false))
+		{
+			float fMoved = mvVRPalmPointKnown[lPalmArm] ? cMath_MatrixMul3x3(mtxWristWas, vPalmInHand - mvVRPalmPoint[lPalmArm]).Length() : 0.0f;
+			bool bFar = mvVRPalmPointKnown[lPalmArm] && fMoved > gfVRPalmRelearnMost && mlVRHandsEmptyFrames < glVRPalmRelearnFarFrames;
+			// (Learned again somewhere else: logged, the first 20 times.)
+			if(fMoved > 0.02f && mlVRPalmRelearnNotes < 20)
+			{
+				mlVRPalmRelearnNotes++;
+				Log("BunkerVR hands: the " + (abLeft ? "left" : "right") + " palm's place in the hand " + (bFar ? "not " : "") + "learnt again, " + int(fMoved * 100.0f) +
+					" cm from where it was (both hands empty for " + mlVRHandsEmptyFrames + " updates, still for " + mlVRStillFrames + ")" + (bFar ? ": too far, so soon" : "") + "\n");
+			}
+			if(bFar == false)
+			{
+				// (The first time in a map, logged if it is not its usual place.)
+				float fFromUsual = cMath_MatrixMul3x3(mtxWristWas, vPalmInHand - (abLeft ? gvVRPalmPointUsualLeft : gvVRPalmPointUsualRight)).Length();
+				if(mvVRPalmPointKnown[lPalmArm] == false && fFromUsual > 0.01f)
+					Log("BunkerVR hands: the " + (abLeft ? "left" : "right") + " palm's place in the hand first learnt " + int(fFromUsual * 100.0f + 0.5f) +
+						" cm from its usual place (the hand bone's own terms " + vPalmInHand.x + " " + vPalmInHand.y + " " + vPalmInHand.z + ")\n");
+				mvVRPalmPoint[lPalmArm] = vPalmInHand;
+				mvVRPalmPointKnown[lPalmArm] = true;
+			}
+		}
+		// (Until it is learned, its usual place: otherwise a right hand not learned yet when it takes the dynamite bundle is
+		// put on the controller by the socket where the bundle's own animation holds it, and drawn 8 cm off the bundle.)
+		if(abPalmAsEmpty) vPalmInHand = mvVRPalmPointKnown[lPalmArm] ? mvVRPalmPoint[lPalmArm] : (abLeft ? gvVRPalmPointUsualLeft : gvVRPalmPointUsualRight);
+		
+		if(bNote)
+		{
+			VRNote(lNote + 0, vShoulder);
+			VRNote(lNote + 1, vElbow);
+			VRNote(lNote + 2, vWrist);
+			VRNote(lNote + 3, pPalm.GetWorldPosition());
+			VRNote(lNote + 4, cVector3f(cMath_MatrixMul3x3(mtxWristWas, cVector3f(1.0f, 0.0f, 0.0f)).Length(),
+										cMath_MatrixMul3x3(mtxWristWas, cVector3f(0.0f, 1.0f, 0.0f)).Length(),
+										cMath_MatrixMul3x3(mtxWristWas, cVector3f(0.0f, 0.0f, 1.0f)).Length()));
+			VRNote(lNote + 5, vPalmInHand);
+			// Standing still (1 or 0), for how many frames, and is this arm's own pose known (1 or 0)?
+			VRNote(lNote + 8, cVector3f(mbVRStill ? 1.0f : 0.0f, float(mlVRStillFrames), mvVRNeutralKnown[abLeft ? 0 : 10] ? 1.0f : 0.0f));
+		}
+		
+		// (afArmScale is only logged, never drawn: the mod always sends 1 (VrGetArmScale), as arm
+		// bones resized on their own turn the sleeves into ribbons.)
+		
+		/////////////////////////////
+		// (Don't move each arm, by its upper bone or its collar bone, to where
+		// a real shoulder is under the real head. The model's shoulders are
+		// well below and behind its eyes, more so drawn bigger, so the arm
+		// would always be moved a hand's width from the body, and the
+		// sleeve's top, which is fixed to the body, drawn out into a spike or
+		// a flap. The whole body is moved instead: see "the chest goes under
+		// the neck" in PlayerBodyHandler.hps.)
+		
+		/////////////////////////////
+		// The controller: where the palm is, and which way the controller is
+		// turned. The mod gives the controller's "pointing" directions: held
+		// naturally, its X is to the right, its Y up (towards the thumb) and
+		// its Z backwards (the controller points along -Z).
+		cVector3f vPalmPos = a_mtxPalm.GetTranslation();
+		cVector3f vCtrlX = cMath_Vector3Normalize(cMath_MatrixMul3x3(a_mtxPalm, cVector3f(1.0f, 0.0f, 0.0f)));
+		cVector3f vCtrlY = cMath_Vector3Normalize(cMath_MatrixMul3x3(a_mtxPalm, cVector3f(0.0f, 1.0f, 0.0f)));
+		cVector3f vCtrlZ = cMath_Vector3Normalize(cMath_MatrixMul3x3(a_mtxPalm, cVector3f(0.0f, 0.0f, 1.0f)));
+		
+		// The fingers lie the way the controller points, dipped a little.
+		cVector3f vFingersWanted = cMath_Vector3Normalize(vCtrlZ * -gfVRHandForward + vCtrlY * -gfVRHandDip);
+		// The back of the hand faces outwards (the palms face each other).
+		cVector3f vHandBackWanted = abLeft ? vCtrlX * -1.0f : vCtrlX;
+		
+		/////////////////////////////
+		// The hand bone turned the way the real hand is.
+		// In this model's hand bone, "along the fingers" is its +X for the left
+		// hand and -X for the right, and "out of the back of the hand" is its +Y
+		// for the left hand and -Y for the right.
+		float fSide = abLeft ? 1.0f : -1.0f;
+		cMatrixf mtxHand = mtxWristWas;
+		{
+			cVector3f vFingersNow = cMath_MatrixMul3x3(mtxHand, cVector3f(fSide, 0.0f, 0.0f));
+			cVector3f vBackNow = cMath_MatrixMul3x3(mtxHand, cVector3f(0.0f, fSide, 0.0f));
+			mtxHand = cMath_MatrixMul(VRTurnBetween(vFingersNow, vFingersWanted, vBackNow), mtxHand);
+			
+			vBackNow = cMath_MatrixMul3x3(mtxHand, cVector3f(0.0f, fSide, 0.0f));
+			mtxHand = cMath_MatrixMul(VRTurnBetween(vBackNow, vHandBackWanted, vFingersWanted), mtxHand);
+		}
+		
+		// With a gun in this hand: turn the hand a little further, so that the
+		// gun's barrel points exactly the way the controller points. (How the
+		// barrel lies within the hand is worked out each time the gun has been
+		// placed; see VRMeasureGunBarrel.)
+		if(abLeft == false && mbVRGunInHand && mbVRBarrelKnown)
+		{
+			// The angles from the mod's menu shift where the barrel should
+			// point: to the controller's right (+X) and up (+Y).
+			cVector3f vBarrelWanted = cMath_Vector3Normalize(vCtrlZ * -1.0f + vCtrlX * cMath_Tan(mvVRGunAngles.x) + vCtrlY * cMath_Tan(mvVRGunAngles.y));
+			cVector3f vBarrelNow = cMath_MatrixMul3x3(mtxHand, mvVRBarrelInHand);
+			mtxHand = cMath_MatrixMul(VRTurnBetween(vBarrelNow, vBarrelWanted, vCtrlX), mtxHand);
+
+			// The shotgun with its pump in the left hand: aimed through the left
+			// hand instead (the left hand steers). The hand is turned on so that
+			// the fore-end's middle (as found in this hand: VRMeasureGunBarrel)
+			// lies the way of where the real left hand holds it: the place the
+			// grip "Holding the shotgun's pump" has it in that palm
+			// (mvVRPumpGripAt). The menu's
+			// barrel angles are then left out (the two hands say where it points);
+			// its lean stays.
+			if(mbVRShotgunInHand && mbVRLeftOnGun && mbVRForeEndKnown)
+			{
+				cVector3f vForeEndNow = cMath_MatrixMul3x3(mtxHand, mvVRForeEndInHand - vPalmInHand);
+				cVector3f vForeEndWanted = cMath_MatrixMul(m_mtxVRPalmLeft, mvVRPumpGripAt) - vPalmPos;
+				if(vForeEndNow.Length() > 0.05f && vForeEndWanted.Length() > 0.1f)
+				{
+					mtxHand = cMath_MatrixMul(VRTurnBetween(vForeEndNow, vForeEndWanted, vCtrlX), mtxHand);
+					vBarrelWanted = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxHand, mvVRBarrelInHand));
+				}
+			}
+			
+			// And lean the gun about its barrel: its top towards the
+			// controller's right for a positive angle.
+			if(mvVRGunAngles.z > 0.001f || mvVRGunAngles.z < -0.001f)
+			{
+				cVector3f vUpNow = vCtrlY - vBarrelWanted * cMath_Vector3Dot(vCtrlY, vBarrelWanted);
+				if(vUpNow.Length() > 0.01f)
+				{
+					vUpNow.Normalize();
+					cVector3f vSide = cMath_Vector3Cross(vBarrelWanted, vUpNow);
+					cVector3f vUpWanted = vUpNow * cMath_Cos(mvVRGunAngles.z) + vSide * cMath_Sin(mvVRGunAngles.z);
+					mtxHand = cMath_MatrixMul(VRTurnBetween(vUpNow, vUpWanted, vBarrelWanted), mtxHand);
+				}
+			}
+			
+			// A shot's kick (the shotgun): the muzzle thrown up and
+			// the gun pushed back into the hand, settling over a moment
+			// (BunkerVR_GunKick; the shot sets "BunkerVR_GunKickAt":
+			// PlayerState_UsingShotgun_Aim.hps). The left hand, on the
+			// fore-end, stays where it is. How far the gun is pushed back is
+			// told to its own script, which leaves it out of the pump's
+			// stroke ("BunkerVR_GunKickPushed": Prop_Shotgun.hps).
+			if(mbVRShotgunInHand)
+			{
+				float fKickSince = float(cEngine_GetGameTime()) - cScript_GetGlobalVarFloat("BunkerVR_GunKickAt");
+				float fKick = BunkerVR_GunKick(fKickSince);
+				float fKickPush = 0.0f;
+				if(fKick > 0.0001f)
+				{
+					cVector3f vBarrel = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxHand, mvVRBarrelInHand));
+					cVector3f vUpNow = vCtrlY - vBarrel * cMath_Vector3Dot(vCtrlY, vBarrel);
+					if(vUpNow.Length() > 0.01f)
+					{
+						vUpNow.Normalize();
+						cVector3f vKicked = vBarrel * cMath_Cos(fKick) + vUpNow * cMath_Sin(fKick);
+						mtxHand = cMath_MatrixMul(VRTurnBetween(vBarrel, vKicked, vCtrlX), mtxHand);
+					}
+					fKickPush = BunkerVR_GunKickPush(fKickSince);
+					vPalmPos = vPalmPos - vBarrel * fKickPush;
+				}
+				cScript_SetGlobalVarFloat("BunkerVR_GunKickPushed", fKickPush);
+			}
+		}
+		
+		// Where the wrist must be for the middle of the palm to sit on the controller's grip.
+		cVector3f vTarget = vPalmPos - cMath_MatrixMul3x3(mtxHand, vPalmInHand);
+		
+		/////////////////////////////
+		// Bend the arm so the wrist reaches that spot.
+		// The arm's own lengths. A reaching arm is drawn out below, and this
+		// runs twice a frame; if the arm has the very lengths it was drawn out
+		// to last time, it still is (nothing has set it back since), and its
+		// own lengths are the ones kept from before. Any other lengths are its
+		// own. (Don't keep the shortest lengths ever seen instead: some
+		// moments give about half the real ones, and the arms are then bent
+		// as if that short, the forearms squashed, and the shoulders slid
+		// far out after the hands.)
+		int lLength = abLeft ? 0 : 2;
+		float fUpperNow = (vElbow - vShoulder).Length();
+		float fForeNow = (vWrist - vElbow).Length();
+		if(mvVRArmNatural[lLength] < 0.001f || cMath_Abs(fUpperNow - mvVRArmDrawnOut[lLength]) > 0.0005f) mvVRArmNatural[lLength] = fUpperNow;
+		if(mvVRArmNatural[lLength + 1] < 0.001f || cMath_Abs(fForeNow - mvVRArmDrawnOut[lLength + 1]) > 0.0005f) mvVRArmNatural[lLength + 1] = fForeNow;
+		float fUpper = mvVRArmNatural[lLength];
+		float fFore = mvVRArmNatural[lLength + 1];
+
+		cVector3f vToTarget = vTarget - vShoulder;
+		float fDist = vToTarget.Length();
+		if(fUpper < 0.001f || fFore < 0.001f || fDist < 0.001f) return;
+		cVector3f vDir = vToTarget * (1.0f / fDist);
+		
+		// The character's arms are shorter than a real person's. When the spot is
+		// out of reach, two things make up the difference. The body's handler
+		// is told how far short the arm is, and leans the whole body that way
+		// over the next few frames (see "the body leans after a reaching hand"
+		// in PlayerBodyHandler.hps): nothing is torn by that. What is still
+		// missing meanwhile is made up by sliding the arm out from the body,
+		// by its collar bone.
+		// (Don't make the arm longer by scaling its upper bone: the bones
+		// after it don't move out with it, the arm stops short of the hand,
+		// and the cuff is drawn out between them like a noodle.)
+		// So that the shoulder doesn't look pulled out at full reach, the
+		// arm is first drawn out a little, up to gfVRArmStretch of its
+		// length: each bone along it is moved out, not scaled, so the sleeve
+		// lengthens evenly from shoulder to wrist (see "the upper arm drawn
+		// out" below). Only what is still missing after that slides the arm
+		// out and leans the body.
+		float fStretch = 1.0f;
+		float fNaturalLongest = (fUpper + fFore) * 0.98f;
+		if(fDist > fNaturalLongest) fStretch = cMath_Min(fDist / fNaturalLongest, gfVRArmStretch);
+		fUpper *= fStretch;
+		fFore *= fStretch;
+		mvVRArmDrawnOut[lLength] = fUpper;
+		mvVRArmDrawnOut[lLength + 1] = fFore;
+		float fLongest = (fUpper + fFore) * 0.98f;
+		float fReach = fDist;
+		cVector3f vShortBy = cVector3f(0.0f, 0.0f, 0.0f);
+		if(fDist > fLongest)
+		{
+			cVector3f vSlide = vDir * (fDist - fLongest);
+			vShortBy = vSlide;
+			cMatrixf mtxMoved = pArmRoot.GetWorldMatrix();
+			mtxMoved.SetTranslation(pArmRoot.GetWorldPosition() + vSlide);
+			pArmRoot.SetWorldMatrix(mtxMoved);
+			
+			vShoulder = vShoulder + vSlide;
+			vElbow = vElbow + vSlide;
+			vWrist = vWrist + vSlide;
+			fReach = fLongest;
+		}
+		if(abLeft)	cScript_SetGlobalVarVector3f("BunkerVR_ReachShortLeft", vShortBy);
+		else		cScript_SetGlobalVarVector3f("BunkerVR_ReachShortRight", vShortBy);
+		// Nor is the hand let nearer the shoulder than a third of the arm's
+		// length: with the gun held up to the face the arm would fold right
+		// up, elbow and upper arm in front of the eyes. The
+		// shoulder backs away from the hand instead, the other way from the
+		// slide above, so the elbow stays gently bent and out of the way.
+		float fNearest = (fUpper + fFore) * gfVRArmNearest;
+		if(fDist < fNearest)
+		{
+			cVector3f vSlide = vDir * (fDist - fNearest);
+			cMatrixf mtxMoved = pArmRoot.GetWorldMatrix();
+			mtxMoved.SetTranslation(pArmRoot.GetWorldPosition() + vSlide);
+			pArmRoot.SetWorldMatrix(mtxMoved);
+
+			vShoulder = vShoulder + vSlide;
+			vElbow = vElbow + vSlide;
+			vWrist = vWrist + vSlide;
+			fReach = fNearest;
+		}
+		float fShortest = cMath_Abs(fUpper - fFore) + 0.01f;
+		if(fReach < fShortest) fReach = fShortest; // nor can it fold completely flat
+		
+		// The elbow goes on the side that points down, a little outwards and back.
+		cMatrixf mtxBody = mBaseObj.GetMatrix();
+		cVector3f vOut = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxBody, cVector3f(fSide, 0.0f, 0.0f)));
+		cVector3f vBack = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxBody, cVector3f(0.0f, 0.0f, -1.0f)));
+		cVector3f vElbowSide = cVector3f(0.0f, -1.0f, 0.0f) + vOut * 0.45f + vBack * 0.5f;
+		
+		// From there it moves with the hand, the way a real elbow does. Where
+		// the real elbow is cannot be known (only the hands and head are
+		// tracked), so this is a guess from four things:
+		if(mfVRElbowMove > 0.001f)
+		{
+			cVector3f vUp = cVector3f(0.0f, 1.0f, 0.0f);
+			float fArm = fUpper + fFore;
+			
+			// 1. How the wrist is rolled. Palm down (the back of the hand
+			//    facing up): the elbow swings out and up. Palm up: it tucks in.
+			float fBackUp = cMath_Vector3Dot(vHandBackWanted, vUp);
+			cVector3f vMove = vOut * (fBackUp * 1.3f) + vUp * (cMath_Max(fBackUp, 0.0f) * 0.7f);
+			
+			// 2. How high the hand is. Above the shoulder: the elbow lifts out
+			//    to the side. Low: it sits a little further back.
+			float fHigh = cMath_Clamp((vTarget.y - vShoulder.y) / fArm, -1.0f, 1.0f);
+			if(fHigh > 0.0f)	vMove = vMove + vOut * (fHigh * 1.2f) + vUp * (fHigh * 0.9f);
+			else				vMove = vMove + vBack * (fHigh * -0.3f);
+			
+			// 3. How close the hand is to the shoulder. Close (hand at the
+			//    chest): the elbow goes back beside the ribs, not out sideways.
+			float fClose = cMath_Clamp(1.0f - fDist / (fArm * 0.6f), 0.0f, 1.0f);
+			vMove = vMove + vBack * (fClose * 0.8f);
+			
+			// 4. Reaching across the body: the elbow lifts outwards.
+			float fAcross = cMath_Clamp(cMath_Vector3Dot(vTarget - vShoulder, vOut) / fArm, -1.0f, 0.0f) * -1.0f;
+			vMove = vMove + vOut * (fAcross * 0.9f) + vUp * (fAcross * 0.3f);
+			
+			
+			// 5. The two hands held together in front: both
+			//    elbows spread outwards and lift a little, as they do when a
+			//    real pair of hands meets. Counted from 35 cm apart.
+			if(mlVRPalmsNow == 3)
+			{
+				float fHandsApart = (m_mtxVRPalmLeft.GetTranslation() - m_mtxVRPalmRight.GetTranslation()).Length();
+				float fTogether = cMath_Clamp(1.0f - fHandsApart / (0.35f * cMath_Max(fArm / 0.45f, 0.5f)), 0.0f, 1.0f);
+				vMove = vMove + vOut * (fTogether * 1.1f) + vUp * (fTogether * 0.25f);
+			}
+			vElbowSide = vElbowSide + vMove * mfVRElbowMove;
+		}
+		
+		vElbowSide = vElbowSide - vDir * cMath_Vector3Dot(vElbowSide, vDir);
+		if(vElbowSide.Length() < 0.001f) vElbowSide = vOut - vDir * cMath_Vector3Dot(vOut, vDir);
+		vElbowSide.Normalize();
+		
+		// The left hand on the shotgun's pump: the hand is fixed on the fore-end as its grip
+		// has it (VRLeftOnPump), so the elbow the rules above guess would leave the wrist bent
+		// as it came. The grip is made for a forearm coming from behind, below and left of the
+		// fore-end, as a shooter's does: the elbow goes to that line (gfVRPumpElbowNatural),
+		// and a little of the way (gfVRPumpElbowStraight) to where the forearm runs straight
+		// on from the hand, along its fingers' line back, so the wrist bends a little as a
+		// real one on a pump does. (Most of the way to the straight line puts the elbow out
+		// to the side, about level with the hand, and wrings the forearm round to meet a palm
+		// turned up under the gun.)
+		if(abLeft && mbVRShotgunInHand && mbVRLeftOnGun)
+		{
+			cVector3f vStraight = (vShoulder + vDir * fReach - vFingersWanted * fFore) - vShoulder;
+			vStraight = vStraight - vDir * cMath_Vector3Dot(vStraight, vDir);
+			cVector3f vGripX = cMath_Vector3Cross(mvVRPumpGripY, mvVRPumpGripZ);
+			cVector3f vFromHand = cMath_MatrixMul3x3(a_mtxPalm, vGripX * gvVRPumpForearmFrom.x + mvVRPumpGripY * gvVRPumpForearmFrom.y + mvVRPumpGripZ * gvVRPumpForearmFrom.z);
+			cVector3f vNatural = (vShoulder + vDir * fReach + cMath_Vector3Normalize(vFromHand) * fFore) - vShoulder;
+			vNatural = vNatural - vDir * cMath_Vector3Dot(vNatural, vDir);
+			if(vStraight.Length() > 0.02f && vNatural.Length() > 0.02f)
+			{
+				vStraight.Normalize();
+				vNatural.Normalize();
+				cVector3f vBlend = vElbowSide * (1.0f - gfVRPumpElbowStraight - gfVRPumpElbowNatural) + vStraight * gfVRPumpElbowStraight + vNatural * gfVRPumpElbowNatural;
+				if(vBlend.Length() > 0.05f)
+				{
+					vBlend.Normalize();
+					vElbowSide = vBlend;
+				}
+			}
+		}
+		
+		// The elbow glides to its new side over a few frames, so that it never
+		// snaps from one place to another.
+		if(mfVRElbowMove > 0.001f)
+		{
+			int lArm = abLeft ? 0 : 1;
+			// (Kept in the body's own directions: kept as a direction in the
+			// world, the elbows would stay behind whenever the body turned and
+			// swing round after it.)
+			cVector3f vUpward = cVector3f(0.0f, 1.0f, 0.0f);
+			cVector3f vSideBefore = vOut * mvVRElbowSide[lArm].x + vUpward * mvVRElbowSide[lArm].y + vBack * mvVRElbowSide[lArm].z;
+			if(vSideBefore.Length() > 0.5f)
+			{
+				cVector3f vGlide = vSideBefore + (vElbowSide - vSideBefore) * 0.10f; // (a tenth of the way per call)
+				vGlide = vGlide - vDir * cMath_Vector3Dot(vGlide, vDir);
+				if(vGlide.Length() > 0.05f)
+				{
+					vGlide.Normalize();
+					vElbowSide = vGlide;
+				}
+			}
+			mvVRElbowSide[lArm] = cVector3f(cMath_Vector3Dot(vElbowSide, vOut), vElbowSide.y, cMath_Vector3Dot(vElbowSide, vBack));
+		}
+		
+		float fAlong = (fUpper * fUpper - fFore * fFore + fReach * fReach) / (2.0f * fReach);
+		float fAside = cMath_Sqrt(cMath_Max(fUpper * fUpper - fAlong * fAlong, 0.0f));
+		cVector3f vElbowWanted = vShoulder + vDir * fAlong + vElbowSide * fAside;
+		cVector3f vWristWanted = vShoulder + vDir * fReach;
+		
+		// Upper arm: swing the elbow to its new place. (The wrist swings along.)
+		// It is also turned about its own length so that the elbow bends the
+		// way it bends in the arm's own pose, like a hinge: the line square to
+		// both the upper arm and the forearm is brought onto the same line of
+		// the bent arm. (With only the shortest swing from wherever the
+		// animation has it, how far it is rolled would depend on that pose:
+		// the elbow would bend sideways or the wrong way round at times, and
+		// twist about whenever the pose changed.)
+		VRTimeMark(7107);
+		VRTimeMark(7108); // (timing: the upper arm and forearm, to 7109)
+		cMatrixf mtxUpperTurn = VRTurnBetween(vElbow - vShoulder, vElbowWanted - vShoulder, vElbowSide);
+		{
+			cVector3f vHingeWas = cMath_Vector3Cross(vElbow - vShoulder, vWrist - vElbow);
+			cVector3f vHingeWanted = cMath_Vector3Cross(vElbowWanted - vShoulder, vWristWanted - vElbowWanted);
+			// (Only with a bend to go by: a near-straight arm has no clear hinge.)
+			float fBendWas = vHingeWas.Length() / cMath_Max((vElbow - vShoulder).Length() * (vWrist - vElbow).Length(), 0.000001f);
+			float fBendWanted = vHingeWanted.Length() / cMath_Max(fUpper * fFore, 0.000001f);
+			if(fBendWas > 0.1f && fBendWanted > 0.05f)
+				mtxUpperTurn = VRTurnFrame(vElbow - vShoulder, vHingeWas, vElbowWanted - vShoulder, vHingeWanted);
+		}
+		VRTurnBoneAbout(pShoulder, mtxUpperTurn, vShoulder);
+
+		// The upper arm drawn out (or back to its own length, if it still is
+		// from the last time round): the bone halfway along it moves out by
+		// its share, and the elbow goes to its place.
+		// (Arm_2, and Arm_4 to Arm_6 below: the arm's bones 4, and 6 to 8, in VRArmBone.)
+		{
+			cVector3f vUpperDir = cMath_Vector3Normalize(vElbowWanted - vShoulder);
+			float fUpperBones = (pElbow.GetWorldPosition() - vShoulder).Length();
+			if(fUpperBones > 0.001f && cMath_Abs(fUpperBones - fUpper) > 0.0005f)
+			{
+				cBoneState@ pMiddle = VRArmBone(apMesh, abLeft, 4);
+				if(pMiddle !is null)
+				{
+					cVector3f vMiddle = pMiddle.GetWorldPosition();
+					float fMiddleAlong = cMath_Vector3Dot(vMiddle - vShoulder, vUpperDir);
+					VRMoveBoneTo(pMiddle, vMiddle + vUpperDir * (fMiddleAlong * (fUpper / fUpperBones - 1.0f)));
+				}
+				VRMoveBoneTo(pElbow, vElbowWanted);
+			}
+		}
+		cVector3f vWristSwung = pWrist.GetWorldPosition();
+
+		if(bNote)
+		{
+			VRNote(lNote + 10, vElbowWanted);
+			VRNote(lNote + 11, pElbow.GetWorldPosition());	// should equal the line above
+			VRNote(lNote + 12, vWristSwung);
+			VRNote(lNote + 13, pWrist.GetWorldPosition());	// should equal the line above
+		}
+		
+		// Forearm: swing the wrist to its new place.
+		VRTurnBoneAbout(pElbow, VRTurnBetween(vWristSwung - vElbowWanted, vWristWanted - vElbowWanted, vElbowSide), vElbowWanted);
+
+		// The forearm drawn out the same way: its three bones each move out
+		// by their share (the hand goes to its place further down).
+		{
+			cVector3f vForeDir = cMath_Vector3Normalize(vWristWanted - vElbowWanted);
+			float fForeBones = (pWrist.GetWorldPosition() - vElbowWanted).Length();
+			if(fForeBones > 0.001f && cMath_Abs(fForeBones - fFore) > 0.0005f)
+			{
+				float fMoreBy = fFore / fForeBones - 1.0f;
+				array<cVector3f> vGoTo(3);
+				array<bool> vHave(3);
+				for(int lAlong = 0; lAlong < 3; ++lAlong)
+				{
+					cBoneState@ pAlong = VRArmBone(apMesh, abLeft, 6 + lAlong);
+					vHave[lAlong] = pAlong !is null;
+					if(pAlong is null) continue;
+					cVector3f vAlong = pAlong.GetWorldPosition();
+					vGoTo[lAlong] = vAlong + vForeDir * (cMath_Vector3Dot(vAlong - vElbowWanted, vForeDir) * fMoreBy);
+				}
+				// (In order from the elbow: each carries the ones after it along.)
+				for(int lAlong = 0; lAlong < 3; ++lAlong)
+				{
+					if(vHave[lAlong] == false) continue;
+					VRMoveBoneTo(VRArmBone(apMesh, abLeft, 6 + lAlong), vGoTo[lAlong]);
+				}
+			}
+		}
+
+		VRTimeMark(7109);
+		VRTimeMark(7110); // (timing: the forearm's twist, to 7111)
+		/////////////////////////////
+		// The forearm twists with the wrist. The hand is about to be turned
+		// the way the real hand is; if only the hand bone turned, the sleeve
+		// would stay as it was and the wrist would look wrung like a cloth.
+		// The model has bones along the forearm for this
+		// (j_?_Arm_4, _5, _6): each is turned about the forearm's line by its
+		// share of the hand's twist, none at the elbow and all of it at the
+		// wrist.
+		{
+			cVector3f vForearm = cMath_Vector3Normalize(vWristWanted - vElbowWanted);
+			cMatrixf mtxCarried = pWrist.GetWorldMatrix(); // the hand as the arm has carried it here, not yet turned
+
+			// How far has the hand to be rolled about the forearm from that?
+			// Taken with whichever of the hand's two sideways directions
+			// (out of its back, towards the thumb) stands more square to the arm.
+			cVector3f vWas = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxCarried, cVector3f(0.0f, fSide, 0.0f)));
+			cVector3f vNow = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxHand, cVector3f(0.0f, fSide, 0.0f)));
+			if(cMath_Abs(cMath_Vector3Dot(vWas, vForearm)) > 0.8f || cMath_Abs(cMath_Vector3Dot(vNow, vForearm)) > 0.8f)
+			{
+				vWas = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxCarried, cVector3f(0.0f, 0.0f, fSide)));
+				vNow = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxHand, cVector3f(0.0f, 0.0f, fSide)));
+			}
+			cVector3f vFlatWas = vWas - vForearm * cMath_Vector3Dot(vWas, vForearm);
+			cVector3f vFlatNow = vNow - vForearm * cMath_Vector3Dot(vNow, vForearm);
+			int lTwistArm = abLeft ? 0 : 1;
+			float fTwist = mvVRTwistLast[lTwistArm];
+			if(vFlatWas.Length() > 0.3f && vFlatNow.Length() > 0.3f)
+			{
+				vFlatWas.Normalize();
+				vFlatNow.Normalize();
+				fTwist = cMath_ATan2(cMath_Vector3Dot(cMath_Vector3Cross(vFlatWas, vFlatNow), vForearm), cMath_Vector3Dot(vFlatWas, vFlatNow));
+
+				// Kept on the same side of a half turn as last frame (a wrist
+				// does not go right round), and never quite a half turn.
+				if(fTwist - mvVRTwistLast[lTwistArm] > cMath_Pi) fTwist -= cMath_PiMul2;
+				if(fTwist - mvVRTwistLast[lTwistArm] < -cMath_Pi) fTwist += cMath_PiMul2;
+				fTwist = cMath_Clamp(fTwist, -2.2f, 2.2f);
+			}
+			mvVRTwistLast[lTwistArm] = fTwist;
+
+			if(vFlatWas.Length() > 0.3f)
+			{
+				tString sArmSide = abLeft ? "j_L_Arm_" : "j_R_Arm_";
+				tString sBefore = "";
+				float fPassedOn = 0.0f; // how much twist the bone before has already handed down to this one
+				for(int lTwistBone = 4; lTwistBone <= 6; ++lTwistBone)
+				{
+					tString sTwistBone = sArmSide + lTwistBone;
+					cBoneState@ pTwistBone = VRArmBone(apMesh, abLeft, lTwistBone + 2);
+					if(pTwistBone is null) continue;
+
+					cVector3f vBonePos = pTwistBone.GetWorldPosition();
+					float fShare = cMath_Clamp(cMath_Vector3Dot(vBonePos - vElbowWanted, vForearm) / fFore, 0.0f, 0.8f) * fTwist;
+
+					// A bone that hangs off the twist bone before it has
+					// been turned with it already.
+					cNode3D@ pTwistParent = pTwistBone.GetParent();
+					bool bHangsOffLast = sBefore != "" && pTwistParent !is null && pTwistParent.GetName() == sBefore;
+					float fTurnBy = bHangsOffLast ? fShare - fPassedOn : fShare;
+					fPassedOn = fShare;
+					sBefore = sTwistBone;
+
+					if(cMath_Abs(fTurnBy) > 0.002f)
+					{
+						cVector3f vTurned = vFlatWas * cMath_Cos(fTurnBy) + cMath_Vector3Cross(vForearm, vFlatWas) * cMath_Sin(fTurnBy);
+						VRTurnBoneAbout(pTwistBone, VRTurnBetween(vFlatWas, vTurned, vForearm), vBonePos);
+					}
+				}
+			}
+			if(bNote) VRNote(lNote + 7, cVector3f(fTwist, 0.0f, 0.0f));
+		}
+		VRTimeMark(7111);
+		VRTimeMark(7112); // (timing: the hand and fingers, to 7113)
+
+		/////////////////////////////
+		// The hand itself.
+		mtxHand.SetTranslation(vWristWanted);
+		pWrist.SetWorldMatrix(mtxHand);
+		
+		/////////////////////////////
+		// The fingers close as the controller is squeezed.
+		// (Empty hands are posed finger by finger from the controller's sensors;
+		// a hand with a pose of its own from that pose.)
+		cVector3f vVRThumbSide = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxHand, cVector3f(0.0f, 0.0f, fSide)));
+		if(abOwnPose)
+			UpdateVRFingersFull(apMesh, abLeft, abLeft ? 0 : 1, vFingersWanted, vHandBackWanted * -1.0f, vVRThumbSide);
+		else if(alFingerMode == 1)
+			UpdateVRFingersPosed(apMesh, abLeft, avFingers, vFingersWanted, vHandBackWanted * -1.0f, vVRThumbSide);
+		else
+			UpdateVRFingers(apMesh, abLeft, alFingerMode == 2 ? 0.0f : afCurl, vFingersWanted, vHandBackWanted * -1.0f, vVRThumbSide);
+		VRNoteIndexTip(apMesh, abLeft); // (for the number locks' rollers)
+		int lVRTagHand = VRTagHand();
+		if(lVRTagHand == (abLeft ? 0 : 1)) VRNoteTagPinch(apMesh, abLeft, a_mtxPalm); // (a dog tag pinched to read)
+		else if(lVRTagHand < 0) mbVRTagPinchLogged = false; // (the next hold is noted afresh)
+		VRTimeMark(7113);
+		
+		if(bNote)
+		{
+			VRNote(lNote + 20, vPalmPos);
+			VRNote(lNote + 21, vTarget);
+			VRNote(lNote + 22, vWristWanted);
+			VRNote(lNote + 23, pWrist.GetWorldPosition());	// should equal the line above
+			VRNote(lNote + 24, pPalm.GetWorldPosition());	// should equal the palm (item 20) when within reach
+			VRNote(lNote + 25, pElbow.GetWorldPosition());	// should still equal item 10
+			VRNote(lNote + 26, pShoulder.GetWorldPosition());
+			VRNote(lNote + 27, cVector3f(fUpper, fFore, fDist));
+			VRNote(lNote + 28, cVector3f(afArmScale, float(mlVRArmCalls), 0.0f));
+			VRNote(lNote + 30, vCtrlX);
+			VRNote(lNote + 31, vCtrlY);
+			VRNote(lNote + 32, vCtrlZ);
+			VRNote(lNote + 33, vFingersWanted);
+			VRNote(lNote + 34, vHandBackWanted);
+			VRNote(lNote + 35, cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxHand, cVector3f(fSide, 0.0f, 0.0f))));	// should equal item 33
+			VRNote(lNote + 36, cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxHand, cVector3f(0.0f, fSide, 0.0f))));	// should equal item 34
+			VRNote(lNote + 37, cMath_Vector3Normalize(cMath_MatrixMul3x3(mBaseObj.GetMatrix(), cVector3f(0.0f, 0.0f, 1.0f))));	// the way the body faces
+			cMatrixf mtxWristNow = pWrist.GetWorldMatrix();
+			VRNote(lNote + 29, cVector3f(cMath_MatrixMul3x3(mtxWristNow, cVector3f(1.0f, 0.0f, 0.0f)).Length(),
+										 cMath_MatrixMul3x3(mtxWristNow, cVector3f(0.0f, 1.0f, 0.0f)).Length(),
+										 cMath_MatrixMul3x3(mtxWristNow, cVector3f(0.0f, 0.0f, 1.0f)).Length()));
+		}
+	}
+	
+	//------------------------------------------------------------
+	
=17
+
+	// BunkerVR: the name of the thing hung on the body at place alIndex (the
+	// global argument 0) of its list, or "" when there is none there (the
+	// gentle knockdowns hide them with the body: VRGentleHide in
+	// PlayerBodyHandler.hps).
+	void _Global_VRGetAttachedProp()
+	{
+		int lIndex = cScript_GetGlobalArgInt(0);
+		tString sName = "";
+		if(lIndex >= 0 && lIndex < int(mvSocketAttachments.length()))
+		{
+			iLuxEntity@ pProp = cLux_ID_Entity(mvSocketAttachments[lIndex].m_idEntity);
+			if(pProp !is null) sName = pProp.GetName();
+		}
+		cScript_SetGlobalReturnString(sName);
+	}
=214
+	/////////////////////////////////////////////
+	// BunkerVR: called by the body handler every frame, once the camera is in
+	// its place. Puts the arms on the VR controllers again, then moves the
+	// things held in the hands along with them.
+	void _Global_VRUpdateArms()
+	{
+		VRTimeMark(7072);
+		VRTimeMark(7090);
+		VRLadderLean(mBaseObj.GetMeshEntity()); // (on a ladder the upper body bent towards the real head, before the arms are put on the controllers)
+		UpdateVRArms();
+		VRSteadyGunHand(mBaseObj.GetMeshEntity(), 0.0f, false); // (as the first arm update of the frame held it)
+		VRTimeMark(7091);
+		VRTimeMark(7073);
+		VRTimeMark(7074);
+		UpdateVRLegs();
+		VRTimeMark(7075);
+		VRTimeMark(7102); // (timing: held things placed)
+		
+		for (uint i = 0; i < mvSocketAttachments.length(); i++)
+		{
+			tID idProp = mvSocketAttachments[i].m_idEntity;
+			iLuxEntity@ pAttachProp = cLux_ID_Entity(idProp);
+			
+			if (idProp == tID_Invalid)
+				continue;			
+			if (pAttachProp is null)
+				continue;
+			
+			bool bVRLoose = VRHeldIsLoose(idProp); // (taken off the socket by the mod: see VRHeldLetGo)
+			if (bVRLoose == false) pAttachProp.UpdateEntityAttachment();
+		
+			if (mvSocketAttachments[i].mbUseParentBoneRotation && bVRLoose == false)
+			{
+				cNode3D@ pSocket = mBaseObj.GetMeshEntity().GetSocket(mvSocketAttachments[i].msSocket);
+				cNode3D@ pParent = pSocket.GetParent();
+						
+				cMatrixf mtxParentRot = pParent.GetWorldMatrix().GetRotation();
+				mtxParentRot = cMath_MatrixMul(cMath_MatrixScale(100.f), mtxParentRot);
+						
+				cMatrixf mtxNew = pAttachProp.GetMatrix();
+				mtxNew.SetRotation(mtxParentRot);
+						
+				pAttachProp.SetMatrix(mtxNew);
+			}
+			VRPlaceHeldByGrip(pAttachProp, mvSocketAttachments[i].msSocket, mvSocketAttachments[i].mbUseParentBoneRotation); // (or where its own grip has it)
+		}
+		
+		VRUpdateLampString();
+		VRUpdateFlareInHand(); // (the flare in the right hand and its cord)
+		VRUpdateGunBullet();
+		VRMeasureGunBarrel();
+		VRUpdateBandage();
+		VRTimeMark(7103);
+	}
+	
+	//------------------------------------------------------------
+
+	/////////////////////////////////////////////
+	// BunkerVR: the bandage, drawn.
+	//
+	// The VR mod works out the healing move itself (the roll is pulled out of
+	// its tin, then wound round the left forearm; see UpdateGrabInput in the
+	// mod's vr.cpp) and says how far it has got (special roll value 7039:
+	// 0 = still in the tin, 1 = out and being wound, 2 = done). This code
+	// shows it:
+	//   - the part already wound lies along a coil round the forearm, from
+	//     where the hand first came to the arm to where the cloth leaves it,
+	//   - the part in the air runs straight from there to the roll,
+	//   - the roll sits in the right hand.
+	// Once the bandage has been used the coil stays on the arm.
+	//
+	// The cloth is made of short flat pieces, each an entity of its own (see
+	// VRBandageMakePieces), put in its place whole every frame, the way
+	// anything held in a hand is. The roll is the game's roll-and-strip model
+	// ("bandage_cutscene_roll.ent") lying as it was made, with only its roll
+	// drawn.
+	//
+	// (Don't bend that model's own strip by setting its 38 bones: the game
+	// puts a model's bones back to rest every update when no animation of
+	// its own is running on it, and what it then draws is neither the bones
+	// as set nor the rest shape.)
+	//
+	// "Along", "out" and "across" below: along the strip towards the roll,
+	// out of the cloth's outer face (the side the roll is on), across it.
+	
+	// The matrix that turns "X" to avX and "Y" to avY (which must be square to
+	// each other). Made of two shortest turns, by the helper the arms use.
+	cMatrixf VRFrameMatrix(const cVector3f &in avX, const cVector3f &in avY)
+	{
+		cMatrixf mtxFirst = VRTurnBetween(cVector3f(1.0f, 0.0f, 0.0f), avX, cVector3f(0.0f, 1.0f, 0.0f));
+		cVector3f vYNow = cMath_MatrixMul3x3(mtxFirst, cVector3f(0.0f, 1.0f, 0.0f));
+		cMatrixf mtxSecond = VRTurnBetween(vYNow, avY, avX);
+		return cMath_MatrixMul(mtxSecond, mtxFirst);
+	}
+
+	// avA with whatever it has of direction avB removed, made one long.
+	// Returns avFallback if nothing is left.
+	cVector3f VRSquareTo(const cVector3f &in avA, const cVector3f &in avB, const cVector3f &in avFallback)
+	{
+		cVector3f vOut = avA - avB * cMath_Vector3Dot(avA, avB);
+		float fLength = vOut.Length();
+		if(fLength < 0.05f) return avFallback;
+		return vOut * (1.0f / fLength);
+	}
+
+	// The roll's entity (the game's roll-and-strip model; only its roll is
+	// drawn). Made when first wanted (and again after a change of map, which
+	// takes it away).
+	iLuxEntity@ VRBandageRoll(bool abCreate)
+	{
+		iLuxEntity@ pRoll = m_idVRBandageRoll != tID_Invalid ? cLux_ID_Entity(m_idVRBandageRoll) : null;
+		if(pRoll !is null || abCreate == false) return pRoll;
+
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		if(pMap is null) return null;
+		pMap.CreateEntity("vr_bandage_roll", "bandage_cutscene_roll.ent", cMatrixf_Identity, cVector3f(1.0f));
+		@pRoll = pMap.GetLatestEntity();
+		if(pRoll is null) return null;
+		m_idVRBandageRoll = pRoll.GetID();
+		pRoll.StopAllAnimations(0.0f);
+		return pRoll;
+	}
+
+	// The cloth's pieces. Each is an entity of its own: the mod's own flat
+	// square of the game's bandage cloth ("bunkervr_bandage_piece.ent" in
+	// entities\bunkervr: 1 by 1, length along its X, width along its Z,
+	// facing its Y, drawn from both sides, showing 3 cm of the cloth the
+	// game's bandage roll is made of). Should the game not be able to load
+	// that, its own long strip of bandage is used instead ("bandage_strip.ent",
+	// 2 m by 12.5 cm; squeezed short it looks streaky). Made when first
+	// wanted, and again after a change of map.
+	void VRBandageMakePieces()
+	{
+		if(int(mvVRBandagePieces.length()) == glVRBandagePieces && cLux_ID_Entity(mvVRBandagePieces[0]) !is null) return;
+
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		if(pMap is null) return;
+		mvVRBandagePieces.resize(0);
+		mbVRBandageOwnPieces = true;
+		for(int i = 0; i < glVRBandagePieces; ++i)
+		{
+			iLuxEntity@ pPiece = null;
+			if(mbVRBandageOwnPieces)
+			{
+				pMap.ResetLatestEntity();
+				pMap.CreateEntity("vr_bandage_piece_" + i, "bunkervr_bandage_piece.ent", cMatrixf_Identity, cVector3f(1.0f));
+				@pPiece = pMap.GetLatestEntity();
+				if(pPiece is null || pPiece.GetMeshEntity() is null)
+				{
+					// (Only the first can fail: then all of them are the game's strip.)
+					if(pPiece !is null) pMap.DestroyEntity(pPiece);
+					@pPiece = null;
+					mbVRBandageOwnPieces = false;
+				}
+			}
+			if(mbVRBandageOwnPieces == false)
+			{
+				pMap.ResetLatestEntity();
+				pMap.CreateEntity("vr_bandage_piece_" + i, "bandage_strip.ent", cMatrixf_Identity, cVector3f(1.0f));
+				@pPiece = pMap.GetLatestEntity();
+			}
+
+			tID idPiece = tID_Invalid;
+			if(pPiece !is null)
+			{
+				idPiece = pPiece.GetID();
+				cMeshEntity@ pPieceMesh = pPiece.GetMeshEntity();
+				if(pPieceMesh !is null) pPieceMesh.SetVisible(false);
+			}
+			mvVRBandagePieces.push_back(idPiece);
+		}
+	}
+
+	// Puts one piece with its middle at avPos, its length along avAlong and
+	// its face towards avOut (square to each other), so long and so wide.
+	void VRBandagePlacePiece(int alPiece, const cVector3f &in avPos, const cVector3f &in avAlong, const cVector3f &in avOut, float afLength, float afWidth)
+	{
+		if(alPiece < 0 || alPiece >= int(mvVRBandagePieces.length())) return;
+		iLuxEntity@ pPiece = mvVRBandagePieces[alPiece] != tID_Invalid ? cLux_ID_Entity(mvVRBandagePieces[alPiece]) : null;
+		if(pPiece is null) return;
+
+		cMatrixf mtxPiece = VRFrameMatrix(avAlong, avOut);
+		mtxPiece.SetTranslation(avPos);
+		// (Both kinds of piece are 2 m long and 12.5 cm wide as made.)
+		pPiece.SetMeshScaleMul(cVector3f(afLength / 2.0f, 1.0f, afWidth / 0.125f));
+		pPiece.SetMatrix(mtxPiece);
+
+		cMeshEntity@ pPieceMesh = pPiece.GetMeshEntity();
+		if(pPieceMesh !is null && pPieceMesh.IsVisible() == false) pPieceMesh.SetVisible(true);
+	}
+
+	// Pieces from number alFirst on are not in use: not drawn.
+	void VRBandageHidePieces(int alFirst)
+	{
+		for(int i = alFirst; i < int(mvVRBandagePieces.length()); ++i)
+		{
+			if(i < 0 || mvVRBandagePieces[i] == tID_Invalid) continue;
+			iLuxEntity@ pPiece = cLux_ID_Entity(mvVRBandagePieces[i]);
+			cMeshEntity@ pPieceMesh = pPiece !is null ? pPiece.GetMeshEntity() : null;
+			if(pPieceMesh !is null && pPieceMesh.IsVisible()) pPieceMesh.SetVisible(false);
+		}
+	}
+
+	// The roll has just been pulled out. Whatever the right hand holds (the
+	// bandage's tin, or the medkit) is hidden there, because the roll
+	// is in that hand now. If it is the tin, a second tin with its lid off is
+	// made for the left hand, which was holding it when the roll came out.
+	void VRBandageStartTin()
+	{
+		m_idVRBandageHidden = tID_Invalid;
+		m_idVRBandageTin = tID_Invalid;
+		bool bLeftBusy = false;
+		iLuxEntity@ pHeld = null;
+		for(uint i = 0; i < mvSocketAttachments.length(); i++)
+		{
+			tID idProp = mvSocketAttachments[i].m_idEntity;
+			if(idProp == tID_Invalid) continue;
+			iLuxEntity@ pProp = cLux_ID_Entity(idProp);
+			if(pProp is null) continue;
+			if(mvSocketAttachments[i].msSocket == "L_Hand") bLeftBusy = true;
+			if(mvSocketAttachments[i].msSocket == "R_Hand") @pHeld = pProp;
+		}
+		if(pHeld is null) return;
+		cMeshEntity@ pHeldMesh = pHeld.GetMeshEntity();
+		if(pHeldMesh is null) return;
+
+		bool bIsTin = pHeldMesh.GetBoneStateFromName("j_Tin_Lid") !is null;
+		cMatrixf mtxHeld = pHeldMesh.GetWorldMatrix();
+		pHeldMesh.SetVisible(false);
+		m_idVRBandageHidden = pHeld.GetID();
+
+		if(bIsTin == false || bLeftBusy || mlVRPalmsNow != 3) return;
+		cLuxMap@ pMap = cLux_GetCurrentMap();
+		if(pMap is null) return;
+
+		// Where the tin sits in the right hand, mirrored for the left hand
+		// (both palms are given with X to the player's right, so mirroring
+		// is a swap of the sign of X on both sides).
+		cMatrixf mtxMirror = cMath_MatrixScale(cVector3f(-1.0f, 1.0f, 1.0f));
+		cMatrixf mtxInRight = cMath_MatrixMul(cMath_MatrixInverse(m_mtxVRPalmRight), mtxHeld);
+		m_mtxVRBandageTinInLeft = cMath_MatrixMul(mtxMirror, cMath_MatrixMul(mtxInRight, mtxMirror));
+
+		pMap.CreateEntity("vr_bandage_tin", "bandage_cutscene_tin.ent", cMath_MatrixMul(m_mtxVRPalmLeft, m_mtxVRBandageTinInLeft), cVector3f(1.0f));
+		iLuxEntity@ pTin = pMap.GetLatestEntity();
+		if(pTin is null) return;
+		m_idVRBandageTin = pTin.GetID();
+		pTin.StopAllAnimations(0.0f);
+
+		// Its lid is off: shrunk to nothing.
+		cMeshEntity@ pTinMesh = pTin.GetMeshEntity();
+		cBoneState@ pLid = pTinMesh !is null ? pTinMesh.GetBoneStateFromName("j_Tin_Lid") : null;
+		if(pLid !is null)
+			pLid.SetMatrix(cMath_MatrixMul(pLid.GetLocalMatrix(), cMath_MatrixScale(cVector3f(0.001f))));
+	}
+
+	// The winding is over (used, or put away): the second tin goes, and the
+	// thing in the right hand is drawn again if it is still there.
+	void VRBandageEndTin(bool abShowHeld)
+	{
+		if(m_idVRBandageTin != tID_Invalid)
+		{
+			iLuxEntity@ pTin = cLux_ID_Entity(m_idVRBandageTin);
+			cLuxMap@ pMap = cLux_GetCurrentMap();
+			if(pTin !is null && pMap !is null) pMap.DestroyEntity(pTin);
+			m_idVRBandageTin = tID_Invalid;
+		}
+		if(m_idVRBandageHidden != tID_Invalid && abShowHeld)
+		{
+			iLuxEntity@ pHeld = cLux_ID_Entity(m_idVRBandageHidden);
+			cMeshEntity@ pHeldMesh = pHeld !is null ? pHeld.GetMeshEntity() : null;
+			if(pHeldMesh !is null) pHeldMesh.SetVisible(true);
+			m_idVRBandageHidden = tID_Invalid;
+		}
+	}
+
+	void VRUpdateBandage()
+	{
+		cMeshEntity@ pBody = mBaseObj.GetMeshEntity();
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		cCamera@ pCam = pPlayer !is null ? pPlayer.GetCamera() : null;
+		if(pBody is null || pCam is null) return;
+
+		/////////////////////////////
+		// What the mod says: how far the healing has got, how many times
+		// round it counts so far, and how thick the arm is taken to be
+		// (special roll value 7062; it can be changed in the mod's menu).
+		int lPhase = -1;
+		float fModTurns = 0.0f;
+		float fRadius = gfVRBandageRadius;
+		float fShiftA = 0.0f;
+		float fShiftB = 0.0f;
+		float fRealRoll = pCam.GetRoll();
+		pCam.SetRoll(7039.0f);
+		cVector3f vAnswer = pCam.GetMatrix().GetTranslation();
+		if(vAnswer.x > 12344.0f && vAnswer.x < 12346.0f)
+		{
+			lPhase = int(vAnswer.y + 0.5f);
+			fModTurns = vAnswer.z;
+			pCam.SetRoll(7062.0f);
+			cVector3f vSet = pCam.GetMatrix().GetTranslation();
+			if(vSet.x > 12344.0f && vSet.x < 12346.0f && vSet.y > 0.019f && vSet.y < 0.101f) fRadius = vSet.y;
+			// And how far the coil's middle is moved off the line of the arm's
+			// bones, two ways across the arm (7063): the sleeve does not hang
+			// evenly round that line.
+			pCam.SetRoll(7063.0f);
+			cVector3f vShiftSet = pCam.GetMatrix().GetTranslation();
+			if(vShiftSet.x > 12344.0f && vShiftSet.x < 12346.0f && cMath_Abs(vShiftSet.y) < 0.081f && cMath_Abs(vShiftSet.z) < 0.081f)
+			{
+				fShiftA = vShiftSet.y;
+				fShiftB = vShiftSet.z;
+			}
+		}
+		pCam.SetRoll(fRealRoll);
+
+		/////////////////////////////
+		// Starting and stopping.
+		bool bWinding = lPhase == 1;
+		if(bWinding && mbVRBandageWinding == false)
+		{
+			// Just pulled out of the tin: start afresh.
+			mbVRBandageWinding = true;
+			mbVRBandageOn = false;
+			mbVRBandageAnchored = false;
+			mbVRBandageHadAngle = false;
+			mfVRBandageTurned = 0.0f;
+			mfVRBandageWound = 0.0f;
+			VRBandageStartTin();
+		}
+		else if(bWinding == false && mbVRBandageWinding)
+		{
+			mbVRBandageWinding = false;
+			VRBandageEndTin(lPhase != 2); // (used: the game is taking the thing in the right hand away, so it is not shown again)
+
+			// Used (the mod says "done"): it stays on the arm as it was wound,
+			// with the end tucked a little further round. Put away or
+			// dropped half-way: it goes.
+			mbVRBandageOn = lPhase == 2 && mbVRBandageAnchored;
+			if(mbVRBandageOn) mfVRBandageWound = cMath_Abs(mfVRBandageTurned) + 0.6f;
+		}
+
+		// Should the game not have taken the thing in the right hand after all
+		// (it does not use a bandage on a healthy man), it is drawn again.
+		if(mbVRBandageWinding == false && lPhase != 2 && m_idVRBandageHidden != tID_Invalid) VRBandageEndTin(true);
+
+		// The mod's count going back means it has started the winding again
+		// (the hand was away from the arm for too long).
+		if(bWinding && fModTurns < mfVRBandageModTurns - 0.25f)
+		{
+			mbVRBandageAnchored = false;
+			mbVRBandageHadAngle = false;
+			mfVRBandageTurned = 0.0f;
+			mfVRBandageWound = 0.0f;
+		}
+		mfVRBandageModTurns = fModTurns;
+
+		iLuxEntity@ pRoll = VRBandageRoll(mbVRBandageWinding || mbVRBandageOn);
+		if(pRoll is null) return;
+		cMeshEntity@ pMesh = pRoll.GetMeshEntity();
+		if(pMesh is null) return;
+		if(mbVRBandageWinding == false && mbVRBandageOn == false)
+		{
+			if(pMesh.IsVisible()) pMesh.SetVisible(false);
+			VRBandageHidePieces(0);
+			return;
+		}
+
+		/////////////////////////////
+		// The left forearm: from the wrist towards the elbow, and two
+		// directions across it to measure angles round it by. They turn
+		// with the forearm, so what is wound on it stays put on it.
+		cBoneState@ pElbow = pBody.GetBoneStateFromName("j_L_Arm_3");
+		cBoneState@ pWrist = pBody.GetBoneStateFromName("j_L_Wrist");
+		cBoneState@ pPalm = pBody.GetBoneStateFromName("j_R_HandSocket");
+		if(pElbow is null || pWrist is null || pPalm is null) return;
+
+		cVector3f vWrist = pWrist.GetWorldPosition();
+		cVector3f vAxis = pElbow.GetWorldPosition() - vWrist;
+		float fForearm = vAxis.Length();
+		if(fForearm < 0.05f) return;
+		vAxis = vAxis * (1.0f / fForearm);
+
+		// (Taken from the bone half-way along the forearm, which twists
+		// with the wrist by half: so the wrap turns with the sleeve under it.)
+		cBoneState@ pTurnsWith = pBody.GetBoneStateFromName("j_L_Arm_5");
+		if(pTurnsWith is null) @pTurnsWith = pElbow;
+		cVector3f vAcross = cMath_Vector3Normalize(cMath_MatrixMul3x3(pTurnsWith.GetWorldMatrix(), cVector3f(0.0f, 1.0f, 0.0f)));
+		if(cMath_Abs(cMath_Vector3Dot(vAcross, vAxis)) > 0.9f)
+			vAcross = cMath_Vector3Normalize(cMath_MatrixMul3x3(pTurnsWith.GetWorldMatrix(), cVector3f(0.0f, 0.0f, 1.0f)));
+		cVector3f vU = VRSquareTo(vAcross, vAxis, cVector3f(0.0f, 1.0f, 0.0f));
+		cVector3f vV = cMath_Vector3Cross(vAxis, vU);
+
+		// Everything is as much bigger as the body is drawn bigger.
+		float fBig = cMath_MatrixMul3x3(mBaseObj.GetMatrix(), cVector3f(1.0f, 0.0f, 0.0f)).Length();
+		if(fBig < 0.3f || fBig > 3.0f) fBig = 1.0f;
+		float fArm = (fRadius + 0.006f) * fBig;					// the coil's radius: the arm's, and a little air
+		cVector3f vArmLine = vWrist + (vU * fShiftA + vV * fShiftB) * fBig;	// the coil's middle line starts here (the wrist, moved across as set)
+		float fRise = gfVRBandagePitch * fBig / cMath_PiMul2;	// towards the elbow, per radian wound
+		float fGrow = 0.0015f * fBig / cMath_PiMul2;			// each turn lies a little outside the last
+		float fPerRadian = cMath_Sqrt(fArm * fArm + fRise * fRise);	// length of strip per radian wound
+
+		/////////////////////////////
+		// While winding: follow the right hand round the arm.
+		cVector3f vHand = pPalm.GetWorldPosition();
+		float fHandDist = 1.0f;
+		if(mbVRBandageWinding)
+		{
+			cVector3f vRel = vHand - vArmLine;
+			float fAlong = cMath_Vector3Dot(vRel, vAxis);
+			cVector3f vOut = vRel - vAxis * fAlong;
+			fHandDist = vOut.Length();
+			float fX = cMath_Vector3Dot(vOut, vU);
+			float fY = cMath_Vector3Dot(vOut, vV);
+			float fAngle = cMath_ATan2(fY, fX);
+			// (Should the math library take those two the other way round.)
+			if(cMath_Abs(cMath_Cos(fAngle) * fHandDist - fX) + cMath_Abs(cMath_Sin(fAngle) * fHandDist - fY) > 0.2f * fHandDist)
+				fAngle = cMath_ATan2(fX, fY);
+
+			// The cloth's end is laid on the arm only when the hand comes close
+			// (within 16 cm of the arm's middle line; 30 feels too far off);
+			// once it is on, the hand may be out to 30 cm.
+			float fAtArmReach = mbVRBandageAnchored ? 0.30f : 0.16f;
+			bool bAtArm = fAlong > -0.08f * fBig && fAlong < fForearm + 0.05f * fBig && fHandDist > 0.02f * fBig && fHandDist < fAtArmReach * fBig;
+			if(bAtArm)
+			{
+				if(mbVRBandageAnchored == false)
+				{
+					// The hand has come to the arm: the end of the strip is
+					// laid on the arm there.
+					mbVRBandageAnchored = true;
+					mfVRBandageStartAngle = fAngle;
+					mfVRBandageStartAlong = cMath_Clamp(fAlong, 0.04f * fBig, fForearm * 0.5f) / fBig;
+					mfVRBandageTurned = 0.0f;
+				}
+				else if(mbVRBandageHadAngle)
+				{
+					float fStep = fAngle - mfVRBandageLastAngle;
+					if(fStep > cMath_Pi) fStep -= cMath_PiMul2;
+					if(fStep < -cMath_Pi) fStep += cMath_PiMul2;
+					if(cMath_Abs(fStep) < 1.2f) mfVRBandageTurned += fStep; // a bigger jump is a tracking slip
+				}
+				mfVRBandageLastAngle = fAngle;
+				mbVRBandageHadAngle = true;
+
+				// The strip leaves the arm where a straight line from the hand
+				// just touches it: that is behind the hand by an angle that
+				// grows with the hand's distance.
+				float fBehind = fHandDist > fArm ? cMath_ACos(fArm / fHandDist) : 0.0f;
+				mfVRBandageWound = cMath_Max(0.0f, cMath_Abs(mfVRBandageTurned) - fBehind);
+				mfVRBandageWay = mfVRBandageTurned < 0.0f ? -1.0f : 1.0f;
+			}
+			else
+			{
+				mbVRBandageHadAngle = false;
+			}
+		}
+
+		/////////////////////////////
+		// Where the wound part ends, and how the strip lies there.
+		float fWound = mbVRBandageAnchored ? mfVRBandageWound : 0.0f;
+		float fWay = mfVRBandageWay;
+		float fEndAngle = mfVRBandageStartAngle + fWay * fWound;
+		float fEndRadius = fArm + fGrow * fWound;
+		cVector3f vEndOut = vU * cMath_Cos(fEndAngle) + vV * cMath_Sin(fEndAngle);
+		cVector3f vEndPos = vArmLine + vAxis * (mfVRBandageStartAlong * fBig + fRise * fWound) + vEndOut * fEndRadius;
+		cVector3f vEndAhead = cMath_Vector3Normalize((vV * cMath_Cos(fEndAngle) - vU * cMath_Sin(fEndAngle)) * (fWay * fEndRadius) + vAxis * fRise);
+
+		/////////////////////////////
+		// The roll (only while winding): held in the right hand as the tin
+		// was, its length along the hand's thumb-up direction, so that it
+		// turns with the hand. It is the game's roll-and-strip model as it
+		// lies at rest, with its strip not drawn, put whole so that the roll's
+		// middle is in the hand.
+		cVector3f vEndAcross = cMath_Vector3Cross(vEndAhead, vEndOut); // across the cloth, where it leaves the arm
+		cVector3f vRollAxis = cMath_Vector3Normalize(cMath_MatrixMul3x3(pPalm.GetWorldMatrix(), cVector3f(0.0f, 1.0f, 0.0f)));
+		cVector3f vRollAlong = cMath_MatrixMul3x3(pPalm.GetWorldMatrix(), cVector3f(1.0f, 0.0f, 0.0f));
+		if(mlVRPalmsNow == 2 || mlVRPalmsNow == 3)
+		{
+			vRollAxis = cMath_Vector3Normalize(cMath_MatrixMul3x3(m_mtxVRPalmRight, cVector3f(0.0f, 1.0f, 0.0f)));
+			vRollAlong = cMath_MatrixMul3x3(m_mtxVRPalmRight, cVector3f(1.0f, 0.0f, 0.0f));
+		}
+		// (A roll is the same either way up: taken the way that twists the
+		// cloth least on its way from the arm.)
+		if(mbVRBandageAnchored && cMath_Vector3Dot(vRollAxis, vEndAcross) < 0.0f) vRollAxis = vRollAxis * -1.0f;
+
+		cVector3f vFreeDir = vEndAhead;
+		cVector3f vRollPos = vEndPos;	// where the strip meets the roll
+		float fFree = 0.0f;
+		float fRollOff = 0.036f * fBig;	// from the roll's middle to the side of it the strip comes off (the roll is 7.3 cm across)
+
+		cSubMeshEntity@ pStripPart = pMesh.GetSubMeshEntityName("m_bandage");
+		if(pStripPart !is null && pStripPart.IsVisible()) pStripPart.SetVisible(false);
+		if(mbVRBandageWinding)
+		{
+			// The model lies along its Z with its outer face towards Y: turned
+			// to "along the strip" and "out of the strip's outer face" (its X
+			// then lies along the roll's length, the other way to vRollAxis).
+			cVector3f vRollMiddle = cVector3f(-0.0030f, -0.00665f, 1.3264f) * fBig; // where the roll's middle is in the model
+			cVector3f vRollOut = cVector3f(0.0f, 1.0f, 0.0f);
+			cMatrixf mtxRoll = cMatrixf_Identity;
+			bool bRollOwn = mbVRBandageRollGrip && (mlVRPalmsNow == 2 || mlVRPalmsNow == 3);
+			if(bRollOwn)
+			{
+				// Where "winding the bandage" has the roll in the right hand
+				// (see VRAskPlacement): held still in the hand, the
+				// cloth coming to it.
+				mtxRoll = cMath_MatrixMul(m_mtxVRPalmRight, m_mtxVRBandageRollGrip);
+				vRollAlong = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxRoll, cVector3f(0.0f, 0.0f, 1.0f)));
+				vRollOut = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxRoll, cVector3f(0.0f, 1.0f, 0.0f)));
+				vRollAxis = cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxRoll, cVector3f(-1.0f, 0.0f, 0.0f)));
+				if(mbVRBandageAnchored && cMath_Vector3Dot(vRollAxis, vEndAcross) < 0.0f) vRollAxis = vRollAxis * -1.0f;
+				// The placement says where the roll's middle is, not where the
+				// model's own origin goes: that lies 1.33 m from the roll
+				// (1.49 m at the body's size), past the 30 cm a placement may
+				// go.
+				cVector3f vRollAt = mtxRoll.GetTranslation();
+				mtxRoll.SetTranslation(vRollAt - cMath_MatrixMul3x3(mtxRoll, vRollMiddle));
+				vRollPos = vRollAt - vRollOut * fRollOff;
+			}
+			else
+			{
+				// The strip comes to the roll from the arm.
+				if(mbVRBandageAnchored && (vHand - vEndPos).Length() > 0.01f) vRollAlong = vHand - vEndPos;
+				vRollAlong = VRSquareTo(vRollAlong, vRollAxis, VRSquareTo(cVector3f(0.0f, 1.0f, 0.0f), vRollAxis, cVector3f(1.0f, 0.0f, 0.0f)));
+				vRollOut = cMath_Vector3Cross(vRollAxis, vRollAlong);
+				vRollPos = vHand - vRollOut * fRollOff;
+				cMatrixf mtxFromModel = cMath_MatrixInverse(VRFrameMatrix(cVector3f(0.0f, 0.0f, 1.0f), cVector3f(0.0f, 1.0f, 0.0f)));
+				mtxRoll = cMath_MatrixMul(VRFrameMatrix(vRollAlong, vRollOut), mtxFromModel);
+				mtxRoll.SetTranslation(vHand - cMath_MatrixMul3x3(mtxRoll, vRollMiddle));
+
+				// Where it is, told to the mod while the hand poses tool is
+				// open, as for a held item, so that a placement of its own
+				// starts from there: its turn, and where its middle is (see
+				// the roll's own placement above).
+				if(mbVRBandageRollSend && (mlVRPalmsNow == 2 || mlVRPalmsNow == 3))
+				{
+					cMatrixf mtxPalmInverse = cMath_MatrixInverse(m_mtxVRPalmRight);
+					cMatrixf mtxInPalm = cMath_MatrixMul(mtxPalmInverse, mtxRoll);
+					mtxInPalm.SetTranslation(cMath_MatrixMul(mtxPalmInverse, vHand));
+					VRSendGripNews(7089, mtxInPalm.GetTranslation());
+					VRSendGripNews(7090, cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxInPalm, cVector3f(0.0f, 0.0f, 1.0f))));
+					VRSendGripNews(7091, cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxInPalm, cVector3f(0.0f, 1.0f, 0.0f))));
+				}
+			}
+			if(mbVRBandageAnchored)
+			{
+				cVector3f vTo = vRollPos - vEndPos;
+				fFree = vTo.Length();
+				if(fFree > 0.01f) vFreeDir = vTo * (1.0f / fFree);
+			}
+
+			if(pMesh.IsVisible() == false) pMesh.SetVisible(true);
+			pRoll.SetMeshScaleMul(cVector3f(fBig));
+			pRoll.SetMatrix(mtxRoll);
+		}
+		else if(pMesh.IsVisible())
+		{
+			pMesh.SetVisible(false);
+		}
+
+		/////////////////////////////
+		// The cloth: short flat pieces laid end to end, sixteen to a turn
+		// round the arm, then a run of them through the air to the roll,
+		// twisting on the way from how the cloth lies on the arm to how the
+		// roll is held.
+		VRBandageMakePieces();
+		int lUsed = 0;
+		float fWidth = 0.1f * gfVRBandageWidth * fBig;
+		if(mbVRBandageAnchored)
+		{
+			float fStep = cMath_PiMul2 / 16.0f;
+			for(int j = 0; lUsed < glVRBandagePieces - 17; ++j)
+			{
+				float fFrom = float(j) * fStep;
+				float fTo = cMath_Min(fFrom + fStep, fWound);
+				if(fTo - fFrom < 0.02f) break;
+				float fMid = (fFrom + fTo) * 0.5f;
+
+				cVector3f vOutA = vU * cMath_Cos(mfVRBandageStartAngle + fWay * fFrom) + vV * cMath_Sin(mfVRBandageStartAngle + fWay * fFrom);
+				cVector3f vOutB = vU * cMath_Cos(mfVRBandageStartAngle + fWay * fTo) + vV * cMath_Sin(mfVRBandageStartAngle + fWay * fTo);
+				cVector3f vOutMid = vU * cMath_Cos(mfVRBandageStartAngle + fWay * fMid) + vV * cMath_Sin(mfVRBandageStartAngle + fWay * fMid);
+				cVector3f vA = vArmLine + vAxis * (mfVRBandageStartAlong * fBig + fRise * fFrom) + vOutA * (fArm + fGrow * fFrom);
+				cVector3f vB = vArmLine + vAxis * (mfVRBandageStartAlong * fBig + fRise * fTo) + vOutB * (fArm + fGrow * fTo);
+
+				cVector3f vAlong = vB - vA;
+				float fLength = vAlong.Length();
+				if(fLength < 0.002f) break;
+				vAlong = vAlong * (1.0f / fLength);
+				// (Longer than the gap, so that the pieces overlap and no arm
+				// shows between them.)
+				VRBandagePlacePiece(lUsed, (vA + vB) * 0.5f, vAlong, VRSquareTo(vOutMid, vAlong, vOutMid), fLength * 1.4f, fWidth);
+				lUsed++;
+			}
+
+			if(mbVRBandageWinding && fFree > 0.01f)
+			{
+				int lFreePieces = int(fFree / (0.04f * fBig)) + 1;
+				if(lFreePieces > 16) lFreePieces = 16;
+				float fEach = fFree / float(lFreePieces);
+				for(int k = 0; k < lFreePieces && lUsed < glVRBandagePieces; ++k)
+				{
+					float fT = (float(k) + 0.5f) / float(lFreePieces);
+					cVector3f vAcross = VRSquareTo(vEndAcross * (1.0f - fT) + vRollAxis * fT, vFreeDir, vEndAcross);
+					VRBandagePlacePiece(lUsed, vEndPos + vFreeDir * (fEach * (float(k) + 0.5f)), vFreeDir, cMath_Vector3Cross(vAcross, vFreeDir), fEach * 1.1f, fWidth);
+					lUsed++;
+				}
+			}
+		}
+		VRBandageHidePieces(lUsed);
+
+		/////////////////////////////
+		// The second tin stays in the left hand: where "the bandage in the
+		// left hand" has its own placement (see VRAskPlacement),
+		// otherwise as the tin sat in the right hand, mirrored. Where it is
+		// then is told to the mod while the hand poses tool is open (as
+		// VRPlaceHeldByGrip does for a held item), so that a placement of its
+		// own starts from there.
+		if(m_idVRBandageTin != tID_Invalid && (mlVRPalmsNow == 1 || mlVRPalmsNow == 3))
+		{
+			iLuxEntity@ pTin = cLux_ID_Entity(m_idVRBandageTin);
+			cMatrixf mtxTinInPalm = mbVRBandageTinGrip ? m_mtxVRBandageTinGrip : m_mtxVRBandageTinInLeft;
+			if(pTin !is null) pTin.SetMatrix(cMath_MatrixMul(m_mtxVRPalmLeft, mtxTinInPalm));
+			if(pTin !is null && mbVRBandageTinGrip == false && mbVRBandageTinSend)
+			{
+				VRSendGripNews(7086, mtxTinInPalm.GetTranslation());
+				VRSendGripNews(7087, cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxTinInPalm, cVector3f(0.0f, 0.0f, 1.0f))));
+				VRSendGripNews(7088, cMath_Vector3Normalize(cMath_MatrixMul3x3(mtxTinInPalm, cVector3f(0.0f, 1.0f, 0.0f))));
+			}
+		}
+	}
+
+	//------------------------------------------------------------
+	
=65
+	[nosave] int mlVRArmCalls = 0;	// BunkerVR: how often the arms have been moved to the controllers
+	[nosave] bool mbVRArmNote = false;	// BunkerVR: send this frame's numbers to the mod's log?
+	[nosave] bool mbVRCarrying = false; // BunkerVR: was a person hung on the left hand at the last look (VRLeftHandCarriesPerson)
+	[nosave] cVector3f mvVRCarryPush = cVector3f(0.0f); // BunkerVR: how far the carried person is moved off the real eyes (VRKeepCarriedClear)
+	[nosave] bool mbVRCarryMoved = false;
+	[nosave] int mlVRCarryLogs = 0;
