+	[nosave] double mfVRLegFitUntil = 0.0;		// BunkerVR: the legs are fitted again until this game time (just after a re-center)
+	[nosave] double mfVRLastLanding = 0.0;		// BunkerVR: game time when a foot last came down
+	[nosave] bool mbVRFreshPose = false;	// BunkerVR: are the body's bones as the animation has just left them (nothing here has moved them yet)?
+	[nosave] bool mbVRBothHandsEmpty = false;	// BunkerVR: is nothing held in either hand this frame?
+	[nosave] int mlVRHandsEmptyFrames = 0;		// BunkerVR: for how many fresh updates in a row both hands have been empty...
+	[nosave] bool mbVRHandsSettled = false;		// ...more than glVRHandsSettleFrames: an item's own animation over
+	[nosave] int mlVRPalmRelearnNotes = 0;		// BunkerVR: "BunkerVR hands: ... learnt again" lines written
+	[nosave] bool mbVRStill = false;	// BunkerVR: has the player stood still (not walking, not turning) for a moment?
+	[nosave] int mlVRDoorStampSeen = 0;	// BunkerVR: the door grip's stamp last seen (see UpdateVRArms)
+	[nosave] int mlVRDoorStaleFrames = 0;	// BunkerVR: frames it has not changed for
+	[nosave] int mlVRFitStampSeen = 0;		// BunkerVR: the fitted hand's stamp last seen (VRFittedHand)...
+	[nosave] int mlVRFitStaleFrames = 0;	// ...and frames it has not changed for
