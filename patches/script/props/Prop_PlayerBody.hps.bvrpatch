+	// BunkerVR: a dogtag (or a code sign) held to be read is put back in the
+	// hand that holds it once the arms have been placed. Its reading state
+	// places it in its own update, from the palm as the mod saw it then, but
+	// the drawn hand is placed here, after the game has moved the player, so
+	// while walking the tag would trail an update behind the hand. The reading
+	// state says where in that palm it is held
+	// (PlayerState_Interact_ReadDogTag.hps VRSayHeldInPalm), and it is placed
+	// there from the palm as it is now. Stale after 0.25 s.
+	void VRUpdateReadHeld()
+	{
+		int lHand = cScript_GetGlobalVarInt("BunkerVR_ReadHeldHand") - 1;
+		if(lHand < 0 || lHand > 1) return;
+		if(cMath_Abs(float(cEngine_GetGameTime()) - cScript_GetGlobalVarFloat("BunkerVR_ReadHeldTime")) > 0.25f) return;
+		cLuxProp@ pHeld = cLux_ID_Prop(cScript_GetGlobalVarID("BunkerVR_ReadHeldProp"));
+		if(pHeld is null) return;
+		cMatrixf mtxPalm;
+		if(VRFollowedPalm(lHand, mtxPalm) == false) return;
+		cVector3f vY = cMath_MatrixMul3x3(mtxPalm, cScript_GetGlobalVarVector3f("BunkerVR_ReadHeldY"));
+		cVector3f vZ = cMath_MatrixMul3x3(mtxPalm, cScript_GetGlobalVarVector3f("BunkerVR_ReadHeldZ"));
+		if(vY.Length() < 0.5f || vZ.Length() < 0.5f) return;
+		vY.Normalize();
+		vZ.Normalize();
+		cMatrixf mtxHeld = cMath_MatrixUnitVectors(cMath_Vector3Cross(vY, vZ), vY, vZ, cVector3f(0.0f));
+		mtxHeld.SetTranslation(cMath_MatrixMul(mtxPalm, cScript_GetGlobalVarVector3f("BunkerVR_ReadHeldMiddle")));
+		// (The first few times this moves it more than 1 cm from where the
+		// reading state had it, the distance is logged.)
+		float fMoved = (mtxHeld.GetTranslation() - pHeld.GetMatrix().GetTranslation()).Length();
+		if(fMoved > 0.01f && mlVRReadHeldLogs < 5)
+		{
+			++mlVRReadHeldLogs;
+			Log("BunkerVR: the held " + pHeld.GetName() + " put in the hand again after the arms: " + int(fMoved * 1000.0f + 0.5f) + " mm on from where its reading state had it\n");
+		}
+		pHeld.SetMatrix(mtxHeld);
+	}
+
+	// BunkerVR: a palm the mod is following, moved as the drawn hand is when
+	// held back off a wall: the same as BunkerVR_ReadFollowedPalm
+	// (helper_bunkervr.hps, which this script doesn't include), the palm the
+	// reading state places from. False when it isn't followed.
+	bool VRFollowedPalm(int alHand, cMatrixf &out a_mtxPalm)
+	{
+		a_mtxPalm = cMatrixf_Identity;
+		cLuxPlayer@ pPlayer = cLux_GetPlayer();
+		cCamera@ pCam = pPlayer !is null ? pPlayer.GetCamera() : null;
+		if(pCam is null || alHand < 0 || alHand > 1) return false;
+		float fRealRoll = pCam.GetRoll();
+		pCam.SetRoll(7010.0f);
+		cVector3f vStatus = pCam.GetMatrix().GetTranslation();
+		bool bFollowed = false;
+		if(vStatus.x > 12344.0f && vStatus.x < 12346.0f)
+		{
+			int lPalms = int(vStatus.y + 0.5f) % 4; // (4 is added when the mod wants the arms' notes)
+			bFollowed = (lPalms & (alHand == 0 ? 1 : 2)) != 0;
+		}
+		if(bFollowed)
+		{
+			pCam.SetRoll(alHand == 0 ? 7011.0f : 7012.0f);
+			a_mtxPalm = pCam.GetMatrix();
+		}
+		pCam.SetRoll(fRealRoll);
+		if(bFollowed == false) return false;
+		cVector3f vBack = cScript_GetGlobalVarVector3f(alHand == 0 ? "BunkerVR_HandBack0" : "BunkerVR_HandBack1");
+		if(vBack.Length() < 0.6f) a_mtxPalm.SetTranslation(a_mtxPalm.GetTranslation() + vBack);
+		return true;
+	}
+	
+	// BunkerVR: while the left hand carries a bullet to the open revolver, the
+	// revolver's script holds its spare bullet between that hand's thumb and
+	// first finger (see VRUpdateRevolver in Prop_Gun.hps). Like the
+	// flashlight's string below, it has to do that again each time the arms
+	// have been placed, or the bullet would trail a frame behind the hand.
+	// The shotgun too, every update while it is in the hand: its carried
+	// shell, and a shell it has thrown out (VRUpdateShotgun in
+	// Prop_Shotgun.hps).
+	// The revolver's spent cases too, while they slide out and fall (BunkerVR_ShellsOut, set by
+	// VRUpdateShells in Prop_Gun.hps): placed in the world again once the gun has moved with the hand.
+	void VRUpdateGunBullet()
+	{
+		bool bShellsOut = cScript_GetGlobalVarInt("BunkerVR_ShellsOut") != 0;
+		if(mbVRBulletInHand == false && mbVRShotgunInHand == false && bShellsOut == false) return;
+
+		for (uint i = 0; i < mvSocketAttachments.length(); i++)
+		{
+			tID idProp = mvSocketAttachments[i].m_idEntity;
+			if (idProp == tID_Invalid) continue;
+			iLuxEntity@ pAttachProp = cLux_ID_Entity(idProp);
+			if (pAttachProp is null) continue;
+
+			cMeshEntity@ pPropMesh = pAttachProp.GetMeshEntity();
+			if (pPropMesh is null) continue;
+			// The shotgun has these two bones.
+			if (pPropMesh.GetBoneStateIndex("j_pump") >= 0 && pPropMesh.GetBoneStateIndex("j_shell_reload") >= 0)
+			{
+				cScript_RunGlobalFunc(pAttachProp.GetName(), "cScrPropShotgun", "_Global_VRPlaceShell");
+				continue;
+			}
+			if (mbVRBulletInHand == false && bShellsOut == false) continue;
+			
+			// Only the revolver has these two bones.
+			if (pPropMesh.GetBoneStateIndex("j_Bullet_006") < 0 || pPropMesh.GetBoneStateIndex("j_cylinder") < 0) continue;
+
+			cScript_RunGlobalFunc(pAttachProp.GetName(), "cScrPropGun", "_Global_VRPlaceBullet");
+		}
+	}
+
+	// BunkerVR: the flare in the right hand (see "the flare by hand" in
+	// PlayerState_UsingFlare.hps). Burning ("BunkerVR_FlareLit"): the burning
+	// flare is put where the flare in the hand is. Its cord held by the left
+	// hand ("BunkerVR_FlareCord": how far its cap is drawn out, in cm of the
+	// model; VRUpdateFlare in PlayerBodyHandler.hps): the cord's bones run out
+	// of the handle's end to the left thumb and first finger, with the cap
+	// between them; the part still inside stays along the handle, moved down
+	// by as much. Done after the arms and the things in the hands are placed
+	// (as the flashlight's string), so that it is where the hand is drawn this
+	// frame.
+	void VRUpdateFlareInHand()
+	{
+		tString sLit = cScript_GetGlobalVarString("BunkerVR_FlareLit");
+		float fCapOut = cScript_GetGlobalVarFloat("BunkerVR_FlareCord");
+		if(sLit == "" && fCapOut < -50.0f) return;
+		iLuxEntity@ pFlare = null;
+		for (uint i = 0; i < mvSocketAttachments.length() && pFlare is null; i++)
+		{
+			if(mvSocketAttachments[i].msSocket != "R_Hand") continue;
+			iLuxEntity@ pAttach = cLux_ID_Entity(mvSocketAttachments[i].m_idEntity);
+			cMeshEntity@ pAttachMesh = pAttach !is null ? pAttach.GetMeshEntity() : null;
+			if(pAttachMesh !is null && pAttachMesh.GetBoneStateIndex("j_plug") >= 0 && pAttachMesh.GetBoneStateIndex("j_string_00") >= 0) @pFlare = pAttach;
+		}
+		if(pFlare is null) return;
+		cMeshEntity@ pMesh = pFlare.GetMeshEntity();
+
+		if(sLit != "")
+		{
+			// (The hand's flare stays shown, and the burning flare's own model,
+			// the game's thrown flare, which is 28% bigger, is hidden while held,
+			// so the flare doesn't grow when lit. Its flame, light and smoke are
+			// placed with its burning end at the hand flare's:
+			// gfBunkerVR_FlareLitLift.)
+			if(pFlare.GetName() != cScript_GetGlobalVarString("BunkerVR_FlareLitHand")) return;
+			iLuxEntity@ pLit = cLux_GetCurrentMap().GetEntityByName(sLit);
+			if(pLit is null) return;
+			cMatrixf mtxLit = pFlare.GetMatrix();
+			mtxLit.SetTranslation(mtxLit.GetTranslation() + cMath_MatrixMul3x3(mtxLit, cVector3f(0.0f, gfBunkerVR_FlareLitLift, 0.0f)));
+			pLit.SetMatrix(mtxLit);
+			cMeshEntity@ pLitMesh = pLit.GetMeshEntity();
+			for (int i = 0; pLitMesh !is null && i < pLitMesh.GetSubMeshEntityNum(); ++i)
+			{
+				cSubMeshEntity@ pSub = pLitMesh.GetSubMeshEntity(i);
+				if(pSub !is null) pSub.SetVisible(false);
+			}
+			return;
+		}
+
+		cBoneState@ pRoot = pMesh.GetBoneStateFromName("j_flare");
+		if(pRoot is null) return;
+		cMatrixf mtxRoot = pRoot.GetWorldMatrix();
+		cMatrixf mtxRest = mtxRoot;
+		mtxRest.SetTranslation(cVector3f(0.0f));
+		float fSize = cMath_MatrixMul3x3(mtxRest, cVector3f(0.0f, 1.0f, 0.0f)).Length();
+		if(fSize < 0.000001f) return;
+		float fUnit = fSize < 0.1f ? 1.0f : 0.01f;
+		float fCm = fSize * fUnit;
+		cVector3f vUp = cMath_MatrixMul3x3(mtxRest, cVector3f(0.0f, 1.0f, 0.0f)) * (1.0f / fSize);
+		cVector3f vExit = cMath_MatrixMul(mtxRoot, cVector3f(0.0f, gfBunkerVR_FlareExit * fUnit, 0.0f));
+
+		// The left thumb and first finger (as the shotgun's VRLeftPinch).
+		cMeshEntity@ pBodyMesh = mBaseObj.GetMeshEntity();
+		cBoneState@ pIndexA = pBodyMesh !is null ? pBodyMesh.GetBoneStateFromName("j_L_Index_3") : null;
+		cBoneState@ pIndexB = pBodyMesh !is null ? pBodyMesh.GetBoneStateFromName("j_L_Index_4") : null;
+		cBoneState@ pThumb = pBodyMesh !is null ? pBodyMesh.GetBoneStateFromName("j_L_Thumb_3") : null;
+		if(pIndexA is null || pIndexB is null || pThumb is null) return;
+		cVector3f vIndexPad = pIndexA.GetWorldPosition() + (pIndexB.GetWorldPosition() - pIndexA.GetWorldPosition()) * 0.6f;
+		cVector3f vPinch = (vIndexPad + pThumb.GetWorldPosition()) * 0.5f;
+		cVector3f vLine = vPinch - vExit;
+		float fLine = vLine.Length();
+		cVector3f vDown = vUp * -1.0f;
+		cVector3f vDir = fLine > 0.5f * fCm ? vLine * (1.0f / fLine) : vDown;
+		cMatrixf mtxTurn = BunkerVR_TurnOnto(vDown, vDir, cMath_MatrixMul3x3(mtxRest, cVector3f(1.0f, 0.0f, 0.0f)));
+
+		// Each bone's own turn as its animation leaves it, read before any is
+		// moved; then each placed, from the cord's top down to the cap.
+		array<cMatrixf> vRest;
+		for (uint i = 0; i < gvBunkerVR_FlareCordBones.length(); ++i)
+		{
+			cBoneState@ pBone = pMesh.GetBoneStateFromName(gvBunkerVR_FlareCordBones[i]);
+			cMatrixf mtxBone = pBone !is null ? pBone.GetWorldMatrix() : mtxRest;
+			mtxBone.SetTranslation(cVector3f(0.0f));
+			vRest.push_back(mtxBone);
+		}
+		for (uint i = 0; i < gvBunkerVR_FlareCordBones.length(); ++i)
+		{
+			cBoneState@ pBone = pMesh.GetBoneStateFromName(gvBunkerVR_FlareCordBones[i]);
+			if(pBone is null) continue;
+			float fOut = BunkerVR_FlareBoneOut(int(i), fCapOut);
+			cMatrixf mtxBone = vRest[i];
+			if(fOut >= 0.0f)
+			{
+				mtxBone = cMath_MatrixMul(mtxTurn, vRest[i]);
+				mtxBone.SetTranslation(vExit + vDir * (fOut * fCm));
+			}
+			else
+			{
+				mtxBone.SetTranslation(vExit + vUp * (-fOut * fCm));
+			}
+			pBone.SetWorldMatrix(mtxBone);
+		}
+	}
+
+	// BunkerVR: while the right hand has hold of the flashlight's cord, the
+	// flashlight runs its own string to that hand (see VRUpdateString in
+	// Prop_DynamoLantern.hps). It has to do that again each time the arms and
+	// the things in the hands have been placed, which is why it is asked here.
+	void VRUpdateLampString()
+	{
+		if(mbVRCordHeld == false) return;
+		
+		for (uint i = 0; i < mvSocketAttachments.length(); i++)
+		{
+			tID idProp = mvSocketAttachments[i].m_idEntity;
+			if (idProp == tID_Invalid) continue;
+			iLuxEntity@ pAttachProp = cLux_ID_Entity(idProp);
+			if (pAttachProp is null) continue;
+			
+			cMeshEntity@ pPropMesh = pAttachProp.GetMeshEntity();
+			if (pPropMesh is null) continue;
+			if (pPropMesh.GetBoneStateIndex("j_string_ring") < 0) continue;
+			
+			cScript_RunGlobalFunc(pAttachProp.GetName(), "cScrPropDynamoLantern", "_Global_VRUpdateString");
=5
+	/////////////////////////////////////////////
+	// BunkerVR: the body's arms follow the VR controllers.
+	//
+	// This runs right after the body's animation has been worked out for the
+	// frame, which is where the game itself adjusts arm bones (see
+	// PlayerState_UsingItem_Base.hps). For each hand whose controller is tracked:
+	//   1. the upper arm and forearm are turned so that the wrist lands where
+	//      the real wrist is (the arm slides out from the shoulder if that is
+	//      further than it can reach),
+	//   2. the hand is turned the way the real hand is turned.
+	//
+	// The VR mod answers through the camera: after setting a special roll value,
+	// reading the camera's matrix returns the palm's data instead. Without the
+	// mod (or with the controllers off) the answer does not match and the arms
+	// are left to the game.
+	// BunkerVR: Lambert, carried over the left shoulder, is kept clear of the
+	// real eyes. On a flat screen the view stays where the carry animation has
+	// the head, beside him; in VR the real head turns, leans and looks around
+	// at him, and would go into him. Each update, once he is hung on the hand:
+	// if his bone nearest the real eyes is nearer than gfVRCarryClear, he is
+	// moved away from the eyes by the difference (to the side or down, never
+	// up; at most gfVRCarryPushMost), and once the head is further than that by
+	// gfVRCarryRoom he goes back to the game's place at gfVRCarryBack. Built up
+	// a step at a time from where he was put last (mvVRCarryPush), so it holds
+	// whether his bones are where he was just put or where he was last update.
+	void VRKeepCarriedClear(iLuxEntity@ apPerson)
+	{
+		cVector3f vHung = apPerson.GetMatrix().GetTranslation(); // (where the game hangs him)
+		cMatrixf mtxPerson = apPerson.GetMatrix();
+		mtxPerson.SetTranslation(vHung + mvVRCarryPush);
+		apPerson.SetMatrix(mtxPerson);
+		cMeshEntity@ pMesh = apPerson.GetMeshEntity();
+		float fNearest = 1000.0f;
+		cVector3f vNearest = cVector3f(0.0f);
+		tString sNearest = "";
+		if(mbVRHeadKnown && pMesh !is null)
+		{
+			cVector3f vEyes = m_mtxVRHead.GetTranslation();
+			for(int i = 0; i < pMesh.GetBoneStateNum(); ++i)
+			{
+				cBoneState@ pBone = pMesh.GetBoneState(i);
+				if(pBone is null) continue;
+				cVector3f vAway = pBone.GetWorldPosition() - vEyes;
+				float fDist = vAway.Length();
+				if(fDist >= fNearest) continue;
+				fNearest = fDist;
+				vNearest = vAway;
+				sNearest = pBone.GetName();
+			}
+		}
+		if(fNearest < gfVRCarryClear)
+		{
+			cVector3f vDir = cVector3f(vNearest.x, cMath_Min(vNearest.y, 0.0f), vNearest.z);
+			if(vDir.Length() < 0.01f) vDir = cVector3f(0.0f, -1.0f, 0.0f);
+			mvVRCarryPush = mvVRCarryPush + cMath_Vector3Normalize(vDir) * (gfVRCarryClear - fNearest) * cMath_Min(1.0f, mfVRArmStep * 20.0f);
+			if(mvVRCarryPush.Length() > gfVRCarryPushMost) mvVRCarryPush = cMath_Vector3Normalize(mvVRCarryPush) * gfVRCarryPushMost;
+		}
+		else if(fNearest > gfVRCarryClear + gfVRCarryRoom && mvVRCarryPush.Length() > 0.0f)
+		{
+			float fBack = mfVRArmStep * gfVRCarryBack;
+			mvVRCarryPush = mvVRCarryPush.Length() <= fBack ? cVector3f(0.0f) : mvVRCarryPush - cMath_Vector3Normalize(mvVRCarryPush) * fBack;
+		}
+		mtxPerson.SetTranslation(vHung + mvVRCarryPush);
+		apPerson.SetMatrix(mtxPerson);
+
+		// Logged as he starts and stops being moved off (by more than 2 cm).
+		bool bMoved = mvVRCarryPush.Length() > 0.02f;
+		if(bMoved != mbVRCarryMoved && mlVRCarryLogs < 20)
+		{
+			mlVRCarryLogs++;
+			Log("BunkerVR: the carried person " + (bMoved ? "is moved off the eyes (his " + sNearest + " was " + int(fNearest * 100.0f + 0.5f) + " cm from them; kept " + int(gfVRCarryClear * 100.0f + 0.5f) + ")" : "is back where the game hangs him") + "\n");
+		}
+		mbVRCarryMoved = bMoved;
+	}
+
+	// BunkerVR: is a person hung on the left hand? Lambert in no
+	// man's land, whom no_mans_land.hps hangs on L_Hand as "Friend_Carried"
+	// while the body walks with the animation set carry_lambert. Logged as it
+	// starts and ends.
+	bool VRLeftHandCarriesPerson()
+	{
+		bool bCarrying = false;
+		for (uint i = 0; i < mvSocketAttachments.length(); i++)
+		{
+			if (mvSocketAttachments[i].msSocket != "L_Hand") continue;
+			iLuxEntity@ pThing = cLux_ID_Entity(mvSocketAttachments[i].m_idEntity);
+			if (pThing !is null && pThing.GetName() == "Friend_Carried") bCarrying = true;
+		}
+		if (bCarrying != mbVRCarrying)
+		{
+			mbVRCarrying = bCarrying;
+			mvVRCarryPush = cVector3f(0.0f); // (see VRKeepCarriedClear)
+			Log("BunkerVR: " + (bCarrying ? "a person is carried on the left hand: that arm keeps the game's carry pose" : "the left hand carries no one now: back on its controller") + "\n");
+		}
+		return bCarrying;
+	}
+
+	// BunkerVR: is a first-person knockdown, kill or death playing on the
+	// body, so that the arms follow its animation instead of the controllers?
+	// The body script says so every update while one plays
+	// (PlayerBodyHandler.hps VRUpdateRoughMove: "BunkerVR_ArmsToMove", stale
+	// after 0.25 s). As it ends, the arms start coming back to the
+	// controllers (mfVRArmsBack, VRArmsComeBack). Logged as it starts and ends.
+	bool VRArmsLeftToMove()
+	{
+		bool bNow = cScript_GetGlobalVarInt("BunkerVR_ArmsToMove") == 1 &&
+					cMath_Abs(float(cEngine_GetGameTime()) - cScript_GetGlobalVarFloat("BunkerVR_ArmsToMoveTime")) < 0.25f;
+		if(bNow != mbVRArmsToMove)
+		{
+			mbVRArmsToMove = bNow;
+			if(bNow == false) mfVRArmsBack = 0.0f;
+			Log("BunkerVR: " + (bNow ? "the arms are the knockdown's, kill's or death's animation's" : "the arms come back to the controllers over " + int(gfVRArmsBackTime * 1000.0f + 0.5f) + " ms") + "\n");
+		}
+		return bNow;
+	}
+
+	// BunkerVR: the arms' bones (each collar bone and everything under it:
+	// the arm, the hand, the fingers, the hand's socket), as indices into the
+	// mesh's bones; found once.
+	void VRFindArmBones(cMeshEntity@ apMesh)
+	{
+		if(mvVRArmBones.length() > 0) return;
+		for(int i = 0; i < apMesh.GetBoneStateNum(); ++i)
+		{
+			cBoneState@ pBone = apMesh.GetBoneState(i);
+			if(pBone is null) continue;
+			tString sName = pBone.GetName();
+			bool bArm = sName == "j_L_Clavicle" || sName == "j_R_Clavicle";
+			cNode3D@ pUp = pBone.GetParent();
+			for(int lUp = 0; lUp < 40 && pUp !is null && bArm == false; ++lUp)
+			{
+				tString sUp = pUp.GetName();
+				bArm = sUp == "j_L_Clavicle" || sUp == "j_R_Clavicle";
+				@pUp = pUp.GetParent();
+			}
+			if(bArm) mvVRArmBones.push_back(i);
+		}
+		Log("BunkerVR: " + mvVRArmBones.length() + " bones in the arms (eased back to the controllers after a knockdown, a kill or a death)\n");
+	}
+
+	// BunkerVR: while the arms come back, at the start of each arm update:
+	// the first of a frame (the bones as the animation has just left them)
+	// stores the arms' bones as animated; the second (once the camera is
+	// placed) starts from the arms as the first put them on the controllers,
+	// before it eased them (so that what it doesn't move again isn't eased
+	// twice).
+	void VRArmsKeepAnimated(cMeshEntity@ apMesh)
+	{
+		if(mfVRArmsBack >= 1.0f) return;
+		VRFindArmBones(apMesh);
+		uint lCount = mvVRArmBones.length();
+		if(mbVRFreshPose)
+		{
+			mvVRArmAnimated.resize(lCount);
+			for(uint i = 0; i < lCount; ++i) mvVRArmAnimated[i] = apMesh.GetBoneState(mvVRArmBones[i]).GetLocalMatrix();
+			mbVRArmAnimatedKnown = true;
+		}
+		else if(mbVRArmFollowedKnown && mvVRArmFollowed.length() == lCount)
+		{
+			for(uint i = 0; i < lCount; ++i) apMesh.GetBoneState(mvVRArmBones[i]).SetMatrix(mvVRArmFollowed[i]);
+		}
+	}
+
+	// BunkerVR: the arms coming back to the controllers after a knockdown, a
+	// kill or a death: once they are put on the controllers, each
+	// of their bones is eased from where the animation has it to there, the
+	// whole way over gfVRArmsBackTime (an S curve). (The first arm update of
+	// a frame keeps them as put on the controllers, for the second: see
+	// VRArmsKeepAnimated.)
+	void VRArmsComeBack(cMeshEntity@ apMesh)
+	{
+		if(mfVRArmsBack >= 1.0f || mbVRArmAnimatedKnown == false) return;
+		uint lCount = mvVRArmBones.length();
+		if(mvVRArmAnimated.length() != lCount) return;
+		if(mbVRFreshPose)
+		{
+			mvVRArmFollowed.resize(lCount);
+			for(uint i = 0; i < lCount; ++i) mvVRArmFollowed[i] = apMesh.GetBoneState(mvVRArmBones[i]).GetLocalMatrix();
+			mbVRArmFollowedKnown = true;
+			mfVRArmsBack = cMath_Min(1.0f, mfVRArmsBack + mfVRArmStep / gfVRArmsBackTime);
+			if(mfVRArmsBack >= 1.0f)
+			{
+				mbVRArmAnimatedKnown = false;
+				mbVRArmFollowedKnown = false;
+				Log("BunkerVR: the arms are back on the controllers\n");
+				return;
+			}
+		}
+		float fT = mfVRArmsBack * mfVRArmsBack * (3.0f - 2.0f * mfVRArmsBack);
+		for(uint i = 0; i < lCount; ++i)
+		{
+			cBoneState@ pBone = apMesh.GetBoneState(mvVRArmBones[i]);
+			pBone.SetMatrix(VRBlendBone(mvVRArmAnimated[i], pBone.GetLocalMatrix(), fT));
+		}
+	}
+
+	// BunkerVR: a bone's local matrix part of the way (afT, 0 to 1) from
+	// a_mtxFrom to a_mtxTo: its rotation along the shortest arc, its position
+	// and scale linearly. A mirrored bone (left-handed axes) is rotated as its
+	// mirror image and mirrored back; one mirrored at one end only, or with
+	// zero scale, switches over at halfway.
+	cMatrixf VRBlendBone(const cMatrixf &in a_mtxFrom, const cMatrixf &in a_mtxTo, float afT)
+	{
+		if(afT >= 1.0f) return a_mtxTo;
+		if(afT <= 0.0f) return a_mtxFrom;
+		cVector3f vFromX = cMath_MatrixMul3x3(a_mtxFrom, cVector3f(1.0f, 0.0f, 0.0f));
+		cVector3f vFromY = cMath_MatrixMul3x3(a_mtxFrom, cVector3f(0.0f, 1.0f, 0.0f));
+		cVector3f vFromZ = cMath_MatrixMul3x3(a_mtxFrom, cVector3f(0.0f, 0.0f, 1.0f));
+		cVector3f vToX = cMath_MatrixMul3x3(a_mtxTo, cVector3f(1.0f, 0.0f, 0.0f));
+		cVector3f vToY = cMath_MatrixMul3x3(a_mtxTo, cVector3f(0.0f, 1.0f, 0.0f));
+		cVector3f vToZ = cMath_MatrixMul3x3(a_mtxTo, cVector3f(0.0f, 0.0f, 1.0f));
+		cVector3f vFromSize(vFromX.Length(), vFromY.Length(), vFromZ.Length());
+		cVector3f vToSize(vToX.Length(), vToY.Length(), vToZ.Length());
+		float fFromMirror = cMath_Vector3Dot(cMath_Vector3Cross(vFromX, vFromY), vFromZ);
+		float fToMirror = cMath_Vector3Dot(cMath_Vector3Cross(vToX, vToY), vToZ);
+		if(cMath_Min(cMath_Min(vFromSize.x, vFromSize.y), vFromSize.z) < 0.000001f || cMath_Min(cMath_Min(vToSize.x, vToSize.y), vToSize.z) < 0.000001f ||
+		   (fFromMirror < 0.0f) != (fToMirror < 0.0f))
+			return afT < 0.5f ? a_mtxFrom : a_mtxTo;
+		float fFlip = fToMirror < 0.0f ? -1.0f : 1.0f;
+		cMatrixf mtxFrom = cMath_MatrixUnitVectors(vFromX * (fFlip / vFromSize.x), vFromY / vFromSize.y, vFromZ / vFromSize.z, cVector3f(0.0f));
+		cMatrixf mtxTo = cMath_MatrixUnitVectors(vToX * (fFlip / vToSize.x), vToY / vToSize.y, vToZ / vToSize.z, cVector3f(0.0f));
+		cMatrixf mtxTurn = BunkerVR_Slerp(afT, mtxFrom, mtxTo); // (without the engine's NaN)
+		cVector3f vSize = vFromSize + (vToSize - vFromSize) * afT;
+		cMatrixf mtx = cMath_MatrixUnitVectors(cMath_MatrixMul3x3(mtxTurn, cVector3f(1.0f, 0.0f, 0.0f)) * (fFlip * vSize.x),
+											   cMath_MatrixMul3x3(mtxTurn, cVector3f(0.0f, 1.0f, 0.0f)) * vSize.y,
+											   cMath_MatrixMul3x3(mtxTurn, cVector3f(0.0f, 0.0f, 1.0f)) * vSize.z, cVector3f(0.0f));
+		mtx.SetTranslation(a_mtxFrom.GetTranslation() + (a_mtxTo.GetTranslation() - a_mtxFrom.GetTranslation()) * afT);
+		return mtx;
+	}
+
+	void UpdateVRArms()
+	{
+		cLuxPlayer@ pVRPlayer = cLux_GetPlayer();
+		cCamera@ pVRCam = pVRPlayer !is null ? pVRPlayer.GetCamera() : null;
+		cMeshEntity@ pVRMesh = mBaseObj.GetMeshEntity();
+		if(pVRCam is null || pVRMesh is null) return;
+		bool bVRArmsToMove = VRArmsLeftToMove();
+		VRArmsKeepAnimated(pVRMesh);
+		
+		int lVRPalms = 0; // 1 = the left palm can be followed, 2 = the right one, 3 = both
+		mbVRCordHeld = false;
+		mbVRRightFittedNow = false; // (see VRFittedHand)
+		mbVRLeftFittedNow = false; // (see VRFittedLeftHand)
+		float fVRArmScale = 1.0f;
+		float fVRCurlLeft = 0.0f;	// how far each hand's fingers are closed: 0 = open, 1 = a full grip
+		float fVRCurlRight = 0.0f;
+		// How each hand's fingers are to be set: 0 = one squeeze on top of
+		// the game's animation, 1 = posed from the hand's rest
+		// shape by three numbers (thumb, first finger, other fingers; 0 open
+		// to 1 closed), 2 = left exactly as the game's animation has them.
+		int lVRFingersLeft = 0;
+		int lVRFingersRight = 0;
+		cVector3f vVRFingersLeft = cVector3f(0.0f);
+		cVector3f vVRFingersRight = cVector3f(0.0f);
+		bool bVRGun = false;		// is a gun held ready in the right hand?
+		bool bVRLeftOnGunWanted = false;
+		int lVRLooseHeld = 0;		// which hands hold a loose thing by themselves (1 left + 2 right; special roll 7014)
+		int lVRGameGrab = -1;		// the hand the game's own grab is holding with (0 left, 1 right; -1 none; special roll 7002)
+		cVector3f vVRSupport = cVector3f(gfVRSupportLeft, gfVRSupportDown, 0.0f);	// left, down, forwards
+		float fVRSupportCurl = gfVRSupportCurl;
+		cMatrixf mtxVRLeft = cMatrixf_Identity;
+		cMatrixf mtxVRRight = cMatrixf_Identity;
+		
+		float fVRRealRoll = pVRCam.GetRoll();
+		pVRCam.SetRoll(7010.0f);
+		cVector3f vVRStatus = pVRCam.GetMatrix().GetTranslation();
+		if(vVRStatus.x > 12344.0f && vVRStatus.x < 12346.0f)
+		{
+			float fVRFlags = vVRStatus.y;
+			if(fVRFlags > 3.5f) // 4 is added when the mod wants this code's numbers in its log
+			{
+				mbVRArmNote = true;
+				fVRFlags -= 4.0f;
+			}
+			if(fVRFlags > 0.5f && fVRFlags < 1.5f) lVRPalms = 1;
+			if(fVRFlags > 1.5f && fVRFlags < 2.5f) lVRPalms = 2;
+			if(fVRFlags > 2.5f && fVRFlags < 3.5f) lVRPalms = 3;
+			if(vVRStatus.z > 0.5f && vVRStatus.z < 3.0f) fVRArmScale = vVRStatus.z;
+			
+			if(lVRPalms == 1 || lVRPalms == 3)
+			{
+				pVRCam.SetRoll(7011.0f);
+				mtxVRLeft = pVRCam.GetMatrix();
+			}
+			if(lVRPalms == 2 || lVRPalms == 3)
+			{
+				pVRCam.SetRoll(7012.0f);
+				mtxVRRight = pVRCam.GetMatrix();
+			}
+			// BunkerVR: while the game hangs a person on the left hand (Lambert,
+			// carried over the shoulder in no man's land), the left arm keeps the
+			// game's carry pose: put on the controller, he would swing about with
+			// it.
+			if((lVRPalms & 1) != 0 && VRLeftHandCarriesPerson()) lVRPalms &= 2;
+			// BunkerVR: and in a first-person knockdown, kill or death, both
+			// arms follow the animation (VRArmsLeftToMove).
+			if(bVRArmsToMove) lVRPalms = 0;
+			if(lVRPalms != 0)
+			{
+				pVRCam.SetRoll(7013.0f);
+				cVector3f vVRCurl = pVRCam.GetMatrix().GetTranslation();
+				fVRCurlLeft = cMath_Clamp(vVRCurl.x, 0.0f, 1.0f);
+				fVRCurlRight = cMath_Clamp(vVRCurl.y, 0.0f, 1.0f);
+				bVRGun = vVRCurl.z > 0.5f;
+				// The Feel page's "Weight (how hard it pulls)" (special roll 7082, its first number;
+				// 0 to 2): how heavy a door pushed by an open hand is (VRPushPart).
+				pVRCam.SetRoll(7082.0f);
+				mfVRFeelWeight = cMath_Clamp(pVRCam.GetMatrix().GetTranslation().x, 0.0f, 2.0f);
+
+				// The fingers of empty hands follow the controllers' finger
+				// sensors (special roll values 7037 left, 7038 right). The
+				// first number says what to do: 10 to 11 = pose the hand, the
+				// part after the 10 being how far the thumb is closed, with
+				// the first finger and the other fingers in the next two
+				// numbers; 20 = the hand holds something, leave the fingers
+				// as animated; anything else = one squeeze on top of the animation.
+				pVRCam.SetRoll(7037.0f);
+				cVector3f vVRAskLeft = pVRCam.GetMatrix().GetTranslation();
+				pVRCam.SetRoll(7038.0f);
+				cVector3f vVRAskRight = pVRCam.GetMatrix().GetTranslation();
+				if(vVRAskLeft.x > 9.99f && vVRAskLeft.x < 11.01f && vVRAskLeft.y > -0.01f && vVRAskLeft.y < 1.01f && vVRAskLeft.z > -0.01f && vVRAskLeft.z < 1.01f)
+				{
+					lVRFingersLeft = 1;
+					vVRFingersLeft = cVector3f(cMath_Clamp(vVRAskLeft.x - 10.0f, 0.0f, 1.0f), vVRAskLeft.y, vVRAskLeft.z);
+				}
+				else if(vVRAskLeft.x > 19.9f && vVRAskLeft.x < 20.1f)
+				{
+					lVRFingersLeft = 2;
+				}
+				if(vVRAskRight.x > 9.99f && vVRAskRight.x < 11.01f && vVRAskRight.y > -0.01f && vVRAskRight.y < 1.01f && vVRAskRight.z > -0.01f && vVRAskRight.z < 1.01f)
+				{
+					lVRFingersRight = 1;
+					vVRFingersRight = cVector3f(cMath_Clamp(vVRAskRight.x - 10.0f, 0.0f, 1.0f), vVRAskRight.y, vVRAskRight.z);
+				}
+				else if(vVRAskRight.x > 19.9f && vVRAskRight.x < 20.1f)
+				{
+					lVRFingersRight = 2;
+				}
+
+				// An item with its own grip (see VRReadGrips): its own
+				// placement, and its own fingers (used
+				// below, with the hands at work: see VRWorkPose).
+				VRReadGrips(pVRCam);
+				
+				// What the mod says the hands are doing: the third number is
+				// 1 while the ammo check is open + 2 while the left hand steadies the gun.
+				pVRCam.SetRoll(7014.0f);
+				cVector3f vVRHandUse = pVRCam.GetMatrix().GetTranslation();
+				// Is the game's own grab holding with a hand (special roll
+				// 7002: 12345, 1 while its interact button is held, the hand)?
+				pVRCam.SetRoll(7002.0f);
+				cVector3f vVRGameGrab = pVRCam.GetMatrix().GetTranslation();
+				if(vVRGameGrab.x > 12344.0f && vVRGameGrab.x < 12346.0f && vVRGameGrab.y > 0.5f) lVRGameGrab = int(vVRGameGrab.z + 0.5f);
+				// (That says only that the hand squeezes. It holds something only
+				// while the game is in one of its hold-on states (its grab, a lever,
+				// a wheel...), not in its ordinary one: a hand squeezed on nothing
+				// is an empty fist, which bumps into things as an open hand does.)
+				if(lVRGameGrab >= 0 && cLux_GetPlayer().GetCurrentStateId() == ePlayerState_Normal) lVRGameGrab = -1;
+				if(vVRHandUse.x > 12344.0f && vVRHandUse.x < 12346.0f)
+				{
+					// (The same for a hand's own hold: the mod says which hands
+					// squeeze for it, the body handler which of them hold something.)
+					lVRLooseHeld = int(vVRHandUse.y + 0.5f) & cScript_GetGlobalVarInt("BunkerVR_FreeHolding");
+					int lVRGunFlags = int(vVRHandUse.z + 0.5f);
+					bVRLeftOnGunWanted = lVRGunFlags == 2 || lVRGunFlags == 3;
+					bool bVRReloadWasOpen = mbVRReloadOpen;
+					mbVRReloadOpen = lVRGunFlags == 1 || lVRGunFlags == 3;
+
+					// +4: the left hand is carrying a bullet to the open revolver.
+					// Its fingers are then half closed whatever the squeeze, so
+					// that the bullet sits between the thumb and the first finger
+					// (the revolver's script puts it there, see VRUpdateGunBullet).
+					mbVRBulletInHand = lVRGunFlags >= 4 && lVRGunFlags <= 7;
+					if(mbVRBulletInHand)
+					{
+						fVRCurlLeft = gfVRBulletCurl;
+						if(lVRFingersLeft != 0)
+						{
+							// A pinch: thumb and first finger meet, the rest tucked in.
+							lVRFingersLeft = 1;
+							vVRFingersLeft = cVector3f(0.8f, 0.6f, 0.9f);
+						}
+						mbVRReloadOpen = lVRGunFlags == 5 || lVRGunFlags == 7;
+					}
+
+					// The revolver has just been flicked shut: its "close"
+					// animation still tips it about in the hand for a moment.
+					// The barrel is not measured again until that is over (see
+					// VRMeasureGunBarrel), or the hand would turn to follow it
+					// and then turn back.
+					if(bVRReloadWasOpen && mbVRReloadOpen == false) mfVRBarrelHold = 1.2f;
+
+					// How the gun should sit in the hand (the mod's menu: 7035
+					// gives the barrel turned right and tipped up, 7036 the top
+					// leaning right; all in degrees).
+					pVRCam.SetRoll(7035.0f);
+					cVector3f vVRGunAngles = pVRCam.GetMatrix().GetTranslation();
+					pVRCam.SetRoll(7036.0f);
+					cVector3f vVRGunLean = pVRCam.GetMatrix().GetTranslation();
+					mvVRGunAngles = cVector3f(0.0f);
+					if(vVRGunAngles.x > 12344.0f && vVRGunAngles.x < 12346.0f && vVRGunLean.x > 12344.0f && vVRGunLean.x < 12346.0f &&
+						cMath_Abs(vVRGunAngles.y) < 46.0f && cMath_Abs(vVRGunAngles.z) < 46.0f && cMath_Abs(vVRGunLean.y) < 91.0f)
+					{
+						mvVRGunAngles = cVector3f(cMath_ToRad(vVRGunAngles.y), cMath_ToRad(vVRGunAngles.z), cMath_ToRad(vVRGunLean.y));
+					}
+					
+					// Where the steadying hand goes can be changed in the mod's
+					// menu (7031: left, down, forwards; 7032: first number = how closed).
+					pVRCam.SetRoll(7031.0f);
+					cVector3f vVRSupportSet = pVRCam.GetMatrix().GetTranslation();
+					pVRCam.SetRoll(7032.0f);
+					float fVRSupportCurlSet = pVRCam.GetMatrix().GetTranslation().x;
+					if(cMath_Abs(vVRSupportSet.x) < 0.31f && cMath_Abs(vVRSupportSet.y) < 0.31f && cMath_Abs(vVRSupportSet.z) < 0.31f &&
+						fVRSupportCurlSet > -0.01f && fVRSupportCurlSet < 1.01f)
+					{
+						vVRSupport = vVRSupportSet;
+						fVRSupportCurl = fVRSupportCurlSet;
+					}
+					
+					// How much the elbows move with the hands (7033, third
+					// number: 1 + the amount, where 0 = a fixed rule and
+					// 1 = normal). Without a valid answer (0 there) the
+					// normal amount is used.
+					pVRCam.SetRoll(7033.0f);
+					cVector3f vVRElbowSet = pVRCam.GetMatrix().GetTranslation();
+					mfVRElbowMove = 1.0f;
+					if(vVRElbowSet.x > 12344.0f && vVRElbowSet.x < 12346.0f && vVRElbowSet.z > 0.99f && vVRElbowSet.z < 3.01f)
+						mfVRElbowMove = vVRElbowSet.z - 1.0f;
+					
+					// Is the right hand holding the flashlight's cord (7034,
+					// third number)? Then its fingers are hooked, not a fist,
+					// so that the cord's ring can sit around the first finger.
+					pVRCam.SetRoll(7034.0f);
+					cVector3f vVRCord = pVRCam.GetMatrix().GetTranslation();
+					mbVRCordHeld = vVRCord.x > 12344.0f && vVRCord.x < 12346.0f && vVRCord.z > 0.5f;
+					if(mbVRCordHeld)
+					{
+						fVRCurlRight = 0.5f;
+						if(lVRFingersRight != 0)
+						{
+							lVRFingersRight = 1;
+							vVRFingersRight = cVector3f(0.4f, 0.6f, 0.6f);
+						}
+					}
+				}
+			}
+		}
+		// Where the real head is (special roll values 7006, then 7005): the
+		// shoulders are put under it (see UpdateVRArm).
+		mbVRHeadKnown = false;
+		if(lVRPalms != 0)
+		{
+			pVRCam.SetRoll(7006.0f);
+			cVector3f vVRHeadStatus = pVRCam.GetMatrix().GetTranslation();
+			if(vVRHeadStatus.x > 12344.0f && vVRHeadStatus.x < 12346.0f && vVRHeadStatus.y > 0.5f)
+			{
+				pVRCam.SetRoll(7005.0f);
+				m_mtxVRHead = pVRCam.GetMatrix();
+				mbVRHeadKnown = true;
+			}
+		}
+		pVRCam.SetRoll(fVRRealRoll);
+
+		// (Whether each hand holds a door or a loose thing, kept from the
+		// block below for the hands' own poses: see VRWorkPose.)
+		bool bVRLeftDoorPose = false;
+		bool bVRRightDoorPose = false;
+		bool bVRLeftLoosePose = false;
+		bool bVRRightLoosePose = false;
+
+		// A hand holding a door is drawn on the spot it holds (the handle),
+		// wherever the real hand is (see the grip in the VR part of
+		// PlayerState_Interact_SwingDoor.hps, which sets these each update;
+		// its stamp going stale means it has stopped).
+		{
+			int lVRDoorHand = cScript_GetGlobalVarInt("BunkerVR_DoorHand");	// 1 left, 2 right, 0 none
+			int lVRDoorHand2 = cScript_GetGlobalVarInt("BunkerVR_DoorHand2");	// the other hand on the same door: 1 left, 2 right, 0 none
+			int lVRDoorStamp = cScript_GetGlobalVarInt("BunkerVR_DoorStamp");
+			if(lVRDoorStamp != mlVRDoorStampSeen)
+			{
+				mlVRDoorStampSeen = lVRDoorStamp;
+				mlVRDoorStaleFrames = 0;
+			}
+			else if(mbVRFreshPose)
+			{
+				mlVRDoorStaleFrames++;
+			}
+			if(lVRDoorHand > 0 && mlVRDoorStaleFrames < 3)
+			{
+				cVector3f vVRDoorGrip = cScript_GetGlobalVarVector3f("BunkerVR_DoorGrip");
+				cVector3f vVRDoorBar = cScript_GetGlobalVarVector3f("BunkerVR_DoorGripAxis");
+				cVector3f vVRDoorOut = cScript_GetGlobalVarVector3f("BunkerVR_DoorGripOut");
+				if(lVRDoorHand == 1 && (lVRPalms == 1 || lVRPalms == 3)) mtxVRLeft = VRHoldBar(mtxVRLeft, vVRDoorGrip, vVRDoorBar, vVRDoorOut);
+				if(lVRDoorHand == 2 && (lVRPalms == 2 || lVRPalms == 3)) mtxVRRight = VRHoldBar(mtxVRRight, vVRDoorGrip, vVRDoorBar, vVRDoorOut);
+				// And the other hand, on the same door too (its own grip).
+				if(lVRDoorHand2 > 0 && lVRDoorHand2 != lVRDoorHand)
+				{
+					cVector3f vVRDoorGrip2 = cScript_GetGlobalVarVector3f("BunkerVR_DoorGrip2");
+					cVector3f vVRDoorBar2 = cScript_GetGlobalVarVector3f("BunkerVR_DoorGripAxis2");
+					cVector3f vVRDoorOut2 = cScript_GetGlobalVarVector3f("BunkerVR_DoorGripOut2");
+					if(lVRDoorHand2 == 1 && (lVRPalms == 1 || lVRPalms == 3)) mtxVRLeft = VRHoldBar(mtxVRLeft, vVRDoorGrip2, vVRDoorBar2, vVRDoorOut2);
+					if(lVRDoorHand2 == 2 && (lVRPalms == 2 || lVRPalms == 3)) mtxVRRight = VRHoldBar(mtxVRRight, vVRDoorGrip2, vVRDoorBar2, vVRDoorOut2);
+				}
+				else
+				{
+					lVRDoorHand2 = 0;
+				}
+			}
+			else
+			{
+				lVRDoorHand = 0;
+				lVRDoorHand2 = 0;
+			}
+			// (Is each hand on a door, as the first hand or the other?)
+			bool bVRLeftOnDoor = lVRDoorHand == 1 || lVRDoorHand2 == 1;
+			bool bVRRightOnDoor = lVRDoorHand == 2 || lVRDoorHand2 == 2;
+			// A right hand fitting an item into what it is used on (a key in its
+			// lock: see VRUpdateFit in PlayerBodyHandler.hps) is drawn
+			// where that puts the item, and held there as a hand on a door is:
+			// not stopped by things, not pressing on doors.
+			cMatrixf mtxVRFitted = cMatrixf_Identity;
+			bool bVRRightFitted = VRFittedHand(lVRPalms == 2 || lVRPalms == 3, mtxVRFitted);
+			if(bVRRightFitted) mtxVRRight = mtxVRFitted;
+			mbVRRightFittedNow = bVRRightFitted; // (the item itself is put exactly there too: VRFittedThing, in VRPlaceHeldByGrip)
+			bool bVRRightFixed = bVRRightOnDoor || bVRRightFitted;
+			// The left hand on the other handle of a tool held with both hands
+			// (the bolt cutters, VRUpdateCutters in
+			// PlayerBodyHandler.hps): drawn on it, held there as the fitted
+			// right hand is.
+			cMatrixf mtxVRLeftFitted = cMatrixf_Identity;
+			bool bVRLeftFitted = VRFittedLeftHand(lVRPalms == 1 || lVRPalms == 3, mtxVRLeftFitted);
+			if(bVRLeftFitted) mtxVRLeft = mtxVRLeftFitted;
+			mbVRLeftFittedNow = bVRLeftFitted;
+			bool bVRLeftFixed = bVRLeftOnDoor || bVRLeftFitted;
+			// A hand holding the gas mask (VRUpdateMask in
+			// PlayerBodyHandler.hps: "BunkerVR_MaskHand", 1 left, 2 right)
+			// holds something: it pushes nothing.
+			mlVRMaskHandNow = cScript_GetGlobalVarInt("BunkerVR_MaskHand");
+
+			// The hands press against doors, hatches, lids and drawers, and are
+			// drawn on the face they press, not through it. Worked out once a frame
+			// (VRHandPress); the shift of the drawn hand is used in both of the
+			// frame's bendings. Not the hand holding a door, nor a hand holding
+			// an item or the gun.
+			// Hands stop at walls, floors, tables and other solid things,
+			// and empty ones push loose things (see VRHandBlock). Not a
+			// hand that holds an item, a door, the gun
+			// (or the left hand on it, or a bullet for it), or the
+			// flashlight's cord. A hand holding a loose thing (by the game's
+			// grab or by itself) still stops (the thing follows the drawn
+			// hand, see below), but pushes nothing. Worked out once a frame,
+			// before the pressing on doors below, which then starts from
+			// where the hand is drawn.
+			bool bVRLeftBusy = bVRLeftFixed || lVRFingersLeft == 2 || mbVRBulletInHand || (bVRGun && bVRLeftOnGunWanted) || mlVRMaskHandNow == 1;
+			bool bVRRightBusy = bVRRightFixed || lVRFingersRight == 2 || bVRGun || mbVRCordHeld || mlVRMaskHandNow == 2;
+			bool bVRLeftHolds = lVRLooseHeld == 1 || lVRLooseHeld == 3 || lVRGameGrab == 0;
+			bool bVRRightHolds = lVRLooseHeld == 2 || lVRLooseHeld == 3 || lVRGameGrab == 1;
+			bVRLeftDoorPose = bVRLeftOnDoor;
+			bVRRightDoorPose = bVRRightOnDoor;
+			bVRLeftLoosePose = bVRLeftHolds;
+			bVRRightLoosePose = bVRRightHolds;
+			if(mbVRFreshPose)
+			{
+				// A hand holding a loose thing has no balls of its own (with
+				// them, the thing, following the hand, shakes and bounces).
+				// The thing is kept out of tables and walls instead
+				// (BunkerVR_HoldPlace, in the code that holds it), and the hand
+				// is drawn where the thing can be: the holding code says how far
+				// that is from where the real hand wants it ("BunkerVR_HoldBack").
+				VRTimeMark(7080);
+				mvVRBlockShift[0] = (lVRPalms == 1 || lVRPalms == 3) ? VRHandBlock(0, mtxVRLeft, fVRCurlLeft, fVRArmScale, bVRLeftBusy || bVRLeftHolds, bVRLeftHolds, bVRLeftFixed) : cVector3f(0.0f);
+				mvVRBlockShift[1] = (lVRPalms == 2 || lVRPalms == 3) ? VRHandBlock(1, mtxVRRight, fVRCurlRight, fVRArmScale, bVRRightBusy || bVRRightHolds, bVRRightHolds, bVRRightFixed) : cVector3f(0.0f);
+				VRTimeMark(7081);
+
+				// How far each empty hand is held back, for the code that picks
+				// what a hand takes hold of (the game's pick, its grab, and a
+				// hand's own hold): it searches from the hand that is seen, so a
+				// hand resting on a table (the real hand a little into it) still
+				// finds what lies on it. (0 0 0 for a holding hand: what it holds
+				// is placed from the real hand, then kept out of things.)
+				cScript_SetGlobalVarVector3f("BunkerVR_HandBack0", mvVRBlockShift[0]);
+				cScript_SetGlobalVarVector3f("BunkerVR_HandBack1", mvVRBlockShift[1]);
+
+				for(int lVRHand = 0; lVRHand < 2; ++lVRHand)
+				{
+					bool bVRHolds = lVRHand == 0 ? bVRLeftHolds : bVRRightHolds;
+					tString sVRHoldBack = lVRHand == 0 ? "BunkerVR_HoldBack0" : "BunkerVR_HoldBack1";
+					if(bVRHolds == false)
+					{
+						cScript_SetGlobalVarVector3f(sVRHoldBack, cVector3f(0.0f)); // (nothing stale for the next hold)
+						cScript_SetGlobalVarID("BunkerVR_HoldBody" + lVRHand, tID_Invalid); // (the same: see VRGlueToHeld)
+						continue;
+					}
+					cVector3f vVRHoldBack = cScript_GetGlobalVarVector3f(sVRHoldBack);
+					if(vVRHoldBack.Length() < gfVRHandOnThingMost + 0.1f) mvVRBlockShift[lVRHand] = vVRHoldBack;
+				}
+			}
+			// (Each hand where the real one is, before it is held back: for the
+			// buttons pushed in, below.)
+			cMatrixf mtxVRLeftReal = mtxVRLeft;
+			cMatrixf mtxVRRightReal = mtxVRRight;
+			if(bVRLeftFixed == false && mvVRBlockShift[0].Length() > 0.0001f) mtxVRLeft.SetTranslation(mtxVRLeft.GetTranslation() + mvVRBlockShift[0]);
+			if(bVRRightFixed == false && mvVRBlockShift[1].Length() > 0.0001f) mtxVRRight.SetTranslation(mtxVRRight.GetTranslation() + mvVRBlockShift[1]);
+			// A hand holding a thing is drawn fixed to it, where it is now (see
+			// VRGlueToHeld). (Instead of the hold-back above, which the holding
+			// code worked out from where the thing was at its update.)
+			if(bVRLeftFixed == false && bVRLeftHolds) mtxVRLeft = VRGlueToHeld(0, mtxVRLeft);
+			if(bVRRightFixed == false && bVRRightHolds) mtxVRRight = VRGlueToHeld(1, mtxVRRight);
+
+			if(mbVRFreshPose)
+			{
+				VRTimeMark(7082);
+				mvVRHandShift[0] = (lVRPalms == 1 || lVRPalms == 3) ? VRHandPress(0, mtxVRLeft.GetTranslation(), bVRLeftFixed || lVRFingersLeft == 2) : cVector3f(0.0f);
+				mvVRHandShift[1] = (lVRPalms == 2 || lVRPalms == 3) ? VRHandPress(1, mtxVRRight.GetTranslation(), bVRRightFixed || lVRFingersRight == 2 || bVRGun) : cVector3f(0.0f);
+				VRTimeMark(7083);
+			}
+			if(bVRLeftFixed == false && mvVRHandShift[0].Length() > 0.0001f) mtxVRLeft.SetTranslation(mtxVRLeft.GetTranslation() + mvVRHandShift[0]);
+			if(bVRRightFixed == false && mvVRHandShift[1].Length() > 0.0001f) mtxVRRight.SetTranslation(mtxVRRight.GetTranslation() + mvVRHandShift[1]);
+
+			// What each hand touches that it can take hold of or use, for the
+			// picks (see VRHandTouchFind), from the hand as drawn. The ticks
+			// only for an open hand that holds and does nothing else.
+			if(mbVRFreshPose)
+			{
+				VRTimeMark(7084);
+				if(lVRPalms == 1 || lVRPalms == 3) VRHandTouchFind(0, mtxVRLeft, fVRCurlLeft, fVRArmScale, bVRLeftHolds, bVRLeftBusy == false && fVRCurlLeft < 0.5f);
+				if(lVRPalms == 2 || lVRPalms == 3) VRHandTouchFind(1, mtxVRRight, fVRCurlRight, fVRArmScale, bVRRightHolds, bVRRightBusy == false && fVRCurlRight < 0.5f);
+				VRTimeMark(7085);
