+		bool bVRPalmAsEmptyLeft = bVRGun == false || VRHandHoldsLoose(0) || bVRShotgunOut;
+		bool bVRPalmAsEmptyRight = bVRGun == false || VRHandHoldsLoose(1) || bVRShotgunOut;
+		// The revolver's kick (VRRevolverKicked): both hands are moved with it, the steadying
+		// left hand too.
