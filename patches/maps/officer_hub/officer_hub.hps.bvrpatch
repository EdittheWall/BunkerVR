=669
+		// BunkerVR: the finale by hand in the headset (helper_bunkervr_finale.hps; the hands' side is
+		// PlayerBodyHandler.hps VRUpdateFinale): what is done of it (glBunkerVR_Finale... bits), saved with the level.
+		int mlVRFinale = 0;
+		
+		// As the level is entered in the headset: its state shown, with what the flat game did before.
+		void VRFinaleSetup()
+		{
+			mlVRFinale = BunkerVR_FinaleFromGame(mlVRFinale, mbDetonatorHandleIsInPlace, mbDynamiteIsInPlace, mbExitBlownUp);
+			BunkerVR_FinaleShow(mlVRFinale);
+		}
+		
+		// A level saved part way through the finale by hand, played on in the flat game: what the hands did counts as
+		// done (a handle in with its nuts loose is in; a bundle set down without its cable is in place), and the detonator
+		// is as the flat game's scenes leave it (the plain one with the handle in, or the push's area armed).
+		void VRFinaleToFlat()
+		{
+			if (mbExitBlownUp || mlVRFinale == 0) return;
+			if ((mlVRFinale & glBunkerVR_FinaleHandle) != 0) mbDetonatorHandleIsInPlace = true;
+			if ((mlVRFinale & glBunkerVR_FinaleBundle) != 0)
+			{
+				mbDynamiteIsInPlace = true;
+				Entity_SetActive("Detonator_DynamiteBundle", true);
+				Entity_SetActive("Trigger_DynamiteBundleSlot", false);
+			}
+			if (mbDetonatorHandleIsInPlace && mbDynamiteIsInPlace)
+				ActivateDetonatorTrigger();
+			else if (mbDetonatorHandleIsInPlace)
+			{
+				Entity_SetActive("Detonator", true);
+				Entity_SetActive("Detonator_Animated", false);
+			}
+		}
+		
+		// From the hands: the wing nuts done up (the handle fixed in, as at the end of the flat game's scene).
+		void BunkerVR_FinaleTight()
+		{
+			mlVRFinale |= glBunkerVR_FinaleTight;
+			mbDetonatorHandleIsInPlace = true;
+			BunkerVR_FinaleShow(mlVRFinale);
+		}
+		
+		// From the hands: the cable laid on the bundle (the dynamite in place, as at the end of its scene).
+		void BunkerVR_FinaleCabled()
+		{
+			mlVRFinale |= glBunkerVR_FinaleCable;
+			mbDynamiteIsInPlace = true;
+			BunkerVR_FinaleShow(mlVRFinale);
+		}
+		
+		// From the hands: the T-bar pushed to the bottom of its stroke, alFast 1 hard enough to fire. All done, it fires:
+		// the push's animation goes on, the game's explosion at once (Seq_DynamiteExplosion), the Beast sent away as the
+		// flat game's push does, then the view darkens and Henri gets up (Seq_VRFinaleDark). Otherwise a dud.
+		void BunkerVR_FinalePushed(int alFast)
+		{
+			if (BunkerVR_FinaleArmed(mlVRFinale) == false)
+			{
+				BunkerVR_FinaleDud(mlVRFinale);
+				return;
+			}
+			if (alFast == 0) return;
+			mlVRFinale |= glBunkerVR_FinaleFired;
+			BunkerVR_FinaleShow(mlVRFinale);
+			BunkerVR_FinaleFireDetonator("OnAnimEnd_DetonatorIgnite");
+			Seq_DynamiteExplosion("");
+			DetonatorSendStalkerAway();
+			Seq_VRFinaleDark("");
+		}
+		
+		// After the push by hand: the explosion, the view black at once with the blast as if the player were knocked
+		// unconscious, four seconds out (the player held still), then the game's own scene after the push
+		// (player_detonator_ignite) joined where Henri is down, getting up, as the view comes back (the timings:
+		// helper_bunkervr_finale_shared.hps).
+		cSequenceStatesData mSeqDataVRFinaleDark;
+		void Seq_VRFinaleDark(const tString &in asTimer)
+		{
+			Sequence_Begin("Seq_VRFinaleDark", mSeqDataVRFinaleDark);
+			Sequence_Wait(gfBunkerVR_FinaleBlackAt);
+			if (Sequence_DoStepAndWait(gfBunkerVR_FinaleOut))
+			{
+				Effect_Fade_Out(gfBunkerVR_FinaleBlackIn); // (knocked out by the blast: black at once...)
+				Player_SetActive(false); // (...and still while dark)
+			}
+			else if (Sequence_DoStepAndWait(0.1f))
+			{
+				Player_SetActive(true);
+				PlayerBody_PlayCutsceneAtEntity("player_detonator_ignite", "Detonator_Animated", false, 0.0f, "OnAnimEnd_DetonatorUsed", 1.0f, gfBunkerVR_FinaleGetUp);
+				PlayerBody_SetCutsceneMaxPitch(0.f);
+				PlayerBody_SetCutsceneMaxYaw(0.f);
+				Effect_Fade_In(gfBunkerVR_FinaleWake);
+			}
+			Sequence_End();
+		}
+		
+		// In the headset the handle and the bundle are used once the hand has brought them (no scene): taken from the
+		// pockets a moment later, outside the game's use (as maintenance.hps does with the bottle), and shown in place.
+		void OnTimer_VRFinaleHandleIn(const tString &in asTimer)
+		{
+			Item_RemoveFromInventory(ItemType_GetFirstInInventory("DetonatorHandle"), eInventoryInstance_Player, false, true);
+			mlVRFinale |= glBunkerVR_FinaleHandle;
+			BunkerVR_FinaleShow(mlVRFinale);
+			Sound_CreateAtEntity("Sound_VRDetonatorHandleIn", "level_entity_shared/doors/button_lock/unlock", "Detonator_Animated");
+		}
+		
+		void OnTimer_VRFinaleBundleIn(const tString &in asTimer)
+		{
+			Item_RemoveFromInventory(ItemType_GetFirstInInventory("DynamiteBundle"), eInventoryInstance_Player, false, true);
+			mlVRFinale |= glBunkerVR_FinaleBundle;
+			BunkerVR_FinaleShow(mlVRFinale);
+			Entity_SetActive("Trigger_DynamiteBundleSlot", false);
+			Sound_CreateAtEntity("Sound_VRDynamitePlaced", "player/foley/action/pickup/dynamite", "Trigger_DynamiteBundleSlot");
+		}
+		
