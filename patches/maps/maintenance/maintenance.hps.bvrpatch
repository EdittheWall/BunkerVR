=1036
+			// BunkerVR: in VR the bottle is filled by hand at the tap (VRUpdateFuelTap in PlayerBodyHandler.hps:
+			// the left hand turns the tap, the fuel runs into the bottle held under it), and used on it once full.
+			// No scene and no crouch after it; a moment later (outside the game's use) the full bottle (or molotov)
+			// is in the hand instead of the empty one.
+			if (cVR_Active())
+			{
+				msUsedBottleItemID = asItemID;
+				msUsedBottleItemType = asItemType;
+				Map_AddTimer("Timer_VRFillBottle", 0.05f, "OnTimer_VRFillBottle");
+				return false;
+			}
+			
=60
+		// BunkerVR: filled by hand at the tap: the empty one leaves the hand and the pockets, and the full one goes
+		// into the hand.
+		void OnTimer_VRFillBottle(const tString &in asTimer)
+		{
+			tString sFull = msUsedBottleItemType == "EmptyMolotovCocktail" ? "MolotovCocktail" : "FuelBottle";
+			Item_RemoveFromInventory(msUsedBottleItemID, eInventoryInstance_Player, false, false);
+			tString sNew = Item_AddToInventory(sFull, eInventoryInstance_Player, false);
+			if (sNew != "") Item_Equip(sNew);
+			// (The game holds a molotov only with a lighter in the pockets, its RequiredToUseItem: without one it stays there.)
+			bool bNoLighter = sFull == "MolotovCocktail" && ItemType_GetCountInInventory("Lighter") == 0;
+			Log("BunkerVR: the " + msUsedBottleItemType + " filled at the tap by hand: a " + sFull + (sNew == "" ? " NOT made" : (bNoLighter ? " in the pockets (no lighter to hold it with)" : " in the hand")) + "\n");
+		}
+		
