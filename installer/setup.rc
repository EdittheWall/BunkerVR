// BunkerVR Setup's resources: its icon, the packed mod (payload.bin, written by pack.exe), its Windows manifest and
// the version Windows shows. Compiled in the staging folder, where the build script puts these files;
// version_rc.h defines BVR_VERSION_TEXT, BVR_MAJOR and BVR_MINOR.
#include <windows.h>
#include "version_rc.h"

1 ICON "setup.ico"
101 RCDATA "payload.bin"
#ifdef BUNKERVR_COPY_LOCK
// Private test builds: whose copy this is ("name=" and "account=" lines).
102 RCDATA "tester.txt"
#endif
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "setup.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION BVR_MAJOR, BVR_MINOR, 0, 0
PRODUCTVERSION BVR_MAJOR, BVR_MINOR, 0, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Mina Studio"
            VALUE "FileDescription", "BunkerVR Setup"
            VALUE "FileVersion", BVR_VERSION_TEXT
            VALUE "ProductName", "BunkerVR"
            VALUE "ProductVersion", BVR_VERSION_TEXT
            VALUE "LegalCopyright", "BunkerVR is a free fan-made mod, not made by or affiliated with Frictional Games"
            VALUE "OriginalFilename", "BunkerVR Setup.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
